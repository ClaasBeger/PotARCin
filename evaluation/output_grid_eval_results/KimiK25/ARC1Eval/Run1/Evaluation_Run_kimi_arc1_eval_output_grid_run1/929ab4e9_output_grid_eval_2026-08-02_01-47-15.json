't happen if pattern is consistent)\n    for i in range(n):\n        for j in range(m):\n            if out[i][j] == -1:\n                out[i][j] = grid[i][j]\n    \n    return out\n\n# Parse test input\ntest_input = \"\"\"5 8 8 6 6 1 3 6 9 6 4 4 4 4 6 9 6 3 1 6 6 8 8 5\n8 1 5 8 5 5 6 6 6 3 3 6 6 3 3 6 6 6 5 5 8 5 1 8\n8 5 6 5 8 5 9 6 9 5 4 4 4 4 5 9 6 9 5 8 5 6 5 8\n6 8 5 1 6 8 6 3 5 9 5 4 4 5 9 5 3 6 8 6 1 5 8 6\n6 5 8 6 3 1 4 3 4 5 5 6 6 5 5 4 3 4 1 3 6 8 5 6\n1 5 5 8 1 6 4 6 4 4 6 3 3 6 4 4 6 4 6 1 8 5 5 1\n3 6 9 6 4 4 8 5 8 3 5 6 6 5 3 8 5 8 4 4 6 9 6 3\n6 6 6 3 3 6 5 5 5 8 1 5 5 1 8 5 5 5 6 3 3 6 6 6\n9 6 9 5 4 4 8 5 5 8 5 6 6 5 8 5 5 8 4 4 5 9 6 9\n6 3 5 9 5 4 3 8 8 1 3 1 1 3 1 8 8 3 4 5 9 5 3 6\n4 3 4 5 5 6 5 2 2 2 1 8 8 1 3 2 2 2 6 5 5 4 3 4\n4 6 4 4 6 3 6 2 2 2 8 8 8 8 1 2 2 2 3 6 4 4 6 4\n4 6 4 4 6 3 6 2 2 2 8 8 8 8 1 2 2 2 3 6 4 4 6 4\n4 3 4 5 5 6 5 2 2 2 1 8 8 1 3 2 2 2 6 5 5 4 3 4\n6 3 5 9 5 4 3 2 2 2 3 1 1 3 1 2 2 2 4 5 9 5 3 6\n9 6 9 5 4 4 8 2 2 2 5 6 6 5 8 5 5 8 4 4 5 9 6 9\n6 6 6 3 3 6 5 5 5 8 1 5 5 1 8 5 5 5 6 3 3 6 6 6\n3 6 9 6 4 4 8 5 8 3 5 6 6 5 3 8 5 8 4 4 6 9 6 3\n1 5 5 8 1 6 4 6 4 4 6 3 3 6 4 4 6 4 6 1 8 5 5 1\n6 5 8 6 3 1 4 3 4 5 5 6 6 5 5 4 3 4 1 3 6 8 5 6\n6 8 5 1 6 8 6 3 5 9 5 4 4 5 9 5 3 6 8 6 1 5 8 6\n8 5 6 5 8 5 9 6 9 5 4 4 4 4 5 9 6 9 5 8 5 6 5 8\n8 1 5 8 5 5 6 6 6 3 3 6 6 3 3 6 6 6 5 5 8 5 1 8\n5 8 8 6 6 1 3 6 9 6 4 4 4 4 6 9 6 3 1 6 6 8 8 5\"\"\"\n\ngrid = [[int(x) for x in row.split()] for row in test_input.strip().split('\\n')]\nresult = solve(grid)\n\nfor row in result:\n    print(' '.join(map(str, row)))\n```\n\nRunning this logic mentally and then computing:\n\n```python\n[[5, 8, 8, 6, 6, 1, 3, 6, 9, 6, 4, 4, 4, 4, 6, 9, 6, 3, 1, 6, 6, 8, 8, 5], [8, 1, 5, 8, 5, 5, 6, 6, 6, 3, 3, 6, 6, 3, 3, 6, 6, 6, 5, 5, 8, 5, 1, 8], [8, 5, 6, 5, 8, 5, 9, 6, 9, 5, 4, 4, 4, 4, 5, 9, 6, 9, 5, 8, 5, 6, 5, 8], [6, 8, 5, 1, 6, 8, 6, 3, 5, 9, 5, 4, 4, 5, 9, 5, 3, 6, 8, 6, 1, 5, 8, 6], [6, 5, 8, 6, 3, 1, 4, 3, 4, 5, 5, 6, 6, 5, 5, 4, 3, 4, 1, 3, 6