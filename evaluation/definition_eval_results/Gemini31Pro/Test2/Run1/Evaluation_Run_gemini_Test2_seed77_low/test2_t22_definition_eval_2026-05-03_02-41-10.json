  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Find all points for each color\n    points = {}\n    for r in range(R):\n        for c in range(C):\n            color = grid[r][c]\n            if color != 0:\n                if color not in points:\n                    points[color] = []\n                points[color].append((r, c))\n                \n    out = [row[:] for row in grid]\n    \n    for color, pts in points.items():\n        # Determine if the main line is vertical or horizontal\n        # by checking if there are multiple points on the same row or column\n        row_counts = {}\n        col_counts = {}\n        for r, c in pts:\n            row_counts[r] = row_counts.get(r, 0) + 1\n            col_counts[c] = col_counts.get(c, 0) + 1\n            \n        max_row_count = max(row_counts.values())\n        max_col_count = max(col_counts.values())\n        \n        is_vertical = False\n        main_idx = -1\n        \n        if max_col_count >= max_row_count and max_col_count > 1:\n            is_vertical = True\n            # find the col with max count\n            main_idx = max(col_counts, key=col_counts.get)\n        elif max_row_count > 1:\n            is_vertical = False\n            main_idx = max(row_counts, key=row_counts.get)\n        else:\n            # Fallback if no collinear points, just pick first point's col\n            is_vertical = True\n            main_idx = pts[0][1]\n            \n        if is_vertical:\n            min_r = min(r for r, c in pts)\n            max_r = max(r for r, c in pts)\n            # draw main vertical line\n            for r in range(min_r, max_r + 1):\n                if out[r][main_idx] == 0 or out[r][main_idx] == color:\n                    out[r][main_idx] = color\n            # draw horizontal branches\n            for r, c in pts:\n                step = 1 if main_idx > c else -1\n                for cc in range(c, main_idx, step):\n                    if out[r][cc] == 0 or out[r][cc] == color:\n                        out[r][cc] = color\n        else:\n            min_c = min(c for r, c in pts)\n            max_c = max(c for r, c in pts)\n            # draw main horizontal line\n            for c in range(min_c, max_c + 1):\n                if out[main_idx][c] == 0 or out[main_idx][c] == color:\n                    out[main_idx][c] = color\n            # draw vertical branches\n            for r, c in pts:\n                step = 1 if main_idx > r else -1\n                for rr in range(r, main_idx, step):\n                    if out[rr][c] == 0 or out[rr][c] == color:\n                        out[rr][c] = color\n\n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Find all points for each color\n    points = {}\n    for r in range(R):\n        for c in range(C):\n            color = grid[r][c]\n            if color != 0:\n                if color not in points:\n                    points[color] = []\n                points[color].append((r, c))\n                \n    out = [row[:] for row in grid]\n    \n    for color, pts in points.items():\n        # Determine if the main line is vertical or horizontal\n        # by checking if there are multiple points on the same row or column\n        row_counts = {}\n        col_counts = {}\n        for r, c in pts:\n            row_counts[r] = row_counts.get(r, 0) + 1\n            col_counts[c] = col_counts.get(c, 0) + 1\n            \n        max_row_count = max(row_counts.values())\n        max_col_count = max(col_counts.values())\n        \n        is_vertical = False\n        main_idx = -1\n        \n        if max_col_count >= max_row_count and max_col_count > 1:\n            is_vertical = True\n            # find the col with max count\n            main_idx = max(col_counts, key=col_counts.get)\n        elif max_row_count > 1:\n            is_vertical = False\n            main_idx = max(row_counts, key=row_counts.get)\n        else:\n            # Fallback if no collinear points, just pick first point's col\n            is_vertical = True\n            main_idx = pts[0][1]\n            \n        if is_vertical:\n            min_r = min(r for r, c in pts)\n            max_r = max(r for r, c in pts)\n            # draw main vertical line\n            for r in range(min_r, max_r + 1):\n                if out[r][main_idx] == 0 or out[r][main_idx] == color:\n                    out[r][main_idx] = color\n            # draw horizontal branches\n            for r, c in pts:\n                step = 1 if main_idx > c else -1\n                for cc in range(c, main_idx, step):\n                    if out[r][cc] == 0 or out[r][cc] == color:\n                        out[r][cc] = color\n        else:\n            min_c = min(c for r, c in pts)\n            max_c = max(c for r, c in pts)\n            # draw main horizontal line\n            for c in range(min_c, max_c + 1):\n                if out[main_idx][c] == 0 or out[main_idx][c] == color:\n                    out[main_idx][c] = color\n            # draw vertical branches\n            for r, c in pts:\n                step = 1 if main_idx > r else -1\n                for rr in range(r, main_idx, step):\n                    if out[rr][c] == 0 or out[rr][c] == color:\n                        out[rr][c] = color\n\n    return out",
