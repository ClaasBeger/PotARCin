  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    max_r_TL = -1\n    for r in range(H // 2):\n        for c in range(W // 2):\n            if grid[r][c] != 0:\n                max_r_TL = max(max_r_TL, r)\n                \n    if max_r_TL == -1:\n        return [row[:] for row in grid]\n        \n    step = (H // 2) - 1 - max_r_TL\n    \n    new_grid = [[0] * W for _ in range(H)]\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] != 0:\n                new_r = r + step if r < H // 2 else r - step\n                new_c = c + step if c < W // 2 else c - step\n                new_grid[new_r][new_c] = grid[r][c]\n                \n    return new_grid\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    max_r_TL = -1\n    for r in range(H // 2):\n        for c in range(W // 2):\n            if grid[r][c] != 0:\n                max_r_TL = max(max_r_TL, r)\n                \n    if max_r_TL == -1:\n        return [row[:] for row in grid]\n        \n    step = (H // 2) - 1 - max_r_TL\n    \n    new_grid = [[0] * W for _ in range(H)]\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] != 0:\n                new_r = r + step if r < H // 2 else r - step\n                new_c = c + step if c < W // 2 else c - step\n                new_grid[new_r][new_c] = grid[r][c]\n                \n    return new_grid",
