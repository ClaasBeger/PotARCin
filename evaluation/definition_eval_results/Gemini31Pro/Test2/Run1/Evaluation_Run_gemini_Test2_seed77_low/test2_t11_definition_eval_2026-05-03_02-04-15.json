  "raw_response": "```python\ndef solve(grid):\n    R, C_col = -1, -1\n    C = 0\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                R, C_col = r, c\n                C = grid[r][c]\n                break\n        if C != 0:\n            break\n            \n    out_grid = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    if C == 0:\n        return out_grid\n        \n    for r in range(rows):\n        for c in range(cols):\n            dr = r - R\n            dc = c - C_col\n            \n            if (dr % 2 != 0) and (dc % 2 != 0):\n                out_grid[r][c] = 3\n            elif (dr % 2 == 0) and (dc % 2 == 0):\n                DX = dr // 2\n                DY = dc // 2\n                \n                # Approximation of the fractal logic\n                if (abs(DX) & abs(DY)) == 0:\n                    if DX == 0 and DY > 0:\n                        out_grid[r][c] = 1\n                    elif DY == 0 and DX > 0:\n                        out_grid[r][c] = 1\n                    elif DX == 0 and DY == 0:\n                        out_grid[r][c] = C\n                    elif (DX < 0 and DY > 0) or (DX > 0 and DY < 0):\n                        out_grid[r][c] = 1\n                    else:\n                        out_grid[r][c] = C\n                else:\n                    if (abs(DX) | abs(DY)) % 2 == 1:\n                        out_grid[r][c] = C\n                    else:\n                        out_grid[r][c] = 1\n                        \n            # Clean up some stray values to better match patterns\n            if dr == 0 and dc == 0:\n                out_grid[r][c] = C\n                \n    # Fix odd/even checkerboard pattern\n    for r in range(rows):\n        for c in range(cols):\n            if (abs(r - R) + abs(c - C_col)) % 2 != 0:\n                out_grid[r][c] = 0\n\n    return out_grid\n```",
  "script": "def solve(grid):\n    R, C_col = -1, -1\n    C = 0\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                R, C_col = r, c\n                C = grid[r][c]\n                break\n        if C != 0:\n            break\n            \n    out_grid = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    if C == 0:\n        return out_grid\n        \n    for r in range(rows):\n        for c in range(cols):\n            dr = r - R\n            dc = c - C_col\n            \n            if (dr % 2 != 0) and (dc % 2 != 0):\n                out_grid[r][c] = 3\n            elif (dr % 2 == 0) and (dc % 2 == 0):\n                DX = dr // 2\n                DY = dc // 2\n                \n                # Approximation of the fractal logic\n                if (abs(DX) & abs(DY)) == 0:\n                    if DX == 0 and DY > 0:\n                        out_grid[r][c] = 1\n                    elif DY == 0 and DX > 0:\n                        out_grid[r][c] = 1\n                    elif DX == 0 and DY == 0:\n                        out_grid[r][c] = C\n                    elif (DX < 0 and DY > 0) or (DX > 0 and DY < 0):\n                        out_grid[r][c] = 1\n                    else:\n                        out_grid[r][c] = C\n                else:\n                    if (abs(DX) | abs(DY)) % 2 == 1:\n                        out_grid[r][c] = C\n                    else:\n                        out_grid[r][c] = 1\n                        \n            # Clean up some stray values to better match patterns\n            if dr == 0 and dc == 0:\n                out_grid[r][c] = C\n                \n    # Fix odd/even checkerboard pattern\n    for r in range(rows):\n        for c in range(cols):\n            if (abs(r - R) + abs(c - C_col)) % 2 != 0:\n                out_grid[r][c] = 0\n\n    return out_grid",
