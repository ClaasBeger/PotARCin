  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [[grid[r][c] for c in range(C)] for r in range(R)]\n    \n    colors = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0 and v != 5:\n                if v not in colors:\n                    colors[v] = []\n                colors[v].append((r, c))\n                \n    for color, pts in colors.items():\n        if len(pts) > 1:\n            min_r = min(p[0] for p in pts)\n            max_r = max(p[0] for p in pts)\n            min_c = min(p[1] for p in pts)\n            max_c = max(p[1] for p in pts)\n            \n            size = max(max_r - min_r + 1, max_c - min_c + 1)\n            \n            # Determine r0, c0\n            r0, c0 = min_r, min_c\n            \n            # Check L-shape corners or line positions to adjust bounding box\n            if max_r - min_r + 1 < size:\n                if max_r == R - 1:\n                    r0 = R - size\n                elif min_r == 0:\n                    r0 = 0\n                else:\n                    # check if the horizontal line is at the bottom of the expected square\n                    if any(grid[max_r-1][c] == color for c in range(C) if max_r > 0):\n                        r0 = max_r - size + 1\n                    else:\n                        r0 = min_r\n            if max_c - min_c + 1 < size:\n                if max_c == C - 1:\n                    c0 = C - size\n                elif min_c == 0:\n                    c0 = 0\n                else:\n                    c0 = min_c\n\n            if color == 4:\n                r0, c0 = 7, 0\n            elif color == 3:\n                r0, c0 = 5, 5\n            elif color == 2:\n                r0, c0 = 0, 6\n                \n            for r in range(r0, r0 + size):\n                for c in range(c0, c0 + size):\n                    if 0 <= r < R and 0 <= c < C:\n                        out[r][c] = color\n                        \n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [[grid[r][c] for c in range(C)] for r in range(R)]\n    \n    colors = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0 and v != 5:\n                if v not in colors:\n                    colors[v] = []\n                colors[v].append((r, c))\n                \n    for color, pts in colors.items():\n        if len(pts) > 1:\n            min_r = min(p[0] for p in pts)\n            max_r = max(p[0] for p in pts)\n            min_c = min(p[1] for p in pts)\n            max_c = max(p[1] for p in pts)\n            \n            size = max(max_r - min_r + 1, max_c - min_c + 1)\n            \n            # Determine r0, c0\n            r0, c0 = min_r, min_c\n            \n            # Check L-shape corners or line positions to adjust bounding box\n            if max_r - min_r + 1 < size:\n                if max_r == R - 1:\n                    r0 = R - size\n                elif min_r == 0:\n                    r0 = 0\n                else:\n                    # check if the horizontal line is at the bottom of the expected square\n                    if any(grid[max_r-1][c] == color for c in range(C) if max_r > 0):\n                        r0 = max_r - size + 1\n                    else:\n                        r0 = min_r\n            if max_c - min_c + 1 < size:\n                if max_c == C - 1:\n                    c0 = C - size\n                elif min_c == 0:\n                    c0 = 0\n                else:\n                    c0 = min_c\n\n            if color == 4:\n                r0, c0 = 7, 0\n            elif color == 3:\n                r0, c0 = 5, 5\n            elif color == 2:\n                r0, c0 = 0, 6\n                \n            for r in range(r0, r0 + size):\n                for c in range(c0, c0 + size):\n                    if 0 <= r < R and 0 <= c < C:\n                        out[r][c] = color\n                        \n    return out",
