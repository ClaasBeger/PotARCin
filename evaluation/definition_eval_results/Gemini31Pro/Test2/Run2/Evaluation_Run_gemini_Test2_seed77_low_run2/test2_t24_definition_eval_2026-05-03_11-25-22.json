  "raw_response": "```python\ndef solve(grid):\n    import copy\n    R = len(grid)\n    if R == 0: return grid\n    C = len(grid[0])\n    out = copy.deepcopy(grid)\n    \n    # Find connected components (4-way) of non-zero pixels\n    visited = set()\n    components = []\n    for r in range(R):\n        for c in range(C):\n            if out[r][c] != 0 and (r, c) not in visited:\n                color = out[r][c]\n                comp = []\n                q = [(r, c)]\n                visited.add((r, c))\n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    for dr, dc in [(-1,0), (1,0), (0,-1), (0,1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < R and 0 <= nc < C and (nr, nc) not in visited and out[nr][nc] == color:\n                            visited.add((nr, nc))\n                            q.append((nr, nc))\n                components.append((color, comp))\n                \n    # Find the isolated pixel (size 1)\n    target_comp = None\n    for color, comp in components:\n        if len(comp) == 1:\n            target_comp = (color, comp)\n            break\n            \n    if not target_comp:\n        return out\n        \n    target_color = target_comp[0]\n    target_pixel = target_comp[1][0]\n    \n    # Graph of components based on line-of-sight\n    adj = {i: set() for i in range(len(components))}\n    \n    def can_see(comp1, comp2):\n        pts1 = set(comp1)\n        pts2 = set(comp2)\n        for r, c in pts1:\n            for dr, dc in [(-1,0), (1,0), (0,-1), (0,1)]:\n                nr, nc = r + dr, c + dc\n                while 0 <= nr < R and 0 <= nc < C:\n                    if (nr, nc) in pts2:\n                        return True\n                    if out[nr][nc] != 0 and (nr, nc) not in pts1:\n                        break\n                    nr += dr\n                    nc += dc\n        return False\n\n    for i in range(len(components)):\n        for j in range(i + 1, len(components)):\n            if can_see(components[i][1], components[j][1]):\n                adj[i].add(j)\n                adj[j].add(i)\n                \n    # BFS to find all components connected to the target pixel\n    start_idx = components.index(target_comp)\n    connected_indices = set([start_idx])\n    q = [start_idx]\n    \n    while q:\n        curr = q.pop(0)\n        for nxt in adj[curr]:\n            if nxt not in connected_indices:\n                connected_indices.add(nxt)\n                q.append(nxt)\n                \n    # Transform\n    for idx in connected_indices:\n        for r, c in components[idx][1]:\n            out[r][c] = target_color\n            \n    # The isolated pixel itself should disappear if it was separate, but the examples show it either staying or disappearing.\n    # Actually, in Ex 1 and 2, it disappears.\n    out[target_pixel[0]][target_pixel[1]] = 0\n    \n    return out\n```",
  "script": "def solve(grid):\n    import copy\n    R = len(grid)\n    if R == 0: return grid\n    C = len(grid[0])\n    out = copy.deepcopy(grid)\n    \n    # Find connected components (4-way) of non-zero pixels\n    visited = set()\n    components = []\n    for r in range(R):\n        for c in range(C):\n            if out[r][c] != 0 and (r, c) not in visited:\n                color = out[r][c]\n                comp = []\n                q = [(r, c)]\n                visited.add((r, c))\n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    for dr, dc in [(-1,0), (1,0), (0,-1), (0,1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < R and 0 <= nc < C and (nr, nc) not in visited and out[nr][nc] == color:\n                            visited.add((nr, nc))\n                            q.append((nr, nc))\n                components.append((color, comp))\n                \n    # Find the isolated pixel (size 1)\n    target_comp = None\n    for color, comp in components:\n        if len(comp) == 1:\n            target_comp = (color, comp)\n            break\n            \n    if not target_comp:\n        return out\n        \n    target_color = target_comp[0]\n    target_pixel = target_comp[1][0]\n    \n    # Graph of components based on line-of-sight\n    adj = {i: set() for i in range(len(components))}\n    \n    def can_see(comp1, comp2):\n        pts1 = set(comp1)\n        pts2 = set(comp2)\n        for r, c in pts1:\n            for dr, dc in [(-1,0), (1,0), (0,-1), (0,1)]:\n                nr, nc = r + dr, c + dc\n                while 0 <= nr < R and 0 <= nc < C:\n                    if (nr, nc) in pts2:\n                        return True\n                    if out[nr][nc] != 0 and (nr, nc) not in pts1:\n                        break\n                    nr += dr\n                    nc += dc\n        return False\n\n    for i in range(len(components)):\n        for j in range(i + 1, len(components)):\n            if can_see(components[i][1], components[j][1]):\n                adj[i].add(j)\n                adj[j].add(i)\n                \n    # BFS to find all components connected to the target pixel\n    start_idx = components.index(target_comp)\n    connected_indices = set([start_idx])\n    q = [start_idx]\n    \n    while q:\n        curr = q.pop(0)\n        for nxt in adj[curr]:\n            if nxt not in connected_indices:\n                connected_indices.add(nxt)\n                q.append(nxt)\n                \n    # Transform\n    for idx in connected_indices:\n        for r, c in components[idx][1]:\n            out[r][c] = target_color\n            \n    # The isolated pixel itself should disappear if it was separate, but the examples show it either staying or disappearing.\n    # Actually, in Ex 1 and 2, it disappears.\n    out[target_pixel[0]][target_pixel[1]] = 0\n    \n    return out",
