  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    eights = set()\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 8:\n                eights.add((r, c))\n                \n    def sym_id(r, c): return r, c\n    def sym_rot90(r, c): return c, C - 1 - r\n    def sym_rot180(r, c): return R - 1 - r, C - 1 - c\n    def sym_rot270(r, c): return R - 1 - c, r\n    def sym_flip_h(r, c): return r, C - 1 - c\n    def sym_flip_v(r, c): return R - 1 - r, c\n    def sym_flip_d1(r, c): return c, r\n    def sym_flip_d2(r, c): return R - 1 - c, C - 1 - r\n\n    # For square grids, all 8 symmetries are valid grid transformations.\n    # We check which of these leave the 8-shape invariant.\n    all_syms = [sym_id, sym_rot90, sym_rot180, sym_rot270, \n                sym_flip_h, sym_flip_v, sym_flip_d1, sym_flip_d2]\n                \n    valid_syms = []\n    for sym in all_syms:\n        transformed_eights = set()\n        for (r, c) in eights:\n            try:\n                nr, nc = sym(r, c)\n                transformed_eights.add((nr, nc))\n            except Exception:\n                pass\n        if transformed_eights == eights:\n            valid_syms.append(sym)\n\n    output = [[0]*C for _ in range(R)]\n    for r in range(R):\n        for c in range(C):\n            val = grid[r][c]\n            if val != 0:\n                for sym in valid_syms:\n                    try:\n                        nr, nc = sym(r, c)\n                        if 0 <= nr < R and 0 <= nc < C:\n                            output[nr][nc] = val\n                    except Exception:\n                        pass\n                        \n    return output\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    eights = set()\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 8:\n                eights.add((r, c))\n                \n    def sym_id(r, c): return r, c\n    def sym_rot90(r, c): return c, C - 1 - r\n    def sym_rot180(r, c): return R - 1 - r, C - 1 - c\n    def sym_rot270(r, c): return R - 1 - c, r\n    def sym_flip_h(r, c): return r, C - 1 - c\n    def sym_flip_v(r, c): return R - 1 - r, c\n    def sym_flip_d1(r, c): return c, r\n    def sym_flip_d2(r, c): return R - 1 - c, C - 1 - r\n\n    # For square grids, all 8 symmetries are valid grid transformations.\n    # We check which of these leave the 8-shape invariant.\n    all_syms = [sym_id, sym_rot90, sym_rot180, sym_rot270, \n                sym_flip_h, sym_flip_v, sym_flip_d1, sym_flip_d2]\n                \n    valid_syms = []\n    for sym in all_syms:\n        transformed_eights = set()\n        for (r, c) in eights:\n            try:\n                nr, nc = sym(r, c)\n                transformed_eights.add((nr, nc))\n            except Exception:\n                pass\n        if transformed_eights == eights:\n            valid_syms.append(sym)\n\n    output = [[0]*C for _ in range(R)]\n    for r in range(R):\n        for c in range(C):\n            val = grid[r][c]\n            if val != 0:\n                for sym in valid_syms:\n                    try:\n                        nr, nc = sym(r, c)\n                        if 0 <= nr < R and 0 <= nc < C:\n                            output[nr][nc] = val\n                    except Exception:\n                        pass\n                        \n    return output",
