  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    colors = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                if v not in colors:\n                    colors[v] = []\n                colors[v].append((r, c))\n                \n    # Sort colors by some priority or just process them\n    for color, pts in colors.items():\n        # Heuristic: connect points forming L-shapes\n        # For simplicity, connect consecutive points in sorted order\n        pts.sort(key=lambda p: (p[0], p[1]))\n        for i in range(len(pts) - 1):\n            r1, c1 = pts[i]\n            r2, c2 = pts[i+1]\n            # Draw horizontal then vertical\n            r, c = r1, c1\n            while c != c2:\n                out[r][c] = color\n                c += 1 if c2 > c1 else -1\n            while r != r2:\n                out[r][c] = color\n                r += 1 if r2 > r1 else -1\n            out[r2][c2] = color\n\n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    colors = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                if v not in colors:\n                    colors[v] = []\n                colors[v].append((r, c))\n                \n    # Sort colors by some priority or just process them\n    for color, pts in colors.items():\n        # Heuristic: connect points forming L-shapes\n        # For simplicity, connect consecutive points in sorted order\n        pts.sort(key=lambda p: (p[0], p[1]))\n        for i in range(len(pts) - 1):\n            r1, c1 = pts[i]\n            r2, c2 = pts[i+1]\n            # Draw horizontal then vertical\n            r, c = r1, c1\n            while c != c2:\n                out[r][c] = color\n                c += 1 if c2 > c1 else -1\n            while r != r2:\n                out[r][c] = color\n                r += 1 if r2 > r1 else -1\n            out[r2][c2] = color\n\n    return out",
