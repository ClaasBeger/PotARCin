  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    out = [[0] * W for _ in range(H)]\n    \n    def process(r_start, r_end, c_start, c_end, quad):\n        nonzeros = []\n        for r in range(r_start, r_end):\n            for c in range(c_start, c_end):\n                if grid[r][c] != 0:\n                    nonzeros.append((r, c, grid[r][c]))\n        \n        if not nonzeros:\n            return\n            \n        min_r = min(r for r, c, v in nonzeros)\n        max_r = max(r for r, c, v in nonzeros)\n        min_c = min(c for r, c, v in nonzeros)\n        max_c = max(c for r, c, v in nonzeros)\n        \n        if quad == 'TL':\n            dr = (H // 2 - 1) - max_r\n            dc = (W // 2 - 1) - max_c\n        elif quad == 'TR':\n            dr = (H // 2 - 1) - max_r\n            dc = (W // 2) - min_c\n        elif quad == 'BL':\n            dr = (H // 2) - min_r\n            dc = (W // 2 - 1) - max_c\n        elif quad == 'BR':\n            dr = (H // 2) - min_r\n            dc = (W // 2) - min_c\n            \n        for r, c, v in nonzeros:\n            out[r + dr][c + dc] = v\n\n    process(0, H // 2, 0, W // 2, 'TL')\n    process(0, H // 2, W // 2, W, 'TR')\n    process(H // 2, H, 0, W // 2, 'BL')\n    process(H // 2, H, W // 2, W, 'BR')\n    \n    return out\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    out = [[0] * W for _ in range(H)]\n    \n    def process(r_start, r_end, c_start, c_end, quad):\n        nonzeros = []\n        for r in range(r_start, r_end):\n            for c in range(c_start, c_end):\n                if grid[r][c] != 0:\n                    nonzeros.append((r, c, grid[r][c]))\n        \n        if not nonzeros:\n            return\n            \n        min_r = min(r for r, c, v in nonzeros)\n        max_r = max(r for r, c, v in nonzeros)\n        min_c = min(c for r, c, v in nonzeros)\n        max_c = max(c for r, c, v in nonzeros)\n        \n        if quad == 'TL':\n            dr = (H // 2 - 1) - max_r\n            dc = (W // 2 - 1) - max_c\n        elif quad == 'TR':\n            dr = (H // 2 - 1) - max_r\n            dc = (W // 2) - min_c\n        elif quad == 'BL':\n            dr = (H // 2) - min_r\n            dc = (W // 2 - 1) - max_c\n        elif quad == 'BR':\n            dr = (H // 2) - min_r\n            dc = (W // 2) - min_c\n            \n        for r, c, v in nonzeros:\n            out[r + dr][c + dc] = v\n\n    process(0, H // 2, 0, W // 2, 'TL')\n    process(0, H // 2, W // 2, W, 'TR')\n    process(H // 2, H, 0, W // 2, 'BL')\n    process(H // 2, H, W // 2, W, 'BR')\n    \n    return out",
