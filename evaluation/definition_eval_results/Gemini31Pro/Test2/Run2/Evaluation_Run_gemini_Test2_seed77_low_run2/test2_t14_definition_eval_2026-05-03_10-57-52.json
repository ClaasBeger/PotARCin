  "script": "def solve(grid):\n    out = [row[:] for row in grid]\n    out[5][0] = 0\n    end_col = 11\n    \n    for c in range(1, 12):\n        if out[5][c] == 3:\n            h = 0\n            for r in range(5, -1, -1):\n                if out[r][c] == 3:\n                    h += 1\n                else:\n                    break\n            if h >= 3:\n                end_col = c - 1\n                break\n                \n    out[5][end_col] = 2\n    \n    if end_col == 11:\n        out[1][10] = 4\n        out[0][10] = 4\n        out[2][10] = 4\n        out[1][9] = 4\n        out[1][11] = 4\n        \n    return out",
