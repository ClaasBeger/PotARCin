1, 1) not in coords:\n            corner_shapes['TL'].append((color, comp))\n        elif (1, 0) not in coords:\n            corner_shapes['TR'].append((color, comp))\n        elif (0, 1) not in coords:\n            corner_shapes['BL'].append((color, comp))\n        elif (0, 0) not in coords:\n            corner_shapes['BR'].append((color, comp))\n\n    def place_shape(shape_comp, color, corner, index):\n        # We assume standard diagonal packing as seen in examples (index * 2, index * 2) or similar.\n        # But for test case, there is only 1 shape per corner!\n        # Let's just do simple offset for now.\n        min_r = min(r for r, c in shape_comp)\n        min_c = min(c for r, c in shape_comp)\n        norm_comp = [(r - min_r, c - min_c) for r, c in shape_comp]\n        \n        offset_r = 0\n        offset_c = 0\n        \n        if corner == 'TL':\n            offset_r = 2 * index\n            offset_c = 2 * index\n        elif corner == 'TR':\n            offset_r = 2 * index\n            offset_c = width - 2 - 2 * index\n        elif corner == 'BL':\n            offset_r = height - 2 - 2 * index\n            offset_c = 2 * index\n        elif corner == 'BR':\n            offset_r = height - 2 - 2 * index\n            offset_c = width - 2 - 2 * index\n            \n        for r, c in norm_comp:\n            tr = offset_r + r\n            tc = offset_c + c\n            if 0 <= tr < height and 0 <= tc < width:\n                output[tr][tc] = color\n\n    for corner, comps in corner_shapes.items():\n        for i, (color, comp) in enumerate(comps):\n            place_shape(comp, color, corner, i)\n            \n    return output",
