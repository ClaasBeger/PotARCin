  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Create a copy of the grid to modify\n    out_grid = [[grid[r][c] for c in range(C)] for r in range(R)]\n    \n    # Find the border color by finding the most frequent non-zero element\n    counts = {}\n    for r in range(R):\n        for c in range(C):\n            val = grid[r][c]\n            if val != 0:\n                counts[val] = counts.get(val, 0) + 1\n    \n    border_color = max(counts.items(), key=lambda x: x[1])[0]\n    \n    # Find the bounding box of the border\n    min_r, max_r = R, -1\n    min_c, max_c = C, -1\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == border_color:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    # Inner corners\n    tl_in = (min_r + 1, min_c + 1)\n    tr_in = (min_r + 1, max_c - 1)\n    bl_in = (max_r - 1, min_c + 1)\n    br_in = (max_r - 1, max_c - 1)\n    \n    # Values at inner corners\n    val_tl = grid[tl_in[0]][tl_in[1]]\n    val_tr = grid[tr_in[0]][tr_in[1]]\n    val_bl = grid[bl_in[0]][bl_in[1]]\n    val_br = grid[br_in[0]][br_in[1]]\n    \n    # Clear inner corners\n    out_grid[tl_in[0]][tl_in[1]] = 0\n    out_grid[tr_in[0]][tr_in[1]] = 0\n    out_grid[bl_in[0]][bl_in[1]] = 0\n    out_grid[br_in[0]][br_in[1]] = 0\n    \n    # Outer corners\n    tl_out = (min_r - 1, min_c - 1)\n    tr_out = (min_r - 1, max_c + 1)\n    bl_out = (max_r + 1, min_c - 1)\n    br_out = (max_r + 1, max_c + 1)\n    \n    # Set outer corners to diagonally opposite values\n    if 0 <= tl_out[0] < R and 0 <= tl_out[1] < C:\n        out_grid[tl_out[0]][tl_out[1]] = val_br\n    if 0 <= tr_out[0] < R and 0 <= tr_out[1] < C:\n        out_grid[tr_out[0]][tr_out[1]] = val_bl\n    if 0 <= bl_out[0] < R and 0 <= bl_out[1] < C:\n        out_grid[bl_out[0]][bl_out[1]] = val_tr\n    if 0 <