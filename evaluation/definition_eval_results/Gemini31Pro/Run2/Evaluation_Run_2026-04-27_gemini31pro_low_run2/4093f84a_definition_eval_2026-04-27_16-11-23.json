  "raw_response": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    out = [[0]*C for _ in range(R)]\n    \n    min_r, max_r = R, -1\n    min_c, max_c = C, -1\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 5:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n\n    for r in range(min_r, max_r + 1):\n        for c in range(min_c, max_c + 1):\n            out[r][c] = 5\n\n    is_horizontal = (max_c - min_c + 1 == C)\n    \n    if is_horizontal:\n        for c in range(C):\n            count_above = 0\n            count_below = 0\n            for r in range(R):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    if r < min_r:\n                        count_above += 1\n                    elif r > max_r:\n                        count_below += 1\n            \n            for i in range(count_above):\n                out[min_r - 1 - i][c] = 5\n            for i in range(count_below):\n                out[max_r + 1 + i][c] = 5\n                \n    else:\n        for r in range(R):\n            count_left = 0\n            count_right = 0\n            for c in range(C):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    if c < min_c:\n                        count_left += 1\n                    elif c > max_c:\n                        count_right += 1\n                        \n            for i in range(count_left):\n                out[r][min_c - 1 - i] = 5\n            for i in range(count_right):\n                out[r][max_c + 1 + i] = 5\n                \n    return out",
