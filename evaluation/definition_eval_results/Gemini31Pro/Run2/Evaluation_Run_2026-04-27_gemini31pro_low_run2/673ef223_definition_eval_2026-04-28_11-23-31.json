  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    # Find vertical bars of 2s\n    bars = [] # list of (start_r, end_r, c)\n    for c in [0, C-1]:\n        r = 0\n        while r < R:\n            if grid[r][c] == 2:\n                start = r\n                while r < R and grid[r][c] == 2:\n                    r += 1\n                bars.append((start, r-1, c))\n            else:\n                r += 1\n\n    bar_with_8s = None\n    bar_without_8s = None\n    \n    # Check which bar corresponds to rows with 8s\n    for start, end, c in bars:\n        has_8 = False\n        for r in range(start, end + 1):\n            if 8 in grid[r]:\n                has_8 = True\n                break\n        if has_8:\n            bar_with_8s = (start, end, c)\n        else:\n            bar_without_8s = (start, end, c)\n            \n    if bar_with_8s and bar_without_8s:\n        start_w, end_w, c_w = bar_with_8s\n        start_wo, end_wo, c_wo = bar_without_8s\n        \n        for r in range(start_w, end_w + 1):\n            if 8 in grid[r]:\n                c_8 = grid[r].index(8)\n                out[r][c_8] = 4\n                \n                # Draw 8s from 2 to 4\n                step = 1 if c_w < c_8 else -1\n                for col in range(c_w + step, c_8, step):\n                    out[r][col] = 8\n                \n                # Relative offset\n                offset = r - start_w\n                r_wo = start_wo + offset\n                \n                # Draw full line of 8s for the other bar\n                step_wo = 1 if c_wo == 0 else -1\n                end_col = C - 1 if c_wo == 0 else 0\n                for col in range(c_wo + step_wo, end_col + step_wo, step_wo):\n                    out[r_wo][col] = 8\n\n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    # Find vertical bars of 2s\n    bars = [] # list of (start_r, end_r, c)\n    for c in [0, C-1]:\n        r = 0\n        while r < R:\n            if grid[r][c] == 2:\n                start = r\n                while r < R and grid[r][c] == 2:\n                    r += 1\n                bars.append((start, r-1, c))\n            else:\n                r += 1\n\n    bar_with_8s = None\n    bar_without_8s = None\n    \n    # Check which bar corresponds to rows with 8s\n    for start, end, c in bars:\n        has_8 = False\n        for r in range(start, end + 1):\n            if 8 in grid[r]:\n                has_8 = True\n                break\n        if has_8:\n            bar_with_8s = (start, end, c)\n        else:\n            bar_without_8s = (start, end, c)\n            \n    if bar_with_8s and bar_without_8s:\n        start_w, end_w, c_w = bar_with_8s\n        start_wo, end_wo, c_wo = bar_without_8s\n        \n        for r in range(start_w, end_w + 1):\n            if 8 in grid[r]:\n                c_8 = grid[r].index(8)\n                out[r][c_8] = 4\n                \n                # Draw 8s from 2 to 4\n                step = 1 if c_w < c_8 else -1\n                for col in range(c_w + step, c_8, step):\n                    out[r][col] = 8\n                \n                # Relative offset\n                offset = r - start_w\n                r_wo = start_wo + offset\n                \n                # Draw full line of 8s for the other bar\n                step_wo = 1 if c_wo == 0 else -1\n                end_col = C - 1 if c_wo == 0 else 0\n                for col in range(c_wo + step_wo, end_col + step_wo, step_wo):\n                    out[r_wo][col] = 8\n\n    return out",
