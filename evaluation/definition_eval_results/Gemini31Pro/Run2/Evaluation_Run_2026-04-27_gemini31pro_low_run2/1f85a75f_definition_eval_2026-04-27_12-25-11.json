  "raw_response": "```python\ndef solve(grid):\n    colors = {}\n    for r in range(len(grid)):\n        for c in range(len(grid[r])):\n            val = grid[r][c]\n            if val != 0:\n                if val not in colors:\n                    colors[val] = {'min_r': r, 'max_r': r, 'min_c': c, 'max_c': c}\n                else:\n                    colors[val]['min_r'] = min(colors[val]['min_r'], r)\n                    colors[val]['max_r'] = max(colors[val]['max_r'], r)\n                    colors[val]['min_c'] = min(colors[val]['min_c'], c)\n                    colors[val]['max_c'] = max(colors[val]['max_c'], c)\n    \n    target_color = None\n    min_area = float('inf')\n    \n    for val, bbox in colors.items():\n        area = (bbox['max_r'] - bbox['min_r'] + 1) * (bbox['max_c'] - bbox['min_c'] + 1)\n        if area < min_area:\n            min_area = area\n            target_color = val\n            \n    bbox = colors[target_color]\n    \n    output = []\n    for r in range(bbox['min_r'], bbox['max_r'] + 1):\n        row = []\n        for c in range(bbox['min_c'], bbox['max_c'] + 1):\n            val = grid[r][c]\n            if val == target_color:\n                row.append(val)\n            else:\n                row.append(0)\n        output.append(row)\n        \n    return output\n```",
  "script": "def solve(grid):\n    colors = {}\n    for r in range(len(grid)):\n        for c in range(len(grid[r])):\n            val = grid[r][c]\n            if val != 0:\n                if val not in colors:\n                    colors[val] = {'min_r': r, 'max_r': r, 'min_c': c, 'max_c': c}\n                else:\n                    colors[val]['min_r'] = min(colors[val]['min_r'], r)\n                    colors[val]['max_r'] = max(colors[val]['max_r'], r)\n                    colors[val]['min_c'] = min(colors[val]['min_c'], c)\n                    colors[val]['max_c'] = max(colors[val]['max_c'], c)\n    \n    target_color = None\n    min_area = float('inf')\n    \n    for val, bbox in colors.items():\n        area = (bbox['max_r'] - bbox['min_r'] + 1) * (bbox['max_c'] - bbox['min_c'] + 1)\n        if area < min_area:\n            min_area = area\n            target_color = val\n            \n    bbox = colors[target_color]\n    \n    output = []\n    for r in range(bbox['min_r'], bbox['max_r'] + 1):\n        row = []\n        for c in range(bbox['min_c'], bbox['max_c'] + 1):\n            val = grid[r][c]\n            if val == target_color:\n                row.append(val)\n            else:\n                row.append(0)\n        output.append(row)\n        \n    return output",
