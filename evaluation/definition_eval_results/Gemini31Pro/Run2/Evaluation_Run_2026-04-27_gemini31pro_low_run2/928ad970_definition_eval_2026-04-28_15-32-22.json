  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out_grid = [row[:] for row in grid]\n    \n    fives_r = []\n    fives_c = []\n    draw_color = None\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 5:\n                fives_r.append(r)\n                fives_c.append(c)\n            elif grid[r][c] != 0:\n                draw_color = grid[r][c]\n                \n    if not fives_r or draw_color is None:\n        return out_grid\n        \n    min_r = min(fives_r)\n    max_r = max(fives_r)\n    min_c = min(fives_c)\n    max_c = max(fives_c)\n    \n    top = min_r + 1\n    bottom = max_r - 1\n    left = min_c + 1\n    right = max_c - 1\n    \n    for c in range(left, right + 1):\n        if out_grid[top][c] == 0:\n            out_grid[top][c] = draw_color\n        if out_grid[bottom][c] == 0:\n            out_grid[bottom][c] = draw_color\n            \n    for r in range(top, bottom + 1):\n        if out_grid[r][left] == 0:\n            out_grid[r][left] = draw_color\n        if out_grid[r][right] == 0:\n            out_grid[r][right] = draw_color\n            \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out_grid = [row[:] for row in grid]\n    \n    fives_r = []\n    fives_c = []\n    draw_color = None\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 5:\n                fives_r.append(r)\n                fives_c.append(c)\n            elif grid[r][c] != 0:\n                draw_color = grid[r][c]\n                \n    if not fives_r or draw_color is None:\n        return out_grid\n        \n    min_r = min(fives_r)\n    max_r = max(fives_r)\n    min_c = min(fives_c)\n    max_c = max(fives_c)\n    \n    top = min_r + 1\n    bottom = max_r - 1\n    left = min_c + 1\n    right = max_c - 1\n    \n    for c in range(left, right + 1):\n        if out_grid[top][c] == 0:\n            out_grid[top][c] = draw_color\n        if out_grid[bottom][c] == 0:\n            out_grid[bottom][c] = draw_color\n            \n    for r in range(top, bottom + 1):\n        if out_grid[r][left] == 0:\n            out_grid[r][left] = draw_color\n        if out_grid[r][right] == 0:\n            out_grid[r][right] = draw_color\n            \n    return out_grid",
