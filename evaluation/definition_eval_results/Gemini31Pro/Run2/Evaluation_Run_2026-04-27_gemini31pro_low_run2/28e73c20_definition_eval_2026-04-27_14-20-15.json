  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    if R == 0 or C == 0:\n        return grid\n        \n    out = [[0]*C for _ in range(R)]\n    out[0][0] = 3\n    \n    r, c = 0, 0\n    dr, dc = 0, 1\n    \n    while True:\n        nr, nc = r + dr, c + dc\n        nnr, nnc = r + 2*dr, c + 2*dc\n        \n        turn = False\n        if not (0 <= nr < R and 0 <= nc < C):\n            turn = True\n        elif (0 <= nnr < R and 0 <= nnc < C) and out[nnr][nnc] == 3:\n            turn = True\n            \n        if turn:\n            dr, dc = dc, -dr\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < R and 0 <= nc < C) or out[nr][nc] == 3:\n                break\n                \n        if out[nr][nc] == 3:\n            break\n            \n        r, c = nr, nc\n        out[r][c] = 3\n        \n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    if R == 0 or C == 0:\n        return grid\n        \n    out = [[0]*C for _ in range(R)]\n    out[0][0] = 3\n    \n    r, c = 0, 0\n    dr, dc = 0, 1\n    \n    while True:\n        nr, nc = r + dr, c + dc\n        nnr, nnc = r + 2*dr, c + 2*dc\n        \n        turn = False\n        if not (0 <= nr < R and 0 <= nc < C):\n            turn = True\n        elif (0 <= nnr < R and 0 <= nnc < C) and out[nnr][nnc] == 3:\n            turn = True\n            \n        if turn:\n            dr, dc = dc, -dr\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < R and 0 <= nc < C) or out[nr][nc] == 3:\n                break\n                \n        if out[nr][nc] == 3:\n            break\n            \n        r, c = nr, nc\n        out[r][c] = 3\n        \n    return out",
