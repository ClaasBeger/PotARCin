  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    out_grid = [[0 for _ in range(W)] for _ in range(H)]\n    \n    bottom_2 = [-1] * W\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 2:\n                out_grid[r][c] = 2\n                if r > bottom_2[c]:\n                    bottom_2[c] = r\n                    \n    visited = set()\n    components = []\n    \n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 5 and (r, c) not in visited:\n                comp = []\n                queue = [(r, c)]\n                visited.add((r, c))\n                while queue:\n                    curr_r, curr_c = queue.pop(0)\n                    comp.append((curr_r, curr_c))\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < H and 0 <= nc < W:\n                            if grid[nr][nc] == 5 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                queue.append((nr, nc))\n                components.append(comp)\n                \n    for comp in components:\n        cols = list(set(c for r, c in comp))\n        top_5 = {}\n        for c in cols:\n            top_5[c] = min(r for r, c_ in comp if c_ == c)\n            \n        min_c = min(cols)\n        max_c = max(cols)\n        \n        for dx in range(-min_c, W - max_c):\n            valid = True\n            first_diff = None\n            for c in cols:\n                diff = top_5[c] - bottom_2[c + dx]\n                if first_diff is None:\n                    first_diff = diff\n                elif diff != first_diff:\n                    valid = False\n                    break\n            if valid:\n                dy = first_diff - 1\n                for r, c in comp:\n                    out_grid[r - dy][c + dx] = 1\n                break\n                \n    return out_grid",
