  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n        \n    R = len(grid)\n    C = len(grid[0])\n    \n    visited = set()\n    queue = []\n    \n    # Add all boundary cells that are 0 to the queue\n    for r in range(R):\n        for c in [0, C - 1]:\n            if grid[r][c] == 0:\n                queue.append((r, c))\n                visited.add((r, c))\n                \n    for c in range(C):\n        for r in [0, R - 1]:\n            if (r, c) not in visited and grid[r][c] == 0:\n                queue.append((r, c))\n                visited.add((r, c))\n                \n    # BFS to find all 0s connected to the boundary\n    while queue:\n        r, c = queue.pop(0)\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < R and 0 <= nc < C:\n                if (nr, nc) not in visited and grid[nr][nc] == 0:\n                    visited.add((nr, nc))\n                    queue.append((nr, nc))\n                    \n    # Create the output grid and fill enclosed 0s with 4\n    out_grid = [row[:] for row in grid]\n    for r in range(R):\n        for c in range(C):\n            if out_grid[r][c] == 0 and (r, c) not in visited:\n                out_grid[r][c] = 4\n                \n    return out_grid\n```",
  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n        \n    R = len(grid)\n    C = len(grid[0])\n    \n    visited = set()\n    queue = []\n    \n    # Add all boundary cells that are 0 to the queue\n    for r in range(R):\n        for c in [0, C - 1]:\n            if grid[r][c] == 0:\n                queue.append((r, c))\n                visited.add((r, c))\n                \n    for c in range(C):\n        for r in [0, R - 1]:\n            if (r, c) not in visited and grid[r][c] == 0:\n                queue.append((r, c))\n                visited.add((r, c))\n                \n    # BFS to find all 0s connected to the boundary\n    while queue:\n        r, c = queue.pop(0)\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < R and 0 <= nc < C:\n                if (nr, nc) not in visited and grid[nr][nc] == 0:\n                    visited.add((nr, nc))\n                    queue.append((nr, nc))\n                    \n    # Create the output grid and fill enclosed 0s with 4\n    out_grid = [row[:] for row in grid]\n    for r in range(R):\n        for c in range(C):\n            if out_grid[r][c] == 0 and (r, c) not in visited:\n                out_grid[r][c] = 4\n                \n    return out_grid",
