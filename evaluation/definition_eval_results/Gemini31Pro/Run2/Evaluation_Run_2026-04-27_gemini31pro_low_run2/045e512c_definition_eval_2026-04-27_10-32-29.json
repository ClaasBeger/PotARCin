  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Count frequencies of each color to find the template shape\n    counts = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n                \n    if not counts:\n        return [row[:] for row in grid]\n        \n    T = max(counts, key=counts.get)\n    \n    # Find bounding box of the template color T\n    T_r = []\n    T_c = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == T:\n                T_r.append(r)\n                T_c.append(c)\n                \n    rt, rb = min(T_r), max(T_r)\n    ct, cb = min(T_c), max(T_c)\n    \n    # Center of the 3x3 bounding box\n    rc = rt + 1\n    cc = ct + 1\n    \n    # Extract the 3x3 boolean pattern\n    pattern = [[False]*3 for _ in range(3)]\n    for r in range(rt, rb+1):\n        for c in range(ct, cb+1):\n            if grid[r][c] == T:\n                # Store relative to the top-left of the 3x3 box\n                pattern[r-rt][c-ct] = True\n                \n    out = [[0]*C for _ in range(R)]\n    \n    # Helper function to draw the template at a grid coordinate (k, m)\n    def draw(k, m, color):\n        for i in range(3):\n            for j in range(3):\n                if pattern[i][j]:\n                    rr = rc - 1 + k * 4 + i\n                    cc_ = cc - 1 + m * 4 + j\n                    if 0 <= rr < R and 0 <= cc_ < C:\n                        out[rr][cc_] = color\n\n    # Draw the central template\n    draw(0, 0, T)\n    \n    # Identify rays from seed pixels\n    rays = set()\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0 and v != T:\n                # Find which 4x4 sector this pixel belongs to\n                k = (r - rc + 2) // 4\n                m = (c - cc + 2) // 4\n                if k != 0 or m != 0:\n                    rays.add((k, m, v))\n                    \n    # Draw all rays extending outwards\n    for k, m, v in rays:\n        # Determine the step direction based on the initial sector\n        dk = (k > 0) - (k < 0)\n        dm = (m > 0) - (m < 0)\n        \n        curr_k, curr_m = k, m\n        # Extend safely across the grid\n        for _ in range(max(R, C) // 4 + 2):\n            draw(curr_k, curr_m, v)\n            curr_k += dk\n            curr_m += dm\n            \n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Count frequencies of each color to find the template shape\n    counts = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n                \n    if not counts:\n        return [row[:] for row in grid]\n        \n    T = max(counts, key=counts.get)\n    \n    # Find bounding box of the template color T\n    T_r = []\n    T_c = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == T:\n                T_r.append(r)\n                T_c.append(c)\n                \n    rt, rb = min(T_r), max(T_r)\n    ct, cb = min(T_c), max(T_c)\n    \n    # Center of the 3x3 bounding box\n    rc = rt + 1\n    cc = ct + 1\n    \n    # Extract the 3x3 boolean pattern\n    pattern = [[False]*3 for _ in range(3)]\n    for r in range(rt, rb+1):\n        for c in range(ct, cb+1):\n            if grid[r][c] == T:\n                # Store relative to the top-left of the 3x3 box\n                pattern[r-rt][c-ct] = True\n                \n    out = [[0]*C for _ in range(R)]\n    \n    # Helper function to draw the template at a grid coordinate (k, m)\n    def draw(k, m, color):\n        for i in range(3):\n            for j in range(3):\n                if pattern[i][j]:\n                    rr = rc - 1 + k * 4 + i\n                    cc_ = cc - 1 + m * 4 + j\n                    if 0 <= rr < R and 0 <= cc_ < C:\n                        out[rr][cc_] = color\n\n    # Draw the central template\n    draw(0, 0, T)\n    \n    # Identify rays from seed pixels\n    rays = set()\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0 and v != T:\n                # Find which 4x4 sector this pixel belongs to\n                k = (r - rc + 2) // 4\n                m = (c - cc + 2) // 4\n                if k != 0 or m != 0:\n                    rays.add((k, m, v))\n                    \n    # Draw all rays extending outwards\n    for k, m, v in rays:\n        # Determine the step direction based on the initial sector\n        dk = (k > 0) - (k < 0)\n        dm = (m > 0) - (m < 0)\n        \n        curr_k, curr_m = k, m\n        # Extend safely across the grid\n        for _ in range(max(R, C) // 4 + 2):\n            draw(curr_k, curr_m, v)\n            curr_k += dk\n            curr_m += dm\n            \n    return out",
