  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return []\n\n    # Find the bounding box of non-zero elements\n    non_empty_rows = [i for i, row in enumerate(grid) if any(val != 0 for val in row)]\n    if not non_empty_rows:\n        return []\n    min_r, max_r = non_empty_rows[0], non_empty_rows[-1]\n    \n    non_empty_cols = [j for j in range(len(grid[0])) if any(grid[i][j] != 0 for i in range(len(grid)))]\n    min_c, max_c = non_empty_cols[0], non_empty_cols[-1]\n    \n    # Extract the subgrid\n    subgrid = [row[min_c:max_c+1] for row in grid[min_r:max_r+1]]\n    \n    # Compress adjacent identical rows\n    comp_rows = [subgrid[0]]\n    for row in subgrid[1:]:\n        if row != comp_rows[-1]:\n            comp_rows.append(row)\n            \n    # Transpose to process columns\n    transposed = list(zip(*comp_rows))\n    \n    # Compress adjacent identical columns\n    comp_cols = [transposed[0]]\n    for col in transposed[1:]:\n        if col != comp_cols[-1]:\n            comp_cols.append(col)\n            \n    # Transpose back to get the final result\n    result = [list(row) for row in zip(*comp_cols)]\n    \n    return result",
