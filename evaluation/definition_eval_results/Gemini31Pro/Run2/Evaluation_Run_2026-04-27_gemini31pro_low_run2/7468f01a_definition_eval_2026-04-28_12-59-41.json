  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    \n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    if min_r == rows:\n        return []\n        \n    out = []\n    for r in range(min_r, max_r + 1):\n        row_slice = grid[r][min_c : max_c + 1]\n        out.append(row_slice[::-1])\n        \n    return out\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    \n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    if min_r == rows:\n        return []\n        \n    out = []\n    for r in range(min_r, max_r + 1):\n        row_slice = grid[r][min_c : max_c + 1]\n        out.append(row_slice[::-1])\n        \n    return out",
