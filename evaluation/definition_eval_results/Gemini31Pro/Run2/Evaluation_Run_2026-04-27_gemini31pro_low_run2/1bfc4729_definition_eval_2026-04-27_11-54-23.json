  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    c1 = 0\n    c2 = 0\n    \n    for i in range(H // 2):\n        for j in range(W):\n            if grid[i][j] != 0:\n                c1 = grid[i][j]\n                \n    for i in range(H // 2, H):\n        for j in range(W):\n            if grid[i][j] != 0:\n                c2 = grid[i][j]\n                \n    out = [[0] * W for _ in range(H)]\n    \n    for i in range(H):\n        for j in range(W):\n            if i < H // 2:\n                if i == 0 or i == 2 or j == 0 or j == W - 1:\n                    out[i][j] = c1\n            else:\n                if i == H - 1 or i == H - 3 or j == 0 or j == W - 1:\n                    out[i][j] = c2\n                    \n    return out\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    c1 = 0\n    c2 = 0\n    \n    for i in range(H // 2):\n        for j in range(W):\n            if grid[i][j] != 0:\n                c1 = grid[i][j]\n                \n    for i in range(H // 2, H):\n        for j in range(W):\n            if grid[i][j] != 0:\n                c2 = grid[i][j]\n                \n    out = [[0] * W for _ in range(H)]\n    \n    for i in range(H):\n        for j in range(W):\n            if i < H // 2:\n                if i == 0 or i == 2 or j == 0 or j == W - 1:\n                    out[i][j] = c1\n            else:\n                if i == H - 1 or i == H - 3 or j == 0 or j == W - 1:\n                    out[i][j] = c2\n                    \n    return out",
