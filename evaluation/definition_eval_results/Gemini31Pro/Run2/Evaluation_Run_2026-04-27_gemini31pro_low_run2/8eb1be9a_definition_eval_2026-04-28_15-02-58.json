  "raw_response": "def solve(grid):\n    non_empty_indices = [i for i, row in enumerate(grid) if any(val != 0 for val in row)]\n    \n    if not non_empty_indices:\n        return grid\n        \n    r_start = min(non_empty_indices)\n    r_end = max(non_empty_indices)\n    \n    block = grid[r_start:r_end+1]\n    block_size = len(block)\n    \n    output = []\n    for i in range(len(grid)):\n        row_index = (i - r_start) % block_size\n        output.append(list(block[row_index]))\n        \n    return output",
