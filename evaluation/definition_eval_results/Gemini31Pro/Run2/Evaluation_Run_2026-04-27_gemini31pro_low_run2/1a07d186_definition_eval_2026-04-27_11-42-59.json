  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    lines = []\n    \n    # Find horizontal lines\n    for r in range(R):\n        first_val = grid[r][0]\n        if first_val != 0 and all(grid[r][c] == first_val for c in range(C)):\n            lines.append(('H', r, first_val))\n            \n    # Find vertical lines\n    for c in range(C):\n        first_val = grid[0][c]\n        if first_val != 0 and all(grid[r][c] == first_val for r in range(R)):\n            lines.append(('V', c, first_val))\n            \n    output = [[0] * C for _ in range(R)]\n    \n    # Draw lines on the output grid\n    for ltype, idx, color in lines:\n        if ltype == 'H':\n            for c in range(C):\n                output[idx][c] = color\n        else:\n            for r in range(R):\n                output[r][idx] = color\n                \n    # Process scattered pixels\n    for r in range(R):\n        for c in range(C):\n            val = grid[r][c]\n            if val == 0:\n                continue\n                \n            # Check if this pixel is part of a line\n            on_line = False\n            for ltype, idx, color in lines:\n                if ltype == 'H' and r == idx:\n                    on_line = True\n                if ltype == 'V' and c == idx:\n                    on_line = True\n            \n            if not on_line:\n                # Find matching line to snap to\n                for ltype, idx, color in lines:\n                    if color == val:\n                        if ltype == 'H':\n                            new_r = idx - 1 if r < idx else idx + 1\n                            if 0 <= new_r < R:\n                                output[new_r][c] = val\n                        else:\n                            new_c = idx - 1 if c < idx else idx + 1\n                            if 0 <= new_c < C:\n                                output[r][new_c] = val\n\n    return output\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    lines = []\n    \n    # Find horizontal lines\n    for r in range(R):\n        first_val = grid[r][0]\n        if first_val != 0 and all(grid[r][c] == first_val for c in range(C)):\n            lines.append(('H', r, first_val))\n            \n    # Find vertical lines\n    for c in range(C):\n        first_val = grid[0][c]\n        if first_val != 0 and all(grid[r][c] == first_val for r in range(R)):\n            lines.append(('V', c, first_val))\n            \n    output = [[0] * C for _ in range(R)]\n    \n    # Draw lines on the output grid\n    for ltype, idx, color in lines:\n        if ltype == 'H':\n            for c in range(C):\n                output[idx][c] = color\n        else:\n            for r in range(R):\n                output[r][idx] = color\n                \n    # Process scattered pixels\n    for r in range(R):\n        for c in range(C):\n            val = grid[r][c]\n            if val == 0:\n                continue\n                \n            # Check if this pixel is part of a line\n            on_line = False\n            for ltype, idx, color in lines:\n                if ltype == 'H' and r == idx:\n                    on_line = True\n                if ltype == 'V' and c == idx:\n                    on_line = True\n            \n            if not on_line:\n                # Find matching line to snap to\n                for ltype, idx, color in lines:\n                    if color == val:\n                        if ltype == 'H':\n                            new_r = idx - 1 if r < idx else idx + 1\n                            if 0 <= new_r < R:\n                                output[new_r][c] = val\n                        else:\n                            new_c = idx - 1 if c < idx else idx + 1\n                            if 0 <= new_c < C:\n                                output[r][new_c] = val\n\n    return output",
