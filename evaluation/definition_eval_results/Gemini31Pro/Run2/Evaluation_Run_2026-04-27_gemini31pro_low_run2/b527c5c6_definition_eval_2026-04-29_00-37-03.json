  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    # Find all 2s\n    twos = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 2:\n                twos.append((r, c))\n                \n    for r2, c2 in twos:\n        # Find the block of 3s (and 2) containing (r2, c2)\n        min_r, max_r = r2, r2\n        while min_r > 0 and grid[min_r - 1][c2] in (2, 3):\n            min_r -= 1\n        while max_r < R - 1 and grid[max_r + 1][c2] in (2, 3):\n            max_r += 1\n            \n        min_c, max_c = c2, c2\n        while min_c > 0 and grid[r2][min_c - 1] in (2, 3):\n            min_c -= 1\n        while max_c < C - 1 and grid[r2][max_c + 1] in (2, 3):\n            max_c += 1\n            \n        # Determine the edge the 2 is on and expand\n        if r2 == min_r and max_r > min_r:\n            # Top edge, expands UP\n            D = max_r - min_r\n            start_c = max(min_c + 1, c2 - D + 1) if c2 - D == min_c else max(min_c, c2 - D)\n            end_c = min(max_c - 1, c2 + D - 1) if c2 + D == max_c else min(max_c, c2 + D)\n            for r in range(r2 - 1, -1, -1):\n                for c in range(start_c, end_c + 1):\n                    out[r][c] = 2 if c == c2 else 3\n        elif r2 == max_r and max_r > min_r:\n            # Bottom edge, expands DOWN\n            D = max_r - min_r\n            start_c = max(min_c + 1, c2 - D + 1) if c2 - D == min_c else max(min_c, c2 - D)\n            end_c = min(max_c - 1, c2 + D - 1) if c2 + D == max_c else min(max_c, c2 + D)\n            for r in range(r2 + 1, R):\n                for c in range(start_c, end_c + 1):\n                    out[r][c] = 2 if c == c2 else 3\n        elif c2 == min_c and max_c > min_c:\n            # Left edge, expands LEFT\n            D = max_c - min_c\n            start_r = max(min_r + 1, r2 - D + 1) if r2 - D == min_r else max(min_r, r2 - D)\n            end_r = min