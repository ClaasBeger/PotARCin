  "raw_response": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    visited = [[False] * C for _ in range(R)]\n    out = [[0] * C for _ in range(R)]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0 and not visited[r][c]:\n                comp = []\n                q = [(r, c)]\n                visited[r][c] = True\n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < R and 0 <= nc < C and not visited[nr][nc] and grid[nr][nc] != 0:\n                            visited[nr][nc] = True\n                            q.append((nr, nc))\n                \n                color = 2 if len(comp) == 6 else 1\n                for cr, cc in comp:\n                    out[cr][cc] = color\n                    \n    return out",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    visited = [[False] * C for _ in range(R)]\n    out = [[0] * C for _ in range(R)]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0 and not visited[r][c]:\n                comp = []\n                q = [(r, c)]\n                visited[r][c] = True\n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < R and 0 <= nc < C and not visited[nr][nc] and grid[nr][nc] != 0:\n                            visited[nr][nc] = True\n                            q.append((nr, nc))\n                \n                color = 2 if len(comp) == 6 else 1\n                for cr, cc in comp:\n                    out[cr][cc] = color\n                    \n    return out",
