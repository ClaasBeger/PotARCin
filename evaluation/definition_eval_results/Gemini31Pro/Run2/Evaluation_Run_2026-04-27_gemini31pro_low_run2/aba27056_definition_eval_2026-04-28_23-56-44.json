  "raw_response": "```python\ndef solve(grid):\n    height = len(grid)\n    width = len(grid[0])\n    \n    # Find the shape color\n    color = 0\n    for r in range(height):\n        for c in range(width):\n            if grid[r][c] != 0:\n                color = grid[r][c]\n                break\n        if color != 0:\n            break\n            \n    if color == 0:\n        return grid\n        \n    out = [row[:] for row in grid]\n    \n    # Find bounding box of the shape\n    min_r, max_r = height, -1\n    min_c, max_c = width, -1\n    for r in range(height):\n        for c in range(width):\n            if grid[r][c] == color:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    # Determine the opening direction by checking the borders of the bounding box\n    top_open = False\n    bottom_open = False\n    left_open = False\n    right_open = False\n    \n    top_count = sum(1 for c in range(min_c, max_c + 1) if grid[min_r][c] == color)\n    bottom_count = sum(1 for c in range(min_c, max_c + 1) if grid[max_r][c] == color)\n    left_count = sum(1 for r in range(min_r, max_r + 1) if grid[r][min_c] == color)\n    right_count = sum(1 for r in range(min_r, max_r + 1) if grid[r][max_c] == color)\n    \n    if top_count < (max_c - min_c): top_open = True\n    if bottom_count < (max_c - min_c): bottom_open = True\n    if left_count < (max_r - min_r): left_open = True\n    if right_count < (max_r - min_r): right_open = True\n    \n    # Simple interior check\n    for r in range(min_r, max_r + 1):\n        for c in range(min_c, max_c + 1):\n            if grid[r][c] == 0:\n                # check if enclosed\n                enclosed = True\n                if top_open and r == min_r: enclosed = False\n                if bottom_open and r == max_r: enclosed = False\n                if left_open and c == min_c: enclosed = False\n                if right_open and c == max_c: enclosed = False\n                out[r][c] = 4\n\n    # Project rays\n    for r in range(height):\n        for c in range(width):\n            if out[r][c] == 4 and grid[r][c] == 0:\n                # Find corresponding emission direction\n                if top_open:\n                    for i in range(1, height):\n                        nr, nc = r - i, c\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                        nr, nc = r - i, c - i\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                        nr, nc = r - i, c + i\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                elif bottom_open:\n                    for i in range(1, height):\n                        nr, nc = r + i, c\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                        nr, nc = r + i, c - i\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                        nr, nc = r + i, c + i\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                elif right_open:\n                    for i in range(1, width):\n                        nr, nc = r, c + i\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                        nr, nc = r - i, c + i\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                        nr, nc = r + i, c + i\n                        if 0 <= nr < height and 0 <= nc < width and out[nr][nc] == 0: out[nr][nc] = 4\n                elif left_open:\n                    for i in range(1, width):\n                        nr, nc = r, c - i\n                        