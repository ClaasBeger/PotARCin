  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    out = [[0] * W for _ in range(H)]\n    \n    eights = []\n    twos = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n            elif grid[r][c] == 2:\n                twos.append((r, c))\n                out[r][c] = 2\n\n    if not eights:\n        return out\n\n    is_top = all(r == 0 for r, c in eights)\n    is_bottom = all(r == H - 1 for r, c in eights)\n    is_left = all(c == 0 for r, c in eights)\n    is_right = all(c == W - 1 for r, c in eights)\n\n    shift_r = 0\n    shift_c = 0\n    shift_indices = set()\n    \n    if is_top or is_bottom:\n        if twos:\n            c2 = twos[0][1]\n            if c2 == 0:\n                shift_c = 1\n            else:\n                shift_c = -1\n            shift_indices = set(r for r, c in twos)\n            \n        for r8, c8 in eights:\n            cur_c = c8\n            rows = range(H) if is_top else range(H - 1, -1, -1)\n            for r in rows:\n                if r in shift_indices:\n                    cur_c += shift_c\n                if 0 <= cur_c < W:\n                    out[r][cur_c] = 8\n                    \n    elif is_left or is_right:\n        if twos:\n            r2 = twos[0][0]\n            if r2 == 0:\n                shift_r = 1\n            else:\n                shift_r = -1\n            shift_indices = set(c for r, c in twos)\n            \n        for r8, c8 in eights:\n            cur_r = r8\n            cols = range(W) if is_left else range(W - 1, -1, -1)\n            for c in cols:\n                if c in shift_indices:\n                    cur_r += shift_r\n                if 0 <= cur_r < H:\n                    out[cur_r][c] = 8\n\n    return out\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    out = [[0] * W for _ in range(H)]\n    \n    eights = []\n    twos = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n            elif grid[r][c] == 2:\n                twos.append((r, c))\n                out[r][c] = 2\n\n    if not eights:\n        return out\n\n    is_top = all(r == 0 for r, c in eights)\n    is_bottom = all(r == H - 1 for r, c in eights)\n    is_left = all(c == 0 for r, c in eights)\n    is_right = all(c == W - 1 for r, c in eights)\n\n    shift_r = 0\n    shift_c = 0\n    shift_indices = set()\n    \n    if is_top or is_bottom:\n        if twos:\n            c2 = twos[0][1]\n            if c2 == 0:\n                shift_c = 1\n            else:\n                shift_c = -1\n            shift_indices = set(r for r, c in twos)\n            \n        for r8, c8 in eights:\n            cur_c = c8\n            rows = range(H) if is_top else range(H - 1, -1, -1)\n            for r in rows:\n                if r in shift_indices:\n                    cur_c += shift_c\n                if 0 <= cur_c < W:\n                    out[r][cur_c] = 8\n                    \n    elif is_left or is_right:\n        if twos:\n            r2 = twos[0][0]\n            if r2 == 0:\n                shift_r = 1\n            else:\n                shift_r = -1\n            shift_indices = set(c for r, c in twos)\n            \n        for r8, c8 in eights:\n            cur_r = r8\n            cols = range(W) if is_left else range(W - 1, -1, -1)\n            for c in cols:\n                if c in shift_indices:\n                    cur_r += shift_r\n                if 0 <= cur_r < H:\n                    out[cur_r][c] = 8\n\n    return out",
