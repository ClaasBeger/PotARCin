  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Create output grid and remove all 5s initially\n    out_grid = [[grid[r][c] if grid[r][c] != 5 else 0 for c in range(C)] for r in range(R)]\n    \n    rows_2 = set()\n    cols_2 = set()\n    fives = []\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 2:\n                rows_2.add(r)\n                cols_2.add(c)\n            elif grid[r][c] == 5:\n                fives.append((r, c))\n                \n    rows_2 = sorted(list(rows_2))\n    cols_2 = sorted(list(cols_2))\n    \n    if not rows_2:\n        return out_grid\n        \n    if len(rows_2) < len(cols_2):\n        # Horizontal brackets\n        top_out, top_in = rows_2[0], rows_2[1]\n        bot_in, bot_out = rows_2[-2], rows_2[-1]\n        mid_r = (top_in + bot_in) / 2\n        for r, c in fives:\n            if r < mid_r:\n                new_r = top_out + top_in - r - 1\n                new_c = c\n            else:\n                new_r = bot_out + bot_in - r + 1\n                new_c = c\n            if 0 <= new_r < R and 0 <= new_c < C:\n                out_grid[new_r][new_c] = 5\n    else:\n        # Vertical brackets\n        left_out, left_in = cols_2[0], cols_2[1]\n        right_in, right_out = cols_2[-2], cols_2[-1]\n        mid_c = (left_in + right_in) / 2\n        for r, c in fives:\n            if c < mid_c:\n                new_c = left_out + left_in - c - 1\n                new_r = r\n            else:\n                new_c = right_out + right_in - c + 1\n                new_r = r\n            if 0 <= new_r < R and 0 <= new_c < C:\n                out_grid[new_r][new_c] = 5\n                \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Create output grid and remove all 5s initially\n    out_grid = [[grid[r][c] if grid[r][c] != 5 else 0 for c in range(C)] for r in range(R)]\n    \n    rows_2 = set()\n    cols_2 = set()\n    fives = []\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 2:\n                rows_2.add(r)\n                cols_2.add(c)\n            elif grid[r][c] == 5:\n                fives.append((r, c))\n                \n    rows_2 = sorted(list(rows_2))\n    cols_2 = sorted(list(cols_2))\n    \n    if not rows_2:\n        return out_grid\n        \n    if len(rows_2) < len(cols_2):\n        # Horizontal brackets\n        top_out, top_in = rows_2[0], rows_2[1]\n        bot_in, bot_out = rows_2[-2], rows_2[-1]\n        mid_r = (top_in + bot_in) / 2\n        for r, c in fives:\n            if r < mid_r:\n                new_r = top_out + top_in - r - 1\n                new_c = c\n            else:\n                new_r = bot_out + bot_in - r + 1\n                new_c = c\n            if 0 <= new_r < R and 0 <= new_c < C:\n                out_grid[new_r][new_c] = 5\n    else:\n        # Vertical brackets\n        left_out, left_in = cols_2[0], cols_2[1]\n        right_in, right_out = cols_2[-2], cols_2[-1]\n        mid_c = (left_in + right_in) / 2\n        for r, c in fives:\n            if c < mid_c:\n                new_c = left_out + left_in - c - 1\n                new_r = r\n            else:\n                new_c = right_out + right_in - c + 1\n                new_r = r\n            if 0 <= new_r < R and 0 <= new_c < C:\n                out_grid[new_r][new_c] = 5\n                \n    return out_grid",
