  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    # Find all seeds (colored pixels)\n    seeds = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] > 0:\n                seeds.append((r, c, grid[r][c]))\n                \n    output = [[0 for _ in range(W)] for _ in range(H)]\n    \n    for r in range(H):\n        for c in range(W):\n            min_dist = float('inf')\n            closest_seeds = []\n            \n            for sr, sc, color in seeds:\n                manhattan_dist = abs(r - sr) + abs(c - sc)\n                if manhattan_dist < min_dist:\n                    min_dist = manhattan_dist\n                    closest_seeds = [(sr, sc, color)]\n                elif manhattan_dist == min_dist:\n                    closest_seeds.append((sr, sc, color))\n            \n            if len(closest_seeds) == 1:\n                sr, sc, color = closest_seeds[0]\n                chebyshev_dist = max(abs(r - sr), abs(c - sc))\n                if chebyshev_dist % 2 == 0:\n                    output[r][c] = color\n                    \n    return output\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    # Find all seeds (colored pixels)\n    seeds = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] > 0:\n                seeds.append((r, c, grid[r][c]))\n                \n    output = [[0 for _ in range(W)] for _ in range(H)]\n    \n    for r in range(H):\n        for c in range(W):\n            min_dist = float('inf')\n            closest_seeds = []\n            \n            for sr, sc, color in seeds:\n                manhattan_dist = abs(r - sr) + abs(c - sc)\n                if manhattan_dist < min_dist:\n                    min_dist = manhattan_dist\n                    closest_seeds = [(sr, sc, color)]\n                elif manhattan_dist == min_dist:\n                    closest_seeds.append((sr, sc, color))\n            \n            if len(closest_seeds) == 1:\n                sr, sc, color = closest_seeds[0]\n                chebyshev_dist = max(abs(r - sr), abs(c - sc))\n                if chebyshev_dist % 2 == 0:\n                    output[r][c] = color\n                    \n    return output",
