  "raw_response": "```python\ndef solve(grid):\n    counts = {}\n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val != 0:\n                counts[val] = counts.get(val, 0) + 1\n    \n    unique_color = min(counts, key=counts.get)\n    \n    min_r, max_r = len(grid), -1\n    min_c, max_c = len(grid[0]), -1\n    \n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val == unique_color:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    output = []\n    for r in range(min_r, max_r + 1):\n        output.append(grid[r][min_c:max_c + 1])\n        \n    return output\n```",
  "script": "def solve(grid):\n    counts = {}\n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val != 0:\n                counts[val] = counts.get(val, 0) + 1\n    \n    unique_color = min(counts, key=counts.get)\n    \n    min_r, max_r = len(grid), -1\n    min_c, max_c = len(grid[0]), -1\n    \n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val == unique_color:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    output = []\n    for r in range(min_r, max_r + 1):\n        output.append(grid[r][min_c:max_c + 1])\n        \n    return output",
