  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find the distinct colors and their bounding boxes\n    boxes = {}\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0:\n                if val not in boxes:\n                    boxes[val] = [r, r, c, c] # min_r, max_r, min_c, max_c\n                else:\n                    boxes[val][0] = min(boxes[val][0], r)\n                    boxes[val][1] = max(boxes[val][1], r)\n                    boxes[val][2] = min(boxes[val][2], c)\n                    boxes[val][3] = max(boxes[val][3], c)\n                    \n    colors = list(boxes.keys())\n    if len(colors) == 2:\n        box1 = boxes[colors[0]]\n        box2 = boxes[colors[1]]\n        \n        r1_min, r1_max, c1_min, c1_max = box1\n        r2_min, r2_max, c2_min, c2_max = box2\n        \n        output = [row[:] for row in grid]\n        \n        # Check if separated horizontally\n        if c1_max < c2_min or c2_max < c1_min:\n            gap_c_min = min(c1_max, c2_max) + 1\n            gap_c_max = max(c1_min, c2_min) - 1\n            \n            overlap_r_min = max(r1_min, r2_min) + 1\n            overlap_r_max = min(r1_max, r2_max) - 1\n            \n            for r in range(overlap_r_min, overlap_r_max + 1):\n                for c in range(gap_c_min, gap_c_max + 1):\n                    output[r][c] = 8\n                    \n        # Check if separated vertically\n        elif r1_max < r2_min or r2_max < r1_min:\n            gap_r_min = min(r1_max, r2_max) + 1\n            gap_r_max = max(r1_min, r2_min) - 1\n            \n            overlap_c_min = max(c1_min, c2_min) + 1\n            overlap_c_max = min(c1_max, c2_max) - 1\n            \n            for r in range(gap_r_min, gap_r_max + 1):\n                for c in range(overlap_c_min, overlap_c_max + 1):\n                    output[r][c] = 8\n                    \n        return output\n    \n    return grid\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find the distinct colors and their bounding boxes\n    boxes = {}\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0:\n                if val not in boxes:\n                    boxes[val] = [r, r, c, c] # min_r, max_r, min_c, max_c\n                else:\n                    boxes[val][0] = min(boxes[val][0], r)\n                    boxes[val][1] = max(boxes[val][1], r)\n                    boxes[val][2] = min(boxes[val][2], c)\n                    boxes[val][3] = max(boxes[val][3], c)\n                    \n    colors = list(boxes.keys())\n    if len(colors) == 2:\n        box1 = boxes[colors[0]]\n        box2 = boxes[colors[1]]\n        \n        r1_min, r1_max, c1_min, c1_max = box1\n        r2_min, r2_max, c2_min, c2_max = box2\n        \n        output = [row[:] for row in grid]\n        \n        # Check if separated horizontally\n        if c1_max < c2_min or c2_max < c1_min:\n            gap_c_min = min(c1_max, c2_max) + 1\n            gap_c_max = max(c1_min, c2_min) - 1\n            \n            overlap_r_min = max(r1_min, r2_min) + 1\n            overlap_r_max = min(r1_max, r2_max) - 1\n            \n            for r in range(overlap_r_min, overlap_r_max + 1):\n                for c in range(gap_c_min, gap_c_max + 1):\n                    output[r][c] = 8\n                    \n        # Check if separated vertically\n        elif r1_max < r2_min or r2_max < r1_min:\n            gap_r_min = min(r1_max, r2_max) + 1\n            gap_r_max = max(r1_min, r2_min) - 1\n            \n            overlap_c_min = max(c1_min, c2_min) + 1\n            overlap_c_max = min(c1_max, c2_max) - 1\n            \n            for r in range(gap_r_min, gap_r_max + 1):\n                for c in range(overlap_c_min, overlap_c_max + 1):\n                    output[r][c] = 8\n                    \n        return output\n    \n    return grid",
