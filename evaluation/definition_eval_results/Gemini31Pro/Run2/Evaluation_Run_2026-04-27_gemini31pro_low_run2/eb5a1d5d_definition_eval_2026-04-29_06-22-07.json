  "raw_response": "```python\ndef solve(grid):\n    r1, r2 = 0, len(grid) - 1\n    c1, c2 = 0, len(grid[0]) - 1\n    \n    seq = []\n    while True:\n        C = grid[r1][c1]\n        seq.append(C)\n        \n        min_r, max_r = None, None\n        min_c, max_c = None, None\n        \n        for r in range(r1, r2 + 1):\n            for c in range(c1, c2 + 1):\n                if grid[r][c] != C:\n                    if min_r is None or r < min_r: min_r = r\n                    if max_r is None or r > max_r: max_r = r\n                    if min_c is None or c < min_c: min_c = c\n                    if max_c is None or c > max_c: max_c = c\n                    \n        if min_r is None:\n            break\n            \n        r1, r2 = min_r, max_r\n        c1, c2 = min_c, max_c\n\n    N = len(seq)\n    out_size = 2 * N - 1\n    out_grid = [[0] * out_size for _ in range(out_size)]\n    \n    for i in range(out_size):\n        for j in range(out_size):\n            layer = min(i, j, out_size - 1 - i, out_size - 1 - j)\n            out_grid[i][j] = seq[layer]\n            \n    return out_grid\n```",
  "script": "def solve(grid):\n    r1, r2 = 0, len(grid) - 1\n    c1, c2 = 0, len(grid[0]) - 1\n    \n    seq = []\n    while True:\n        C = grid[r1][c1]\n        seq.append(C)\n        \n        min_r, max_r = None, None\n        min_c, max_c = None, None\n        \n        for r in range(r1, r2 + 1):\n            for c in range(c1, c2 + 1):\n                if grid[r][c] != C:\n                    if min_r is None or r < min_r: min_r = r\n                    if max_r is None or r > max_r: max_r = r\n                    if min_c is None or c < min_c: min_c = c\n                    if max_c is None or c > max_c: max_c = c\n                    \n        if min_r is None:\n            break\n            \n        r1, r2 = min_r, max_r\n        c1, c2 = min_c, max_c\n\n    N = len(seq)\n    out_size = 2 * N - 1\n    out_grid = [[0] * out_size for _ in range(out_size)]\n    \n    for i in range(out_size):\n        for j in range(out_size):\n            layer = min(i, j, out_size - 1 - i, out_size - 1 - j)\n            out_grid[i][j] = seq[layer]\n            \n    return out_grid",
