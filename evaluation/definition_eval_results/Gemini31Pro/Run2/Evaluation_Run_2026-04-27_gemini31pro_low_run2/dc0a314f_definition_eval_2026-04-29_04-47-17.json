  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find bounding box of 3s\n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 3:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    output = []\n    for r in range(min_r, max_r + 1):\n        row_out = []\n        for c in range(min_c, max_c + 1):\n            # Check symmetric positions\n            candidates = [\n                grid[r][cols - 1 - c],\n                grid[rows - 1 - r][c],\n                grid[rows - 1 - r][cols - 1 - c]\n            ]\n            # Find a counterpart that is not 3\n            for val in candidates:\n                if val != 3:\n                    row_out.append(val)\n                    break\n        output.append(row_out)\n        \n    return output\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find bounding box of 3s\n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 3:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    output = []\n    for r in range(min_r, max_r + 1):\n        row_out = []\n        for c in range(min_c, max_c + 1):\n            # Check symmetric positions\n            candidates = [\n                grid[r][cols - 1 - c],\n                grid[rows - 1 - r][c],\n                grid[rows - 1 - r][cols - 1 - c]\n            ]\n            # Find a counterpart that is not 3\n            for val in candidates:\n                if val != 3:\n                    row_out.append(val)\n                    break\n        output.append(row_out)\n        \n    return output",
