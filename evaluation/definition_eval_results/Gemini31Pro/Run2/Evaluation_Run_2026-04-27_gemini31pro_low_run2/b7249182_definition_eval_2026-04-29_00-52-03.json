  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    points = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                points.append((r, c, grid[r][c]))\n    \n    if len(points) != 2:\n        return [row[:] for row in grid]\n        \n    p1, p2 = points\n    # Sort by row or col\n    if p1[1] == p2[1]: # Vertical\n        if p1[0] > p2[0]:\n            p1, p2 = p2, p1\n        r1, c, col1 = p1\n        r2, _, col2 = p2\n        \n        mid_f = (r1 + r2) // 2\n        mid_c = mid_f + 1\n        \n        cross_top = mid_f - 1\n        cross_bot = mid_c + 1\n        \n        out = [row[:] for row in grid]\n        \n        # Top shape\n        for r in range(r1, cross_top + 1):\n            out[r][c] = col1\n        for dc in [-2, -1, 0, 1, 2]:\n            if 0 <= c + dc < cols:\n                out[cross_top][c + dc] = col1\n        if 0 <= c - 2 < cols:\n            out[cross_top + 1][c - 2] = col1\n        if 0 <= c + 2 < cols:\n            out[cross_top + 1][c + 2] = col1\n            \n        # Bottom shape\n        for r in range(cross_bot, r2 + 1):\n            out[r][c] = col2\n        for dc in [-2, -1, 0, 1, 2]:\n            if 0 <= c + dc < cols:\n                out[cross_bot][c + dc] = col2\n        if 0 <= c - 2 < cols:\n            out[cross_bot - 1][c - 2] = col2\n        if 0 <= c + 2 < cols:\n            out[cross_bot - 1][c + 2] = col2\n            \n        return out\n        \n    elif p1[0] == p2[0]: # Horizontal\n        if p1[1] > p2[1]:\n            p1, p2 = p2, p1\n        r, c1, col1 = p1\n        _, c2, col2 = p2\n        \n        mid_f = (c1 + c2) // 2\n        mid_c = mid_f + 1\n        \n        cross_left = mid_f - 1\n        cross_right = mid_c + 1\n        \n        out = [row[:] for row in grid]\n        \n        # Left shape\n        for c in range(c1, cross_left + 1):\n            out[r][c] = col1\n        for dr in [-2, -1, 0, 1, 2]:\n            if 0 <= r + dr < rows:\n                out[r + dr][cross_left] = col1\n        if 0 <= r - 2 < rows:\n            out[r - 2][cross_left + 1] = col1\n        if 0 <= r + 2 < rows:\n            out[r + 2][cross_left + 1] = col1\n            \n        # Right shape\n        for c in range(cross_right, c2 + 1):\n            out[r][c] = col2\n        for dr in [-2, -1, 0, 1, 2]:\n            if 0 <= r + dr < rows:\n                out[r + dr][cross_right] = col2\n        if 0 <= r - 2 < rows:\n            out[r - 2][cross_right - 1] = col2\n        if 0 <= r + 2 < rows:\n            out[r + 2][cross_right - 1] = col2\n            \n        return out\n        \n    return [row[:] for row in grid]",
