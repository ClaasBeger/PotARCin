          if 0 <= r + dr < rows:\n                out[r + dr][cross_left] = col1\n        if 0 <= r - 2 < rows:\n            out[r - 2][cross_left + 1] = col1\n        if 0 <= r + 2 < rows:\n            out[r + 2][cross_left + 1] = col1\n            \n        # Right shape\n        for c in range(cross_right, c2 + 1):\n            out[r][c] = col2\n        for dr in [-2, -1, 0, 1, 2]:\n            if 0 <= r + dr < rows:\n                out[r + dr][cross_right] = col2\n        if 0 <= r - 2 < rows:\n            out[r - 2][cross_right - 1] = col2\n        if 0 <= r + 2 < rows:\n            out[r + 2][cross_right - 1] = col2\n            \n        return out\n        \n    return [row[:] for row in grid]",
