  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    visited = set()\n    \n    out_grid = [row[:] for row in grid]\n    \n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 0 and (r, c) not in visited:\n                comp = []\n                stack = [(r, c)]\n                visited.add((r, c))\n                touches_boundary = False\n                \n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    comp.append((curr_r, curr_c))\n                    \n                    # Check if the component touches the grid boundary\n                    if curr_r == 0 or curr_r == H - 1 or curr_c == 0 or curr_c == W - 1:\n                        touches_boundary = True\n                        \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < H and 0 <= nc < W:\n                            if grid[nr][nc] == 0 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                stack.append((nr, nc))\n                                \n                # If it's a completely enclosed hole\n                if not touches_boundary:\n                    min_r = min(cell[0] for cell in comp)\n                    max_r = max(cell[0] for cell in comp)\n                    min_c = min(cell[1] for cell in comp)\n                    max_c = max(cell[1] for cell in comp)\n                    \n                    w = max_c - min_c + 1\n                    h = max_r - min_r + 1\n                    \n                    # Fill with 2s only if the hole is a perfect square\n                    if w == h and len(comp) == w * h:\n                        for cr, cc in comp:\n                            out_grid[cr][cc] = 2\n                            \n    return out_grid\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    visited = set()\n    \n    out_grid = [row[:] for row in grid]\n    \n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 0 and (r, c) not in visited:\n                comp = []\n                stack = [(r, c)]\n                visited.add((r, c))\n                touches_boundary = False\n                \n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    comp.append((curr_r, curr_c))\n                    \n                    # Check if the component touches the grid boundary\n                    if curr_r == 0 or curr_r == H - 1 or curr_c == 0 or curr_c == W - 1:\n                        touches_boundary = True\n                        \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < H and 0 <= nc < W:\n                            if grid[nr][nc] == 0 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                stack.append((nr, nc))\n                                \n                # If it's a completely enclosed hole\n                if not touches_boundary:\n                    min_r = min(cell[0] for cell in comp)\n                    max_r = max(cell[0] for cell in comp)\n                    min_c = min(cell[1] for cell in comp)\n                    max_c = max(cell[1] for cell in comp)\n                    \n                    w = max_c - min_c + 1\n                    h = max_r - min_r + 1\n                    \n                    # Fill with 2s only if the hole is a perfect square\n                    if w == h and len(comp) == w * h:\n                        for cr, cc in comp:\n                            out_grid[cr][cc] = 2\n                            \n    return out_grid",
