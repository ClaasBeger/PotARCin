  "raw_response": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    line_color = grid[2][0] if H > 2 else 0\n    \n    block_rows = (H + 1) // 3\n    block_cols = (W + 1) // 3\n    \n    from collections import defaultdict\n    color_positions = defaultdict(list)\n    \n    for r in range(block_rows):\n        for c in range(block_cols):\n            pr = r * 3\n            pc = c * 3\n            color = grid[pr][pc]\n            if color != 0 and color != line_color:\n                color_positions[color].append((r, c))\n                \n    output_grid = [row[:] for row in grid]\n    \n    for color, positions in color_positions.items():\n        n = len(positions)\n        for i in range(n):\n            for j in range(i + 1, n):\n                r1, c1 = positions[i]\n                r2, c2 = positions[j]\n                if r1 == r2:\n                    for c in range(min(c1, c2), max(c1, c2) + 1):\n                        pr = r1 * 3\n                        pc = c * 3\n                        output_grid[pr][pc] = color\n                        output_grid[pr][pc+1] = color\n                        output_grid[pr+1][pc] = color\n                        output_grid[pr+1][pc+1] = color\n                if c1 == c2:\n                    for r in range(min(r1, r2), max(r1, r2) + 1):\n                        pr = r * 3\n                        pc = c1 * 3\n                        output_grid[pr][pc] = color\n                        output_grid[pr][pc+1] = color\n                        output_grid[pr+1][pc] = color\n                        output_grid[pr+1][pc+1] = color\n                        \n    return output_grid",
