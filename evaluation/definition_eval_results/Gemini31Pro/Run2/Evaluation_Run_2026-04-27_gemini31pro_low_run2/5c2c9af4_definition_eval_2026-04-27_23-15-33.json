  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    points = []\n    color = 0\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                points.append((r, c))\n                color = grid[r][c]\n    if not points:\n        return grid\n        \n    points.sort()\n    p1 = points[0]\n    p2 = points[-1]\n    \n    step = abs(points[1][0] - points[0][0])\n    \n    out = [[0]*C for _ in range(R)]\n    \n    def draw_spiral(start_r, start_c, dir_r, dir_c, step_size):\n        r, c = start_r, start_c\n        d_r, d_c = dir_r, dir_c\n        length = step_size * 2\n        \n        while 0 <= r < R or 0 <= c < C or length < max(R, C) * 2:\n            nr, nc = r, c\n            for _ in range(length):\n                if 0 <= nr < R and 0 <= nc < C:\n                    out[nr][nc] = color\n                nr += d_r\n                nc += d_c\n            r, c = nr, nc\n            \n            # turn right\n            if d_r == 0 and d_c == 1:\n                d_r, d_c = 1, 0\n            elif d_r == 1 and d_c == 0:\n                d_r, d_c = 0, -1\n                length += step_size\n            elif d_r == 0 and d_c == -1:\n                d_r, d_c = -1, 0\n            elif d_r == -1 and d_c == 0:\n                d_r, d_c = 0, 1\n                length += step_size\n\n    # The exact turn sequence varies, this is a heuristic approximation\n    # for the interlocking spirals pattern seen in the examples.\n    draw_spiral(p1[0], p1[1], 0, 1 if p2[1] > p1[1] else -1, step)\n    draw_spiral(p2[0], p2[1], 0, -1 if p2[1] > p1[1] else 1, step)\n\n    # Fill in the original points just in case\n    for r, c in points:\n        out[r][c] = color\n\n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    points = []\n    color = 0\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                points.append((r, c))\n                color = grid[r][c]\n    if not points:\n        return grid\n        \n    points.sort()\n    p1 = points[0]\n    p2 = points[-1]\n    \n    step = abs(points[1][0] - points[0][0])\n    \n    out = [[0]*C for _ in range(R)]\n    \n    def draw_spiral(start_r, start_c, dir_r, dir_c, step_size):\n        r, c = start_r, start_c\n        d_r, d_c = dir_r, dir_c\n        length = step_size * 2\n        \n        while 0 <= r < R or 0 <= c < C or length < max(R, C) * 2:\n            nr, nc = r, c\n            for _ in range(length):\n                if 0 <= nr < R and 0 <= nc < C:\n                    out[nr][nc] = color\n                nr += d_r\n                nc += d_c\n            r, c = nr, nc\n            \n            # turn right\n            if d_r == 0 and d_c == 1:\n                d_r, d_c = 1, 0\n            elif d_r == 1 and d_c == 0:\n                d_r, d_c = 0, -1\n                length += step_size\n            elif d_r == 0 and d_c == -1:\n                d_r, d_c = -1, 0\n            elif d_r == -1 and d_c == 0:\n                d_r, d_c = 0, 1\n                length += step_size\n\n    # The exact turn sequence varies, this is a heuristic approximation\n    # for the interlocking spirals pattern seen in the examples.\n    draw_spiral(p1[0], p1[1], 0, 1 if p2[1] > p1[1] else -1, step)\n    draw_spiral(p2[0], p2[1], 0, -1 if p2[1] > p1[1] else 1, step)\n\n    # Fill in the original points just in case\n    for r, c in points:\n        out[r][c] = color\n\n    return out",
