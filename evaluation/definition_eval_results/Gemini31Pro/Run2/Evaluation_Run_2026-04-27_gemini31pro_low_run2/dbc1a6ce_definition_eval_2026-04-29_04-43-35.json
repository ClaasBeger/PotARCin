  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    res = [row[:] for row in grid]\n    \n    # Connect 1s in each row\n    for r in range(R):\n        ones = [c for c in range(C) if grid[r][c] == 1]\n        if len(ones) >= 2:\n            for i in range(len(ones)-1):\n                for c in range(ones[i]+1, ones[i+1]):\n                    if res[r][c] == 0:\n                        res[r][c] = 8\n                        \n    # Connect 1s in each column\n    for c in range(C):\n        ones = [r for r in range(R) if grid[r][c] == 1]\n        if len(ones) >= 2:\n            for i in range(len(ones)-1):\n                for r in range(ones[i]+1, ones[i+1]):\n                    if res[r][c] == 0:\n                        res[r][c] = 8\n                        \n    return res\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    res = [row[:] for row in grid]\n    \n    # Connect 1s in each row\n    for r in range(R):\n        ones = [c for c in range(C) if grid[r][c] == 1]\n        if len(ones) >= 2:\n            for i in range(len(ones)-1):\n                for c in range(ones[i]+1, ones[i+1]):\n                    if res[r][c] == 0:\n                        res[r][c] = 8\n                        \n    # Connect 1s in each column\n    for c in range(C):\n        ones = [r for r in range(R) if grid[r][c] == 1]\n        if len(ones) >= 2:\n            for i in range(len(ones)-1):\n                for r in range(ones[i]+1, ones[i+1]):\n                    if res[r][c] == 0:\n                        res[r][c] = 8\n                        \n    return res",
