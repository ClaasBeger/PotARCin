  "raw_response": "def solve(grid):\n    R = len(grid)\n    if R == 0: return grid\n    C = len(grid[0])\n    visited = set()\n    out_grid = [row[:] for row in grid]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 1 and (r, c) not in visited:\n                comp = []\n                stack = [(r, c)]\n                visited.add((r, c))\n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    comp.append((curr_r, curr_c))\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0: continue\n                            nr, nc = curr_r + dr, curr_c + dc\n                            if 0 <= nr < R and 0 <= nc < C and grid[nr][nc] == 1 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                stack.append((nr, nc))\n                \n                min_r = min(p[0] for p in comp)\n                max_r = max(p[0] for p in comp)\n                min_c = min(p[1] for p in comp)\n                max_c = max(p[1] for p in comp)\n                \n                w = max_c - min_c + 1\n                h = max_r - min_r + 1\n                \n                if w >= 3 and h >= 3:\n                    expected_size = 2 * w + 2 * h - 4\n                    if len(comp) == expected_size:\n                        is_box = True\n                        for pr, pc in comp:\n                            if not (pr == min_r or pr == max_r or pc == min_c or pc == max_c):\n                                is_box = False\n                                break\n                        if is_box:\n                            for pr, pc in comp:\n                                out_grid[pr][pc] = 3\n                                \n    return out_grid",
  "script": "def solve(grid):\n    R = len(grid)\n    if R == 0: return grid\n    C = len(grid[0])\n    visited = set()\n    out_grid = [row[:] for row in grid]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 1 and (r, c) not in visited:\n                comp = []\n                stack = [(r, c)]\n                visited.add((r, c))\n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    comp.append((curr_r, curr_c))\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0: continue\n                            nr, nc = curr_r + dr, curr_c + dc\n                            if 0 <= nr < R and 0 <= nc < C and grid[nr][nc] == 1 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                stack.append((nr, nc))\n                \n                min_r = min(p[0] for p in comp)\n                max_r = max(p[0] for p in comp)\n                min_c = min(p[1] for p in comp)\n                max_c = max(p[1] for p in comp)\n                \n                w = max_c - min_c + 1\n                h = max_r - min_r + 1\n                \n                if w >= 3 and h >= 3:\n                    expected_size = 2 * w + 2 * h - 4\n                    if len(comp) == expected_size:\n                        is_box = True\n                        for pr, pc in comp:\n                            if not (pr == min_r or pr == max_r or pc == min_c or pc == max_c):\n                                is_box = False\n                                break\n                        if is_box:\n                            for pr, pc in comp:\n                                out_grid[pr][pc] = 3\n                                \n    return out_grid",
