  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # 1. Find bounding box (defined by '4's)\n    fours = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 4:\n                fours.append((r, c))\n                \n    if not fours:\n        return grid\n        \n    min_r = min(r for r, c in fours)\n    max_r = max(r for r, c in fours)\n    min_c = min(c for r, c in fours)\n    max_c = max(c for r, c in fours)\n    \n    # 2. Extract template\n    template_pixels = []\n    for r in range(max_r + 1, R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                template_pixels.append((r, c, grid[r][c]))\n                \n    if not template_pixels:\n        return [row[min_c:max_c+1] for row in grid[min_r:max_r+1]]\n        \n    t_min_r = min(r for r, c, val in template_pixels)\n    t_min_c = min(c for r, c, val in template_pixels)\n    \n    # Normalize template coords\n    norm_template = [(r - t_min_r, c - t_min_c, val) for r, c, val in template_pixels]\n    \n    # 3. Find blocks in bounding area to determine N and alignment\n    # Output grid initialization\n    out_R = max_r - min_r + 1\n    out_C = max_c - min_c + 1\n    out_grid = [[0 for _ in range(out_C)] for _ in range(out_R)]\n    \n    out_grid[0][0] = 4\n    out_grid[0][-1] = 4\n    out_grid[-1][0] = 4\n    out_grid[-1][-1] = 4\n    \n    blocks = {}\n    for r in range(min_r + 1, max_r):\n        for c in range(min_c + 1, max_c):\n            val = grid[r][c]\n            if val != 0 and val != 4:\n                if val not in blocks:\n                    blocks[val] = []\n                blocks[val].append((r - min_r, c - min_c))\n                \n    # Find N\n    N = 1\n    if blocks:\n        for val, coords in blocks.items():\n            r0, c0 = min(coords, key=lambda x: (x[0], x[1]))\n            n = 0\n            while (r0 + n, c0) in coords:\n                n += 1\n            N = max(N, n)\n            break\n            \n    # Find alignment\n    base_r, base_c = 0, 0\n    aligned = False\n    for tr, tc, tval in norm_template:\n        if tval in blocks:\n            # Find the top-left of this color in bounded area\n            coords = blocks[tval]\n            br, bc = min(coords, key=lambda x: (x[0], x[1]))\n            base_r = br - tr * N\n            base_c = bc - tc * N\n            aligned = True\n            break\n            \n    if not aligned and norm_template:\n        # Fallback if no color matches\n        base_r, base_c = 1, 1\n\n    # 4. Draw scaled template\n    for tr, tc, tval in norm_template:\n        for i in range(N):\n            for j in range(N):\n                rr = base_r + tr * N + i\n                cc = base_c + tc * N + j\n                if 0 <= rr < out_R and 0 <= cc < out_C:\n                    if out_grid[rr][cc] != 4:\n                        out_grid[rr][cc] = tval\n                        \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # 1. Find bounding box (defined by '4's)\n    fours = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 4:\n                fours.append((r, c))\n                \n    if not fours:\n        return grid\n        \n    min_r = min(r for r, c in fours)\n    max_r = max(r for r, c in fours)\n    min_c = min(c for r, c in fours)\n    max_c = max(c for r, c in fours)\n    \n    # 2. Extract template\n    template_pixels = []\n    for r in range(max_r + 1, R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                template_pixels.append((r, c, grid[r][c]))\n                \n    if not template_pixels:\n        return [row[min_c:max_c+1] for row in grid[min_r:max_r+1]]\n        \n    t_min_r = min(r for r, c, val in template_pixels)\n    t_min_c = min(c for r, c, val in template_pixels)\n    \n    # Normalize template coords\n    norm_template = [(r - t_min_r, c - t_min_c, val) for r, c, val in template_pixels]\n    \n    # 3. Find blocks in bounding area to determine N and alignment\n    # Output grid initialization\n    out_R = max_r - min_r + 1\n    out_C = max_c - min_c + 1\n    out_grid = [[0 for _ in range(out_C)] for _ in range(out_R)]\n    \n    out_grid[0][0] = 4\n    out_grid[0][-1] = 4\n    out_grid[-1][0] = 4\n    out_grid[-1][-1] = 4\n    \n    blocks = {}\n    for r in range(min_r + 1, max_r):\n        for c in range(min_c + 1, max_c):\n            val = grid[r][c]\n            if val != 0 and val != 4:\n                if val not in blocks:\n                    blocks[val] = []\n                blocks[val].append((r - min_r, c - min_c))\n                \n    # Find N\n    N = 1\n    if blocks:\n        for val, coords in blocks.items():\n            r0, c0 = min(coords, key=lambda x: (x[0], x[1]))\n            n = 0\n            while (r0 + n, c0) in coords:\n                n += 1\n            N = max(N, n)\n            break\n            \n    # Find alignment\n    base_r, base_c = 0, 0\n    aligned = False\n    for tr, tc, tval in norm_template:\n        if tval in blocks:\n            # Find the top-left of this color in bounded area\n            coords = blocks[tval]\n            br, bc = min(coords, key=lambda x: (x[0], x[1]))\n            base_r = br - tr * N\n            base_c = bc - tc * N\n            aligned = True\n            break\n            \n    if not aligned and norm_template:\n        # Fallback if no color matches\n        base_r, base_c = 1, 1\n\n    # 4. Draw scaled template\n    for tr, tc, tval in norm_template:\n        for i in range(N):\n            for j in range(N):\n                rr = base_r + tr * N + i\n                cc = base_c + tc * N + j\n                if 0 <= rr < out_R and 0 <= cc < out_C:\n                    if out_grid[rr][cc] != 4:\n                        out_grid[rr][cc] = tval\n                        \n    return out_grid",
