  "raw_response": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    # Find holes of 9s\n    visited_9 = set()\n    holes = set()\n    \n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 9 and (r, c) not in visited_9:\n                comp = set()\n                stack = [(r, c)]\n                is_hole = True\n                \n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    if (curr_r, curr_c) in comp:\n                        continue\n                    comp.add((curr_r, curr_c))\n                    \n                    if curr_r == 0 or curr_r == H - 1 or curr_c == 0 or curr_c == W - 1:\n                        is_hole = False\n                        \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < H and 0 <= nc < W and grid[nr][nc] == 9:\n                            if (nr, nc) not in comp:\n                                stack.append((nr, nc))\n                \n                visited_9.update(comp)\n                if is_hole:\n                    holes.update(comp)\n                    \n    # Find components of 1s and check if they enclose a hole\n    visited_1 = set()\n    output_grid = [row[:] for row in grid]\n    \n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 1 and (r, c) not in visited_1:\n                comp = set()\n                stack = [(r, c)]\n                touches_hole = False\n                \n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    if (curr_r, curr_c) in comp:\n                        continue\n                    comp.add((curr_r, curr_c))\n                    \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < H and 0 <= nc < W:\n                            if grid[nr][nc] == 1 and (nr, nc) not in comp:\n                                stack.append((nr, nc))\n                            elif (nr, nc) in holes:\n                                touches_hole = True\n                                \n                visited_1.update(comp)\n                if touches_hole:\n                    for cr, cc in comp:\n                        output_grid[cr][cc] = 8\n                        \n    return output_grid",
