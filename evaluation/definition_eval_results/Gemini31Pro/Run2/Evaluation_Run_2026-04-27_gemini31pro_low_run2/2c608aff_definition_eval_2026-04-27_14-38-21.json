  "raw_response": "def solve(grid):\n    import copy\n    from collections import Counter\n    \n    out_grid = copy.deepcopy(grid)\n    R = len(grid)\n    C = len(grid[0])\n    \n    counts = Counter(val for row in grid for val in row)\n    bg = counts.most_common(1)[0][0]\n    \n    block_r1, block_r2, block_c1, block_c2 = -1, -1, -1, -1\n    \n    # Find the block (rectangle with width > 1 and height > 1)\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != bg:\n                w = 0\n                while c + w < C and grid[r][c+w] == grid[r][c]:\n                    w += 1\n                h = 0\n                while r + h < R and all(grid[r+h][c+k] == grid[r][c] for k in range(w)):\n                    h += 1\n                if w > 1 and h > 1:\n                    block_r1, block_r2 = r, r + h - 1\n                    block_c1, block_c2 = c, c + w - 1\n                    break\n        if block_r1 != -1:\n            break\n            \n    # Draw connections\n    if block_r1 != -1:\n        for r in range(R):\n            for c in range(C):\n                if grid[r][c] != bg:\n                    if block_r1 <= r <= block_r2 and block_c1 <= c <= block_c2:\n                        continue\n                    \n                    if block_r1 <= r <= block_r2:\n                        if c < block_c1:\n                            for nc in range(c + 1, block_c1):\n                                out_grid[r][nc] = grid[r][c]\n                        elif c > block_c2:\n                            for nc in range(block_c2 + 1, c):\n                                out_grid[r][nc] = grid[r][c]\n                    elif block_c1 <= c <= block_c2:\n                        if r < block_r1:\n                            for nr in range(r + 1, block_r1):\n                                out_grid[nr][c] = grid[r][c]\n                        elif r > block_r2:\n                            for nr in range(block_r2 + 1, r):\n                                out_grid[nr][c] = grid[r][c]\n\n    return out_grid",
  "script": "def solve(grid):\n    import copy\n    from collections import Counter\n    \n    out_grid = copy.deepcopy(grid)\n    R = len(grid)\n    C = len(grid[0])\n    \n    counts = Counter(val for row in grid for val in row)\n    bg = counts.most_common(1)[0][0]\n    \n    block_r1, block_r2, block_c1, block_c2 = -1, -1, -1, -1\n    \n    # Find the block (rectangle with width > 1 and height > 1)\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != bg:\n                w = 0\n                while c + w < C and grid[r][c+w] == grid[r][c]:\n                    w += 1\n                h = 0\n                while r + h < R and all(grid[r+h][c+k] == grid[r][c] for k in range(w)):\n                    h += 1\n                if w > 1 and h > 1:\n                    block_r1, block_r2 = r, r + h - 1\n                    block_c1, block_c2 = c, c + w - 1\n                    break\n        if block_r1 != -1:\n            break\n            \n    # Draw connections\n    if block_r1 != -1:\n        for r in range(R):\n            for c in range(C):\n                if grid[r][c] != bg:\n                    if block_r1 <= r <= block_r2 and block_c1 <= c <= block_c2:\n                        continue\n                    \n                    if block_r1 <= r <= block_r2:\n                        if c < block_c1:\n                            for nc in range(c + 1, block_c1):\n                                out_grid[r][nc] = grid[r][c]\n                        elif c > block_c2:\n                            for nc in range(block_c2 + 1, c):\n                                out_grid[r][nc] = grid[r][c]\n                    elif block_c1 <= c <= block_c2:\n                        if r < block_r1:\n                            for nr in range(r + 1, block_r1):\n                                out_grid[nr][c] = grid[r][c]\n                        elif r > block_r2:\n                            for nr in range(block_r2 + 1, r):\n                                out_grid[nr][c] = grid[r][c]\n\n    return out_grid",
