              visited.add((nr, nc))\n                        q.append((nr, nc))\n            components.append(comp)\n            \n    # There should be two main components: large shape and small block\n    components.sort(key=len)\n    small_comp = components[0]\n    large_comp = components[-1]\n    \n    # Bounding box of small block\n    sr_min = min(r for r, c, v in small_comp)\n    sr_max = max(r for r, c, v in small_comp)\n    sc_min = min(c for r, c, v in small_comp)\n    sc_max = max(c for r, c, v in small_comp)\n    \n    small_block = []\n    for r in range(sr_min, sr_max + 1):\n        row = []\n        for c in range(sc_min, sc_max + 1):\n            row.append(grid[r][c])\n        small_block.append(row)\n        \n    # Bounding box of large block\n    lr_min = min(r for r, c, v in large_comp)\n    lr_max = max(r for r, c, v in large_comp)\n    lc_min = min(c for r, c, v in large_comp)\n    lc_max = max(c for r, c, v in large_comp)\n    \n    H = lr_max - lr_min + 1\n    W = lc_max - lc_min + 1\n    \n    small_h = len(small_block)\n    small_w = len(small_block[0])\n    \n    block_h = H // small_h\n    block_w = W // small_w\n    \n    out_grid = []\n    for i in range(small_h):\n        out_row = []\n        for j in range(small_w):\n            # Check if the corresponding block in the large shape is filled\n            # We can check the center of the block\n            center_r = lr_min + i * block_h + block_h // 2\n            center_c = lc_min + j * block_w + block_w // 2\n            if grid[center_r][center_c] != 0:\n                out_row.append(small_block[i][j])\n            else:\n                out_row.append(0)\n        out_grid.append(out_row)\n        \n    return out_grid",
