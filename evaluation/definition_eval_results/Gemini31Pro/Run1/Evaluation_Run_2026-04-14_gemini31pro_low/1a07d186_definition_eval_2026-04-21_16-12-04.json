  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    if R == 0: return []\n    C = len(grid[0])\n    \n    full_rows = {}\n    for r in range(R):\n        color = grid[r][0]\n        if color != 0 and all(grid[r][c] == color for c in range(C)):\n            full_rows[color] = r\n            \n    full_cols = {}\n    for c in range(C):\n        color = grid[0][c]\n        if color != 0 and all(grid[r][c] == color for r in range(R)):\n            full_cols[color] = c\n            \n    out = [[0]*C for _ in range(R)]\n    \n    for color, r in full_rows.items():\n        for c in range(C):\n            out[r][c] = color\n            \n    for color, c in full_cols.items():\n        for r in range(R):\n            out[r][c] = color\n            \n    for r in range(R):\n        for c in range(C):\n            color = grid[r][c]\n            if color == 0: \n                continue\n            \n            if color in full_rows and full_rows[color] == r: \n                continue\n            if color in full_cols and full_cols[color] == c: \n                continue\n            \n            if color in full_rows:\n                line_r = full_rows[color]\n                new_r = line_r - 1 if r < line_r else line_r + 1\n                if 0 <= new_r < R:\n                    out[new_r][c] = color\n            elif color in full_cols:\n                line_c = full_cols[color]\n                new_c = line_c - 1 if c < line_c else line_c + 1\n                if 0 <= new_c < C:\n                    out[r][new_c] = color\n                \n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    if R == 0: return []\n    C = len(grid[0])\n    \n    full_rows = {}\n    for r in range(R):\n        color = grid[r][0]\n        if color != 0 and all(grid[r][c] == color for c in range(C)):\n            full_rows[color] = r\n            \n    full_cols = {}\n    for c in range(C):\n        color = grid[0][c]\n        if color != 0 and all(grid[r][c] == color for r in range(R)):\n            full_cols[color] = c\n            \n    out = [[0]*C for _ in range(R)]\n    \n    for color, r in full_rows.items():\n        for c in range(C):\n            out[r][c] = color\n            \n    for color, c in full_cols.items():\n        for r in range(R):\n            out[r][c] = color\n            \n    for r in range(R):\n        for c in range(C):\n            color = grid[r][c]\n            if color == 0: \n                continue\n            \n            if color in full_rows and full_rows[color] == r: \n                continue\n            if color in full_cols and full_cols[color] == c: \n                continue\n            \n            if color in full_rows:\n                line_r = full_rows[color]\n                new_r = line_r - 1 if r < line_r else line_r + 1\n                if 0 <= new_r < R:\n                    out[new_r][c] = color\n            elif color in full_cols:\n                line_c = full_cols[color]\n                new_c = line_c - 1 if c < line_c else line_c + 1\n                if 0 <= new_c < C:\n                    out[r][new_c] = color\n                \n    return out",
