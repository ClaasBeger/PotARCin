  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [[col for col in row] for row in grid]\n    \n    twos_r = []\n    twos_c = []\n    fives = []\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 2:\n                twos_r.append(r)\n                twos_c.append(c)\n            elif grid[r][c] == 5:\n                fives.append((r, c))\n                out[r][c] = 0\n                \n    from collections import Counter\n    r_counts = Counter(twos_r)\n    c_counts = Counter(twos_c)\n    \n    r_max = max(r_counts.values()) if r_counts else 0\n    c_max = max(c_counts.values()) if c_counts else 0\n    \n    if r_max > c_max:\n        lines = [r for r, cnt in r_counts.most_common(2)]\n        for r, c in fives:\n            dist1 = abs(r - lines[0])\n            dist2 = abs(r - lines[1])\n            if dist1 < dist2:\n                line = lines[0]\n            else:\n                line = lines[1]\n            \n            new_r = line - (r - line)\n            if 0 <= new_r < R:\n                out[new_r][c] = 5\n    else:\n        lines = [c for c, cnt in c_counts.most_common(2)]\n        for r, c in fives:\n            dist1 = abs(c - lines[0])\n            dist2 = abs(c - lines[1])\n            if dist1 < dist2:\n                line = lines[0]\n            else:\n                line = lines[1]\n            \n            new_c = line - (c - line)\n            if 0 <= new_c < C:\n                out[r][new_c] = 5\n                \n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    out = [[col for col in row] for row in grid]\n    \n    twos_r = []\n    twos_c = []\n    fives = []\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 2:\n                twos_r.append(r)\n                twos_c.append(c)\n            elif grid[r][c] == 5:\n                fives.append((r, c))\n                out[r][c] = 0\n                \n    from collections import Counter\n    r_counts = Counter(twos_r)\n    c_counts = Counter(twos_c)\n    \n    r_max = max(r_counts.values()) if r_counts else 0\n    c_max = max(c_counts.values()) if c_counts else 0\n    \n    if r_max > c_max:\n        lines = [r for r, cnt in r_counts.most_common(2)]\n        for r, c in fives:\n            dist1 = abs(r - lines[0])\n            dist2 = abs(r - lines[1])\n            if dist1 < dist2:\n                line = lines[0]\n            else:\n                line = lines[1]\n            \n            new_r = line - (r - line)\n            if 0 <= new_r < R:\n                out[new_r][c] = 5\n    else:\n        lines = [c for c, cnt in c_counts.most_common(2)]\n        for r, c in fives:\n            dist1 = abs(c - lines[0])\n            dist2 = abs(c - lines[1])\n            if dist1 < dist2:\n                line = lines[0]\n            else:\n                line = lines[1]\n            \n            new_c = line - (c - line)\n            if 0 <= new_c < C:\n                out[r][new_c] = 5\n                \n    return out",
