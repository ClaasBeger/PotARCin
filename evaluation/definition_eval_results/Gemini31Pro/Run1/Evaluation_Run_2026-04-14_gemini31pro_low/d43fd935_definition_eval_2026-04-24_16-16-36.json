  "raw_response": "def solve(grid):\n    import copy\n    out = copy.deepcopy(grid)\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    threes = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 3:\n                threes.append((r, c))\n                \n    if not threes:\n        return out\n        \n    min_r = min(r for r, c in threes)\n    max_r = max(r for r, c in threes)\n    min_c = min(c for r, c in threes)\n    max_c = max(c for r, c in threes)\n    \n    # Up from (min_r, min_c)\n    for r in range(min_r - 1, -1, -1):\n        if grid[r][min_c] != 0:\n            color = grid[r][min_c]\n            for i in range(r + 1, min_r):\n                out[i][min_c] = color\n            break\n            \n    # Up from (min_r, max_c)\n    for r in range(min_r - 1, -1, -1):\n        if grid[r][max_c] != 0:\n            color = grid[r][max_c]\n            for i in range(r + 1, min_r):\n                out[i][max_c] = color\n            break\n            \n    # Down from (max_r, min_c)\n    for r in range(max_r + 1, rows):\n        if grid[r][min_c] != 0:\n            color = grid[r][min_c]\n            for i in range(max_r + 1, r):\n                out[i][min_c] = color\n            break\n            \n    # Down from (max_r, max_c)\n    for r in range(max_r + 1, rows):\n        if grid[r][max_c] != 0:\n            color = grid[r][max_c]\n            for i in range(max_r + 1, r):\n                out[i][max_c] = color\n            break\n            \n    # Left from (min_r, min_c)\n    for c in range(min_c - 1, -1, -1):\n        if grid[min_r][c] != 0:\n            color = grid[min_r][c]\n            for i in range(c + 1, min_c):\n                out[min_r][i] = color\n            break\n            \n    # Left from (max_r, min_c)\n    for c in range(min_c - 1, -1, -1):\n        if grid[max_r][c] != 0:\n            color = grid[max_r][c]\n            for i in range(c + 1, min_c):\n                out[max_r][i]