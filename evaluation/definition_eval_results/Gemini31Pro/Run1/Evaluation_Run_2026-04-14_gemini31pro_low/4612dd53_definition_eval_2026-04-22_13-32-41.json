  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Find all 1s\n    ones = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 1:\n                ones.append((r, c))\n                \n    if not ones:\n        return [row[:] for row in grid]\n        \n    min_r = min(r for r, c in ones)\n    max_r = max(r for r, c in ones)\n    min_c = min(c for r, c in ones)\n    max_c = max(c for r, c in ones)\n    \n    # Determine which rows and cols are lines\n    # Based on examples, a row or col is a line if it contains >= 4 ones\n    # The boundaries are always lines\n    line_rows = set([min_r, max_r])\n    line_cols = set([min_c, max_c])\n    \n    for r in range(min_r, max_r + 1):\n        if sum(1 for c in range(min_c, max_c + 1) if grid[r][c] == 1) >= 4:\n            line_rows.add(r)\n            \n    for c in range(min_c, max_c + 1):\n        if sum(1 for r in range(min_r, max_r + 1) if grid[r][c] == 1) >= 4:\n            line_cols.add(c)\n            \n    out_grid = [row[:] for row in grid]\n    \n    for r in range(min_r, max_r + 1):\n        for c in range(min_c, max_c + 1):\n            if r in line_rows or c in line_cols:\n                if out_grid[r][c] == 0:\n                    out_grid[r][c] = 2\n                    \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Find all 1s\n    ones = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 1:\n                ones.append((r, c))\n                \n    if not ones:\n        return [row[:] for row in grid]\n        \n    min_r = min(r for r, c in ones)\n    max_r = max(r for r, c in ones)\n    min_c = min(c for r, c in ones)\n    max_c = max(c for r, c in ones)\n    \n    # Determine which rows and cols are lines\n    # Based on examples, a row or col is a line if it contains >= 4 ones\n    # The boundaries are always lines\n    line_rows = set([min_r, max_r])\n    line_cols = set([min_c, max_c])\n    \n    for r in range(min_r, max_r + 1):\n        if sum(1 for c in range(min_c, max_c + 1) if grid[r][c] == 1) >= 4:\n            line_rows.add(r)\n            \n    for c in range(min_c, max_c + 1):\n        if sum(1 for r in range(min_r, max_r + 1) if grid[r][c] == 1) >= 4:\n            line_cols.add(c)\n            \n    out_grid = [row[:] for row in grid]\n    \n    for r in range(min_r, max_r + 1):\n        for c in range(min_c, max_c + 1):\n            if r in line_rows or c in line_cols:\n                if out_grid[r][c] == 0:\n                    out_grid[r][c] = 2\n                    \n    return out_grid",
