  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C_len = len(grid[0])\n    \n    r0, c0 = -1, -1\n    color = 0\n    \n    # Find the 2x2 square and the drawing color\n    for r in range(R - 1):\n        for c in range(C_len - 1):\n            cell_vals = [grid[r][c], grid[r][c+1], grid[r+1][c], grid[r+1][c+1]]\n            if 2 in cell_vals and any(v != 0 and v != 2 for v in cell_vals):\n                r0, c0 = r, c\n                for v in cell_vals:\n                    if v != 0 and v != 2:\n                        color = v\n                        break\n                break\n        if r0 != -1:\n            break\n            \n    out_grid = [[0 for _ in range(C_len)] for _ in range(R)]\n    \n    if r0 == -1:\n        return out_grid\n        \n    dirs = []\n    if grid[r0][c0] == 2: \n        dirs.append((-1, -1))\n    if grid[r0][c0+1] == 2: \n        dirs.append((-1, 1))\n    if grid[r0+1][c0] == 2: \n        dirs.append((1, -1))\n    if grid[r0+1][c0+1] == 2: \n        dirs.append((1, 1))\n    \n    def paint(r_start, c_start):\n        painted = False\n        for rr in range(r_start, r_start + 2):\n            for cc in range(c_start, c_start + 2):\n                if 0 <= rr < R and 0 <= cc < C_len:\n                    out_grid[rr][cc] = color\n                    painted = True\n        return painted\n\n    paint(r0, c0)\n    \n    for dr, dc in dirs:\n        k = 1\n        while True:\n            # Keep painting along the diagonal direction\n            if not paint(r0 + k * dr, c0 + k * dc):\n                break\n            k += 1\n            \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C_len = len(grid[0])\n    \n    r0, c0 = -1, -1\n    color = 0\n    \n    # Find the 2x2 square and the drawing color\n    for r in range(R - 1):\n        for c in range(C_len - 1):\n            cell_vals = [grid[r][c], grid[r][c+1], grid[r+1][c], grid[r+1][c+1]]\n            if 2 in cell_vals and any(v != 0 and v != 2 for v in cell_vals):\n                r0, c0 = r, c\n                for v in cell_vals:\n                    if v != 0 and v != 2:\n                        color = v\n                        break\n                break\n        if r0 != -1:\n            break\n            \n    out_grid = [[0 for _ in range(C_len)] for _ in range(R)]\n    \n    if r0 == -1:\n        return out_grid\n        \n    dirs = []\n    if grid[r0][c0] == 2: \n        dirs.append((-1, -1))\n    if grid[r0][c0+1] == 2: \n        dirs.append((-1, 1))\n    if grid[r0+1][c0] == 2: \n        dirs.append((1, -1))\n    if grid[r0+1][c0+1] == 2: \n        dirs.append((1, 1))\n    \n    def paint(r_start, c_start):\n        painted = False\n        for rr in range(r_start, r_start + 2):\n            for cc in range(c_start, c_start + 2):\n                if 0 <= rr < R and 0 <= cc < C_len:\n                    out_grid[rr][cc] = color\n                    painted = True\n        return painted\n\n    paint(r0, c0)\n    \n    for dr, dc in dirs:\n        k = 1\n        while True:\n            # Keep painting along the diagonal direction\n            if not paint(r0 + k * dr, c0 + k * dc):\n                break\n            k += 1\n            \n    return out_grid",
