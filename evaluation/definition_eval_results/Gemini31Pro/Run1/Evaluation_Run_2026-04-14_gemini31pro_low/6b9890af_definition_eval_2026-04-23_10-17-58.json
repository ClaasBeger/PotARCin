  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find bounding box of the hollow square of 2s\n    min_r2, max_r2, min_c2, max_c2 = rows, -1, cols, -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                if r < min_r2: min_r2 = r\n                if r > max_r2: max_r2 = r\n                if c < min_c2: min_c2 = c\n                if c > max_c2: max_c2 = c\n                \n    # Inner dimension of the hollow square\n    W = max_r2 - min_r2 - 1\n    \n    # Find bounding box and color of the small pattern\n    min_rp, max_rp, min_cp, max_cp = rows, -1, cols, -1\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0 and val != 2:\n                if r < min_rp: min_rp = r\n                if r > max_rp: max_rp = r\n                if c < min_cp: min_cp = c\n                if c > max_cp: max_cp = c\n                \n    pattern_w = max_cp - min_cp + 1\n    \n    # Extract the small pattern\n    pattern = []\n    for r in range(min_rp, max_rp + 1):\n        row_vals = []\n        for c in range(min_cp, max_cp + 1):\n            row_vals.append(grid[r][c])\n        pattern.append(row_vals)\n        \n    # Scale factor\n    k = W // pattern_w\n    \n    # Generate the output grid\n    out_size = W + 2\n    output = [[0] * out_size for _ in range(out_size)]\n    \n    for r in range(out_size):\n        for c in range(out_size):\n            if r == 0 or r == out_size - 1 or c == 0 or c == out_size - 1:\n                output[r][c] = 2\n            else:\n                pr = (r - 1) // k\n                pc = (c - 1) // k\n                output[r][c] = pattern[pr][pc]\n                \n    return output\n```",
