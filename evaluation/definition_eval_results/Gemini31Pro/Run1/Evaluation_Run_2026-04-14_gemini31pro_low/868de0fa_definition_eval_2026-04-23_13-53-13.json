  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    visited = set()\n    output = [row[:] for row in grid]\n    \n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 0 and (r, c) not in visited:\n                comp = []\n                q = [(r, c)]\n                visited.add((r, c))\n                touches_boundary = False\n                \n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    \n                    if curr_r == 0 or curr_r == H - 1 or curr_c == 0 or curr_c == W - 1:\n                        touches_boundary = True\n                        \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < H and 0 <= nc < W:\n                            if grid[nr][nc] == 0 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                q.append((nr, nc))\n                \n                if not touches_boundary:\n                    min_c = min(x[1] for x in comp)\n                    max_c = max(x[1] for x in comp)\n                    \n                    w = max_c - min_c + 1\n                    color = 7 if w % 2 == 1 else 2\n                    \n                    for cr, cc in comp:\n                        output[cr][cc] = color\n                        \n    return output\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    visited = set()\n    output = [row[:] for row in grid]\n    \n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 0 and (r, c) not in visited:\n                comp = []\n                q = [(r, c)]\n                visited.add((r, c))\n                touches_boundary = False\n                \n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    \n                    if curr_r == 0 or curr_r == H - 1 or curr_c == 0 or curr_c == W - 1:\n                        touches_boundary = True\n                        \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = curr_r + dr, curr_c + dc\n                        if 0 <= nr < H and 0 <= nc < W:\n                            if grid[nr][nc] == 0 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                q.append((nr, nc))\n                \n                if not touches_boundary:\n                    min_c = min(x[1] for x in comp)\n                    max_c = max(x[1] for x in comp)\n                    \n                    w = max_c - min_c + 1\n                    color = 7 if w % 2 == 1 else 2\n                    \n                    for cr, cc in comp:\n                        output[cr][cc] = color\n                        \n    return output",
