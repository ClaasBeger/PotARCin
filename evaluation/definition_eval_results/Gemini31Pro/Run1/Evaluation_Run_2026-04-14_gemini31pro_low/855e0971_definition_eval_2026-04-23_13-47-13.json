  "raw_response": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    row_colors = []\n    for row in grid:\n        colors = [x for x in row if x != 0]\n        if not colors:\n            colors = [0]\n        row_colors.append(max(set(colors), key=colors.count))\n        \n    col_colors = []\n    for c in range(C):\n        colors = [grid[r][c] for r in range(R) if grid[r][c] != 0]\n        if not colors:\n            colors = [0]\n        col_colors.append(max(set(colors), key=colors.count))\n        \n    row_matches = sum(1 for r in range(R) for c in range(C) if grid[r][c] == row_colors[r] or grid[r][c] == 0)\n    col_matches = sum(1 for r in range(R) for c in range(C) if grid[r][c] == col_colors[c] or grid[r][c] == 0)\n    \n    is_horizontal = row_matches > col_matches\n\n    out = [row[:] for row in grid]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 0:\n                if is_horizontal:\n                    bg = row_colors[r]\n                    for i in range(r, -1, -1):\n                        if row_colors[i] == bg:\n                            out[i][c] = 0\n                        else:\n                            break\n                    for i in range(r + 1, R):\n                        if row_colors[i] == bg:\n                            out[i][c] = 0\n                        else:\n                            break\n                else:\n                    bg = col_colors[c]\n                    for i in range(c, -1, -1):\n                        if col_colors[i] == bg:\n                            out[r][i] = 0\n                        else:\n                            break\n                    for i in range(c + 1, C):\n                        if col_colors[i] == bg:\n                            out[r][i] = 0\n                        else:\n                            break\n    return out",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    row_colors = []\n    for row in grid:\n        colors = [x for x in row if x != 0]\n        if not colors:\n            colors = [0]\n        row_colors.append(max(set(colors), key=colors.count))\n        \n    col_colors = []\n    for c in range(C):\n        colors = [grid[r][c] for r in range(R) if grid[r][c] != 0]\n        if not colors:\n            colors = [0]\n        col_colors.append(max(set(colors), key=colors.count))\n        \n    row_matches = sum(1 for r in range(R) for c in range(C) if grid[r][c] == row_colors[r] or grid[r][c] == 0)\n    col_matches = sum(1 for r in range(R) for c in range(C) if grid[r][c] == col_colors[c] or grid[r][c] == 0)\n    \n    is_horizontal = row_matches > col_matches\n\n    out = [row[:] for row in grid]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 0:\n                if is_horizontal:\n                    bg = row_colors[r]\n                    for i in range(r, -1, -1):\n                        if row_colors[i] == bg:\n                            out[i][c] = 0\n                        else:\n                            break\n                    for i in range(r + 1, R):\n                        if row_colors[i] == bg:\n                            out[i][c] = 0\n                        else:\n                            break\n                else:\n                    bg = col_colors[c]\n                    for i in range(c, -1, -1):\n                        if col_colors[i] == bg:\n                            out[r][i] = 0\n                        else:\n                            break\n                    for i in range(c + 1, C):\n                        if col_colors[i] == bg:\n                            out[r][i] = 0\n                        else:\n                            break\n    return out",
