n out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    best_center = None\n    max_score = -1\n    \n    for cy_2 in range(2 * R):\n        for cx_2 in range(2 * C):\n            cy = cy_2 / 2.0\n            cx = cx_2 / 2.0\n            \n            score = 0\n            for y in range(R):\n                for x in range(C):\n                    if grid[y][x] != 0:\n                        y1 = cy + x - cx\n                        x1 = cx - (y - cy)\n                        y2 = cy - (y - cy)\n                        x2 = cx - (x - cx)\n                        y3 = cy - (x - cx)\n                        x3 = cx + (y - cy)\n                        \n                        for ny, nx in [(y1, x1), (y2, x2), (y3, x3)]:\n                            if ny.is_integer() and nx.is_integer():\n                                iny, inx = int(ny), int(nx)\n                                if 0 <= iny < R and 0 <= inx < C:\n                                    if grid[iny][inx] == grid[y][x]:\n                                        score += 1\n            \n            if score > max_score:\n                max_score = score\n                best_center = (cy, cx)\n                \n    out = [[grid[y][x] for x in range(C)] for y in range(R)]\n    cy, cx = best_center\n    \n    for y in range(R):\n        for x in range(C):\n            if grid[y][x] != 0:\n                v = grid[y][x]\n                y1 = cy + x - cx\n                x1 = cx - (y - cy)\n                y2 = cy - (y - cy)\n                x2 = cx - (x - cx)\n                y3 = cy - (x - cx)\n                x3 = cx + (y - cy)\n                \n                for ny, nx in [(y1, x1), (y2, x2), (y3, x3)]:\n                    if ny.is_integer() and nx.is_integer():\n                        iny, inx = int(ny), int(nx)\n                        if 0 <= iny < R and 0 <= inx < C:\n                            out[iny][inx] = v\n                            \n    return out",
