  "raw_response": "```python\ndef solve(grid):\n    min_r, max_r = len(grid), -1\n    min_c, max_c = len(grid[0]), -1\n    color = 5\n    \n    for r in range(len(grid)):\n        for c in range(len(grid[0])):\n            if grid[r][c] != 0:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                color = grid[r][c]\n                \n    macro = [[0] * 3 for _ in range(3)]\n    for i in range(3):\n        for j in range(3):\n            r = min_r + i * 3\n            c = min_c + j * 3\n            if r <= max_r and c <= max_c and grid[r][c] != 0:\n                macro[i][j] = 1\n                \n    out = [[0] * 9 for _ in range(9)]\n    for r in range(9):\n        for c in range(9):\n            macro_r, macro_c = r // 3, c // 3\n            micro_r, micro_c = r % 3, c % 3\n            if macro[macro_r][macro_c] == 1 and macro[micro_r][micro_c] == 1:\n                out[r][c] = color\n                \n    return out\n```",
  "script": "def solve(grid):\n    min_r, max_r = len(grid), -1\n    min_c, max_c = len(grid[0]), -1\n    color = 5\n    \n    for r in range(len(grid)):\n        for c in range(len(grid[0])):\n            if grid[r][c] != 0:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                color = grid[r][c]\n                \n    macro = [[0] * 3 for _ in range(3)]\n    for i in range(3):\n        for j in range(3):\n            r = min_r + i * 3\n            c = min_c + j * 3\n            if r <= max_r and c <= max_c and grid[r][c] != 0:\n                macro[i][j] = 1\n                \n    out = [[0] * 9 for _ in range(9)]\n    for r in range(9):\n        for c in range(9):\n            macro_r, macro_c = r // 3, c // 3\n            micro_r, micro_c = r % 3, c % 3\n            if macro[macro_r][macro_c] == 1 and macro[micro_r][micro_c] == 1:\n                out[r][c] = color\n                \n    return out",
