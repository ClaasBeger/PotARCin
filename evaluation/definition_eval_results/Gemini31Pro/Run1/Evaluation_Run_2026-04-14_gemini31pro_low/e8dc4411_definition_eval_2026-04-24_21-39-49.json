  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    bg_color = None\n    counts = {}\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            counts[val] = counts.get(val, 0) + 1\n            \n    # background is the most common color\n    bg_color = max(counts, key=counts.get)\n    \n    zeros = []\n    color_val = None\n    color_pos = None\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val == 0:\n                zeros.append((r, c))\n            elif val != bg_color:\n                color_val = val\n                color_pos = (r, c)\n                \n    if not zeros or color_pos is None:\n        return [row[:] for row in grid]\n        \n    cy, cx = color_pos\n    \n    # Find all possible valid translations (dy, dx) where abs(dy) == abs(dx) > 0\n    valid_diffs = []\n    for zy, zx in zeros:\n        dy = cy - zy\n        dx = cx - zx\n        if abs(dy) == abs(dx) and dy != 0:\n            valid_diffs.append((dy, dx))\n            \n    if not valid_diffs:\n        return [row[:] for row in grid]\n        \n    # Sort by magnitude\n    valid_diffs.sort(key=lambda x: abs(x[0]))\n    \n    # Determine the step vector\n    # If the max magnitude is equal to the size of the bounding box, it's a discrete non-overlapping jump\n    min_zy = min(z[0] for z in zeros)\n    max_zy = max(z[0] for z in zeros)\n    box_size = max_zy - min_zy + 1\n    \n    max_diff = valid_diffs[-1]\n    if abs(max_diff[0]) >= box_size:\n        step = max_diff\n    else:\n        step = valid_diffs[0]\n        \n    out_grid = [row[:] for row in grid]\n    \n    k = 1\n    while True:\n        cur_dy = k * step[0]\n        cur_dx = k * step[1]\n        \n        # Check if any part of the translated shape is in bounds\n        in_bounds = False\n        for zy, zx in zeros:\n            ny, nx = zy + cur_dy, zx + cur_dx\n            if 0 <= ny < rows and 0 <= nx < cols:\n                in_bounds = True\n                out_grid[ny][nx] = color_val\n                \n        if not in_bounds:\n            break\n        k += 1\n        \n    return out_grid\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    bg_color = None\n    counts = {}\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            counts[val] = counts.get(val, 0) + 1\n            \n    # background is the most common color\n    bg_color = max(counts, key=counts.get)\n    \n    zeros = []\n    color_val = None\n    color_pos = None\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val == 0:\n                zeros.append((r, c))\n            elif val != bg_color:\n                color_val = val\n                color_pos = (r, c)\n                \n    if not zeros or color_pos is None:\n        return [row[:] for row in grid]\n        \n    cy, cx = color_pos\n    \n    # Find all possible valid translations (dy, dx) where abs(dy) == abs(dx) > 0\n    valid_diffs = []\n    for zy, zx in zeros:\n        dy = cy - zy\n        dx = cx - zx\n        if abs(dy) == abs(dx) and dy != 0:\n            valid_diffs.append((dy, dx))\n            \n    if not valid_diffs:\n        return [row[:] for row in grid]\n        \n    # Sort by magnitude\n    valid_diffs.sort(key=lambda x: abs(x[0]))\n    \n    # Determine the step vector\n    # If the max magnitude is equal to the size of the bounding box, it's a discrete non-overlapping jump\n    min_zy = min(z[0] for z in zeros)\n    max_zy = max(z[0] for z in zeros)\n    box_size = max_zy - min_zy + 1\n    \n    max_diff = valid_diffs[-1]\n    if abs(max_diff[0]) >= box_size:\n        step = max_diff\n    else:\n        step = valid_diffs[0]\n        \n    out_grid = [row[:] for row in grid]\n    \n    k = 1\n    while True:\n        cur_dy = k * step[0]\n        cur_dx = k * step[1]\n        \n        # Check if any part of the translated shape is in bounds\n        in_bounds = False\n        for zy, zx in zeros:\n            ny, nx = zy + cur_dy, zx + cur_dx\n            if 0 <= ny < rows and 0 <= nx < cols:\n                in_bounds = True\n                out_grid[ny][nx] = color_val\n                \n        if not in_bounds:\n            break\n        k += 1\n        \n    return out_grid",
