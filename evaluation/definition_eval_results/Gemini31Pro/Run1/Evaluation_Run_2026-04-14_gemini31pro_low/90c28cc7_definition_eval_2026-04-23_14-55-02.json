  "script": "def solve(grid):\n    # Remove all-zero rows\n    non_zero_rows = [row for row in grid if any(val != 0 for val in row)]\n    if not non_zero_rows:\n        return []\n\n    # Remove all-zero columns\n    num_cols = len(non_zero_rows[0])\n    non_zero_cols_indices = [\n        c for c in range(num_cols)\n        if any(non_zero_rows[r][c] != 0 for r in range(len(non_zero_rows)))\n    ]\n    \n    compact_grid = [\n        [row[c] for c in non_zero_cols_indices]\n        for row in non_zero_rows\n    ]\n\n    # Remove adjacent duplicate rows\n    dedup_rows = []\n    for row in compact_grid:\n        if not dedup_rows or row != dedup_rows[-1]:\n            dedup_rows.append(row)\n\n    # Remove adjacent duplicate columns\n    if not dedup_rows:\n        return []\n\n    dedup_cols_grid = [[] for _ in range(len(dedup_rows))]\n    num_compact_cols = len(dedup_rows[0])\n    \n    for c in range(num_compact_cols):\n        current_col = [dedup_rows[r][c] for r in range(len(dedup_rows))]\n        if c == 0:\n            for r in range(len(dedup_rows)):\n                dedup_cols_grid[r].append(current_col[r])\n        else:\n            prev_col = [dedup_rows[r][c-1] for r in range(len(dedup_rows))]\n            if current_col != prev_col:\n                for r in range(len(dedup_rows)):\n                    dedup_cols_grid[r].append(current_col[r])\n\n    return dedup_cols_grid",
