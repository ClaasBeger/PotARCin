  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    if R == 0: return grid\n    C = len(grid[0])\n    out = [row[:] for row in grid]\n    visited = set()\n    \n    for r in range(R):\n        for c in range(C):\n            if out[r][c] == 1 and (r, c) not in visited:\n                q = [(r, c)]\n                visited.add((r, c))\n                comp = []\n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0:\n                                continue\n                            nr, nc = curr_r + dr, curr_c + dc\n                            if 0 <= nr < R and 0 <= nc < C and out[nr][nc] == 1 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                q.append((nr, nc))\n                \n                min_r = min(x[0] for x in comp)\n                max_r = max(x[0] for x in comp)\n                min_c = min(x[1] for x in comp)\n                max_c = max(x[1] for x in comp)\n                \n                color = None\n                for ir in range(min_r, max_r + 1):\n                    for ic in range(min_c, max_c + 1):\n                        if out[ir][ic] > 1:\n                            color = out[ir][ic]\n                            break\n                    if color is not None:\n                        break\n                \n                if color is not None:\n                    for ir in range(min_r, max_r + 1):\n                        for ic in range(min_c, max_c + 1):\n                            if out[ir][ic] == 0:\n                                out[ir][ic] = color\n                    if min_r > 0:\n                        for ic in range(min_c, max_c + 1):\n                            if out[min_r - 1][ic] == 0:\n                                out[min_r - 1][ic] = color\n                                \n    return out\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    if R == 0: return grid\n    C = len(grid[0])\n    out = [row[:] for row in grid]\n    visited = set()\n    \n    for r in range(R):\n        for c in range(C):\n            if out[r][c] == 1 and (r, c) not in visited:\n                q = [(r, c)]\n                visited.add((r, c))\n                comp = []\n                while q:\n                    curr_r, curr_c = q.pop(0)\n                    comp.append((curr_r, curr_c))\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0:\n                                continue\n                            nr, nc = curr_r + dr, curr_c + dc\n                            if 0 <= nr < R and 0 <= nc < C and out[nr][nc] == 1 and (nr, nc) not in visited:\n                                visited.add((nr, nc))\n                                q.append((nr, nc))\n                \n                min_r = min(x[0] for x in comp)\n                max_r = max(x[0] for x in comp)\n                min_c = min(x[1] for x in comp)\n                max_c = max(x[1] for x in comp)\n                \n                color = None\n                for ir in range(min_r, max_r + 1):\n                    for ic in range(min_c, max_c + 1):\n                        if out[ir][ic] > 1:\n                            color = out[ir][ic]\n                            break\n                    if color is not None:\n                        break\n                \n                if color is not None:\n                    for ir in range(min_r, max_r + 1):\n                        for ic in range(min_c, max_c + 1):\n                            if out[ir][ic] == 0:\n                                out[ir][ic] = color\n                    if min_r > 0:\n                        for ic in range(min_c, max_c + 1):\n                            if out[min_r - 1][ic] == 0:\n                                out[min_r - 1][ic] = color\n                                \n    return out",
