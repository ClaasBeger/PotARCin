  "raw_response": "def solve(grid):\n    out = [row[:] for row in grid]\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    if max_r == -1:\n        return out\n        \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0 and val != 8:\n                if min_r <= r <= max_r:\n                    if c < min_c:\n                        out[r][min_c] = val\n                    elif c > max_c:\n                        out[r][max_c] = val\n                elif min_c <= c <= max_c:\n                    if r < min_r:\n                        out[min_r][c] = val\n                    elif r > max_r:\n                        out[max_r][c] = val\n                        \n    return out",
  "script": "def solve(grid):\n    out = [row[:] for row in grid]\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                if r < min_r: min_r = r\n                if r > max_r: max_r = r\n                if c < min_c: min_c = c\n                if c > max_c: max_c = c\n                \n    if max_r == -1:\n        return out\n        \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0 and val != 8:\n                if min_r <= r <= max_r:\n                    if c < min_c:\n                        out[r][min_c] = val\n                    elif c > max_c:\n                        out[r][max_c] = val\n                elif min_c <= c <= max_c:\n                    if r < min_r:\n                        out[min_r][c] = val\n                    elif r > max_r:\n                        out[max_r][c] = val\n                        \n    return out",
