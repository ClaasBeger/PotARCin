  "raw_response": "```python\ndef solve(grid):\n    # Find the bounding box of 4s\n    fours = []\n    for r in range(len(grid)):\n        for c in range(len(grid[r])):\n            if grid[r][c] == 4:\n                fours.append((r, c))\n    \n    min_r = min(r for r, c in fours)\n    max_r = max(r for r, c in fours)\n    min_c = min(c for r, c in fours)\n    max_c = max(c for r, c in fours)\n    \n    height = max_r - min_r + 1\n    width = max_c - min_c + 1\n    \n    left_color = grid[min_r + 1][min_c]\n    right_color = grid[min_r + 1][max_c]\n    \n    left_shape = []\n    right_shape = []\n    \n    for r in range(len(grid)):\n        for c in range(len(grid[r])):\n            if min_r <= r <= max_r and min_c <= c <= max_c:\n                continue\n            if grid[r][c] == left_color:\n                left_shape.append((r, c))\n            elif grid[r][c] == right_color:\n                right_shape.append((r, c))\n                \n    out_grid = [[0 for _ in range(width)] for _ in range(height)]\n    out_grid[0][0] = 4\n    out_grid[0][width - 1] = 4\n    out_grid[height - 1][0] = 4\n    out_grid[height - 1][width - 1] = 4\n    \n    for i in range(1, height - 1):\n        out_grid[i][0] = left_color\n        out_grid[i][width - 1] = right_color\n        \n    if left_shape:\n        min_lr = min(r for r, c in left_shape)\n        min_lc = min(c for r, c in left_shape)\n        for r, c in left_shape:\n            out_grid[r - min_lr + 1][c - min_lc + 1] = left_color\n\n    if right_shape:\n        min_rr = min(r for r, c in right_shape)\n        max_rc = max(c for r, c in right_shape)\n        for r, c in right_shape:\n            out_grid[r - min_rr + 1][width - 2 - (max_rc - c)] = right_color\n\n    return out_grid\n```",
  "script": "def solve(grid):\n    # Find the bounding box of 4s\n    fours = []\n    for r in range(len(grid)):\n        for c in range(len(grid[r])):\n            if grid[r][c] == 4:\n                fours.append((r, c))\n    \n    min_r = min(r for r, c in fours)\n    max_r = max(r for r, c in fours)\n    min_c = min(c for r, c in fours)\n    max_c = max(c for r, c in fours)\n    \n    height = max_r - min_r + 1\n    width = max_c - min_c + 1\n    \n    left_color = grid[min_r + 1][min_c]\n    right_color = grid[min_r + 1][max_c]\n    \n    left_shape = []\n    right_shape = []\n    \n    for r in range(len(grid)):\n        for c in range(len(grid[r])):\n            if min_r <= r <= max_r and min_c <= c <= max_c:\n                continue\n            if grid[r][c] == left_color:\n                left_shape.append((r, c))\n            elif grid[r][c] == right_color:\n                right_shape.append((r, c))\n                \n    out_grid = [[0 for _ in range(width)] for _ in range(height)]\n    out_grid[0][0] = 4\n    out_grid[0][width - 1] = 4\n    out_grid[height - 1][0] = 4\n    out_grid[height - 1][width - 1] = 4\n    \n    for i in range(1, height - 1):\n        out_grid[i][0] = left_color\n        out_grid[i][width - 1] = right_color\n        \n    if left_shape:\n        min_lr = min(r for r, c in left_shape)\n        min_lc = min(c for r, c in left_shape)\n        for r, c in left_shape:\n            out_grid[r - min_lr + 1][c - min_lc + 1] = left_color\n\n    if right_shape:\n        min_rr = min(r for r, c in right_shape)\n        max_rc = max(c for r, c in right_shape)\n        for r, c in right_shape:\n            out_grid[r - min_rr + 1][width - 2 - (max_rc - c)] = right_color\n\n    return out_grid",
