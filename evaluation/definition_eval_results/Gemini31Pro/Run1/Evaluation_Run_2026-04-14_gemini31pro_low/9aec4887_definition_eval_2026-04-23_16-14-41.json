 for c in range(out_w - 2, 0, -1):\n            if out[r][c] == 8:\n                break\n            out[r][c] = right_c\n    # Top\n    for c in range(1, out_w - 1):\n        for r in range(1, out_h - 1):\n            if out[r][c] == 8:\n                break\n            out[r][c] = top_c\n    # Bottom\n    for c in range(1, out_w - 1):\n        for r in range(out_h - 2, 0, -1):\n            if out[r][c] == 8:\n                break\n            out[r][c] = bottom_c\n            \n    return out",
