  "raw_response": "```python\ndef solve(grid):\n    # Find the shape of 8s\n    r_min_8, r_max_8 = len(grid), -1\n    c_min_8, c_max_8 = len(grid[0]), -1\n    for r in range(len(grid)):\n        for c in range(len(grid[0])):\n            if grid[r][c] == 8:\n                r_min_8 = min(r_min_8, r)\n                r_max_8 = max(r_max_8, r)\n                c_min_8 = min(c_min_8, c)\n                c_max_8 = max(c_max_8, c)\n    \n    # Extract the 8s shape\n    h_8 = r_max_8 - r_min_8 + 1\n    w_8 = c_max_8 - c_min_8 + 1\n    shape_8 = []\n    for r in range(r_min_8, r_max_8 + 1):\n        shape_8.append([grid[r][c] for c in range(c_min_8, c_max_8 + 1)])\n        \n    # Find the frame bounds and colors\n    r_min_f, r_max_f = len(grid), -1\n    c_min_f, c_max_f = len(grid[0]), -1\n    colors = set()\n    for r in range(len(grid)):\n        for c in range(len(grid[0])):\n            if grid[r][c] not in (0, 8):\n                r_min_f = min(r_min_f, r)\n                r_max_f = max(r_max_f, r)\n                c_min_f = min(c_min_f, c)\n                c_max_f = max(c_max_f, c)\n                colors.add(grid[r][c])\n                \n    top_c = grid[r_min_f][c_min_f + 1]\n    bottom_c = grid[r_max_f][c_min_f + 1]\n    left_c = grid[r_min_f + 1][c_min_f]\n    right_c = grid[r_min_f + 1][c_max_f]\n    \n    out_h = h_8 + 2\n    out_w = w_8 + 2\n    out = [[0] * out_w for _ in range(out_h)]\n    \n    for c in range(1, out_w - 1):\n        out[0][c] = top_c\n        out[out_h - 1][c] = bottom_c\n    for r in range(1, out_h - 1):\n        out[r][0] = left_c\n        out[r][out_w - 1] = right_c\n        \n    for r in range(h_8):\n        for c in range(w_8):\n            out[r+1][c+1] = shape_8[r][c]\n            \n    # Raycast inwards to fill the gaps\n    # Left\n    for r in range(1, out_h - 1):\n        for c in range(1, out_w - 1):\n            if out[r][c] == 8:\n                break\n            out[r][c] = left_c\n    # Right\n    for r in range(1, out_h - 1):\n        for c in range(out_w - 2, 0, -1):\n            if out[r][c] == 8:\n                break\n            out[r][c] = right_c\n    # Top\n    for c in range(1, out_w - 1):\n        for r in range(1, out_h - 1):\n            if out[r][c] == 8:\n                break\n            out[r][c] = top_c\n    # Bottom\n    for c in range(1, out_w - 1):\n        for r in range(out_h - 2, 0, -1):\n            if out[r][c] == 8:\n                break\n            out[r][c] = bottom_c\n            \n    return out\n```",
