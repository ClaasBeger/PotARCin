  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Find all coordinates of 2s\n    twos = set()\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 2:\n                twos.add((r, c))\n                \n    # Group 2s into vertical lines\n    lines = []\n    visited = set()\n    for r in range(R):\n        for c in range(C):\n            if (r, c) in twos and (r, c) not in visited:\n                line = []\n                curr_r = r\n                while (curr_r, c) in twos:\n                    line.append((curr_r, c))\n                    visited.add((curr_r, c))\n                    curr_r += 1\n                lines.append(line)\n                \n    # Find the shooting pattern (offsets of rows with 8s)\n    pattern = []\n    for line in lines:\n        c = line[0][1]\n        has_targets = False\n        for offset, (r, _) in enumerate(line):\n            if 8 in grid[r]:\n                pattern.append(offset)\n                has_targets = True\n        if has_targets:\n            break\n            \n    out_grid = [row[:] for row in grid]\n    \n    # Apply transformations for each line of 2s\n    for line in lines:\n        c = line[0][1]\n        direction = 1 if c < C / 2 else -1\n        \n        has_target = any(8 in grid[r] for r, _ in line)\n        \n        if has_target:\n            # Line with targets: shoot to the 8, turning it into 4\n            for r, _ in line:\n                if 8 in grid[r]:\n                    t_c = grid[r].index(8)\n                    out_grid[r][t_c] = 4\n                    step = 1 if t_c > c else -1\n                    curr = c + step\n                    while curr != t_c:\n                        out_grid[r][curr] = 8\n                        curr += step\n        else:\n            # Line without targets: shoot all the way across the grid based on pattern\n            for offset in pattern:\n                if offset < len(line):\n                    r = line[offset][0]\n                    step = direction\n                    curr = c + step\n                    while 0 <= curr < C:\n                        out_grid[r][curr] = 8\n                        curr += step\n                        \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    # Find all coordinates of 2s\n    twos = set()\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 2:\n                twos.add((r, c))\n                \n    # Group 2s into vertical lines\n    lines = []\n    visited = set()\n    for r in range(R):\n        for c in range(C):\n            if (r, c) in twos and (r, c) not in visited:\n                line = []\n                curr_r = r\n                while (curr_r, c) in twos:\n                    line.append((curr_r, c))\n                    visited.add((curr_r, c))\n                    curr_r += 1\n                lines.append(line)\n                \n    # Find the shooting pattern (offsets of rows with 8s)\n    pattern = []\n    for line in lines:\n        c = line[0][1]\n        has_targets = False\n        for offset, (r, _) in enumerate(line):\n            if 8 in grid[r]:\n                pattern.append(offset)\n                has_targets = True\n        if has_targets:\n            break\n            \n    out_grid = [row[:] for row in grid]\n    \n    # Apply transformations for each line of 2s\n    for line in lines:\n        c = line[0][1]\n        direction = 1 if c < C / 2 else -1\n        \n        has_target = any(8 in grid[r] for r, _ in line)\n        \n        if has_target:\n            # Line with targets: shoot to the 8, turning it into 4\n            for r, _ in line:\n                if 8 in grid[r]:\n                    t_c = grid[r].index(8)\n                    out_grid[r][t_c] = 4\n                    step = 1 if t_c > c else -1\n                    curr = c + step\n                    while curr != t_c:\n                        out_grid[r][curr] = 8\n                        curr += step\n        else:\n            # Line without targets: shoot all the way across the grid based on pattern\n            for offset in pattern:\n                if offset < len(line):\n                    r = line[offset][0]\n                    step = direction\n                    curr = c + step\n                    while 0 <= curr < C:\n                        out_grid[r][curr] = 8\n                        curr += step\n                        \n    return out_grid",
