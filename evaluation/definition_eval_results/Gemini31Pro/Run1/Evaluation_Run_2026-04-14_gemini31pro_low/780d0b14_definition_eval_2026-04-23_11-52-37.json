  "raw_response": "def solve(grid):\n    row_is_empty = [all(c == 0 for c in row) for row in grid]\n    \n    strips = []\n    current_strip = []\n    for r, empty in enumerate(row_is_empty):\n        if empty:\n            if current_strip:\n                strips.append(current_strip)\n                current_strip = []\n        else:\n            current_strip.append(r)\n    if current_strip:\n        strips.append(current_strip)\n        \n    out_grid = []\n    for strip_rows in strips:\n        col_is_empty = []\n        for c in range(len(grid[0])):\n            if all(grid[r][c] == 0 for r in strip_rows):\n                col_is_empty.append(True)\n            else:\n                col_is_empty.append(False)\n                \n        regions = []\n        current_region = []\n        for c, empty in enumerate(col_is_empty):\n            if empty:\n                if current_region:\n                    regions.append(current_region)\n                    current_region = []\n            else:\n                current_region.append(c)\n        if current_region:\n            regions.append(current_region)\n            \n        out_row = []\n        for reg_cols in regions:\n            counts = {}\n            for r in strip_rows:\n                for c in reg_cols:\n                    val = grid[r][c]\n                    if val != 0:\n                        counts[val] = counts.get(val, 0) + 1\n            if counts:\n                most_frequent = max(counts.keys(), key=lambda k: counts[k])\n                out_row.append(most_frequent)\n        if out_row:\n            out_grid.append(out_row)\n            \n    return out_grid",
  "script": "def solve(grid):\n    row_is_empty = [all(c == 0 for c in row) for row in grid]\n    \n    strips = []\n    current_strip = []\n    for r, empty in enumerate(row_is_empty):\n        if empty:\n            if current_strip:\n                strips.append(current_strip)\n                current_strip = []\n        else:\n            current_strip.append(r)\n    if current_strip:\n        strips.append(current_strip)\n        \n    out_grid = []\n    for strip_rows in strips:\n        col_is_empty = []\n        for c in range(len(grid[0])):\n            if all(grid[r][c] == 0 for r in strip_rows):\n                col_is_empty.append(True)\n            else:\n                col_is_empty.append(False)\n                \n        regions = []\n        current_region = []\n        for c, empty in enumerate(col_is_empty):\n            if empty:\n                if current_region:\n                    regions.append(current_region)\n                    current_region = []\n            else:\n                current_region.append(c)\n        if current_region:\n            regions.append(current_region)\n            \n        out_row = []\n        for reg_cols in regions:\n            counts = {}\n            for r in strip_rows:\n                for c in reg_cols:\n                    val = grid[r][c]\n                    if val != 0:\n                        counts[val] = counts.get(val, 0) + 1\n            if counts:\n                most_frequent = max(counts.keys(), key=lambda k: counts[k])\n                out_row.append(most_frequent)\n        if out_row:\n            out_grid.append(out_row)\n            \n    return out_grid",
