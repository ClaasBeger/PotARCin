text or markdown.",
  "raw_response": "def solve(grid):\n    rows = len(grid)\n    if rows == 0: return []\n    cols = len(grid[0])\n    \n    color = 0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                color = grid[r][c]\n                break\n        if color != 0:\n            break\n            \n    if color == 0:\n        return []\n\n    visited = set()\n    components = 0\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == color and (r, c) not in visited:\n                components += 1\n                stack = [(r, c)]\n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    if (curr_r, curr_c) not in visited:\n                        visited.add((curr_r, curr_c))\n                        for dr in [-1, 0, 1]:\n                            for dc in [-1, 0, 1]:\n                                if dr == 0 and dc == 0:\n                                    continue\n                                nr, nc = curr_r + dr, curr_c + dc\n                                if 0 <= nr < rows and 0 <= nc < cols:\n                                    if grid[nr][nc] == color and (nr, nc) not in visited:\n                                        stack.append((nr, nc))\n                                        \n    output = []\n    for i in range(components):\n        row = [0] * components\n        row[i] = color\n        output.append(row)\n        \n    return output",
  "script": "def solve(grid):\n    rows = len(grid)\n    if rows == 0: return []\n    cols = len(grid[0])\n    \n    color = 0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                color = grid[r][c]\n                break\n        if color != 0:\n            break\n            \n    if color == 0:\n        return []\n\n    visited = set()\n    components = 0\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == color and (r, c) not in visited:\n                components += 1\n                stack = [(r, c)]\n                while stack:\n                    curr_r, curr_c = stack.pop()\n                    if (curr_r, curr_c) not in visited:\n                        visited.add((curr_r, curr_c))\n                        for dr in [-1, 0, 1]:\n                            for dc in [-1, 0, 1]:\n                                if dr == 0 and dc == 0:\n                                    continue\n                                nr, nc = curr_r + dr, curr_c + dc\n                                if 0 <= nr < rows and 0 <= nc < cols:\n                                    if grid[nr][nc] == color and (nr, nc) not in visited:\n                                        stack.append((nr, nc))\n                                        \n    output = []\n    for i in range(components):\n        row = [0] * components\n        row[i] = color\n        output.append(row)\n        \n    return output",
