  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    points = []\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                points.append((r, c, grid[r][c]))\n                \n    if len(points) != 2:\n        return [row[:] for row in grid]\n        \n    p1, p2 = points\n    # Ensure p1 is before p2 in either row or col\n    if p1[0] > p2[0] or p1[1] > p2[1]:\n        p1, p2 = p2, p1\n        \n    r1, c1, color1 = p1\n    r2, c2, color2 = p2\n    \n    out = [[0]*C for _ in range(R)]\n    \n    if c1 == c2:\n        # Vertical alignment\n        mid1 = (r1 + r2) // 2\n        mid2 = mid1 + 1\n        \n        # Stems\n        for r in range(r1, mid1):\n            out[r][c1] = color1\n        for r in range(mid2 + 1, r2 + 1):\n            out[r][c1] = color2\n            \n        # Loop for color 1\n        top_edge_r = mid1 - 1\n        for c in range(c1 - 2, c1 + 3):\n            if 0 <= c < C:\n                out[top_edge_r][c] = color1\n        if 0 <= c1 - 2 < C: out[mid1][c1 - 2] = color1\n        if 0 <= c1 + 2 < C: out[mid1][c1 + 2] = color1\n        \n        # Loop for color 2\n        bottom_edge_r = mid2 + 1\n        for c in range(c1 - 2, c1 + 3):\n            if 0 <= c < C:\n                out[bottom_edge_r][c] = color2\n        if 0 <= c1 - 2 < C: out[mid2][c1 - 2] = color2\n        if 0 <= c1 + 2 < C: out[mid2][c1 + 2] = color2\n        \n    elif r1 == r2:\n        # Horizontal alignment\n        mid1 = (c1 + c2) // 2\n        mid2 = mid1 + 1\n        \n        # Stems\n        for c in range(c1, mid1):\n            out[r1][c] = color1\n        for c in range(mid2 + 1, c2 + 1):\n            out[r1][c] = color2\n            \n        # Loop for color 1\n        left_edge_c = mid1 - 1\n        for r in range(r1 - 2, r1 + 3):\n            if 0 <= r < R:\n                out[r][left_edge_c] = color1\n        if 0 <= r1 - 2 < R: out[r1 - 2][mid1] = color1\n  