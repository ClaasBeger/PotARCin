  "raw_response": "def solve(grid):\n    counts = {}\n    for row in grid:\n        for val in row:\n            counts[val] = counts.get(val, 0) + 1\n            \n    max_val = None\n    max_count = -1\n    for val, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_val = val\n            \n    out_grid = []\n    for row in grid:\n        out_row = []\n        for val in row:\n            if val == max_val:\n                out_row.append(val)\n            else:\n                out_row.append(5)\n        out_grid.append(out_row)\n        \n    return out_grid",
