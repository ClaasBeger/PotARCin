 0 0 0\n2 2 2 2 2 2\n0 3 0 0 0 0\n0 3 0 0 0 0\n0 3 0 0 0 0\n\nBelow is a test input grid.\n\nInput:\n0 0 4 4 0 0\n0 0 4 4 0 0\n5 5 4 4 5 5\n5 5 4 4 5 5\n0 0 4 4 0 0\n0 0 4 4 0 0\n0 0 4 4 0 0\n0 0 4 4 0 0\n0 0 4 4 0 0\n0 0 4 4 0 0\n0 0 4 4 0 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    num_rows = len(grid)\n    num_cols = len(grid[0])\n    \n    colors = list(set(val for row in grid for val in row if val != 0))\n    if len(colors) != 2:\n        return grid  # Fallback if assumptions don't hold\n    \n    int_rows = [r for r in range(num_rows) if 0 not in grid[r]]\n    int_cols = [c for c in range(num_cols) if 0 not in [grid[r][c] for r in range(num_rows)]]\n    \n    out_grid = [row[:] for row in grid]\n    \n    for r in int_rows:\n        for c in int_cols:\n            current = out_grid[r][c]\n            new_color = colors[0] if current == colors[1] else colors[1]\n            out_grid[r][c] = new_color\n            \n    return out_grid",
  "script": "def solve(grid):\n    num_rows = len(grid)\n    num_cols = len(grid[0])\n    \n    colors = list(set(val for row in grid for val in row if val != 0))\n    if len(colors) != 2:\n        return grid  # Fallback if assumptions don't hold\n    \n    int_rows = [r for r in range(num_rows) if 0 not in grid[r]]\n    int_cols = [c for c in range(num_cols) if 0 not in [grid[r][c] for r in range(num_rows)]]\n    \n    out_grid = [row[:] for row in grid]\n    \n    for r in int_rows:\n        for c in int_cols:\n            current = out_grid[r][c]\n            new_color = colors[0] if current == colors[1] else colors[1]\n            out_grid[r][c] = new_color\n            \n    return out_grid",
