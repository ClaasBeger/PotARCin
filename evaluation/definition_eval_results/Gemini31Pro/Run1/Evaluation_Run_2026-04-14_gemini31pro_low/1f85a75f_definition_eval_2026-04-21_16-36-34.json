  "raw_response": "```python\ndef solve(grid):\n    colors = set(c for row in grid for c in row if c != 0)\n    for color in colors:\n        rs = [r for r, row in enumerate(grid) for c, val in enumerate(row) if val == color]\n        cs = [c for r, row in enumerate(grid) for c, val in enumerate(row) if val == color]\n        \n        if not rs:\n            continue\n            \n        min_r, max_r = min(rs), max(rs)\n        min_c, max_c = min(cs), max(cs)\n        \n        # The target block will be localized, whereas noise colors are scattered across the grid\n        if (max_r - min_r) < 15 and (max_c - min_c) < 15:\n            out = []\n            for r in range(min_r, max_r + 1):\n                row_out = []\n                for c in range(min_c, max_c + 1):\n                    # Keep only the target color, set everything else (like 0s or any overlapping noise) to 0\n                    row_out.append(grid[r][c] if grid[r][c] == color else 0)\n                out.append(row_out)\n            return out\n            \n    return []\n```",
  "script": "def solve(grid):\n    colors = set(c for row in grid for c in row if c != 0)\n    for color in colors:\n        rs = [r for r, row in enumerate(grid) for c, val in enumerate(row) if val == color]\n        cs = [c for r, row in enumerate(grid) for c, val in enumerate(row) if val == color]\n        \n        if not rs:\n            continue\n            \n        min_r, max_r = min(rs), max(rs)\n        min_c, max_c = min(cs), max(cs)\n        \n        # The target block will be localized, whereas noise colors are scattered across the grid\n        if (max_r - min_r) < 15 and (max_c - min_c) < 15:\n            out = []\n            for r in range(min_r, max_r + 1):\n                row_out = []\n                for c in range(min_c, max_c + 1):\n                    # Keep only the target color, set everything else (like 0s or any overlapping noise) to 0\n                    row_out.append(grid[r][c] if grid[r][c] == color else 0)\n                out.append(row_out)\n            return out\n            \n    return []",
