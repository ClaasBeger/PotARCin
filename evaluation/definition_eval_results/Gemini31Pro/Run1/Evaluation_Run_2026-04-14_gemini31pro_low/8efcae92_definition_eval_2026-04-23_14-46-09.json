  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    visited = set()\n    best_block = None\n    max_twos = -1\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0 and (r, c) not in visited:\n                r_end = r\n                while r_end < R and grid[r_end][c] != 0:\n                    r_end += 1\n                \n                c_end = c\n                while c_end < C and grid[r][c_end] != 0:\n                    c_end += 1\n                \n                block = []\n                twos_count = 0\n                for rr in range(r, r_end):\n                    row_block = []\n                    for cc in range(c, c_end):\n                        val = grid[rr][cc]\n                        row_block.append(val)\n                        if val == 2:\n                            twos_count += 1\n                        visited.add((rr, cc))\n                    block.append(row_block)\n                \n                if twos_count > max_twos:\n                    max_twos = twos_count\n                    best_block = block\n\n    return best_block",
