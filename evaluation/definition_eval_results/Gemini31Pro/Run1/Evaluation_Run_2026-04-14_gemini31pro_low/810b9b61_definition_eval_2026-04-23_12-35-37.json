  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    if R == 0:\n        return grid\n    C = len(grid[0])\n    visited = set()\n    \n    out_grid = [row[:] for row in grid]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 1 and (r, c) not in visited:\n                comp = []\n                q = [(r, c)]\n                visited.add((r, c))\n                head = 0\n                # Use 8-way connectivity to find the full isolated component\n                while head < len(q):\n                    curr_r, curr_c = q[head]\n                    comp.append((curr_r, curr_c))\n                    head += 1\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0:\n                                continue\n                            nr, nc = curr_r + dr, curr_c + dc\n                            if 0 <= nr < R and 0 <= nc < C and grid[nr][nc] == 1:\n                                if (nr, nc) not in visited:\n                                    visited.add((nr, nc))\n                                    q.append((nr, nc))\n                \n                min_r = min(x[0] for x in comp)\n                max_r = max(x[0] for x in comp)\n                min_c = min(x[1] for x in comp)\n                max_c = max(x[1] for x in comp)\n                \n                w = max_c - min_c + 1\n                h = max_r - min_r + 1\n                \n                # Check if the component is exactly a hollow rectangle\n                if w >= 3 and h >= 3 and len(comp) == 2 * w + 2 * h - 4:\n                    is_rect = True\n                    comp_set = set(comp)\n                    # Check horizontal boundaries\n                    for c_b in range(min_c, max_c + 1):\n                        if (min_r, c_b) not in comp_set or (max_r, c_b) not in comp_set:\n                            is_rect = False\n                            break\n                    # Check vertical boundaries\n                    for r_b in range(min_r, max_r + 1):\n                        if (r_b, min_c) not in comp_set or (r_b, max_c) not in comp_set:\n                            is_rect = False\n                            break\n                            \n                    if is_rect:\n                        for rr, cc in comp:\n                            out_grid[rr][cc] = 3\n                            \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    if R == 0:\n        return grid\n    C = len(grid[0])\n    visited = set()\n    \n    out_grid = [row[:] for row in grid]\n    \n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == 1 and (r, c) not in visited:\n                comp = []\n                q = [(r, c)]\n                visited.add((r, c))\n                head = 0\n                # Use 8-way connectivity to find the full isolated component\n                while head < len(q):\n                    curr_r, curr_c = q[head]\n                    comp.append((curr_r, curr_c))\n                    head += 1\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0:\n                                continue\n                            nr, nc = curr_r + dr, curr_c + dc\n                            if 0 <= nr < R and 0 <= nc < C and grid[nr][nc] == 1:\n                                if (nr, nc) not in visited:\n                                    visited.add((nr, nc))\n                                    q.append((nr, nc))\n                \n                min_r = min(x[0] for x in comp)\n                max_r = max(x[0] for x in comp)\n                min_c = min(x[1] for x in comp)\n                max_c = max(x[1] for x in comp)\n                \n                w = max_c - min_c + 1\n                h = max_r - min_r + 1\n                \n                # Check if the component is exactly a hollow rectangle\n                if w >= 3 and h >= 3 and len(comp) == 2 * w + 2 * h - 4:\n                    is_rect = True\n                    comp_set = set(comp)\n                    # Check horizontal boundaries\n                    for c_b in range(min_c, max_c + 1):\n                        if (min_r, c_b) not in comp_set or (max_r, c_b) not in comp_set:\n                            is_rect = False\n                            break\n                    # Check vertical boundaries\n                    for r_b in range(min_r, max_r + 1):\n                        if (r_b, min_c) not in comp_set or (r_b, max_c) not in comp_set:\n                            is_rect = False\n                            break\n                            \n                    if is_rect:\n                        for rr, cc in comp:\n                            out_grid[rr][cc] = 3\n                            \n    return out_grid",
