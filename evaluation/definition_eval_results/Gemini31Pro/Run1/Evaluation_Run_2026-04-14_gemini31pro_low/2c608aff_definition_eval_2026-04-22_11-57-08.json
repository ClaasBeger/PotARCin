  "raw_response": "```python\ndef solve(grid):\n    import collections\n\n    R = len(grid)\n    C = len(grid[0])\n    \n    counts = collections.Counter(val for row in grid for val in row)\n    bg_color = counts.most_common(1)[0][0]\n    \n    non_bg_counts = [c for c in counts.most_common() if c[0] != bg_color]\n    block_color = non_bg_counts[0][0]\n    dot_color = non_bg_counts[1][0]\n    \n    min_r, max_r = R, -1\n    min_c, max_c = C, -1\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == block_color:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    res = [row[:] for row in grid]\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == dot_color:\n                if min_r <= r <= max_r:\n                    if c < min_c:\n                        for nc in range(c + 1, min_c):\n                            res[r][nc] = dot_color\n                    elif c > max_c:\n                        for nc in range(max_c + 1, c):\n                            res[r][nc] = dot_color\n                elif min_c <= c <= max_c:\n                    if r < min_r:\n                        for nr in range(r + 1, min_r):\n                            res[nr][c] = dot_color\n                    elif r > max_r:\n                        for nr in range(max_r + 1, r):\n                            res[nr][c] = dot_color\n                            \n    return res\n```",
  "script": "def solve(grid):\n    import collections\n\n    R = len(grid)\n    C = len(grid[0])\n    \n    counts = collections.Counter(val for row in grid for val in row)\n    bg_color = counts.most_common(1)[0][0]\n    \n    non_bg_counts = [c for c in counts.most_common() if c[0] != bg_color]\n    block_color = non_bg_counts[0][0]\n    dot_color = non_bg_counts[1][0]\n    \n    min_r, max_r = R, -1\n    min_c, max_c = C, -1\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == block_color:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    res = [row[:] for row in grid]\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] == dot_color:\n                if min_r <= r <= max_r:\n                    if c < min_c:\n                        for nc in range(c + 1, min_c):\n                            res[r][nc] = dot_color\n                    elif c > max_c:\n                        for nc in range(max_c + 1, c):\n                            res[r][nc] = dot_color\n                elif min_c <= c <= max_c:\n                    if r < min_r:\n                        for nr in range(r + 1, min_r):\n                            res[nr][c] = dot_color\n                    elif r > max_r:\n                        for nr in range(max_r + 1, r):\n                            res[nr][c] = dot_color\n                            \n    return res",
