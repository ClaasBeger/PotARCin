4 7 1 5 8 4\n4 0 3 8 8 8 8 8 8 8 8 4 2 4 3 4 5\n3 7 7 8 8 8 8 8 8 8 8 4 8 7 7 1 8\n6 6 4 7 6 8 1 8 1 9 2 6 8 7 2 8 8\n7 3 5 1 4 1 6 4 9 6 7 7 9 2 3 0 2\n9 2 2 5 4 8 3 9 9 9 5 9 6 1 4 6 9\n6 1 9 6 3 1 6 6 8 6 0 1 3 4 8 7 7\n2 1 2 4 9 2 1 5 1 7 0 7 9 3 8 2 1\n7 1 9 4 2 8 4 3 6 2 8 0 8 5 3 5 9\n1 2 5 7 8 7 1 6 5 8 0 9 2 8 9 1 5\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    max_area = 0\n    best_rect = None\n    best_colors = None\n    \n    # Check all pairs of colors\n    for c1 in range(10):\n        for c2 in range(c1, 10):\n            allowed = {c1, c2}\n            \n            # Create a histogram for each row to find maximal rectangle\n            height = [0] * C\n            for r in range(R):\n                for c in range(C):\n                    if grid[r][c] in allowed:\n                        height[c] += 1\n                    else:\n                        height[c] = 0\n                \n                # Evaluate maximal rectangle in histogram\n                stack = []\n                for c in range(C + 1):\n                    h = height[c] if c < C else 0\n                    while stack and h < height[stack[-1]]:\n                        idx = stack.pop()\n                        h_rect = height[idx]\n                        w_rect = c if not stack else c - stack[-1] - 1\n                        area = h_rect * w_rect\n                        \n                        if area > max_area and h_rect >= 3 and w_rect >= 3:\n                            # To be perfectly accurate, we verify the number of unique colors\n                            # within this rectangle. It must be <= 2.\n                            r_start = r - h_rect + 1\n                            r_end = r\n                            c_start = c - w_rect if not stack else stack[-1] + 1\n                            c_end = c - 1\n                            \n                            max_area = area\n                            best_rect = (r_start, r_end, c_start, c_end)\n                            best_colors = allowed\n                    stack.append(c)\n\n    # Extract the block\n    r_start, r_end, c_start, c_end = best_rect\n    subgrid = [row[c_start:c_end+1] for row in grid[r_start:r_end+1]]\n    \n    # Identify background and foreground colors\n    counts = {}\n    for row in subgrid:\n        for val in row:\n            counts[val] = counts.get(val, 0) + 1\n            \n    if len(counts) == 1:\n        return subgrid\n        \n    sorted_colors = sorted(counts.items(), key=lambda x: x[1], reverse=True)\n    bg_color = sorted_colors[0][0]\n    fg_color = sorted_colors[1][0]\n    \n    H = r_end - r_start + 1\n    W = c_end - c_start + 1\n    \n    # Find positions of fg_color\n    fg_rows = set()\n    fg_cols = set()\n    for r in range(H):\n        for c in range(W):\n            if subgrid[r][c] == fg_color:\n                fg_rows.add(r)\n                fg_cols.add(c)\n                \n    # Create the output\n    out_grid = [[bg_color for _ in range(W)] for _ in range(H)]\n    for r in range(H):\n        for c in range(W):\n            if r in fg_rows or c in fg_cols:\n                out_grid[r][c] = fg_color\n                \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    max_area = 0\n    best_rect = None\n    best_colors = None\n    \n    # Check all pairs of colors\n    for c1 in range(10):\n        for c2 in range(c1, 10):\n            allowed = {c1, c2}\n            \n            # Create a histogram for each row to find maximal rectangle\n            height = [0] * C\n            for r in range(R):\n                for c in range(C):\n                    if grid[r][c] in allowed:\n                        height[c] += 1\n                    else:\n                        height[c] = 0\n                \n                # Evaluate maximal rectangle in histogram\n                stack = []\n                for c in range(C + 1):\n                    h = height[c] if c < C else 0\n                    while stack and h < height[stack[-1]]:\n                        idx = stack.pop()\n                        h_rect = height[idx]\n                        w_rect = c if not stack else c - stack[-1] - 1\n                        area = h_rect * w_rect\n                        \n                        if area > max_area and h_rect >= 3 and w_rect >= 3:\n                            # To be perfectly accurate, we verify the number of unique colors\n                            # within this rectangle. It must be <= 2.\n                            r_start = r - h_rect + 1\n                            r_end = r\n                            c_start = c - w_rect if not stack else stack[-1] + 1\n                            c_end = c - 1\n                            \n                            max_area = area\n                            best_rect = (r_start, r_end, c_start, c_end)\n                            best_colors = allowed\n                    stack.append(c)\n\n    # Extract the block\n    r_start, r_end, c_start, c_end = best_rect\n    subgrid = [row[c_start:c_end+1] for row in grid[r_start:r_end+1]]\n    \n    # Identify background and foreground colors\n    counts = {}\n    for row in subgrid:\n        for val in row:\n            counts[val] = counts.get(val, 0) + 1\n            \n    if len(counts) == 1:\n        return subgrid\n        \n    sorted_colors = sorted(counts.items(), key=lambda x: x[1], reverse=True)\n    bg_color = sorted_colors[0][0]\n    fg_color = sorted_colors[1][0]\n    \n    H = r_end - r_start + 1\n    W = c_end - c_start + 1\n    \n    # Find positions of fg_color\n    fg_rows = set()\n    fg_cols = set()\n    for r in range(H):\n        for c in range(W):\n            if subgrid[r][c] == fg_color:\n                fg_rows.add(r)\n                fg_cols.add(c)\n                \n    # Create the output\n    out_grid = [[bg_color for _ in range(W)] for _ in range(H)]\n    for r in range(H):\n        for c in range(W):\n            if r in fg_rows or c in fg_cols:\n                out_grid[r][c] = fg_color\n                \n    return out_grid",
