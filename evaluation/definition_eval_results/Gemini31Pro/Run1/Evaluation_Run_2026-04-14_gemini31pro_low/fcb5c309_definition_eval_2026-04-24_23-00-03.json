  "raw_response": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    best_rect = None\n    best_area = 0\n    best_k = 0\n    \n    for r1 in range(R):\n        for c1 in range(C):\n            for r2 in range(r1 + 2, R):\n                for c2 in range(c1 + 2, C):\n                    border_color = grid[r1][c1]\n                    if border_color == 0:\n                        continue\n                    \n                    # check border\n                    is_border = True\n                    for r in range(r1, r2 + 1):\n                        if grid[r][c1] != border_color or grid[r][c2] != border_color:\n                            is_border = False\n                            break\n                    if not is_border: continue\n                    for c in range(c1, c2 + 1):\n                        if grid[r1][c] != border_color or grid[r2][c] != border_color:\n                            is_border = False\n                            break\n                    if not is_border: continue\n                    \n                    # check interior\n                    interior_colors = set()\n                    for r in range(r1 + 1, r2):\n                        for c in range(c1 + 1, c2):\n                            if grid[r][c] != 0:\n                                interior_colors.add(grid[r][c])\n                    \n                    if len(interior_colors) == 1:\n                        k = list(interior_colors)[0]\n                        if k != border_color:\n                            area = (r2 - r1 + 1) * (c2 - c1 + 1)\n                            if area > best_area:\n                                best_area = area\n                                best_rect = (r1, c1, r2, c2)\n                                best_k = k\n\n    r1, c1, r2, c2 = best_rect\n    out = []\n    for r in range(r1, r2 + 1):\n        row = []\n        for c in range(c1, c2 + 1):\n            if r == r1 or r == r2 or c == c1 or c == c2:\n                row.append(best_k)\n            else:\n                row.append(grid[r][c])\n        out.append(row)\n    return out",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    best_rect = None\n    best_area = 0\n    best_k = 0\n    \n    for r1 in range(R):\n        for c1 in range(C):\n            for r2 in range(r1 + 2, R):\n                for c2 in range(c1 + 2, C):\n                    border_color = grid[r1][c1]\n                    if border_color == 0:\n                        continue\n                    \n                    # check border\n                    is_border = True\n                    for r in range(r1, r2 + 1):\n                        if grid[r][c1] != border_color or grid[r][c2] != border_color:\n                            is_border = False\n                            break\n                    if not is_border: continue\n                    for c in range(c1, c2 + 1):\n                        if grid[r1][c] != border_color or grid[r2][c] != border_color:\n                            is_border = False\n                            break\n                    if not is_border: continue\n                    \n                    # check interior\n                    interior_colors = set()\n                    for r in range(r1 + 1, r2):\n                        for c in range(c1 + 1, c2):\n                            if grid[r][c] != 0:\n                                interior_colors.add(grid[r][c])\n                    \n                    if len(interior_colors) == 1:\n                        k = list(interior_colors)[0]\n                        if k != border_color:\n                            area = (r2 - r1 + 1) * (c2 - c1 + 1)\n                            if area > best_area:\n                                best_area = area\n                                best_rect = (r1, c1, r2, c2)\n                                best_k = k\n\n    r1, c1, r2, c2 = best_rect\n    out = []\n    for r in range(r1, r2 + 1):\n        row = []\n        for c in range(c1, c2 + 1):\n            if r == r1 or r == r2 or c == c1 or c == c2:\n                row.append(best_k)\n            else:\n                row.append(grid[r][c])\n        out.append(row)\n    return out",
