  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    colors = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                colors[v] = colors.get(v, 0) + 1\n                \n    seed_color = None\n    for color, count in colors.items():\n        if count == 1:\n            seed_color = color\n            break\n            \n    if seed_color is None:\n        return [row[:] for row in grid]\n        \n    seed_r, seed_c = -1, -1\n    min_r, max_r = R, -1\n    min_c, max_c = C, -1\n    \n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                if v == seed_color:\n                    seed_r, seed_c = r, c\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    out_grid = [row[:] for row in grid]\n    \n    if seed_r == max_r and min_c < seed_c < max_c:\n        # Pointing UP\n        for r in range(min_r - 1, -1, -1):\n            out_grid[r][seed_c] = seed_color\n    elif seed_r == min_r and min_c < seed_c < max_c:\n        # Pointing DOWN\n        for r in range(max_r + 1, R):\n            out_grid[r][seed_c] = seed_color\n    elif seed_c == max_c and min_r < seed_r < max_r:\n        # Pointing LEFT\n        for c in range(min_c - 1, -1, -1):\n            out_grid[seed_r][c] = seed_color\n    elif seed_c == min_c and min_r < seed_r < max_r:\n        # Pointing RIGHT\n        for c in range(max_c + 1, C):\n            out_grid[seed_r][c] = seed_color\n            \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    colors = {}\n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                colors[v] = colors.get(v, 0) + 1\n                \n    seed_color = None\n    for color, count in colors.items():\n        if count == 1:\n            seed_color = color\n            break\n            \n    if seed_color is None:\n        return [row[:] for row in grid]\n        \n    seed_r, seed_c = -1, -1\n    min_r, max_r = R, -1\n    min_c, max_c = C, -1\n    \n    for r in range(R):\n        for c in range(C):\n            v = grid[r][c]\n            if v != 0:\n                if v == seed_color:\n                    seed_r, seed_c = r, c\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    out_grid = [row[:] for row in grid]\n    \n    if seed_r == max_r and min_c < seed_c < max_c:\n        # Pointing UP\n        for r in range(min_r - 1, -1, -1):\n            out_grid[r][seed_c] = seed_color\n    elif seed_r == min_r and min_c < seed_c < max_c:\n        # Pointing DOWN\n        for r in range(max_r + 1, R):\n            out_grid[r][seed_c] = seed_color\n    elif seed_c == max_c and min_r < seed_r < max_r:\n        # Pointing LEFT\n        for c in range(min_c - 1, -1, -1):\n            out_grid[seed_r][c] = seed_color\n    elif seed_c == min_c and min_r < seed_r < max_r:\n        # Pointing RIGHT\n        for c in range(max_c + 1, C):\n            out_grid[seed_r][c] = seed_color\n            \n    return out_grid",
