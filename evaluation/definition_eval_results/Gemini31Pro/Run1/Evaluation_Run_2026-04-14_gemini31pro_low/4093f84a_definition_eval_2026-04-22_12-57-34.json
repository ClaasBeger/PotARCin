  "raw_response": "```python\ndef solve(grid):\n    height = len(grid)\n    width = len(grid[0])\n    \n    min_r, max_r = height, -1\n    min_c, max_c = width, -1\n    \n    for r in range(height):\n        for c in range(width):\n            if grid[r][c] == 5:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    is_horizontal = (max_c - min_c == width - 1)\n    \n    out_grid = [[0]*width for _ in range(height)]\n    for r in range(height):\n        for c in range(width):\n            if grid[r][c] == 5:\n                out_grid[r][c] = 5\n                \n    if is_horizontal:\n        for c in range(width):\n            cnt_top = 0\n            for r in range(min_r):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_top += 1\n            for i in range(1, cnt_top + 1):\n                out_grid[min_r - i][c] = 5\n                \n            cnt_bottom = 0\n            for r in range(max_r + 1, height):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_bottom += 1\n            for i in range(1, cnt_bottom + 1):\n                out_grid[max_r + i][c] = 5\n    else:\n        for r in range(height):\n            cnt_left = 0\n            for c in range(min_c):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_left += 1\n            for i in range(1, cnt_left + 1):\n                out_grid[r][min_c - i] = 5\n                \n            cnt_right = 0\n            for c in range(max_c + 1, width):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_right += 1\n            for i in range(1, cnt_right + 1):\n                out_grid[r][max_c + i] = 5\n                \n    return out_grid\n```",
  "script": "def solve(grid):\n    height = len(grid)\n    width = len(grid[0])\n    \n    min_r, max_r = height, -1\n    min_c, max_c = width, -1\n    \n    for r in range(height):\n        for c in range(width):\n            if grid[r][c] == 5:\n                min_r = min(min_r, r)\n                max_r = max(max_r, r)\n                min_c = min(min_c, c)\n                max_c = max(max_c, c)\n                \n    is_horizontal = (max_c - min_c == width - 1)\n    \n    out_grid = [[0]*width for _ in range(height)]\n    for r in range(height):\n        for c in range(width):\n            if grid[r][c] == 5:\n                out_grid[r][c] = 5\n                \n    if is_horizontal:\n        for c in range(width):\n            cnt_top = 0\n            for r in range(min_r):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_top += 1\n            for i in range(1, cnt_top + 1):\n                out_grid[min_r - i][c] = 5\n                \n            cnt_bottom = 0\n            for r in range(max_r + 1, height):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_bottom += 1\n            for i in range(1, cnt_bottom + 1):\n                out_grid[max_r + i][c] = 5\n    else:\n        for r in range(height):\n            cnt_left = 0\n            for c in range(min_c):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_left += 1\n            for i in range(1, cnt_left + 1):\n                out_grid[r][min_c - i] = 5\n                \n            cnt_right = 0\n            for c in range(max_c + 1, width):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    cnt_right += 1\n            for i in range(1, cnt_right + 1):\n                out_grid[r][max_c + i] = 5\n                \n    return out_grid",
