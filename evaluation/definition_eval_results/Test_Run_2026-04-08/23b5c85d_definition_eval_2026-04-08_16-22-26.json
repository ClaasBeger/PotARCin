  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    rect_components = []\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            rows = [x for x, _ in cells]\n            cols = [y for _, y in cells]\n            min_r, max_r = min(rows), max(rows)\n            min_c, max_c = min(cols), max(cols)\n\n            bbox_h = max_r - min_r + 1\n            bbox_w = max_c - min_c + 1\n            area = bbox_h * bbox_w\n\n            if len(cells) == area:\n                rect_components.append((area, min_r, min_c, max_r, max_c, color))\n\n    rect_components.sort()\n    area, min_r, min_c, max_r, max_c, color = rect_components[0]\n\n    return [[color for _ in range(min_c, max_c + 1)] for _ in range(min_r, max_r + 1)]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    rect_components = []\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            rows = [x for x, _ in cells]\n            cols = [y for _, y in cells]\n            min_r, max_r = min(rows), max(rows)\n            min_c, max_c = min(cols), max(cols)\n\n            bbox_h = max_r - min_r + 1\n            bbox_w = max_c - min_c + 1\n            area = bbox_h * bbox_w\n\n            if len(cells) == area:\n                rect_components.append((area, min_r, min_c, max_r, max_c, color))\n\n    rect_components.sort()\n    area, min_r, min_c, max_r, max_c, color = rect_components[0]\n\n    return [[color for _ in range(min_c, max_c + 1)] for _ in range(min_r, max_r + 1)]",
