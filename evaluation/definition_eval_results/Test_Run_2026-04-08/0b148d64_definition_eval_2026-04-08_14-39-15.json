  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    zero_rows = [all(v == 0 for v in row) for row in grid]\n    zero_cols = [all(grid[r][c] == 0 for r in range(h)) for c in range(w)]\n\n    def segments(flags):\n        segs = []\n        i = 0\n        n = len(flags)\n        while i < n:\n            if flags[i]:\n                i += 1\n                continue\n            j = i\n            while j < n and not flags[j]:\n                j += 1\n            segs.append((i, j))\n            i = j\n        return segs\n\n    row_segs = segments(zero_rows)\n    col_segs = segments(zero_cols)\n\n    blocks = []\n    for r0, r1 in row_segs:\n        for c0, c1 in col_segs:\n            vals = []\n            nonzero = False\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    v = grid[r][c]\n                    if v != 0:\n                        vals.append(v)\n                        nonzero = True\n            if nonzero:\n                color = max(set(vals), key=vals.count)\n                blocks.append((color, r0, r1, c0, c1))\n\n    color_counts = {}\n    for color, *_ in blocks:\n        color_counts[color] = color_counts.get(color, 0) + 1\n\n    target = None\n    for block in blocks:\n        if color_counts[block[0]] == 1:\n            target = block\n            break\n\n    if target is None:\n        target = blocks[0]\n\n    _, r0, r1, c0, c1 = target\n    return [row[c0:c1] for row in grid[r0:r1]]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    zero_rows = [all(v == 0 for v in row) for row in grid]\n    zero_cols = [all(grid[r][c] == 0 for r in range(h)) for c in range(w)]\n\n    def segments(flags):\n        segs = []\n        i = 0\n        n = len(flags)\n        while i < n:\n            if flags[i]:\n                i += 1\n                continue\n            j = i\n            while j < n and not flags[j]:\n                j += 1\n            segs.append((i, j))\n            i = j\n        return segs\n\n    row_segs = segments(zero_rows)\n    col_segs = segments(zero_cols)\n\n    blocks = []\n    for r0, r1 in row_segs:\n        for c0, c1 in col_segs:\n            vals = []\n            nonzero = False\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    v = grid[r][c]\n                    if v != 0:\n                        vals.append(v)\n                        nonzero = True\n            if nonzero:\n                color = max(set(vals), key=vals.count)\n                blocks.append((color, r0, r1, c0, c1))\n\n    color_counts = {}\n    for color, *_ in blocks:\n        color_counts[color] = color_counts.get(color, 0) + 1\n\n    target = None\n    for block in blocks:\n        if color_counts[block[0]] == 1:\n            target = block\n            break\n\n    if target is None:\n        target = blocks[0]\n\n    _, r0, r1, c0, c1 = target\n    return [row[c0:c1] for row in grid[r0:r1]]",
