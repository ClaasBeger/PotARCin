  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    best_cells = []\n    best_color = 0\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                if len(cells) > len(best_cells):\n                    best_cells = cells\n                    best_color = color\n\n    if not best_cells:\n        return []\n\n    min_r = min(r for r, c in best_cells)\n    max_r = max(r for r, c in best_cells)\n    min_c = min(c for r, c in best_cells)\n    max_c = max(c for r, c in best_cells)\n\n    out_h = max_r - min_r + 1\n    out_w = max_c - min_c + 1\n    out = [[0] * out_w for _ in range(out_h)]\n\n    for r, c in best_cells:\n        out[r - min_r][c - min_c] = best_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    best_cells = []\n    best_color = 0\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                if len(cells) > len(best_cells):\n                    best_cells = cells\n                    best_color = color\n\n    if not best_cells:\n        return []\n\n    min_r = min(r for r, c in best_cells)\n    max_r = max(r for r, c in best_cells)\n    min_c = min(c for r, c in best_cells)\n    max_c = max(c for r, c in best_cells)\n\n    out_h = max_r - min_r + 1\n    out_w = max_c - min_c + 1\n    out = [[0] * out_w for _ in range(out_h)]\n\n    for r, c in best_cells:\n        out[r - min_r][c - min_c] = best_color\n\n    return out",
