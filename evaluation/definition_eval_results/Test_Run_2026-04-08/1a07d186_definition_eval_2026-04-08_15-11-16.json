  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find full monochrome rows/columns\n    lines = {}  # color -> (\"row\", index) or (\"col\", index)\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            lines[c] = (\"row\", r)\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            lines[v] = (\"col\", c)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Draw the full lines\n    for color, (kind, idx) in lines.items():\n        if kind == \"row\":\n            for c in range(w):\n                out[idx][c] = color\n        else:\n            for r in range(h):\n                out[r][idx] = color\n\n    # Project same-colored stray cells to the square adjacent to the line\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or color not in lines:\n                continue\n\n            kind, idx = lines[color]\n\n            # Skip cells already on the defining line\n            if kind == \"row\" and r == idx:\n                continue\n            if kind == \"col\" and c == idx:\n                continue\n\n            if kind == \"row\":\n                nr = idx - 1 if r < idx else idx + 1\n                if 0 <= nr < h:\n                    out[nr][c] = color\n            else:\n                nc = idx - 1 if c < idx else idx + 1\n                if 0 <= nc < w:\n                    out[r][nc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find full monochrome rows/columns\n    lines = {}  # color -> (\"row\", index) or (\"col\", index)\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            lines[c] = (\"row\", r)\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            lines[v] = (\"col\", c)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Draw the full lines\n    for color, (kind, idx) in lines.items():\n        if kind == \"row\":\n            for c in range(w):\n                out[idx][c] = color\n        else:\n            for r in range(h):\n                out[r][idx] = color\n\n    # Project same-colored stray cells to the square adjacent to the line\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or color not in lines:\n                continue\n\n            kind, idx = lines[color]\n\n            # Skip cells already on the defining line\n            if kind == \"row\" and r == idx:\n                continue\n            if kind == \"col\" and c == idx:\n                continue\n\n            if kind == \"row\":\n                nr = idx - 1 if r < idx else idx + 1\n                if 0 <= nr < h:\n                    out[nr][c] = color\n            else:\n                nc = idx - 1 if c < idx else idx + 1\n                if 0 <= nc < w:\n                    out[r][nc] = color\n\n    return out",
