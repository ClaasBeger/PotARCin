  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Identify the separator/background line color from any full uniform row.\n    border = None\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            border = grid[r][0]\n            break\n    if border is None:\n        return [row[:] for row in grid]\n\n    # Separator rows/cols are full border-color lines.\n    sep_rows = {r for r in range(h) if all(grid[r][c] == border for c in range(w))}\n    sep_cols = {c for c in range(w) if all(grid[r][c] == border for r in range(h))}\n\n    # Group non-separator rows/cols into 2-row / 2-col cell bands.\n    row_groups = []\n    cur = []\n    for r in range(h):\n        if r in sep_rows:\n            if cur:\n                row_groups.append(cur)\n                cur = []\n        else:\n            cur.append(r)\n    if cur:\n        row_groups.append(cur)\n\n    col_groups = []\n    cur = []\n    for c in range(w):\n        if c in sep_cols:\n            if cur:\n                col_groups.append(cur)\n                cur = []\n        else:\n            cur.append(c)\n    if cur:\n        col_groups.append(cur)\n\n    nr = len(row_groups)\n    nc = len(col_groups)\n\n    # Compress to cell grid using the top-left cell value of each 2x2 block.\n    cells = [[grid[row_groups[i][0]][col_groups[j][0]] for j in range(nc)] for i in range(nr)]\n\n    # Collect colors excluding 0 and border.\n    colors = set()\n    for i in range(nr):\n        for j in range(nc):\n            v = cells[i][j]\n            if v != 0 and v != border:\n                colors.add(v)\n\n    out_cells = [row[:] for row in cells]\n\n    # Fill horizontal/vertical spans between same-colored cells.\n    for color in colors:\n        # Horizontal spans\n        for i in range(nr):\n            js = [j for j in range(nc) if cells[i][j] == color]\n            if len(js) >= 2:\n                for j in range(min(js), max(js) + 1):\n                    out_cells[i][j] = color\n\n        # Vertical spans\n        for j in range(nc):\n            is_ = [i for i in range(nr) if cells[i][j] == color]\n            if len(is_) >= 2:\n                for i in range(min(is_), max(is_) + 1):\n                    out_cells[i][j] = color\n\n    # Expand back to full grid.\n    out = [row[:] for row in grid]\n    for i in range(nr):\n        for j in range(nc):\n            val = out_cells[i][j]\n            for r in row_groups[i]:\n                for c in col_groups[j]:\n                    out[r][c] = val\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Identify the separator/background line color from any full uniform row.\n    border = None\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            border = grid[r][0]\n            break\n    if border is None:\n        return [row[:] for row in grid]\n\n    # Separator rows/cols are full border-color lines.\n    sep_rows = {r for r in range(h) if all(grid[r][c] == border for c in range(w))}\n    sep_cols = {c for c in range(w) if all(grid[r][c] == border for r in range(h))}\n\n    # Group non-separator rows/cols into 2-row / 2-col cell bands.\n    row_groups = []\n    cur = []\n    for r in range(h):\n        if r in sep_rows:\n            if cur:\n                row_groups.append(cur)\n                cur = []\n        else:\n            cur.append(r)\n    if cur:\n        row_groups.append(cur)\n\n    col_groups = []\n    cur = []\n    for c in range(w):\n        if c in sep_cols:\n            if cur:\n                col_groups.append(cur)\n                cur = []\n        else:\n            cur.append(c)\n    if cur:\n        col_groups.append(cur)\n\n    nr = len(row_groups)\n    nc = len(col_groups)\n\n    # Compress to cell grid using the top-left cell value of each 2x2 block.\n    cells = [[grid[row_groups[i][0]][col_groups[j][0]] for j in range(nc)] for i in range(nr)]\n\n    # Collect colors excluding 0 and border.\n    colors = set()\n    for i in range(nr):\n        for j in range(nc):\n            v = cells[i][j]\n            if v != 0 and v != border:\n                colors.add(v)\n\n    out_cells = [row[:] for row in cells]\n\n    # Fill horizontal/vertical spans between same-colored cells.\n    for color in colors:\n        # Horizontal spans\n        for i in range(nr):\n            js = [j for j in range(nc) if cells[i][j] == color]\n            if len(js) >= 2:\n                for j in range(min(js), max(js) + 1):\n                    out_cells[i][j] = color\n\n        # Vertical spans\n        for j in range(nc):\n            is_ = [i for i in range(nr) if cells[i][j] == color]\n            if len(is_) >= 2:\n                for i in range(min(is_), max(is_) + 1):\n                    out_cells[i][j] = color\n\n    # Expand back to full grid.\n    out = [row[:] for row in grid]\n    for i in range(nr):\n        for j in range(nc):\n            val = out_cells[i][j]\n            for r in row_groups[i]:\n                for c in col_groups[j]:\n                    out[r][c] = val\n\n    return out",
