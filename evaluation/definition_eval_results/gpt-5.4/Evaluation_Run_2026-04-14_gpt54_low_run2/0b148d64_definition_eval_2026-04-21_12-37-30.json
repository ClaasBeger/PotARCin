  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def nonzero_row_segments():\n        segs = []\n        i = 0\n        while i < h:\n            while i < h and all(v == 0 for v in grid[i]):\n                i += 1\n            if i >= h:\n                break\n            j = i\n            while j < h and any(v != 0 for v in grid[j]):\n                j += 1\n            segs.append((i, j))\n            i = j\n        return segs\n\n    def nonzero_col_segments():\n        segs = []\n        j = 0\n        while j < w:\n            while j < w and all(grid[i][j] == 0 for i in range(h)):\n                j += 1\n            if j >= w:\n                break\n            k = j\n            while k < w and any(grid[i][k] != 0 for i in range(h)):\n                k += 1\n            segs.append((j, k))\n            j = k\n        return segs\n\n    row_segs = nonzero_row_segments()\n    col_segs = nonzero_col_segments()\n\n    blocks = []\n    for r0, r1 in row_segs:\n        for c0, c1 in col_segs:\n            sub = [row[c0:c1] for row in grid[r0:r1]]\n            colors = {v for row in sub for v in row if v != 0}\n            if colors:\n                blocks.append((r0, r1, c0, c1, sub, colors))\n\n    color_count = {}\n    for _, _, _, _, _, colors in blocks:\n        for color in colors:\n            color_count[color] = color_count.get(color, 0) + 1\n\n    for _, _, _, _, sub, colors in blocks:\n        if any(color_count[color] == 1 for color in colors):\n            return sub\n\n    return grid",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def nonzero_row_segments():\n        segs = []\n        i = 0\n        while i < h:\n            while i < h and all(v == 0 for v in grid[i]):\n                i += 1\n            if i >= h:\n                break\n            j = i\n            while j < h and any(v != 0 for v in grid[j]):\n                j += 1\n            segs.append((i, j))\n            i = j\n        return segs\n\n    def nonzero_col_segments():\n        segs = []\n        j = 0\n        while j < w:\n            while j < w and all(grid[i][j] == 0 for i in range(h)):\n                j += 1\n            if j >= w:\n                break\n            k = j\n            while k < w and any(grid[i][k] != 0 for i in range(h)):\n                k += 1\n            segs.append((j, k))\n            j = k\n        return segs\n\n    row_segs = nonzero_row_segments()\n    col_segs = nonzero_col_segments()\n\n    blocks = []\n    for r0, r1 in row_segs:\n        for c0, c1 in col_segs:\n            sub = [row[c0:c1] for row in grid[r0:r1]]\n            colors = {v for row in sub for v in row if v != 0}\n            if colors:\n                blocks.append((r0, r1, c0, c1, sub, colors))\n\n    color_count = {}\n    for _, _, _, _, _, colors in blocks:\n        for color in colors:\n            color_count[color] = color_count.get(color, 0) + 1\n\n    for _, _, _, _, sub, colors in blocks:\n        if any(color_count[color] == 1 for color in colors):\n            return sub\n\n    return grid",
