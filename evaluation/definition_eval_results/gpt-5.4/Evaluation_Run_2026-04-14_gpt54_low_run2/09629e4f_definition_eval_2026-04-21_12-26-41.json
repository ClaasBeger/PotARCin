  "raw_response": "def solve(grid):\n    h, w = len(grid), len(grid[0])\n\n    sep_rows = [r for r in range(h) if all(v == 5 for v in grid[r])]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == 5 for r in range(h))]\n\n    row_starts = [0] + [r + 1 for r in sep_rows]\n    col_starts = [0] + [c + 1 for c in sep_cols]\n\n    block_size = sep_rows[0] if sep_rows else h\n\n    template = None\n    for rs in row_starts:\n        if rs + block_size > h:\n            continue\n        for cs in col_starts:\n            if cs + block_size > w:\n                continue\n            block = [row[cs:cs + block_size] for row in grid[rs:rs + block_size]]\n            vals = [v for row in block for v in row]\n            nonzero = [v for v in vals if v != 0]\n            if len(nonzero) == 4 and sorted(nonzero) == [2, 3, 4, 6]:\n                template = block\n                break\n        if template is not None:\n            break\n\n    if template is None:\n        return [row[:] for row in grid]\n\n    out = [[0] * w for _ in range(h)]\n\n    for r in sep_rows:\n        for c in range(w):\n            out[r][c] = 5\n    for c in sep_cols:\n        for r in range(h):\n            out[r][c] = 5\n\n    for br, rs in enumerate(row_starts):\n        if rs + block_size > h:\n            continue\n        for bc, cs in enumerate(col_starts):\n            if cs + block_size > w:\n                continue\n            color = template[br][bc]\n            for r in range(rs, rs + block_size):\n                for c in range(cs, cs + block_size):\n                    out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h, w = len(grid), len(grid[0])\n\n    sep_rows = [r for r in range(h) if all(v == 5 for v in grid[r])]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == 5 for r in range(h))]\n\n    row_starts = [0] + [r + 1 for r in sep_rows]\n    col_starts = [0] + [c + 1 for c in sep_cols]\n\n    block_size = sep_rows[0] if sep_rows else h\n\n    template = None\n    for rs in row_starts:\n        if rs + block_size > h:\n            continue\n        for cs in col_starts:\n            if cs + block_size > w:\n                continue\n            block = [row[cs:cs + block_size] for row in grid[rs:rs + block_size]]\n            vals = [v for row in block for v in row]\n            nonzero = [v for v in vals if v != 0]\n            if len(nonzero) == 4 and sorted(nonzero) == [2, 3, 4, 6]:\n                template = block\n                break\n        if template is not None:\n            break\n\n    if template is None:\n        return [row[:] for row in grid]\n\n    out = [[0] * w for _ in range(h)]\n\n    for r in sep_rows:\n        for c in range(w):\n            out[r][c] = 5\n    for c in sep_cols:\n        for r in range(h):\n            out[r][c] = 5\n\n    for br, rs in enumerate(row_starts):\n        if rs + block_size > h:\n            continue\n        for bc, cs in enumerate(col_starts):\n            if cs + block_size > w:\n                continue\n            color = template[br][bc]\n            for r in range(rs, rs + block_size):\n                for c in range(cs, cs + block_size):\n                    out[r][c] = color\n\n    return out",
