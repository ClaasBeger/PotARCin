  "raw_response": "def solve(grid):\n    if not grid:\n        return grid\n    H = len(grid)\n    W = len(grid[0])\n    # Locate the column containing the vertical line of 5s\n    C = None\n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == 5:\n                C = j\n                break\n        if C is not None:\n            break\n    # Locate the unique non\u2011zero, non\u20115 cell\n    r = c = val = None\n    for i in range(H):\n        for j in range(W):\n            v = grid[i][j]\n            if v != 0 and v != 5:\n                r, c, val = i, j, v\n                break\n        if val is not None:\n            break\n    # Copy grid for output\n    out = [row[:] for row in grid]\n    if val is None:\n        return out\n    # Clear original position\n    out[r][c] = 0\n    # Place the value at the far right of its original row\n    out[r][W-1] = val\n    # Compute ghost position\n    d = C - c                     # horizontal distance to the line of 5s\n    r_ghost = r - d\n    if r_ghost < 0:\n        r_ghost = 0\n    c_ghost = 2 * C - c\n    if d % 2 == 0:\n        c_ghost -= 1\n    if c_ghost >= W:\n        c_ghost = W - 1\n    if c_ghost < 0:\n        c_ghost = 0\n    out[r_ghost][c_ghost] = val\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return grid\n    H = len(grid)\n    W = len(grid[0])\n    # Locate the column containing the vertical line of 5s\n    C = None\n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == 5:\n                C = j\n                break\n        if C is not None:\n            break\n    # Locate the unique non\u2011zero, non\u20115 cell\n    r = c = val = None\n    for i in range(H):\n        for j in range(W):\n            v = grid[i][j]\n            if v != 0 and v != 5:\n                r, c, val = i, j, v\n                break\n        if val is not None:\n            break\n    # Copy grid for output\n    out = [row[:] for row in grid]\n    if val is None:\n        return out\n    # Clear original position\n    out[r][c] = 0\n    # Place the value at the far right of its original row\n    out[r][W-1] = val\n    # Compute ghost position\n    d = C - c                     # horizontal distance to the line of 5s\n    r_ghost = r - d\n    if r_ghost < 0:\n        r_ghost = 0\n    c_ghost = 2 * C - c\n    if d % 2 == 0:\n        c_ghost -= 1\n    if c_ghost >= W:\n        c_ghost = W - 1\n    if c_ghost < 0:\n        c_ghost = 0\n    out[r_ghost][c_ghost] = val\n    return out",
