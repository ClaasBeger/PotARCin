  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find all non-zero cells\n    fives = []\n    payload_pos = None\n    payload_val = None\n    main_objects = []  # positions of other non-zero values\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0:\n                if val == 5:\n                    fives.append((r, c))\n                else:\n                    main_objects.append((r, c, val))\n    \n    # Find payload: the value that appears least frequently (excluding 5)\n    # or the one that is isolated\n    from collections import Counter\n    non_five_vals = [val for r, c, val in main_objects]\n    if not non_five_vals:\n        return grid\n    \n    val_counts = Counter(non_five_vals)\n    # Payload is typically the one with count 1\n    payload_val = min(val_counts.keys(), key=lambda x: val_counts[x])\n    \n    payload_pos = None\n    new_main_objects = []\n    for r, c, val in main_objects:\n        if val == payload_val:\n            payload_pos = (r, c)\n        else:\n            new_main_objects.append((r, c, val))\n    \n    if payload_pos is None or len(fives) < 1:\n        return grid\n    \n    # Determine direction from payload through fives\n    # Sort fives by distance to payload\n    fives_sorted = sorted(fives, key=lambda p: abs(p[0]-payload_pos[0]) + abs(p[1]-payload_pos[1]))\n    \n    # Calculate step direction\n    # The line goes from payload through fives\n    r0, c0 = payload_pos\n    r1, c1 = fives_sorted[0]\n    \n    dr = r1 - r0\n    dc = c1 - c0\n    \n    # Normalize to step size 1 in the dominant direction or gcd\n    import math\n    g = math.gcd(abs(dr), abs(dc))\n    if g > 0:\n        dr //= g\n        dc //= g\n    \n    # Create output grid\n    result = [row[:] for row in grid]\n    \n    # Clear payload and fives\n    pr, pc = payload_pos\n    result[pr][pc] = 0\n    for fr, fc in fives:\n        result[fr][fc] = 0\n    \n    # Extend line from the far end of fives\n    # Find the furthest five in the direction of (dr, dc)\n    far_r, far_c = fives_sorted[-1]\n    \n    # Current position to check (start from far five + step)\n    curr_r, curr_c = far_r + dr, far_c + dc\n    \n    # Keep moving until out of bounds or hit main object\n    last_valid = None\n    while 0 <= curr_r < rows and 0 <= curr_c < cols:\n        # Check if current cell has main object (in original grid)\n        if grid[curr_r][curr_c] != 0 and grid[curr_r][curr_c] != 5 and (curr_r, curr_c) != payload_pos:\n            # Hit a main object, stop before it\n            break\n        \n        last_valid = (curr_r, curr_c)\n        \n        # Check if adjacent to any main object (excluding payload and fives)\n        is_adjacent = False\n        for mr, mc, mval in new_main_objects:\n            if abs(curr_r - mr) <= 1 and abs(curr_c - mc) <= 1:\n                is_adjacent = True\n                break\n        \n        if is_adjacent:\n            # Place here\n            result[curr_r][curr_c] = payload_val\n            return result\n        \n        curr_r += dr\n        curr_c += dc\n    \n    # If we exited loop without placing, place at last valid position\n    if last_valid:\n        result[last_valid[0]][last_valid[1]] = payload_val\n    else:\n        # No valid position found, maybe place at far five position?\n        # Or check if we should go the other way?\n        # Try opposite direction\n        dr, dc = -dr, -dc\n        curr_r, curr_c = far_r + dr, far_c + dc\n        last_valid = None\n        while 0 <= curr_r < rows and 0 <= curr_c < cols:\n            if grid[curr_r][curr_c] != 0 and grid[curr_r][curr_c] != 5 and (curr_r, curr_c) != payload_pos:\n                break\n            last_valid = (curr_r, curr_c)\n            is_adjacent = False\n            for mr, mc, mval in new_main_objects:\n    