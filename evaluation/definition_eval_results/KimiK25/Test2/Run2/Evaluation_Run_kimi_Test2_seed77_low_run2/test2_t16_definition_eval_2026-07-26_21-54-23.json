  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return [row[:] for row in grid]\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find the special color (not 0, not 5)\n    special_color = None\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0 and val != 5:\n                special_color = val\n                break\n        if special_color is not None:\n            break\n    \n    # If no special color, just return grid (or handle as needed)\n    if special_color is None:\n        return [row[:] for row in grid]\n    \n    # Find connected components of 5s\n    visited = [[False] * cols for _ in range(rows)]\n    components = []\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5 and not visited[r][c]:\n                # BFS to find component\n                stack = [(r, c)]\n                visited[r][c] = True\n                component_cells = []\n                \n                while stack:\n                    cr, cc = stack.pop()\n                    component_cells.append((cr, cc))\n                    \n                    for dr, dc in directions:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if not visited[nr][nc] and grid[nr][nc] == 5:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n                \n                components.append({\n                    'size': len(component_cells),\n                    'cells': component_cells\n                })\n    \n    if not components:\n        # No 5s to recolor, just remove special color markers\n        result = [row[:] for row in grid]\n        for r in range(rows):\n            for c in range(cols):\n                if result[r][c] == special_color:\n                    result[r][c] = 0\n        return result\n    \n    # Determine target size\n    size_counts = {}\n    for comp in components:\n        s = comp['size']\n        size_counts[s] = size_counts.get(s, 0) + 1\n    \n    sorted_sizes = sorted(size_counts.keys(), reverse=True)\n    max_size = sorted_sizes[0]\n    \n    if size_counts[max_size] > 1:\n        target_size = max_size\n    else:\n        # Unique largest, take second largest\n        if len(sorted_sizes) > 1:\n            target_size = sorted_sizes[1]\n        else:\n            target_size = max_size  # fallback\n    \n    # Create result grid\n    result = [row[:] for row in grid]\n    \n    # Clear special color markers (set to 0)\n    for r in range(rows):\n        for c in range(cols):\n            if result[r][c] == special_color:\n                result[r][c] = 0\n    \n    # Recolor target components\n    for comp in components:\n        if comp['size'] == target_size:\n            for (r, c) in comp['cells']:\n                result[r][c] = special_color\n    \n    return result\n```",
