  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    \n    # Cells for each quadrant: TL, TR, BL, BR\n    cells = [[] for _ in range(4)]\n    # Bounding boxes: [min_r, max_r, min_c, max_c] for each quadrant\n    bbox = [[float('inf'), -float('inf'), float('inf'), -float('inf')] for _ in range(4)]\n    \n    mid_r = H // 2\n    mid_c = W // 2\n    \n    for r in range(H):\n        for c in range(W):\n            v = grid[r][c]\n            if v != 0:\n                if r < mid_r and c < mid_c:\n                    idx = 0  # TL\n                elif r < mid_r and c >= mid_c:\n                    idx = 1  # TR\n                elif r >= mid_r and c < mid_c:\n                    idx = 2  # BL\n                else:\n                    idx = 3  # BR\n                \n                cells[idx].append((r, c, v))\n                b = bbox[idx]\n                if r < b[0]: b[0] = r\n                if r > b[1]: b[1] = r\n                if c < b[2]: b[2] = c\n                if c > b[3]: b[3] = c\n    \n    # Target center lines\n    target_max_r = mid_r - 1\n    target_min_r = mid_r\n    target_max_c = mid_c - 1\n    target_min_c = mid_c\n    \n    # Calculate shifts based on anchor patterns\n    # Vertical shifts: top uses TL's max_r, bottom uses BL's min_r\n    # Horizontal shifts: left uses TL's max_c, right uses TR's min_c\n    dr_top = 0\n    dr_bottom = 0\n    dc_left = 0\n    dc_right = 0\n    \n    if cells[0]:  # TL\n        dr_top = target_max_r - bbox[0][1]\n        dc_left = target_max_c - bbox[0][3]\n    if cells[2]:  # BL\n        dr_bottom = target_min_r - bbox[2][0]\n    if cells[1]:  # TR\n        dc_right = target_min_c - bbox[1][2]\n    \n    shifts = [\n        (dr_top, dc_left),      # TL\n        (dr_top, dc_right),     # TR\n        (dr_bottom, dc_left),   # BL\n        (dr_bottom, dc_right)   # BR\n    ]\n    \n    out = [[0 for _ in range(W)] for _ in range(H)]\n    \n    for i in range(4):\n        dr, dc = shifts[i]\n        for r, c, v in cells[i]:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W:\n                out[nr][nc] = v\n    \n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    \n    # Cells for each quadrant: TL, TR, BL, BR\n    cells = [[] for _ in range(4)]\n    # Bounding boxes: [min_r, max_r, min_c, max_c] for each quadrant\n    bbox = [[float('inf'), -float('inf'), float('inf'), -float('inf')] for _ in range(4)]\n    \n    mid_r = H // 2\n    mid_c = W // 2\n    \n    for r in range(H):\n        for c in range(W):\n            v = grid[r][c]\n            if v != 0:\n                if r < mid_r and c < mid_c:\n                    idx = 0  # TL\n                elif r < mid_r and c >= mid_c:\n                    idx = 1  # TR\n                elif r >= mid_r and c < mid_c:\n                    idx = 2  # BL\n                else:\n                    idx = 3  # BR\n                \n                cells[idx].append((r, c, v))\n                b = bbox[idx]\n                if r < b[0]: b[0] = r\n                if r > b[1]: b[1] = r\n                if c < b[2]: b[2] = c\n                if c > b[3]: b[3] = c\n    \n    # Target center lines\n    target_max_r = mid_r - 1\n    target_min_r = mid_r\n    target_max_c = mid_c - 1\n    target_min_c = mid_c\n    \n    # Calculate shifts based on anchor patterns\n    # Vertical shifts: top uses TL's max_r, bottom uses BL's min_r\n    # Horizontal shifts: left uses TL's max_c, right uses TR's min_c\n    dr_top = 0\n    dr_bottom = 0\n    dc_left = 0\n    dc_right = 0\n    \n    if cells[0]:  # TL\n        dr_top = target_max_r - bbox[0][1]\n        dc_left = target_max_c - bbox[0][3]\n    if cells[2]:  # BL\n        dr_bottom = target_min_r - bbox[2][0]\n    if cells[1]:  # TR\n        dc_right = target_min_c - bbox[1][2]\n    \n    shifts = [\n        (dr_top, dc_left),      # TL\n        (dr_top, dc_right),     # TR\n        (dr_bottom, dc_left),   # BL\n        (dr_bottom, dc_right)   # BR\n    ]\n    \n    out = [[0 for _ in range(W)] for _ in range(H)]\n    \n    for i in range(4):\n        dr, dc = shifts[i]\n        for r, c, v in cells[i]:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W:\n                out[nr][nc] = v\n    \n    return out",
