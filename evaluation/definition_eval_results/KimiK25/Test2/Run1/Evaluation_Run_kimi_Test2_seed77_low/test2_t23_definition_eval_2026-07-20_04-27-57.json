ls - 1, c1))\n        r2 = max(0, min(rows - 1, r2))\n        c2 = max(0, min(cols - 1, c2))\n        \n        # Draw horizontal line from c1 to c2 at row r1\n        step = 1 if c2 >= c1 else -1\n        for c in range(c1, c2 + step, step):\n            out[r1][c] = 5\n        \n        # Draw vertical line from r1 to r2 at column c2\n        step = 1 if r2 >= r1 else -1\n        for r in range(r1, r2 + step, step):\n            out[r][c2] = 5\n    \n    # Also connect in column order to ensure connectivity for spread out components\n    order_c = sorted(range(len(centroids)), key=lambda i: centroids[i][1])\n    for i in range(len(order_c) - 1):\n        idx1 = order_c[i]\n        idx2 = order_c[i + 1]\n        r1, c1 = int(round(centroids[idx1][0])), int(round(centroids[idx1][1]))\n        r2, c2 = int(round(centroids[idx2][0])), int(round(centroids[idx2][1]))\n        \n        r1 = max(0, min(rows - 1, r1))\n        c1 = max(0, min(cols - 1, c1))\n        r2 = max(0, min(rows - 1, r2))\n        c2 = max(0, min(cols - 1, c2))\n        \n        # Draw vertical then horizontal\n        step = 1 if r2 >= r1 else -1\n        for r in range(r1, r2 + step, step):\n            out[r][c1] = 5\n        \n        step = 1 if c2 >= c1 else -1\n        for c in range(c1, c2 + step, step):\n            out[r2][c] = 5\n    \n    return out",
