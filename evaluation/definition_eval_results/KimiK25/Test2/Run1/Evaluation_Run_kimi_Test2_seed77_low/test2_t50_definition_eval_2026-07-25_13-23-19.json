  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return grid\n    n = len(grid)\n    m = len(grid[0])\n    \n    # Find all 5s and the marker\n    fives = []\n    marker = None\n    for i in range(n):\n        for j in range(m):\n            val = grid[i][j]\n            if val == 5:\n                fives.append((i, j))\n            elif val not in (0, 7):\n                marker = (i, j, val)\n    \n    if not fives or marker is None:\n        return grid\n    \n    # Determine lattice structure\n    rows = sorted({r for r, c in fives})\n    cols = sorted({c for r, c in fives})\n    R = len(rows)\n    C = len(cols)\n    step_r = rows[1] - rows[0] if R > 1 else 1\n    step_c = cols[1] - cols[0] if C > 1 else 1\n    # Assume square step\n    step = step_r\n    r0 = rows[0]\n    c0 = cols[0]\n    \n    mr, mc, mval = marker\n    # Replace marker with 5\n    grid[mr][mc] = 5\n    \n    # Lattice coordinates of marker\n    i_m = (mr - r0) // step\n    j_m = (mc - c0) // step\n    \n    # Determine target rows\n    if i_m == 0 or i_m == R - 1:\n        rows_target = list(range(R))\n    else:\n        if i_m < R / 2:\n            # bottom half\n            rows_target = list(range((R + 1) // 2, R))\n        else:\n            # top half\n            rows_target = list(range(0, R // 2))\n    \n    # Determine target columns\n    if j_m == 0:\n        cols_target = list(range(1, C))\n    elif j_m == C - 1:\n        cols_target = list(range(0, C - 1))\n    else:\n        if j_m < C / 2:\n            # right half\n            cols_target = list(range((C + 1) // 2, C))\n        else:\n            # left half\n            cols_target = list(range(0, C // 2))\n    \n    if not rows_target or not cols_target:\n        return grid\n    \n    r_min = r0 + min(rows_target) * step\n    r_max = r0 + max(rows_target) * step\n    c_min = c0 + min(cols_target) * step\n    c_max = c0 + max(cols_target) * step\n    \n    # Clamp to grid bounds\n    r_min = max(0, 