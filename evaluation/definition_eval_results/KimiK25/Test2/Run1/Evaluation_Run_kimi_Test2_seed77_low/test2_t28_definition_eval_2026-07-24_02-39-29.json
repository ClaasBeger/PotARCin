  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find all 5s and the special number (non-zero, non-5)\n    fives = []\n    special_pos = None\n    special_val = None\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val == 5:\n                fives.append((r, c))\n            elif val != 0:\n                special_pos = (r, c)\n                special_val = val\n    \n    if not fives or special_pos is None:\n        return grid\n    \n    # Determine the direction of the line formed by 5s and special\n    # Sort by row to find the direction from first to last\n    all_points = fives + [special_pos]\n    all_points.sort()  # Sort by row, then col\n    \n    # Calculate direction vector\n    start = all_points[0]\n    end = all_points[-1]\n    dr = end[0] - start[0]\n    dc = end[1] - start[1]\n    \n    # Normalize to step size (-1, 0, or 1)\n    if dr != 0:\n        dr = dr // abs(dr)\n    if dc != 0:\n        dc = dc // abs(dc)\n    \n    # Ray trace in opposite direction from special position\n    opp_dr = -dr\n    opp_dc = -dc\n    \n    # Start from special position and move in opposite direction\n    curr_r, curr_c = special_pos\n    last_valid = special_pos\n    \n    while True:\n        next_r = curr_r + opp_dr\n        next_c = curr_c + opp_dc\n        \n        # Check bounds\n        if next_r < 0 or next_r >= rows or next_c < 0 or next_c >= cols:\n            break\n        \n        # Check if next cell is occupied (non-zero in original grid, excluding 5s and special)\n        next_val = grid[next_r][next_c]\n        if next_val != 0 and (next_r, next_c) not in fives and (next_r, next_c) != special_pos:\n            break\n        \n        # Move to next cell\n        curr_r, curr_c = next_r, next_c\n        last_valid = (curr_r, curr_c)\n    \n    # Create output grid\n    output = [row[:] for row in grid]\n    \n    # Remove all 5s and special\n    for r, c in fives:\n        output[r][c] = 0\n    output[special_pos[0]][special_pos[1]] = 0\n    \n    # Place special at new position\n    output[last_valid[0]][last_valid[1]] = special_val\n    \n    return output\n```",
  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find all 5s and the special number (non-zero, non-5)\n    fives = []\n    special_pos = None\n    special_val = None\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val == 5:\n                fives.append((r, c))\n            elif val != 0:\n                special_pos = (r, c)\n                special_val = val\n    \n    if not fives or special_pos is None:\n        return grid\n    \n    # Determine the direction of the line formed by 5s and special\n    # Sort by row to find the direction from first to last\n    all_points = fives + [special_pos]\n    all_points.sort()  # Sort by row, then col\n    \n    # Calculate direction vector\n    start = all_points[0]\n    end = all_points[-1]\n    dr = end[0] - start[0]\n    dc = end[1] - start[1]\n    \n    # Normalize to step size (-1, 0, or 1)\n    if dr != 0:\n        dr = dr // abs(dr)\n    if dc != 0:\n        dc = dc // abs(dc)\n    \n    # Ray trace in opposite direction from special position\n    opp_dr = -dr\n    opp_dc = -dc\n    \n    # Start from special position and move in opposite direction\n    curr_r, curr_c = special_pos\n    last_valid = special_pos\n    \n    while True:\n        next_r = curr_r + opp_dr\n        next_c = curr_c + opp_dc\n        \n        # Check bounds\n        if next_r < 0 or next_r >= rows or next_c < 0 or next_c >= cols:\n            break\n        \n        # Check if next cell is occupied (non-zero in original grid, excluding 5s and special)\n        next_val = grid[next_r][next_c]\n        if next_val != 0 and (next_r, next_c) not in fives and (next_r, next_c) != special_pos:\n            break\n        \n        # Move to next cell\n        curr_r, curr_c = next_r, next_c\n        last_valid = (curr_r, curr_c)\n    \n    # Create output grid\n    output = [row[:] for row in grid]\n    \n    # Remove all 5s and special\n    for r, c in fives:\n        output[r][c] = 0\n    output[special_pos[0]][special_pos[1]] = 0\n    \n    # Place special at new position\n    output[last_valid[0]][last_valid[1]] = special_val\n    \n    return output",
