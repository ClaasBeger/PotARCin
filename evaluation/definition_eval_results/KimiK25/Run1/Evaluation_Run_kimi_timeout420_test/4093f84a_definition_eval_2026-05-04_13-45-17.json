k in range(1, count + 1):\n            col = max_col + k\n            if col < width:\n                output[i][col] = 5\n    \n    # Apply vertical extensions (top and bottom)\n    for j, count in col_top.items():\n        for k in range(1, count + 1):\n            row = min_row - k\n            if row >= 0:\n                output[row][j] = 5\n    \n    for j, count in col_bottom.items():\n        for k in range(1, count + 1):\n            row = max_row + k\n            if row < height:\n                output[row][j] = 5\n    \n    return output",
