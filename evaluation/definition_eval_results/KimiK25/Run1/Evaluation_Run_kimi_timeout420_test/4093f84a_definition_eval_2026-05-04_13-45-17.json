  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    height = len(grid)\n    width = len(grid[0])\n    \n    # Find bounds of the 5-block\n    min_row, max_row = height, -1\n    min_col, max_col = width, -1\n    \n    markers = []  # list of (row, col, value) - value not needed just position\n    \n    for i in range(height):\n        for j in range(width):\n            val = grid[i][j]\n            if val == 5:\n                min_row = min(min_row, i)\n                max_row = max(max_row, i)\n                min_col = min(min_col, j)\n                max_col = max(max_col, j)\n            elif val != 0:\n                markers.append((i, j))\n    \n    # Create output grid as copy\n    output = [row[:] for row in grid]\n    \n    # Clear all markers (set to 0)\n    for i, j in markers:\n        output[i][j] = 0\n    \n    # If no 5s found, return cleared grid\n    if max_row == -1:\n        return output\n    \n    # Count extensions needed per row and per column\n    row_left = {}   # row index -> count of markers to the left\n    row_right = {}  # row index -> count of markers to the right\n    col_top = {}    # col index -> count of markers above\n    col_bottom = {} # col index -> count of markers below\n    \n    for i, j in markers:\n        # Row-wise horizontal positioning\n        if j < min_col:\n            row_left[i] = row_left.get(i, 0) + 1\n        elif j > max_col:\n            row_right[i] = row_right.get(i, 0) + 1\n        \n        # Column-wise vertical positioning\n        if i < min_row:\n            col_top[j] = col_top.get(j, 0) + 1\n        elif i > max_row:\n            col_bottom[j] = col_bottom.get(j, 0) + 1\n    \n    # Apply horizontal extensions (left and right)\n    for i, count in row_left.items():\n        for k in range(1, count + 1):\n            col = min_col - k\n            if col >= 0:\n                output[i][col] = 5\n    \n    for i, count in row_right.items():\n        for k in range(1, count + 1):\n            col = max_col + k\n            if col < width:\n                output[i][col] = 5\n    \n    # Apply vertical extensions (top and bottom)\n    for j, count in col_top.items():\n        for k in range(1, count + 1):\n            row = min_row - k\n            if row >= 0:\n                output[row][j] = 5\n    \n    for j, count in col_bottom.items():\n        for k in range(1, count + 1):\n            row = max_row + k\n            if row < height:\n                output[row][j] = 5\n    \n    return output\n```",
