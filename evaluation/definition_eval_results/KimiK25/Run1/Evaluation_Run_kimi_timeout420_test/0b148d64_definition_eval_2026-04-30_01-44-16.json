  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find horizontal separator (consecutive all-zero rows)\n    h_start = None\n    h_end = None\n    for i in range(rows):\n        if all(x == 0 for x in grid[i]):\n            if h_start is None:\n                h_start = i\n            h_end = i\n        else:\n            if h_start is not None:\n                break\n    \n    # Find vertical separator (consecutive all-zero columns)\n    v_start = None\n    v_end = None\n    for j in range(cols):\n        if all(grid[i][j] == 0 for i in range(rows)):\n            if v_start is None:\n                v_start = j\n            v_end = j\n        else:\n            if v_start is not None:\n                break\n    \n    # If no separators found, return original grid\n    if h_start is None or v_start is None:\n        return grid\n    \n    # Extract the four quadrants\n    tl = [row[:v_start] for row in grid[:h_start]]  # Top-left\n    tr = [row[v_end+1:] for row in grid[:h_start]]  # Top-right\n    bl = [row[:v_start] for row in grid[h_end+1:]]  # Bottom-left\n    br = [row[v_end+1:] for row in grid[h_end+1:]]  # Bottom-right\n    \n    def get_signature(quadrant):\n        \"\"\"Get set of non-zero values in quadrant\"\"\"\n        sig = set()\n        for row in quadrant:\n            for val in row:\n                if val != 0:\n                    sig.add(val)\n        return frozenset(sig)\n    \n    signatures = {\n        'tl': get_signature(tl),\n        'tr': get_signature(tr),\n        'bl': get_signature(bl),\n        'br': get_signature(br)\n    }\n    \n    # Find the quadrant with unique signature\n    from collections import Counter\n    sig_counts = Counter(signatures.values())\n    \n    for name, sig in signatures.items():\n        if sig_counts[sig] == 1:\n            if name == 'tl':\n                return tl\n            elif name == 'tr':\n  