  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return []\n    \n    from collections import defaultdict\n    \n    # Map each non-zero value to its coordinates\n    value_coords = defaultdict(list)\n    for i, row in enumerate(grid):\n        for j, val in enumerate(row):\n            if val != 0:\n                value_coords[val].append((i, j))\n    \n    # Identify the target value by highest density (count / bounding_box_area)\n    target_bounds = None\n    max_density = -1\n    \n    for val, coords in value_coords.items():\n        rows = [c[0] for c in coords]\n        cols = [c[1] for c in coords]\n        \n        min_r, max_r = min(rows), max(rows)\n        min_c, max_c = min(cols), max(cols)\n        \n        area = (max_r - min_r + 1) * (max_c - min_c + 1)\n        count = len(coords)\n        density = count / area\n        \n        if density > max_density:\n            max_density = density\n            target_bounds = (min_r, max_r, min_c, max_c)\n    \n    if target_bounds is None:\n        return [[]]\n    \n    min_r, max_r, min_c, max_c = target_bounds\n    \n    # Extract subgrid\n    result = []\n    for i in range(min_r, max_r + 1):\n        result.append(grid[i][min_c:max_c+1])\n    \n    return result\n```",
  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return []\n    \n    from collections import defaultdict\n    \n    # Map each non-zero value to its coordinates\n    value_coords = defaultdict(list)\n    for i, row in enumerate(grid):\n        for j, val in enumerate(row):\n            if val != 0:\n                value_coords[val].append((i, j))\n    \n    # Identify the target value by highest density (count / bounding_box_area)\n    target_bounds = None\n    max_density = -1\n    \n    for val, coords in value_coords.items():\n        rows = [c[0] for c in coords]\n        cols = [c[1] for c in coords]\n        \n        min_r, max_r = min(rows), max(rows)\n        min_c, max_c = min(cols), max(cols)\n        \n        area = (max_r - min_r + 1) * (max_c - min_c + 1)\n        count = len(coords)\n        density = count / area\n        \n        if density > max_density:\n            max_density = density\n            target_bounds = (min_r, max_r, min_c, max_c)\n    \n    if target_bounds is None:\n        return [[]]\n    \n    min_r, max_r, min_c, max_c = target_bounds\n    \n    # Extract subgrid\n    result = []\n    for i in range(min_r, max_r + 1):\n        result.append(grid[i][min_c:max_c+1])\n    \n    return result",
