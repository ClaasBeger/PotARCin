  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    visited = [[False] * W for _ in range(H)]\n    res = [row[:] for row in grid]\n    stack = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 1 and not visited[r][c]:\n                stack.append((r, c))\n                visited[r][c] = True\n                cells = []\n                deg = 0\n                while stack:\n                    cr, cc = stack.pop()\n                    cells.append((cr, cc))\n                    nr = cr - 1\n                    if nr >= 0 and grid[nr][cc] == 1:\n                        deg += 1\n                        if not visited[nr][cc]:\n                            visited[nr][cc] = True\n                            stack.append((nr, cc))\n                    nr = cr + 1\n                    if nr < H and grid[nr][cc] == 1:\n                        deg += 1\n                        if not visited[nr][cc]:\n                            visited[nr][cc] = True\n                            stack.append((nr, cc))\n                    nc = cc - 1\n                    if nc >= 0 and grid[cr][nc] == 1:\n                        deg += 1\n                        if not visited[cr][nc]:\n                            visited[cr][nc] = True\n                            stack.append((cr, nc))\n                    nc = cc + 1\n                    if nc < W and grid[cr][nc] == 1:\n                        deg += 1\n                        if not visited[cr][nc]:\n                            visited[cr][nc] = True\n                            stack.append((cr, nc))\n                nodes = len(cells)\n                edges = deg // 2\n                if edges >= nodes:\n                    for cr, cc in cells:\n                        res[cr][cc] = 8\n    return res",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    visited = [[False] * W for _ in range(H)]\n    res = [row[:] for row in grid]\n    stack = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 1 and not visited[r][c]:\n                stack.append((r, c))\n                visited[r][c] = True\n                cells = []\n                deg = 0\n                while stack:\n                    cr, cc = stack.pop()\n                    cells.append((cr, cc))\n                    nr = cr - 1\n                    if nr >= 0 and grid[nr][cc] == 1:\n                        deg += 1\n                        if not visited[nr][cc]:\n                            visited[nr][cc] = True\n                            stack.append((nr, cc))\n                    nr = cr + 1\n                    if nr < H and grid[nr][cc] == 1:\n                        deg += 1\n                        if not visited[nr][cc]:\n                            visited[nr][cc] = True\n                            stack.append((nr, cc))\n                    nc = cc - 1\n                    if nc >= 0 and grid[cr][nc] == 1:\n                        deg += 1\n                        if not visited[cr][nc]:\n                            visited[cr][nc] = True\n                            stack.append((cr, nc))\n                    nc = cc + 1\n                    if nc < W and grid[cr][nc] == 1:\n                        deg += 1\n                        if not visited[cr][nc]:\n                            visited[cr][nc] = True\n                            stack.append((cr, nc))\n                nodes = len(cells)\n                edges = deg // 2\n                if edges >= nodes:\n                    for cr, cc in cells:\n                        res[cr][cc] = 8\n    return res",
