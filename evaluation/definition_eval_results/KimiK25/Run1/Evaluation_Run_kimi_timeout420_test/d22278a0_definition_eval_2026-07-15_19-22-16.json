  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    h = len(grid)\n    w = len(grid[0])\n    \n    # Find all non-zero sources (position and value)\n    sources = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                sources.append((r, c, grid[r][c]))\n    \n    # Initialize output grid with zeros\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    \n    # For each cell, determine which source \"owns\" it (closest by Manhattan distance)\n    for r in range(h):\n        for c in range(w):\n            min_dist = float('inf')\n            closest = None\n            is_tie = False\n            \n            for sr, sc, val in sources:\n                dist = abs(r - sr) + abs(c - sc)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest = (sr, sc, val)\n                    is_tie = False\n                elif dist == min_dist:\n                    is_tie = True\n            \n            # If tie or no source, leave as 0\n            if is_tie or closest is None:\n                continue\n            \n            sr, sc, val = closest\n            \n            # Transform coordinates to top-left reference frame\n            if sr == 0 and sc == 0:\n                # Top-left: no transformation\n                rr, cc = r, c\n            elif sr == 0 and sc == w - 1:\n                # Top-right: mirror horizontally\n                rr, cc = r, (w - 1) - c\n            elif sr == h - 1 and sc == 0:\n                # Bottom-left: mirror vertically\n                rr, cc = (h - 1) - r, c\n            elif sr == h - 1 and sc == w - 1:\n                # Bottom-right: mirror both\n                rr, cc = (h - 1) - r, (w - 1) - c\n            else:\n                # Fallback (shouldn't happen in valid inputs)\n                rr, cc = r, c\n            \n            # Apply the top-left fill pattern\n            if rr % 2 == 0:\n                # Even rows: fill [0, rr] and even columns beyond rr\n                if cc <= rr or (cc > rr and cc % 2 == 0):\n                    out[r][c] = val\n            else:\n                # Odd rows: fill only even columns beyond rr\n                if cc > rr and cc % 2 == 0:\n                    out[r][c] = val\n    \n    return out",
