  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    \n    # Find bounding box of 2s (the rectangle)\n    min_r2, max_r2 = rows, -1\n    min_c2, max_c2 = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                if r < min_r2: min_r2 = r\n                if r > max_r2: max_r2 = r\n                if c < min_c2: min_c2 = c\n                if c > max_c2: max_c2 = c\n    \n    # If no 2s found, return original grid\n    if max_r2 == -1:\n        return [row[:] for row in grid]\n    \n    # Find bounding box of pattern (non-0, non-2)\n    min_rp, max_rp = rows, -1\n    min_cp, max_cp = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0 and val != 2:\n                if r < min_rp: min_rp = r\n                if r > max_rp: max_rp = r\n                if c < min_cp: min_cp = c\n                if c > max_cp: max_cp = c\n    \n    # If no pattern found, return the rectangle as is\n    if max_rp == -1:\n        result = []\n        for r in range(min_r2, max_r2 + 1):\n            result.append(grid[r][min_c2:max_c2+1])\n        return result\n    \n    # Extract pattern\n    pat_h = max_rp - min_rp + 1\n    pat_w = max_cp - min_cp + 1\n    pattern = []\n    for r in range(min_rp, max_rp + 1):\n        row = []\n        for c in range(min_cp, max_cp + 1):\n            row.append(grid[r][c])\n        pattern.append(row)\n    \n    # Output dimensions\n    out_h = max_r2 - min_r2 + 1\n    out_w = max_c2 - min_c2 + 1\n    \n    # Initialize output with border of 2s and interior of 0s\n    output = [[0 for _ in range(out_w)] for _ in range(out_h)]\n    for r in range(out_h):\n        for c in range(out_w):\n            if r == 0 or r == out_h - 1 or c == 0 or c == out_w - 1:\n                output[r][c] = 2\n    \n    # Interior dimensions\n    int_h = out_h - 2\n    int_w = out_w - 2\n    \n    # Scale factors (assume divisible as per problem constraints)\n    scale_h = int_h // pat_h if pat_h > 0 else 1\n    scale_w = int_w // pat_w if pat_w > 0 else 1\n    \n    # Fill interior based on scaled pattern\n    for pr in range(pat_h):\n        for pc in range(pat_w):\n            val = pattern[pr][pc]\n            if val != 0:\n                start_r = 1 + pr * scale_h\n                start_c = 1 + pc * scale_w\n                for dr in range(scale_h):\n                    for dc in range(scale_w):\n                        output[start_r + dr][start_c + dc] = val\n    \n    return output\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    \n    # Find bounding box of 2s (the rectangle)\n    min_r2, max_r2 = rows, -1\n    min_c2, max_c2 = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                if r < min_r2: min_r2 = r\n                if r > max_r2: max_r2 = r\n                if c < min_c2: min_c2 = c\n                if c > max_c2: max_c2 = c\n    \n    # If no 2s found, return original grid\n    if max_r2 == -1:\n        return [row[:] for row in grid]\n    \n    # Find bounding box of pattern (non-0, non-2)\n    min_rp, max_rp = rows, -1\n    min_cp, max_cp = cols, -1\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0 and val != 2:\n                if r < min_rp: min_rp = r\n                if r > max_rp: max_rp = r\n                if c < min_cp: min_cp = c\n                if c > max_cp: max_cp = c\n    \n    # If no pattern found, return the rectangle as is\n    if max_rp == -1:\n        result = []\n        for r in range(min_r2, max_r2 + 1):\n            result.append(grid[r][min_c2:max_c2+1])\n        return result\n    \n    # Extract pattern\n    pat_h = max_rp - min_rp + 1\n    pat_w = max_cp - min_cp + 1\n    pattern = []\n    for r in range(min_rp, max_rp + 1):\n        row = []\n        for c in range(min_cp, max_cp + 1):\n            row.append(grid[r][c])\n        pattern.append(row)\n    \n    # Output dimensions\n    out_h = max_r2 - min_r2 + 1\n    out_w = max_c2 - min_c2 + 1\n    \n    # Initialize output with border of 2s and interior of 0s\n    output = [[0 for _ in range(out_w)] for _ in range(out_h)]\n    for r in range(out_h):\n        for c in range(out_w):\n            if r == 0 or r == out_h - 1 or c == 0 or c == out_w - 1:\n                output[r][c] = 2\n    \n    # Interior dimensions\n    int_h = out_h - 2\n    int_w = out_w - 2\n    \n    # Scale factors (assume divisible as per problem constraints)\n    scale_h = int_h // pat_h if pat_h > 0 else 1\n    scale_w = int_w // pat_w if pat_w > 0 else 1\n    \n    # Fill interior based on scaled pattern\n    for pr in range(pat_h):\n        for pc in range(pat_w):\n            val = pattern[pr][pc]\n            if val != 0:\n                start_r = 1 + pr * scale_h\n                start_c = 1 + pc * scale_w\n                for dr in range(scale_h):\n                    for dc in range(scale_w):\n                        output[start_r + dr][start_c + dc] = val\n    \n    return output",
