  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Create output as a copy of the input\n    output = [row[:] for row in grid]\n    \n    # Track visited cells to find connected components\n    visited = [[False for _ in range(cols)] for _ in range(rows)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and not visited[r][c]:\n                # BFS to find all cells in this component\n                queue = [(r, c)]\n                visited[r][c] = True\n                min_r, max_r = r, r\n                min_c, max_c = c, c\n                \n                while queue:\n                    cr, cc = queue.pop(0)\n                    min_r = min(min_r, cr)\n                    max_r = max(max_r, cr)\n                    min_c = min(min_c, cc)\n                    max_c = max(max_c, cc)\n                    \n                    # Check 4-connected neighbors\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 1 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                queue.append((nr, nc))\n                \n                # Calculate center row and column\n                mid_r = (min_r + max_r) // 2\n                mid_c = (min_c + max_c) // 2\n                \n                # Fill the horizontal line (middle row) with 6s\n                for cc in range(cols):\n                    if grid[mid_r][cc] != 1:\n                        output[mid_r][cc] = 6\n                \n                # Fill the vertical line (middle column) with 6s\n                for rr in range(rows):\n                    if grid[rr][mid_c] != 1:\n                        output[rr][mid_c] = 6\n    \n    return output",
