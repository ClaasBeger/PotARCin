  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find separator rows (all values are 5)\n    sep_rows = [r for r in range(rows) if all(grid[r][c] == 5 for c in range(cols))]\n    \n    # Find separator columns (all values are 5)\n    sep_cols = [c for c in range(cols) if all(grid[r][c] == 5 for r in range(rows))]\n    \n    # Initialize output grid\n    output = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    # Fill separators with 5\n    for r in sep_rows:\n        for c in range(cols):\n            output[r][c] = 5\n    for c in sep_cols:\n        for r in range(rows):\n            output[r][c] = 5\n    \n    # Calculate row segments between separators\n    row_segments = []\n    start = 0\n    for sep in sep_rows:\n        if start < sep:\n            row_segments.append((start, sep - 1))\n        start = sep + 1\n    if start < rows:\n        row_segments.append((start, rows - 1))\n    \n    # Calculate column segments between separators\n    col_segments = []\n    start = 0\n    for sep in sep_cols:\n        if start < sep:\n            col_segments.append((start, sep - 1))\n        start = sep + 1\n    if start < cols:\n        col_segments.append((start, cols - 1))\n    \n    # Fill each block\n    for r_start, r_end in row_segments:\n        for c_start, c_end in col_segments:\n            # Find the non-zero, non-5 value in this block\n            target_val = None\n            for r in range(r_start, r_end + 1):\n                for c in range(c_start, c_end + 1):\n                    val = grid[r][c]\n                    if val != 0 and val != 5:\n                        target_val = val\n                        break\n                if target_val is not None:\n                    break\n            \n            # Fill the block with target_val + 5\n            if target_val is not None:\n                fill_val = target_val + 5\n                for r in range(r_start, r_end + 1):\n                    for c in range(c_start, c_end + 1):\n                        output[r][c] = fill_val\n    \n    return output",
