5 5 5 5 0 5 5 5\n0 5 5 0 5 5 0 5 0 0\n5 5 0 5 5 5 5 5 0 5\n5 5 0 5 5 5 5 5 5 0\n0 0 5 5 5 5 0 5 5 5\n5 5 5 5 0 5 0 0 5 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "```python\nfrom collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    out = [row[:] for row in grid]\n    \n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 0 and not visited[i][j]:\n                # BFS to find the connected component of zeros\n                component = []\n                dq = deque()\n                dq.append((i, j))\n                visited[i][j] = True\n                while dq:\n                    x, y = dq.popleft()\n                    component.append((x, y))\n                    # 4-directional neighbors\n                    nx = x - 1\n                    if nx >= 0 and grid[nx][y] == 0 and not visited[nx][y]:\n                        visited[nx][y] = True\n                        dq.append((nx, y))\n                    nx = x + 1\n                    if nx < rows and grid[nx][y] == 0 and not visited[nx][y]:\n                        visited[nx][y] = True\n                        dq.append((nx, y))\n                    ny = y - 1\n                    if ny >= 0 and grid[x][ny] == 0 and not visited[x][ny]:\n                        visited[x][ny] = True\n                        dq.append((x, ny))\n                    ny = y + 1\n                    if ny < cols and grid[x][ny] == 0 and not visited[x][ny]:\n                        visited[x][ny] = True\n                        dq.append((x, ny))\n                size = len(component)\n                # Map component size to output value: 1->3, 2->2, 3->1\n                if size == 1:\n                    val = 3\n                elif size == 2:\n                    val = 2\n                elif size == 3:\n                    val = 1\n                else:\n                    val = 0  # fallback, not expected in given tasks\n                for x, y in component:\n                    out[x][y] = val\n    return out\n```",
  "script": "from collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    out = [row[:] for row in grid]\n    \n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 0 and not visited[i][j]:\n                # BFS to find the connected component of zeros\n                component = []\n                dq = deque()\n                dq.append((i, j))\n                visited[i][j] = True\n                while dq:\n                    x, y = dq.popleft()\n                    component.append((x, y))\n                    # 4-directional neighbors\n                    nx = x - 1\n                    if nx >= 0 and grid[nx][y] == 0 and not visited[nx][y]:\n                        visited[nx][y] = True\n                        dq.append((nx, y))\n                    nx = x + 1\n                    if nx < rows and grid[nx][y] == 0 and not visited[nx][y]:\n                        visited[nx][y] = True\n                        dq.append((nx, y))\n                    ny = y - 1\n                    if ny >= 0 and grid[x][ny] == 0 and not visited[x][ny]:\n                        visited[x][ny] = True\n                        dq.append((x, ny))\n                    ny = y + 1\n                    if ny < cols and grid[x][ny] == 0 and not visited[x][ny]:\n                        visited[x][ny] = True\n                        dq.append((x, ny))\n                size = len(component)\n                # Map component size to output value: 1->3, 2->2, 3->1\n                if size == 1:\n                    val = 3\n                elif size == 2:\n                    val = 2\n                elif size == 3:\n                    val = 1\n                else:\n                    val = 0  # fallback, not expected in given tasks\n                for x, y in component:\n                    out[x][y] = val\n    return out",
