  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    output = [row[:] for row in grid]\n    visited = [[False] * cols for _ in range(rows)]\n    \n    from collections import deque\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and not visited[r][c]:\n                # BFS to find connected component\n                queue = deque()\n                queue.append((r, c))\n                visited[r][c] = True\n                component = [(r, c)]\n                \n                while queue:\n                    cr, cc = queue.popleft()\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == 1:\n                            visited[nr][nc] = True\n                            queue.append((nr, nc))\n                            component.append((nr, nc))\n                \n                # Analyze if this component is a hollow rectangle\n                min_r = min(p[0] for p in component)\n                max_r = max(p[0] for p in component)\n                min_c = min(p[1] for p in component)\n                max_c = max(p[1] for p in component)\n                \n                height = max_r - min_r + 1\n                width = max_c - min_c + 1\n                \n                # Must be at least 3x3 to be a hollow rectangle\n                if height < 3 or width < 3:\n                    continue\n                \n                # Check if any cell is in the interior (strictly inside bounding box)\n                has_interior_cell = False\n                for (cr, cc) in component:\n                    if min_r < cr < max_r and min_c < cc < max_c:\n                        has_interior_cell = True\n                        break\n                \n                if has_interior_cell:\n                    continue\n                \n                # Check if component size matches perimeter of bounding box\n                expected_size = 2 * (height + width) - 4\n                if len(component) != expected_size:\n                    continue\n                \n                # This is a hollow rectangle, change all its cells to 3\n                for (cr, cc) in component:\n                    output[cr][cc] = 3\n    \n    return output\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    output = [row[:] for row in grid]\n    visited = [[False] * cols for _ in range(rows)]\n    \n    from collections import deque\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and not visited[r][c]:\n                # BFS to find connected component\n                queue = deque()\n                queue.append((r, c))\n                visited[r][c] = True\n                component = [(r, c)]\n                \n                while queue:\n                    cr, cc = queue.popleft()\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == 1:\n                            visited[nr][nc] = True\n                            queue.append((nr, nc))\n                            component.append((nr, nc))\n                \n                # Analyze if this component is a hollow rectangle\n                min_r = min(p[0] for p in component)\n                max_r = max(p[0] for p in component)\n                min_c = min(p[1] for p in component)\n                max_c = max(p[1] for p in component)\n                \n                height = max_r - min_r + 1\n                width = max_c - min_c + 1\n                \n                # Must be at least 3x3 to be a hollow rectangle\n                if height < 3 or width < 3:\n                    continue\n                \n                # Check if any cell is in the interior (strictly inside bounding box)\n                has_interior_cell = False\n                for (cr, cc) in component:\n                    if min_r < cr < max_r and min_c < cc < max_c:\n                        has_interior_cell = True\n                        break\n                \n                if has_interior_cell:\n                    continue\n                \n                # Check if component size matches perimeter of bounding box\n                expected_size = 2 * (height + width) - 4\n                if len(component) != expected_size:\n                    continue\n                \n                # This is a hollow rectangle, change all its cells to 3\n                for (cr, cc) in component:\n                    output[cr][cc] = 3\n    \n    return output",
