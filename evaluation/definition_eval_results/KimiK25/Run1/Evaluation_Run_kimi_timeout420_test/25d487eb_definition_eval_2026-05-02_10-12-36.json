  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Count occurrences of each non-zero color\n    color_count = {}\n    non_zero_pixels = []\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0:\n                non_zero_pixels.append((r, c, val))\n                color_count[val] = color_count.get(val, 0) + 1\n    \n    if not non_zero_pixels:\n        return grid\n    \n    # Find marker color (least frequent non-zero color)\n    marker_color = min(color_count, key=color_count.get)\n    \n    # Find marker position and shape pixels (all other non-zero pixels)\n    marker_r, marker_c = -1, -1\n    shape_pixels = []\n    for r, c, val in non_zero_pixels:\n        if val == marker_color:\n            marker_r, marker_c = r, c\n        else:\n            shape_pixels.append((r, c))\n    \n    if marker_r == -1 or not shape_pixels:\n        return grid\n    \n    # Calculate center of mass of the shape\n    sum_r = sum(r for r, c in shape_pixels)\n    sum_c = sum(c for r, c in shape_pixels)\n    n = len(shape_pixels)\n    mean_r = sum_r / n\n    mean_c = sum_c / n\n    \n    # Determine direction from marker to center of mass\n    dr = mean_r - marker_r\n    dc = mean_c - marker_c\n    \n    # Create output grid\n    output = [row[:] for row in grid]\n    \n    # Determine step direction based on dominant axis\n    if abs(dr) > abs(dc):\n        # Vertical movement\n        step_r = -1 if dr < 0 else 1\n        step_c = 0\n    else:\n        # Horizontal movement\n        step_r = 0\n        step_c = -1 if dc < 0 else 1\n    \n    # Walk from marker in the determined direction, filling empty cells\n    r, c = marker_r + step_r, marker_c + step_c\n    while 0 <= r < rows and 0 <= c < cols:\n        if output[r][c] == 0:\n            output[r][c] = marker_color\n        r += step_r\n        c += step_c\n    \n    return output",
