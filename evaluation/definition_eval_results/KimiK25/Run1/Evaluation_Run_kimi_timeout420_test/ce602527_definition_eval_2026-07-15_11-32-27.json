  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Determine background color (most frequent)\n    from collections import Counter\n    freq = Counter(v for row in grid for v in grid[0])\n    # Actually count all cells\n    freq = Counter(grid[r][c] for r in range(rows) for c in range(cols))\n    bg = freq.most_common(1)[0][0]\n    \n    visited = [[False] * cols for _ in range(rows)]\n    best = None\n    best_dist = None\n    best_sum = None\n    best_min_r = None\n    best_min_c = None\n    \n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c] and grid[r][c] != bg:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                min_r, max_r = r, r\n                min_c, max_c = c, c\n                idx = 0\n                while idx < len(stack):\n                    cr, cc = stack[idx]\n                    idx += 1\n                    if cr < min_r: min_r = cr\n                    if cr > max_r: max_r = cr\n                    if cc < min_c: min_c = cc\n                    if cc > max_c: max_c = cc\n                    for dr, dc in ((1,0), (-1,0), (0,1), (0,-1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == color:\n                            visited[nr][nc] = True\n                            stack.append((nr, nc))\n                center_r = (min_r + max_r) / 2.0\n                center_c = (min_c + max_c) / 2.0\n                dist = abs(center_r - center_c)\n                s = center_r + center_c\n                if (best_dist is None or dist < best_dist - 1e-9 or\n                    (abs(dist - best_dist) < 1e-9 and\n                     (s < best_sum - 1e-9 or\n                      (abs(s - best_sum) < 1e-9 and\n                       (min_r < best_min_r or\n                        (min_r == best_min_r and min_c < best_min_c)))))):\n                    best_dist = dist\n                    best_sum = s\n                    best_min_r = min_r\n                    best_min_c = min_c\n                    best = (min_r, max_r, min_c, max_c)\n    \n    if best is None:\n        return []\n    min_r, max_r, min_c, max_c = best\n    return [row[min_c:max_c+1] for row in grid[min_r:max_r+1]]\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Determine background color (most frequent)\n    from collections import Counter\n    freq = Counter(v for row in grid for v in grid[0])\n    # Actually count all cells\n    freq = Counter(grid[r][c] for r in range(rows) for c in range(cols))\n    bg = freq.most_common(1)[0][0]\n    \n    visited = [[False] * cols for _ in range(rows)]\n    best = None\n    best_dist = None\n    best_sum = None\n    best_min_r = None\n    best_min_c = None\n    \n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c] and grid[r][c] != bg:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                min_r, max_r = r, r\n                min_c, max_c = c, c\n                idx = 0\n                while idx < len(stack):\n                    cr, cc = stack[idx]\n                    idx += 1\n                    if cr < min_r: min_r = cr\n                    if cr > max_r: max_r = cr\n                    if cc < min_c: min_c = cc\n                    if cc > max_c: max_c = cc\n                    for dr, dc in ((1,0), (-1,0), (0,1), (0,-1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == color:\n                            visited[nr][nc] = True\n                            stack.append((nr, nc))\n                center_r = (min_r + max_r) / 2.0\n                center_c = (min_c + max_c) / 2.0\n                dist = abs(center_r - center_c)\n                s = center_r + center_c\n                if (best_dist is None or dist < best_dist - 1e-9 or\n                    (abs(dist - best_dist) < 1e-9 and\n                     (s < best_sum - 1e-9 or\n                      (abs(s - best_sum) < 1e-9 and\n                       (min_r < best_min_r or\n                        (min_r == best_min_r and min_c < best_min_c)))))):\n                    best_dist = dist\n                    best_sum = s\n                    best_min_r = min_r\n                    best_min_c = min_c\n                    best = (min_r, max_r, min_c, max_c)\n    \n    if best is None:\n        return []\n    min_r, max_r, min_c, max_c = best\n    return [row[min_c:max_c+1] for row in grid[min_r:max_r+1]]",
