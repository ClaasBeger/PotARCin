  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    n = len(grid)\n    m = len(grid[0])\n    \n    div_rows = [i for i in range(n) if all(grid[i][j] == 5 for j in range(m))]\n    div_cols = [j for j in range(m) if all(grid[i][j] == 5 for i in range(n))]\n    \n    def make_bounds(divs, total):\n        bounds = []\n        start = 0\n        for d in divs:\n            bounds.append((start, d))\n            start = d + 1\n        bounds.append((start, total))\n        return bounds\n    \n    row_bounds = make_bounds(div_rows, n)\n    col_bounds = make_bounds(div_cols, m)\n    \n    bottom_br = len(row_bounds) - 1\n    \n    best_count = -1\n    src_br = -1\n    src_bc = -1\n    for bc in range(len(col_bounds)):\n        r0, r1 = row_bounds[bottom_br]\n        c0, c1 = col_bounds[bc]\n        cnt = 0\n        for i in range(r0, r1):\n            for j in range(c0, c1):\n                if grid[i][j] != 0:\n                    cnt += 1\n        if cnt > best_count:\n            best_count = cnt\n            src_br = bottom_br\n            src_bc = bc\n    \n    out = [[5 if grid[i][j] == 5 else 0 for j in range(m)] for i in range(n)]\n    \n    if best_count <= 0:\n        return out\n    \n    sr0, sr1 = row_bounds[src_br]\n    sc0, sc1 = col_bounds[src_bc]\n    h = sr1 - sr0\n    w = sc1 - sc0\n    source_block = [grid[i][sc0:sc1] for i in range(sr0, sr1)]\n    \n    cells = []\n    for i in range(h):\n        for j in range(w):\n            if source_block[i][j] != 0:\n                cells.append((i, j))\n    \n    max_dist = -1\n    cand_cols = []\n    for _, c in cells:\n        d = abs(c - src_bc)\n        if d > max_dist:\n            max_dist = d\n            cand_cols = [c]\n        elif d == max_dist:\n            cand_cols.append(c)\n    tgt_bc = max(cand_cols)\n    \n    tgt_br = min(i for i, c in cells if c == tgt_bc)\n    \n    tr0, _ = row_bounds[tgt_br]\n    tc0, _ = col_bounds[tgt_bc]\n    for i in range(h):\n        for j in range(w):\n            out[tr0 + i][tc0 + j] = source_block[i][j]\n    \n    return out\n```",
