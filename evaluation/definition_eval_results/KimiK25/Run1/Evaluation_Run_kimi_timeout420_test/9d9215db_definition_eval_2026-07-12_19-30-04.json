  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n\n    # Determine the parity class of the non-zero cells\n    p = q = None\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] != 0:\n                p = r % 2\n                q = c % 2\n                break\n        if p is not None:\n            break\n\n    if p is None:\n        return [row[:] for row in grid]\n\n    # Extract the subgrid containing only cells of that parity\n    rows = [r for r in range(H) if r % 2 == p]\n    cols = [c for c in range(W) if c % 2 == q]\n    R = len(rows)\n    C = len(cols)\n\n    S = [[0] * C for _ in range(R)]\n    for i, r in enumerate(rows):\n        for j, c in enumerate(cols):\n            S[i][j] = grid[r][c]\n\n    # Determine colors for each frame\n    corner_color = {}\n    edge_color = {}\n    for r in range(R):\n        for c in range(C):\n            v = S[r][c]\n            if v == 0:\n                continue\n            d = min(r, c, R - 1 - r, C - 1 - c)\n            is_corner = (\n                (r == d and c == d) or\n                (r == d and c == C - 1 - d) or\n                (r == R - 1 - d and c == d) or\n                (r == R - 1 - d and c == C - 1 - d)\n            )\n            if is_corner:\n                corner_color[d] = v\n            else:\n                edge_color[d] = v\n\n    max_d = min((R + 1) // 2, (C + 1) // 2)\n    S_out = [[0] * C for _ in range(R)]\n\n    for d in range(max_d):\n        if d in corner_color:\n            v = corner_color[d]\n            S_out[d][d] = v\n            S_out[d][C - 1 - d] = v\n            S_out[R - 1 - d][d] = v\n            S_out[R - 1 - d][C - 1 - d] = v\n\n        if d in edge_color:\n            v = edge_color[d]\n            # top edge\n            for c in range(d + 1, C - 1 - d):\n                S_out[d][c] = v\n            # bottom edge\n            for c in range(d + 1, C - 1 - d):\n                S_out[R - 1 - d][c] = v\n            # left edge\n            for r in range(d + 1, R - 1 - d):\n                S_out[r][d] = v\n            # right edge\n            for r in range(d + 1, R - 1 - d):\n                S_out[r][C - 1 - d] = v\n\n    # Map back to original grid\n    out = [[0] * W for _ in range(H)]\n    for i, r in enumerate(rows):\n        for j, c in enumerate(cols):\n            out[r][c] = S_out[i][j]\n\n    return out",
