  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0]) if rows > 0 else 0\n    \n    # Create a deep copy of the grid\n    output = [row[:] for row in grid]\n    \n    # Find all positions of 8s\n    eights = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n    \n    # Group by row and column\n    from collections import defaultdict\n    row_groups = defaultdict(list)\n    col_groups = defaultdict(list)\n    \n    for r, c in eights:\n        row_groups[r].append(c)\n        col_groups[c].append(r)\n    \n    # Process horizontal connections (same row)\n    for r, col_list in row_groups.items():\n        if len(col_list) >= 2:\n            col_list_sorted = sorted(col_list)\n            for i in range(len(col_list_sorted) - 1):\n                start_c = col_list_sorted[i]\n                end_c = col_list_sorted[i + 1]\n                for c in range(start_c + 1, end_c):\n                    if output[r][c] == 0:\n                        output[r][c] = 3\n    \n    # Process vertical connections (same column)\n    for c, row_list in col_groups.items():\n        if len(row_list) >= 2:\n            row_list_sorted = sorted(row_list)\n            for i in range(len(row_list_sorted) - 1):\n                start_r = row_list_sorted[i]\n                end_r = row_list_sorted[i + 1]\n                for r in range(start_r + 1, end_r):\n                    if output[r][c] == 0:\n                        output[r][c] = 3\n    \n    return output\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0]) if rows > 0 else 0\n    \n    # Create a deep copy of the grid\n    output = [row[:] for row in grid]\n    \n    # Find all positions of 8s\n    eights = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n    \n    # Group by row and column\n    from collections import defaultdict\n    row_groups = defaultdict(list)\n    col_groups = defaultdict(list)\n    \n    for r, c in eights:\n        row_groups[r].append(c)\n        col_groups[c].append(r)\n    \n    # Process horizontal connections (same row)\n    for r, col_list in row_groups.items():\n        if len(col_list) >= 2:\n            col_list_sorted = sorted(col_list)\n            for i in range(len(col_list_sorted) - 1):\n                start_c = col_list_sorted[i]\n                end_c = col_list_sorted[i + 1]\n                for c in range(start_c + 1, end_c):\n                    if output[r][c] == 0:\n                        output[r][c] = 3\n    \n    # Process vertical connections (same column)\n    for c, row_list in col_groups.items():\n        if len(row_list) >= 2:\n            row_list_sorted = sorted(row_list)\n            for i in range(len(row_list_sorted) - 1):\n                start_r = row_list_sorted[i]\n                end_r = row_list_sorted[i + 1]\n                for r in range(start_r + 1, end_r):\n                    if output[r][c] == 0:\n                        output[r][c] = 3\n    \n    return output",
