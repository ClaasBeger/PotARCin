  "raw_response": "```python\nfrom collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    original = grid\n    output = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    # Find connected components of 2s and compute their bounding boxes\n    for r in range(h):\n        for c in range(w):\n            if original[r][c] == 2 and not visited[r][c]:\n                q = deque()\n                q.append((r, c))\n                visited[r][c] = True\n                min_r = max_r = r\n                min_c = max_c = c\n                while q:\n                    cr, cc = q.popleft()\n                    if cr < min_r:\n                        min_r = cr\n                    if cr > max_r:\n                        max_r = cr\n                    if cc < min_c:\n                        min_c = cc\n                    if cc > max_c:\n                        max_c = cc\n                    # Up\n                    nr = cr - 1\n                    if nr >= 0 and not visited[nr][cc] and original[nr][cc] == 2:\n                        visited[nr][cc] = True\n                        q.append((nr, cc))\n                    # Down\n                    nr = cr + 1\n                    if nr < h and not visited[nr][cc] and original[nr][cc] == 2:\n                        visited[nr][cc] = True\n                        q.append((nr, cc))\n                    # Left\n                    nc = cc - 1\n                    if nc >= 0 and not visited[cr][nc] and original[cr][nc] == 2:\n                        visited[cr][nc] = True\n                        q.append((cr, nc))\n                    # Right\n                    nc = cc + 1\n                    if nc < w and not visited[cr][nc] and original[cr][nc] == 2:\n                        visited[cr][nc] = True\n                        q.append((cr, nc))\n                components.append((min_r, max_r, min_c, max_c))\n\n    n = len(components)\n    for i in range(n):\n        rmin_i, rmax_i, cmin_i, cmax_i = components[i]\n        for j in range(i + 1, n):\n            rmin_j, rmax_j, cmin_j, cmax_j = components[j]\n\n            # Check if row intervals overlap\n            if rmax_i < rmin_j or rmax_j < rmin_i:\n                continue\n\n            # Determine left and right components\n            if cmax_i < cmin_j:\n                left = components[i]\n                right = components[j]\n            elif cmax_j < cmin_i:\n                left = components[j]\n                right = components[i]\n            else:\n                # Overlapping or touching horizontally: no gap to fill\n                continue\n\n            gap_c_start = left[3] + 1\n            gap_c_end = right[2] - 1\n            if gap_c_start > gap_c_end:\n                continue\n\n            # Overlapping row range\n            row_start = max(rmin_i, rmin_j)\n            row_end = min(rmax_i, rmax_j)\n\n            # Verify the gap contains no original 2s (i.e., is empty)\n            blocked = False\n            for rr in range(row_start, row_end + 1):\n                for cc in range(gap_c_start, gap_c_end + 1):\n                    if original[rr][cc] != 0:\n                        blocked = True\n                        break\n                if blocked:\n                    break\n            if blocked:\n                continue\n\n            # Fill the gap with 9\n            for rr in range(row_start, row_end + 1):\n                for cc in range(gap_c_start, gap_c_end + 1):\n                    output[rr][cc] = 9\n\n    return output\n```",
  "script": "from collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    original = grid\n    output = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    # Find connected components of 2s and compute their bounding boxes\n    for r in range(h):\n        for c in range(w):\n            if original[r][c] == 2 and not visited[r][c]:\n                q = deque()\n                q.append((r, c))\n                visited[r][c] = True\n                min_r = max_r = r\n                min_c = max_c = c\n                while q:\n                    cr, cc = q.popleft()\n                    if cr < min_r:\n                        min_r = cr\n                    if cr > max_r:\n                        max_r = cr\n                    if cc < min_c:\n                        min_c = cc\n                    if cc > max_c:\n                        max_c = cc\n                    # Up\n                    nr = cr - 1\n                    if nr >= 0 and not visited[nr][cc] and original[nr][cc] == 2:\n                        visited[nr][cc] = True\n                        q.append((nr, cc))\n                    # Down\n                    nr = cr + 1\n                    if nr < h and not visited[nr][cc] and original[nr][cc] == 2:\n                        visited[nr][cc] = True\n                        q.append((nr, cc))\n                    # Left\n                    nc = cc - 1\n                    if nc >= 0 and not visited[cr][nc] and original[cr][nc] == 2:\n                        visited[cr][nc] = True\n                        q.append((cr, nc))\n                    # Right\n                    nc = cc + 1\n                    if nc < w and not visited[cr][nc] and original[cr][nc] == 2:\n                        visited[cr][nc] = True\n                        q.append((cr, nc))\n                components.append((min_r, max_r, min_c, max_c))\n\n    n = len(components)\n    for i in range(n):\n        rmin_i, rmax_i, cmin_i, cmax_i = components[i]\n        for j in range(i + 1, n):\n            rmin_j, rmax_j, cmin_j, cmax_j = components[j]\n\n            # Check if row intervals overlap\n            if rmax_i < rmin_j or rmax_j < rmin_i:\n                continue\n\n            # Determine left and right components\n            if cmax_i < cmin_j:\n                left = components[i]\n                right = components[j]\n            elif cmax_j < cmin_i:\n                left = components[j]\n                right = components[i]\n            else:\n                # Overlapping or touching horizontally: no gap to fill\n                continue\n\n            gap_c_start = left[3] + 1\n            gap_c_end = right[2] - 1\n            if gap_c_start > gap_c_end:\n                continue\n\n            # Overlapping row range\n            row_start = max(rmin_i, rmin_j)\n            row_end = min(rmax_i, rmax_j)\n\n            # Verify the gap contains no original 2s (i.e., is empty)\n            blocked = False\n            for rr in range(row_start, row_end + 1):\n                for cc in range(gap_c_start, gap_c_end + 1):\n                    if original[rr][cc] != 0:\n                        blocked = True\n                        break\n                if blocked:\n                    break\n            if blocked:\n                continue\n\n            # Fill the gap with 9\n            for rr in range(row_start, row_end + 1):\n                for cc in range(gap_c_start, gap_c_end + 1):\n                    output[rr][cc] = 9\n\n    return output",
