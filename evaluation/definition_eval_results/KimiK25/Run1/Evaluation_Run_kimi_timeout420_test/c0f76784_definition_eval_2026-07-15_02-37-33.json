               break\n                    if not valid:\n                        break\n\n                if not valid:\n                    continue\n\n                fill = max(h, w) - 2 + 5\n                for rr in range(min_r + 1, max_r):\n                    for cc in range(min_c + 1, max_c):\n                        out[rr][cc] = fill\n\n    return out",
