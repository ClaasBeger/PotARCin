  "raw_response": "from collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n    visited = [[False] * cols for _ in range(rows)]\n\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5 and not visited[r][c]:\n                q = deque()\n                q.append((r, c))\n                visited[r][c] = True\n                min_r = max_r = r\n                min_c = max_c = c\n\n                while q:\n                    cr, cc = q.popleft()\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if not visited[nr][nc] and grid[nr][nc] == 5:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n                                if nr < min_r:\n                                    min_r = nr\n                                if nr > max_r:\n                                    max_r = nr\n                                if nc < min_c:\n                                    min_c = nc\n                                if nc > max_c:\n                                    max_c = nc\n\n                h = max_r - min_r + 1\n                w = max_c - min_c + 1\n                if h < 2 or w < 2:\n                    continue\n\n                valid = True\n                for rr in range(min_r, max_r + 1):\n                    for cc in range(min_c, max_c + 1):\n                        if rr == min_r or rr == max_r or cc == min_c or cc == max_c:\n                            if grid[rr][cc] != 5:\n                                valid = False\n                                break\n                        else:\n                            if grid[rr][cc] != 0:\n                                valid = False\n           