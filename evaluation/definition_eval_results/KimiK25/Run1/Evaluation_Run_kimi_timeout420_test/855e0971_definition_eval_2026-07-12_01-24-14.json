  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n\n    def row_base(row):\n        for v in row:\n            if v != 0:\n                return v\n        return None\n\n    def col_base(c):\n        for r in range(H):\n            v = grid[r][c]\n            if v != 0:\n                return v\n        return None\n\n    # Check uniformity\n    rows_uniform = True\n    for row in grid:\n        nonzeros = {v for v in row if v != 0}\n        if len(nonzeros) > 1:\n            rows_uniform = False\n            break\n\n    cols_uniform = True\n    for c in range(W):\n        nonzeros = {grid[r][c] for r in range(H) if grid[r][c] != 0}\n        if len(nonzeros) > 1:\n            cols_uniform = False\n            break\n\n    result = [row[:] for row in grid]\n\n    if rows_uniform:\n        i = 0\n        while i < H:\n            base = row_base(grid[i])\n            start = i\n            while i < H and row_base(grid[i]) == base:\n                i += 1\n            end = i - 1\n            zero_cols = set()\n            for r in range(start, end + 1):\n                for c, val in enumerate(grid[r]):\n                    if val == 0:\n                        zero_cols.add(c)\n            for r in range(start, end + 1):\n                for c in zero_cols:\n                    result[r][c] = 0\n    elif cols_uniform:\n        j = 0\n        while j < W:\n            base = col_base(j)\n            start = j\n            while j < W and col_base(j) == base:\n                j += 1\n            end = j - 1\n            zero_rows = set()\n            for c in range(start, end + 1):\n                for r in range(H):\n                    if grid[r][c] == 0:\n                        zero_rows.add(r)\n            for c in range(start, end + 1):\n                for r in zero_rows:\n                    result[r][c] = 0\n\n    return result",
