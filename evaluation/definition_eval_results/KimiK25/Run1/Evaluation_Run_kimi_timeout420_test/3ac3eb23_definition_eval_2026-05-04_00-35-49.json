  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    output = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != 0:\n                for i in range(r, rows):\n                    offset = i - r\n                    if offset % 2 == 0:\n                        output[i][c] = val\n                    else:\n                        if c > 0:\n                            output[i][c-1] = val\n                        if c < cols - 1:\n                            output[i][c+1] = val\n    return output\n```",
