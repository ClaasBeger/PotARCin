  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    if cols == 0:\n        return [[] for _ in range(rows)]\n    \n    visited = [[False] * cols for _ in range(rows)]\n    components = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                cells = []\n                stack = [(r, c)]\n                visited[r][c] = True\n                \n                while stack:\n                    cr, cc = stack.pop()\n                    cells.append((cr, cc))\n                    \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if not visited[nr][nc] and grid[nr][nc] == color:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n                \n                min_row = min(cell[0] for cell in cells)\n                max_row = max(cell[0] for cell in cells)\n                height = max_row - min_row + 1\n                \n                components.append({\n                    'cells': cells,\n                    'height': height,\n                    'color': color\n                })\n    \n    output = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    for comp in components:\n        height = comp['height']\n        for r, c in comp['cells']:\n            new_r = r - height\n            if 0 <= new_r < rows:\n                output[new_r][c] = comp['color']\n    \n    return output\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    if cols == 0:\n        return [[] for _ in range(rows)]\n    \n    visited = [[False] * cols for _ in range(rows)]\n    components = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                cells = []\n                stack = [(r, c)]\n                visited[r][c] = True\n                \n                while stack:\n                    cr, cc = stack.pop()\n                    cells.append((cr, cc))\n                    \n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if not visited[nr][nc] and grid[nr][nc] == color:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n                \n                min_row = min(cell[0] for cell in cells)\n                max_row = max(cell[0] for cell in cells)\n                height = max_row - min_row + 1\n                \n                components.append({\n                    'cells': cells,\n                    'height': height,\n                    'color': color\n                })\n    \n    output = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    for comp in components:\n        height = comp['height']\n        for r, c in comp['cells']:\n            new_r = r - height\n            if 0 <= new_r < rows:\n                output[new_r][c] = comp['color']\n    \n    return output",
