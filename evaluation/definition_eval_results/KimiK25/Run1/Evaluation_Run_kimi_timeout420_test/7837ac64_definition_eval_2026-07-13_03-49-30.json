  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    n = len(grid)\n    m = len(grid[0])\n    \n    from collections import Counter\n    cnt = Counter()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                cnt[v] += 1\n    if not cnt:\n        return [[0]]\n    L = cnt.most_common(1)[0][0]\n    \n    row_counts = [sum(1 for v in row if v == L) for row in grid]\n    col_counts = [sum(1 for i in range(n) if grid[i][j] == L) for j in range(m)]\n    \n    sep_rows = [i for i, c in enumerate(row_counts) if c > m * 0.6]\n    sep_cols = [j for j, c in enumerate(col_counts) if c > n * 0.6]\n    \n    data_rows = [i for i in sep_rows if any(v != L for v in grid[i])]\n    data_cols = [j for j in sep_cols if any(grid[i][j] != L for i in range(n))]\n    \n    out = []\n    for i in range(len(data_rows) - 1):\n        r1 = data_rows[i]\n        r2 = data_rows[i + 1]\n        out_row = []\n        for j in range(len(data_cols) - 1):\n            c1 = data_cols[j]\n            c2 = data_cols[j + 1]\n            vals = [grid[r1][c1], grid[r1][c2], grid[r2][c1], grid[r2][c2]]\n            if len(set(vals)) == 1:\n                val = vals[0]\n                out_row.append(val if val != L else 0)\n            else:\n                out_row.append(0)\n        out.append(out_row)\n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    n = len(grid)\n    m = len(grid[0])\n    \n    from collections import Counter\n    cnt = Counter()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                cnt[v] += 1\n    if not cnt:\n        return [[0]]\n    L = cnt.most_common(1)[0][0]\n    \n    row_counts = [sum(1 for v in row if v == L) for row in grid]\n    col_counts = [sum(1 for i in range(n) if grid[i][j] == L) for j in range(m)]\n    \n    sep_rows = [i for i, c in enumerate(row_counts) if c > m * 0.6]\n    sep_cols = [j for j, c in enumerate(col_counts) if c > n * 0.6]\n    \n    data_rows = [i for i in sep_rows if any(v != L for v in grid[i])]\n    data_cols = [j for j in sep_cols if any(grid[i][j] != L for i in range(n))]\n    \n    out = []\n    for i in range(len(data_rows) - 1):\n        r1 = data_rows[i]\n        r2 = data_rows[i + 1]\n        out_row = []\n        for j in range(len(data_cols) - 1):\n            c1 = data_cols[j]\n            c2 = data_cols[j + 1]\n            vals = [grid[r1][c1], grid[r1][c2], grid[r2][c1], grid[r2][c2]]\n            if len(set(vals)) == 1:\n                val = vals[0]\n                out_row.append(val if val != L else 0)\n            else:\n                out_row.append(0)\n        out.append(out_row)\n    return out",
