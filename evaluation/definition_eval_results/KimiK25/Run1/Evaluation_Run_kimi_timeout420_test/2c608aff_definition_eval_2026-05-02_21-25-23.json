  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find background color (most frequent)\n    from collections import Counter\n    flat = [grid[r][c] for r in range(rows) for c in range(cols)]\n    background = Counter(flat).most_common(1)[0][0]\n    \n    # Find connected components of non-background cells\n    visited = set()\n    components = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != background and (r, c) not in visited:\n                # BFS to find component\n                color = grid[r][c]\n                stack = [(r, c)]\n                comp = []\n                while stack:\n                    cr, cc = stack.pop()\n                    if (cr, cc) in visited:\n                        continue\n                    if cr < 0 or cr >= rows or cc < 0 or cc >= cols:\n                        continue\n                    if grid[cr][cc] != color:\n                        continue\n                    visited.add((cr, cc))\n                    comp.append((cr, cc))\n                    for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                        stack.append((cr + dr, cc + dc))\n                components.append((color, comp))\n    \n    if not components:\n        return grid\n    \n    # The rectangle is the largest component\n    rect_color, rect_cells = max(components, key=lambda x: len(x[1]))\n    rect_set = set(rect_cells)\n    \n    # Get bounding box of rectangle\n    min_r = min(r for r, c in rect_cells)\n    max_r = max(r for r, c in rect_cells)\n    min_c = min(c for r, c in rect_cells)\n    max_c = max(c for r, c in rect_cells)\n    \n    # Find markers (non-background cells not in the main rectangle)\n    markers = []\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != background and (r, c) not in rect_set:\n                markers.append((r, c, val))\n    \n    # Create output\n    out = [row[:] for row in grid]\n    \n    # Draw lines from markers toward the rectangle\n    for r, c, color in markers:\n        # Horizontal alignment: same row as rectangle\n        if min_r <= r <= max_r:\n            if c < min_c:\n                # Draw rightward from marker to just before rectangle\n                for cc in range(c, min_c):\n                    out[r][cc] = color\n            elif c > max_c:\n                # Draw leftward from just after rectangle to marker\n                for cc in range(max_c + 1, c + 1):\n                    out[r][cc] = color\n        \n        # Vertical alignment: same column as rectangle\n        if min_c <= c <= max_c:\n            if r < min_r:\n                # Draw downward from marker to just before rectangle\n                for rr in range(r, min_r):\n                    out[rr][c] = color\n            elif r > max_r:\n                # Draw upward from just after rectangle to marker\n                for rr in range(max_r + 1, r + 1):\n                    out[rr][c] = color\n    \n    return out\n```",
  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find background color (most frequent)\n    from collections import Counter\n    flat = [grid[r][c] for r in range(rows) for c in range(cols)]\n    background = Counter(flat).most_common(1)[0][0]\n    \n    # Find connected components of non-background cells\n    visited = set()\n    components = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != background and (r, c) not in visited:\n                # BFS to find component\n                color = grid[r][c]\n                stack = [(r, c)]\n                comp = []\n                while stack:\n                    cr, cc = stack.pop()\n                    if (cr, cc) in visited:\n                        continue\n                    if cr < 0 or cr >= rows or cc < 0 or cc >= cols:\n                        continue\n                    if grid[cr][cc] != color:\n                        continue\n                    visited.add((cr, cc))\n                    comp.append((cr, cc))\n                    for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                        stack.append((cr + dr, cc + dc))\n                components.append((color, comp))\n    \n    if not components:\n        return grid\n    \n    # The rectangle is the largest component\n    rect_color, rect_cells = max(components, key=lambda x: len(x[1]))\n    rect_set = set(rect_cells)\n    \n    # Get bounding box of rectangle\n    min_r = min(r for r, c in rect_cells)\n    max_r = max(r for r, c in rect_cells)\n    min_c = min(c for r, c in rect_cells)\n    max_c = max(c for r, c in rect_cells)\n    \n    # Find markers (non-background cells not in the main rectangle)\n    markers = []\n    for r in range(rows):\n        for c in range(cols):\n            val = grid[r][c]\n            if val != background and (r, c) not in rect_set:\n                markers.append((r, c, val))\n    \n    # Create output\n    out = [row[:] for row in grid]\n    \n    # Draw lines from markers toward the rectangle\n    for r, c, color in markers:\n        # Horizontal alignment: same row as rectangle\n        if min_r <= r <= max_r:\n            if c < min_c:\n                # Draw rightward from marker to just before rectangle\n                for cc in range(c, min_c):\n                    out[r][cc] = color\n            elif c > max_c:\n                # Draw leftward from just after rectangle to marker\n                for cc in range(max_c + 1, c + 1):\n                    out[r][cc] = color\n        \n        # Vertical alignment: same column as rectangle\n        if min_c <= c <= max_c:\n            if r < min_r:\n                # Draw downward from marker to just before rectangle\n                for rr in range(r, min_r):\n                    out[rr][c] = color\n            elif r > max_r:\n                # Draw upward from just after rectangle to marker\n                for rr in range(max_r + 1, r + 1):\n                    out[rr][c] = color\n    \n    return out",
