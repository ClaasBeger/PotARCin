  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    if rows == 0 or cols == 0:\n        return [row[:] for row in grid]\n    \n    visited = [[False] * cols for _ in range(rows)]\n    result = [row[:] for row in grid]\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                queue = [(r, c)]\n                visited[r][c] = True\n                cells = [(r, c)]\n                \n                # BFS to find all connected cells of same color\n                head = 0\n                while head < len(queue):\n                    cr, cc = queue[head]\n                    head += 1\n                    for dr, dc in directions:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == color:\n                            visited[nr][nc] = True\n                            queue.append((nr, nc))\n                            cells.append((nr, nc))\n                \n                # Find bounding box\n                min_r = min(cell[0] for cell in cells)\n                max_r = max(cell[0] for cell in cells)\n                min_c = min(cell[1] for cell in cells)\n                max_c = max(cell[1] for cell in cells)\n                \n                # Check if it's a solid rectangle\n                expected_count = (max_r - min_r + 1) * (max_c - min_c + 1)\n                if len(cells) == expected_count:\n                    # Hollow out interior if there is one (height > 2 and width > 2)\n                    if max_r > min_r + 1 and max_c > min_c + 1:\n                        for rr in range(min_r + 1, max_r):\n                            for cc in range(min_c + 1, max_c):\n                                result[rr][cc] = 0\n    \n    return result",
