  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    R = len(grid)\n    C = len(grid[0])\n    best = None\n    for r1 in range(R):\n        for c1 in range(C):\n            color = grid[r1][c1]\n            if color == 0:\n                continue\n            max_c2 = c1\n            for c in range(c1 + 1, C):\n                if grid[r1][c] != color:\n                    break\n                max_c2 = c\n            for r2 in range(r1 + 1, R):\n                if grid[r2][c1] != color:\n                    break\n                for c2 in range(c1 + 1, max_c2 + 1):\n                    if grid[r2][c2] != color:\n                        break\n                    ok = True\n                    for r in range(r1, r2 + 1):\n                        if grid[r][c2] != color:\n                            ok = False\n                            break\n                    if not ok:\n                        continue\n                    if r2 - r1 > 1 and c2 - c1 > 1:\n                        for r in range(r1 + 1, r2):\n                            row_vals = grid[r]\n                            for c in range(c1 + 1, c2):\n                                if row_vals[c] == color:\n                                    ok = False\n                                    break\n                            if not ok:\n                                break\n                    if not ok:\n                        continue\n                    area = (r2 - r1 + 1) * (c2 - c1 + 1)\n                    h = r2 - r1 + 1\n                    w = c2 - c1 + 1\n                    if best is None or area > best[0] or (\n                        area == best[0] and (\n                            h > best[1] or (\n                                h == best[1] and (\n                                    w > best[2] or (\n                                        w == best[2] and (\n                                            r1 < best[3] or (\n                                                r1 == best[3] and c1 < best[4]\n                                            )\n                                        )\n                                    )\n                                )\n                            )\n                        )\n                    ):\n                        best = (area, h, w, r1, c1, r2, c2, color)\n    if best is None:\n        return grid\n    area, h, w, r1, c1, r2, c2, rect_color = best\n    interior_counts = {}\n    for r in range(r1 + 1, r2):\n        row = grid[r]\n        for c in range(c1 + 1, c2):\n            val = row[c]\n            if val != 0 and val != rect_color:\n                interior_counts[val] = interior_counts.get(val, 0) + 1\n    if interior_counts:\n        other = max(interior_counts, key=lambda k: interior_counts[k])\n    else:\n        global_counts = {}\n        for row in grid:\n            for val in row:\n                if val != 0 and val != rect_color:\n                    global_counts[val] = global_counts.get(val, 0) + 1\n        if global_counts:\n            other = max(global_counts, key=lambda k: global_counts[k])\n        else:\n            other = rect_color\n    out = [[0] * w for _ in range(h)]\n    for c in range(w):\n        out[0][c] = other\n        out[h - 1][c] = other\n    for r in range(h):\n        out[r][0] = other\n        out[r][w - 1] = other\n    for r in range(r1 + 1, r2):\n        for c in range(c1 + 1, c2):\n            if grid[r][c] == other:\n                out[r - r1][c - c1] = other\n    return out",
