  "script": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n    fours = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == 4]\n    s = set(fours)\n    n = len(fours)\n    for i in range(n):\n        r1, c1 = fours[i]\n        for j in range(i + 1, n):\n            r2, c2 = fours[j]\n            if r1 == r2 or c1 == c2:\n                continue\n            rmin, rmax = (r1, r2) if r1 < r2 else (r2, r1)\n            cmin, cmax = (c1, c2) if c1 < c2 else (c2, c1)\n            if (rmin, cmin) in s and (rmin, cmax) in s and (rmax, cmin) in s and (rmax, cmax) in s:\n                for r in range(rmin + 1, rmax):\n                    for c in range(cmin + 1, cmax):\n                        out[r][c] = 2\n    return out",
