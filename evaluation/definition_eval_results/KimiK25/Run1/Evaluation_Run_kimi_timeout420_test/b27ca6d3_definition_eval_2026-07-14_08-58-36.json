  "raw_response": "```python\nfrom collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Create a copy of the grid for the result\n    result = [row[:] for row in grid]\n    \n    # Track visited cells\n    visited = [[False] * cols for _ in range(rows)]\n    \n    # Directions for 4-connectivity (up, down, left, right)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2 and not visited[r][c]:\n                # Find connected component using BFS\n                queue = deque([(r, c)])\n                visited[r][c] = True\n                cells = [(r, c)]\n                \n                while queue:\n                    cr, cc = queue.popleft()\n                    for dr, dc in directions:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 2 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                queue.append((nr, nc))\n                                cells.append((nr, nc))\n                \n                # Only process components with 2 or more cells\n                if len(cells) >= 2:\n                    # Find bounding box\n                    min_r = min(cell[0] for cell in cells)\n                    max_r = max(cell[0] for cell in cells)\n                    min_c = min(cell[1] for cell in cells)\n                    max_c = max(cell[1] for cell in cells)\n                    \n                    # Expand by 1 in each direction\n                    r1, r2 = min_r - 1, max_r + 1\n                    c1, c2 = min_c - 1, max_c + 1\n                    \n                    # Draw 3s on the border of the expanded bounding box\n                    for rr in range(r1, r2 + 1):\n                        for cc in range(c1, c2 + 1):\n                            # Check if this cell is on the border of the expanded box\n                            if rr == r1 or rr == r2 or cc == c1 or cc == c2:\n                                # Check bounds\n                                if 0 <= rr < rows and 0 <= cc < cols:\n                                    # Only overwrite if not a 2 (preserve other 2s)\n                                    if result[rr][cc] != 2:\n                                        result[rr][cc] = 3\n    \n    return result\n```",
  "script": "from collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Create a copy of the grid for the result\n    result = [row[:] for row in grid]\n    \n    # Track visited cells\n    visited = [[False] * cols for _ in range(rows)]\n    \n    # Directions for 4-connectivity (up, down, left, right)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2 and not visited[r][c]:\n                # Find connected component using BFS\n                queue = deque([(r, c)])\n                visited[r][c] = True\n                cells = [(r, c)]\n                \n                while queue:\n                    cr, cc = queue.popleft()\n                    for dr, dc in directions:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 2 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                queue.append((nr, nc))\n                                cells.append((nr, nc))\n                \n                # Only process components with 2 or more cells\n                if len(cells) >= 2:\n                    # Find bounding box\n                    min_r = min(cell[0] for cell in cells)\n                    max_r = max(cell[0] for cell in cells)\n                    min_c = min(cell[1] for cell in cells)\n                    max_c = max(cell[1] for cell in cells)\n                    \n                    # Expand by 1 in each direction\n                    r1, r2 = min_r - 1, max_r + 1\n                    c1, c2 = min_c - 1, max_c + 1\n                    \n                    # Draw 3s on the border of the expanded bounding box\n                    for rr in range(r1, r2 + 1):\n                        for cc in range(c1, c2 + 1):\n                            # Check if this cell is on the border of the expanded box\n                            if rr == r1 or rr == r2 or cc == c1 or cc == c2:\n                                # Check bounds\n                                if 0 <= rr < rows and 0 <= cc < cols:\n                                    # Only overwrite if not a 2 (preserve other 2s)\n                                    if result[rr][cc] != 2:\n                                        result[rr][cc] = 3\n    \n    return result",
