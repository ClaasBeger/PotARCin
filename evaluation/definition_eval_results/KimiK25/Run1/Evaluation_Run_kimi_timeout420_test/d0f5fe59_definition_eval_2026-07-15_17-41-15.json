text or markdown.",
  "raw_response": "```python\nfrom collections import deque\n\ndef solve(grid):\n    if not grid or not grid[0]:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    num_clusters = 0\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8 and not visited[r][c]:\n                num_clusters += 1\n                queue = deque([(r, c)])\n                visited[r][c] = True\n                \n                while queue:\n                    cr, cc = queue.popleft()\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 8 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                queue.append((nr, nc))\n    \n    result = [[0] * num_clusters for _ in range(num_clusters)]\n    for i in range(num_clusters):\n        result[i][i] = 8\n    \n    return result\n```",
  "script": "from collections import deque\n\ndef solve(grid):\n    if not grid or not grid[0]:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    num_clusters = 0\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8 and not visited[r][c]:\n                num_clusters += 1\n                queue = deque([(r, c)])\n                visited[r][c] = True\n                \n                while queue:\n                    cr, cc = queue.popleft()\n                    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 8 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                queue.append((nr, nc))\n    \n    result = [[0] * num_clusters for _ in range(num_clusters)]\n    for i in range(num_clusters):\n        result[i][i] = 8\n    \n    return result",
