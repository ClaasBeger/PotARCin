  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    min_r = rows\n    max_r = -1\n    min_c = cols\n    max_c = -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n    if max_r == -1:\n        return []\n    sub = []\n    colors = set()\n    for r in range(min_r, max_r + 1):\n        row = []\n        for c in range(min_c, max_c + 1):\n            v = grid[r][c]\n            row.append(v)\n            if v != 0:\n                colors.add(v)\n        sub.append(row)\n    if len(colors) == 2:\n        a, b = tuple(colors)\n        mapping = {a: b, b: a}\n        for r in range(len(sub)):\n            for c in range(len(sub[0])):\n                val = sub[r][c]\n                if val in mapping:\n                    sub[r][c] = mapping[val]\n    return sub",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    min_r = rows\n    max_r = -1\n    min_c = cols\n    max_c = -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n    if max_r == -1:\n        return []\n    sub = []\n    colors = set()\n    for r in range(min_r, max_r + 1):\n        row = []\n        for c in range(min_c, max_c + 1):\n            v = grid[r][c]\n            row.append(v)\n            if v != 0:\n                colors.add(v)\n        sub.append(row)\n    if len(colors) == 2:\n        a, b = tuple(colors)\n        mapping = {a: b, b: a}\n        for r in range(len(sub)):\n            for c in range(len(sub[0])):\n                val = sub[r][c]\n                if val in mapping:\n                    sub[r][c] = mapping[val]\n    return sub",
