elf, no other text or markdown.",
  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find the line color by looking for uniform rows or columns\n    line_color = None\n    \n    # Check for uniform rows\n    for r in range(rows):\n        first = grid[r][0]\n        is_uniform = True\n        for c in range(1, cols):\n            if grid[r][c] != first:\n                is_uniform = False\n                break\n        if is_uniform:\n            line_color = first\n            break\n    \n    # If no uniform rows found, check for uniform columns\n    if line_color is None:\n        for c in range(cols):\n            first = grid[0][c]\n            is_uniform = True\n            for r in range(1, rows):\n                if grid[r][c] != first:\n                    is_uniform = False\n                    break\n            if is_uniform:\n                line_color = first\n                break\n    \n    # If no line color found, return original grid\n    if line_color is None:\n        return grid\n    \n    # Find horizontal dividers (rows entirely filled with line_color)\n    h_dividers = []\n    for r in range(rows):\n        if all(grid[r][c] == line_color for c in range(cols)):\n            h_dividers.append(r)\n    \n    # Find vertical dividers (columns entirely filled with line_color)\n    v_dividers = []\n    for c in range(cols):\n        if all(grid[r][c] == line_color for r in range(rows)):\n            v_dividers.append(c)\n    \n    # Calculate number of sections\n    h_sections = len(h_dividers) + 1\n    v_sections = len(v_dividers) + 1\n    \n    # Find background color (first color that is not the line_color)\n    bg_color = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != line_color:\n                bg_color = grid[r][c]\n                break\n        if bg_color is not None:\n            break\n    \n    # If grid consists only of line_color, use line_color as background\n    if bg_color is None:\n        bg_color = line_color\n    \n    # Create output grid filled with background color\n    result = [[bg_color for _ in range(v_sections)] for _ in range(h_sections)]\n    \n    return result\n```",
