  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    # Locate the shape made of 3s\n    shape_cells = [(r, c) for r in range(H) for c in range(W) if grid[r][c] == 3]\n    if not shape_cells:\n        # No shape to move\n        return [row[:] for row in grid]\n    # Bounding box of the shape\n    min_r = min(r for r, c in shape_cells)\n    max_r = max(r for r, c in shape_cells)\n    min_c = min(c for r, c in shape_cells)\n    max_c = max(c for r, c in shape_cells)\n    # Find the full line of 2s (either a row or a column)\n    row_2 = None\n    col_2 = None\n    for r in range(H):\n        if all(grid[r][c] == 2 for c in range(W)):\n            row_2 = r\n            break\n    if row_2 is None:\n        for c in range(W):\n            if all(grid[r][c] == 2 for r in range(H)):\n                col_2 = c\n                break\n    # Determine shift and position of the 8-line\n    delta_r = 0\n    delta_c = 0\n    line8_r = None\n    line8_c = None\n    if row_2 is not None:\n        # Horizontal line of 2s\n        if max_r < row_2:\n            # Shape is above the line, move down\n            delta_r = (row_2 - 1) - max_r\n            line8_r = (min_r + delta_r) - 1\n        else:\n            # Shape is below the line, move up\n            delta_r = (row_2 + 1) - min_r\n            line8_r = (max_r + delta_r) + 1\n    elif col_2 is not None:\n        # Vertical line of 2s\n        if max_c < col_2:\n            # Shape is left of the line, move right\n            delta_c = (col_2 - 1) - max_c\n            line8_c = (min_c + delta_c) - 1\n        else:\n            # Shape is right of the line, move left\n            delta_c = (col_2 + 1) - min_c\n            line8_c = (max_c + delta_c) + 1\n    else:\n        # No line of 2s found, return copy\n        return [row[:] for row in grid]\n    # Compute new shape positions\n    new_shape = [(r + delta_r, c + delta_c) for (r, c) in shape_cells]\n    # Build output grid\n    out = [[0] * W for _ in range(H)]\n    # Place the line of 2s\n    if row_2 is not None:\n        for c in range(W):\n            out[row_2][c] = 2\n    elif col_2 is not None:\n        for r in range(H):\n            out[r][col_2] = 2\n    # Place the moved shape (3s)\n    for r, c in new_shape:\n        if 0 <= r < H and 0 <= c < W:\n            out[r][c] = 3\n    # Place the line of 8s on the side opposite to the 2s\n    if line8_r is not None and 0 <= line8_r < H:\n        for c in range(W):\n            out[line8_r][c] = 8\n    if line8_c is not None and 0 <= line8_c < W:\n        for r in range(H):\n            out[r][line8_c] = 8\n    return out",
