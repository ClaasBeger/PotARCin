  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    \n    # Identify connected components of zeros (4-directional)\n    comp = [[-1] * W for _ in range(H)]\n    from collections import deque\n    num_comps = 0\n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == 0 and comp[i][j] == -1:\n                q = deque([(i, j)])\n                comp[i][j] = num_comps\n                while q:\n                    r, c = q.popleft()\n                    nr = r + 1\n                    if nr < H and grid[nr][c] == 0 and comp[nr][c] == -1:\n                        comp[nr][c] = num_comps\n                        q.append((nr, c))\n                    nr = r - 1\n                    if nr >= 0 and grid[nr][c] == 0 and comp[nr][c] == -1:\n                        comp[nr][c] = num_comps\n                        q.append((nr, c))\n                    nc = c + 1\n                    if nc < W and grid[r][nc] == 0 and comp[r][nc] == -1:\n                        comp[r][nc] = num_comps\n                        q.append((r, nc))\n                    nc = c - 1\n                    if nc >= 0 and grid[r][nc] == 0 and comp[r][nc] == -1:\n                        comp[r][nc] = num_comps\n                        q.append((r, nc))\n                num_comps += 1\n    \n    # Prefix sum of zero cells (1 if zero, else 0)\n    ps = [[0] * (W + 1) for _ in range(H + 1)]\n    for i in range(H):\n        row_sum = 0\n        for j in range(W):\n            row_sum += 1 if grid[i][j] == 0 else 0\n            ps[i + 1][j + 1] = ps[i][j + 1] + row_sum\n    \n    best_area = [0] * num_comps\n    best_rects = [[] for _ in range(num_comps)]\n    \n    # Scan all row pairs (height >= 2)\n    for r1 in range(H):\n        for r2 in range(r1 + 1, H):\n            h = r2 - r1 + 1\n            c = 0\n            while c < W:\n                # Check if column c is entirely zero between r1 and r2\n                total = ps[r2 + 1][c + 1] - ps[r1][c + 1] - ps[r2 + 1][c] + ps[r1][c]\n                if total == h:\n                    start = c\n                    while c < W:\n                        total = ps[r2 + 1][c + 1] - ps[r1][c + 1] - ps[r2 + 1][c] + ps[r1][c]\n                        if total != h:\n                            break\n                        c += 1\n                    end = c - 1\n                    run_len = end - start + 1\n                    if run_len >= 2:\n                        area = h * run_len\n                        cid = comp[r1][start]\n                        if area > best_area[cid]:\n                            best_area[cid] = area\n                            best_rects[cid] = [(r1, r2, start, end)]\n                        elif area == best_area[cid]:\n                            best_rects[cid].append((r1, r2, start, end))\n                else:\n                    c += 1\n    \n    # Apply the transformation\n    out = [row[:] for row in grid]\n    for cid in range(num_comps):\n        for r1, r2, c1, c2 in best_rects[cid]:\n            for r in range(r1, r2 + 1):\n                row = out[r]\n                for c in range(c1, c2 + 1):\n                    row[c] = 2\n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    \n    # Identify connected components of zeros (4-directional)\n    comp = [[-1] * W for _ in range(H)]\n    from collections import deque\n    num_comps = 0\n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == 0 and comp[i][j] == -1:\n                q = deque([(i, j)])\n                comp[i][j] = num_comps\n                while q:\n                    r, c = q.popleft()\n                    nr = r + 1\n                    if nr < H and grid[nr][c] == 0 and comp[nr][c] == -1:\n                        comp[nr][c] = num_comps\n                        q.append((nr, c))\n                    nr = r - 1\n                    if nr >= 0 and grid[nr][c] == 0 and comp[nr][c] == -1:\n                        comp[nr][c] = num_comps\n                        q.append((nr, c))\n                    nc = c + 1\n                    if nc < W and grid[r][nc] == 0 and comp[r][nc] == -1:\n                        comp[r][nc] = num_comps\n                        q.append((r, nc))\n                    nc = c - 1\n                    if nc >= 0 and grid[r][nc] == 0 and comp[r][nc] == -1:\n                        comp[r][nc] = num_comps\n                        q.append((r, nc))\n                num_comps += 1\n    \n    # Prefix sum of zero cells (1 if zero, else 0)\n    ps = [[0] * (W + 1) for _ in range(H + 1)]\n    for i in range(H):\n        row_sum = 0\n        for j in range(W):\n            row_sum += 1 if grid[i][j] == 0 else 0\n            ps[i + 1][j + 1] = ps[i][j + 1] + row_sum\n    \n    best_area = [0] * num_comps\n    best_rects = [[] for _ in range(num_comps)]\n    \n    # Scan all row pairs (height >= 2)\n    for r1 in range(H):\n        for r2 in range(r1 + 1, H):\n            h = r2 - r1 + 1\n            c = 0\n            while c < W:\n                # Check if column c is entirely zero between r1 and r2\n                total = ps[r2 + 1][c + 1] - ps[r1][c + 1] - ps[r2 + 1][c] + ps[r1][c]\n                if total == h:\n                    start = c\n                    while c < W:\n                        total = ps[r2 + 1][c + 1] - ps[r1][c + 1] - ps[r2 + 1][c] + ps[r1][c]\n                        if total != h:\n                            break\n                        c += 1\n                    end = c - 1\n                    run_len = end - start + 1\n                    if run_len >= 2:\n                        area = h * run_len\n                        cid = comp[r1][start]\n                        if area > best_area[cid]:\n                            best_area[cid] = area\n                            best_rects[cid] = [(r1, r2, start, end)]\n                        elif area == best_area[cid]:\n                            best_rects[cid].append((r1, r2, start, end))\n                else:\n                    c += 1\n    \n    # Apply the transformation\n    out = [row[:] for row in grid]\n    for cid in range(num_comps):\n        for r1, r2, c1, c2 in best_rects[cid]:\n            for r in range(r1, r2 + 1):\n                row = out[r]\n                for c in range(c1, c2 + 1):\n                    row[c] = 2\n    return out",
