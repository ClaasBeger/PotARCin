  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find the block center (3 surrounded by 2s)\n    center_r, center_c = -1, -1\n    for r in range(1, rows - 1):\n        for c in range(1, cols - 1):\n            if grid[r][c] == 3:\n                # Check all 8 neighbors are 2\n                is_block = True\n                for dr in [-1, 0, 1]:\n                    for dc in [-1, 0, 1]:\n                        if dr == 0 and dc == 0:\n                            continue\n                        if grid[r + dr][c + dc] != 2:\n                            is_block = False\n                            break\n                    if not is_block:\n                        break\n                if is_block:\n                    center_r, center_c = r, c\n                    break\n        if center_r != -1:\n            break\n    \n    if center_r == -1:\n        return grid\n    \n    # Determine direction by checking for line of 3s\n    new_r, new_c = center_r, center_c\n    \n    # Check horizontal (next 3 to the right)\n    if center_c + 2 < cols and grid[center_r][center_c + 2] == 3:\n        new_c = center_c + 2\n    # Check vertical (next 3 below)\n    elif center_r + 2 < rows and grid[center_r + 2][center_c] == 3:\n        new_r = center_r + 2\n    else:\n        # Try other direction or return as is\n        return grid\n    \n    # Create output as copy\n    output = [row[:] for row in grid]\n    \n    # Clear old block (set 8 neighbors to 0)\n    for dr in [-1, 0, 1]:\n        for dc in [-1, 0, 1]:\n            if dr == 0 and dc == 0:\n                continue\n            nr, nc = center_r + dr, center_c + dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                output[nr][nc] = 0\n    \n    # Set new block (set 8 neighbors to 2)\n    for dr in [-1, 0, 1]:\n        for dc in [-1, 0, 1]:\n            if dr == 0 and dc == 0:\n  