  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find the frame marked by 4s\n    fours = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 4:\n                fours.append((r, c))\n    \n    # Get frame bounds\n    min_r = min(p[0] for p in fours)\n    max_r = max(p[0] for p in fours)\n    min_c = min(p[1] for p in fours)\n    max_c = max(p[1] for p in fours)\n    \n    # Get left and right colors from the frame edges\n    left_color = 0\n    right_color = 0\n    for r in range(min_r + 1, max_r):\n        if grid[r][min_c] != 4 and grid[r][min_c] != 0:\n            left_color = grid[r][min_c]\n        if grid[r][max_c] != 4 and grid[r][max_c] != 0:\n            right_color = grid[r][max_c]\n    \n    # Extract templates from outside the frame\n    def extract_template(color):\n        cells = []\n        min_tc, max_tc = cols, -1\n        min_tr, max_tr = rows, -1\n        for r in range(rows):\n            for c in range(cols):\n                if grid[r][c] == color:\n                    # Check if outside frame\n                    if r < min_r or r > max_r or c < min_c or c > max_c:\n                        cells.append((r, c))\n                        min_tc = min(min_tc, c)\n                        max_tc = max(max_tc, c)\n                        min_tr = min(min_tr, r)\n                        max_tr = max(max_tr, r)\n        \n        if not cells:\n            return []\n        \n        # Create subgrid\n        h = max_tr - min_tr + 1\n        w = max_tc - min_tc + 1\n        template = [[0] * w for _ in range(h)]\n        for r, c in cells:\n            template[r - min_tr][c - min_tc] = color\n        return template\n    \n    left_template = extract_template(left_color)\n    right_template = extract_template(right_color)\n    \n    # Check if crossed (left color object is to the right of right color object)\n    # Find min col of left template and max col of right template in original grid\n    left_min_c = cols\n    right_max_c = -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == left_color and (r < min_r or r > max_r or c < min_c or c > max_c):\n                left_min_c = min(left_min_c, c)\n            if grid[r][c] == right_color and (r < min_r or r > max_r or c < min_c or c > max_c):\n                right_max_c = max(right_max_c, c)\n    \n    crossed = left_min_c > right_max_c\n    \n    # Flip if crossed\n    if crossed:\n        if left_template:\n            left_template = [row[::-1] for row in left_template]\n        if right_template:\n            right_template = [row[::-1] for row in right_template]\n    \n    # Create output grid\n    out_h = max_r - min_r + 1\n    out_w = max_c - min_c + 1\n    output = [[0] * out_w for _ in range(out_h)]\n    \n    # Set corners to 4\n    output[0][0] = 4\n    output[0][out_w - 1] = 4\n    output[out_h - 1][0] = 4\n    output[out_h - 1][out_w - 1] = 4\n    \n    # Interior dimensions\n    interior_h = out_h - 2\n    interior_w = out_w - 2\n    left_width = interior_w // 2\n    right_width = interior_w - left_width\n    \n    # Place left template (right-aligned in left half, fill gap with color)\n    if left_template:\n        th, tw = len(left_template), len(left_template[0])\n        start_r = 1\n        start_c = 1 + left_width - tw  # Right-aligned\n        \n        # Fill gap to the left with color\n        for r in range(th):\n            for c in range(start_c):\n                output[start_r + r][1 + c] = left_color\n        \n        # Place template\n        for r in range(th):\n            for c in range(tw):\n                if left_template[r][c] != 0:\n                    output[start_r + r][start_c + c] = left_template[r][c]\n    \n    # Place right template (left-aligned in right half, fill gap to right with color)\n    if right_template:\n        th, tw = len(right_template), len(right_template[0])\n        start_r = 1\n        start_c = 1 + left_width  # Left-aligned in right half\n        \n        # Place template\n        for r in range(th):\n            for c in range(tw):\n                if right_template[r][c] != 0:\n                    output[start_r + r][start_c + c] = right_template[r][c]\n        \n        # Fill gap to the right with color\n        for r in range(th):\n            for c in range(start_c + tw, out_w - 1):\n                output[start_r + r][c] = right_color\n    \n    return output\n```",
