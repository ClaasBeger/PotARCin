rior)\n    holes = []  # list of (list of absolute positions, normalized shape tuple)\n    for r1, c1, r2, c2 in containers:\n        interior_zeros = []\n        for r in range(r1 + 1, r2):\n            for c in range(c1 + 1, c2):\n                if grid[r][c] == 0:\n                    interior_zeros.append((r, c))\n        # Find connected components using BFS\n        visited = set()\n        for r, c in interior_zeros:\n            if (r, c) in visited:\n                continue\n            comp = []\n            queue = [(r, c)]\n            visited.add((r, c))\n            while queue:\n                cr, cc = queue.pop(0)\n                comp.append((cr, cc))\n                for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                    nr, nc = cr + dr, cc + dc\n                    if r1 < nr < r2 and c1 < nc < c2 and grid[nr][nc] == 0 and (nr, nc) not in visited:\n                        visited.add((nr, nc))\n                        queue.append((nr, nc))\n        # Normalize shape\n            min_r = min(p[0] for p in comp)\n            min_c = min(p[1] for p in comp)\n            shape = tuple(sorted((p[0] - min_r, p[1] - min_c) for p in comp))\n            holes.append((comp, shape))\n    \n    # Find objects outside containers (connected components of non-0, non-5)\n    object_cells = []\n    for r in range(n):\n        for c in range(m):\n            if (r, c) not in container_cells:\n                val = grid[r][c]\n                if val != 0 and val != 5:\n                    object_cells.append((r, c))\n    \n    objects = []  # list of (color, list of positions, normalized shape)\n    visited = set()\n    for r, c in object_cells:\n        if (r, c) in visited:\n            continue\n        color = grid[r][c]\n        comp = []\n        queue = [(r, c)]\n        visited.add((r, c))\n        while queue:\n            cr, cc = queue.pop(0)\n            comp.append((cr, cc))\n            for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                nr, nc = cr + dr, cc + dc\n                if 0 <= nr < n and 0 <= nc < m and (nr, nc) not in visited and (nr, nc) not in container_cells:\n                    if grid[nr][nc] == color:\n                        visited.add((nr, nc))\n                        queue.append((nr, nc))\n        # Normalize shape\n        min_r = min(p[0] for p in comp)\n        min_c = min(p[1] for p in comp)\n        shape = tuple(sorted((p[0] - min_r, p[1] - min_c) for p in comp))\n        objects.append((color, comp, shape))\n    \n    # Match objects to holes by shape and perform transformation\n    used_holes = set()\n    for color, obj_pos, obj_shape in objects:\n        for i, (hole_pos, hole_shape) in enumerate(holes):\n            if i in used_holes:\n                continue\n            if obj_shape == hole_shape:\n                # Clear object from original position\n                for r, c in obj_pos:\n                    grid[r][c] = 0\n                # Place object into hole\n                obj_min_r = min(p[0] for p in obj_pos)\n                obj_min_c = min(p[1] for p in obj_pos)\n                hole_min_r = min(p[0] for p in hole_pos)\n                hole_min_c = min(p[1] for p in hole_pos)\n                for (r_obj, c_obj) in obj_pos:\n                    dr = r_obj - obj_min_r\n                    dc = c_obj - obj_min_c\n                    r_target = hole_min_r + dr\n                    c_target = hole_min_c + dc\n                    grid[r_target][c_target] = color\n                used_holes.add(i)\n                break\n    \n    return grid",
