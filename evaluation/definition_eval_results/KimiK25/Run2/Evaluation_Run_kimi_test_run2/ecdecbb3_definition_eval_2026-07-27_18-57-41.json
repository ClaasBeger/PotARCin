  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Create output grid as a copy of input\n    output = [row[:] for row in grid]\n    \n    # Find all source cells (value 2)\n    sources = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                sources.append((r, c))\n    \n    # Four directions: up, down, left, right\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    \n    for r, c in sources:\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            steps = 0\n            \n            # Walk in the current direction\n            while 0 <= nr < rows and 0 <= nc < cols:\n                steps += 1\n                \n                # Check if we hit an 8\n                if grid[nr][nc] == 8:\n                    # Check if this 8 is part of a line perpendicular to our direction\n                    is_line = False\n                    \n                    if dr != 0:  # Moving vertically, look for horizontal line\n                        if (nc > 0 and grid[nr][nc-1] == 8) or (nc < cols-1 and grid[nr][nc+1] == 8):\n                            is_line = True\n                    else:  # Moving horizontally, look for vertical line\n                        if (nr > 0 and grid[nr-1][nc] == 8) or (nr < rows-1 and grid[nr+1][nc] == 8):\n                            is_line = True\n                    \n                    if is_line:\n                        # Draw line of 2s from source towards the line (excluding cross area)\n                        # Fill cells at distance 1 to steps-2 from source\n                        for s in range(1, steps - 1):\n                            line_r = r + dr * s\n                            line_c = c + dc * s\n                            if 0 <= line_r < rows and 0 <= line_c < cols:\n                                output[line_r][line_c] = 2\n                        \n                        # Draw 3x3 cross centered at the intersection (nr, nc)\n                        for cr in range(nr - 1, nr + 2):\n                            for cc in range(nc - 1, nc + 2):\n                                if 0 <= cr < rows and 0 <= cc < cols:\n                                    if cr == nr and cc == nc:\n                                        output[cr][cc] = 2\n                                    else:\n                                        output[cr][cc] = 8\n                        break\n                \n                nr += dr\n                nc += dc\n    \n    return output\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Create output grid as a copy of input\n    output = [row[:] for row in grid]\n    \n    # Find all source cells (value 2)\n    sources = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                sources.append((r, c))\n    \n    # Four directions: up, down, left, right\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    \n    for r, c in sources:\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            steps = 0\n            \n            # Walk in the current direction\n            while 0 <= nr < rows and 0 <= nc < cols:\n                steps += 1\n                \n                # Check if we hit an 8\n                if grid[nr][nc] == 8:\n                    # Check if this 8 is part of a line perpendicular to our direction\n                    is_line = False\n                    \n                    if dr != 0:  # Moving vertically, look for horizontal line\n                        if (nc > 0 and grid[nr][nc-1] == 8) or (nc < cols-1 and grid[nr][nc+1] == 8):\n                            is_line = True\n                    else:  # Moving horizontally, look for vertical line\n                        if (nr > 0 and grid[nr-1][nc] == 8) or (nr < rows-1 and grid[nr+1][nc] == 8):\n                            is_line = True\n                    \n                    if is_line:\n                        # Draw line of 2s from source towards the line (excluding cross area)\n                        # Fill cells at distance 1 to steps-2 from source\n                        for s in range(1, steps - 1):\n                            line_r = r + dr * s\n                            line_c = c + dc * s\n                            if 0 <= line_r < rows and 0 <= line_c < cols:\n                                output[line_r][line_c] = 2\n                        \n                        # Draw 3x3 cross centered at the intersection (nr, nc)\n                        for cr in range(nr - 1, nr + 2):\n                            for cc in range(nc - 1, nc + 2):\n                                if 0 <= cr < rows and 0 <= cc < cols:\n                                    if cr == nr and cc == nc:\n                                        output[cr][cc] = 2\n                                    else:\n                                        output[cr][cc] = 8\n                        break\n                \n                nr += dr\n                nc += dc\n    \n    return output",
