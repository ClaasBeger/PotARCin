  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    # locate the two non-zero cells\n    cells = []\n    for i in range(H):\n        for j in range(W):\n            v = grid[i][j]\n            if v != 0:\n                cells.append((i, j, v))\n    if len(cells) != 2:\n        # fallback: return empty grid of same size\n        return [[0] * W for _ in range(H)]\n    (r1, c1, v1), (r2, c2, v2) = cells\n\n    # decide orientation\n    vertical = False\n    if c1 == c2:\n        vertical = True\n    elif r1 == r2:\n        vertical = False\n    elif abs(c1 - c2) < abs(r1 - r2):\n        vertical = False\n    else:\n        vertical = True\n\n    out = [[0] * W for _ in range(H)]\n\n    if vertical:\n        # sort by row\n        if r1 < r2:\n            r_low, v_low = r1, v1\n            r_high, v_high = r2, v2\n        else:\n            r_low, v_low = r2, v2\n            r_high, v_high = r1, v1\n        d = r_high - r_low\n        step = 2 * d\n        k = 0\n        while True:\n            row1 = r_low + k * step\n            if row1 >= H:\n                break\n            for j in range(W):\n                out[row1][j] = v_low\n            row2 = r_high + k * step\n            if row2 < H:\n                for j in range(W):\n                    out[row2][j] = v_high\n            k += 1\n    else:\n        # horizontal\n        if c1 < c2:\n            c_low, v_low = c1, v1\n            c_high, v_high = c2, v2\n        else:\n            c_low, v_low = c2, v2\n            c_high, v_high = c1, v1\n        d = c_high - c_low\n        step = 2 * d\n        for i in range(H):\n            col = c_low\n            while col < W:\n                out[i][col] = v_low\n                col += step\n            col = c_high\n            while col < W:\n                out[i][col] = v_high\n                col += step\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    # locate the two non-zero cells\n    cells = []\n    for i in range(H):\n        for j in range(W):\n            v = grid[i][j]\n            if v != 0:\n                cells.append((i, j, v))\n    if len(cells) != 2:\n        # fallback: return empty grid of same size\n        return [[0] * W for _ in range(H)]\n    (r1, c1, v1), (r2, c2, v2) = cells\n\n    # decide orientation\n    vertical = False\n    if c1 == c2:\n        vertical = True\n    elif r1 == r2:\n        vertical = False\n    elif abs(c1 - c2) < abs(r1 - r2):\n        vertical = False\n    else:\n        vertical = True\n\n    out = [[0] * W for _ in range(H)]\n\n    if vertical:\n        # sort by row\n        if r1 < r2:\n            r_low, v_low = r1, v1\n            r_high, v_high = r2, v2\n        else:\n            r_low, v_low = r2, v2\n            r_high, v_high = r1, v1\n        d = r_high - r_low\n        step = 2 * d\n        k = 0\n        while True:\n            row1 = r_low + k * step\n            if row1 >= H:\n                break\n            for j in range(W):\n                out[row1][j] = v_low\n            row2 = r_high + k * step\n            if row2 < H:\n                for j in range(W):\n                    out[row2][j] = v_high\n            k += 1\n    else:\n        # horizontal\n        if c1 < c2:\n            c_low, v_low = c1, v1\n            c_high, v_high = c2, v2\n        else:\n            c_low, v_low = c2, v2\n            c_high, v_high = c1, v1\n        d = c_high - c_low\n        step = 2 * d\n        for i in range(H):\n            col = c_low\n            while col < W:\n                out[i][col] = v_low\n                col += step\n            col = c_high\n            while col < W:\n                out[i][col] = v_high\n                col += step\n    return out",
