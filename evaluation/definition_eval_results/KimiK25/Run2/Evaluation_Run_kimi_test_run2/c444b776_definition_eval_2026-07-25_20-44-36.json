  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n\n    # Find interior rows/columns that are completely filled with 4 (separators)\n    row_seps = [r for r in range(1, H - 1) if all(grid[r][c] == 4 for c in range(W))]\n    col_seps = [c for c in range(1, W - 1) if all(grid[r][c] == 4 for r in range(H))]\n\n    def make_intervals(seps, length):\n        intervals = []\n        prev = 0\n        for s in seps:\n            if prev <= s - 1:\n                intervals.append((prev, s - 1))\n            prev = s + 1\n        if prev <= length - 1:\n            intervals.append((prev, length - 1))\n        return intervals\n\n    row_intervals = make_intervals(row_seps, H)\n    col_intervals = make_intervals(col_seps, W)\n\n    # List all blocks defined by the separators\n    blocks = []\n    for r0, r1 in row_intervals:\n        for c0, c1 in col_intervals:\n            blocks.append((r0, r1, c0, c1))\n\n    # Identify the block that contains the pattern (any cell != 0 and != 4)\n    source = None\n    for block in blocks:\n        r0, r1, c0, c1 = block\n        found = False\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                if grid[r][c] not in (0, 4):\n                    found = True\n                    break\n            if found:\n                break\n        if found:\n            source = block\n            break\n\n    out = [row[:] for row in grid]\n    if source is None:\n        return out\n\n    sr0, sr1, sc0, sc1 = source\n    # Extract the source pattern\n    pattern = [grid[r][sc0:sc1 + 1] for r in range(sr0, sr1 + 1)]\n    ph = len(pattern)\n    pw = len(pattern[0]) if ph else 0\n\n    # Replicate the pattern into every other block\n    for block in blocks:\n        if block == source:\n            continue\n        r0, r1, c0, c1 = block\n        for i in range(min(ph, r1 - r0 + 1)):\n            for j in range(min(pw, c1 - c0 + 1)):\n                out[r0 + i][c0 + j] = pattern[i][j]\n\n    return out",
