             zero_cells = []\n                zero_set = set()\n                for rr in range(min_r + 1, max_r):\n                    for cc in range(min_c + 1, max_c):\n                        if grid[rr][cc] == 0:\n                            zero_cells.append((rr, cc))\n                            zero_set.add((rr, cc))\n\n                if not zero_cells:\n                    continue\n\n                visited0 = set()\n                for zr, zc in zero_cells:\n                    if (zr, zc) in visited0:\n                        continue\n                    # BFS this 4-connected zero region\n                    q = [(zr, zc)]\n                    visited0.add((zr, zc))\n                    comp = [(zr, zc)]\n                    cz_min_r = cz_max_r = zr\n                    cz_min_c = cz_max_c = zc\n\n                    while q:\n                        cr, cc = q.pop()\n                        for dr, dc in dirs:\n                            nr, nc = cr + dr, cc + dc\n                            if (nr, nc) in zero_set and (nr, nc) not in visited0:\n                                visited0.add((nr, nc))\n                                q.append((nr, nc))\n                                comp.append((nr, nc))\n                                if nr < cz_min_r:\n                                    cz_min_r = nr\n                                if nr > cz_max_r:\n                                    cz_max_r = nr\n                                if nc < cz_min_c:\n                                    cz_min_c = nc\n                                if nc > cz_max_c:\n                                    cz_max_c = nc\n\n                    h = cz_max_r - cz_min_r + 1\n                    w = cz_max_c - cz_min_c + 1\n                    if h == w and len(comp) == h * w:\n                        for rr, cc in comp:\n                            out[rr][cc] = 2\n\n    return out",
