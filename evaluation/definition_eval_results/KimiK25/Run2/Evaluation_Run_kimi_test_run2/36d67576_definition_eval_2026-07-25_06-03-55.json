  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return [row[:] for row in grid]\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    # Find horizontal lines of 4s\n    for r in range(rows):\n        c = 0\n        while c < cols:\n            if grid[r][c] == 4:\n                # Find end of horizontal line\n                start_c = c\n                while c < cols and grid[r][c] == 4:\n                    c += 1\n                end_c = c - 1\n                length = end_c - start_c + 1\n                \n                # Check if there's a 2 perpendicular to the ends\n                # Check start: up or down\n                if r > 0 and grid[r-1][start_c] == 2:\n                    # 2 is above start\n                    R = (-1, 0)  # vector to the 2\n                    apply_pattern(result, r, start_c, length, 0, 1, R, horizontal=True)\n                elif r < rows - 1 and grid[r+1][start_c] == 2:\n                    # 2 is below start\n                    R = (1, 0)\n                    apply_pattern(result, r, start_c, length, 0, 1, R, horizontal=True)\n                # Check end: up or down\n                elif r > 0 and grid[r-1][end_c] == 2:\n                    R = (-1, 0)\n                    apply_pattern(result, r, end_c, length, 0, -1, R, horizontal=True)\n                elif r < rows - 1 and grid[r+1][end_c] == 2:\n                    R = (1, 0)\n                    apply_pattern(result, r, end_c, length, 0, -1, R, horizontal=True)\n            else:\n                c += 1\n    \n    # Find vertical lines of 4s\n    for c in range(cols):\n        r = 0\n        while r < rows:\n            if grid[r][c] == 4:\n                # Find end of vertical line\n                start_r = r\n                while r < rows and grid[r][c] == 4:\n                    r += 1\n                end_r = r - 1\n                length = end_r - start_r + 1\n                \n                # Check if there's a 2 perpendicular to the ends\n                # Check start: left or right\n                if c > 0 and grid[start_r][c-1] == 2:\n                    # 2 is left of start\n                    R = (0, -1)\n                    apply_pattern(result, start_r, c, length, 1, 0, R, horizontal=False)\n                elif c < cols - 1 and grid[start_r][c+1] == 2:\n                    # 2 is right of start\n                    R = (0, 1)\n                    apply_pattern(result, start_r, c, length, 1, 0, R, horizontal=False)\n                # Check end: left or right\n                elif c > 0 and grid[end_r][c-1] == 2:\n                    R = (0, -1)\n                    apply_pattern(result, end_r, c, length, -1, 0, R, horizontal=False)\n                elif c < cols - 1 and grid[end_r][c+1] == 2:\n                    R = (0, 1)\n                    apply_pattern(result, end_r, c, length, -1, 0, R, horizontal=False)\n            else:\n                r += 1\n    \n    return result\n\ndef apply_pattern(grid, r, c, length, dr, dc, R, horizontal):\n    # R is the vector from the line cell to the 2\n    # We traverse the line from the end that has the 2, or towards it\n    # Actually, we need to iterate through all cells of the line\n    # Determine line direction\n    if horizontal:\n        line_dr, line_dc = 0, 1\n        if dc < 0:  # going backwards\n            line_dc = -1\n    else:\n        line_dr, line_dc = 1, 0\n        if dr < 0:\n            line_dr = -1\n    \n    # Generate all cells in the line starting from the reference point (r,c)\n    cells = []\n    for i in range(length):\n        cells.append((r + i * line_dr, c + i * line_dc))\n    \n    # R is perpendicular vector pointing to the side where 2 is relative to the end\n    # But we need to know which end has the 2.\n    # Actually, the caller passes the end that has the 2 as (r,c)\n    # So cells[0] is the cell with the 2 adjacent (at cells[0] + R)\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    for i, (cr, cc) in enumerate(cells):\n        # Side opposite to R\n        opp_r, opp_c = cr - R[0], cc - R[1]\n        # Side of R\n        same_r, same_c = cr + R[0], cc + R[1]\n        \n        if i % 2 == 0:\n            # Place 3 on opposite side\n            if 0 <= opp_r < rows and 0 <= opp_c < cols:\n                if grid[opp_r][opp_c] == 0:\n                    grid[opp_r][opp_c] = 3\n        else:\n            # Place 1 on same side (where R points)\n            if 0 <= same_r < rows and 0 <= same_c < cols:\n                if grid[same_r][same_c] == 0:\n                    grid[same_r][same_c] = 1\n    \n    # Ensure the 2 is preserved (it should already be there)\n    first_cell = cells[0]\n    two_r, two_c = first_cell[0] + R[0], first_cell[1] + R[1]\n    if 0 <= two_r < rows and 0 <= two_c < cols:\n        grid[two_r][two_c] = 2\n```",
