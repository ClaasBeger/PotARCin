  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    out = [row[:] for row in grid]\n    top = grid[0][1]\n    bottom = grid[H - 1][1]\n    left = grid[1][0]\n    right = grid[1][W - 1]\n    cells = []\n    for r in range(1, H - 1):\n        for c in range(1, W - 1):\n            v = grid[r][c]\n            if v != 0:\n                cells.append((r, c, v))\n                out[r][c] = 0\n    for r, c, v in cells:\n        if v == top:\n            out[1][c] = v\n        elif v == bottom:\n            out[H - 2][c] = v\n        elif v == left:\n            out[r][1] = v\n        elif v == right:\n            out[r][W - 2] = v\n    return out",
