  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Identify horizontal lines (full rows of same non-zero value)\n    row_lines = {}  # row_index -> value\n    for r in range(rows):\n        val = grid[r][0]\n        if val != 0 and all(cell == val for cell in grid[r]):\n            row_lines[r] = val\n    \n    # Identify vertical lines (full columns of same non-zero value)\n    col_lines = {}  # col_index -> value\n    for c in range(cols):\n        val = grid[0][c]\n        if val != 0:\n            is_uniform = True\n            for r in range(rows):\n                if grid[r][c] != val:\n                    is_uniform = False\n                    break\n            if is_uniform:\n                col_lines[c] = val\n    \n    # Initialize output grid with zeros\n    out = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    # Copy lines to output\n    for r, val in row_lines.items():\n        for c in range(cols):\n            out[r][c] = val\n    for c, val in col_lines.items():\n        for r in range(rows):\n            out[r][c] = val\n    \n    # Process scattered cells (non-zero cells not part of a line)\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v == 0:\n                continue\n            \n            # Skip if part of a line\n            if r in row_lines and row_lines[r] == v:\n                continue\n            if c in col_lines and col_lines[c] == v:\n                continue\n            \n            # Find closest line with the same value\n            min_dist = float('inf')\n            best_target = None\n            best_type = None  # 'h' or 'v'\n            \n            # Check horizontal lines\n            for line_r, line_val in row_lines.items():\n                if line_val == v:\n                    dist = abs(r - line_r)\n                    if dist < min_dist:\n                        min_dist = dist\n                        best_target = line_r\n                        best_type = 'h'\n            \n            # Check vertical lines\n            for line_c, line_val in col_lines.items():\n                if line_val == v:\n                    dist = abs(c - line_c)\n                    if dist < min_dist:\n                        min_dist = dist\n                        best_target = line_c\n                        best_type = 'v'\n            \n            # If found a line, move cell to be adjacent to it\n            if best_target is not None:\n                if best_type == 'h':\n                    line_r = best_target\n                    if r < line_r:\n                        new_r = line_r - 1\n                    else:\n                        new_r = line_r + 1\n                    new_c = c\n                    if 0 <= new_r < rows:\n                        out[new_r][new_c] = v\n                else:  # vertical line\n                    line_c = best_target\n                    if c < line_c:\n                        new_c = line_c - 1\n                    else:\n                        new_c = line_c + 1\n                    new_r = r\n                    if 0 <= new_c < cols:\n                        out[new_r][new_c] = v\n    \n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Identify horizontal lines (full rows of same non-zero value)\n    row_lines = {}  # row_index -> value\n    for r in range(rows):\n        val = grid[r][0]\n        if val != 0 and all(cell == val for cell in grid[r]):\n            row_lines[r] = val\n    \n    # Identify vertical lines (full columns of same non-zero value)\n    col_lines = {}  # col_index -> value\n    for c in range(cols):\n        val = grid[0][c]\n        if val != 0:\n            is_uniform = True\n            for r in range(rows):\n                if grid[r][c] != val:\n                    is_uniform = False\n                    break\n            if is_uniform:\n                col_lines[c] = val\n    \n    # Initialize output grid with zeros\n    out = [[0 for _ in range(cols)] for _ in range(rows)]\n    \n    # Copy lines to output\n    for r, val in row_lines.items():\n        for c in range(cols):\n            out[r][c] = val\n    for c, val in col_lines.items():\n        for r in range(rows):\n            out[r][c] = val\n    \n    # Process scattered cells (non-zero cells not part of a line)\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v == 0:\n                continue\n            \n            # Skip if part of a line\n            if r in row_lines and row_lines[r] == v:\n                continue\n            if c in col_lines and col_lines[c] == v:\n                continue\n            \n            # Find closest line with the same value\n            min_dist = float('inf')\n            best_target = None\n            best_type = None  # 'h' or 'v'\n            \n            # Check horizontal lines\n            for line_r, line_val in row_lines.items():\n                if line_val == v:\n                    dist = abs(r - line_r)\n                    if dist < min_dist:\n                        min_dist = dist\n                        best_target = line_r\n                        best_type = 'h'\n            \n            # Check vertical lines\n            for line_c, line_val in col_lines.items():\n                if line_val == v:\n                    dist = abs(c - line_c)\n                    if dist < min_dist:\n                        min_dist = dist\n                        best_target = line_c\n                        best_type = 'v'\n            \n            # If found a line, move cell to be adjacent to it\n            if best_target is not None:\n                if best_type == 'h':\n                    line_r = best_target\n                    if r < line_r:\n                        new_r = line_r - 1\n                    else:\n                        new_r = line_r + 1\n                    new_c = c\n                    if 0 <= new_r < rows:\n                        out[new_r][new_c] = v\n                else:  # vertical line\n                    line_c = best_target\n                    if c < line_c:\n                        new_c = line_c - 1\n                    else:\n                        new_c = line_c + 1\n                    new_r = r\n                    if 0 <= new_c < cols:\n                        out[new_r][new_c] = v\n    \n    return out",
