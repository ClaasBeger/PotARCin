  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    from collections import defaultdict\n    col_rows = defaultdict(list)\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 2:\n                col_rows[c].append(r)\n    \n    lines = []\n    for c, rows in col_rows.items():\n        rows.sort()\n        start = rows[0]\n        prev = rows[0]\n        for i in range(1, len(rows)):\n            if rows[i] == prev + 1:\n                prev = rows[i]\n            else:\n                lines.append((c, start, prev))\n                start = rows[i]\n                prev = rows[i]\n        lines.append((c, start, prev))\n    \n    if len(lines) < 2:\n        return out\n    \n    if len(lines) > 2:\n        lines.sort(key=lambda x: x[2] - x[1] + 1, reverse=True)\n        lines = lines[:2]\n    \n    line1, line2 = lines\n    \n    eights = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n    \n    for r, c in eights:\n        if line1[1] <= r <= line1[2]:\n            near, far = line1, line2\n        elif line2[1] <= r <= line2[2]:\n            near, far = line2, line1\n        else:\n            continue\n        \n        c_near, r0_near, _ = near\n        c_far, r0_far, _ = far\n        \n        idx = r - r0_near\n        r_far = r0_far + idx\n        \n        out[r][c] = 4\n        lo, hi = sorted((c, c_near))\n        for k in range(lo + 1, hi):\n            out[r][k] = 8\n        \n        if 0 <= r_far < H:\n            for k in range(W):\n                if k != c_far:\n                    out[r_far][k] = 8\n            out[r_far][c_far] = 2\n    \n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    from collections import defaultdict\n    col_rows = defaultdict(list)\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 2:\n                col_rows[c].append(r)\n    \n    lines = []\n    for c, rows in col_rows.items():\n        rows.sort()\n        start = rows[0]\n        prev = rows[0]\n        for i in range(1, len(rows)):\n            if rows[i] == prev + 1:\n                prev = rows[i]\n            else:\n                lines.append((c, start, prev))\n                start = rows[i]\n                prev = rows[i]\n        lines.append((c, start, prev))\n    \n    if len(lines) < 2:\n        return out\n    \n    if len(lines) > 2:\n        lines.sort(key=lambda x: x[2] - x[1] + 1, reverse=True)\n        lines = lines[:2]\n    \n    line1, line2 = lines\n    \n    eights = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n    \n    for r, c in eights:\n        if line1[1] <= r <= line1[2]:\n            near, far = line1, line2\n        elif line2[1] <= r <= line2[2]:\n            near, far = line2, line1\n        else:\n            continue\n        \n        c_near, r0_near, _ = near\n        c_far, r0_far, _ = far\n        \n        idx = r - r0_near\n        r_far = r0_far + idx\n        \n        out[r][c] = 4\n        lo, hi = sorted((c, c_near))\n        for k in range(lo + 1, hi):\n            out[r][k] = 8\n        \n        if 0 <= r_far < H:\n            for k in range(W):\n                if k != c_far:\n                    out[r_far][k] = 8\n            out[r_far][c_far] = 2\n    \n    return out",
