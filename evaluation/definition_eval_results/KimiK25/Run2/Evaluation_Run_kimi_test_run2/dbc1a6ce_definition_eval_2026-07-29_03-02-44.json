  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    ones = set()\n    row_ones = [[] for _ in range(h)]\n    col_ones = [[] for _ in range(w)]\n    for r in range(h):\n        row = grid[r]\n        for c in range(w):\n            if row[c] == 1:\n                ones.add((r, c))\n                row_ones[r].append(c)\n                col_ones[c].append(r)\n    out = [row[:] for row in grid]\n    for r in range(h):\n        if len(row_ones[r]) >= 2:\n            lo = min(row_ones[r])\n            hi = max(row_ones[r])\n            for c in range(lo + 1, hi):\n                if (r, c) not in ones:\n                    out[r][c] = 8\n    for c in range(w):\n        if len(col_ones[c]) >= 2:\n            lo = min(col_ones[c])\n            hi = max(col_ones[c])\n            for r in range(lo + 1, hi):\n                if (r, c) not in ones:\n                    out[r][c] = 8\n    return out",
