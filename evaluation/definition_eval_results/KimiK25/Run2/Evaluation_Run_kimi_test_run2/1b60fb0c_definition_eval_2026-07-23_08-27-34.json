ram - c\n        elif t_type == 'h':\n            r2, c2 = t_param - r, c\n        else:\n            r2, c2 = H - 1 - r, W - 1 - c\n        if 0 <= r2 < H and 0 <= c2 < W and out[r2][c2] == 0:\n            out[r2][c2] = 2\n\n    return out",
