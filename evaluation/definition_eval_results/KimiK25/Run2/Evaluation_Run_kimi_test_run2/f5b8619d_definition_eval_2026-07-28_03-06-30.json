  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    col_has_nonzero = [False] * w\n    for j in range(w):\n        for i in range(h):\n            if grid[i][j] != 0:\n                col_has_nonzero[j] = True\n                break\n    pattern = []\n    for i in range(h):\n        row = []\n        for j in range(w):\n            v = grid[i][j]\n            if v != 0:\n                row.append(v)\n            elif col_has_nonzero[j]:\n                row.append(8)\n            else:\n                row.append(0)\n        pattern.append(row)\n    out = []\n    for _ in range(2):\n        for i in range(h):\n            out.append(pattern[i] + pattern[i])\n    return out",
