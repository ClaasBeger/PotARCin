_h - 1][out_w - 1] = 4\n\n    # fill the left and right borders with the respective colors\n    for i in range(1, out_h - 1):\n        out[i][0] = left_color\n        out[i][out_w - 1] = right_color\n\n    # overlay the left shape (top\u2011aligned, starting at column 1)\n    subL = shape_L[4]\n    for i in range(hL):\n        for j in range(wL):\n            out[1 + i][1 + j] = subL[i][j]\n\n    # overlay the right shape (top\u2011aligned, placed immediately to the right of the left shape)\n    subR = shape_R[4]\n    start_c = 1 + wL\n    for i in range(hR):\n        for j in range(wR):\n            out[1 + i][start_c + j] = subR[i][j]\n\n    return out",
