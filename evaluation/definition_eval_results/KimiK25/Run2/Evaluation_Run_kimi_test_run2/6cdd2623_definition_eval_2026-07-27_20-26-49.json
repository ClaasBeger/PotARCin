  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    \n    from collections import defaultdict\n    positions = defaultdict(list)\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                positions[v].append((r, c))\n    \n    out = [[0] * w for _ in range(h)]\n    \n    for color, coords in positions.items():\n        if len(coords) != 4:\n            continue\n        for i in range(4):\n            r1, c1 = coords[i]\n            for j in range(i + 1, 4):\n                r2, c2 = coords[j]\n                if r1 == r2:\n                    if (c1 == 0 and c2 == w - 1) or (c1 == w - 1 and c2 == 0):\n                        for cc in range(w):\n                            out[r1][cc] = color\n                elif c1 == c2:\n                    if (r1 == 0 and r2 == h - 1) or (r1 == h - 1 and r2 == 0):\n                        for rr in range(h):\n                            out[rr][c1] = color\n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    \n    from collections import defaultdict\n    positions = defaultdict(list)\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                positions[v].append((r, c))\n    \n    out = [[0] * w for _ in range(h)]\n    \n    for color, coords in positions.items():\n        if len(coords) != 4:\n            continue\n        for i in range(4):\n            r1, c1 = coords[i]\n            for j in range(i + 1, 4):\n                r2, c2 = coords[j]\n                if r1 == r2:\n                    if (c1 == 0 and c2 == w - 1) or (c1 == w - 1 and c2 == 0):\n                        for cc in range(w):\n                            out[r1][cc] = color\n                elif c1 == c2:\n                    if (r1 == 0 and r2 == h - 1) or (r1 == h - 1 and r2 == 0):\n                        for rr in range(h):\n                            out[rr][c1] = color\n    return out",
