  "raw_response": "def solve(grid):\n    if not grid:\n        return grid\n    H = len(grid)\n    W = len(grid[0])\n    markers = [(r, c) for r in range(H) for c in range(W) if grid[r][c] == 2]\n    if not markers:\n        return grid\n    rows = {r for r, c in markers}\n    cols = {c for r, c in markers}\n    transposed = False\n    if len(rows) == 1:\n        grid = [[grid[r][c] for r in range(H)] for c in range(W)]\n        H, W = W, H\n        transposed = True\n        markers = [(r, c) for r in range(H) for c in range(W) if grid[r][c] == 2]\n        cols = {c for r, c in markers}\n    marker_col = next(iter(cols))\n    marker_rows = sorted({r for r, c in markers})\n    marker_rows_set = set(marker_rows)\n    base_row = None\n    for r in range(H):\n        if any(v == 8 for v in grid[r]):\n            base_row = r\n            break\n    if base_row is None:\n        return grid\n    pattern_cols = [c for c in range(W) if grid[base_row][c] == 8]\n    if not pattern_cols:\n        return grid\n    if min(pattern_cols) > marker_col:\n        delta = 1\n    else:\n        delta = -1\n    out = [[0] * W for _ in range(H)]\n    if base_row <= marker_rows[0]:\n        shift = 0\n        for r in range(base_row, H):\n            if r in marker_rows_set:\n                shift += 1\n            for c in pattern_cols:\n                nc = c + shift * delta\n                if 0 <= nc < W:\n                    out[r][nc] = 8\n            if grid[r][marker_col] == 2:\n                out[r][marker_col] = 2\n    else:\n        shift = 0\n        for r in range(base_row, -1, -1):\n            if r in marker_rows_set:\n                shift += 1\n            for c in pattern_cols:\n                nc = c + shift * delta\n                if 0 <= nc < W:\n                    out[r][nc] = 8\n            if grid[r][marker_col] == 2:\n                out[r][marker_col] = 2\n    if transposed:\n        out = [[out[r][c] for r in range(H)] for c in range(W)]\n    return out",
