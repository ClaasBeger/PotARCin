  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    min_r = rows\n    max_r = -1\n    min_c = cols\n    max_c = -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n    # If there are no non-zero cells, return a copy\n    if max_r == -1:\n        return [row[:] for row in grid]\n    sum_r = min_r + max_r\n    sum_c = min_c + max_c\n    out = [row[:] for row in grid]\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0:\n                r2 = sum_r - r\n                c2 = sum_c - c\n                out[r][c] = v\n                out[r2][c] = v\n                out[r][c2] = v\n                out[r2][c2] = v\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    min_r = rows\n    max_r = -1\n    min_c = cols\n    max_c = -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n    # If there are no non-zero cells, return a copy\n    if max_r == -1:\n        return [row[:] for row in grid]\n    sum_r = min_r + max_r\n    sum_c = min_c + max_c\n    out = [row[:] for row in grid]\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0:\n                r2 = sum_r - r\n                c2 = sum_c - c\n                out[r][c] = v\n                out[r2][c] = v\n                out[r][c2] = v\n                out[r2][c2] = v\n    return out",
