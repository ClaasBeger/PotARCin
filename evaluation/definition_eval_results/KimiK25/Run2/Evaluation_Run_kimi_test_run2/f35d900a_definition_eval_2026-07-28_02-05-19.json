  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find all non-zero cells\n    points = []\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                points.append((r, c, v))\n\n    # Map rows and columns to their members\n    row_map = {}\n    col_map = {}\n    for r, c, v in points:\n        row_map.setdefault(r, []).append((c, v))\n        col_map.setdefault(c, []).append((r, v))\n\n    # Determine border color for each point using its row partner\n    border = {}\n    for r, c, v in points:\n        partner = None\n        for cc, cv in row_map[r]:\n            if cc != c:\n                partner = cv\n                break\n        if partner is None:\n            for rr, cv in col_map[c]:\n                if rr != r:\n                    partner = cv\n                    break\n        border[(r, c)] = partner\n\n    # Start with empty grid\n    out = [[0] * w for _ in range(h)]\n\n    # Draw 3x3 blocks\n    for r, c, v in points:\n        bc = border[(r, c)]\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w:\n                    if dr == 0 and dc == 0:\n                        out[nr][nc] = v\n                    else:\n                        out[nr][nc] = bc\n\n    # Distinct rows and columns of the four points\n    distinct_rows = sorted({r for r, _, _ in points})\n    distinct_cols = sorted({c for _, c, _ in points})\n\n    if len(distinct_rows) == 2 and len(distinct_cols) == 2:\n        r1, r2 = distinct_rows\n        c1, c2 = distinct_cols\n\n        # Horizontal connectors on the middle rows of the blocks\n        for rr in (r1, r2):\n            left = c1 + 2\n            right = c2 - 2\n            if left <= right:\n                mid = (c1 + c2) / 2.0\n                cc = left\n                while cc <= mid:\n                    if 0 <= cc < w:\n                        out[rr][cc] = 5\n                    cc += 2\n                cc = right\n                while cc >= mid:\n                    if 0 <= cc < w:\n                        out[rr][cc] = 5\n                    cc -= 2\n\n        # Vertical connectors on the middle columns of the blocks\n        for cc in (c1, c2):\n            top = r1 + 2\n            bottom = r2 - 2\n            if top <= bottom:\n                mid = (r1 + r2) / 2.0\n                rr = top\n                while rr <= mid:\n                    if 0 <= rr < h:\n                        out[rr][cc] = 5\n                    rr += 2\n                rr = bottom\n                while rr >= mid:\n                    if 0 <= rr < h:\n                        out[rr][cc] = 5\n                    rr -= 2\n\n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find all non-zero cells\n    points = []\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                points.append((r, c, v))\n\n    # Map rows and columns to their members\n    row_map = {}\n    col_map = {}\n    for r, c, v in points:\n        row_map.setdefault(r, []).append((c, v))\n        col_map.setdefault(c, []).append((r, v))\n\n    # Determine border color for each point using its row partner\n    border = {}\n    for r, c, v in points:\n        partner = None\n        for cc, cv in row_map[r]:\n            if cc != c:\n                partner = cv\n                break\n        if partner is None:\n            for rr, cv in col_map[c]:\n                if rr != r:\n                    partner = cv\n                    break\n        border[(r, c)] = partner\n\n    # Start with empty grid\n    out = [[0] * w for _ in range(h)]\n\n    # Draw 3x3 blocks\n    for r, c, v in points:\n        bc = border[(r, c)]\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w:\n                    if dr == 0 and dc == 0:\n                        out[nr][nc] = v\n                    else:\n                        out[nr][nc] = bc\n\n    # Distinct rows and columns of the four points\n    distinct_rows = sorted({r for r, _, _ in points})\n    distinct_cols = sorted({c for _, c, _ in points})\n\n    if len(distinct_rows) == 2 and len(distinct_cols) == 2:\n        r1, r2 = distinct_rows\n        c1, c2 = distinct_cols\n\n        # Horizontal connectors on the middle rows of the blocks\n        for rr in (r1, r2):\n            left = c1 + 2\n            right = c2 - 2\n            if left <= right:\n                mid = (c1 + c2) / 2.0\n                cc = left\n                while cc <= mid:\n                    if 0 <= cc < w:\n                        out[rr][cc] = 5\n                    cc += 2\n                cc = right\n                while cc >= mid:\n                    if 0 <= cc < w:\n                        out[rr][cc] = 5\n                    cc -= 2\n\n        # Vertical connectors on the middle columns of the blocks\n        for cc in (c1, c2):\n            top = r1 + 2\n            bottom = r2 - 2\n            if top <= bottom:\n                mid = (r1 + r2) / 2.0\n                rr = top\n                while rr <= mid:\n                    if 0 <= rr < h:\n                        out[rr][cc] = 5\n                    rr += 2\n                rr = bottom\n                while rr >= mid:\n                    if 0 <= rr < h:\n                        out[rr][cc] = 5\n                    rr -= 2\n\n    return out",
