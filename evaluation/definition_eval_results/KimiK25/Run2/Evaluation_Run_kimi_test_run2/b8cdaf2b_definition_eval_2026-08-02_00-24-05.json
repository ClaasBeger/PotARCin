rs, key=colors.get)\n    \n    # Find leftmost and rightmost positions of fill_color in bottom structure\n    fill_positions = [(r, c) for r, c, v in non_zeros if v == fill_color]\n    if not fill_positions:\n        return result\n    \n    min_col = min(c for r, c in fill_positions)\n    max_col = max(c for r, c in fill_positions)\n    \n    # Find the row where fill starts (lowest row with fill)\n    min_row = min(r for r, c in fill_positions)\n    \n    # Project diagonally upward from the leftmost and rightmost fill positions\n    # From leftmost position, go up-left\n    r, c = min_row - 1, min_col - 1\n    while r >= 0 and c >= 0:\n        result[r][c] = fill_color\n        r -= 1\n        c -= 1\n    \n    # From rightmost position, go up-right  \n    r, c = min_row - 1, max_col + 1\n    while r >= 0 and c < cols:\n        result[r][c] = fill_color\n        r -= 1\n        c += 1\n    \n    return result",
