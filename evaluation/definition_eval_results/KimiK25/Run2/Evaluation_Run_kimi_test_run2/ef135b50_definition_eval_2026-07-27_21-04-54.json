or j in range(i + 1, k):\n            ci = comps[i]\n            cj = comps[j]\n            r1 = max(ci['min_r'], cj['min_r'])\n            r2 = min(ci['max_r'], cj['max_r'])\n            if r1 > r2:\n                continue\n            if ci['max_c'] < cj['min_c']:\n                left, right = ci, cj\n            elif cj['max_c'] < ci['min_c']:\n                left, right = cj, ci\n            else:\n                continue\n            c1 = left['max_c'] + 1\n            c2 = right['min_c'] - 1\n            if c1 > c2:\n                continue\n            blocked = False\n            for rr in range(r1, r2 + 1):\n                for cc in range(c1, c2 + 1):\n                    cid = comp_grid[rr][cc]\n                    if cid != -1 and cid != i and cid != j:\n                        blocked = True\n                        break\n                if blocked:\n                    break\n            if not blocked:\n                for rr in range(r1, r2 + 1):\n                    for cc in range(c1, c2 + 1):\n                        out[rr][cc] = 9\n    return out",
