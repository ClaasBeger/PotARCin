  "raw_response": "from collections import deque\n\ndef solve(grid):\n    if not grid:\n        return []\n    n = len(grid)\n    m = len(grid[0])\n    out = [row[:] for row in grid]\n    comp_grid = [[-1] * m for _ in range(n)]\n    comps = []\n    for r in range(n):\n        for c in range(m):\n            if grid[r][c] == 2 and comp_grid[r][c] == -1:\n                idx = len(comps)\n                q = deque()\n                q.append((r, c))\n                comp_grid[r][c] = idx\n                min_r = max_r = r\n                min_c = max_c = c\n                while q:\n                    cr, cc = q.popleft()\n                    if cr < min_r:\n                        min_r = cr\n                    if cr > max_r:\n                        max_r = cr\n                    if cc < min_c:\n                        min_c = cc\n                    if cc > max_c:\n                        max_c = cc\n                    nr = cr + 1\n                    if nr < n and grid[nr][cc] == 2 and comp_grid[nr][cc] == -1:\n                        comp_grid[nr][cc] = idx\n                        q.append((nr, cc))\n                    nr = cr - 1\n                    if nr >= 0 and grid[nr][cc] == 2 and comp_grid[nr][cc] == -1:\n                        comp_grid[nr][cc] = idx\n                        q.append((nr, cc))\n                    nc = cc + 1\n                    if nc < m and grid[cr][nc] == 2 and comp_grid[cr][nc] == -1:\n                        comp_grid[cr][nc] = idx\n                        q.append((cr, nc))\n                    nc = cc - 1\n                    if nc >= 0 and grid[cr][nc] == 2 and comp_grid[cr][nc] == -1:\n                        comp_grid[cr][nc] = idx\n                        q.append((cr, nc))\n                comps.append({\n                    'min_r': min_r,\n                    'max_r': max_r,\n                    'min_c': min_c,\n                    'max_c': max_c,\n                })\n    k = len(comps)\n    for i in range(k):\n        for j in range(i + 1, k):\n            ci = comps[i]\n            cj = comps[j]\n            r1 = max(ci['min_r'], cj['min_r'])\n            r2 = min(ci['max_r'], cj['max_r'])\n            if r1 > r2:\n                continue\n            if ci['max_c'] < cj['min_c']:\n                left, right = ci, cj\n            elif cj['max_c'] < ci['min_c']:\n                left, right = cj, ci\n            else:\n                continue\n            c1 = left['max_c'] + 1\n            c2 = right['min_c'] - 1\n            if c1 > c2:\n                continue\n            blocked = False\n            for rr in range(r1, r2 + 1):\n                for cc in range(c1, c2 + 1):\n                    cid = comp_grid[rr][cc]\n                    if cid != -1 and cid != i and cid != j:\n                        blocked = True\n                        break\n                if blocked:\n                    break\n            if not blocked:\n                for rr in range(r1, r2 + 1):\n                    for cc in range(c1, c2 + 1):\n                        out[rr][cc] = 9\n    return out",
