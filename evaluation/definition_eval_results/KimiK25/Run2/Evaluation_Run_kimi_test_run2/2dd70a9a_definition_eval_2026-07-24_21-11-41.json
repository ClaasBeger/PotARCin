  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0]) if H > 0 else 0\n\n    # locate source (3) and target (2) cells\n    src = [(r, c) for r in range(H) for c in range(W) if grid[r][c] == 3]\n    tgt = [(r, c) for r in range(H) for c in range(W) if grid[r][c] == 2]\n\n    if not src or not tgt:\n        return grid\n\n    def try_path(r0, c0, axis, d):\n        \"\"\"\n        axis: 0 = primary movement along rows (vertical), 1 = along cols (horizontal)\n        d: direction sign (+1 or -1)\n        Returns new grid if path reaches adjacency to target, else None.\n        \"\"\"\n        g = [row[:] for row in grid]\n        r, c = r0, c0\n\n        # Phase 1: move along primary axis until blocked\n        while True:\n            nr = r + (d if axis == 0 else 0)\n            nc = c + (d if axis == 1 else 0)\n            if not (0 <= nr < H and 0 <= nc < W):\n                break\n            if g[nr][nc] != 0:\n                break\n            r, c = nr, nc\n            g[r][c] = 3\n\n        # Phase 2: move along perpendicular axis towards target coordinate\n        if axis == 0:\n            # need to reach target column\n            tc = tgt[0][1]\n            step = 1 if tc > c else -1\n            while True:\n                nr = r\n                nc = c + step\n                if not (0 <= nc < W):\n                    break\n                if g[nr][nc] != 0:\n                    break\n                c = nc\n                g[r][c] = 3\n                if c == tc:\n                    break\n        else:\n            # need to reach target row\n            tr = tgt[0][0]\n            step = 1 if tr > r else -1\n            while True:\n                nr = r + step\n                nc = c\n                if not (0 <= nr < H):\n                    break\n                if g[nr][nc] != 0:\n                    break\n                r = nr\n                g[r][c] = 3\n                if r == tr:\n                    break\n\n        # Phase 3: move along primary axis towards target coordinate\n        if axis == 0:\n            tr = tgt[0][0]\n            step = 1 if tr > r else -1\n            while True:\n                nr = r + step\n                nc = c\n                if not (0 <= nr < H):\n                    break\n                if g[nr][nc] != 0:\n                    break\n                r = nr\n                g[r][c] = 3\n        else:\n            tc = tgt[0][1]\n            step = 1 if tc > c else -1\n            while True:\n                nr = r\n                nc = c + step\n                if not (0 <= nc < W):\n                    break\n                if g[nr][nc] != 0:\n                    break\n                c = nc\n                g[r][c] = 3\n\n        # Check if final cell is adjacent to any target cell\n        for tr, tc in tgt:\n            if abs(r - tr) + abs(c - tc) == 1:\n                return g\n        return None\n\n    # Build candidate starting points based on source shape\n    src_rows = [r for r, _ in src]\n    src_cols = [c for _, c in src]\n    candidates = []\n\n    # vertical line (same column)\n    if len(set(src_cols)) == 1:\n        col = src_cols[0]\n        # up\n        candidates.append((min(src_rows), col, 0, -1))\n        # down\n        candidates.append((max(src_rows), col, 0, 1))\n    # horizontal line (same row)\n    elif len(set(src_rows)) == 1:\n        row = src_rows[0]\n        # left\n        candidates.append((row, min(src_cols), 1, -1))\n        # right\n        candidates.append((row, max(src_cols), 1, 1))\n    else:\n        # single cell or other: try all four primary directions\n        r, c = src[0]\n        candidates.append((r, c, 0, -1))\n        candidates.append((r, c, 0, 1))\n        candidates.append((r, c, 1, -1))\n        candidates.append((r, c, 1, 1))\n\n    for r0, c0, axis, d in candidates:\n        res = try_path(r0, c0, axis, d)\n        if res is not None:\n            return res\n\n    # Fallback: return original if nothing worked\n    return grid\n```",
