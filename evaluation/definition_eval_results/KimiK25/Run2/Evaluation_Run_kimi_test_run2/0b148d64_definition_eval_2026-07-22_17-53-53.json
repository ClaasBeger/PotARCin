  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    H = len(grid)\n    W = len(grid[0])\n    # locate the cross of zeros that separates the four quadrants\n    zero_rows = [i for i in range(H) if all(v == 0 for v in grid[i])]\n    zero_cols = [j for j in range(W) if all(grid[i][j] == 0 for i in range(H))]\n    # if we cannot find zero separators, fall back to frequency+bounding box\n    if not zero_rows or not zero_cols:\n        from collections import Counter\n        cnt = Counter(v for row in grid for v in row if v != 0)\n        if not cnt:\n            return grid\n        unique_val = min(cnt, key=cnt.get)\n        min_r = min(i for i in range(H) for j in range(W) if grid[i][j] == unique_val)\n        max_r = max(i for i in range(H) for j in range(W) if grid[i][j] == unique_val)\n        min_c = min(j for j in range(W) for i in range(H) if grid[i][j] == unique_val)\n        max_c = max(j for j in range(W) for i in range(H) if grid[i][j] == unique_val)\n        return [row[min_c:max_c+1] for row in grid[min_r:max_r+1]]\n    # the separator bands are the contiguous zero rows/cols (interior)\n    r_start = min(zero_rows)\n    r_end = max(zero_rows)\n    c_start = min(zero_cols)\n    c_end = max(zero_cols)\n    # split into four sub\u2011grids\n    top = grid[:r_start]\n    bottom = grid[r_end+1:]\n    left_slice = slice(0, c_start)\n    right_slice = slice(c_end+1, W)\n    TL = [row[left_slice] for row in top]\n    TR = [row[right_slice] for row in top]\n    BL = [row[left_slice] for row in bottom]\n    BR = [row[right_slice] for row in bottom]\n    # helper to collect non\u2011zero colors in a sub\u2011grid\n    def colors(g):\n        s = set()\n        for row in g:\n            for v in row:\n                if v != 0:\n                    s.add(v)\n        return s\n    cTL, cTR, cBL, cBR = colors(TL), colors(TR), colors(BL), colors(BR)\n    all_sets = [cTL, cTR, cBL, cBR]\n    subgrids = [TL, TR, BL, BR]\n    # find the quadrant that contains a colour not present in the other three\n    for i, s in enumerate(all_sets):\n        others = set()\n        for j in range(4):\n            if j != i:\n                others.update(all_sets[j])\n        if s - others:          # there is at least one colour unique to this quadrant\n            return subgrids[i]\n    # fallback (should not be needed for valid inputs)\n    from collections import Counter\n    cnt = Counter(v for row in grid for v in row if v != 0)\n    unique_val = min(cnt, key=cnt.get)\n    min_r = min(i for i in range(H) for j in range(W) if grid[i][j] == unique_val)\n    max_r = max(i for i in range(H) for j in range(W) if grid[i][j] == unique_val)\n    min_c = min(j for j in range(W) for i in range(H) if grid[i][j] == unique_val)\n    max_c = max(j for j in range(W) for i in range(H) if grid[i][j] == unique_val)\n    return [row[min_c:max_c+1] for row in grid[min_r:max_r+1]]",
