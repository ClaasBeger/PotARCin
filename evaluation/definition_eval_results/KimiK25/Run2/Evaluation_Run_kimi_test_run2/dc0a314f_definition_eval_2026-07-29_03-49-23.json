  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n else 0\n    size = 5\n    r = c = -1\n    # Locate the 5x5 uniform block\n    for i in range(n - size + 1):\n        for j in range(m - size + 1):\n            val = grid[i][j]\n            uniform = True\n            for di in range(size):\n                row = grid[i + di]\n                for dj in range(size):\n                    if row[j + dj] != val:\n                        uniform = False\n                        break\n                if not uniform:\n                    break\n            if uniform:\n                r, c = i, j\n                break\n        if r != -1:\n            break\n    # Build the output by taking the opposite region rotated 180 degrees\n    out = [[0] * size for _ in range(size)]\n    for i in range(size):\n        gi = n - 1 - r - i\n        for j in range(size):\n            gj = m - 1 - c - j\n            out[i][j] = grid[gi][gj]\n    return out",
