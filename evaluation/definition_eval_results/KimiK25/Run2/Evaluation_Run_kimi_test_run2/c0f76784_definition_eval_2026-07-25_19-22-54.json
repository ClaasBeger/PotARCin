  "raw_response": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    rows = len(grid)\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    fills = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                component = []\n                min_r, max_r = r, r\n                min_c, max_c = c, c\n                while stack:\n                    cr, cc = stack.pop()\n                    component.append((cr, cc))\n                    if cr < min_r: min_r = cr\n                    if cr > max_r: max_r = cr\n                    if cc < min_c: min_c = cc\n                    if cc > max_c: max_c = cc\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == 5:\n                            visited[nr][nc] = True\n                            stack.append((nr, nc))\n                \n                h = max_r - min_r + 1\n                w = max_c - min_c + 1\n                if h < 3 or w < 3:\n                    continue\n                \n                perimeter = 2 * (h + w) - 4\n                if len(component) != perimeter:\n                    continue\n                \n                valid = True\n                for (cr, cc) in component:\n                    if not (cr == min_r or cr == max_r or cc == min_c or cc == max_c):\n                        valid = False\n                        break\n                if not valid:\n                    continue\n                \n                for ir in range(min_r + 1, max_r):\n                    for ic in range(min_c + 1, max_c):\n                        if grid[ir][ic] != 0:\n                            valid = False\n                            break\n                    if not valid:\n                        break\n                if not valid:\n                    continue\n                \n                value = max(h - 2, w - 2) + 5\n                fills.append((min_r, max_r, min_c, max_c, value))\n    \n    result = [row[:] for row in grid]\n    for min_r, max_r, min_c, max_c, value in fills:\n        for r in range(min_r + 1, max_r):\n            for c in range(min_c + 1, max_c):\n                result[r][c] = value\n    return result",
