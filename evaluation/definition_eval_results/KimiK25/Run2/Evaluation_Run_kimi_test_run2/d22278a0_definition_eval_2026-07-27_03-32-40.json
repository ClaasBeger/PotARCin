  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    sources = []\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                sources.append((r, c, v))\n    out = [[0] * w for _ in range(h)]\n    for r in range(h):\n        for c in range(w):\n            best_dist = None\n            best_src = None\n            tie = False\n            for sr, sc, val in sources:\n                d = abs(r - sr) + abs(c - sc)\n                if best_dist is None or d < best_dist:\n                    best_dist = d\n                    best_src = (sr, sc, val)\n                    tie = False\n                elif d == best_dist:\n                    tie = True\n            if tie or best_src is None:\n                continue\n            sr, sc, val = best_src\n            dr = abs(r - sr)\n            dc = abs(c - sc)\n            if dr % 2 == 0:\n                if dc <= dr or dc % 2 == 0:\n                    out[r][c] = val\n            else:\n                if dc % 2 == 0 and dc >= dr:\n                    out[r][c] = val\n    return out\n```",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    sources = []\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                sources.append((r, c, v))\n    out = [[0] * w for _ in range(h)]\n    for r in range(h):\n        for c in range(w):\n            best_dist = None\n            best_src = None\n            tie = False\n            for sr, sc, val in sources:\n                d = abs(r - sr) + abs(c - sc)\n                if best_dist is None or d < best_dist:\n                    best_dist = d\n                    best_src = (sr, sc, val)\n                    tie = False\n                elif d == best_dist:\n                    tie = True\n            if tie or best_src is None:\n                continue\n            sr, sc, val = best_src\n            dr = abs(r - sr)\n            dc = abs(c - sc)\n            if dr % 2 == 0:\n                if dc <= dr or dc % 2 == 0:\n                    out[r][c] = val\n            else:\n                if dc % 2 == 0 and dc >= dr:\n                    out[r][c] = val\n    return out",
