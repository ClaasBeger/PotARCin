  "raw_response": "```python\ndef solve(grid):\n    if not grid:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0]) if rows > 0 else 0\n    \n    # Find all positions of value 8\n    positions = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                positions.append((r, c))\n    \n    # Create a copy of the grid for output\n    output = [row[:] for row in grid]\n    \n    # Group positions by row and by column\n    from collections import defaultdict\n    row_groups = defaultdict(list)\n    col_groups = defaultdict(list)\n    \n    for r, c in positions:\n        row_groups[r].append(c)\n        col_groups[c].append(r)\n    \n    # Fill horizontal lines (same row, between pairs of 8s)\n    for r, columns in row_groups.items():\n        if len(columns) >= 2:\n            columns.sort()\n            for i in range(len(columns) - 1):\n                c1 = columns[i]\n                c2 = columns[i + 1]\n                for c in range(c1 + 1, c2):\n                    output[r][c] = 3\n    \n    # Fill vertical lines (same column, between pairs of 8s)\n    for c, row_list in col_groups.items():\n        if len(row_list) >= 2:\n            row_list.sort()\n            for i in range(len(row_list) - 1):\n                r1 = row_list[i]\n                r2 = row_list[i + 1]\n                for r in range(r1 + 1, r2):\n                    output[r][c] = 3\n    \n    return output\n```",
  "script": "def solve(grid):\n    if not grid:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0]) if rows > 0 else 0\n    \n    # Find all positions of value 8\n    positions = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                positions.append((r, c))\n    \n    # Create a copy of the grid for output\n    output = [row[:] for row in grid]\n    \n    # Group positions by row and by column\n    from collections import defaultdict\n    row_groups = defaultdict(list)\n    col_groups = defaultdict(list)\n    \n    for r, c in positions:\n        row_groups[r].append(c)\n        col_groups[c].append(r)\n    \n    # Fill horizontal lines (same row, between pairs of 8s)\n    for r, columns in row_groups.items():\n        if len(columns) >= 2:\n            columns.sort()\n            for i in range(len(columns) - 1):\n                c1 = columns[i]\n                c2 = columns[i + 1]\n                for c in range(c1 + 1, c2):\n                    output[r][c] = 3\n    \n    # Fill vertical lines (same column, between pairs of 8s)\n    for c, row_list in col_groups.items():\n        if len(row_list) >= 2:\n            row_list.sort()\n            for i in range(len(row_list) - 1):\n                r1 = row_list[i]\n                r2 = row_list[i + 1]\n                for r in range(r1 + 1, r2):\n                    output[r][c] = 3\n    \n    return output",
