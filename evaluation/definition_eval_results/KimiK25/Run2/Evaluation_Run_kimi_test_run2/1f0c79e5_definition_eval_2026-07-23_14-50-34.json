  "raw_response": "```python\ndef solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n > 0 else 0\n    \n    # Find non-zero cells\n    cells = []\n    for i in range(n):\n        for j in range(m):\n            if grid[i][j] != 0:\n                cells.append((i, j))\n    \n    if not cells:\n        return [[0] * m for _ in range(n)]\n    \n    # Determine bounding box of the pattern\n    min_r = min(r for r, c in cells)\n    max_r = max(r for r, c in cells)\n    min_c = min(c for r, c in cells)\n    max_c = max(c for r, c in cells)\n    \n    # Collect positions with color != 2 and identify the main color C\n    P = []\n    C = None\n    for r in range(min_r, max_r + 1):\n        for c in range(min_c, max_c + 1):\n            val = grid[r][c]\n            if val != 0 and val != 2:\n                P.append((r, c))\n                C = val\n    \n    # Initialize output\n    out = [[0] * m for _ in range(n)]\n    \n    if len(P) == 1:\n        # Two diagonal bands through the point\n        r0, c0 = P[0]\n        s0 = r0 + c0\n        d0 = r0 - c0\n        for r in range(n):\n            for c in range(m):\n                if abs((r + c) - s0) <= 1 or abs((r - c) - d0) <= 1:\n                    out[r][c] = C\n    elif len(P) == 2:\n        r1, c1 = P[0]\n        r2, c2 = P[1]\n        d1 = r1 - c1\n        d2 = r2 - c2\n        if d1 == d2:\n            # On same main diagonal, vary along anti-diagonal (r+c)\n            s1 = r1 + c1\n            s2 = r2 + c2\n            smin, smax = min(s1, s2), max(s1, s2)\n            for r in range(n):\n                for c in range(m):\n                    if smin <= r + c <= smax:\n                        out[r][c] = C\n        else:\n            # On same anti-diagonal or adjacent, vary along main diagonal (r-c)\n            # Check if r+c is constant\n            s1 = r1 + c1\n            s2 = r2 + c2\n            if s1 == s2:\n                dmin, dmax = min(d1, d2), max(d1, d2)\n                for r in range(n):\n                    for c in range(m):\n                        if dmin <= r - c <= dmax:\n                            out[r][c] = C\n            else:\n                # Fallback, shouldn't happen in valid 2x2\n                smin, smax = min(s1, s2), max(s1, s2)\n                for r in range(n):\n                    for c in range(m):\n                        if smin <= r + c <= smax:\n                            out[r][c] = C\n    elif len(P) == 3:\n        # Find the position of the 2 (the missing corner)\n        pos2 = None\n        for r in [min_r, max_r]:\n            for c in [min_c, max_c]:\n                if grid[r][c] == 2:\n                    pos2 = (r, c)\n                    break\n            if pos2:\n                break\n        \n        if pos2:\n            r2, c2 = pos2\n            center_r = (min_r + max_r) / 2.0\n            center_c = (min_c + max_c) / 2.0\n            dr = r2 - center_r\n            dc = c2 - center_c\n            \n            if dr * dc < 0:\n                # Anti-diagonal direction: use r+c\n                f0 = r2 + c2\n                for r in range(n):\n                    for c in range(m):\n                        if abs((r + c) - f0) <= 1:\n                            out[r][c] = C\n            else:\n                # Main diagonal direction: use r-c\n                f0 = r2 - c2\n                for r in range(n):\n                    for c in range(m):\n                        if abs((r - c) - f0) <= 1:\n                            out[r][c] = C\n    return out\n```",
