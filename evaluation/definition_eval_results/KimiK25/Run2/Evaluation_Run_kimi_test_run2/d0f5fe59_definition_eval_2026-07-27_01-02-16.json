text or markdown.",
  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    visited = [[False] * w for _ in range(h)]\n    count = 0\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                count += 1\n                stack = [(r, c)]\n                visited[r][c] = True\n                while stack:\n                    cr, cc = stack.pop()\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < h and 0 <= nc < w:\n                            if not visited[nr][nc] and grid[nr][nc] != 0:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n    return [[8 if i == j else 0 for j in range(count)] for i in range(count)]",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    visited = [[False] * w for _ in range(h)]\n    count = 0\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                count += 1\n                stack = [(r, c)]\n                visited[r][c] = True\n                while stack:\n                    cr, cc = stack.pop()\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < h and 0 <= nc < w:\n                            if not visited[nr][nc] and grid[nr][nc] != 0:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n    return [[8 if i == j else 0 for j in range(count)] for i in range(count)]",
