t, bottom-right quadrants in output\n    \n    # Based on examples, we need to map 4 shapes to 4 quadrants of 4x4 output\n    # The output is 4x4, divided into four 2x2 quadrants\n    \n    # Sort by vertical then horizontal to get TL, TR, BL, BR order\n    shape_info.sort(key=lambda s: (s['center_r'], s['center_c']))\n    \n    # Create 4x4 output grid\n    output = [[0] * 4 for _ in range(4)]\n    \n    # Map each shape to its quadrant\n    # Quadrant order: top-left, top-right, bottom-left, bottom-right\n    # But need to check which shapes go where based on examples\n    \n    # Looking at examples, shapes are arranged by their original position\n    # Top-left shapes -> top-left quadrant, etc.\n    \n    # Actually, let's look more carefully at the pattern\n    # In example 1: colors are 8(TR), 2(TL), 1(BR), 3(BL) in input\n    # Output: 8 8 2 2 / 8 0 0 2 / 3 0 0 1 / 3 3 1 1\n    \n    # The mapping seems to be:\n    # Top-most shapes go to top, bottom-most to bottom\n    # Left-most to left, right-most to right\n    \n    # Let's categorize by center position\n    mid_r = sum(s['center_r'] for s in shape_info) / 4\n    mid_c = sum(s['center_c'] for s in shape_info) / 4\n    \n    # Find which shape goes to which quadrant\n    for shape in shape_info:\n        is_top = shape['center_r'] < mid_r\n        is_left = shape['center_c'] < mid_c\n        \n        # Determine output quadrant position\n        if is_top and is_left:\n            # Top-left quadrant (rows 0-1, cols 0-1)\n            qr, qc = 0, 0\n        elif is_top and not is_left:\n            # Top-right quadrant (rows 0-1, cols 2-3)\n            qr, qc = 0, 2\n        elif not is_top and is_left:\n            # Bottom-left quadrant (rows 2-3, cols 0-1)\n            qr, qc = 2, 0\n        else:\n            # Bottom-right quadrant (rows 2-3, cols 2-3)\n            qr, qc = 2, 2\n        \n        color = shape['color']\n        \n        # Place the L-shape in the quadrant\n        # The L-shape fills 3 cells in a 2x2 pattern\n        # We need to preserve the orientation\n        \n        # Map the shape's pattern to the quadrant\n        if shape['tl']:\n            output[qr][qc] = color\n        if shape['tr']:\n            output[qr][qc+1] = color\n        if shape['bl']:\n            output[qr+1][qc] = color\n        if shape['br']:\n            output[qr+1][qc+1] = color\n    \n    return output",
