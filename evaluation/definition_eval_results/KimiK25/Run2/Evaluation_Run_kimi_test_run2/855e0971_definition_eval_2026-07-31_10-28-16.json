  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return [row[:] for row in grid] if grid else []\n    \n    n_rows = len(grid)\n    n_cols = len(grid[0])\n    \n    # Determine if bands are horizontal (uniform rows) or vertical (uniform columns)\n    is_horizontal = True\n    for row in grid:\n        non_zero = {x for x in row if x != 0}\n        if len(non_zero) > 1:\n            is_horizontal = False\n            break\n    \n    result = [row[:] for row in grid]\n    \n    if is_horizontal:\n        # Process horizontal bands: extend 0s vertically within each band\n        r = 0\n        while r < n_rows:\n            # Determine the color of the current band\n            row = grid[r]\n            non_zero_vals = [x for x in row if x != 0]\n            band_color = non_zero_vals[0] if non_zero_vals else 0\n            \n            # Find the extent of this band (consecutive rows with same color)\n            start_r = r\n            r += 1\n            while r < n_rows:\n                curr_row = grid[r]\n                curr_non_zero = [x for x in curr_row if x != 0]\n                curr_color = curr_non_zero[0] if curr_non_zero else 0\n                if curr_color != band_color:\n                    break\n                r += 1\n            end_r = r - 1\n            \n            # Find all columns that contain at least one 0 in this band\n            zero_cols = set()\n            for i in range(start_r, end_r + 1):\n                for j in range(n_cols):\n                    if grid[i][j] == 0:\n                        zero_cols.add(j)\n            \n            # Fill those columns with 0s for the entire band\n            for i in range(start_r, end_r + 1):\n                for j in zero_cols:\n                    result[i][j] = 0\n    else:\n        # Process vertical bands: extend 0s horizontally within each band\n        c = 0\n        while c < n_cols:\n            # Determine the color of the current band