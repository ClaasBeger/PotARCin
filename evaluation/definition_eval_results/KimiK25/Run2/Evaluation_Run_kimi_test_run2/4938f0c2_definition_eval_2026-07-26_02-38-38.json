  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    twos = []\n    threes = []\n    for r in range(h):\n        row = grid[r]\n        for c in range(w):\n            v = row[c]\n            if v == 2:\n                twos.append((r, c))\n            elif v == 3:\n                threes.append((r, c))\n    if not threes:\n        return [row[:] for row in grid]\n    r_min = min(r for r, _ in threes)\n    r_max = max(r for r, _ in threes)\n    c_min = min(c for _, c in threes)\n    c_max = max(c for _, c in threes)\n    sum_r = r_min + r_max\n    sum_c = c_min + c_max\n    out = [[0] * w for _ in range(h)]\n    for r, c in twos:\n        for nr, nc in ((r, c), (r, sum_c - c), (sum_r - r, c), (sum_r - r, sum_c - c)):\n            if 0 <= nr < h and 0 <= nc < w:\n                out[nr][nc] = 2\n    for r, c in threes:\n        out[r][c] = 3\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    h = len(grid)\n    w = len(grid[0])\n    twos = []\n    threes = []\n    for r in range(h):\n        row = grid[r]\n        for c in range(w):\n            v = row[c]\n            if v == 2:\n                twos.append((r, c))\n            elif v == 3:\n                threes.append((r, c))\n    if not threes:\n        return [row[:] for row in grid]\n    r_min = min(r for r, _ in threes)\n    r_max = max(r for r, _ in threes)\n    c_min = min(c for _, c in threes)\n    c_max = max(c for _, c in threes)\n    sum_r = r_min + r_max\n    sum_c = c_min + c_max\n    out = [[0] * w for _ in range(h)]\n    for r, c in twos:\n        for nr, nc in ((r, c), (r, sum_c - c), (sum_r - r, c), (sum_r - r, sum_c - c)):\n            if 0 <= nr < h and 0 <= nc < w:\n                out[nr][nc] = 2\n    for r, c in threes:\n        out[r][c] = 3\n    return out",
