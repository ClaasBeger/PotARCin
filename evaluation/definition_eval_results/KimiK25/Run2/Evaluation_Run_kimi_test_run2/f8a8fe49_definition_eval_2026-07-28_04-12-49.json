  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    # Find bounding box of 2s\n    min_r = rows\n    max_r = -1\n    min_c = cols\n    max_c = -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n    # If no 2s found, return copy unchanged\n    if max_r == -1:\n        return [row[:] for row in grid]\n    height = max_r - min_r\n    width = max_c - min_c\n    out = [row[:] for row in grid]\n    # Process 5s inside the bounding box\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5:\n                # Strictly interior to the rectangle defined by 2s\n                if min_r < r < max_r and min_c < c < max_c:\n                    # Remove original 5\n                    out[r][c] = 0\n                    if height > width:\n                        # Reflect across top or bottom border\n                        # Use integer comparison to avoid floats\n                        if 2 * r <= min_r + max_r:\n                            new_r = 2 * min_r - r\n                        else:\n                            new_r = 2 * max_r - r\n                        new_c = c\n                    else:\n                        # Reflect across left or right border\n                        if 2 * c <= min_c + max_c:\n                            new_c = 2 * min_c - c\n                        else:\n                            new_c = 2 * max_c - c\n                        new_r = r\n                    # Place the 5 in the new location if within bounds\n                    if 0 <= new_r < rows and 0 <= new_c < cols:\n                        out[new_r][new_c] = 5\n    return out",
