  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                yield nr, nc\n\n    def get_components(match_fn):\n        visited = [[False] * cols for _ in range(rows)]\n        comps = []\n        for r in range(rows):\n            for c in range(cols):\n                if not visited[r][c] and match_fn(grid[r][c]):\n                    stack = [(r, c)]\n                    visited[r][c] = True\n                    comp = []\n                    while stack:\n                        cr, cc = stack.pop()\n                        comp.append((cr, cc))\n                        for nr, nc in neighbors(cr, cc):\n                            if not visited[nr][nc] and match_fn(grid[nr][nc]):\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n                    comps.append(comp)\n        return comps\n\n    # Template is the connected component made of non-zero, non-8 colors.\n    template_components = get_components(lambda v: v != 0 and v != 8)\n    if not template_components:\n        return [row[:] for row in grid]\n\n    template = max(template_components, key=len)\n\n    min_r = min(r for r, c in template)\n    min_c = min(c for r, c in template)\n\n    template_shape = set()\n    template_values = {}\n    for r, c in template:\n        rel = (r - min_r, c - min_c)\n        template_shape.add(rel)\n        template_values[rel] = grid[r][c]\n\n    out = [[0] * cols for _ in range(rows)]\n\n    # Find all 8-components and replace those whose shape matches the template.\n    eight_components = get_components(lambda v: v == 8)\n    for comp in eight_components:\n        comp_min_r = min(r for r, c in comp)\n        comp_min_c = min(c for r, c in comp)\n        comp_shape = {(r - comp_min_r, c - comp_min_c) for r, c in comp}\n\n        if comp_shape == template_shape:\n            for rel, value in template_values.items():\n                rr = comp_min_r + rel[0]\n                cc = comp_min_c + rel[1]\n                out[rr][cc] = value\n\n    return out",
