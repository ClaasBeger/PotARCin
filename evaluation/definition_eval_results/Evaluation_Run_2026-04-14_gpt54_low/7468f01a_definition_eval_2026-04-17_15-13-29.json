  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    nonzero_positions = [\n        (r, c)\n        for r in range(rows)\n        for c in range(cols)\n        if grid[r][c] != 0\n    ]\n\n    if not nonzero_positions:\n        return []\n\n    min_r = min(r for r, _ in nonzero_positions)\n    max_r = max(r for r, _ in nonzero_positions)\n    min_c = min(c for _, c in nonzero_positions)\n    max_c = max(c for _, c in nonzero_positions)\n\n    cropped = [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n    return [row[::-1] for row in cropped]",
