  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find background color as the most frequent non-zero color.\n    counts = {}\n    for row in grid:\n        for v in row:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n    bg = max(counts, key=counts.get)\n\n    zeros = []\n    seed = None\n    seed_color = None\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 0:\n                zeros.append((r, c))\n            elif v != bg:\n                seed = (r, c)\n                seed_color = v\n\n    if not zeros or seed is None:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, c in zeros)\n    max_r = max(r for r, c in zeros)\n    min_c = min(c for r, c in zeros)\n    max_c = max(c for r, c in zeros)\n\n    sr, sc = seed\n    center_r = (min_r + max_r) / 2.0\n    center_c = (min_c + max_c) / 2.0\n\n    dr_sign = -1 if sr < center_r else 1\n    dc_sign = -1 if sc < center_c else 1\n\n    # Choose the zero-cell at the extreme opposite corner of the motion.\n    if dr_sign == 1:\n        target_r = min(r for r, c in zeros)\n    else:\n        target_r = max(r for r, c in zeros)\n\n    candidates = [(r, c) for (r, c) in zeros if r == target_r]\n\n    if dc_sign == 1:\n        source = min(candidates, key=lambda x: x[1])  # leftmost\n    else:\n        source = max(candidates, key=lambda x: x[1])  # rightmost\n\n    vr = sr - source[0]\n    vc = sc - source[1]\n\n    out = [row[:] for row in grid]\n\n    k = 1\n    while True:\n        placed_any = False\n        for r, c in zeros:\n            nr = r + k * vr\n            nc = c + k * vc\n            if 0 <= nr < h and 0 <= nc < w:\n                if out[nr][nc] == bg:\n                    out[nr][nc] = seed_color\n                placed_any = True\n        if not placed_any:\n            break\n        k += 1\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find background color as the most frequent non-zero color.\n    counts = {}\n    for row in grid:\n        for v in row:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n    bg = max(counts, key=counts.get)\n\n    zeros = []\n    seed = None\n    seed_color = None\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 0:\n                zeros.append((r, c))\n            elif v != bg:\n                seed = (r, c)\n                seed_color = v\n\n    if not zeros or seed is None:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, c in zeros)\n    max_r = max(r for r, c in zeros)\n    min_c = min(c for r, c in zeros)\n    max_c = max(c for r, c in zeros)\n\n    sr, sc = seed\n    center_r = (min_r + max_r) / 2.0\n    center_c = (min_c + max_c) / 2.0\n\n    dr_sign = -1 if sr < center_r else 1\n    dc_sign = -1 if sc < center_c else 1\n\n    # Choose the zero-cell at the extreme opposite corner of the motion.\n    if dr_sign == 1:\n        target_r = min(r for r, c in zeros)\n    else:\n        target_r = max(r for r, c in zeros)\n\n    candidates = [(r, c) for (r, c) in zeros if r == target_r]\n\n    if dc_sign == 1:\n        source = min(candidates, key=lambda x: x[1])  # leftmost\n    else:\n        source = max(candidates, key=lambda x: x[1])  # rightmost\n\n    vr = sr - source[0]\n    vc = sc - source[1]\n\n    out = [row[:] for row in grid]\n\n    k = 1\n    while True:\n        placed_any = False\n        for r, c in zeros:\n            nr = r + k * vr\n            nc = c + k * vc\n            if 0 <= nr < h and 0 <= nc < w:\n                if out[nr][nc] == bg:\n                    out[nr][nc] = seed_color\n                placed_any = True\n        if not placed_any:\n            break\n        k += 1\n\n    return out",
