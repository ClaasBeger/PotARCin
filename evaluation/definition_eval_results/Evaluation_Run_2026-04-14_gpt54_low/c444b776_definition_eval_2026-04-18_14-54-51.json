  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    full4_rows = [r for r in range(h) if all(v == 4 for v in grid[r])]\n    full4_cols = [c for c in range(w) if all(grid[r][c] == 4 for r in range(h))]\n\n    row_bounds = [-1] + full4_rows + [h]\n    col_bounds = [-1] + full4_cols + [w]\n\n    row_segments = []\n    for i in range(len(row_bounds) - 1):\n        a, b = row_bounds[i] + 1, row_bounds[i + 1]\n        if a < b:\n            row_segments.append((a, b))\n\n    col_segments = []\n    for i in range(len(col_bounds) - 1):\n        a, b = col_bounds[i] + 1, col_bounds[i + 1]\n        if a < b:\n            col_segments.append((a, b))\n\n    blocks = []\n    for rs, re in row_segments:\n        for cs, ce in col_segments:\n            content = [row[cs:ce] for row in grid[rs:re]]\n            score = sum(1 for r in content for v in r if v not in (0, 4))\n            blocks.append((score, rs, re, cs, ce, content))\n\n    source = max(blocks, key=lambda x: x[0])\n    _, _, _, _, _, source_content = source\n\n    out = [row[:] for row in grid]\n\n    for _, rs, re, cs, ce, _ in blocks:\n        bh = re - rs\n        bw = ce - cs\n        for i in range(bh):\n            for j in range(bw):\n                out[rs + i][cs + j] = source_content[i][j]\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    full4_rows = [r for r in range(h) if all(v == 4 for v in grid[r])]\n    full4_cols = [c for c in range(w) if all(grid[r][c] == 4 for r in range(h))]\n\n    row_bounds = [-1] + full4_rows + [h]\n    col_bounds = [-1] + full4_cols + [w]\n\n    row_segments = []\n    for i in range(len(row_bounds) - 1):\n        a, b = row_bounds[i] + 1, row_bounds[i + 1]\n        if a < b:\n            row_segments.append((a, b))\n\n    col_segments = []\n    for i in range(len(col_bounds) - 1):\n        a, b = col_bounds[i] + 1, col_bounds[i + 1]\n        if a < b:\n            col_segments.append((a, b))\n\n    blocks = []\n    for rs, re in row_segments:\n        for cs, ce in col_segments:\n            content = [row[cs:ce] for row in grid[rs:re]]\n            score = sum(1 for r in content for v in r if v not in (0, 4))\n            blocks.append((score, rs, re, cs, ce, content))\n\n    source = max(blocks, key=lambda x: x[0])\n    _, _, _, _, _, source_content = source\n\n    out = [row[:] for row in grid]\n\n    for _, rs, re, cs, ce, _ in blocks:\n        bh = re - rs\n        bw = ce - cs\n        for i in range(bh):\n            for j in range(bw):\n                out[rs + i][cs + j] = source_content[i][j]\n\n    return out",
