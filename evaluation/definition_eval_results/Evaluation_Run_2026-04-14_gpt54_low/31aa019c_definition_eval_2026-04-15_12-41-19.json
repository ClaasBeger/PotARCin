  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    counts = {}\n    pos = {}\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n                pos[v] = (r, c)\n\n    target_color = None\n    target_pos = None\n    for color, cnt in counts.items():\n        if cnt == 1:\n            target_color = color\n            target_pos = pos[color]\n            break\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    if target_color is None:\n        return out\n\n    r, c = target_pos\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h and 0 <= cc < w:\n                out[rr][cc] = 2\n\n    out[r][c] = target_color\n    return out",
