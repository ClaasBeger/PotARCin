max(0, max_r - 2), min(min_r, h - 3) + 1):\n            if placed:\n                break\n            for c0 in range(max(0, max_c - 2), min(min_c, w - 3) + 1):\n                # Window must contain only 5 or this color (no 0, no other colors)\n                ok = True\n                mask = []\n                for i in range(3):\n                    row = []\n                    for j in range(3):\n                        v = grid[r0 + i][c0 + j]\n                        if v != 5 and v != color:\n                            ok = False\n                            break\n                        row.append(1 if v == color else 0)\n                    if not ok:\n                        break\n                    mask.append(tuple(row))\n                if not ok:\n                    continue\n                mask = tuple(mask)\n                if mask in templates:\n                    br, bc = templates[mask]\n                    for i in range(3):\n                        for j in range(3):\n                            out[br * 3 + i][bc * 3 + j] = color if mask[i][j] else 5\n                    placed = True\n                    break\n\n    return out",
