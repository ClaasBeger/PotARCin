  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find connected components of non-zero, non-8 cells\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and grid[r][c] != 8 and not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n                comps.append((color, cells))\n\n    # Separate horizontal and vertical line components\n    horizontals = []\n    verticals = []\n    for color, cells in comps:\n        rows = {r for r, c in cells}\n        cols = {c for r, c in cells}\n        if len(rows) == 1:\n            horizontals.append((min(rows), color, cells))\n        elif len(cols) == 1:\n            verticals.append((min(cols), color, cells))\n\n    # Identify frame sides\n    top_row, top_color, top_cells = min(horizontals, key=lambda x: x[0])\n    bottom_row, bottom_color, bottom_cells = max(horizontals, key=lambda x: x[0])\n    left_col, left_color, left_cells = min(verticals, key=lambda x: x[0])\n    right_col, right_color, right_cells = max(verticals, key=lambda x: x[0])\n\n    top_cols = [c for r, c in top_cells]\n    left_rows = [r for r, c in left_cells]\n\n    inner_w = len(top_cols)\n    inner_h = len(left_rows)\n\n    # Find bounding box of 8s\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n    min_r = min(r for r, c in eights)\n    max_r = max(r for r, c in eights)\n    min_c = min(c for r, c in eights)\n    max_c = max(c for r, c in eights)\n\n    # Extract/fit 8 pattern to interior size\n    pattern = [[0] * inner_w for _ in range(inner_h)]\n    for r in range(inner_h):\n        for c in range(inner_w):\n            sr = min_r + r\n            sc = min_c + c\n            if min_r <= sr <= max_r and min_c <= sc <= max_c and 0 <= sr < h and 0 <= sc < w:\n                pattern[r][c] = 8 if grid[sr][sc] == 8 else 0\n\n    # Recolor boundary 8s that touch exactly one side of the interior\n    for r in range(inner_h):\n        for c in range(inner_w):\n            if pattern[r][c] != 8:\n                continue\n            sides = []\n            if r == 0:\n                sides.append(top_color)\n            if r == inner_h - 1:\n                sides.append(bottom_color)\n            if c == 0:\n                sides.append(left_color)\n            if c == inner_w - 1:\n                sides.append(right_color)\n            if len(sides) == 1:\n                pattern[r][c] = sides[0]\n\n    # Build output with border frame\n    out_h = inner_h + 2\n    out_w = inner_w + 2\n    out = [[0] * out_w for _ in range(out_h)]\n\n    for c in range(1, out_w - 1):\n        out[0][c] = top_color\n        out[out_h - 1][c] = bottom_color\n    for r in range(1, out_h - 1):\n        out[r][0] = left_color\n        out[r][out_w - 1] = right_color\n\n    for r in range(inner_h):\n        for c in range(inner_w):\n            out[r + 1][c + 1] = pattern[r][c]\n\n    return out",
