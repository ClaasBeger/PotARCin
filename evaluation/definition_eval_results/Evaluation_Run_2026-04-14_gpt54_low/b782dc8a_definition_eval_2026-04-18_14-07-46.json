  "raw_response": "from collections import deque\n\ndef solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = sorted({v for row in grid for v in row if v not in (0, 8)})\n    if len(colors) != 2:\n        return [row[:] for row in grid]\n\n    a, b = colors\n    other = {a: b, b: a}\n\n    out = [row[:] for row in grid]\n    q = deque()\n\n    for r in range(h):\n        for c in range(w):\n            if out[r][c] in other:\n                q.append((r, c))\n\n    while q:\n        r, c = q.popleft()\n        expected = other[out[r][c]]\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and out[nr][nc] != 8:\n                if out[nr][nc] == 0:\n                    out[nr][nc] = expected\n                    q.append((nr, nc))\n\n    return out",
