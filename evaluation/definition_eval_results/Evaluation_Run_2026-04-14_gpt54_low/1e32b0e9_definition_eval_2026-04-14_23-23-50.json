  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find separator color from any full nonzero row/column\n    sep_color = None\n    full_rows = []\n    for i in range(h):\n        row = grid[i]\n        if row and all(v == row[0] for v in row) and row[0] != 0:\n            full_rows.append(i)\n            sep_color = row[0]\n    full_cols = []\n    for j in range(w):\n        col0 = grid[0][j]\n        if col0 != 0 and all(grid[i][j] == col0 for i in range(h)):\n            full_cols.append(j)\n            sep_color = col0\n\n    if sep_color is None:\n        return [row[:] for row in grid]\n\n    # Boundaries of content cells between separator rows/cols\n    row_bounds = []\n    start = 0\n    for r in full_rows + [h]:\n        if start < r:\n            row_bounds.append((start, r))\n        start = r + 1\n\n    col_bounds = []\n    start = 0\n    for c in full_cols + [w]:\n        if start < c:\n            col_bounds.append((start, c))\n        start = c + 1\n\n    if not row_bounds or not col_bounds:\n        return [row[:] for row in grid]\n\n    cell_h = row_bounds[0][1] - row_bounds[0][0]\n    cell_w = col_bounds[0][1] - col_bounds[0][0]\n\n    # Build template as union of all nonzero, non-separator pixels\n    template = set()\n    for r0, r1 in row_bounds:\n        for c0, c1 in col_bounds:\n            for i in range(r0, r1):\n                for j in range(c0, c1):\n                    v = grid[i][j]\n                    if v != 0 and v != sep_color:\n                        template.add((i - r0, j - c0))\n\n    # Apply template to every cell using separator color, preserving originals\n    out = [row[:] for row in grid]\n    for r0, r1 in row_bounds:\n        for c0, c1 in col_bounds:\n            for di, dj in template:\n                i, j = r0 + di, c0 + dj\n                if r0 <= i < r1 and c0 <= j < c1 and out[i][j] == 0:\n                    out[i][j] = sep_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find separator color from any full nonzero row/column\n    sep_color = None\n    full_rows = []\n    for i in range(h):\n        row = grid[i]\n        if row and all(v == row[0] for v in row) and row[0] != 0:\n            full_rows.append(i)\n            sep_color = row[0]\n    full_cols = []\n    for j in range(w):\n        col0 = grid[0][j]\n        if col0 != 0 and all(grid[i][j] == col0 for i in range(h)):\n            full_cols.append(j)\n            sep_color = col0\n\n    if sep_color is None:\n        return [row[:] for row in grid]\n\n    # Boundaries of content cells between separator rows/cols\n    row_bounds = []\n    start = 0\n    for r in full_rows + [h]:\n        if start < r:\n            row_bounds.append((start, r))\n        start = r + 1\n\n    col_bounds = []\n    start = 0\n    for c in full_cols + [w]:\n        if start < c:\n            col_bounds.append((start, c))\n        start = c + 1\n\n    if not row_bounds or not col_bounds:\n        return [row[:] for row in grid]\n\n    cell_h = row_bounds[0][1] - row_bounds[0][0]\n    cell_w = col_bounds[0][1] - col_bounds[0][0]\n\n    # Build template as union of all nonzero, non-separator pixels\n    template = set()\n    for r0, r1 in row_bounds:\n        for c0, c1 in col_bounds:\n            for i in range(r0, r1):\n                for j in range(c0, c1):\n                    v = grid[i][j]\n                    if v != 0 and v != sep_color:\n                        template.add((i - r0, j - c0))\n\n    # Apply template to every cell using separator color, preserving originals\n    out = [row[:] for row in grid]\n    for r0, r1 in row_bounds:\n        for c0, c1 in col_bounds:\n            for di, dj in template:\n                i, j = r0 + di, c0 + dj\n                if r0 <= i < r1 and c0 <= j < c1 and out[i][j] == 0:\n                    out[i][j] = sep_color\n\n    return out",
