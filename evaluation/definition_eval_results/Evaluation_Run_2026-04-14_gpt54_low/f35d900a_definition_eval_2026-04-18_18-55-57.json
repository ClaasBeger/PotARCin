  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    if not pts:\n        return out\n\n    rows = sorted(set(r for r, c, v in pts))\n    cols = sorted(set(c for r, c, v in pts))\n\n    if len(rows) != 2 or len(cols) != 2:\n        return [row[:] for row in grid]\n\n    r1, r2 = rows\n    c1, c2 = cols\n\n    val = {(r, c): v for r, c, v in pts}\n    tl = val[(r1, c1)]\n    tr = val[(r1, c2)]\n    bl = val[(r2, c1)]\n    br = val[(r2, c2)]\n\n    def draw_block(cr, cc, center_color, border_color):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                rr, cc2 = cr + dr, cc + dc\n                if 0 <= rr < h and 0 <= cc2 < w:\n                    out[rr][cc2] = center_color if (dr == 0 and dc == 0) else border_color\n\n    draw_block(r1, c1, tl, tr)\n    draw_block(r1, c2, tr, tl)\n    draw_block(r2, c1, bl, br)\n    draw_block(r2, c2, br, bl)\n\n    def fill_alternating_line(cells):\n        n = len(cells)\n        for i, (r, c) in enumerate(cells):\n            if min(i, n - 1 - i) % 2 == 0:\n                out[r][c] = 5\n\n    if c1 + 2 <= c2 - 2:\n        top_cells = [(r1, c) for c in range(c1 + 2, c2 - 1)]\n        bottom_cells = [(r2, c) for c in range(c1 + 2, c2 - 1)]\n        fill_alternating_line(top_cells)\n        fill_alternating_line(bottom_cells)\n\n    if r1 + 2 <= r2 - 2:\n        left_cells = [(r, c1) for r in range(r1 + 2, r2 - 1)]\n        right_cells = [(r, c2) for r in range(r1 + 2, r2 - 1)]\n        fill_alternating_line(left_cells)\n        fill_alternating_line(right_cells)\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    if not pts:\n        return out\n\n    rows = sorted(set(r for r, c, v in pts))\n    cols = sorted(set(c for r, c, v in pts))\n\n    if len(rows) != 2 or len(cols) != 2:\n        return [row[:] for row in grid]\n\n    r1, r2 = rows\n    c1, c2 = cols\n\n    val = {(r, c): v for r, c, v in pts}\n    tl = val[(r1, c1)]\n    tr = val[(r1, c2)]\n    bl = val[(r2, c1)]\n    br = val[(r2, c2)]\n\n    def draw_block(cr, cc, center_color, border_color):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                rr, cc2 = cr + dr, cc + dc\n                if 0 <= rr < h and 0 <= cc2 < w:\n                    out[rr][cc2] = center_color if (dr == 0 and dc == 0) else border_color\n\n    draw_block(r1, c1, tl, tr)\n    draw_block(r1, c2, tr, tl)\n    draw_block(r2, c1, bl, br)\n    draw_block(r2, c2, br, bl)\n\n    def fill_alternating_line(cells):\n        n = len(cells)\n        for i, (r, c) in enumerate(cells):\n            if min(i, n - 1 - i) % 2 == 0:\n                out[r][c] = 5\n\n    if c1 + 2 <= c2 - 2:\n        top_cells = [(r1, c) for c in range(c1 + 2, c2 - 1)]\n        bottom_cells = [(r2, c) for c in range(c1 + 2, c2 - 1)]\n        fill_alternating_line(top_cells)\n        fill_alternating_line(bottom_cells)\n\n    if r1 + 2 <= r2 - 2:\n        left_cells = [(r, c1) for r in range(r1 + 2, r2 - 1)]\n        right_cells = [(r, c2) for r in range(r1 + 2, r2 - 1)]\n        fill_alternating_line(left_cells)\n        fill_alternating_line(right_cells)\n\n    return out",
