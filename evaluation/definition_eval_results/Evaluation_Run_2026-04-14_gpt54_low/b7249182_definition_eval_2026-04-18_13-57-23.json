  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    def put(r, c, color):\n        if 0 <= r < h and 0 <= c < w:\n            out[r][c] = color\n\n    def draw_horizontal(r, c_from, c_to, color):\n        step = 1 if c_to >= c_from else -1\n        for c in range(c_from, c_to + step, step):\n            put(r, c, color)\n\n    def draw_vertical(r_from, r_to, c, color):\n        step = 1 if r_to >= r_from else -1\n        for r in range(r_from, r_to + step, step):\n            put(r, c, color)\n\n    def draw_right_arrow(r, c, bar_c, color):\n        draw_horizontal(r, c, bar_c, color)\n        for dr in range(-2, 3):\n            put(r + dr, bar_c, color)\n        put(r - 2, bar_c + 1, color)\n        put(r + 2, bar_c + 1, color)\n\n    def draw_left_arrow(r, c, bar_c, color):\n        draw_horizontal(r, c, bar_c, color)\n        for dr in range(-2, 3):\n            put(r + dr, bar_c, color)\n        put(r - 2, bar_c - 1, color)\n        put(r + 2, bar_c - 1, color)\n\n    def draw_down_arrow(r, c, bar_r, color):\n        draw_vertical(r, bar_r, c, color)\n        for dc in range(-2, 3):\n            put(bar_r, c + dc, color)\n        put(bar_r + 1, c - 2, color)\n        put(bar_r + 1, c + 2, color)\n\n    def draw_up_arrow(r, c, bar_r, color):\n        draw_vertical(r, bar_r, c, color)\n        for dc in range(-2, 3):\n            put(bar_r, c + dc, color)\n        put(bar_r - 1, c - 2, color)\n        put(bar_r - 1, c + 2, color)\n\n    if len(pts) != 2:\n        return grid\n\n    r1, c1, col1 = pts[0]\n    r2, c2, col2 = pts[1]\n\n    if r1 == r2:\n        if c1 <= c2:\n            dist = c2 - c1\n            offset = dist // 2 - 1\n            draw_right_arrow(r1, c1, c1 + offset, col1)\n            draw_left_arrow(r2, c2, c2 - offset, col2)\n        else:\n            dist = c1 - c2\n            offset = dist // 2 - 1\n            draw_left_arrow(r1, c1, c1 - offset, col1)\n            draw_right_arrow(r2, c2, c2 + offset, col2)\n    elif c1 == c2:\n        if r1 <= r2:\n            dist = r2 - r1\n            offset = dist // 2 - 1\n            draw_down_arrow(r1, c1, r1 + offset, col1)\n            draw_up_arrow(r2, c2, r2 - offset, col2)\n        else:\n            dist = r1 - r2\n            offset = dist // 2 - 1\n            draw_up_arrow(r1, c1, r1 - offset, col1)\n            draw_down_arrow(r2, c2, r2 + offset, col2)\n    else:\n        return grid\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    def put(r, c, color):\n        if 0 <= r < h and 0 <= c < w:\n            out[r][c] = color\n\n    def draw_horizontal(r, c_from, c_to, color):\n        step = 1 if c_to >= c_from else -1\n        for c in range(c_from, c_to + step, step):\n            put(r, c, color)\n\n    def draw_vertical(r_from, r_to, c, color):\n        step = 1 if r_to >= r_from else -1\n        for r in range(r_from, r_to + step, step):\n            put(r, c, color)\n\n    def draw_right_arrow(r, c, bar_c, color):\n        draw_horizontal(r, c, bar_c, color)\n        for dr in range(-2, 3):\n            put(r + dr, bar_c, color)\n        put(r - 2, bar_c + 1, color)\n        put(r + 2, bar_c + 1, color)\n\n    def draw_left_arrow(r, c, bar_c, color):\n        draw_horizontal(r, c, bar_c, color)\n        for dr in range(-2, 3):\n            put(r + dr, bar_c, color)\n        put(r - 2, bar_c - 1, color)\n        put(r + 2, bar_c - 1, color)\n\n    def draw_down_arrow(r, c, bar_r, color):\n        draw_vertical(r, bar_r, c, color)\n        for dc in range(-2, 3):\n            put(bar_r, c + dc, color)\n        put(bar_r + 1, c - 2, color)\n        put(bar_r + 1, c + 2, color)\n\n    def draw_up_arrow(r, c, bar_r, color):\n        draw_vertical(r, bar_r, c, color)\n        for dc in range(-2, 3):\n            put(bar_r, c + dc, color)\n        put(bar_r - 1, c - 2, color)\n        put(bar_r - 1, c + 2, color)\n\n    if len(pts) != 2:\n        return grid\n\n    r1, c1, col1 = pts[0]\n    r2, c2, col2 = pts[1]\n\n    if r1 == r2:\n        if c1 <= c2:\n            dist = c2 - c1\n            offset = dist // 2 - 1\n            draw_right_arrow(r1, c1, c1 + offset, col1)\n            draw_left_arrow(r2, c2, c2 - offset, col2)\n        else:\n            dist = c1 - c2\n            offset = dist // 2 - 1\n            draw_left_arrow(r1, c1, c1 - offset, col1)\n            draw_right_arrow(r2, c2, c2 + offset, col2)\n    elif c1 == c2:\n        if r1 <= r2:\n            dist = r2 - r1\n            offset = dist // 2 - 1\n            draw_down_arrow(r1, c1, r1 + offset, col1)\n            draw_up_arrow(r2, c2, r2 - offset, col2)\n        else:\n            dist = r1 - r2\n            offset = dist // 2 - 1\n            draw_up_arrow(r1, c1, r1 - offset, col1)\n            draw_down_arrow(r2, c2, r2 + offset, col2)\n    else:\n        return grid\n\n    return out",
