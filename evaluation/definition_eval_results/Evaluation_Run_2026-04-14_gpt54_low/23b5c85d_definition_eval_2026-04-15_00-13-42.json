  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    best_cells = None\n    best_bbox = None\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n            min_r = max_r = r\n            min_c = max_c = c\n\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                if x < min_r:\n                    min_r = x\n                if x > max_r:\n                    max_r = x\n                if y < min_c:\n                    min_c = y\n                if y > max_c:\n                    max_c = y\n\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            area = len(cells)\n            bbox_area = (max_r - min_r + 1) * (max_c - min_c + 1)\n\n            if (\n                best_cells is None\n                or area < len(best_cells)\n                or (area == len(best_cells) and bbox_area < (best_bbox[1] - best_bbox[0] + 1) * (best_bbox[3] - best_bbox[2] + 1))\n            ):\n                best_cells = cells\n                best_bbox = (min_r, max_r, min_c, max_c)\n\n    if best_cells is None:\n        return []\n\n    min_r, max_r, min_c, max_c = best_bbox\n    return [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    best_cells = None\n    best_bbox = None\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n            min_r = max_r = r\n            min_c = max_c = c\n\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                if x < min_r:\n                    min_r = x\n                if x > max_r:\n                    max_r = x\n                if y < min_c:\n                    min_c = y\n                if y > max_c:\n                    max_c = y\n\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            area = len(cells)\n            bbox_area = (max_r - min_r + 1) * (max_c - min_c + 1)\n\n            if (\n                best_cells is None\n                or area < len(best_cells)\n                or (area == len(best_cells) and bbox_area < (best_bbox[1] - best_bbox[0] + 1) * (best_bbox[3] - best_bbox[2] + 1))\n            ):\n                best_cells = cells\n                best_bbox = (min_r, max_r, min_c, max_c)\n\n    if best_cells is None:\n        return []\n\n    min_r, max_r, min_c, max_c = best_bbox\n    return [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]",
