  "raw_response": "def solve(grid):\n    H, W = len(grid), len(grid[0])\n\n    # Locate the four corner markers (color 4)\n    fours = [(r, c) for r in range(H) for c in range(W) if grid[r][c] == 4]\n    rs = [r for r, _ in fours]\n    cs = [c for _, c in fours]\n    rmin, rmax = min(rs), max(rs)\n    cmin, cmax = min(cs), max(cs)\n\n    out_h = rmax - rmin + 1\n    out_w = cmax - cmin + 1\n\n    # Build output canvas as the cropped rectangle\n    out = [[0 for _ in range(out_w)] for _ in range(out_h)]\n    out[0][0] = 4\n    out[0][out_w - 1] = 4\n    out[out_h - 1][0] = 4\n    out[out_h - 1][out_w - 1] = 4\n\n    # Find colored components inside the 4-corner rectangle (excluding 0 and 4)\n    inside = [[grid[r][c] for c in range(cmin, cmax + 1)] for r in range(rmin, rmax + 1)]\n    h, w = len(inside), len(inside[0])\n\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if inside[r][c] != 0 and inside[r][c] != 4 and not visited[r][c]:\n                color = inside[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and inside[nx][ny] == color:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n                rr = [x for x, _ in cells]\n                cc = [y for _, y in cells]\n                top, left = min(rr), min(cc)\n                bottom, right = max(rr), max(cc)\n                comps.append({\n                    \"color\": color,\n                    \"top\": top,\n                    \"left\": left,\n                    \"height\": bottom - top + 1,\n                    \"width\": right - left + 1\n                })\n\n    # Scale factor = size of the square blocks in the top region\n    if comps:\n        s = min(min(comp[\"height\"], comp[\"width\"]) for comp in comps)\n    else:\n        s = 1\n\n    # Extract the miniature pattern outside the rectangle\n    outside_cells = []\n    for r in range(H):\n        for c in range(W):\n            if not (rmin <= r <= rmax and cmin <= c <= cmax):\n                v = grid[r][c]\n                if v != 0 and v != 4:\n                    outside_cells.append((r, c))\n\n    if not outside_cells:\n        return out\n\n    pr0 = min(r for r, _ in outside_cells)\n    pr1 = max(r for r, _ in outside_cells)\n    pc0 = min(c for _, c in outside_cells)\n    pc1 = max(c for _, c in outside_cells)\n\n    pattern = [[0 for _ in range(pc1 - pc0 + 1)] for _ in range(pr1 - pr0 + 1)]\n    for r in range(pr0, pr1 + 1):\n        for c in range(pc0, pc1 + 1):\n            v = grid[r][c]\n            if v != 4:\n                pattern[r - pr0][c - pc0] = v\n\n    ph, pw = len(pattern), len(pattern[0])\n\n    # Precompute pattern positions by color\n    pattern_pos = {}\n    for r in range(ph):\n        for c in range(pw):\n            v = pattern[r][c]\n            if v != 0:\n                pattern_pos.setdefault(v, []).append((r, c))\n\n    # Determine placement offset using top-region blocks\n    def valid_offset(off_r, off_c):\n        # Entire scaled pattern must fit inside crop\n        if off_r < 0 or off_c < 0:\n            return False\n        if off_r + ph * s > out_h or off_c + pw * s > out_w:\n            return False\n\n        # Every existing top component must correspond to a same-colored miniature cell\n        for comp in comps:\n            tr, tc, color = comp[\"top\"], comp[\"left\"], comp[\"color\"]\n            if (tr - off_r) % s != 0 or (tc - off_c) % s != 0:\n                return False\n            mr = (tr - off_r) // s\n            mc = (tc - off_c) // s\n            if not (0 <= mr < ph and 0 <= mc < pw):\n                return False\n            if pattern[mr][mc] != color:\n                return False\n        return True\n\n    offset_r = offset_c = None\n\n    if comps:\n        first = comps[0]\n        for mr, mc in pattern_pos.get(first[\"color\"], []):\n            cand_r = first[\"top\"] - mr * s\n            cand_c = first[\"left\"] - mc * s\n            if valid_offset(cand_r, cand_c):\n                offset_r, offset_c = cand_r, cand_c\n                break\n\n    if offset_r is None:\n        # Fallback: place at top-left if possible\n        offset_r, offset_c = 0, 0\n\n    # Render scaled pattern\n    for r in range(ph):\n        for c in range(pw):\n            color = pattern[r][c]\n            if color == 0:\n                continue\n            rr0 = offset_r + r * s\n            cc0 = offset_c + c * s\n            for dr in range(s):\n                for dc in range(s):\n                    rr = rr0 + dr\n                    cc = cc0 + dc\n                    if 0 <= rr < out_h and 0 <= cc < out_w:\n                        out[rr][cc] = color\n\n    # Restore corner markers\n    out[0][0] = 4\n    out[0][out_w - 1] = 4\n    out[out_h - 1][0] = 4\n    out[out_h - 1][out_w - 1] = 4\n\n    return out",
