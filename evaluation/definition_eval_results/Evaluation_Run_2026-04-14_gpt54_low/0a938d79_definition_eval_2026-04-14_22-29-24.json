  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    if len(pts) != 2:\n        return [row[:] for row in grid]\n\n    (r1, c1, v1), (r2, c2, v2) = pts\n\n    out = [[0] * w for _ in range(h)]\n\n    # If the two markers connect top and bottom edges, create vertical stripes.\n    if {r1, r2} == {0, h - 1}:\n        if c2 < c1:\n            r1, c1, v1, r2, c2, v2 = r2, c2, v2, r1, c1, v1\n        step = c2 - c1\n        if step <= 0:\n            return [row[:] for row in grid]\n        colors = [v1, v2]\n        k = 0\n        c = c1\n        while c < w:\n            color = colors[k % 2]\n            for r in range(h):\n                out[r][c] = color\n            k += 1\n            c += step\n        return out\n\n    # Otherwise create horizontal stripes.\n    if r2 < r1:\n        r1, c1, v1, r2, c2, v2 = r2, c2, v2, r1, c1, v1\n    step = r2 - r1\n    if step <= 0:\n        return [row[:] for row in grid]\n\n    colors = [v1, v2]\n    k = 0\n    r = r1\n    while r < h:\n        color = colors[k % 2]\n        for c in range(w):\n            out[r][c] = color\n        k += 1\n        r += step\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    if len(pts) != 2:\n        return [row[:] for row in grid]\n\n    (r1, c1, v1), (r2, c2, v2) = pts\n\n    out = [[0] * w for _ in range(h)]\n\n    # If the two markers connect top and bottom edges, create vertical stripes.\n    if {r1, r2} == {0, h - 1}:\n        if c2 < c1:\n            r1, c1, v1, r2, c2, v2 = r2, c2, v2, r1, c1, v1\n        step = c2 - c1\n        if step <= 0:\n            return [row[:] for row in grid]\n        colors = [v1, v2]\n        k = 0\n        c = c1\n        while c < w:\n            color = colors[k % 2]\n            for r in range(h):\n                out[r][c] = color\n            k += 1\n            c += step\n        return out\n\n    # Otherwise create horizontal stripes.\n    if r2 < r1:\n        r1, c1, v1, r2, c2, v2 = r2, c2, v2, r1, c1, v1\n    step = r2 - r1\n    if step <= 0:\n        return [row[:] for row in grid]\n\n    colors = [v1, v2]\n    k = 0\n    r = r1\n    while r < h:\n        color = colors[k % 2]\n        for c in range(w):\n            out[r][c] = color\n        k += 1\n        r += step\n\n    return out",
