  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    twos = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not twos:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, _ in twos)\n    min_c = min(c for _, c in twos)\n    shape = [(r - min_r, c - min_c) for r, c in twos]\n\n    max_dr = max(dr for dr, _ in shape)\n    max_dc = max(dc for _, dc in shape)\n\n    out = [row[:] for row in grid]\n\n    for r0 in range(h - max_dr):\n        for c0 in range(w - max_dc):\n            if all(grid[r0 + dr][c0 + dc] == 0 for dr, dc in shape):\n                for dr, dc in shape:\n                    out[r0 + dr][c0 + dc] = 2\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    twos = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not twos:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, _ in twos)\n    min_c = min(c for _, c in twos)\n    shape = [(r - min_r, c - min_c) for r, c in twos]\n\n    max_dr = max(dr for dr, _ in shape)\n    max_dc = max(dc for _, dc in shape)\n\n    out = [row[:] for row in grid]\n\n    for r0 in range(h - max_dr):\n        for c0 in range(w - max_dc):\n            if all(grid[r0 + dr][c0 + dc] == 0 for dr, dc in shape):\n                for dr, dc in shape:\n                    out[r0 + dr][c0 + dc] = 2\n\n    return out",
