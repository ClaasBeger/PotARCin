  "raw_response": "def solve(grid):\n    from collections import deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def components_of_value(val, allowed_rows=None):\n        seen = [[False] * w for _ in range(h)]\n        comps = []\n        row_ok = set(allowed_rows) if allowed_rows is not None else None\n\n        for r in range(h):\n            if row_ok is not None and r not in row_ok:\n                continue\n            for c in range(w):\n                if grid[r][c] != val or seen[r][c]:\n                    continue\n                q = deque([(r, c)])\n                seen[r][c] = True\n                cells = []\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny]:\n                            if grid[nx][ny] == val and (row_ok is None or nx in row_ok):\n                                seen[nx][ny] = True\n                                q.append((nx, ny))\n                comps.append(cells)\n        return comps\n\n    def normalize(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        norm = sorted((r - min_r, c - min_c) for r, c in cells)\n        max_r = max(r for r, c in norm) if norm else -1\n        max_c = max(c for r, c in norm) if norm else -1\n        return norm, min_r, min_c, max_r + 1, max_c + 1\n\n    # Bottom patterns are the 5-components\n    comps5 = components_of_value(5)\n    shapes5 = []\n    for comp in comps5:\n        norm, _, _, hh, ww = normalize(comp)\n        shapes5.append({\n            \"cells\": set(norm),\n            \"h\": hh,\n            \"w\": ww,\n        })\n\n    # Seeds are 0-components in rows that contain any 2\n    top_rows = [r for r in range(h) if 2 in grid[r]]\n    seed_comps = components_of_value(0, allowed_rows=top_rows)\n\n    out = [row[:] for row in grid]\n    for r in range(h):\n        for c in range(w):\n            if out[r][c] == 5:\n                out[r][c] = 0\n\n    for comp in seed_comps:\n        seed_norm_list, anchor_r, anchor_c, seed_h, seed_w = normalize(comp)\n        seed_norm = set(seed_norm_list)\n\n        matched_shape = None\n        for shape in shapes5:\n            top_part = {(r, c) for (r, c) in shape[\"cells\"] if r < seed_h}\n            if top_part == seed_norm:\n                matched_shape = shape\n                break\n\n        if matched_shape is None:\n            continue\n\n        for dr, dc in matched_shape[\"cells\"]:\n            rr, cc = anchor_r + dr, anchor_c + dc\n            if 0 <= rr < h and 0 <= cc < w and out[rr][cc] != 2:\n                out[rr][cc] = 1\n\n    return out",
  "script": "def solve(grid):\n    from collections import deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def components_of_value(val, allowed_rows=None):\n        seen = [[False] * w for _ in range(h)]\n        comps = []\n        row_ok = set(allowed_rows) if allowed_rows is not None else None\n\n        for r in range(h):\n            if row_ok is not None and r not in row_ok:\n                continue\n            for c in range(w):\n                if grid[r][c] != val or seen[r][c]:\n                    continue\n                q = deque([(r, c)])\n                seen[r][c] = True\n                cells = []\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny]:\n                            if grid[nx][ny] == val and (row_ok is None or nx in row_ok):\n                                seen[nx][ny] = True\n                                q.append((nx, ny))\n                comps.append(cells)\n        return comps\n\n    def normalize(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        norm = sorted((r - min_r, c - min_c) for r, c in cells)\n        max_r = max(r for r, c in norm) if norm else -1\n        max_c = max(c for r, c in norm) if norm else -1\n        return norm, min_r, min_c, max_r + 1, max_c + 1\n\n    # Bottom patterns are the 5-components\n    comps5 = components_of_value(5)\n    shapes5 = []\n    for comp in comps5:\n        norm, _, _, hh, ww = normalize(comp)\n        shapes5.append({\n            \"cells\": set(norm),\n            \"h\": hh,\n            \"w\": ww,\n        })\n\n    # Seeds are 0-components in rows that contain any 2\n    top_rows = [r for r in range(h) if 2 in grid[r]]\n    seed_comps = components_of_value(0, allowed_rows=top_rows)\n\n    out = [row[:] for row in grid]\n    for r in range(h):\n        for c in range(w):\n            if out[r][c] == 5:\n                out[r][c] = 0\n\n    for comp in seed_comps:\n        seed_norm_list, anchor_r, anchor_c, seed_h, seed_w = normalize(comp)\n        seed_norm = set(seed_norm_list)\n\n        matched_shape = None\n        for shape in shapes5:\n            top_part = {(r, c) for (r, c) in shape[\"cells\"] if r < seed_h}\n            if top_part == seed_norm:\n                matched_shape = shape\n                break\n\n        if matched_shape is None:\n            continue\n\n        for dr, dc in matched_shape[\"cells\"]:\n            rr, cc = anchor_r + dr, anchor_c + dc\n            if 0 <= rr < h and 0 <= cc < w and out[rr][cc] != 2:\n                out[rr][cc] = 1\n\n    return out",
