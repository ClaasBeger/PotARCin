  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                yield nr, nc\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 5 or visited[r][c]:\n                continue\n\n            # Collect one connected component of 5s\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                for nr, nc in neighbors(cr, cc):\n                    if not visited[nr][nc] and grid[nr][nc] == 5:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            rs = [x for x, _ in cells]\n            cs = [y for _, y in cells]\n            r1, r2 = min(rs), max(rs)\n            c1, c2 = min(cs), max(cs)\n\n            # Need at least a 3x3 box to have an interior\n            if r2 - r1 < 2 or c2 - c1 < 2:\n                continue\n\n            cellset = set(cells)\n\n            # Verify component is exactly a rectangular border of 5s\n            ok = True\n            for rr in range(r1, r2 + 1):\n                for cc in range(c1, c2 + 1):\n                    on_border = rr == r1 or rr == r2 or cc == c1 or cc == c2\n                    if on_border:\n                        if (rr, cc) not in cellset:\n                            ok = False\n                            break\n                    else:\n                        if (rr, cc) in cellset:\n                            ok = False\n                            break\n                if not ok:\n                    break\n\n            if not ok:\n                continue\n\n            inner_h = r2 - r1 - 1\n            inner_w = c2 - c1 - 1\n            fill_color = 5 + min(inner_h, inner_w)\n\n            for rr in range(r1 + 1, r2):\n                for cc in range(c1 + 1, c2):\n                    out[rr][cc] = fill_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                yield nr, nc\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 5 or visited[r][c]:\n                continue\n\n            # Collect one connected component of 5s\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                for nr, nc in neighbors(cr, cc):\n                    if not visited[nr][nc] and grid[nr][nc] == 5:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            rs = [x for x, _ in cells]\n            cs = [y for _, y in cells]\n            r1, r2 = min(rs), max(rs)\n            c1, c2 = min(cs), max(cs)\n\n            # Need at least a 3x3 box to have an interior\n            if r2 - r1 < 2 or c2 - c1 < 2:\n                continue\n\n            cellset = set(cells)\n\n            # Verify component is exactly a rectangular border of 5s\n            ok = True\n            for rr in range(r1, r2 + 1):\n                for cc in range(c1, c2 + 1):\n                    on_border = rr == r1 or rr == r2 or cc == c1 or cc == c2\n                    if on_border:\n                        if (rr, cc) not in cellset:\n                            ok = False\n                            break\n                    else:\n                        if (rr, cc) in cellset:\n                            ok = False\n                            break\n                if not ok:\n                    break\n\n            if not ok:\n                continue\n\n            inner_h = r2 - r1 - 1\n            inner_w = c2 - c1 - 1\n            fill_color = 5 + min(inner_h, inner_w)\n\n            for rr in range(r1 + 1, r2):\n                for cc in range(c1 + 1, c2):\n                    out[rr][cc] = fill_color\n\n    return out",
