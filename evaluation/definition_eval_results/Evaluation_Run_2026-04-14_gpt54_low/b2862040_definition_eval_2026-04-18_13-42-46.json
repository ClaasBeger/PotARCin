  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    # Find all enclosed 9-regions (holes): 9-components not touching the border.\n    seen9 = [[False] * w for _ in range(h)]\n    hole_cells = set()\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 9 or seen9[r][c]:\n                continue\n\n            stack = [(r, c)]\n            seen9[r][c] = True\n            comp = []\n            touches_border = False\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n                if x == 0 or x == h - 1 or y == 0 or y == w - 1:\n                    touches_border = True\n\n                for dx, dy in dirs:\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not seen9[nx][ny] and grid[nx][ny] == 9:\n                        seen9[nx][ny] = True\n                        stack.append((nx, ny))\n\n            if not touches_border:\n                hole_cells.update(comp)\n\n    # Recolor any 1-component that is adjacent to at least one hole cell.\n    out = [row[:] for row in grid]\n    seen1 = [[False] * w for _ in range(h)]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 1 or seen1[r][c]:\n                continue\n\n            stack = [(r, c)]\n            seen1[r][c] = True\n            comp = []\n            adjacent_to_hole = False\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n\n                for dx, dy in dirs:\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w:\n                        if grid[nx][ny] == 1 and not seen1[nx][ny]:\n                            seen1[nx][ny] = True\n                            stack.append((nx, ny))\n                        elif (nx, ny) in hole_cells:\n                            adjacent_to_hole = True\n\n            if adjacent_to_hole:\n                for x, y in comp:\n                    out[x][y] = 8\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    # Find all enclosed 9-regions (holes): 9-components not touching the border.\n    seen9 = [[False] * w for _ in range(h)]\n    hole_cells = set()\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 9 or seen9[r][c]:\n                continue\n\n            stack = [(r, c)]\n            seen9[r][c] = True\n            comp = []\n            touches_border = False\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n                if x == 0 or x == h - 1 or y == 0 or y == w - 1:\n                    touches_border = True\n\n                for dx, dy in dirs:\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not seen9[nx][ny] and grid[nx][ny] == 9:\n                        seen9[nx][ny] = True\n                        stack.append((nx, ny))\n\n            if not touches_border:\n                hole_cells.update(comp)\n\n    # Recolor any 1-component that is adjacent to at least one hole cell.\n    out = [row[:] for row in grid]\n    seen1 = [[False] * w for _ in range(h)]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 1 or seen1[r][c]:\n                continue\n\n            stack = [(r, c)]\n            seen1[r][c] = True\n            comp = []\n            adjacent_to_hole = False\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n\n                for dx, dy in dirs:\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w:\n                        if grid[nx][ny] == 1 and not seen1[nx][ny]:\n                            seen1[nx][ny] = True\n                            stack.append((nx, ny))\n                        elif (nx, ny) in hole_cells:\n                            adjacent_to_hole = True\n\n            if adjacent_to_hole:\n                for x, y in comp:\n                    out[x][y] = 8\n\n    return out",
