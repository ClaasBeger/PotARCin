  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find connected components of color 2\n    seen = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2 and not seen[r][c]:\n                stack = [(r, c)]\n                seen[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == 2:\n                            seen[nx][ny] = True\n                            stack.append((nx, ny))\n                rows = [x for x, _ in cells]\n                cols = [y for _, y in cells]\n                comps.append({\n                    \"top\": min(rows),\n                    \"bottom\": max(rows),\n                    \"col\": cols[0]\n                })\n\n    if len(comps) != 2:\n        return [row[:] for row in grid]\n\n    # Identify left and right vertical lines\n    comps.sort(key=lambda x: x[\"col\"])\n    left = comps[0]\n    right = comps[1]\n\n    out = [row[:] for row in grid]\n\n    # Use original 8 positions only\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n\n    for r, c in eights:\n        source = None\n        target = None\n\n        # Determine which vertical line this 8 belongs to\n        if left[\"top\"] <= r <= left[\"bottom\"] and c > left[\"col\"]:\n            source = left\n            target = right\n            side = \"left\"\n        elif right[\"top\"] <= r <= right[\"bottom\"] and c < right[\"col\"]:\n            source = right\n            target = left\n            side = \"right\"\n        else:\n            # Fallback: choose the segment whose row-span contains r\n            if left[\"top\"] <= r <= left[\"bottom\"]:\n                source = left\n                target = right\n                side = \"left\"\n            elif right[\"top\"] <= r <= right[\"bottom\"]:\n                source = right\n                target = left\n                side = \"right\"\n            else:\n                continue\n\n        if side == \"left\":\n            # Draw from left line toward the 8; 8 becomes 4\n            for cc in range(source[\"col\"] + 1, c):\n                out[r][cc] = 8\n            out[r][c] = 4\n\n            # Mirror on the right-line component at same offset row\n            mr = target[\"top\"] + (r - source[\"top\"])\n            if 0 <= mr < h:\n                for cc in range(0, target[\"col\"]):\n                    out[mr][cc] = 8\n        else:\n            # Draw from 8 toward right line; 8 becomes 4\n            for cc in range(c + 1, source[\"col\"]):\n                out[r][cc] = 8\n            out[r][c] = 4\n\n            # Mirror on the left-line component at same offset row\n            mr = target[\"top\"] + (r - source[\"top\"])\n            if 0 <= mr < h:\n                for cc in range(target[\"col\"] + 1, w):\n                    out[mr][cc] = 8\n\n    return out",
