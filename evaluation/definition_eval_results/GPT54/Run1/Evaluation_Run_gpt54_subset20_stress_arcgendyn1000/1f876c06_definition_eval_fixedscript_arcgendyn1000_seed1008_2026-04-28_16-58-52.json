  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    positions = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                positions.setdefault(v, []).append((r, c))\n\n    def sign(x):\n        if x < 0:\n            return -1\n        if x > 0:\n            return 1\n        return 0\n\n    for color, pts in positions.items():\n        if len(pts) < 2:\n            continue\n\n        # Use the two occurrences of the color as the endpoints of the diagonal.\n        (r1, c1), (r2, c2) = pts[0], pts[1]\n\n        dr = sign(r2 - r1)\n        dc = sign(c2 - c1)\n\n        # Fill only if the two points define a diagonal segment.\n        if abs(r2 - r1) != abs(c2 - c1):\n            continue\n\n        steps = abs(r2 - r1)\n        for k in range(steps + 1):\n            out[r1 + dr * k][c1 + dc * k] = color\n\n    return out",
