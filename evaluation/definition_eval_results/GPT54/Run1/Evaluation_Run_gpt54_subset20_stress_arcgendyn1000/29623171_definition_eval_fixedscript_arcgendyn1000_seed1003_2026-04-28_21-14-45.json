  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    sep_rows = [r for r in range(h) if all(v == 5 for v in grid[r])]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == 5 for r in range(h))]\n\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n\n    color = 0\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] not in (0, 5):\n                color = grid[r][c]\n                break\n        if color:\n            break\n\n    out = [row[:] for row in grid]\n\n    regions = []\n    max_count = 0\n\n    for i in range(len(row_bounds) - 1):\n        r1 = row_bounds[i] + 1\n        r2 = row_bounds[i + 1]\n        if r1 >= r2:\n            continue\n        for j in range(len(col_bounds) - 1):\n            c1 = col_bounds[j] + 1\n            c2 = col_bounds[j + 1]\n            if c1 >= c2:\n                continue\n\n            count = 0\n            for r in range(r1, r2):\n                for c in range(c1, c2):\n                    if grid[r][c] not in (0, 5):\n                        count += 1\n\n            regions.append((r1, r2, c1, c2, count))\n            if count > max_count:\n                max_count = count\n\n    for r1, r2, c1, c2, count in regions:\n        fill = (count == max_count and count > 0)\n        for r in range(r1, r2):\n            for c in range(c1, c2):\n                out[r][c] = color if fill else 0\n\n    return out",
