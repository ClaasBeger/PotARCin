  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = set()\n    for row in grid:\n        colors.update(row)\n\n    best_color = None\n    best_rows = []\n    best_cols = []\n    best_score = -1\n\n    for color in colors:\n        full_rows = [r for r in range(h) if all(grid[r][c] == color for c in range(w))]\n        full_cols = [c for c in range(w) if all(grid[r][c] == color for r in range(h))]\n        score = len(full_rows) + len(full_cols)\n        if score > best_score:\n            best_score = score\n            best_color = color\n            best_rows = full_rows\n            best_cols = full_cols\n\n    line_color = best_color\n\n    counts = {}\n    for row in grid:\n        for v in row:\n            if v != line_color:\n                counts[v] = counts.get(v, 0) + 1\n\n    if counts:\n        bg_color = max(counts, key=counts.get)\n    else:\n        bg_color = line_color\n\n    out_h = len(best_rows) + 1\n    out_w = len(best_cols) + 1\n\n    return [[bg_color for _ in range(out_w)] for _ in range(out_h)]",
