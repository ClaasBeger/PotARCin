  "arc_gen_dynamic_seed": 1580944453,
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    if h == 0 or w == 0:\n        return out\n\n    # Find the template row: the row with the most 5s.\n    row_counts = [sum(1 for v in row if v == 5) for row in grid]\n    template_row = max(range(h), key=lambda r: row_counts[r])\n\n    template_cols = [c for c in range(w) if grid[template_row][c] == 5]\n    if not template_cols:\n        return out\n\n    # Find the marker column: the column with the most 5s outside the template row.\n    col_counts = []\n    for c in range(w):\n        count = 0\n        for r in range(h):\n            if r != template_row and grid[r][c] == 5:\n                count += 1\n        col_counts.append(count)\n\n    marker_col = max(range(w), key=lambda c: col_counts[c])\n\n    # On each row marked by a 5 in the marker column, stamp the template as 2s.\n    for r in range(h):\n        if r != template_row and grid[r][marker_col] == 5:\n            for c in template_cols:\n                if out[r][c] == 0:\n                    out[r][c] = 2\n\n    return out",
