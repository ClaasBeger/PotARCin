  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                yield nr, nc\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 8 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                comp = []\n\n                while stack:\n                    cr, cc = stack.pop()\n                    comp.append((cr, cc))\n                    for nr, nc in neighbors(cr, cc):\n                        if grid[nr][nc] == 8 and not visited[nr][nc]:\n                            visited[nr][nc] = True\n                            stack.append((nr, nc))\n\n                if len(comp) == 3:\n                    rs = [x for x, _ in comp]\n                    cs = [y for _, y in comp]\n                    rmin, rmax = min(rs), max(rs)\n                    cmin, cmax = min(cs), max(cs)\n\n                    if rmax - rmin == 1 and cmax - cmin == 1:\n                        cells = {(rr, cc) for rr in range(rmin, rmax + 1) for cc in range(cmin, cmax + 1)}\n                        missing = list(cells - set(comp))\n                        if len(missing) == 1:\n                            mr, mc = missing[0]\n                            if out[mr][mc] == 0:\n                                out[mr][mc] = 1\n\n    return out",
