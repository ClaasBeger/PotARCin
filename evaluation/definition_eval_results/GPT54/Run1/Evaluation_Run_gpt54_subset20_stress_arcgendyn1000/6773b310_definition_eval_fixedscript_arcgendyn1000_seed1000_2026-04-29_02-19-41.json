  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    sep_rows = [i for i in range(h) if all(v == 8 for v in grid[i])]\n    sep_cols = [j for j in range(w) if all(grid[i][j] == 8 for i in range(h))]\n\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n\n    out = []\n    for rb in range(len(row_bounds) - 1):\n        r1 = row_bounds[rb] + 1\n        r2 = row_bounds[rb + 1]\n        if r1 >= r2:\n            continue\n\n        out_row = []\n        for cb in range(len(col_bounds) - 1):\n            c1 = col_bounds[cb] + 1\n            c2 = col_bounds[cb + 1]\n            if c1 >= c2:\n                continue\n\n            count6 = 0\n            for i in range(r1, r2):\n                for j in range(c1, c2):\n                    if grid[i][j] == 6:\n                        count6 += 1\n\n            out_row.append(1 if count6 == 2 else 0)\n        out.append(out_row)\n\n    return out",
