  "script": "def solve(grid):\n    from collections import defaultdict, deque\n\n    h, w = len(grid), len(grid[0])\n\n    # Collect cells by color\n    cells_by_color = defaultdict(list)\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                cells_by_color[v].append((r, c))\n\n    colors = list(cells_by_color.keys())\n    if len(colors) != 2:\n        # Fallback: crop non-zero bbox if not exactly two objects\n        pts = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n        if not pts:\n            return [[0]]\n        r0 = min(r for r, _ in pts)\n        r1 = max(r for r, _ in pts)\n        c0 = min(c for _, c in pts)\n        c1 = max(c for _, c in pts)\n        return [row[c0:c1 + 1] for row in grid[r0:r1 + 1]]\n\n    # Build tight bbox matrices for the two colored objects\n    shapes = []\n    for color in colors:\n        pts = cells_by_color[color]\n        r0 = min(r for r, _ in pts)\n        r1 = max(r for r, _ in pts)\n        c0 = min(c for _, c in pts)\n        c1 = max(c for _, c in pts)\n        mat = [[0] * (c1 - c0 + 1) for _ in range(r1 - r0 + 1)]\n        for r, c in pts:\n            mat[r - r0][c - c0] = color\n        shapes.append(mat)\n\n    A, B = shapes\n    ha, wa = len(A), len(A[0])\n    hb, wb = len(B), len(B[0])\n\n    best = None\n    best_grid = None\n\n    # Search relative placements of B with respect to A\n    for dr in range(-hb, ha + 1):\n        for dc in range(-wb, wa + 1):\n            # Check for color collisions where both are non-zero\n            ok = True\n            occupied = []\n\n            for r in range(ha):\n                for c in range(wa):\n                    if A[r][c] != 0:\n                        occupied.append((r, c, A[r][c]))\n\n            for r in range(hb):\n                for c in range(wb):\n                    if B[r][c] == 0:\n                        continue\n                    ar, ac = r + dr, c + dc\n                    if 0 <= ar < ha and 0 <= ac < wa and A[ar][ac] != 0:\n                        ok = False\n                        break\n                    occupied.append((ar, ac, B[r][c]))\n                if not ok:\n                    break\n\n            if not ok:\n                continue\n\n            rs = [r for r, _, _ in occupied]\n            cs = [c for _, c, _ in occupied]\n            rmin, rmax = min(rs), max(rs)\n            cmin, cmax = min(cs), max(cs)\n            H = rmax - rmin + 1\n            W = cmax - cmin + 1\n            area = H * W\n\n            # Build cropped union\n            out = [[0] * W for _ in range(H)]\n            for r, c, v in occupied:\n                out[r - rmin][c - cmin] = v\n\n            key = (area, H + W, H, W, tuple(tuple(row) for row in out))\n            if best is None or key < best:\n                best = key\n                best_grid = out\n\n    return best_grid",
