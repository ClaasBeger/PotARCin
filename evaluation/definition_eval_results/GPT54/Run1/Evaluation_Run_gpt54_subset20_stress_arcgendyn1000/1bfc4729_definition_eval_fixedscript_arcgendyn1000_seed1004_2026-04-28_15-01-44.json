  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    mid = h // 2\n\n    top_seed = None\n    bottom_seed = None\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                if r < mid and top_seed is None:\n                    top_seed = (r, c, grid[r][c])\n                elif r >= mid and bottom_seed is None:\n                    bottom_seed = (r, c, grid[r][c])\n\n    if top_seed is not None:\n        sr, _, color = top_seed\n        for r in range(0, mid):\n            if r == 0 or r == sr:\n                for c in range(w):\n                    out[r][c] = color\n            else:\n                out[r][0] = color\n                out[r][w - 1] = color\n\n    if bottom_seed is not None:\n        sr, _, color = bottom_seed\n        for r in range(mid, h):\n            if r == h - 1 or r == sr:\n                for c in range(w):\n                    out[r][c] = color\n            else:\n                out[r][0] = color\n                out[r][w - 1] = color\n\n    return out",
