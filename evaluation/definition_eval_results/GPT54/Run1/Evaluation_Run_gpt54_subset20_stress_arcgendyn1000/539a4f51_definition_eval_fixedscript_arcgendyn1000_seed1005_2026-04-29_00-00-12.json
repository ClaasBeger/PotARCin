  "script": "def solve(grid):\n    n = len(grid)\n    if n == 0:\n        return []\n\n    m_row = 0\n    for j, v in enumerate(grid[0]):\n        if v != 0:\n            m_row = j + 1\n\n    m_col = 0\n    for i, row in enumerate(grid):\n        if row[0] != 0:\n            m_col = i + 1\n\n    m = max(m_row, m_col)\n    if m == 0:\n        return [[0] * (2 * n) for _ in range(2 * n)]\n\n    s = grid[0][:m]\n    size = 2 * n\n    t = [s[i % m] for i in range(size)]\n\n    return [[t[max(i, j)] for j in range(size)] for i in range(size)]",
