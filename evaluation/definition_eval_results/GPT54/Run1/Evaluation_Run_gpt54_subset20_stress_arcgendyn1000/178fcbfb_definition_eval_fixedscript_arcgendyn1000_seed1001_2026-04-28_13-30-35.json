  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    row_colors = {}\n    col_twos = set()\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 2:\n                col_twos.add(c)\n            elif v in (1, 3):\n                row_colors[r] = v\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for c in col_twos:\n        for r in range(h):\n            out[r][c] = 2\n\n    for r, color in row_colors.items():\n        for c in range(w):\n            out[r][c] = color\n\n    return out",
