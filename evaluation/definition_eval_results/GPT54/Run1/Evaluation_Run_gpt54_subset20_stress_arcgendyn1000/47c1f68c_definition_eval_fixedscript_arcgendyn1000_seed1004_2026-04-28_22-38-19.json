  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find the divider row and color\n    divider_row = None\n    divider_color = None\n    for i in range(h):\n        vals = set(grid[i])\n        if len(vals) == 1 and 0 not in vals:\n            divider_row = i\n            divider_color = grid[i][0]\n            break\n\n    # Find the divider column (same color)\n    divider_col = None\n    for j in range(w):\n        if all(grid[i][j] == divider_color for i in range(h)):\n            divider_col = j\n            break\n\n    out_h = h - 1\n    out_w = w - 1\n    out = [[0 for _ in range(out_w)] for _ in range(out_h)]\n\n    # Read the pattern from the top-left quadrant, ignoring zeros and divider color\n    for i in range(divider_row):\n        for j in range(divider_col):\n            if grid[i][j] != 0 and grid[i][j] != divider_color:\n                # top-left\n                out[i][j] = divider_color\n                # top-right (horizontal mirror)\n                out[i][out_w - 1 - j] = divider_color\n                # bottom-left (vertical mirror)\n                out[out_h - 1 - i][j] = divider_color\n                # bottom-right (both mirrors)\n                out[out_h - 1 - i][out_w - 1 - j] = divider_color\n\n    return out",
