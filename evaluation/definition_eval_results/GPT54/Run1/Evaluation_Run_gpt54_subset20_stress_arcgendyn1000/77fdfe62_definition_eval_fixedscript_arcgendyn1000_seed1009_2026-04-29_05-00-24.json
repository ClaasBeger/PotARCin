  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    one_rows = [r for r in range(h) if all(v == 1 for v in grid[r])]\n    one_cols = [c for c in range(w) if all(grid[r][c] == 1 for r in range(h))]\n\n    top_sep, bottom_sep = one_rows[0], one_rows[-1]\n    left_sep, right_sep = one_cols[0], one_cols[-1]\n\n    inner = [row[left_sep + 1:right_sep] for row in grid[top_sep + 1:bottom_sep]]\n    ih = len(inner)\n    iw = len(inner[0])\n\n    tl = grid[0][0]\n    tr = grid[0][w - 1]\n    bl = grid[h - 1][0]\n    br = grid[h - 1][w - 1]\n\n    mid_r = ih // 2\n    mid_c = iw // 2\n\n    out = []\n    for r in range(ih):\n        new_row = []\n        for c in range(iw):\n            if inner[r][c] != 8:\n                new_row.append(0)\n            else:\n                if r < mid_r and c < mid_c:\n                    new_row.append(tl)\n                elif r < mid_r and c >= mid_c:\n                    new_row.append(tr)\n                elif r >= mid_r and c < mid_c:\n                    new_row.append(bl)\n                else:\n                    new_row.append(br)\n        out.append(new_row)\n\n    return out",
