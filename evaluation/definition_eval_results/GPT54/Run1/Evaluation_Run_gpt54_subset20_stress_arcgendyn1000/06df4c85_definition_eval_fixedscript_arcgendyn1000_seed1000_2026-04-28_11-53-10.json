  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: the color that forms full rows and full columns.\n    row_full = {}\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            v = grid[r][0]\n            row_full[v] = row_full.get(v, 0) + 1\n\n    col_full = {}\n    for c in range(w):\n        v = grid[0][c]\n        ok = True\n        for r in range(h):\n            if grid[r][c] != v:\n                ok = False\n                break\n        if ok:\n            col_full[v] = col_full.get(v, 0) + 1\n\n    sep_color = None\n    best = -1\n    for v in set(row_full) | set(col_full):\n        score = row_full.get(v, 0) + col_full.get(v, 0)\n        if score > best:\n            best = score\n            sep_color = v\n\n    # Split into content row/col bands between separator rows/cols.\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = []\n    for c in range(w):\n        if all(grid[r][c] == sep_color for r in range(h)):\n            sep_cols.append(c)\n\n    row_bands = []\n    start = 0\n    for r in sep_rows:\n        if start < r:\n            row_bands.append((start, r - 1))\n        start = r + 1\n    if start < h:\n        row_bands.append((start, h - 1))\n\n    col_bands = []\n    start = 0\n    for c in sep_cols:\n        if start < c:\n            col_bands.append((start, c - 1))\n        start = c + 1\n    if start < w:\n        col_bands.append((start, w - 1))\n\n    nr = len(row_bands)\n    nc = len(col_bands)\n\n    # Read cell colors.\n    cells = [[0] * nc for _ in range(nr)]\n    for i, (r0, r1) in enumerate(row_bands):\n        for j, (c0, c1) in enumerate(col_bands):\n            color = 0\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        color = v\n                        break\n                if color:\n                    break\n            cells[i][j] = color\n\n    # Group positions by color.\n    positions = {}\n    for i in range(nr):\n        for j in range(nc):\n            v = cells[i][j]\n            if v != 0:\n                positions.setdefault(v, []).append((i, j))\n\n    # Connect same-colored cells horizontally within rows and vertically within columns.\n    out_cells = [row[:] for row in cells]\n\n    for color, pts in positions.items():\n        by_row = {}\n        by_col = {}\n        for i, j in pts:\n            by_row.setdefault(i, []).append(j)\n            by_col.setdefault(j, []).append(i)\n\n        for i, js in by_row.items():\n            if len(js) >= 2:\n                a, b = min(js), max(js)\n                for j in range(a, b + 1):\n                    if out_cells[i][j] in (0, color):\n                        out_cells[i][j] = color\n\n        for j, is_ in by_col.items():\n            if len(is_) >= 2:\n                a, b = min(is_), max(is_)\n                for i in range(a, b + 1):\n                    if out_cells[i][j] in (0, color):\n                        out_cells[i][j] = color\n\n    # Write back to full grid.\n    out = [row[:] for row in grid]\n    for i, (r0, r1) in enumerate(row_bands):\n        for j, (c0, c1) in enumerate(col_bands):\n            color = out_cells[i][j]\n            fill = color if color != 0 else 0\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    out[r][c] = fill\n\n    # Restore separator rows/cols exactly.\n    for r in sep_rows:\n        for c in range(w):\n            out[r][c] = sep_color\n    for c in sep_cols:\n        for r in range(h):\n            out[r][c] = sep_color\n\n    return out",
