  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    out = [row[:] for row in grid]\n\n    def neighbors(r, c):\n        if r > 0:\n            yield r - 1, c\n        if r + 1 < h:\n            yield r + 1, c\n        if c > 0:\n            yield r, c - 1\n        if c + 1 < w:\n            yield r, c + 1\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            min_r = max_r = r\n            min_c = max_c = c\n\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                if cr < min_r:\n                    min_r = cr\n                if cr > max_r:\n                    max_r = cr\n                if cc < min_c:\n                    min_c = cc\n                if cc > max_c:\n                    max_c = cc\n\n                for nr, nc in neighbors(cr, cc):\n                    if not visited[nr][nc] and grid[nr][nc] == color:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            for cr, cc in cells:\n                out[cr][cc] = 0\n\n            for rr in range(min_r, max_r + 1):\n                for cc in range(min_c, max_c + 1):\n                    if rr == min_r or rr == max_r or cc == min_c or cc == max_c:\n                        out[rr][cc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    out = [row[:] for row in grid]\n\n    def neighbors(r, c):\n        if r > 0:\n            yield r - 1, c\n        if r + 1 < h:\n            yield r + 1, c\n        if c > 0:\n            yield r, c - 1\n        if c + 1 < w:\n            yield r, c + 1\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            min_r = max_r = r\n            min_c = max_c = c\n\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                if cr < min_r:\n                    min_r = cr\n                if cr > max_r:\n                    max_r = cr\n                if cc < min_c:\n                    min_c = cc\n                if cc > max_c:\n                    max_c = cc\n\n                for nr, nc in neighbors(cr, cc):\n                    if not visited[nr][nc] and grid[nr][nc] == color:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            for cr, cc in cells:\n                out[cr][cc] = 0\n\n            for rr in range(min_r, max_r + 1):\n                for cc in range(min_c, max_c + 1):\n                    if rr == min_r or rr == max_r or cc == min_c or cc == max_c:\n                        out[rr][cc] = color\n\n    return out",
