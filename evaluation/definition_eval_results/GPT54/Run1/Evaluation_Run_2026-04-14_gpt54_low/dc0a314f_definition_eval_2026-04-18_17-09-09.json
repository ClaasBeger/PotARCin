 9 5 2 9 9 9 6 6 9 9 9 2 5 9 5\n5 9 5 2 9 9 9 6 6 9 9 9 2 5 9 5\n9 2 5 5 9 9 7 9 9 7 9 9 5 5 2 9\n9 5 2 9 6 6 9 9 9 9 6 6 9 2 5 9\n9 9 9 5 9 6 9 9 9 9 6 9 5 9 9 9\n2 4 4 4 5 9 5 2 2 5 9 5 4 4 4 2\n5 4 5 4 9 2 5 5 5 5 2 9 4 5 4 5\n2 5 4 4 9 5 2 9 9 2 5 9 4 4 5 2\n2 2 5 2 9 9 9 5 5 9 9 9 2 5 2 2\nOutput:\n5 5 9 9 9\n9 9 2 5 9\n5 5 5 2 9\n2 2 5 9 5\n9 9 9 6 9\n\nBelow is a test input grid.\n\nInput:\n5 5 2 5 2 5 5 5 5 5 5 2 5 2 5 5\n5 2 2 5 5 5 2 2 2 2 5 5 5 2 2 5\n2 2 5 8 5 2 2 5 5 2 2 5 8 5 2 2\n5 5 8 5 5 2 5 5 5 5 2 5 5 8 5 5\n2 5 5 5 4 6 6 9 3 3 3 3 3 5 5 2\n5 5 2 2 6 6 9 9 3 3 3 3 3 2 5 5\n5 2 2 5 6 9 6 9 3 3 3 3 3 2 2 5\n5 2 5 5 9 9 9 9 3 3 3 3 3 5 2 5\n5 2 5 5 9 9 9 9 3 3 3 3 3 5 2 5\n5 2 2 5 6 9 6 9 9 6 9 6 5 2 2 5\n5 5 2 2 6 6 9 9 9 9 6 6 2 2 5 5\n2 5 5 5 4 6 6 9 9 6 6 4 5 5 5 2\n5 5 8 5 5 2 5 5 5 5 2 5 5 8 5 5\n2 2 5 8 5 2 2 5 5 2 2 5 8 5 2 2\n5 2 2 5 5 5 2 2 2 2 5 5 5 2 2 5\n5 5 2 5 2 5 5 5 5 5 5 2 5 2 5 5\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    m, n = len(grid), len(grid[0])\n\n    # Find the 5x5 block of 3s\n    target = None\n    for r in range(m - 4):\n        for c in range(n - 4):\n            ok = True\n            for i in range(5):\n                for j in range(5):\n                    if grid[r + i][c + j] != 3:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                target = (r, c)\n                break\n        if target is not None:\n            break\n\n    if target is None:\n        return []\n\n    r, c = target\n\n    def block_has_no_3(rr, cc):\n        if rr < 0 or cc < 0 or rr + 5 > m or cc + 5 > n:\n            return False\n        for i in range(5):\n            for j in range(5):\n                if grid[rr + i][cc + j] == 3:\n                    return False\n        return True\n\n    # Vertical reflection\n    vc = n - c - 5\n    if block_has_no_3(r, vc):\n        return [list(reversed(grid[r + i][vc:vc + 5])) for i in range(5)]\n\n    # Horizontal reflection\n    vr = m - r - 5\n    if block_has_no_3(vr, c):\n        return [grid[vr + i][c:c + 5] for i in range(4, -1, -1)]\n\n    # 180-degree rotation\n    if block_has_no_3(vr, vc):\n        return [list(reversed(grid[vr + i][vc:vc + 5])) for i in range(4, -1, -1)]\n\n    return []",
  "script": "def solve(grid):\n    m, n = len(grid), len(grid[0])\n\n    # Find the 5x5 block of 3s\n    target = None\n    for r in range(m - 4):\n        for c in range(n - 4):\n            ok = True\n            for i in range(5):\n                for j in range(5):\n                    if grid[r + i][c + j] != 3:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                target = (r, c)\n                break\n        if target is not None:\n            break\n\n    if target is None:\n        return []\n\n    r, c = target\n\n    def block_has_no_3(rr, cc):\n        if rr < 0 or cc < 0 or rr + 5 > m or cc + 5 > n:\n            return False\n        for i in range(5):\n            for j in range(5):\n                if grid[rr + i][cc + j] == 3:\n                    return False\n        return True\n\n    # Vertical reflection\n    vc = n - c - 5\n    if block_has_no_3(r, vc):\n        return [list(reversed(grid[r + i][vc:vc + 5])) for i in range(5)]\n\n    # Horizontal reflection\n    vr = m - r - 5\n    if block_has_no_3(vr, c):\n        return [grid[vr + i][c:c + 5] for i in range(4, -1, -1)]\n\n    # 180-degree rotation\n    if block_has_no_3(vr, vc):\n        return [list(reversed(grid[vr + i][vc:vc + 5])) for i in range(4, -1, -1)]\n\n    return []",
