ue\n\n            interior_h = rect_h - 2\n            interior_w = rect_w - 2\n            fill = 7 if (interior_h * interior_w) % 2 == 1 else 2\n\n            for rr in range(r0 + 1, r1):\n                for cc in range(c0 + 1, c1):\n                    out[rr][cc] = fill\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n\n    def neighbors(r, c):\n        if r > 0:\n            yield r - 1, c\n        if r + 1 < h:\n            yield r + 1, c\n        if c > 0:\n            yield r, c - 1\n        if c + 1 < w:\n            yield r, c + 1\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 1 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                for nr, nc in neighbors(cr, cc):\n                    if grid[nr][nc] == 1 and not visited[nr][nc]:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            rs = [x for x, _ in cells]\n            cs = [y for _, y in cells]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n\n            rect_h = r1 - r0 + 1\n            rect_w = c1 - c0 + 1\n\n            if rect_h < 3 or rect_w < 3:\n                continue\n\n            cellset = set(cells)\n            border_count = 2 * rect_h + 2 * rect_w - 4\n            if len(cellset) != border_count:\n                continue\n\n            ok = True\n            for rr in range(r0, r1 + 1):\n                for cc in range(c0, c1 + 1):\n                    on_border = rr == r0 or rr == r1 or cc == c0 or cc == c1\n                    if on_border:\n                        if grid[rr][cc] != 1:\n                            ok = False\n                            break\n                    else:\n                        if grid[rr][cc] != 0:\n                            ok = False\n                            break\n                if not ok:\n                    break\n\n            if not ok:\n                continue\n\n            interior_h = rect_h - 2\n            interior_w = rect_w - 2\n            fill = 7 if (interior_h * interior_w) % 2 == 1 else 2\n\n            for rr in range(r0 + 1, r1):\n                for cc in range(c0 + 1, c1):\n                    out[rr][cc] = fill\n\n    return out",
