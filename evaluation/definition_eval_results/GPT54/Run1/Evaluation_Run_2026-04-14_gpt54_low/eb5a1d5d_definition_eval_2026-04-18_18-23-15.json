  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    if h == 0 or w == 0:\n        return []\n\n    layers = []\n    current_color = grid[0][0]\n    layers.append(current_color)\n\n    top, left, bottom, right = 0, 0, h - 1, w - 1\n\n    while True:\n        min_r, max_r = h, -1\n        min_c, max_c = w, -1\n\n        for r in range(top, bottom + 1):\n            row = grid[r]\n            for c in range(left, right + 1):\n                if row[c] != current_color:\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n        if max_r == -1:\n            break\n\n        next_color = None\n        for r in range(min_r, max_r + 1):\n            for c in range(min_c, max_c + 1):\n                if grid[r][c] != current_color:\n                    next_color = grid[r][c]\n                    break\n            if next_color is not None:\n                break\n\n        layers.append(next_color)\n        current_color = next_color\n        top, left, bottom, right = min_r, min_c, max_r, max_c\n\n    n = 2 * len(layers) - 1\n    out = [[layers[0] for _ in range(n)] for _ in range(n)]\n\n    for i, color in enumerate(layers):\n        for r in range(i, n - i):\n            for c in range(i, n - i):\n                out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    if h == 0 or w == 0:\n        return []\n\n    layers = []\n    current_color = grid[0][0]\n    layers.append(current_color)\n\n    top, left, bottom, right = 0, 0, h - 1, w - 1\n\n    while True:\n        min_r, max_r = h, -1\n        min_c, max_c = w, -1\n\n        for r in range(top, bottom + 1):\n            row = grid[r]\n            for c in range(left, right + 1):\n                if row[c] != current_color:\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n        if max_r == -1:\n            break\n\n        next_color = None\n        for r in range(min_r, max_r + 1):\n            for c in range(min_c, max_c + 1):\n                if grid[r][c] != current_color:\n                    next_color = grid[r][c]\n                    break\n            if next_color is not None:\n                break\n\n        layers.append(next_color)\n        current_color = next_color\n        top, left, bottom, right = min_r, min_c, max_r, max_c\n\n    n = 2 * len(layers) - 1\n    out = [[layers[0] for _ in range(n)] for _ in range(n)]\n\n    for i, color in enumerate(layers):\n        for r in range(i, n - i):\n            for c in range(i, n - i):\n                out[r][c] = color\n\n    return out",
