  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    full_rows = [r for r in range(h) if all(grid[r][c] == 8 for c in range(w))]\n    full_cols = [c for c in range(w) if all(grid[r][c] == 8 for r in range(h))]\n\n    if len(full_rows) < 2 or len(full_cols) < 2:\n        return [row[:] for row in grid]\n\n    r1, r2 = full_rows[0], full_rows[1]\n    c1, c2 = full_cols[0], full_cols[1]\n\n    out = [row[:] for row in grid]\n\n    # Top-middle -> 2\n    for r in range(0, r1):\n        for c in range(c1 + 1, c2):\n            if out[r][c] != 8:\n                out[r][c] = 2\n\n    # Middle-left -> 4\n    for r in range(r1 + 1, r2):\n        for c in range(0, c1):\n            if out[r][c] != 8:\n                out[r][c] = 4\n\n    # Middle-middle -> 6\n    for r in range(r1 + 1, r2):\n        for c in range(c1 + 1, c2):\n            if out[r][c] != 8:\n                out[r][c] = 6\n\n    # Middle-right -> 3\n    for r in range(r1 + 1, r2):\n        for c in range(c2 + 1, w):\n            if out[r][c] != 8:\n                out[r][c] = 3\n\n    # Bottom-middle -> 1\n    for r in range(r2 + 1, h):\n        for c in range(c1 + 1, c2):\n            if out[r][c] != 8:\n                out[r][c] = 1\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    full_rows = [r for r in range(h) if all(grid[r][c] == 8 for c in range(w))]\n    full_cols = [c for c in range(w) if all(grid[r][c] == 8 for r in range(h))]\n\n    if len(full_rows) < 2 or len(full_cols) < 2:\n        return [row[:] for row in grid]\n\n    r1, r2 = full_rows[0], full_rows[1]\n    c1, c2 = full_cols[0], full_cols[1]\n\n    out = [row[:] for row in grid]\n\n    # Top-middle -> 2\n    for r in range(0, r1):\n        for c in range(c1 + 1, c2):\n            if out[r][c] != 8:\n                out[r][c] = 2\n\n    # Middle-left -> 4\n    for r in range(r1 + 1, r2):\n        for c in range(0, c1):\n            if out[r][c] != 8:\n                out[r][c] = 4\n\n    # Middle-middle -> 6\n    for r in range(r1 + 1, r2):\n        for c in range(c1 + 1, c2):\n            if out[r][c] != 8:\n                out[r][c] = 6\n\n    # Middle-right -> 3\n    for r in range(r1 + 1, r2):\n        for c in range(c2 + 1, w):\n            if out[r][c] != 8:\n                out[r][c] = 3\n\n    # Bottom-middle -> 1\n    for r in range(r2 + 1, h):\n        for c in range(c1 + 1, c2):\n            if out[r][c] != 8:\n                out[r][c] = 1\n\n    return out",
