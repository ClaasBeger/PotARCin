  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    marker_positions = []\n    shape_color = None\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 5:\n                marker_positions.append((r, c))\n            elif v != 0:\n                shape_color = v\n\n    if not marker_positions or shape_color is None:\n        return out\n\n    min_r = min(r for r, _ in marker_positions)\n    max_r = max(r for r, _ in marker_positions)\n    min_c = min(c for _, c in marker_positions)\n    max_c = max(c for _, c in marker_positions)\n\n    top = min_r + 1\n    bottom = max_r - 1\n    left = min_c + 1\n    right = max_c - 1\n\n    if top > bottom or left > right:\n        return out\n\n    for c in range(left, right + 1):\n        if out[top][c] != 5:\n            out[top][c] = shape_color\n        if out[bottom][c] != 5:\n            out[bottom][c] = shape_color\n\n    for r in range(top, bottom + 1):\n        if out[r][left] != 5:\n            out[r][left] = shape_color\n        if out[r][right] != 5:\n            out[r][right] = shape_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    marker_positions = []\n    shape_color = None\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 5:\n                marker_positions.append((r, c))\n            elif v != 0:\n                shape_color = v\n\n    if not marker_positions or shape_color is None:\n        return out\n\n    min_r = min(r for r, _ in marker_positions)\n    max_r = max(r for r, _ in marker_positions)\n    min_c = min(c for _, c in marker_positions)\n    max_c = max(c for _, c in marker_positions)\n\n    top = min_r + 1\n    bottom = max_r - 1\n    left = min_c + 1\n    right = max_c - 1\n\n    if top > bottom or left > right:\n        return out\n\n    for c in range(left, right + 1):\n        if out[top][c] != 5:\n            out[top][c] = shape_color\n        if out[bottom][c] != 5:\n            out[bottom][c] = shape_color\n\n    for r in range(top, bottom + 1):\n        if out[r][left] != 5:\n            out[r][left] = shape_color\n        if out[r][right] != 5:\n            out[r][right] = shape_color\n\n    return out",
