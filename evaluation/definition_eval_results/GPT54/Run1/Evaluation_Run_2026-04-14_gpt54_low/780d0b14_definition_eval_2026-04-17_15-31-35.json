  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    zero_rows = [all(v == 0 for v in row) for row in grid]\n    zero_cols = [all(grid[r][c] == 0 for r in range(h)) for c in range(w)]\n\n    row_blocks = []\n    i = 0\n    while i < h:\n        if zero_rows[i]:\n            i += 1\n            continue\n        j = i\n        while j < h and not zero_rows[j]:\n            j += 1\n        row_blocks.append((i, j))\n        i = j\n\n    col_blocks = []\n    i = 0\n    while i < w:\n        if zero_cols[i]:\n            i += 1\n            continue\n        j = i\n        while j < w and not zero_cols[j]:\n            j += 1\n        col_blocks.append((i, j))\n        i = j\n\n    out = []\n    for r0, r1 in row_blocks:\n        out_row = []\n        for c0, c1 in col_blocks:\n            color = 0\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    if grid[r][c] != 0:\n                        color = grid[r][c]\n                        break\n                if color != 0:\n                    break\n            out_row.append(color)\n        out.append(out_row)\n\n    return out",
