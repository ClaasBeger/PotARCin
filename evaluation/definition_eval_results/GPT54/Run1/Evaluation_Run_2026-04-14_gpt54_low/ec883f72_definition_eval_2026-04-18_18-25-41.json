  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                colors.setdefault(v, []).append((r, c))\n\n    if not colors:\n        return grid\n\n    def bbox(cells):\n        rs = [r for r, _ in cells]\n        cs = [c for _, c in cells]\n        return min(rs), max(rs), min(cs), max(cs)\n\n    def is_frame_color(cells):\n        r0, r1, c0, c1 = bbox(cells)\n        s = set(cells)\n        for r, c in cells:\n            if not (r == r0 or r == r1 or c == c0 or c == c1):\n                return False\n        corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]\n        occupied_corners = sum((corner in s) for corner in corners)\n        return occupied_corners >= 1\n\n    frame_color = None\n    for color, cells in colors.items():\n        if is_frame_color(cells):\n            frame_color = color\n            break\n\n    if frame_color is None:\n        return [row[:] for row in grid]\n\n    out = [row[:] for row in grid]\n    frame_cells = colors[frame_color]\n    r0, r1, c0, c1 = bbox(frame_cells)\n    frame_set = set(frame_cells)\n    frame_corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]\n    occupied_corners = [corner for corner in frame_corners if corner in frame_set]\n\n    def sign(x):\n        return (x > 0) - (x < 0)\n\n    for color, cells in colors.items():\n        if color == frame_color:\n            continue\n        for rr, cc in cells:\n            for cr, ccorn in occupied_corners:\n                dr = cr - rr\n                dc = ccorn - cc\n                if dr == 0 or dc == 0:\n                    continue\n                if abs(dr) != abs(dc):\n                    continue\n                sr = sign(dr)\n                sc = sign(dc)\n                nr, nc = cr + sr, ccorn + sc\n                while 0 <= nr < h and 0 <= nc < w:\n                    if out[nr][nc] == 