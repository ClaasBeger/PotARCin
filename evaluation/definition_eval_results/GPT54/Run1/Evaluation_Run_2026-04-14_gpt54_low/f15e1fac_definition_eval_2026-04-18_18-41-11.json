  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def border_has_color(border, color):\n        if border == 'top':\n            return any(v == color for v in grid[0])\n        if border == 'bottom':\n            return any(v == color for v in grid[h - 1])\n        if border == 'left':\n            return any(grid[r][0] == color for r in range(h))\n        if border == 'right':\n            return any(grid[r][w - 1] == color for r in range(h))\n        return False\n\n    borders = ['top', 'bottom', 'left', 'right']\n    source_border = next(b for b in borders if border_has_color(b, 8))\n    anchor_border = next(b for b in borders if border_has_color(b, 2))\n\n    out = [row[:] for row in grid]\n\n    if source_border in ('top', 'bottom'):\n        source_row = 0 if source_border == 'top' else h - 1\n        source_cols = [c for c in range(w) if grid[source_row][c] == 8]\n\n        anchor_col = 0 if anchor_border == 'left' else w - 1\n        anchor_rows = [r for r in range(h) if grid[r][anchor_col] == 2]\n\n        shift_sign = 1 if anchor_border == 'left' else -1\n\n        for r in range(h):\n            k = sum(1 for ar in anchor_rows if ar <= r)\n            for c in source_cols:\n                nc = c + shift_sign * k\n                if 0 <= nc < w and out[r][nc] == 0:\n                    out[r][nc] = 8\n\n    else:\n        source_col = 0 if source_border == 'left' else w - 1\n        source_rows = [r for r in range(h) if grid[r][source_col] == 8]\n\n        anchor_row = 0 if anchor_border == 'top' else h - 1\n        anchor_cols = [c for c in range(w) if grid[anchor_row][c] == 2]\n\n        shift_sign = 1 if anchor_border == 'top' else -1\n\n        for c in range(w):\n            k = sum(1 for ac in anchor_cols if ac <= c)\n            for r in source_rows:\n                nr = r + shift_sign * k\n                if 0 <= nr < h and out[nr][c] == 0:\n                    out[nr][c] = 8\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def border_has_color(border, color):\n        if border == 'top':\n            return any(v == color for v in grid[0])\n        if border == 'bottom':\n            return any(v == color for v in grid[h - 1])\n        if border == 'left':\n            return any(grid[r][0] == color for r in range(h))\n        if border == 'right':\n            return any(grid[r][w - 1] == color for r in range(h))\n        return False\n\n    borders = ['top', 'bottom', 'left', 'right']\n    source_border = next(b for b in borders if border_has_color(b, 8))\n    anchor_border = next(b for b in borders if border_has_color(b, 2))\n\n    out = [row[:] for row in grid]\n\n    if source_border in ('top', 'bottom'):\n        source_row = 0 if source_border == 'top' else h - 1\n        source_cols = [c for c in range(w) if grid[source_row][c] == 8]\n\n        anchor_col = 0 if anchor_border == 'left' else w - 1\n        anchor_rows = [r for r in range(h) if grid[r][anchor_col] == 2]\n\n        shift_sign = 1 if anchor_border == 'left' else -1\n\n        for r in range(h):\n            k = sum(1 for ar in anchor_rows if ar <= r)\n            for c in source_cols:\n                nc = c + shift_sign * k\n                if 0 <= nc < w and out[r][nc] == 0:\n                    out[r][nc] = 8\n\n    else:\n        source_col = 0 if source_border == 'left' else w - 1\n        source_rows = [r for r in range(h) if grid[r][source_col] == 8]\n\n        anchor_row = 0 if anchor_border == 'top' else h - 1\n        anchor_cols = [c for c in range(w) if grid[anchor_row][c] == 2]\n\n        shift_sign = 1 if anchor_border == 'top' else -1\n\n        for c in range(w):\n            k = sum(1 for ac in anchor_cols if ac <= c)\n            for r in source_rows:\n                nr = r + shift_sign * k\n                if 0 <= nr < h and out[nr][c] == 0:\n                    out[nr][c] = 8\n\n    return out",
