r r, c in other_cells:\n            for nr, nc in (\n                (r, c),\n                (r, 2 * cc - c),\n                (2 * cr - r, c),\n                (2 * cr - r, 2 * cc - c),\n            ):\n                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in x_set:\n                    out[nr][nc] = other_color\n\n    for r, c in x_cells:\n        out[r][c] = x_color\n\n    return out",
