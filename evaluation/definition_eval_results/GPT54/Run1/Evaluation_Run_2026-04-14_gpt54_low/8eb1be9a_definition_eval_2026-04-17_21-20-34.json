  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    nonzero_rows = [i for i, row in enumerate(grid) if any(v != 0 for v in row)]\n    if not nonzero_rows:\n        return [row[:] for row in grid]\n\n    start = min(nonzero_rows)\n    end = max(nonzero_rows)\n    pattern = [grid[i][:] for i in range(start, end + 1)]\n    p = len(pattern)\n\n    out = []\n    for r in range(h):\n        out.append(pattern[(r - start) % p][:])\n    return out",
