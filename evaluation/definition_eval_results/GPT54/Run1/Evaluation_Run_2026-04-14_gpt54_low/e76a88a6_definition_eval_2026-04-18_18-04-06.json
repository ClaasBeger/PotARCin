  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                yield nr, nc\n\n    components = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                colors = set()\n                while stack:\n                    cr, cc = stack.pop()\n                    cells.append((cr, cc))\n                    colors.add(grid[cr][cc])\n                    for nr, nc in neighbors(cr, cc):\n                        if grid[nr][nc] != 0 and not visited[nr][nc]:\n                            visited[nr][nc] = True\n                            stack.append((nr, nc))\n                components.append((cells, colors))\n\n    source_bbox = None\n    source_pattern = None\n    targets = []\n\n    for cells, colors in components:\n        min_r = min(r for r, c in cells)\n        max_r = max(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        max_c = max(c for r, c in cells)\n        bh = max_r - min_r + 1\n        bw = max_c - min_c + 1\n\n        if colors == {5}:\n            if len(cells) == bh * bw:\n                targets.append((min_r, min_c, bh, bw))\n        else:\n            source_bbox = (min_r, min_c, bh, bw)\n            source_pattern = [\n                [grid[min_r + i][min_c + j] for j in range(bw)]\n                for i in range(bh)\n            ]\n\n    if source_pattern is None:\n        return [row[:] for row in grid]\n\n    out = [row[:] for row in grid]\n    sh = len(source_pattern)\n    sw = len(source_pattern[0])\n\n    for tr, tc, th, tw in targets:\n        if th == sh and tw == sw: