  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def dominant_nonzero(values):\n        counts = {}\n        for v in values:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n        if not counts:\n            return 0\n        return max(counts, key=counts.get)\n\n    row_scores = []\n    for r in range(h):\n        nz = sum(1 for v in grid[r] if v != 0)\n        row_scores.append((nz, r))\n    row_scores.sort(reverse=True)\n    r1 = row_scores[0][1]\n    r2 = row_scores[1][1]\n    top, bottom = sorted([r1, r2])\n\n    col_scores = []\n    for c in range(w):\n        nz = sum(1 for r in range(h) if grid[r][c] != 0)\n        col_scores.append((nz, c))\n    col_scores.sort(reverse=True)\n    c1 = col_scores[0][1]\n    c2 = col_scores[1][1]\n    left, right = sorted([c1, c2])\n\n    top_color = dominant_nonzero(grid[top])\n    bottom_color = dominant_nonzero(grid[bottom])\n    left_color = dominant_nonzero([grid[r][left] for r in range(h)])\n    right_color = dominant_nonzero([grid[r][right] for r in range(h)])\n\n    inner_counts = {top_color: 0, bottom_color: 0, left_color: 0, right_color: 0}\n    for r in range(top + 1, bottom):\n        for c in range(left + 1, right):\n            v = grid[r][c]\n            if v in inner_counts:\n                inner_counts[v] += 1\n\n    obj_color = max(inner_counts, key=inner_counts.get)\n\n    out_h = bottom - top + 1\n    out_w = right - left + 1\n    out = [[0] * out_w for _ in range(out_h)]\n\n    for c in range(out_w):\n        if c == 0:\n            out[0][c] = left_color\n            out[-1][c] = left_color\n        elif c == out_w - 1:\n            out[0][c] = right_color\n            out[-1][c] = right_color\n        else:\n            out[0][c] = top_color\n            out[-1][c] = bottom_color\n\n    for r in range(1, out_h - 1):\n        out[r][0] = left_color\n        out[r][-1] = right_color\n\n    if obj_color == right_color:\n        for r in range