  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    row_to_cols = {}\n    for r in range(h):\n        cols = {c for c in range(w) if grid[r][c] == 4}\n        if cols:\n            row_to_cols[r] = cols\n\n    rows = sorted(row_to_cols.keys())\n\n    for i in range(len(rows)):\n        r1 = rows[i]\n        for j in range(i + 1, len(rows)):\n            r2 = rows[j]\n            common_cols = sorted(row_to_cols[r1] & row_to_cols[r2])\n            for a in range(len(common_cols)):\n                c1 = common_cols[a]\n                for b in range(a + 1, len(common_cols)):\n                    c2 = common_cols[b]\n                    for r in range(r1 + 1, r2):\n                        for c in range(c1 + 1, c2):\n                            if out[r][c] == 0:\n                                out[r][c] = 2\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    row_to_cols = {}\n    for r in range(h):\n        cols = {c for c in range(w) if grid[r][c] == 4}\n        if cols:\n            row_to_cols[r] = cols\n\n    rows = sorted(row_to_cols.keys())\n\n    for i in range(len(rows)):\n        r1 = rows[i]\n        for j in range(i + 1, len(rows)):\n            r2 = rows[j]\n            common_cols = sorted(row_to_cols[r1] & row_to_cols[r2])\n            for a in range(len(common_cols)):\n                c1 = common_cols[a]\n                for b in range(a + 1, len(common_cols)):\n                    c2 = common_cols[b]\n                    for r in range(r1 + 1, r2):\n                        for c in range(c1 + 1, c2):\n                            if out[r][c] == 0:\n                                out[r][c] = 2\n\n    return out",
