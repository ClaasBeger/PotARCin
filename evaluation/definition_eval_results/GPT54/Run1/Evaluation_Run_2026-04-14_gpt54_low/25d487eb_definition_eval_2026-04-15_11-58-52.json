  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Count non-zero colors\n    counts = {}\n    positions = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n                positions.setdefault(v, []).append((r, c))\n\n    if not counts:\n        return grid\n\n    # The marker color is the one appearing once\n    marker_color = None\n    marker_pos = None\n    for color, cnt in counts.items():\n        if cnt == 1:\n            marker_color = color\n            marker_pos = positions[color][0]\n            break\n\n    if marker_color is None:\n        return grid\n\n    mr, mc = marker_pos\n\n    # Bounding box of all non-zero cells\n    nonzero_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n    min_r = min(r for r, c in nonzero_cells)\n    max_r = max(r for r, c in nonzero_cells)\n    min_c = min(c for r, c in nonzero_cells)\n    max_c = max(c for r, c in nonzero_cells)\n\n    # Determine extension direction from marker's position on the bounding box\n    dr, dc = 0, 0\n    if mr == min_r:\n        dr, dc = 1, 0\n    elif mr == max_r:\n        dr, dc = -1, 0\n    elif mc == min_c:\n        dr, dc = 0, 1\n    elif mc == max_c:\n        dr, dc = 0, -1\n    else:\n        return grid\n\n    # Copy grid and extend marker color through background cells to the edge\n    out = [row[:] for row in grid]\n    r, c = mr + dr, mc + dc\n    while 0 <= r < h and 0 <= c < w:\n        if out[r][c] == 0:\n            out[r][c] = marker_color\n        r += dr\n        c += dc\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Count non-zero colors\n    counts = {}\n    positions = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n                positions.setdefault(v, []).append((r, c))\n\n    if not counts:\n        return grid\n\n    # The marker color is the one appearing once\n    marker_color = None\n    marker_pos = None\n    for color, cnt in counts.items():\n        if cnt == 1:\n            marker_color = color\n            marker_pos = positions[color][0]\n            break\n\n    if marker_color is None:\n        return grid\n\n    mr, mc = marker_pos\n\n    # Bounding box of all non-zero cells\n    nonzero_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n    min_r = min(r for r, c in nonzero_cells)\n    max_r = max(r for r, c in nonzero_cells)\n    min_c = min(c for r, c in nonzero_cells)\n    max_c = max(c for r, c in nonzero_cells)\n\n    # Determine extension direction from marker's position on the bounding box\n    dr, dc = 0, 0\n    if mr == min_r:\n        dr, dc = 1, 0\n    elif mr == max_r:\n        dr, dc = -1, 0\n    elif mc == min_c:\n        dr, dc = 0, 1\n    elif mc == max_c:\n        dr, dc = 0, -1\n    else:\n        return grid\n\n    # Copy grid and extend marker color through background cells to the edge\n    out = [row[:] for row in grid]\n    r, c = mr + dr, mc + dc\n    while 0 <= r < h and 0 <= c < w:\n        if out[r][c] == 0:\n            out[r][c] = marker_color\n        r += dr\n        c += dc\n\n    return out",
