  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0])\n    assert n == 5 and m == 5\n\n    # Scale factor = number of distinct non-zero colors in last row and last column\n    border_vals = set()\n    for x in grid[4]:\n        if x != 0:\n            border_vals.add(x)\n    for i in range(5):\n        x = grid[i][4]\n        if x != 0:\n            border_vals.add(x)\n    s = len(border_vals)\n\n    out_h = 5 * s\n    out_w = 5 * s\n    out = [[0 for _ in range(out_w)] for _ in range(out_h)]\n\n    # Scale the 4x4 upper-left region\n    for r in range(4):\n        for c in range(4):\n            val = grid[r][c]\n            if val != 0:\n                for rr in range(r * s, (r + 1) * s):\n                    for cc in range(c * s, (c + 1) * s):\n                        out[rr][cc] = val\n\n    # Find bounding box of non-zero cells in the 4x4 region\n    nz = [(r, c) for r in range(4) for c in range(4) if grid[r][c] != 0]\n    if nz:\n        rmin = min(r for r, c in nz)\n        rmax = max(r for r, c in nz)\n        cmin = min(c for r, c in nz)\n        cmax = max(c for r, c in nz)\n\n        # Add color-2 diagonals in size-s corner squares adjacent to the object\n        # Top-left\n        if rmin > 0 and cmin > 0:\n            for i in range(s):\n                out[i][i] = 2\n\n        # Top-right\n        if rmin > 0 and cmax < 3:\n            cs = (cmax + 1) * s\n            for i in range(s):\n                out[i][cs + (s - 1 - i)] = 2\n\n        # Bottom-left\n        if rmax < 3 and cmin > 0:\n            rs = (rmax + 1) * s\n            for i in range(s):\n                out[rs + (s - 1 - i)][i] = 2\n\n        # Bottom-right\n        if rmax < 3 and cmax < 3:\n            rs = (rmax + 1) * s\n            cs = (cmax + 1) * s\n            for i in range(s):\n                out[rs + i][cs + i] = 2\n\n    # Scale the rightmost column of the input into the right strip\n    for r in range(5):\n        val = grid[r][4]\n        for rr in range(r * s, (r + 1) * s):\n            for cc in range(4 * s, 5 * s):\n                out[rr][cc] = val\n\n    # Scale the bottom row of the input into the bottom strip\n    for c in range(5):\n        val = grid[4][c]\n        for rr in range(4 * s, 5 * s):\n            for cc in range(c * s, (c + 1) * s):\n                out[rr][cc] = val\n\n    return out",
