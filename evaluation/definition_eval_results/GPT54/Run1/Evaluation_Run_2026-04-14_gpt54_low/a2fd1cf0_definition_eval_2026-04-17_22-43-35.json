  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pos2 = None\n    pos3 = None\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2:\n                pos2 = (r, c)\n            elif grid[r][c] == 3:\n                pos3 = (r, c)\n\n    if pos2 is None or pos3 is None:\n        return [row[:] for row in grid]\n\n    r2, c2 = pos2\n    r3, c3 = pos3\n\n    out = [row[:] for row in grid]\n\n    # Draw horizontal segment on the row of 2 toward the column of 3.\n    step_c = 1 if c3 > c2 else -1\n    for c in range(c2 + step_c, c3, step_c):\n        if out[r2][c] == 0:\n            out[r2][c] = 8\n\n    # Draw vertical segment on the column of 3 toward the row of 2.\n    step_r = 1 if r2 > r3 else -1\n    for r in range(r3 + step_r, r2, step_r):\n        if out[r][c3] == 0:\n            out[r][c3] = 8\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pos2 = None\n    pos3 = None\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2:\n                pos2 = (r, c)\n            elif grid[r][c] == 3:\n                pos3 = (r, c)\n\n    if pos2 is None or pos3 is None:\n        return [row[:] for row in grid]\n\n    r2, c2 = pos2\n    r3, c3 = pos3\n\n    out = [row[:] for row in grid]\n\n    # Draw horizontal segment on the row of 2 toward the column of 3.\n    step_c = 1 if c3 > c2 else -1\n    for c in range(c2 + step_c, c3, step_c):\n        if out[r2][c] == 0:\n            out[r2][c] = 8\n\n    # Draw vertical segment on the column of 3 toward the row of 2.\n    step_r = 1 if r2 > r3 else -1\n    for r in range(r3 + step_r, r2, step_r):\n        if out[r][c3] == 0:\n            out[r][c3] = 8\n\n    return out",
