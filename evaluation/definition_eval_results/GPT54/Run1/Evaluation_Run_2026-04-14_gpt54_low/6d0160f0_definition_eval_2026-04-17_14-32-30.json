  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Count all non-zero, non-separator values\n    counts = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != 5:\n                counts[v] = counts.get(v, 0) + 1\n\n    # Find the smallest value that appears exactly once\n    unique_vals = [v for v, cnt in counts.items() if cnt == 1]\n    if not unique_vals:\n        # Fallback: keep only separators if no unique value exists\n        return [[5 if grid[r][c] == 5 else 0 for c in range(w)] for r in range(h)]\n\n    target_val = min(unique_vals)\n\n    # Locate the unique value\n    ur = uc = None\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == target_val:\n                ur, uc = r, c\n                break\n        if ur is not None:\n            break\n\n    # Determine the 3x3 source block and the destination block coordinates\n    block_r = ur // 4\n    block_c = uc // 4\n    local_r = ur % 4\n    local_c = uc % 4\n\n    src_r0 = block_r * 4\n    src_c0 = block_c * 4\n    dst_r0 = local_r * 4\n    dst_c0 = local_c * 4\n\n    # Start with separators preserved, everything else zero\n    out = [[5 if grid[r][c] == 5 else 0 for c in range(w)] for r in range(h)]\n\n    # Copy the entire 3x3 source block into the destination 3x3 block\n    for dr in range(3):\n        for dc in range(3):\n            out[dst_r0 + dr][dst_c0 + dc] = grid[src_r0 + dr][src_c0 + dc]\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Count all non-zero, non-separator values\n    counts = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != 5:\n                counts[v] = counts.get(v, 0) + 1\n\n    # Find the smallest value that appears exactly once\n    unique_vals = [v for v, cnt in counts.items() if cnt == 1]\n    if not unique_vals:\n        # Fallback: keep only separators if no unique value exists\n        return [[5 if grid[r][c] == 5 else 0 for c in range(w)] for r in range(h)]\n\n    target_val = min(unique_vals)\n\n    # Locate the unique value\n    ur = uc = None\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == target_val:\n                ur, uc = r, c\n                break\n        if ur is not None:\n            break\n\n    # Determine the 3x3 source block and the destination block coordinates\n    block_r = ur // 4\n    block_c = uc // 4\n    local_r = ur % 4\n    local_c = uc % 4\n\n    src_r0 = block_r * 4\n    src_c0 = block_c * 4\n    dst_r0 = local_r * 4\n    dst_c0 = local_c * 4\n\n    # Start with separators preserved, everything else zero\n    out = [[5 if grid[r][c] == 5 else 0 for c in range(w)] for r in range(h)]\n\n    # Copy the entire 3x3 source block into the destination 3x3 block\n    for dr in range(3):\n        for dc in range(3):\n            out[dst_r0 + dr][dst_c0 + dc] = grid[src_r0 + dr][src_c0 + dc]\n\n    return out",
