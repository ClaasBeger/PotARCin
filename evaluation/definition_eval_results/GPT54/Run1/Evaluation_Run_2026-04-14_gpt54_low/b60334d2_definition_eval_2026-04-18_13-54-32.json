  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    pattern = [\n        [5, 1, 5],\n        [1, 0, 1],\n        [5, 1, 5],\n    ]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 5:\n                for dr in range(-1, 2):\n                    for dc in range(-1, 2):\n                        rr = r + dr\n                        cc = c + dc\n                        if 0 <= rr < h and 0 <= cc < w:\n                            out[rr][cc] = pattern[dr + 1][dc + 1]\n\n    return out",
