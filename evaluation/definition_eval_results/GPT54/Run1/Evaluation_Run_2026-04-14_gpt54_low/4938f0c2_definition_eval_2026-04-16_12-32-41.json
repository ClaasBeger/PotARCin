  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    # Find the bounding box of the color-3 anchor block\n    threes = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 3]\n    if not threes:\n        return out\n\n    min_r = min(r for r, _ in threes)\n    max_r = max(r for r, _ in threes)\n    min_c = min(c for _, c in threes)\n    max_c = max(c for _, c in threes)\n\n    # Reflection is across the horizontal/vertical midlines of the 3-block.\n    # Using sums avoids dealing with half-integers.\n    rsum = min_r + max_r\n    csum = min_c + max_c\n\n    # Mirror every non-zero, non-3 cell across both axes.\n    cells = [(r, c, grid[r][c]) for r in range(h) for c in range(w) if grid[r][c] not in (0, 3)]\n\n    for r, c, color in cells:\n        positions = [\n            (r, c),\n            (r, csum - c),\n            (rsum - r, c),\n            (rsum - r, csum - c),\n        ]\n        for rr, cc in positions:\n            if 0 <= rr < h and 0 <= cc < w and out[rr][cc] != 3:\n                out[rr][cc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    # Find the bounding box of the color-3 anchor block\n    threes = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 3]\n    if not threes:\n        return out\n\n    min_r = min(r for r, _ in threes)\n    max_r = max(r for r, _ in threes)\n    min_c = min(c for _, c in threes)\n    max_c = max(c for _, c in threes)\n\n    # Reflection is across the horizontal/vertical midlines of the 3-block.\n    # Using sums avoids dealing with half-integers.\n    rsum = min_r + max_r\n    csum = min_c + max_c\n\n    # Mirror every non-zero, non-3 cell across both axes.\n    cells = [(r, c, grid[r][c]) for r in range(h) for c in range(w) if grid[r][c] not in (0, 3)]\n\n    for r, c, color in cells:\n        positions = [\n            (r, c),\n            (r, csum - c),\n            (rsum - r, c),\n            (rsum - r, csum - c),\n        ]\n        for rr, cc in positions:\n            if 0 <= rr < h and 0 <= cc < w and out[rr][cc] != 3:\n                out[rr][cc] = color\n\n    return out",
