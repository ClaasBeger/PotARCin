  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find the bounding box of the color-2 frame\n    twos = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not twos:\n        return grid\n\n    rmin = min(r for r, _ in twos)\n    rmax = max(r for r, _ in twos)\n    cmin = min(c for _, c in twos)\n    cmax = max(c for _, c in twos)\n\n    frame_h = rmax - rmin + 1\n    frame_w = cmax - cmin + 1\n    inner_h = frame_h - 2\n    inner_w = frame_w - 2\n\n    # Find the non-zero, non-2 pattern\n    pattern_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0 and grid[r][c] != 2]\n    if not pattern_cells:\n        # Just return the cropped frame if no pattern exists\n        out = [[0] * frame_w for _ in range(frame_h)]\n        for r in range(frame_h):\n            out[r][0] = 2\n            out[r][-1] = 2\n        for c in range(frame_w):\n            out[0][c] = 2\n            out[-1][c] = 2\n        return out\n\n    prmin = min(r for r, _ in pattern_cells)\n    prmax = max(r for r, _ in pattern_cells)\n    pcmin = min(c for _, c in pattern_cells)\n    pcmax = max(c for _, c in pattern_cells)\n\n    pat_h = prmax - prmin + 1\n    pat_w = pcmax - pcmin + 1\n\n    pattern = [row[pcmin:pcmax + 1] for row in grid[prmin:prmax + 1]]\n\n    sy = inner_h // pat_h\n    sx = inner_w // pat_w\n\n    # Build output\n    out = [[0] * frame_w for _ in range(frame_h)]\n\n    # Draw border\n    for r in range(frame_h):\n        out[r][0] = 2\n        out[r][-1] = 2\n    for c in range(frame_w):\n        out[0][c] = 2\n        out[-1][c] = 2\n\n    # Scale pattern into interior\n    for pr in range(pat_h):\n        for pc in range(pat_w):\n            val = pattern[pr][pc]\n            for dr in range(sy):\n                for dc in range(sx):\n                    out[1 + pr * sy + dr][1 + pc * sx + dc] = val\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find the bounding box of the color-2 frame\n    twos = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not twos:\n        return grid\n\n    rmin = min(r for r, _ in twos)\n    rmax = max(r for r, _ in twos)\n    cmin = min(c for _, c in twos)\n    cmax = max(c for _, c in twos)\n\n    frame_h = rmax - rmin + 1\n    frame_w = cmax - cmin + 1\n    inner_h = frame_h - 2\n    inner_w = frame_w - 2\n\n    # Find the non-zero, non-2 pattern\n    pattern_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0 and grid[r][c] != 2]\n    if not pattern_cells:\n        # Just return the cropped frame if no pattern exists\n        out = [[0] * frame_w for _ in range(frame_h)]\n        for r in range(frame_h):\n            out[r][0] = 2\n            out[r][-1] = 2\n        for c in range(frame_w):\n            out[0][c] = 2\n            out[-1][c] = 2\n        return out\n\n    prmin = min(r for r, _ in pattern_cells)\n    prmax = max(r for r, _ in pattern_cells)\n    pcmin = min(c for _, c in pattern_cells)\n    pcmax = max(c for _, c in pattern_cells)\n\n    pat_h = prmax - prmin + 1\n    pat_w = pcmax - pcmin + 1\n\n    pattern = [row[pcmin:pcmax + 1] for row in grid[prmin:prmax + 1]]\n\n    sy = inner_h // pat_h\n    sx = inner_w // pat_w\n\n    # Build output\n    out = [[0] * frame_w for _ in range(frame_h)]\n\n    # Draw border\n    for r in range(frame_h):\n        out[r][0] = 2\n        out[r][-1] = 2\n    for c in range(frame_w):\n        out[0][c] = 2\n        out[-1][c] = 2\n\n    # Scale pattern into interior\n    for pr in range(pat_h):\n        for pc in range(pat_w):\n            val = pattern[pr][pc]\n            for dr in range(sy):\n                for dc in range(sx):\n                    out[1 + pr * sy + dr][1 + pc * sx + dc] = val\n\n    return out",
