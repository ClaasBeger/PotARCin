  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                rows = [x for x, _ in cells]\n                cols = [y for _, y in cells]\n                r0, r1 = min(rows), max(rows) + 1\n                c0, c1 = min(cols), max(cols) + 1\n                components.append((r0, r1, c0, c1, color))\n\n    if not components:\n        return []\n\n    row_bounds = sorted(set([r0 for r0, r1, c0, c1, color in components] +\n                            [r1 for r0, r1, c0, c1, color in components]))\n    col_bounds = sorted(set([c0 for r0, r1, c0, c1, color in components] +\n                            [c1 for r0, r1, c0, c1, color in components]))\n\n    out = []\n    for i in range(len(row_bounds) - 1):\n        row = []\n        r = row_bounds[i]\n        for j in range(len(col_bounds) - 1):\n            c = col_bounds[j]\n            row.append(grid[r][c])\n        out.append(row)\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                rows = [x for x, _ in cells]\n                cols = [y for _, y in cells]\n                r0, r1 = min(rows), max(rows) + 1\n                c0, c1 = min(cols), max(cols) + 1\n                components.append((r0, r1, c0, c1, color))\n\n    if not components:\n        return []\n\n    row_bounds = sorted(set([r0 for r0, r1, c0, c1, color in components] +\n                            [r1 for r0, r1, c0, c1, color in components]))\n    col_bounds = sorted(set([c0 for r0, r1, c0, c1, color in components] +\n                            [c1 for r0, r1, c0, c1, color in components]))\n\n    out = []\n    for i in range(len(row_bounds) - 1):\n        row = []\n        r = row_bounds[i]\n        for j in range(len(col_bounds) - 1):\n            c = col_bounds[j]\n            row.append(grid[r][c])\n        out.append(row)\n\n    return out",
