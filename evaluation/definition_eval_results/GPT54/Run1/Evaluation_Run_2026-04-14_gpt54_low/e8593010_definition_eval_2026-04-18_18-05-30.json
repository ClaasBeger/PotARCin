5 5 5 5 0 5 5 5\n0 5 5 0 5 5 0 5 0 0\n5 5 0 5 5 5 5 5 0 5\n5 5 0 5 5 5 5 5 5 0\n0 0 5 5 5 5 0 5 5 5\n5 5 5 5 0 5 0 0 5 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    seen = [[False] * w for _ in range(h)]\n    color_map = {1: 3, 2: 2, 3: 1}\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 0 and not seen[r][c]:\n                stack = [(r, c)]\n                seen[r][c] = True\n                comp = []\n\n                while stack:\n                    x, y = stack.pop()\n                    comp.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == 0:\n                            seen[nx][ny] = True\n                            stack.append((nx, ny))\n\n                color = color_map.get(len(comp), 0)\n                for x, y in comp:\n                    out[x][y] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    seen = [[False] * w for _ in range(h)]\n    color_map = {1: 3, 2: 2, 3: 1}\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 0 and not seen[r][c]:\n                stack = [(r, c)]\n                seen[r][c] = True\n                comp = []\n\n                while stack:\n                    x, y = stack.pop()\n                    comp.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == 0:\n                            seen[nx][ny] = True\n                            stack.append((nx, ny))\n\n                color = color_map.get(len(comp), 0)\n                for x, y in comp:\n                    out[x][y] = color\n\n    return out",
