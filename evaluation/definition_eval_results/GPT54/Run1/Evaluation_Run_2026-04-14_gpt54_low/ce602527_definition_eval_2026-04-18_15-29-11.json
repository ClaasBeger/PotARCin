ython script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    from collections import Counter\n\n    h = len(grid)\n    w = len(grid[0])\n\n    # background = most frequent color\n    bg = Counter(v for row in grid for v in row).most_common(1)[0][0]\n\n    colors = sorted({v for row in grid for v in row if v != bg})\n    if not colors:\n        return [row[:] for row in grid]\n\n    def bbox_of_color(c):\n        rs, cs = [], []\n        for i in range(h):\n            for j in range(w):\n                if grid[i][j] == c:\n                    rs.append(i)\n                    cs.append(j)\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        sub = [row[c0:c1+1] for row in grid[r0:r1+1]]\n        return sub\n\n    def score(sub, color):\n        hh, ww = len(sub), len(sub[0])\n\n        rows = [tuple(r) for r in sub]\n        cols = [tuple(sub[i][j] for i in range(hh)) for j in range(ww)]\n\n        uniq_rows = len(set(rows))\n        uniq_cols = len(set(cols))\n\n        # symmetry score\n        hsym = sum(1 for i in range(hh) if rows[i] == rows[hh - 1 - i])\n        vsym = sum(1 for j in range(ww) if cols[j] == cols[ww - 1 - j])\n\n        # count of foreground cells\n        fg = sum(1 for i in range(hh) for j in range(ww) if sub[i][j] == color)\n\n        # prefer compact, structured, symmetric patterns over large blobs\n        return (\n            uniq_rows + uniq_cols,       # fewer unique rows/cols\n            -(hsym + vsym),              # more symmetry\n            hh * ww,                     # smaller bbox\n            -fg                          # denser if still tied\n        )\n\n    best_color = None\n    best_sub = None\n    best_score = None\n\n    for c in colors:\n        sub = bbox_of_color(c)\n        sc = score(sub, c)\n        if best_score is None or sc < best_score:\n            best_score = sc\n            best_color = c\n            best_sub = sub\n\n    return best_sub",
  "script": "def solve(grid):\n    from collections import Counter\n\n    h = len(grid)\n    w = len(grid[0])\n\n    # background = most frequent color\n    bg = Counter(v for row in grid for v in row).most_common(1)[0][0]\n\n    colors = sorted({v for row in grid for v in row if v != bg})\n    if not colors:\n        return [row[:] for row in grid]\n\n    def bbox_of_color(c):\n        rs, cs = [], []\n        for i in range(h):\n            for j in range(w):\n                if grid[i][j] == c:\n                    rs.append(i)\n                    cs.append(j)\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        sub = [row[c0:c1+1] for row in grid[r0:r1+1]]\n        return sub\n\n    def score(sub, color):\n        hh, ww = len(sub), len(sub[0])\n\n        rows = [tuple(r) for r in sub]\n        cols = [tuple(sub[i][j] for i in range(hh)) for j in range(ww)]\n\n        uniq_rows = len(set(rows))\n        uniq_cols = len(set(cols))\n\n        # symmetry score\n        hsym = sum(1 for i in range(hh) if rows[i] == rows[hh - 1 - i])\n        vsym = sum(1 for j in range(ww) if cols[j] == cols[ww - 1 - j])\n\n        # count of foreground cells\n        fg = sum(1 for i in range(hh) for j in range(ww) if sub[i][j] == color)\n\n        # prefer compact, structured, symmetric patterns over large blobs\n        return (\n            uniq_rows + uniq_cols,       # fewer unique rows/cols\n            -(hsym + vsym),              # more symmetry\n            hh * ww,                     # smaller bbox\n            -fg                          # denser if still tied\n        )\n\n    best_color = None\n    best_sub = None\n    best_score = None\n\n    for c in colors:\n        sub = bbox_of_color(c)\n        sc = score(sub, c)\n        if best_score is None or sc < best_score:\n            best_score = sc\n            best_color = c\n            best_sub = sub\n\n    return best_sub",
