rue matches.\n        key = (\n            matches,\n            matches + misses - oob,\n            -oob,\n            -misses\n        )\n        if best is None or key > best_key:\n            best = cand\n            best_key = key\n\n    if best is None:\n        return [row[:] for row in grid]\n\n    t = best[-1]\n    out = [row[:] for row in grid]\n\n    for r, c in ones:\n        q = t(r, c)\n        if q is None:\n            continue\n        rr, cc = q\n        if out[rr][cc] == 0:\n            out[rr][cc] = 2\n\n    return out",
