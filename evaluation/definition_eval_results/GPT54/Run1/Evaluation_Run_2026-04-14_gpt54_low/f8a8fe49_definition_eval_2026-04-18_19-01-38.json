  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find bounding box of color 2\n    twos = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not twos:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, _ in twos)\n    max_r = max(r for r, _ in twos)\n    min_c = min(c for _, c in twos)\n    max_c = max(c for _, c in twos)\n\n    # Decide whether the frame emphasizes top/bottom or left/right borders\n    top_count = sum(1 for c in range(w) if grid[min_r][c] == 2)\n    bottom_count = sum(1 for c in range(w) if grid[max_r][c] == 2)\n    left_count = sum(1 for r in range(h) if grid[r][min_c] == 2)\n    right_count = sum(1 for r in range(h) if grid[r][max_c] == 2)\n\n    vertical_reflection = (top_count + bottom_count) >= (left_count + right_count)\n\n    # Start with the original grid but remove all 5s\n    out = [row[:] for row in grid]\n    for r in range(h):\n        for c in range(w):\n            if out[r][c] == 5:\n                out[r][c] = 0\n\n    if vertical_reflection:\n        center_r = (min_r + max_r) / 2.0\n        for r in range(h):\n            for c in range(w):\n                if grid[r][c] == 5:\n                    if r < center_r:\n                        nr = min_r - (r - min_r)\n                    else:\n                        nr = max_r + (max_r - r)\n                    nc = c\n                    if 0 <= nr < h and 0 <= nc < w:\n                        out[nr][nc] = 5\n    else:\n        center_c = (min_c + max_c) / 2.0\n        for r in range(h):\n            for c in range(w):\n                if grid[r][c] == 5:\n                    if c < center_c:\n                        nc = min_c - (c - min_c)\n                    else:\n                        nc = max_c + (max_c - c)\n                    nr = r\n                    if 0 <= nr < h and 0 <= nc < w:\n                        out[nr][nc] = 5\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find bounding box of color 2\n    twos = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not twos:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, _ in twos)\n    max_r = max(r for r, _ in twos)\n    min_c = min(c for _, c in twos)\n    max_c = max(c for _, c in twos)\n\n    # Decide whether the frame emphasizes top/bottom or left/right borders\n    top_count = sum(1 for c in range(w) if grid[min_r][c] == 2)\n    bottom_count = sum(1 for c in range(w) if grid[max_r][c] == 2)\n    left_count = sum(1 for r in range(h) if grid[r][min_c] == 2)\n    right_count = sum(1 for r in range(h) if grid[r][max_c] == 2)\n\n    vertical_reflection = (top_count + bottom_count) >= (left_count + right_count)\n\n    # Start with the original grid but remove all 5s\n    out = [row[:] for row in grid]\n    for r in range(h):\n        for c in range(w):\n            if out[r][c] == 5:\n                out[r][c] = 0\n\n    if vertical_reflection:\n        center_r = (min_r + max_r) / 2.0\n        for r in range(h):\n            for c in range(w):\n                if grid[r][c] == 5:\n                    if r < center_r:\n                        nr = min_r - (r - min_r)\n                    else:\n                        nr = max_r + (max_r - r)\n                    nc = c\n                    if 0 <= nr < h and 0 <= nc < w:\n                        out[nr][nc] = 5\n    else:\n        center_c = (min_c + max_c) / 2.0\n        for r in range(h):\n            for c in range(w):\n                if grid[r][c] == 5:\n                    if c < center_c:\n                        nc = min_c - (c - min_c)\n                    else:\n                        nc = max_c + (max_c - c)\n                    nr = r\n                    if 0 <= nr < h and 0 <= nc < w:\n                        out[nr][nc] = 5\n\n    return out",
