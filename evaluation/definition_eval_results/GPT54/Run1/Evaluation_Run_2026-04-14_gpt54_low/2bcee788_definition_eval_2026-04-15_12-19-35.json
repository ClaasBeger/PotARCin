object across the boundary between the object and the 2-line\n    if orientation == 'vertical':\n        line_c = two_cells[0][1]\n        obj_cols = [c for r, c in obj_cells]\n        if obj_cols and max(obj_cols) < line_c:\n            # object is left of the 2-line; axis at line_c - 0.5\n            for r, c in obj_cells:\n                mc = 2 * line_c - 1 - c\n                if 0 <= mc < w:\n                    out[r][mc] = obj_color\n        else:\n            # object is right of the 2-line; axis at line_c + 0.5\n            for r, c in obj_cells:\n                mc = 2 * line_c + 1 - c\n                if 0 <= mc < w:\n                    out[r][mc] = obj_color\n    else:\n        line_r = two_cells[0][0]\n        obj_rows = [r for r, c in obj_cells]\n        if obj_rows and max(obj_rows) < line_r:\n            # object is above the 2-line; axis at line_r - 0.5\n            for r, c in obj_cells:\n                mr = 2 * line_r - 1 - r\n                if 0 <= mr < h:\n                    out[mr][c] = obj_color\n        else:\n            # object is below the 2-line; axis at line_r + 0.5\n            for r, c in obj_cells:\n                mr = 2 * line_r + 1 - r\n                if 0 <= mr < h:\n                    out[mr][c] = obj_color\n\n    return out",
