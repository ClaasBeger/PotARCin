  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    original = [row[:] for row in grid]\n    out = [row[:] for row in grid]\n\n    # Find longest horizontal contiguous run of 0s\n    max_h = 0\n    h_runs = []\n    for r in range(h):\n        c = 0\n        while c < w:\n            if original[r][c] == 0:\n                start = c\n                while c < w and original[r][c] == 0:\n                    c += 1\n                length = c - start\n                if length > max_h:\n                    max_h = length\n                    h_runs = [(r, start, c - 1)]\n                elif length == max_h:\n                    h_runs.append((r, start, c - 1))\n            else:\n                c += 1\n\n    # Find longest vertical contiguous run of 0s\n    max_v = 0\n    v_runs = []\n    for c in range(w):\n        r = 0\n        while r < h:\n            if original[r][c] == 0:\n                start = r\n                while r < h and original[r][c] == 0:\n                    r += 1\n                length = r - start\n                if length > max_v:\n                    max_v = length\n                    v_runs = [(c, start, r - 1)]\n                elif length == max_v:\n                    v_runs.append((c, start, r - 1))\n            else:\n                r += 1\n\n    # Paint all cells in longest horizontal runs\n    if max_h > 0:\n        for r, c1, c2 in h_runs:\n            for c in range(c1, c2 + 1):\n                if original[r][c] == 0:\n                    out[r][c] = 3\n\n    # Paint all cells in longest vertical runs\n    if max_v > 0:\n        for c, r1, r2 in v_runs:\n            for r in range(r1, r2 + 1):\n                if original[r][c] == 0:\n                    out[r][c] = 3\n\n    return out",
