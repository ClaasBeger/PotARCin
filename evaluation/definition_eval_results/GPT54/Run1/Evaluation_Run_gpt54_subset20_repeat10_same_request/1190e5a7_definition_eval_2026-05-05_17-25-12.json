elf, no other text or markdown.",
  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find colors that make entire rows or columns monochromatic\n    row_full_colors = []\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            row_full_colors.append(grid[r][0])\n\n    col_full_colors = []\n    for c in range(w):\n        val = grid[0][c]\n        if all(grid[r][c] == val for r in range(h)):\n            col_full_colors.append(val)\n\n    # Separator color: the color used by the full divider rows/columns\n    counts = {}\n    for v in row_full_colors + col_full_colors:\n        counts[v] = counts.get(v, 0) + 1\n    sep_color = max(counts, key=counts.get)\n\n    # Background/output color: any non-separator color, prefer most frequent\n    bg_counts = {}\n    for row in grid:\n        for v in row:\n            if v != sep_color:\n                bg_counts[v] = bg_counts.get(v, 0) + 1\n    fill_color = max(bg_counts, key=bg_counts.get) if bg_counts else sep_color\n\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep_color for r in range(h))]\n\n    def count_segments(length, separators):\n        if length == 0:\n            return 0\n        seps = set(separators)\n        segments = 0\n        in_segment = False\n        for i in range(length):\n            if i in seps:\n                in_segment = False\n            else:\n                if not in_segment:\n                    segments += 1\n                    in_segment = True\n        return segments\n\n    out_h = count_segments(h, sep_rows)\n    out_w = count_segments(w, sep_cols)\n\n    return [[fill_color for _ in range(out_w)] for _ in range(out_h)]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find colors that make entire rows or columns monochromatic\n    row_full_colors = []\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            row_full_colors.append(grid[r][0])\n\n    col_full_colors = []\n    for c in range(w):\n        val = grid[0][c]\n        if all(grid[r][c] == val for r in range(h)):\n            col_full_colors.append(val)\n\n    # Separator color: the color used by the full divider rows/columns\n    counts = {}\n    for v in row_full_colors + col_full_colors:\n        counts[v] = counts.get(v, 0) + 1\n    sep_color = max(counts, key=counts.get)\n\n    # Background/output color: any non-separator color, prefer most frequent\n    bg_counts = {}\n    for row in grid:\n        for v in row:\n            if v != sep_color:\n                bg_counts[v] = bg_counts.get(v, 0) + 1\n    fill_color = max(bg_counts, key=bg_counts.get) if bg_counts else sep_color\n\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep_color for r in range(h))]\n\n    def count_segments(length, separators):\n        if length == 0:\n            return 0\n        seps = set(separators)\n        segments = 0\n        in_segment = False\n        for i in range(length):\n            if i in seps:\n                in_segment = False\n            else:\n                if not in_segment:\n                    segments += 1\n                    in_segment = True\n        return segments\n\n    out_h = count_segments(h, sep_rows)\n    out_w = count_segments(w, sep_cols)\n\n    return [[fill_color for _ in range(out_w)] for _ in range(out_h)]",
