  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator rows: rows that are entirely one repeated nonzero color.\n    sep_rows = []\n    sep_color_counts = {}\n    for r in range(h):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            v = grid[r][0]\n            if v != 0:\n                sep_rows.append(r)\n                sep_color_counts[v] = sep_color_counts.get(v, 0) + 1\n\n    # Separator color is the one used by the full separator rows.\n    if sep_color_counts:\n        sep_color = max(sep_color_counts, key=sep_color_counts.get)\n    else:\n        # Fallback: use full columns if needed\n        sep_cols_tmp = []\n        col_color_counts = {}\n        for c in range(w):\n            col_vals = {grid[r][c] for r in range(h)}\n            if len(col_vals) == 1:\n                v = grid[0][c]\n                if v != 0:\n                    sep_cols_tmp.append(c)\n                    col_color_counts[v] = col_color_counts.get(v, 0) + 1\n        sep_color = max(col_color_counts, key=col_color_counts.get)\n\n    # Find separator columns for that separator color.\n    sep_cols = []\n    for c in range(w):\n        if all(grid[r][c] == sep_color for r in range(h)):\n            sep_cols.append(c)\n\n    # Build cell row/col spans between separator lines.\n    row_spans = []\n    prev = -1\n    for r in sep_rows + [h]:\n        if prev + 1 <= r - 1:\n            row_spans.append((prev + 1, r - 1))\n        prev = r\n\n    col_spans = []\n    prev = -1\n    for c in sep_cols + [w]:\n        if prev + 1 <= c - 1:\n            col_spans.append((prev + 1, c - 1))\n        prev = c\n\n    nr = len(row_spans)\n    nc = len(col_spans)\n\n    # Read the cell-level grid.\n    cells = [[0] * nc for _ in range(nr)]\n    for i, (r1, r2) in enumerate(row_spans):\n        for j, (c1, c2) in enumerate(col_spans):\n            color = 0\n            for r in range(r1, r2 + 1):\n                for c in range(c1, c2 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        color = v\n                        break\n                if color:\n                    break\n            cells[i][j] = color\n\n    # Apply the rule: for each color, fill straight horizontal and vertical\n    # segments connecting same-colored cells.\n    colors = sorted({cells[i][j] for i in range(nr) for j in range(nc)} - {0})\n\n    out_cells = [row[:] for row in cells]\n\n    for color in colors:\n        # Horizontal fills\n        for i in range(nr):\n            js = [j for j in range(nc) if cells[i][j] == color]\n            if len(js) >= 2:\n                for j in range(min(js), max(js) + 1):\n                    if out_cells[i][j] == 0:\n                        out_cells[i][j] = color\n\n        # Vertical fills\n        for j in range(nc):\n            is_ = [i for i in range(nr) if cells[i][j] == color]\n            if len(is_) >= 2:\n                for i in range(min(is_), max(is_) + 1):\n                    if out_cells[i][j] == 0:\n                        out_cells[i][j] = color\n\n    # Reconstruct the output grid.\n    out = [row[:] for row in grid]\n    for i, (r1, r2) in enumerate(row_spans):\n        for j, (c1, c2) in enumerate(col_spans):\n            color = out_cells[i][j]\n            for r in range(r1, r2 + 1):\n                for c in range(c1, c2 + 1):\n                    out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator rows: rows that are entirely one repeated nonzero color.\n    sep_rows = []\n    sep_color_counts = {}\n    for r in range(h):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            v = grid[r][0]\n            if v != 0:\n                sep_rows.append(r)\n                sep_color_counts[v] = sep_color_counts.get(v, 0) + 1\n\n    # Separator color is the one used by the full separator rows.\n    if sep_color_counts:\n        sep_color = max(sep_color_counts, key=sep_color_counts.get)\n    else:\n        # Fallback: use full columns if needed\n        sep_cols_tmp = []\n        col_color_counts = {}\n        for c in range(w):\n            col_vals = {grid[r][c] for r in range(h)}\n            if len(col_vals) == 1:\n                v = grid[0][c]\n                if v != 0:\n                    sep_cols_tmp.append(c)\n                    col_color_counts[v] = col_color_counts.get(v, 0) + 1\n        sep_color = max(col_color_counts, key=col_color_counts.get)\n\n    # Find separator columns for that separator color.\n    sep_cols = []\n    for c in range(w):\n        if all(grid[r][c] == sep_color for r in range(h)):\n            sep_cols.append(c)\n\n    # Build cell row/col spans between separator lines.\n    row_spans = []\n    prev = -1\n    for r in sep_rows + [h]:\n        if prev + 1 <= r - 1:\n            row_spans.append((prev + 1, r - 1))\n        prev = r\n\n    col_spans = []\n    prev = -1\n    for c in sep_cols + [w]:\n        if prev + 1 <= c - 1:\n            col_spans.append((prev + 1, c - 1))\n        prev = c\n\n    nr = len(row_spans)\n    nc = len(col_spans)\n\n    # Read the cell-level grid.\n    cells = [[0] * nc for _ in range(nr)]\n    for i, (r1, r2) in enumerate(row_spans):\n        for j, (c1, c2) in enumerate(col_spans):\n            color = 0\n            for r in range(r1, r2 + 1):\n                for c in range(c1, c2 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        color = v\n                        break\n                if color:\n                    break\n            cells[i][j] = color\n\n    # Apply the rule: for each color, fill straight horizontal and vertical\n    # segments connecting same-colored cells.\n    colors = sorted({cells[i][j] for i in range(nr) for j in range(nc)} - {0})\n\n    out_cells = [row[:] for row in cells]\n\n    for color in colors:\n        # Horizontal fills\n        for i in range(nr):\n            js = [j for j in range(nc) if cells[i][j] == color]\n            if len(js) >= 2:\n                for j in range(min(js), max(js) + 1):\n                    if out_cells[i][j] == 0:\n                        out_cells[i][j] = color\n\n        # Vertical fills\n        for j in range(nc):\n            is_ = [i for i in range(nr) if cells[i][j] == color]\n            if len(is_) >= 2:\n                for i in range(min(is_), max(is_) + 1):\n                    if out_cells[i][j] == 0:\n                        out_cells[i][j] = color\n\n    # Reconstruct the output grid.\n    out = [row[:] for row in grid]\n    for i, (r1, r2) in enumerate(row_spans):\n        for j, (c1, c2) in enumerate(col_spans):\n            color = out_cells[i][j]\n            for r in range(r1, r2 + 1):\n                for c in range(c1, c2 + 1):\n                    out[r][c] = color\n\n    return out",
