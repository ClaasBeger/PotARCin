  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from any uniform non-zero full row/column\n    line_color = None\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)) and grid[r][0] != 0:\n            line_color = grid[r][0]\n            break\n    if line_color is None:\n        for c in range(w):\n            col0 = grid[0][c]\n            if col0 != 0 and all(grid[r][c] == col0 for r in range(h)):\n                line_color = col0\n                break\n\n    # Copy grid for output\n    out = [row[:] for row in grid]\n\n    # Find separator rows/cols\n    sep_rows = [r for r in range(h) if all(grid[r][c] == line_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == line_color for r in range(h))]\n\n    # Build block intervals between separators\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n    row_blocks = [(row_bounds[i] + 1, row_bounds[i + 1]) for i in range(len(row_bounds) - 1) if row_bounds[i] + 1 < row_bounds[i + 1]]\n    col_blocks = [(col_bounds[i] + 1, col_bounds[i + 1]) for i in range(len(col_bounds) - 1) if col_bounds[i] + 1 < col_bounds[i + 1]]\n\n    # Find object color(s): non-zero, non-separator\n    colors = set()\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != line_color:\n                colors.add(v)\n\n    if not colors:\n        return out\n\n    # In these tasks there is effectively one object color\n    obj_color = next(iter(colors))\n\n    # Find template = block with the most object-colored cells\n    template_positions = set()\n    max_count = -1\n    block_size = None\n\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            positions = set()\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    if grid[r][c] == obj_color:\n                        positions.add((r - r0, c - c0))\n            if len(positions) > max_count:\n                max_count = len(positions)\n                template_positions = positions\n                block_size = (r1 - r0, c1 - c0)\n\n    if not template_positions:\n        return out\n\n    # Apply template to every block:\n    # preserve object-color cells, fill missing template cells with separator color\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            bh, bw = r1 - r0, c1 - c0\n            if (bh, bw) != block_size:\n                continue\n            for dr, dc in template_positions:\n                rr, cc = r0 + dr, c0 + dc\n                if out[rr][cc] == 0:\n                    out[rr][cc] = line_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from any uniform non-zero full row/column\n    line_color = None\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)) and grid[r][0] != 0:\n            line_color = grid[r][0]\n            break\n    if line_color is None:\n        for c in range(w):\n            col0 = grid[0][c]\n            if col0 != 0 and all(grid[r][c] == col0 for r in range(h)):\n                line_color = col0\n                break\n\n    # Copy grid for output\n    out = [row[:] for row in grid]\n\n    # Find separator rows/cols\n    sep_rows = [r for r in range(h) if all(grid[r][c] == line_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == line_color for r in range(h))]\n\n    # Build block intervals between separators\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n    row_blocks = [(row_bounds[i] + 1, row_bounds[i + 1]) for i in range(len(row_bounds) - 1) if row_bounds[i] + 1 < row_bounds[i + 1]]\n    col_blocks = [(col_bounds[i] + 1, col_bounds[i + 1]) for i in range(len(col_bounds) - 1) if col_bounds[i] + 1 < col_bounds[i + 1]]\n\n    # Find object color(s): non-zero, non-separator\n    colors = set()\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != line_color:\n                colors.add(v)\n\n    if not colors:\n        return out\n\n    # In these tasks there is effectively one object color\n    obj_color = next(iter(colors))\n\n    # Find template = block with the most object-colored cells\n    template_positions = set()\n    max_count = -1\n    block_size = None\n\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            positions = set()\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    if grid[r][c] == obj_color:\n                        positions.add((r - r0, c - c0))\n            if len(positions) > max_count:\n                max_count = len(positions)\n                template_positions = positions\n                block_size = (r1 - r0, c1 - c0)\n\n    if not template_positions:\n        return out\n\n    # Apply template to every block:\n    # preserve object-color cells, fill missing template cells with separator color\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            bh, bw = r1 - r0, c1 - c0\n            if (bh, bw) != block_size:\n                continue\n            for dr, dc in template_positions:\n                rr, cc = r0 + dr, c0 + dc\n                if out[rr][cc] == 0:\n                    out[rr][cc] = line_color\n\n    return out",
