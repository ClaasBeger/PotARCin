  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from any full non-zero row/column\n    sep_color = None\n    for r in range(h):\n        row_set = set(grid[r])\n        if len(row_set) == 1:\n            v = grid[r][0]\n            if v != 0:\n                sep_color = v\n                break\n    if sep_color is None:\n        for c in range(w):\n            col = [grid[r][c] for r in range(h)]\n            col_set = set(col)\n            if len(col_set) == 1:\n                v = col[0]\n                if v != 0:\n                    sep_color = v\n                    break\n\n    # Identify separator rows/cols\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep_color for r in range(h))]\n\n    # Build panel row/col ranges\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n\n    row_ranges = []\n    for i in range(len(row_bounds) - 1):\n        a, b = row_bounds[i] + 1, row_bounds[i + 1]\n        if a < b:\n            row_ranges.append((a, b))\n\n    col_ranges = []\n    for i in range(len(col_bounds) - 1):\n        a, b = col_bounds[i] + 1, col_bounds[i + 1]\n        if a < b:\n            col_ranges.append((a, b))\n\n    # Canonical shape = union of all non-zero, non-separator cells in local panel coordinates\n    canonical = set()\n    for rs, re in row_ranges:\n        for cs, ce in col_ranges:\n            for r in range(rs, re):\n                for c in range(cs, ce):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        canonical.add((r - rs, c - cs))\n\n    # Apply canonical shape to every panel using separator color,\n    # but preserve original non-zero non-separator cells.\n    out = [row[:] for row in grid]\n    for rs, re in row_ranges:\n        for cs, ce in col_ranges:\n            ph, pw = re - rs, ce - cs\n            for dr, dc in canonical:\n                if 0 <= dr < ph and 0 <= dc < pw:\n                    r, c = rs + dr, cs + dc\n                    if out[r][c] == 0:\n                        out[r][c] = sep_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from any full non-zero row/column\n    sep_color = None\n    for r in range(h):\n        row_set = set(grid[r])\n        if len(row_set) == 1:\n            v = grid[r][0]\n            if v != 0:\n                sep_color = v\n                break\n    if sep_color is None:\n        for c in range(w):\n            col = [grid[r][c] for r in range(h)]\n            col_set = set(col)\n            if len(col_set) == 1:\n                v = col[0]\n                if v != 0:\n                    sep_color = v\n                    break\n\n    # Identify separator rows/cols\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep_color for r in range(h))]\n\n    # Build panel row/col ranges\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n\n    row_ranges = []\n    for i in range(len(row_bounds) - 1):\n        a, b = row_bounds[i] + 1, row_bounds[i + 1]\n        if a < b:\n            row_ranges.append((a, b))\n\n    col_ranges = []\n    for i in range(len(col_bounds) - 1):\n        a, b = col_bounds[i] + 1, col_bounds[i + 1]\n        if a < b:\n            col_ranges.append((a, b))\n\n    # Canonical shape = union of all non-zero, non-separator cells in local panel coordinates\n    canonical = set()\n    for rs, re in row_ranges:\n        for cs, ce in col_ranges:\n            for r in range(rs, re):\n                for c in range(cs, ce):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        canonical.add((r - rs, c - cs))\n\n    # Apply canonical shape to every panel using separator color,\n    # but preserve original non-zero non-separator cells.\n    out = [row[:] for row in grid]\n    for rs, re in row_ranges:\n        for cs, ce in col_ranges:\n            ph, pw = re - rs, ce - cs\n            for dr, dc in canonical:\n                if 0 <= dr < ph and 0 <= dc < pw:\n                    r, c = rs + dr, cs + dc\n                    if out[r][c] == 0:\n                        out[r][c] = sep_color\n\n    return out",
