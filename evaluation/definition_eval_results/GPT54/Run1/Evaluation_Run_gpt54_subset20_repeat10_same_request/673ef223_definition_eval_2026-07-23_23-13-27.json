  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find vertical segments of color 2\n    two_positions = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    cols_with_twos = sorted(set(c for r, c in two_positions))\n\n    # Group by column\n    segments = []\n    for c in cols_with_twos:\n        rows = sorted(r for r, cc in two_positions if cc == c)\n        if rows:\n            segments.append((rows[0], rows[-1], c))  # start_row, end_row, col\n\n    # Identify top and bottom 2-segments\n    segments.sort(key=lambda x: x[0])\n    top_start, top_end, top_col = segments[0]\n    bot_start, bot_end, bot_col = segments[1]\n\n    # Find all seed 8s that are in the top segment's row range\n    seeds = []\n    for r in range(top_start, top_end + 1):\n        for c in range(w):\n            if grid[r][c] == 8:\n                seeds.append((r, c))\n\n    for r, c in seeds:\n        offset = r - top_start\n        br = bot_start + offset\n\n        # Draw on top segment row: from top bar toward seed, seed becomes 4\n        if top_col == 0:\n            for x in range(1, c):\n                out[r][x] = 8\n            out[r][c] = 4\n        else:\n            for x in range(c + 1, top_col):\n                out[r][x] = 8\n            out[r][c] = 4\n\n        # Draw on corresponding bottom segment row: full interior horizontal line\n        if 0 <= br < h:\n            if bot_col == 0:\n                for x in range(1, w):\n                    out[br][x] = 8\n            else:\n                for x in range(0, bot_col):\n                    out[br][x] = 8\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find vertical segments of color 2\n    two_positions = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    cols_with_twos = sorted(set(c for r, c in two_positions))\n\n    # Group by column\n    segments = []\n    for c in cols_with_twos:\n        rows = sorted(r for r, cc in two_positions if cc == c)\n        if rows:\n            segments.append((rows[0], rows[-1], c))  # start_row, end_row, col\n\n    # Identify top and bottom 2-segments\n    segments.sort(key=lambda x: x[0])\n    top_start, top_end, top_col = segments[0]\n    bot_start, bot_end, bot_col = segments[1]\n\n    # Find all seed 8s that are in the top segment's row range\n    seeds = []\n    for r in range(top_start, top_end + 1):\n        for c in range(w):\n            if grid[r][c] == 8:\n                seeds.append((r, c))\n\n    for r, c in seeds:\n        offset = r - top_start\n        br = bot_start + offset\n\n        # Draw on top segment row: from top bar toward seed, seed becomes 4\n        if top_col == 0:\n            for x in range(1, c):\n                out[r][x] = 8\n            out[r][c] = 4\n        else:\n            for x in range(c + 1, top_col):\n                out[r][x] = 8\n            out[r][c] = 4\n\n        # Draw on corresponding bottom segment row: full interior horizontal line\n        if 0 <= br < h:\n            if bot_col == 0:\n                for x in range(1, w):\n                    out[br][x] = 8\n            else:\n                for x in range(0, bot_col):\n                    out[br][x] = 8\n\n    return out",
