  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator rows/cols: full lines of a single non-zero color.\n    sep_rows = []\n    sep_cols = []\n\n    for r in range(h):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            v = next(iter(vals))\n            if v != 0:\n                sep_rows.append(r)\n\n    for c in range(w):\n        vals = {grid[r][c] for r in range(h)}\n        if len(vals) == 1:\n            v = next(iter(vals))\n            if v != 0:\n                sep_cols.append(c)\n\n    # Separator color\n    sep_color = None\n    if sep_rows:\n        sep_color = grid[sep_rows[0]][0]\n    elif sep_cols:\n        sep_color = grid[0][sep_cols[0]]\n    else:\n        return [row[:] for row in grid]\n\n    # Partition ranges between separator lines.\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n\n    row_ranges = [(row_bounds[i] + 1, row_bounds[i + 1]) for i in range(len(row_bounds) - 1) if row_bounds[i] + 1 < row_bounds[i + 1]]\n    col_ranges = [(col_bounds[i] + 1, col_bounds[i + 1]) for i in range(len(col_bounds) - 1) if col_bounds[i] + 1 < col_bounds[i + 1]]\n\n    # Union of all non-zero, non-separator cells within a block, in block-local coordinates.\n    union_positions = set()\n    for r0, r1 in row_ranges:\n        for c0, c1 in col_ranges:\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        union_positions.add((r - r0, c - c0))\n\n    # Apply union pattern to every block using separator color, preserving original colored cells.\n    out = [row[:] for row in grid]\n    for r0, r1 in row_ranges:\n        for c0, c1 in col_ranges:\n            bh = r1 - r0\n            bw = c1 - c0\n            for dr, dc in union_positions:\n                if 0 <= dr < bh and 0 <= dc < bw:\n                    rr, cc = r0 + dr, c0 + dc\n                    if out[rr][cc] == 0:\n                        out[rr][cc] = sep_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator rows/cols: full lines of a single non-zero color.\n    sep_rows = []\n    sep_cols = []\n\n    for r in range(h):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            v = next(iter(vals))\n            if v != 0:\n                sep_rows.append(r)\n\n    for c in range(w):\n        vals = {grid[r][c] for r in range(h)}\n        if len(vals) == 1:\n            v = next(iter(vals))\n            if v != 0:\n                sep_cols.append(c)\n\n    # Separator color\n    sep_color = None\n    if sep_rows:\n        sep_color = grid[sep_rows[0]][0]\n    elif sep_cols:\n        sep_color = grid[0][sep_cols[0]]\n    else:\n        return [row[:] for row in grid]\n\n    # Partition ranges between separator lines.\n    row_bounds = [-1] + sep_rows + [h]\n    col_bounds = [-1] + sep_cols + [w]\n\n    row_ranges = [(row_bounds[i] + 1, row_bounds[i + 1]) for i in range(len(row_bounds) - 1) if row_bounds[i] + 1 < row_bounds[i + 1]]\n    col_ranges = [(col_bounds[i] + 1, col_bounds[i + 1]) for i in range(len(col_bounds) - 1) if col_bounds[i] + 1 < col_bounds[i + 1]]\n\n    # Union of all non-zero, non-separator cells within a block, in block-local coordinates.\n    union_positions = set()\n    for r0, r1 in row_ranges:\n        for c0, c1 in col_ranges:\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        union_positions.add((r - r0, c - c0))\n\n    # Apply union pattern to every block using separator color, preserving original colored cells.\n    out = [row[:] for row in grid]\n    for r0, r1 in row_ranges:\n        for c0, c1 in col_ranges:\n            bh = r1 - r0\n            bw = c1 - c0\n            for dr, dc in union_positions:\n                if 0 <= dr < bh and 0 <= dc < bw:\n                    rr, cc = r0 + dr, c0 + dc\n 