  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: a color that forms complete rows and complete columns.\n    row_full = {}\n    for r in range(h):\n        c = grid[r][0]\n        ok = True\n        for x in grid[r]:\n            if x != c:\n                ok = False\n                break\n        if ok:\n            row_full.setdefault(c, []).append(r)\n\n    col_full = {}\n    for c in range(w):\n        v = grid[0][c]\n        ok = True\n        for r in range(h):\n            if grid[r][c] != v:\n                ok = False\n                break\n        if ok:\n            col_full.setdefault(v, []).append(c)\n\n    sep_color = None\n    best = -1\n    for c in row_full:\n        if c in col_full:\n            score = len(row_full[c]) + len(col_full[c])\n            if score > best:\n                best = score\n                sep_color = c\n\n    if sep_color is None:\n        return [row[:] for row in grid]\n\n    sep_rows = set(row_full[sep_color])\n    sep_cols = set(col_full[sep_color])\n\n    # Build block intervals between separator rows/cols.\n    row_blocks = []\n    start = None\n    for r in range(h):\n        if r in sep_rows:\n            if start is not None:\n                row_blocks.append((start, r - 1))\n                start = None\n        else:\n            if start is None:\n                start = r\n    if start is not None:\n        row_blocks.append((start, h - 1))\n\n    col_blocks = []\n    start = None\n    for c in range(w):\n        if c in sep_cols:\n            if start is not None:\n                col_blocks.append((start, c - 1))\n                start = None\n        else:\n            if start is None:\n                start = c\n    if start is not None:\n        col_blocks.append((start, w - 1))\n\n    def block_values(br, bc):\n        r0, r1 = row_blocks[br]\n        c0, c1 = col_blocks[bc]\n        vals = set()\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                vals.add(grid[r][c])\n        return vals\n\n    def set_block(out, br, bc, color):\n        r0, r1 = row_blocks[br]\n        c0, c1 = col_blocks[bc]\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                out[r][c] = color\n\n    # Record original colored blocks.\n    positions_by_color = {}\n    empty_blocks = set()\n    occupied = {}\n\n    for br in range(len(row_blocks)):\n        for bc in range(len(col_blocks)):\n            vals = block_values(br, bc)\n            vals_no_sep = {v for v in vals if v != sep_color}\n            if vals_no_sep == {0}:\n                empty_blocks.add((br, bc))\n            else:\n                colors = [v for v in vals_no_sep if v != 0]\n                if len(set(colors)) == 1 and colors:\n                    color = colors[0]\n                    positions_by_color.setdefault(color, []).append((br, bc))\n                    occupied[(br, bc)] = color\n\n    out = [row[:] for row in grid]\n\n    # Fill segments between original same-colored blocks sharing a row or column.\n    for color, pts in positions_by_color.items():\n        n = len(pts)\n        for i in range(n):\n            r1, c1 = pts[i]\n            for j in range(i + 1, n):\n                r2, c2 = pts[j]\n                if r1 == r2:\n                    a, b = sorted((c1, c2))\n                    for bc in range(a, b + 1):\n                        if (r1, bc) in empty_blocks or occupied.get((r1, bc)) == color:\n                            set_block(out, r1, bc, color)\n                elif c1 == c2:\n                    a, b = sorted((r1, r2))\n                    for br in range(a, b + 1):\n                        if (br, c1) in empty_blocks or occupied.get((br, c1)) == color:\n                            set_block(out, br, c1, color)\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: a color that forms complete rows and complete columns.\n    row_full = {}\n    for r in range(h):\n        c = grid[r][0]\n        ok = True\n        for x in grid[r]:\n            if x != c:\n                ok = False\n                break\n        if ok:\n            row_full.setdefault(c, []).append(r)\n\n    col_full = {}\n    for c in range(w):\n        v = grid[0][c]\n        ok = True\n        for r in range(h):\n            if grid[r][c] != v:\n                ok = False\n                break\n        if ok:\n            col_full.setdefault(v, []).append(c)\n\n    sep_color = None\n    best = -1\n    for c in row_full:\n        if c in col_full:\n            score = len(row_full[c]) + len(col_full[c])\n            if score > best:\n                best = score\n                sep_color = c\n\n    if sep_color is None:\n        return [row[:] for row in grid]\n\n    sep_rows = set(row_full[sep_color])\n    sep_cols = set(col_full[sep_color])\n\n    # Build block intervals between separator rows/cols.\n    row_blocks = []\n    start = None\n    for r in range(h):\n        if r in sep_rows:\n            if start is not None:\n                row_blocks.append((start, r - 1))\n                start = None\n        else:\n            if start is None:\n                start = r\n    if start is not None:\n        row_blocks.append((start, h - 1))\n\n    col_blocks = []\n    start = None\n    for c in range(w):\n        if c in sep_cols:\n            if start is not None:\n                col_blocks.append((start, c - 1))\n                start = None\n        else:\n            if start is None:\n                start = c\n    if start is not None:\n        col_blocks.append((start, w - 1))\n\n    def block_values(br, bc):\n        r0, r1 = row_blocks[br]\n        c0, c1 = col_blocks[bc]\n        vals = set()\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                vals.add(grid[r][c])\n        return vals\n\n    def set_block(out, br, bc, color):\n        r0, r1 = row_blocks[br]\n        c0, c1 = col_blocks[bc]\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                out[r][c] = color\n\n    # Record original colored blocks.\n    positions_by_color = {}\n    empty_blocks = set()\n    occupied = {}\n\n    for br in range(len(row_blocks)):\n        for bc in range(len(col_blocks)):\n            vals = block_values(br, bc)\n            vals_no_sep = {v for v in vals if v != sep_color}\n            if vals_no_sep == {0}:\n                empty_blocks.add((br, bc))\n            else:\n                colors = [v for v in vals_no_sep if v != 0]\n                if len(set(colors)) == 1 and colors:\n                    color = colors[0]\n                    positions_by_color.setdefault(color, []).append((br, bc))\n                    occupied[(br, bc)] = color\n\n    out = [row[:] for row in grid]\n\n    # Fill segments between original same-colored blocks sharing a row or column.\n    for color, pts in positions_by_color.items():\n        n = len(pts)\n        for i in range(n):\n            r1, c1 = pts[i]\n            for j in range(i + 1, n):\n                r2, c2 = pts[j]\n                if r1 == r2:\n                    a, b = sorted((c1, c2))\n                    for bc in range(a, b + 1):\n                        if (r1, bc) in empty_blocks or occupied.get((r1, bc)) == color:\n                            set_block(out, r1, bc, color)\n                elif c1 == c2:\n                    a, b = sorted((r1, r2))\n                    for br in range(a, b + 1):\n                        if (br, c1) in empty_blocks or occupied.get((br, c1)) == color:\n                            set_block(out, br, c1, color)\n\n    return out",
