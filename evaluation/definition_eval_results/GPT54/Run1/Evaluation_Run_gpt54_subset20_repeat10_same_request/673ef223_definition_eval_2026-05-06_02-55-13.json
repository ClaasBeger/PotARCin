  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find vertical contiguous segments of color 2\n    cols = {}\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2:\n                cols.setdefault(c, []).append(r)\n\n    segments = []\n    for c, rows in cols.items():\n        rows = sorted(rows)\n        start = rows[0]\n        prev = rows[0]\n        for x in rows[1:]:\n            if x == prev + 1:\n                prev = x\n            else:\n                segments.append((c, start, prev))\n                start = prev = x\n        segments.append((c, start, prev))\n\n    # Keep the two main segments\n    segments.sort(key=lambda s: (-(s[2] - s[1] + 1), s[0], s[1]))\n    seg1, seg2 = segments[:2]\n\n    def seg_len(seg):\n        return seg[2] - seg[1] + 1\n\n    # Pair them by equal offset order; if lengths differ, use overlapping offsets only\n    # Process any 8 that lies within one segment's row-span.\n    def process_source(src_seg, dst_seg):\n        src_c, src_top, src_bot = src_seg\n        dst_c, dst_top, dst_bot = dst_seg\n        max_offset = min(seg_len(src_seg), seg_len(dst_seg))\n\n        for r in range(src_top, src_bot + 1):\n            offset = r - src_top\n            if offset < 0 or offset >= max_offset:\n                continue\n\n            # Find 8s on this row (excluding the bar itself)\n            eights = [c for c in range(w) if grid[r][c] == 8 and c != src_c]\n            for c8 in eights:\n                # Draw from the source 8 toward its nearby bar, and mark source as 4\n                if src_c < c8:\n                    for c in range(src_c + 1, c8):\n                        out[r][c] = 8\n                else:\n                    for c in range(c8 + 1, src_c):\n                        out[r][c] = 8\n                out[r][c8] = 4\n\n                # Draw full row on corresponding row of opposite segment, away from that bar\n                rr = dst_top + offset\n                if 0 <= rr < h:\n                    if dst_c == 0:\n                        for c in range(1, w):\n                            out[rr][c] = 8\n                    elif dst_c == w - 1:\n                        for c in range(0, w - 1):\n                            out[rr][c] = 8\n                    else:\n                        # Fallback: fill the larger side away from the bar\n                        if dst_c <= w - 1 - dst_c:\n                            for c in range(dst_c + 1, w):\n                                out[rr][c] = 8\n                        else:\n                            for c in range(0, dst_c):\n                                out[rr][c] = 8\n\n    process_source(seg1, seg2)\n    process_source(seg2, seg1)\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find vertical contiguous segments of color 2\n    cols = {}\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2:\n                cols.setdefault(c, []).append(r)\n\n    segments = []\n    for c, rows in cols.items():\n        rows = sorted(rows)\n        start = rows[0]\n        prev = rows[0]\n        for x in rows[1:]:\n            if x == prev + 1:\n                prev = x\n            else:\n                segments.append((c, start, prev))\n                start = prev = x\n        segments.append((c, start, prev))\n\n    # Keep the two main segments\n    segments.sort(key=lambda s: (-(s[2] - s[1] + 1), s[0], s[1]))\n    seg1, seg2 = segments[:2]\n\n    def seg_len(seg):\n        return seg[2] - seg[1] + 1\n\n    # Pair them by equal offset order; if lengths differ, use overlapping offsets only\n    # Process any 8 that lies within one segment's row-span.\n    def process_source(src_seg, dst_seg):\n        src_c, src_top, src_bot = src_seg\n        dst_c, dst_top, dst_bot = dst_seg\n        max_offset = min(seg_len(src_seg), seg_len(dst_seg))\n\n        for r in range(src_top, src_bot + 1):\n            offset = r - src_top\n            if offset < 0 or offset >= max_offset:\n                continue\n\n            # Find 8s on this row (excluding the bar itself)\n            eights = [c for c in range(w) if grid[r][c] == 8 and c != src_c]\n            for c8 in eights:\n                # Draw from the source 8 toward its nearby bar, and mark source as 4\n                if src_c < c8:\n                    for c in range(src_c + 1, c8):\n                        out[r][c] = 8\n                else:\n                    for c in range(c8 + 1, src_c):\n                        out[r][c] = 8\n                out[r][c8] = 4\n\n                # Draw full row on corresponding row of opposite segment, away from that bar\n                rr = dst_top + offset\n                if 0 <= rr < h:\n                    if dst_c == 0:\n                        for c in range(1, w):\n                            out[rr][c] = 8\n                    elif dst_c == w - 1:\n                        for c in range(0, w - 1):\n                            out[rr][c] = 8\n                    else:\n                        # Fallback: fill the larger side away from the bar\n                        if dst_c <= w - 1 - dst_c:\n                            for c in range(dst_c + 1, w):\n                                out[rr][c] = 8\n                        else:\n                            for c in range(0, dst_c):\n                                out[rr][c] = 8\n\n    process_source(seg1, seg2)\n    process_source(seg2, seg1)\n\n    return out",
