  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find full monochrome non-zero rows\n    row_lines = []\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            row_lines.append((r, c))\n\n    # Find full monochrome non-zero columns\n    col_lines = []\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            col_lines.append((c, v))\n\n    # Organize lines by color\n    rows_by_color = {}\n    for r, color in row_lines:\n        rows_by_color.setdefault(color, []).append(r)\n\n    cols_by_color = {}\n    for c, color in col_lines:\n        cols_by_color.setdefault(color, []).append(c)\n\n    # Prepare output with only the detected full lines\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    for r, color in row_lines:\n        for c in range(w):\n            out[r][c] = color\n    for c, color in col_lines:\n        for r in range(h):\n            out[r][c] = color\n\n    # Helper sets to recognize cells already belonging to full lines\n    line_cells = set()\n    for r, color in row_lines:\n        for c in range(w):\n            line_cells.add((r, c))\n    for c, color in col_lines:\n        for r in range(h):\n            line_cells.add((r, c))\n\n    # Project scattered cells of a line's color to the adjacent side of that line\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0:\n                continue\n            if (r, c) in line_cells:\n                continue\n            if color not in rows_by_color and color not in cols_by_color:\n                continue\n\n            candidates = []\n\n            for rr in rows_by_color.get(color, []):\n                if r < rr and rr - 1 >= 0:\n                    candidates.append((abs(r - rr), rr - 1, c))\n                elif r > rr and rr + 1 < h:\n                    candidates.append((abs(r - rr), rr + 1, c))\n\n            for cc in cols_by_color.get(color, []):\n                if c < cc and cc - 1 >= 0:\n                    candidates.append((abs(c - cc), r, cc - 1))\n                elif c > cc and cc + 1 < w:\n                    candidates.append((abs(c - cc), r, cc + 1))\n\n            if not candidates:\n                continue\n\n            _, nr, nc = min(candidates, key=lambda t: t[0])\n            out[nr][nc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find full monochrome non-zero rows\n    row_lines = []\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            row_lines.append((r, c))\n\n    # Find full monochrome non-zero columns\n    col_lines = []\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            col_lines.append((c, v))\n\n    # Organize lines by color\n    rows_by_color = {}\n    for r, color in row_lines:\n        rows_by_color.setdefault(color, []).append(r)\n\n    cols_by_color = {}\n    for c, color in col_lines:\n        cols_by_color.setdefault(color, []).append(c)\n\n    # Prepare output with only the detected full lines\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    for r, color in row_lines:\n        for c in range(w):\n            out[r][c] = color\n    for c, color in col_lines:\n        for r in range(h):\n            out[r][c] = color\n\n    # Helper sets to recognize cells already belonging to full lines\n    line_cells = set()\n    for r, color in row_lines:\n        for c in range(w):\n            line_cells.add((r, c))\n    for c, color in col_lines:\n        for r in range(h):\n            line_cells.add((r, c))\n\n    # Project scattered cells of a line's color to the adjacent side of that line\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0:\n                continue\n            if (r, c) in line_cells:\n                continue\n            if color not in rows_by_color and color not in cols_by_color:\n                continue\n\n            candidates = []\n\n            for rr in rows_by_color.get(color, []):\n                if r < rr and rr - 1 >= 0:\n                    candidates.append((abs(r - rr), rr - 1, c))\n                elif r > rr and rr + 1 < h:\n                    candidates.append((abs(r - rr), rr + 1, c))\n\n            for cc in cols_by_color.get(color, []):\n                if c < cc and cc - 1 >= 0:\n                    candidates.append((abs(c - cc), r, cc - 1))\n                elif c > cc and cc + 1 < w:\n                    candidates.append((abs(c - cc), r, cc + 1))\n\n            if not candidates:\n                continue\n\n            _, nr, nc = min(candidates, key=lambda t: t[0])\n            out[nr][nc] = color\n\n    return out",
