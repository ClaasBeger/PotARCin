  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    segments = []\n\n    for c in [0, w - 1]:\n        r = 0\n        while r < h:\n            if grid[r][c] == 2:\n                start = r\n                while r < h and grid[r][c] == 2:\n                    r += 1\n                end = r - 1\n                segments.append((start, end, c))\n            else:\n                r += 1\n\n    if len(segments) != 2:\n        return out\n\n    segments.sort(key=lambda x: x[0])\n    upper = segments[0]\n    lower = segments[1]\n\n    upper_start, upper_end, upper_col = upper\n    lower_start, lower_end, lower_col = lower\n\n    source_eights = []\n    for r in range(upper_start, upper_end + 1):\n        for c in range(w):\n            if grid[r][c] == 8:\n                source_eights.append((r, c))\n\n    for r, c in source_eights:\n        if upper_col == 0:\n            for cc in range(1, c):\n                out[r][cc] = 8\n            out[r][c] = 4\n        else:\n            out[r][c] = 4\n            for cc in range(c + 1, w - 1):\n                out[r][cc] = 8\n\n        rr = lower_start + (r - upper_start)\n        if 0 <= rr < h:\n            if lower_col == 0:\n                for cc in range(1, w):\n                    if cc != lower_col:\n                        out[rr][cc] = 8\n                out[rr][lower_col] = 2\n            else:\n                for cc in range(0, w - 1):\n                    if cc != lower_col:\n                        out[rr][cc] = 8\n                out[rr][lower_col] = 2\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    segments = []\n\n    for c in [0, w - 1]:\n        r = 0\n        while r < h:\n            if grid[r][c] == 2:\n                start = r\n                while r < h and grid[r][c] == 2:\n                    r += 1\n                end = r - 1\n                segments.append((start, end, c))\n            else:\n                r += 1\n\n    if len(segments) != 2:\n        return out\n\n    segments.sort(key=lambda x: x[0])\n    upper = segments[0]\n    lower = segments[1]\n\n    upper_start, upper_end, upper_col = upper\n    lower_start, lower_end, lower_col = lower\n\n    source_eights = []\n    for r in range(upper_start, upper_end + 1):\n        for c in range(w):\n            if grid[r][c] == 8:\n                source_eights.append((r, c))\n\n    for r, c in source_eights:\n        if upper_col == 0:\n            for cc in range(1, c):\n                out[r][cc] = 8\n            out[r][c] = 4\n        else:\n            out[r][c] = 4\n            for cc in range(c + 1, w - 1):\n                out[r][cc] = 8\n\n        rr = lower_start + (r - upper_start)\n        if 0 <= rr < h:\n            if lower_col == 0:\n                for cc in range(1, w):\n                    if cc != lower_col:\n                        out[rr][cc] = 8\n                out[rr][lower_col] = 2\n            else:\n                for cc in range(0, w - 1):\n                    if cc != lower_col:\n                        out[rr][cc] = 8\n                out[rr][lower_col] = 2\n\n    return out",
