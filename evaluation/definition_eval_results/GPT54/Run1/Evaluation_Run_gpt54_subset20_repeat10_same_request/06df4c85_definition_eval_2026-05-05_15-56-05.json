  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def find_separator_color():\n        candidates = []\n        for r in range(h):\n            v = grid[r][0]\n            if v != 0 and all(grid[r][c] == v for c in range(w)):\n                candidates.append(v)\n        for c in range(w):\n            v = grid[0][c]\n            if v != 0 and all(grid[r][c] == v for r in range(h)):\n                candidates.append(v)\n        if candidates:\n            counts = {}\n            for v in candidates:\n                counts[v] = counts.get(v, 0) + 1\n            return max(counts, key=counts.get)\n        return 0\n\n    sep = find_separator_color()\n\n    sep_rows = {r for r in range(h) if all(grid[r][c] == sep for c in range(w))}\n    sep_cols = {c for c in range(w) if all(grid[r][c] == sep for r in range(h))}\n\n    def get_blocks(n, seps):\n        blocks = []\n        start = None\n        for i in range(n):\n            if i in seps:\n                if start is not None:\n                    blocks.append((start, i - 1))\n                    start = None\n            else:\n                if start is None:\n                    start = i\n        if start is not None:\n            blocks.append((start, n - 1))\n        return blocks\n\n    row_blocks = get_blocks(h, sep_rows)\n    col_blocks = get_blocks(w, sep_cols)\n\n    R = len(row_blocks)\n    C = len(col_blocks)\n\n    cells = [[0 for _ in range(C)] for _ in range(R)]\n\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            color = 0\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep:\n                        color = v\n                        break\n                if color:\n                    break\n            cells[i][j] = color\n\n    positions_by_color = {}\n    for i in range(R):\n        for j in range(C):\n            v = cells[i][j]\n            if v != 0:\n                positions_by_color.setdefault(v, []).append((i, j))\n\n    for color, positions in positions_by_color.items():\n        rows = {}\n        cols = {}\n        for i, j in positions:\n            rows.setdefault(i, []).append(j)\n            cols.setdefault(j, []).append(i)\n\n        for i, js in rows.items():\n            if len(js) >= 2:\n                a, b = min(js), max(js)\n                for j in range(a, b + 1):\n                    if cells[i][j] == 0 or cells[i][j] == color:\n                        cells[i][j] = color\n\n        for j, is_ in cols.items():\n            if len(is_) >= 2:\n                a, b = min(is_), max(is_)\n                for i in range(a, b + 1):\n                    if cells[i][j] == 0 or cells[i][j] == color:\n                        cells[i][j] = color\n\n    out = [row[:] for row in grid]\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            color = cells[i][j]\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def find_separator_color():\n        candidates = []\n        for r in range(h):\n            v = grid[r][0]\n            if v != 0 and all(grid[r][c] == v for c in range(w)):\n                candidates.append(v)\n        for c in range(w):\n            v = grid[0][c]\n            if v != 0 and all(grid[r][c] == v for r in range(h)):\n                candidates.append(v)\n        if candidates:\n            counts = {}\n            for v in candidates:\n                counts[v] = counts.get(v, 0) + 1\n            return max(counts, key=counts.get)\n        return 0\n\n    sep = find_separator_color()\n\n    sep_rows = {r for r in range(h) if all(grid[r][c] == sep for c in range(w))}\n    sep_cols = {c for c in range(w) if all(grid[r][c] == sep for r in range(h))}\n\n    def get_blocks(n, seps):\n        blocks = []\n        start = None\n        for i in range(n):\n            if i in seps:\n                if start is not None:\n                    blocks.append((start, i - 1))\n                    start = None\n            else:\n                if start is None:\n                    start = i\n        if start is not None:\n            blocks.append((start, n - 1))\n        return blocks\n\n    row_blocks = get_blocks(h, sep_rows)\n    col_blocks = get_blocks(w, sep_cols)\n\n    R = len(row_blocks)\n    C = len(col_blocks)\n\n    cells = [[0 for _ in range(C)] for _ in range(R)]\n\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            color = 0\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep:\n                        color = v\n                        break\n                if color:\n                    break\n            cells[i][j] = color\n\n    positions_by_color = {}\n    for i in range(R):\n        for j in range(C):\n            v = cells[i][j]\n            if v != 0:\n                positions_by_color.setdefault(v, []).append((i, j))\n\n    for color, positions in positions_by_color.items():\n        rows = {}\n        cols = {}\n        for i, j in positions:\n            rows.setdefault(i, []).append(j)\n            cols.setdefault(j, []).append(i)\n\n        for i, js in rows.items():\n            if len(js) >= 2:\n                a, b = min(js), max(js)\n                for j in range(a, b + 1):\n                    if cells[i][j] == 0 or cells[i][j] == color:\n                        cells[i][j] = color\n\n        for j, is_ in cols.items():\n            if len(is_) >= 2:\n                a, b = min(is_), max(is_)\n                for i in range(a, b + 1):\n                    if cells[i][j] == 0 or cells[i][j] == color:\n                        cells[i][j] = color\n\n    out = [row[:] for row in grid]\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            color = cells[i][j]\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    out[r][c] = color\n\n    return out",
