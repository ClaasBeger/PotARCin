  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    original = [row[:] for row in grid]\n\n    # Find vertical contiguous segments of color 2.\n    segments = []\n    for c in range(w):\n        r = 0\n        while r < h:\n            if original[r][c] == 2:\n                start = r\n                while r < h and original[r][c] == 2:\n                    r += 1\n                end = r - 1\n                # Keep only pure vertical bar cells in this contiguous run.\n                cells = [(rr, cc) for rr in range(start, end + 1) for cc in range(w) if original[rr][cc] == 2]\n                if all(cc == c for rr, cc in cells):\n                    segments.append({\"col\": c, \"top\": start, \"bottom\": end, \"len\": end - start + 1})\n            else:\n                r += 1\n\n    if len(segments) < 2:\n        return out\n\n    # Use the two vertical bars.\n    # If more than two are found, choose the two longest; ties by column.\n    segments.sort(key=lambda s: (-s[\"len\"], s[\"col\"]))\n    segs = segments[:2]\n    segs.sort(key=lambda s: s[\"top\"])\n\n    def seeds_for_segment(seg):\n        seeds = []\n        for r in range(seg[\"top\"], seg[\"bottom\"] + 1):\n            for c in range(w):\n                if c != seg[\"col\"] and original[r][c] == 8:\n                    seeds.append((r, c))\n        return seeds\n\n    seeds0 = seeds_for_segment(segs[0])\n    seeds1 = seeds_for_segment(segs[1])\n\n    tasks = []\n    if seeds0:\n        tasks.append((segs[0], segs[1], seeds0))\n    if seeds1:\n        tasks.append((segs[1], segs[0], seeds1))\n\n    for origin, target, seeds in tasks:\n        for r, c in seeds:\n            # Draw from origin bar to the seed, and convert seed 8 -> 4.\n            if origin[\"col\"] < c:\n                for cc in range(origin[\"col\"] + 1, c):\n                    out[r][cc] = 8\n            else:\n                for cc in range(c + 1, origin[\"col\"]):\n                    out[r][cc] = 8\n            out[r][c] = 4\n\n            # Mirror by relative row position onto the other bar.\n            rr = target[\"top\"] + (r - origin[\"top\"])\n            if 0 <= rr < h:\n                if target[\"col\"] == 0:\n                    for cc in range(1, w):\n                        out[rr][cc] = 8\n                    out[rr][0] = 2\n                elif target[\"col\"] == w - 1:\n                    for cc in range(0, w - 1):\n                        out[rr][cc] = 8\n                    out[rr][w - 1] = 2\n                else:\n                    # General case: fill away from the bar toward the farther edge.\n                    if target[\"col\"] < w // 2:\n                        for cc in range(target[\"col\"] + 1, w):\n                            out[rr][cc] = 8\n                        out[rr][target[\"col\"]] = 2\n                    else:\n                        for cc in range(0, target[\"col\"]):\n                            out[rr][cc] = 8\n                        out[rr][target[\"col\"]] = 2\n\n    return out",
