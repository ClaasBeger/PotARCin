gin[\"col\"]):\n                    out[r][cc] = 8\n            out[r][c] = 4\n\n            # Mirror by relative row position onto the other bar.\n            rr = target[\"top\"] + (r - origin[\"top\"])\n            if 0 <= rr < h:\n                if target[\"col\"] == 0:\n                    for cc in range(1, w):\n                        out[rr][cc] = 8\n                    out[rr][0] = 2\n                elif target[\"col\"] == w - 1:\n                    for cc in range(0, w - 1):\n                        out[rr][cc] = 8\n                    out[rr][w - 1] = 2\n                else:\n                    # General case: fill away from the bar toward the farther edge.\n                    if target[\"col\"] < w // 2:\n                        for cc in range(target[\"col\"] + 1, w):\n                            out[rr][cc] = 8\n                        out[rr][target[\"col\"]] = 2\n                    else:\n                        for cc in range(0, target[\"col\"]):\n                            out[rr][cc] = 8\n                        out[rr][target[\"col\"]] = 2\n\n    return out",
