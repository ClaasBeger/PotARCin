  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find complete rows/columns of a single nonzero color\n    full_rows = {}\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            full_rows.setdefault(c, []).append(r)\n\n    full_cols = {}\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            full_cols.setdefault(v, []).append(c)\n\n    # Start with blank output, then copy the complete lines\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for color, rows in full_rows.items():\n        for r in rows:\n            for c in range(w):\n                out[r][c] = color\n\n    for color, cols in full_cols.items():\n        for c in cols:\n            for r in range(h):\n                out[r][c] = color\n\n    # Project scattered cells of colors that have a complete line of the same color\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0:\n                continue\n\n            on_full_row = color in full_rows and r in full_rows[color]\n            on_full_col = color in full_cols and c in full_cols[color]\n            if on_full_row or on_full_col:\n                continue\n\n            rows = full_rows.get(color, [])\n            cols = full_cols.get(color, [])\n\n            if not rows and not cols:\n                continue\n\n            # Choose the nearest available full line orientation\n            best = None  # (distance, kind, line_index)\n            for rr in rows:\n                d = abs(r - rr)\n                cand = (d, 'row', rr)\n                if best is None or cand < best:\n                    best = cand\n            for cc in cols:\n                d = abs(c - cc)\n                cand = (d, 'col', cc)\n                if best is None or cand < best:\n                    best = cand\n\n            _, kind, line = best\n\n            if kind == 'row':\n                if r < line:\n                    tr = line - 1\n                elif r > line:\n                    tr = line + 1\n                else:\n                    continue\n                if 0 <= tr < h:\n                    out[tr][c] = color\n            else:\n                if c < line:\n                    tc = line - 1\n                elif c > line:\n                    tc = line + 1\n                else:\n                    continue\n                if 0 <= tc < w:\n                    out[r][tc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find complete rows/columns of a single nonzero color\n    full_rows = {}\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            full_rows.setdefault(c, []).append(r)\n\n    full_cols = {}\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            full_cols.setdefault(v, []).append(c)\n\n    # Start with blank output, then copy the complete lines\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for color, rows in full_rows.items():\n        for r in rows:\n            for c in range(w):\n                out[r][c] = color\n\n    for color, cols in full_cols.items():\n        for c in cols:\n            for r in range(h):\n                out[r][c] = color\n\n    # Project scattered cells of colors that have a complete line of the same color\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0:\n                continue\n\n            on_full_row = color in full_rows and r in full_rows[color]\n            on_full_col = color in full_cols and c in full_cols[color]\n            if on_full_row or on_full_col:\n                continue\n\n            rows = full_rows.get(color, [])\n            cols = full_cols.get(color, [])\n\n            if not rows and not cols:\n                continue\n\n            # Choose the nearest available full line orientation\n            best = None  # (distance, kind, line_index)\n            for rr in rows:\n                d = abs(r - rr)\n                cand = (d, 'row', rr)\n                if best is None or cand < best:\n                    best = cand\n            for cc in cols:\n                d = abs(c - cc)\n                cand = (d, 'col', cc)\n                if best is None or cand < best:\n                    best = cand\n\n            _, kind, line = best\n\n            if kind == 'row':\n                if r < line:\n                    tr = line - 1\n                elif r > line:\n                    tr = line + 1\n                else:\n                    continue\n                if 0 <= tr < h:\n                    out[tr][c] = color\n            else:\n                if c < line:\n                    tc = line - 1\n                elif c > line:\n                    tc = line + 1\n                else:\n                    continue\n                if 0 <= tc < w:\n                    out[r][tc] = color\n\n    return out",
