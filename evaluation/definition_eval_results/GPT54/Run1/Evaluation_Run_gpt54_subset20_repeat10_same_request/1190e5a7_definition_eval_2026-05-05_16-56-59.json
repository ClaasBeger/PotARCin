elf, no other text or markdown.",
  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find the separator color: a color that appears as at least one full row\n    # and at least one full column.\n    row_full_colors = set()\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            row_full_colors.add(grid[r][0])\n\n    col_full_colors = set()\n    for c in range(w):\n        first = grid[0][c]\n        if all(grid[r][c] == first for r in range(h)):\n            col_full_colors.add(first)\n\n    candidates = row_full_colors & col_full_colors\n    if not candidates:\n        # Fallback: return grid unchanged if pattern is not found\n        return [row[:] for row in grid]\n\n    sep = next(iter(candidates))\n\n    # Count contiguous non-separator row groups\n    row_groups = 0\n    in_group = False\n    for r in range(h):\n        is_sep_row = all(grid[r][c] == sep for c in range(w))\n        if not is_sep_row:\n            if not in_group:\n                row_groups += 1\n                in_group = True\n        else:\n            in_group = False\n\n    # Count contiguous non-separator column groups\n    col_groups = 0\n    in_group = False\n    for c in range(w):\n        is_sep_col = all(grid[r][c] == sep for r in range(h))\n        if not is_sep_col:\n            if not in_group:\n                col_groups += 1\n                in_group = True\n        else:\n            in_group = False\n\n    # Fill color is the most common non-separator color\n    counts = {}\n    for r in range(h):\n        for c in range(w):\n            val = grid[r][c]\n            if val != sep:\n                counts[val] = counts.get(val, 0) + 1\n\n    fill = max(counts, key=counts.get)\n\n    return [[fill for _ in range(col_groups)] for _ in range(row_groups)]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find the separator color: a color that appears as at least one full row\n    # and at least one full column.\n    row_full_colors = set()\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            row_full_colors.add(grid[r][0])\n\n    col_full_colors = set()\n    for c in range(w):\n        first = grid[0][c]\n        if all(grid[r][c] == first for r in range(h)):\n            col_full_colors.add(first)\n\n    candidates = row_full_colors & col_full_colors\n    if not candidates:\n        # Fallback: return grid unchanged if pattern is not found\n        return [row[:] for row in grid]\n\n    sep = next(iter(candidates))\n\n    # Count contiguous non-separator row groups\n    row_groups = 0\n    in_group = False\n    for r in range(h):\n        is_sep_row = all(grid[r][c] == sep for c in range(w))\n        if not is_sep_row:\n            if not in_group:\n                row_groups += 1\n                in_group = True\n        else:\n            in_group = False\n\n    # Count contiguous non-separator column groups\n    col_groups = 0\n    in_group = False\n    for c in range(w):\n        is_sep_col = all(grid[r][c] == sep for r in range(h))\n        if not is_sep_col:\n            if not in_group:\n                col_groups += 1\n                in_group = True\n        else:\n            in_group = False\n\n    # Fill color is the most common non-separator color\n    counts = {}\n    for r in range(h):\n        for c in range(w):\n            val = grid[r][c]\n            if val != sep:\n                counts[val] = counts.get(val, 0) + 1\n\n    fill = max(counts, key=counts.get)\n\n    return [[fill for _ in range(col_groups)] for _ in range(row_groups)]",
