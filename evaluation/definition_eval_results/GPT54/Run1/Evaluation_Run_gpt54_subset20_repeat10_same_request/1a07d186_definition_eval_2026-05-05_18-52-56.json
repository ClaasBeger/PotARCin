  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    full_rows = {}\n    full_cols = {}\n\n    # Find full non-zero rows\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            full_rows.setdefault(c, []).append(r)\n\n    # Find full non-zero columns\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            full_cols.setdefault(v, []).append(c)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Copy full rows\n    for color, rows in full_rows.items():\n        for r in rows:\n            for c in range(w):\n                out[r][c] = color\n\n    # Copy full columns\n    for color, cols in full_cols.items():\n        for c in cols:\n            for r in range(h):\n                out[r][c] = color\n\n    # Move scattered cells of colors that have a corresponding full line\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0:\n                continue\n\n            # Skip cells that are already part of a full line\n            on_full_row = color in full_rows and r in full_rows[color]\n            on_full_col = color in full_cols and c in full_cols[color]\n            if on_full_row or on_full_col:\n                continue\n\n            candidates = []\n\n            # Candidate targets from full rows of the same color\n            for rr in full_rows.get(color, []):\n                if r < rr and rr - 1 >= 0:\n                    candidates.append((abs(r - rr), 0, rr - 1, c))\n                elif r > rr and rr + 1 < h:\n                    candidates.append((abs(r - rr), 0, rr + 1, c))\n\n            # Candidate targets from full columns of the same color\n            for cc in full_cols.get(color, []):\n                if c < cc and cc - 1 >= 0:\n                    candidates.append((abs(c - cc), 1, r, cc - 1))\n                elif c > cc and cc + 1 < w:\n                    candidates.append((abs(c - cc), 1, r, cc + 1))\n\n            if candidates:\n                _, _, tr, tc = min(candidates)\n                out[tr][tc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    full_rows = {}\n    full_cols = {}\n\n    # Find full non-zero rows\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            full_rows.setdefault(c, []).append(r)\n\n    # Find full non-zero columns\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[y][c] == v for y in range(h)):\n            full_cols.setdefault(v, []).append(c)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Copy full rows\n    for color, rows in full_rows.items():\n        for r in rows:\n            for c in range(w):\n                out[r][c] = color\n\n    # Copy full columns\n    for color, cols in full_cols.items():\n        for c in cols:\n            for r in range(h):\n                out[r][c] = color\n\n    # Move scattered cells of colors that have a corresponding full line\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0:\n                continue\n\n            # Skip cells that are already part of a full line\n            on_full_row = color in full_rows and r in full_rows[color]\n            on_full_col = color in full_cols and c in full_cols[color]\n            if on_full_row or on_full_col:\n                continue\n\n            candidates = []\n\n            # Candidate targets from full rows of the same color\n            for rr in full_rows.get(color, []):\n                if r < rr and rr - 1 >= 0:\n                    candidates.append((abs(r - rr), 0, rr - 1, c))\n                elif r > rr and rr + 1 < h:\n                    candidates.append((abs(r - rr), 0, rr + 1, c))\n\n            # Candidate targets from full columns of the same color\n            for cc in full_cols.get(color, []):\n                if c < cc and cc - 1 >= 0:\n                    candidates.append((abs(c - cc), 1, r, cc - 1))\n                elif c > cc and cc + 1 < w:\n                    candidates.append((abs(c - cc), 1, r, cc + 1))\n\n            if candidates:\n                _, _, tr, tc = min(candidates)\n                out[tr][tc] = color\n\n    return out",
