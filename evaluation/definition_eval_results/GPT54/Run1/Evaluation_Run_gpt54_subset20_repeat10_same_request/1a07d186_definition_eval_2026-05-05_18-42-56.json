  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find full monochrome rows and columns\n    full_rows = {}  # color -> list of row indices\n    full_cols = {}  # color -> list of col indices\n\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            full_rows.setdefault(c, []).append(r)\n\n    for x in range(w):\n        c = grid[0][x]\n        if c != 0 and all(grid[y][x] == c for y in range(h)):\n            full_cols.setdefault(c, []).append(x)\n\n    # Build output with only the full lines preserved\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for c, rows in full_rows.items():\n        for r in rows:\n            for x in range(w):\n                out[r][x] = c\n\n    for c, cols in full_cols.items():\n        for x in cols:\n            for y in range(h):\n                out[y][x] = c\n\n    # Helper sets for cells already belonging to full lines\n    row_line_cells = set()\n    for rows in full_rows.values():\n        for r in rows:\n            for x in range(w):\n                row_line_cells.add((r, x))\n\n    col_line_cells = set()\n    for cols in full_cols.values():\n        for x in cols:\n            for y in range(h):\n                col_line_cells.add((y, x))\n\n    # Project scattered cells of a line's color to the cell adjacent to that line\n    for y in range(h):\n        for x in range(w):\n            color = grid[y][x]\n            if color == 0:\n                continue\n            if (y, x) in row_line_cells or (y, x) in col_line_cells:\n                continue\n\n            placed = False\n\n            if color in full_rows:\n                target_row = min(full_rows[color], key=lambda r: abs(y - r))\n                if y < target_row and target_row - 1 >= 0:\n                    out[target_row - 1][x] = color\n                    placed = True\n                elif y > target_row and target_row + 1 < h:\n                    out[target_row + 1][x] = color\n                    placed = True\n\n            if not placed and color in full_cols:\n                target_col = min(full_cols[color], key=lambda c: abs(x - c))\n                if x < target_col and target_col - 1 >= 0:\n                    out[y][target_col - 1] = color\n                elif x > target_col and target_col + 1 < w:\n                    out[y][target_col + 1] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find full monochrome rows and columns\n    full_rows = {}  # color -> list of row indices\n    full_cols = {}  # color -> list of col indices\n\n    for r in range(h):\n        c = grid[r][0]\n        if c != 0 and all(grid[r][x] == c for x in range(w)):\n            full_rows.setdefault(c, []).append(r)\n\n    for x in range(w):\n        c = grid[0][x]\n        if c != 0 and all(grid[y][x] == c for y in range(h)):\n            full_cols.setdefault(c, []).append(x)\n\n    # Build output with only the full lines preserved\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for c, rows in full_rows.items():\n        for r in rows:\n            for x in range(w):\n                out[r][x] = c\n\n    for c, cols in full_cols.items():\n        for x in cols:\n            for y in range(h):\n                out[y][x] = c\n\n    # Helper sets for cells already belonging to full lines\n    row_line_cells = set()\n    for rows in full_rows.values():\n        for r in rows:\n            for x in range(w):\n                row_line_cells.add((r, x))\n\n    col_line_cells = set()\n    for cols in full_cols.values():\n        for x in cols:\n            for y in range(h):\n                col_line_cells.add((y, x))\n\n    # Project scattered cells of a line's color to the cell adjacent to that line\n    for y in range(h):\n        for x in range(w):\n            color = grid[y][x]\n            if color == 0:\n                continue\n            if (y, x) in row_line_cells or (y, x) in col_line_cells:\n                continue\n\n            placed = False\n\n            if color in full_rows:\n                target_row = min(full_rows[color], key=lambda r: abs(y - r))\n                if y < target_row and target_row - 1 >= 0:\n                    out[target_row - 1][x] = color\n                    placed = True\n                elif y > target_row and target_row + 1 < h:\n                    out[target_row + 1][x] = color\n                    placed = True\n\n            if not placed and color in full_cols:\n                target_col = min(full_cols[color], key=lambda c: abs(x - c))\n                if x < target_col and target_col - 1 >= 0:\n                    out[y][target_col - 1] = color\n                elif x > target_col and target_col + 1 < w:\n                    out[y][target_col + 1] = color\n\n    return out",
