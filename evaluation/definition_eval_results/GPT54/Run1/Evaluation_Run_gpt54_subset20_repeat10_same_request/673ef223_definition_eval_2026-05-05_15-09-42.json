  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    # Find the two vertical bars of 2s\n    bar_cols = []\n    for c in range(w):\n        rows = [r for r in range(h) if grid[r][c] == 2]\n        if rows:\n            # Keep columns that form one contiguous vertical segment\n            if max(rows) - min(rows) + 1 == len(rows):\n                bar_cols.append((c, min(rows), max(rows)))\n\n    # Expect two bars; if not, return unchanged\n    if len(bar_cols) != 2:\n        return out\n\n    # Determine which bar has the 8-markers aligned with it\n    def marker_cells_for_bar(bar):\n        c, r0, r1 = bar\n        cells = []\n        for r in range(r0, r1 + 1):\n            for cc in range(w):\n                if grid[r][cc] == 8:\n                    cells.append((r, cc))\n        return cells\n\n    markers0 = marker_cells_for_bar(bar_cols[0])\n    markers1 = marker_cells_for_bar(bar_cols[1])\n\n    if markers0 and not markers1:\n        src_bar, dst_bar = bar_cols[0], bar_cols[1]\n        src_markers = markers0\n    elif markers1 and not markers0:\n        src_bar, dst_bar = bar_cols[1], bar_cols[0]\n        src_markers = markers1\n    else:\n        # Fallback: choose the bar with more markers\n        if len(markers0) >= len(markers1):\n            src_bar, dst_bar = bar_cols[0], bar_cols[1]\n            src_markers = markers0\n        else:\n            src_bar, dst_bar = bar_cols[1], bar_cols[0]\n            src_markers = markers1\n\n    src_c, src_top, src_bot = src_bar\n    dst_c, dst_top, dst_bot = dst_bar\n\n    offsets = []\n\n    # Draw from source bar to each 8 marker, converting the marker to 4\n    for r, c in src_markers:\n        offsets.append(r - src_top)\n        if src_c == 0:\n            for cc in range(1, c):\n                out[r][cc] = 8\n            out[r][c] = 4\n        elif src_c == w - 1:\n            out[r][c] = 4\n            for cc in range(c + 1, w - 1):\n                out[r][cc] = 8\n\n    # Replicate corresponding rows on the destination bar side\n    for off in offsets:\n        r = dst_top + off\n        if not (dst_top <= r <= dst_bot):\n            continue\n        if dst_c == 0:\n            for cc in range(1, w):\n                out[r][cc] = 8\n        elif dst_c == w - 1:\n            for cc in range(0, w - 1):\n                out[r][cc] = 8\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    # Find the two vertical bars of 2s\n    bar_cols = []\n    for c in range(w):\n        rows = [r for r in range(h) if grid[r][c] == 2]\n        if rows:\n            # Keep columns that form one contiguous vertical segment\n            if max(rows) - min(rows) + 1 == len(rows):\n                bar_cols.append((c, min(rows), max(rows)))\n\n    # Expect two bars; if not, return unchanged\n    if len(bar_cols) != 2:\n        return out\n\n    # Determine which bar has the 8-markers aligned with it\n    def marker_cells_for_bar(bar):\n        c, r0, r1 = bar\n        cells = []\n        for r in range(r0, r1 + 1):\n            for cc in range(w):\n                if grid[r][cc] == 8:\n                    cells.append((r, cc))\n        return cells\n\n    markers0 = marker_cells_for_bar(bar_cols[0])\n    markers1 = marker_cells_for_bar(bar_cols[1])\n\n    if markers0 and not markers1:\n        src_bar, dst_bar = bar_cols[0], bar_cols[1]\n        src_markers = markers0\n    elif markers1 and not markers0:\n        src_bar, dst_bar = bar_cols[1], bar_cols[0]\n        src_markers = markers1\n    else:\n        # Fallback: choose the bar with more markers\n        if len(markers0) >= len(markers1):\n            src_bar, dst_bar = bar_cols[0], bar_cols[1]\n            src_markers = markers0\n        else:\n            src_bar, dst_bar = bar_cols[1], bar_cols[0]\n            src_markers = markers1\n\n    src_c, src_top, src_bot = src_bar\n    dst_c, dst_top, dst_bot = dst_bar\n\n    offsets = []\n\n    # Draw from source bar to each 8 marker, converting the marker to 4\n    for r, c in src_markers:\n        offsets.append(r - src_top)\n        if src_c == 0:\n            for cc in range(1, c):\n                out[r][cc] = 8\n            out[r][c] = 4\n        elif src_c == w - 1:\n            out[r][c] = 4\n            for cc in range(c + 1, w - 1):\n                out[r][cc] = 8\n\n    # Replicate corresponding rows on the destination bar side\n    for off in offsets:\n        r = dst_top + off\n        if not (dst_top <= r <= dst_bot):\n            continue\n        if dst_c == 0:\n            for cc in range(1, w):\n                out[r][cc] = 8\n        elif dst_c == w - 1:\n            for cc in range(0, w - 1):\n                out[r][cc] = 8\n\n    return out",
