  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find the two vertical bars of 2s\n    bars = []\n    for c in range(w):\n        rows = [r for r in range(h) if grid[r][c] == 2]\n        if len(rows) >= 2:\n            ok = all(rows[i] + 1 == rows[i + 1] for i in range(len(rows) - 1))\n            if ok:\n                bars.append((rows[0], rows[-1], c))\n\n    # Use the two longest/valid bars if more are present\n    bars = sorted(bars, key=lambda x: (x[0], x[2]))\n    if len(bars) != 2:\n        return out\n\n    (s1, e1, c1), (s2, e2, c2) = bars\n\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n\n    for r, c in eights:\n        if s1 <= r <= e1:\n            src_s, src_e, src_c = s1, e1, c1\n            dst_s, dst_e, dst_c = s2, e2, c2\n        elif s2 <= r <= e2:\n            src_s, src_e, src_c = s2, e2, c2\n            dst_s, dst_e, dst_c = s1, e1, c1\n        else:\n            continue\n\n        offset = r - src_s\n        dst_r = dst_s + offset\n        if not (0 <= dst_r < h):\n            continue\n\n        # Draw on the source side: from the bar toward the 8, and turn the 8 into 4\n        if src_c < c:\n            for x in range(src_c + 1, c):\n                out[r][x] = 8\n            out[r][c] = 4\n        elif src_c > c:\n            out[r][c] = 4\n            for x in range(c + 1, src_c):\n                out[r][x] = 8\n\n        # Draw on the opposite side: full row from the opposite edge to the opposite bar\n        if dst_c == 0:\n            for x in range(1, w):\n                if out[dst_r][x] != 2:\n                    out[dst_r][x] = 8\n        elif dst_c == w - 1:\n            for x in range(0, w - 1):\n                if out[dst_r][x] != 2:\n                    out[dst_r][x] = 8\n        else:\n            # General case if the bar is not on an edge: fill from the farther edge toward the bar\n            if dst_c < w // 2:\n                for x in range(dst_c + 1, w):\n                    if out[dst_r][x] != 2:\n                        out[dst_r][x] = 8\n            else:\n                for x in range(0, dst_c):\n                    if out[dst_r][x] != 2:\n                        out[dst_r][x] = 8\n\n    return out",
