 final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from uniform rows/columns\n    uniform_row_vals = [row[0] for row in grid if all(v == row[0] for v in row)]\n    uniform_col_vals = []\n    for c in range(w):\n        v = grid[0][c]\n        ok = True\n        for r in range(h):\n            if grid[r][c] != v:\n                ok = False\n                break\n        if ok:\n            uniform_col_vals.append(v)\n\n    counts = {}\n    for v in uniform_row_vals + uniform_col_vals:\n        counts[v] = counts.get(v, 0) + 1\n    sep = max(counts, key=counts.get) if counts else 0\n\n    # Separator row/col indices\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep for r in range(h))]\n\n    # Build non-separator row/col segments (cell blocks)\n    row_segments = []\n    start = 0\n    for r in sep_rows:\n        if start <= r - 1:\n            row_segments.append((start, r - 1))\n        start = r + 1\n    if start <= h - 1:\n        row_segments.append((start, h - 1))\n\n    col_segments = []\n    start = 0\n    for c in sep_cols:\n        if start <= c - 1:\n            col_segments.append((start, c - 1))\n        start = c + 1\n    if start <= w - 1:\n        col_segments.append((start, w - 1))\n\n    nr = len(row_segments)\n    nc = len(col_segments)\n\n    # Read cell colors from blocks\n    cells = [[0 for _ in range(nc)] for _ in range(nr)]\n    colors_present = set()\n\n    for i, (r0, r1) in enumerate(row_segments):\n        for j, (c0, c1) in enumerate(col_segments):\n            vals = set()\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep:\n                        vals.add(v)\n            if len(vals) == 1:\n                color = next(iter(vals))\n                cells[i][j] = color\n                colors_present.add(color)\n\n    out = [row[:] for row in grid]\n\n    def fill_block(i, j, color):\n        r0, r1 = row_segments[i]\n        c0, c1 = col_segments[j]\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                out[r][c] = color\n\n    # Use original anchors only\n    for color in colors_present:\n        # Horizontal connections\n        for i in range(nr):\n            js = [j for j in range(nc) if cells[i][j] == color]\n            if len(js) >= 2:\n                for j in range(min(js), max(js) + 1):\n                    fill_block(i, j, color)\n\n        # Vertical connections\n        for j in range(nc):\n            is_ = [i for i in range(nr) if cells[i][j] == color]\n            if len(is_) >= 2:\n                for i in range(min(is_), max(is_) + 1):\n                    fill_block(i, j, color)\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from uniform rows/columns\n    uniform_row_vals = [row[0] for row in grid if all(v == row[0] for v in row)]\n    uniform_col_vals = []\n    for c in range(w):\n        v = grid[0][c]\n        ok = True\n        for r in range(h):\n            if grid[r][c] != v:\n                ok = False\n                break\n        if ok:\n            uniform_col_vals.append(v)\n\n    counts = {}\n    for v in uniform_row_vals + uniform_col_vals:\n        counts[v] = counts.get(v, 0) + 1\n    sep = max(counts, key=counts.get) if counts else 0\n\n    # Separator row/col indices\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep for r in range(h))]\n\n    # Build non-separator row/col segments (cell blocks)\n    row_segments = []\n    start = 0\n    for r in sep_rows:\n        if start <= r - 1:\n            row_segments.append((start, r - 1))\n        start = r + 1\n    if start <= h - 1:\n        row_segments.append((start, h - 1))\n\n    col_segments = []\n    start = 0\n    for c in sep_cols:\n        if start <= c - 1:\n            col_segments.append((start, c - 1))\n        start = c + 1\n    if start <= w - 1:\n        col_segments.append((start, w - 1))\n\n    nr = len(row_segments)\n    nc = len(col_segments)\n\n    # Read cell colors from blocks\n    cells = [[0 for _ in range(nc)] for _ in range(nr)]\n    colors_present = set()\n\n    for i, (r0, r1) in enumerate(row_segments):\n        for j, (c0, c1) in enumerate(col_segments):\n            vals = set()\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep:\n                        vals.add(v)\n            if len(vals) == 1:\n                color = next(iter(vals))\n                cells[i][j] = color\n                colors_present.add(color)\n\n    out = [row[:] for row in grid]\n\n    def fill_block(i, j, color):\n        r0, r1 = row_segments[i]\n        c0, c1 = col_segments[j]\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                out[r][c] = color\n\n    # Use original anchors only\n    for color in colors_present:\n        # Horizontal connections\n        for i in range(nr):\n            js = [j for j in range(nc) if cells[i][j] == color]\n            if len(js) >= 2:\n                for j in range(min(js), max(js) + 1):\n                    fill_block(i, j, color)\n\n        # Vertical connections\n        for j in range(nc):\n            is_ = [i for i in range(nr) if cells[i][j] == color]\n            if len(is_) >= 2:\n                for i in range(min(is_), max(is_) + 1):\n                    fill_block(i, j, color)\n\n    return out",
