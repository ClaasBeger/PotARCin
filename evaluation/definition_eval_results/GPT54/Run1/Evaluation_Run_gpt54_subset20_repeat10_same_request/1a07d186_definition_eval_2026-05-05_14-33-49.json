  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find colors that form complete rows or columns\n    full_rows = {}  # color -> set(rows)\n    full_cols = {}  # color -> set(cols)\n\n    for r in range(h):\n        color = grid[r][0]\n        if color != 0 and all(grid[r][c] == color for c in range(w)):\n            full_rows.setdefault(color, set()).add(r)\n\n    for c in range(w):\n        color = grid[0][c]\n        if color != 0 and all(grid[r][c] == color for r in range(h)):\n            full_cols.setdefault(color, set()).add(c)\n\n    # Build output with only the structural full lines kept\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for color, rows in full_rows.items():\n        for r in rows:\n            for c in range(w):\n                out[r][c] = color\n\n    for color, cols in full_cols.items():\n        for c in cols:\n            for r in range(h):\n                out[r][c] = color\n\n    # Project non-line cells of each anchored color onto the adjacent side of its line\n    anchored_colors = set(full_rows) | set(full_cols)\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or color not in anchored_colors:\n                continue\n\n            # Skip cells that are already part of a full row/column of that color\n            if color in full_rows and r in full_rows[color]:\n                continue\n            if color in full_cols and c in full_cols[color]:\n                continue\n\n            placed = False\n\n            # Prefer row anchor if present\n            if color in full_rows and full_rows[color]:\n                row = min(full_rows[color], key=lambda rr: abs(rr - r))\n                nr = row - 1 if r < row else row + 1\n                if 0 <= nr < h:\n                    out[nr][c] = color\n                    placed = True\n\n            # Otherwise use column anchor\n            if not placed and c