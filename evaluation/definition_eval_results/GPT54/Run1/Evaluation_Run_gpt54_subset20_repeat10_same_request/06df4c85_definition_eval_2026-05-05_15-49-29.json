  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from full uniform non-zero rows/columns\n    sep_color = None\n    for r in range(h):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            v = grid[r][0]\n            if v != 0:\n                sep_color = v\n                break\n    if sep_color is None:\n        for c in range(w):\n            vals = {grid[r][c] for r in range(h)}\n            if len(vals) == 1:\n                v = grid[0][c]\n                if v != 0:\n                    sep_color = v\n                    break\n\n    if sep_color is None:\n        return [row[:] for row in grid]\n\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep_color for r in range(h))]\n\n    def make_blocks(n, seps):\n        blocks = []\n        start = 0\n        seps = sorted(seps)\n        for s in seps:\n            if start < s:\n                blocks.append((start, s - 1))\n            start = s + 1\n        if start < n:\n            blocks.append((start, n - 1))\n        return blocks\n\n    row_blocks = make_blocks(h, sep_rows)\n    col_blocks = make_blocks(w, sep_cols)\n\n    nr = len(row_blocks)\n    nc = len(col_blocks)\n\n    # Read cell colors\n    cells = [[0] * nc for _ in range(nr)]\n    colors = set()\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            cnt = {}\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        cnt[v] = cnt.get(v, 0) + 1\n            if cnt:\n                color = max(cnt, key=cnt.get)\n                cells[i][j] = color\n                colors.add(color)\n\n    out_cells = [row[:] for row in cells]\n\n    for color in colors:\n        pos = [(r, c) for r in range(nr) for c in range(nc) if cells[r][c] == color]\n\n        rows_map = {}\n        cols_map = {}\n        for r, c in pos:\n            rows_map.setdefault(r, []).append(c)\n            cols_map.setdefault(c, []).append(r)\n\n        for r, cs in rows_map.items():\n            if len(cs) >= 2:\n                a, b = min(cs), max(cs)\n                for c in range(a, b + 1):\n                    out_cells[r][c] = color\n\n        for c, rs in cols_map.items():\n            if len(rs) >= 2:\n                a, b = min(rs), max(rs)\n                for r in range(a, b + 1):\n                    out_cells[r][c] = color\n\n    out = [row[:] for row in grid]\n\n    # Paint filled cells back into grid\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            color = out_cells[i][j]\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    out[r][c] = color\n\n    # Restore separator rows/cols\n    for r in sep_rows:\n        for c in range(w):\n            out[r][c] = sep_color\n    for c in sep_cols:\n        for r in range(h):\n            out[r][c] = sep_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color from full uniform non-zero rows/columns\n    sep_color = None\n    for r in range(h):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            v = grid[r][0]\n            if v != 0:\n                sep_color = v\n                break\n    if sep_color is None:\n        for c in range(w):\n            vals = {grid[r][c] for r in range(h)}\n            if len(vals) == 1:\n                v = grid[0][c]\n                if v != 0:\n                    sep_color = v\n                    break\n\n    if sep_color is None:\n        return [row[:] for row in grid]\n\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep_color for r in range(h))]\n\n    def make_blocks(n, seps):\n        blocks = []\n        start = 0\n        seps = sorted(seps)\n        for s in seps:\n            if start < s:\n                blocks.append((start, s - 1))\n            start = s + 1\n        if start < n:\n            blocks.append((start, n - 1))\n        return blocks\n\n    row_blocks = make_blocks(h, sep_rows)\n    col_blocks = make_blocks(w, sep_cols)\n\n    nr = len(row_blocks)\n    nc = len(col_blocks)\n\n    # Read cell colors\n    cells = [[0] * nc for _ in range(nr)]\n    colors = set()\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            cnt = {}\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        cnt[v] = cnt.get(v, 0) + 1\n            if cnt:\n                color = max(cnt, key=cnt.get)\n                cells[i][j] = color\n                colors.add(color)\n\n    out_cells = [row[:] for row in cells]\n\n    for color in colors:\n        pos = [(r, c) for r in range(nr) for c in range(nc) if cells[r][c] == color]\n\n        rows_map = {}\n        cols_map = {}\n        for r, c in pos:\n            rows_map.setdefault(r, []).append(c)\n            cols_map.setdefault(c, []).append(r)\n\n        for r, cs in rows_map.items():\n            if len(cs) >= 2:\n                a, b = min(cs), max(cs)\n                for c in range(a, b + 1):\n                    out_cells[r][c] = color\n\n        for c, rs in cols_map.items():\n            if len(rs) >= 2:\n                a, b = min(rs), max(rs)\n                for r in range(a, b + 1):\n                    out_cells[r][c] = color\n\n    out = [row[:] for row in grid]\n\n    # Paint filled cells back into grid\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            color = out_cells[i][j]\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    out[r][c] = color\n\n    # Restore separator rows/cols\n    for r in sep_rows:\n        for c in range(w):\n            out[r][c] = sep_color\n    for c in sep_cols:\n        for r in range(h):\n            out[r][c] = sep_color\n\n    return out",
