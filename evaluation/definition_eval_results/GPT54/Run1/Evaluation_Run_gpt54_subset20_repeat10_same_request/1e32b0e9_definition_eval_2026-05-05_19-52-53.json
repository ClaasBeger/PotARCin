  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: a non-zero color that forms full rows/columns.\n    sep_counts = {}\n    for r in range(h):\n        val = grid[r][0]\n        if val != 0 and all(grid[r][c] == val for c in range(w)):\n            sep_counts[val] = sep_counts.get(val, 0) + 1\n    for c in range(w):\n        val = grid[0][c]\n        if val != 0 and all(grid[r][c] == val for r in range(h)):\n            sep_counts[val] = sep_counts.get(val, 0) + 1\n\n    sep = max(sep_counts, key=sep_counts.get)\n\n    # Separator rows/cols\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep for r in range(h))]\n\n    # Non-separator row/col segments\n    row_segments = []\n    start = 0\n    for r in sep_rows + [h]:\n        if start < r:\n            row_segments.append((start, r))\n        start = r + 1\n\n    col_segments = []\n    start = 0\n    for c in sep_cols + [w]:\n        if start < c:\n            col_segments.append((start, c))\n        start = c + 1\n\n    # Find object color (non-zero, non-separator)\n    obj = None\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != sep:\n                obj = v\n                break\n        if obj is not None:\n            break\n\n    # Canonical mask = union of all object cells in corresponding block coordinates\n    bh = row_segments[0][1] - row_segments[0][0]\n    bw = col_segments[0][1] - col_segments[0][0]\n    mask = [[False] * bw for _ in range(bh)]\n\n    for r0, r1 in row_segments:\n        for c0, c1 in col_segments:\n            for i in range(r1 - r0):\n                for j in range(c1 - c0):\n                    if grid[r0 + i][c0 + j] == obj:\n                        mask[i][j] = True\n\n    # Apply mask to every block: preserve object cells, fill missing mask cells with separator color\n    out = [row[:] for row in grid]\n    for r0, r1 in row_segments:\n        for c0, c1 in col_segments:\n            for i in range(r1 - r0):\n                for j in range(c1 - c0):\n                    if mask[i][j] and out[r0 + i][c0 + j] == 0:\n                        out[r0 + i][c0 + j] = sep\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: a non-zero color that forms full rows/columns.\n    sep_counts = {}\n    for r in range(h):\n        val = grid[r][0]\n        if val != 0 and all(grid[r][c] == val for c in range(w)):\n            sep_counts[val] = sep_counts.get(val, 0) + 1\n    for c in range(w):\n        val = grid[0][c]\n        if val != 0 and all(grid[r][c] == val for r in range(h)):\n            sep_counts[val] = sep_counts.get(val, 0) + 1\n\n    sep = max(sep_counts, key=sep_counts.get)\n\n    # Separator rows/cols\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep for r in range(h))]\n\n    # Non-separator row/col segments\n    row_segments = []\n    start = 0\n    for r in sep_rows + [h]:\n        if start < r:\n            row_segments.append((start, r))\n        start = r + 1\n\n    col_segments = []\n    start = 0\n    for c in sep_cols + [w]:\n        if start < c:\n            col_segments.append((start, c))\n        start = c + 1\n\n    # Find object color (non-zero, non-separator)\n    obj = None\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != sep:\n                obj = v\n                break\n        if obj is not None:\n            break\n\n    # Canonical mask = union of all object cells in corresponding block coordinates\n    bh = row_segments[0][1] - row_segments[0][0]\n    bw = col_segments[0][1] - col_segments[0][0]\n    mask = [[False] * bw for _ in range(bh)]\n\n    for r0, r1 in row_segments:\n        for c0, c1 in col_segments:\n            for i in range(r1 - r0):\n                for j in range(c1 - c0):\n                    if grid[r0 + i][c0 + j] == obj:\n                        mask[i][j] = True\n\n    # Apply mask to every block: preserve object cells, fill missing mask cells with separator color\n    out = 