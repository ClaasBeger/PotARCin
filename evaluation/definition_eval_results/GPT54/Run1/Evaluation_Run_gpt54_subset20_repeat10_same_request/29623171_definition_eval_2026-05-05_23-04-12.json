  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Detect separator color from any full non-zero row/column\n    full_row_vals = []\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)) and grid[r][0] != 0:\n            full_row_vals.append(grid[r][0])\n\n    full_col_vals = []\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[r][c] == v for r in range(h)):\n            full_col_vals.append(v)\n\n    wall_color = full_row_vals[0] if full_row_vals else full_col_vals[0]\n\n    sep_rows = [r for r in range(h) if all(grid[r][c] == wall_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == wall_color for r in range(h))]\n\n    # Build row/col segments between separator lines\n    row_segments = []\n    start = 0\n    for r in sep_rows + [h]:\n        if start < r:\n            row_segments.append((start, r))\n        start = r + 1\n\n    col_segments = []\n    start = 0\n    for c in sep_cols + [w]:\n        if start < c:\n            col_segments.append((start, c))\n        start = c + 1\n\n    # Determine the drawing color (non-zero and not wall color)\n    draw_color = None\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != wall_color:\n                draw_color = v\n                break\n        if draw_color is not None:\n            break\n\n    # Count colored cells in each subgrid\n    counts = {}\n    max_count = 0\n    for i, (r0, r1) in enumerate(row_segments):\n        for j, (c0, c1) in enumerate(col_segments):\n            cnt = 0\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    if grid[r][c] == draw_color:\n                        cnt += 1\n            counts[(i, j)] = cnt\n            if cnt > max_count:\n                max_count = cnt\n\n    # Start output: keep walls, clear everything else\n    out = [[wall_color if grid[r][c] == wall_color else 0 for c in range(w)] for r in range(h)]\n\n    # Fill every subgrid that has the maximum count\n    for (i, j), cnt in counts.items():\n        if cnt == max_count and cnt > 0:\n            r0, r1 = row_segments[i]\n            c0, c1 = col_segments[j]\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    out[r][c] = draw_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Detect separator color from any full non-zero row/column\n    full_row_vals = []\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)) and grid[r][0] != 0:\n            full_row_vals.append(grid[r][0])\n\n    full_col_vals = []\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and all(grid[r][c] == v for r in range(h)):\n            full_col_vals.append(v)\n\n    wall_color = full_row_vals[0] if full_row_vals else full_col_vals[0]\n\n    sep_rows = [r for r in range(h) if all(grid[r][c] == wall_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == wall_color for r in range(h))]\n\n    # Build row/col segments between separator lines\n    row_segments = []\n    start = 0\n    for r in sep_rows + [h]:\n        if start < r:\n            row_segments.append((start, r))\n        start = r + 1\n\n    col_segments = []\n    start = 0\n    for c in sep_cols + [w]:\n        if start < c:\n            col_segments.append((start, c))\n        start = c + 1\n\n    # Determine the drawing color (non-zero and not wall color)\n    draw_color = None\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != wall_color:\n                draw_color = v\n                break\n        if draw_color is not None:\n            break\n\n    # Count colored cells in each subgrid\n    counts = {}\n    max_count = 0\n    for i, (r0, r1) in enumerate(row_segments):\n        for j, (c0, c1) in enumerate(col_segments):\n            cnt = 0\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    if grid[r][c] == draw_color:\n                        cnt += 1\n            counts[(i, j)] = cnt\n            if cnt > max_count:\n                max_count = cnt\n\n    # Start output: keep walls, clear everything else\n    out = [[wall_color if grid[r][c] == wall_color else 0 for c in range(w)] for r in range(h)]\n\n    # Fill every subgrid that has the maximum count\n    for (i, j), cnt in counts.items():\n        if cnt == max_count and cnt > 0:\n            r0, r1 = row_segments[i]\n            c0, c1 = col_segments[j]\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    out[r][c] = draw_color\n\n    return out",
