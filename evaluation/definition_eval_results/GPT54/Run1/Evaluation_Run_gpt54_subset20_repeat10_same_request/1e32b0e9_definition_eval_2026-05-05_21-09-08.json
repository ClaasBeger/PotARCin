  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color and separator rows/cols:\n    # rows/cols that are completely filled with one same nonzero color.\n    row_seps = []\n    col_seps = []\n    sep_color = None\n\n    for i in range(h):\n        v = grid[i][0]\n        if v != 0 and all(cell == v for cell in grid[i]):\n            row_seps.append(i)\n            if sep_color is None:\n                sep_color = v\n\n    for j in range(w):\n        v = grid[0][j]\n        if v != 0 and all(grid[i][j] == v for i in range(h)):\n            col_seps.append(j)\n            if sep_color is None:\n                sep_color = v\n\n    # Fallback: if not found, return unchanged\n    if sep_color is None or not row_seps or not col_seps:\n        return [row[:] for row in grid]\n\n    # Determine object colors (nonzero and not separator)\n    object_colors = set()\n    for i in range(h):\n        for j in range(w):\n            v = grid[i][j]\n            if v != 0 and v != sep_color:\n                object_colors.add(v)\n\n    if not object_colors:\n        return [row[:] for row in grid]\n\n    # Build block intervals between separator rows/cols\n    row_bounds = [-1] + row_seps + [h]\n    col_bounds = [-1] + col_seps + [w]\n\n    row_blocks = [(row_bounds[k] + 1, row_bounds[k + 1]) for k in range(len(row_bounds) - 1) if row_bounds[k] + 1 < row_bounds[k + 1]]\n    col_blocks = [(col_bounds[k] + 1, col_bounds[k + 1]) for k in range(len(col_bounds) - 1) if col_bounds[k] + 1 < col_bounds[k + 1]]\n\n    bh = row_blocks[0][1] - row_blocks[0][0]\n    bw = col_blocks[0][1] - col_blocks[0][0]\n\n    # Union mask of all object-colored cells in local block coordinates\n    mask = [[False] * bw for _ in range(bh)]\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            if (r1 - r0) != bh or (c1 - c0) != bw:\n                continue\n            for di in range(bh):\n                for dj in range(bw):\n                    if grid[r0 + di][c0 + dj] in object_colors:\n                        mask[di][dj] = True\n\n    # Apply mask to every block: fill missing masked cells with separator color\n    out = [row[:] for row in grid]\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            if (r1 - r0) != bh or (c1 - c0) != bw:\n                continue\n            for di in range(bh):\n                for dj in range(bw):\n                    if mask[di][dj] and out[r0 + di][c0 + dj] == 0:\n                        out[r0 + di][c0 + dj] = sep_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color and separator rows/cols:\n    # rows/cols that are completely filled with one same nonzero color.\n    row_seps = []\n    col_seps = []\n    sep_color = None\n\n    for i in range(h):\n        v = grid[i][0]\n        if v != 0 and all(cell == v for cell in grid[i]):\n            row_seps.append(i)\n            if sep_color is None:\n                sep_color = v\n\n    for j in range(w):\n        v = grid[0][j]\n        if v != 0 and all(grid[i][j] == v for i in range(h)):\n            col_seps.append(j)\n            if sep_color is None:\n                sep_color = v\n\n    # Fallback: if not found, return unchanged\n    if sep_color is None or not row_seps or not col_seps:\n        return [row[:] for row in grid]\n\n    # Determine object colors (nonzero and not separator)\n    object_colors = set()\n    for i in range(h):\n        for j in range(w):\n            v = grid[i][j]\n            if v != 0 and v != sep_color:\n                object_colors.add(v)\n\n    if not object_colors:\n        return [row[:] for row in grid]\n\n    # Build block intervals between separator rows/cols\n    row_bounds = [-1] + row_seps + [h]\n    col_bounds = [-1] + col_seps + [w]\n\n    row_blocks = [(row_bounds[k] + 1, row_bounds[k + 1]) for k in range(len(row_bounds) - 1) if row_bounds[k] + 1 < row_bounds[k + 1]]\n    col_blocks = [(col_bounds[k] + 1, col_bounds[k + 1]) for k in range(len(col_bounds) - 1) if col_bounds[k] + 1 < col_bounds[k + 1]]\n\n    bh = row_blocks[0][1] - row_blocks[0][0]\n    bw = col_blocks[0][1] - col_blocks[0][0]\n\n    # Union mask of all object-colored cells in local block coordinates\n    mask = [[False] * bw for _ in range(bh)]\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            if (r1 - r0) != bh or (c1 - c0) != bw:\n                continue\n            for di in range(bh):\n                for dj in range(bw):\n                    if grid[r0 + di][c0 + dj] in object_colors:\n                        mask[di][dj] = True\n\n    # Apply mask to every block: fill missing masked cells with separator color\n    out = [row[:] for row in grid]\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            if (r1 - r0) != bh or (c1 - c0) != bw:\n                continue\n            for di in range(bh):\n                for dj in range(bw):\n                    if mask[di][dj] and out[r0 + di][c0 + dj] == 0:\n                        out[r0 + di][c0 + dj] = sep_color\n\n    return out",
