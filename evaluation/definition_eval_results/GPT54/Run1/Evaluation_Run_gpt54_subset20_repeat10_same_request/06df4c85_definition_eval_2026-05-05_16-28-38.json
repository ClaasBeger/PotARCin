  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: a color that forms complete rows and complete columns.\n    row_full = {}\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            v = grid[r][0]\n            row_full.setdefault(v, []).append(r)\n\n    col_full = {}\n    for c in range(w):\n        v = grid[0][c]\n        ok = True\n        for r in range(h):\n            if grid[r][c] != v:\n                ok = False\n                break\n        if ok:\n            col_full.setdefault(v, []).append(c)\n\n    sep_color = None\n    best_score = -1\n    for v in set(row_full) | set(col_full):\n        score = len(row_full.get(v, [])) + len(col_full.get(v, []))\n        if score > best_score:\n            best_score = score\n            sep_color = v\n\n    row_seps = set(row_full.get(sep_color, []))\n    col_seps = set(col_full.get(sep_color, []))\n\n    # Group non-separator rows/cols into content bands (cells are blocks between separator lines).\n    row_blocks = []\n    r = 0\n    while r < h:\n        if r in row_seps:\n            r += 1\n            continue\n        r0 = r\n        while r < h and r not in row_seps:\n            r += 1\n        row_blocks.append((r0, r))\n\n    col_blocks = []\n    c = 0\n    while c < w:\n        if c in col_seps:\n            c += 1\n            continue\n        c0 = c\n        while c < w and c not in col_seps:\n            c += 1\n        col_blocks.append((c0, c))\n\n    nr = len(row_blocks)\n    nc = len(col_blocks)\n\n    # Compress to cell grid.\n    cells = [[0 for _ in range(nc)] for _ in range(nr)]\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            val = 0\n            for rr in range(r0, r1):\n                for cc in range(c0, c1):\n                    if grid[rr][cc] != sep_color:\n                        val = grid[rr][cc]\n                        break\n                if val != 0:\n                    break\n            cells[i][j] = val\n\n    original = [row[:] for row in cells]\n    result = [row[:] for row in cells]\n\n    # For each color, connect pairs aligned horizontally or vertically using original endpoints only.\n    colors = set()\n    for i in range(nr):\n        for j in range(nc):\n            v = original[i][j]\n            if v != 0:\n                colors.add(v)\n\n    for color in colors:\n        pts = [(i, j) for i in range(nr) for j in range(nc) if original[i][j] == color]\n\n        # Horizontal connections\n        by_row = {}\n        for i, j in pts:\n            by_row.setdefault(i, []).append(j)\n        for i, js in by_row.items():\n            js.sort()\n            m = len(js)\n            for a in range(m):\n                for b in range(a + 1, m):\n                    j1, j2 = js[a], js[b]\n                    for j in range(j1, j2 + 1):\n                        if result[i][j] == 0 or result[i][j] == color:\n                            result[i][j] = color\n\n        # Vertical connections\n        by_col = {}\n        for i, j in pts:\n            by_col.setdefault(j, []).append(i)\n        for j, is_ in by_col.items():\n            is_.sort()\n            m = len(is_)\n            for a in range(m):\n                for b in range(a + 1, m):\n                    i1, i2 = is_[a], is_[b]\n                    for i in range(i1, i2 + 1):\n                        if result[i][j] == 0 or result[i][j] == color:\n                            result[i][j] = color\n\n    # Rebuild full grid.\n    out = [row[:] for row in grid]\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            v = result[i][j]\n            for rr in range(r0, r1):\n                for cc in range(c0, c1):\n                    out[rr][cc] = v\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: a color that forms complete rows and complete columns.\n    row_full = {}\n    for r in range(h):\n        if all(grid[r][c] == grid[r][0] for c in range(w)):\n            v = grid[r][0]\n            row_full.setdefault(v, []).append(r)\n\n    col_full = {}\n    for c in range(w):\n        v = grid[0][c]\n        ok = True\n        for r in range(h):\n            if grid[r][c] != v:\n                ok = False\n                break\n        if ok:\n            col_full.setdefault(v, []).append(c)\n\n    sep_color = None\n    best_score = -1\n    for v in set(row_full) | set(col_full):\n        score = len(row_full.get(v, [])) + len(col_full.get(v, []))\n        if score > best_score:\n            best_score = score\n            sep_color = v\n\n    row_seps = set(row_full.get(sep_color, []))\n    col_seps = set(col_full.get(sep_color, []))\n\n    # Group non-separator rows/cols into content bands (cells are blocks between separator lines).\n    row_blocks = []\n    r = 0\n    while r < h:\n        if r in row_seps:\n            r += 1\n            continue\n        r0 = r\n        while r < h and r not in row_seps:\n            r += 1\n        row_blocks.append((r0, r))\n\n    col_blocks = []\n    c = 0\n    while c < w:\n        if c in col_seps:\n            c += 1\n            continue\n        c0 = c\n        while c < w and c not in col_seps:\n            c += 1\n        col_blocks.append((c0, c))\n\n    nr = len(row_blocks)\n    nc = len(col_blocks)\n\n    # Compress to cell grid.\n    cells = [[0 for _ in range(nc)] for _ in range(nr)]\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            val = 0\n            for rr in range(r0, r1):\n                for cc in range(c0, c1):\n                    if grid[rr][cc] != sep_color:\n                        val = grid[rr][cc]\n                        break\n                if val != 0:\n                    break\n            cells[i][j] = val\n\n    original = [row[:] for row in cells]\n    result = [row[:] for row in cells]\n\n    # For each color, connect pairs aligned horizontally or vertically using original endpoints only.\n    colors = set()\n    for i in range(nr):\n        for j in range(nc):\n            v = original[i][j]\n            if v != 0:\n                colors.add(v)\n\n    for color in colors:\n        pts = [(i, j) for i in range(nr) for j in range(nc) if original[i][j] == color]\n\n        # Horizontal connections\n        by_row = {}\n        for i, j in pts:\n            by_row.setdefault(i, []).append(j)\n        for i, js in by_row.items():\n            js.sort()\n            m = len(js)\n            for a in range(m):\n                for b in range(a + 1, m):\n                    j1, j2 = js[a], js[b]\n                    for j in range(j1, j2 + 1):\n                        if result[i][j] == 0 or result[i][j] == color:\n                            result[i][j] = color\n\n        # Vertical connections\n        by_col = {}\n        for i, j in pts:\n            by_col.setdefault(j, []).append(i)\n        for j, is_ in by_col.items():\n            is_.sort()\n            m = len(is_)\n            for a in range(m):\n                for b in range(a + 1, m):\n                    i1, i2 = is_[a], is_[b]\n                    for i in range(i1, i2 + 1):\n                        if result[i][j] == 0 or result[i][j] == color:\n                            result[i][j] = color\n\n    # Rebuild full grid.\n    out = [row[:] for row in grid]\n    for i, (r0, r1) in enumerate(row_blocks):\n        for j, (c0, c1) in enumerate(col_blocks):\n            v = result[i][j]\n            for rr in range(r0, r1):\n                for cc in range(c0, c1):\n                    out[rr][cc] = v\n    return out",
