  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find complete non-zero horizontal and vertical lines.\n    lines_by_color = {}\n\n    for r in range(h):\n        val = grid[r][0]\n        if val != 0 and all(grid[r][c] == val for c in range(w)):\n            lines_by_color.setdefault(val, []).append((\"row\", r))\n\n    for c in range(w):\n        val = grid[0][c]\n        if val != 0 and all(grid[r][c] == val for r in range(h)):\n            lines_by_color.setdefault(val, []).append((\"col\", c))\n\n    # Start output with just the complete lines preserved.\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    for color, lines in lines_by_color.items():\n        for kind, idx in lines:\n            if kind == \"row\":\n                for c in range(w):\n                    out[idx][c] = color\n            else:\n                for r in range(h):\n                    out[r][idx] = color\n\n    # Move other occurrences of line-colors to the cell adjacent to their line,\n    # preserving their row/column and which side of the line they are on.\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or color not in lines_by_color:\n                continue\n\n            # Skip cells that are already on one of that color's full lines.\n            on_line = False\n            for kind, idx in lines_by_color[color]:\n                if (kind == \"row\" and r == idx) or (kind == \"col\" and c == idx):\n                    on_line = True\n                    break\n            if on_line:\n                continue\n\n            # Choose the nearest full line of the same color.\n            best = None\n            best_dist = None\n            for kind, idx in lines_by_color[color]:\n                dist = abs(r - idx) if kind == \"row\" else abs(c - idx)\n                if best_dist is None or dist < best_dist:\n                    best_dist = dist\n                    best = (kind, idx)\n\n            kind, idx = best\n            if kind == \"row\":\n                nr = idx - 1 if r < idx else idx + 1\n                if 0 <= nr < h:\n                    out[nr][c] = color\n            else:\n                nc = idx - 1 if c < idx else idx + 1\n                if 0 <= nc < w:\n                    out[r][nc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find complete non-zero horizontal and vertical lines.\n    lines_by_color = {}\n\n    for r in range(h):\n        val = grid[r][0]\n        if val != 0 and all(grid[r][c] == val for c in range(w)):\n            lines_by_color.setdefault(val, []).append((\"row\", r))\n\n    for c in range(w):\n        val = grid[0][c]\n        if val != 0 and all(grid[r][c] == val for r in range(h)):\n            lines_by_color.setdefault(val, []).append((\"col\", c))\n\n    # Start output with just the complete lines preserved.\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    for color, lines in lines_by_color.items():\n        for kind, idx in lines:\n            if kind == \"row\":\n                for c in range(w):\n                    out[idx][c] = color\n            else:\n                for r in range(h):\n                    out[r][idx] = color\n\n    # Move other occurrences of line-colors to the cell adjacent to their line,\n    # preserving their row/column and which side of the line they are on.\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or color not in lines_by_color:\n                continue\n\n            # Skip cells that are already on one of that color's full lines.\n            on_line = False\n            for kind, idx in lines_by_color[color]:\n                if (kind == \"row\" and r == idx) or (kind == \"col\" and c == idx):\n                    on_line = True\n                    break\n            if on_line:\n                continue\n\n            # Choose the nearest full line of the same color.\n            best = None\n            best_dist = None\n            for kind, idx in lines_by_color[color]:\n                dist = abs(r - idx) if kind == \"row\" else abs(c - idx)\n                if best_dist is None or dist < best_dist:\n                    best_dist = dist\n                    best = (kind, idx)\n\n            kind, idx = best\n            if kind == \"row\":\n                nr = idx - 1 if r < idx else idx + 1\n                if 0 <= nr < h:\n                    out[nr][c] = color\n            else:\n                nc = idx - 1 if c < idx else idx + 1\n                if 0 <= nc < w:\n                    out[r][nc] = color\n\n    return out",
