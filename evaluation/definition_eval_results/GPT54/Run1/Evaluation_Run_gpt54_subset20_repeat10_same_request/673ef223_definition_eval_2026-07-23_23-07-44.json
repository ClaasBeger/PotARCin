  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    bars = []\n    for c in (0, w - 1):\n        rows = [r for r in range(h) if grid[r][c] == 2]\n        if rows:\n            top = min(rows)\n            bottom = max(rows)\n            bars.append((c, top, bottom))\n\n    if len(bars) != 2:\n        return out\n\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n\n    def count_in_bar(bar):\n        _, top, bottom = bar\n        return sum(1 for r, _ in eights if top <= r <= bottom)\n\n    bar_a, bar_b = bars\n    source = bar_a if count_in_bar(bar_a) >= count_in_bar(bar_b) else bar_b\n    target = bar_b if source == bar_a else bar_a\n\n    src_c, src_top, src_bottom = source\n    tgt_c, tgt_top, tgt_bottom = target\n\n    src_eights = [(r, c) for r, c in eights if src_top <= r <= src_bottom]\n\n    for r, c in src_eights:\n        if src_c == 0:\n            for x in range(1, c):\n                out[r][x] = 8\n            out[r][c] = 4\n        else:\n            for x in range(c + 1, w - 1):\n                out[r][x] = 8\n            out[r][c] = 4\n\n        rr = tgt_top + (r - src_top)\n        if 0 <= rr < h:\n            if tgt_c == 0:\n                for x in range(1, w):\n                    if out[rr][x] != 2:\n                        out[rr][x] = 8\n            else:\n                for x in range(0, w - 1):\n                    if out[rr][x] != 2:\n                        out[rr][x] = 8\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    bars = []\n    for c in (0, w - 1):\n        rows = [r for r in range(h) if grid[r][c] == 2]\n        if rows:\n            top = min(rows)\n            bottom = max(rows)\n            bars.append((c, top, bottom))\n\n    if len(bars) != 2:\n        return out\n\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n\n    def count_in_bar(bar):\n        _, top, bottom = bar\n        return sum(1 for r, _ in eights if top <= r <= bottom)\n\n    bar_a, bar_b = bars\n    source = bar_a if count_in_bar(bar_a) >= count_in_bar(bar_b) else bar_b\n    target = bar_b if source == bar_a else bar_a\n\n    src_c, src_top, src_bottom = source\n    tgt_c, tgt_top, tgt_bottom = target\n\n    src_eights = [(r, c) for r, c in eights if src_top <= r <= src_bottom]\n\n    for r, c in src_eights:\n        if src_c == 0:\n            for x in range(1, c):\n                out[r][x] = 8\n            out[r][c] = 4\n        else:\n            for x in range(c + 1, w - 1):\n                out[r][x] = 8\n            out[r][c] = 4\n\n        rr = tgt_top + (r - src_top)\n        if 0 <= rr < h:\n            if tgt_c == 0:\n                for x in range(1, w):\n                    if out[rr][x] != 2:\n                        out[rr][x] = 8\n            else:\n                for x in range(0, w - 1):\n                    if out[rr][x] != 2:\n                        out[rr][x] = 8\n\n    return out",
