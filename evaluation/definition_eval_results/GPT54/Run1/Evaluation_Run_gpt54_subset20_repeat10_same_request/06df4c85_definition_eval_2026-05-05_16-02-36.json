  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find the separator/border color: the non-zero color that forms full rows/columns.\n    border = None\n    for row in grid:\n        vals = set(row)\n        if len(vals) == 1:\n            v = row[0]\n            if v != 0:\n                border = v\n                break\n    if border is None:\n        return [r[:] for r in grid]\n\n    # Cell layout is 2x2 blocks separated by 1-cell-thick border lines.\n    cell_rows = (h + 1) // 3\n    cell_cols = (w + 1) // 3\n\n    # Read the logical cell grid.\n    cells = [[0 for _ in range(cell_cols)] for _ in range(cell_rows)]\n    for cr in range(cell_rows):\n        for cc in range(cell_cols):\n            r0, c0 = cr * 3, cc * 3\n            vals = {\n                grid[r0][c0], grid[r0][c0 + 1],\n                grid[r0 + 1][c0], grid[r0 + 1][c0 + 1]\n            }\n            vals.discard(0)\n            vals.discard(border)\n            if len(vals) == 1:\n                cells[cr][cc] = next(iter(vals))\n\n    # Collect seed positions by color.\n    by_color = {}\n    for r in range(cell_rows):\n        for c in range(cell_cols):\n            color = cells[r][c]\n            if color != 0:\n                by_color.setdefault(color, []).append((r, c))\n\n    # Fill between same-colored cells in the same row or column.\n    out_cells = [row[:] for row in cells]\n\n    for color, pts in by_color.items():\n        rows = {}\n        cols = {}\n\n        for r, c in pts:\n            rows.setdefault(r, []).append(c)\n            cols.setdefault(c, []).append(r)\n\n        for r, cs in rows.items():\n            if len(cs) >= 2:\n                a, b = min(cs), max(cs)\n                for c in range(a, b + 1):\n                    out_cells[r][c] = color\n\n        for c, rs in cols.items():\n            if len(rs) >= 2:\n                a, b = min(rs), max(rs)\n                for r in range(a, b + 1):\n                    out_cells[r]