  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find connected components of color 2\n    seen = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2 and not seen[r][c]:\n                stack = [(r, c)]\n                seen[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == 2:\n                            seen[nx][ny] = True\n                            stack.append((nx, ny))\n                comps.append(cells)\n\n    bars = []\n    for cells in comps:\n        rows = [r for r, c in cells]\n        cols = [c for r, c in cells]\n        if len(set(cols)) == 1:\n            bars.append({\n                \"col\": cols[0],\n                \"top\": min(rows),\n                \"bottom\": max(rows),\n                \"len\": max(rows) - min(rows) + 1\n            })\n\n    if len(bars) != 2:\n        return out\n\n    # Helper to draw from a source bar to an 8, then mirror onto the other bar\n    def process_seed(src_bar, dst_bar, r, c):\n        # Draw on source row: fill between bar and seed with 8, seed becomes 4\n        if src_bar[\"col\"] < c:\n            for j in range(src_bar[\"col\"] + 1, c):\n                out[r][j] = 8\n            out[r][c] = 4\n        elif src_bar[\"col\"] > c:\n            for j in range(c + 1, src_bar[\"col\"]):\n                out[r][j] = 8\n            out[r][c] = 4\n        else:\n            out[r][c] = 4\n\n        # Mirror to destination bar at same offset within the bar\n        rr = dst_bar[\"top\"] + (r - src_bar[\"top\"])\n        if 0 <= rr < h:\n            if dst_bar[\"col\"] == 0:\n                for j in range(1, w):\n                    if j != dst_bar[\"col\"]:\n                        out[rr][j] = 8\n                out[rr][dst_bar[\"col\"]] = 2\n            elif dst_bar[\"col\"] == w - 1:\n                for j in range(0, w - 1):\n                    out[rr][j] = 8\n                out[rr][dst_bar[\"col\"]] = 2\n            else:\n                if dst_bar[\"col\"] < w // 2:\n                    for j in range(dst_bar[\"col\"] + 1, w):\n                        out[rr][j] = 8\n                    out[rr][dst_bar[\"col\"]] = 2\n                else:\n                    for j in range(0, dst_bar[\"col\"]):\n                        out[rr][j] = 8\n                    out[rr][dst_bar[\"col\"]] = 2\n\n    # Collect all seed 8s and assign them to the bar whose vertical span contains their row\n    seeds = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n\n    for r, c in seeds:\n        owners = [i for i, bar in enumerate(bars) if bar[\"top\"] <= r <= bar[\"bottom\"]]\n        if len(owners) == 1:\n            src_i = owners[0]\n            dst_i = 1 - src_i\n            process_seed(bars[src_i], bars[dst_i], r, c)\n\n    return out",
