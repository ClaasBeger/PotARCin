           for y in range(c + 1, source[\"col\"]):\n                out[r][y] = 8\n        out[r][c] = 4\n\n        # Target side: same relative row, fill away from the bar across the row\n        r2 = target[\"top\"] + (r - source[\"top\"])\n        if 0 <= r2 < h:\n            if target[\"col\"] == 0:\n                for y in range(1, w):\n                    if out[r2][y] != 2:\n                        out[r2][y] = 8\n            elif target[\"col\"] == w - 1:\n                for y in range(0, w - 1):\n                    if out[r2][y] != 2:\n                        out[r2][y] = 8\n            else:\n                # Fallback: fill away from the nearer edge\n                if target[\"col\"] < w // 2:\n                    for y in range(target[\"col\"] + 1, w):\n                        if out[r2][y] != 2:\n                            out[r2][y] = 8\n                else:\n                    for y in range(0, target[\"col\"]):\n                        if out[r2][y] != 2:\n                            out[r2][y] = 8\n\n    return out",
