  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    # Find connected components of color 2\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 2:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n                comps.append(cells)\n\n    # Expect two vertical bars of 2s\n    bars = []\n    for cells in comps:\n        rows = [r for r, c in cells]\n        cols = [c for r, c in cells]\n        bars.append({\n            \"cells\": cells,\n            \"top\": min(rows),\n            \"bottom\": max(rows),\n            \"col\": cols[0]\n        })\n\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n\n    # Choose the bar whose vertical span contains the 8s as the source\n    def score(bar):\n        return sum(1 for r, c in eights if bar[\"top\"] <= r <= bar[\"bottom\"])\n\n    bars.sort(key=score, reverse=True)\n    source = bars[0]\n    target = bars[1]\n\n    # Draw from source bar to each 8, and mirror the row-offset pattern onto target bar\n    for r, c in eights:\n        if not (source[\"top\"] <= r <= source[\"bottom\"]):\n            continue\n\n        # Source side: connect bar to 8, and convert the 8 to 4\n        if source[\"col\"] < c:\n            for y in range(source[\"col\"] + 1, c):\n                out[r][y] = 8\n        elif source[\"col\"] > c:\n            for y in range(c + 1, source[\"col\"]):\n                out[r][y] = 8\n        out[r][c] = 4\n\n        # Target side: same relative row, fill away from the bar across the row\n        r2 = target[\"top\"] + (r - source[\"top\"])\n        if 0 <= r2 < h:\n            if target[\"col\"] == 0:\n                for y in range(1, w):\n                    if out[r2][y] != 2:\n                        out[r2][y] = 8\n            elif target[\"col\"] == w - 1:\n                for y in range(0, w - 1):\n                    if out[r2][y] != 2:\n                        out[r2][y] = 8\n            else:\n                # Fallback: fill away from the nearer edge\n                if target[\"col\"] < w // 2:\n                    for y in range(target[\"col\"] + 1, w):\n                        if out[r2][y] != 2:\n                            out[r2][y] = 8\n                else:\n                    for y in range(0, target[\"col\"]):\n                        if out[r2][y] != 2:\n                            out[r2][y] = 8\n\n    return out",
