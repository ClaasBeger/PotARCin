  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find connected components of color 2\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 2:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n                rows = [x for x, _ in cells]\n                cols = [y for _, y in cells]\n                comps.append({\n                    \"cells\": cells,\n                    \"rmin\": min(rows),\n                    \"rmax\": max(rows),\n                    \"c\": cols[0]\n                })\n\n    seeds = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n\n    if len(comps) != 2 or not seeds:\n        return out\n\n    # Source component is the one whose vertical span contains the seed rows\n    def score(comp):\n        return sum(1 for r, _ in seeds if comp[\"rmin\"] <= r <= comp[\"rmax\"])\n\n    comps.sort(key=score, reverse=True)\n    source = comps[0]\n    target = comps[1]\n\n    # Draw from each seed to the source bar\n    rel_rows = []\n    for r, c in seeds:\n        if not (source[\"rmin\"] <= r <= source[\"rmax\"]):\n            continue\n        rel_rows.append(r - source[\"rmin\"])\n\n        if source[\"c\"] == 0:\n            for y in range(1, c):\n                out[r][y] = 8\n            out[r][c] = 4\n        elif source[\"c\"] == w - 1:\n            out[r][c] = 4\n            for y in range(c + 1, w - 1):\n                out[r][y] = 8\n\n    # Mirror the marked rows onto the target bar span\n    for dr in rel_rows:\n        rr = target[\"rmin\"] + dr\n        if 0 <= rr < h and target[\"rmin\"] <= rr <= target[\"rmax\"]:\n            if target[\"c\"] == 0:\n                for y in range(1, w):\n                    out[rr][y] = 8\n                out[rr][0] = 2\n            elif target[\"c\"] == w - 1:\n                for y in range(0, w - 1):\n                    out[rr][y] = 8\n                out[rr][w - 1] = 2\n\n    return out",
