  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def is_full_same_row(r):\n        val = grid[r][0]\n        return val != 0 and all(grid[r][c] == val for c in range(w))\n\n    def is_full_same_col(c):\n        val = grid[0][c]\n        return val != 0 and all(grid[r][c] == val for r in range(h))\n\n    sep_rows = [r for r in range(h) if is_full_same_row(r)]\n    sep_cols = [c for c in range(w) if is_full_same_col(c)]\n\n    if sep_rows:\n        sep_color = grid[sep_rows[0]][0]\n    elif sep_cols:\n        sep_color = grid[0][sep_cols[0]]\n    else:\n        return [row[:] for row in grid]\n\n    row_blocks = []\n    start = 0\n    for r in sep_rows + [h]:\n        if start < r:\n            row_blocks.append((start, r))\n        start = r + 1\n\n    col_blocks = []\n    start = 0\n    for c in sep_cols + [w]:\n        if start < c:\n            col_blocks.append((start, c))\n        start = c + 1\n\n    union_shape = set()\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        union_shape.add((r - r0, c - c0))\n\n    out = [row[:] for row in grid]\n\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            bh = r1 - r0\n            bw = c1 - c0\n            for dr, dc in union_shape:\n                if 0 <= dr < bh and 0 <= dc < bw:\n                    rr = r0 + dr\n                    cc = c0 + dc\n                    if out[rr][cc] == 0:\n                        out[rr][cc] = sep_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def is_full_same_row(r):\n        val = grid[r][0]\n        return val != 0 and all(grid[r][c] == val for c in range(w))\n\n    def is_full_same_col(c):\n        val = grid[0][c]\n        return val != 0 and all(grid[r][c] == val for r in range(h))\n\n    sep_rows = [r for r in range(h) if is_full_same_row(r)]\n    sep_cols = [c for c in range(w) if is_full_same_col(c)]\n\n    if sep_rows:\n        sep_color = grid[sep_rows[0]][0]\n    elif sep_cols:\n        sep_color = grid[0][sep_cols[0]]\n    else:\n        return [row[:] for row in grid]\n\n    row_blocks = []\n    start = 0\n    for r in sep_rows + [h]:\n        if start < r:\n            row_blocks.append((start, r))\n        start = r + 1\n\n    col_blocks = []\n    start = 0\n    for c in sep_cols + [w]:\n        if start < c:\n            col_blocks.append((start, c))\n        start = c + 1\n\n    union_shape = set()\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        union_shape.add((r - r0, c - c0))\n\n    out = [row[:] for row in grid]\n\n    for r0, r1 in row_blocks:\n        for c0, c1 in col_blocks:\n            bh = r1 - r0\n            bw = c1 - c0\n            for dr, dc in union_shape:\n                if 0 <= dr < bh and 0 <= dc < bw:\n                    rr = r0 + dr\n                    cc = c0 + dc\n                    if out[rr][cc] == 0:\n                        out[rr][cc] = sep_color\n\n    return out",
