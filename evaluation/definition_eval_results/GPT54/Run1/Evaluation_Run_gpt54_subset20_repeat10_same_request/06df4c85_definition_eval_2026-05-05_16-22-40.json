  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def is_uniform_row(r):\n        v = grid[r][0]\n        return all(grid[r][c] == v for c in range(w))\n\n    def is_uniform_col(c):\n        v = grid[0][c]\n        return all(grid[r][c] == v for r in range(h))\n\n    sep_rows = [r for r in range(h) if is_uniform_row(r)]\n    sep_cols = [c for c in range(w) if is_uniform_col(c)]\n\n    # Assume the separator color is the uniform value used by the grid lines.\n    sep_color = grid[sep_rows[0]][0] if sep_rows else grid[0][sep_cols[0]]\n\n    def make_bands(indices, size):\n        bands = []\n        start = 0\n        for x in indices:\n            if start <= x - 1:\n                bands.append((start, x - 1))\n            start = x + 1\n        if start <= size - 1:\n            bands.append((start, size - 1))\n        return bands\n\n    row_bands = make_bands(sep_rows, h)\n    col_bands = make_bands(sep_cols, w)\n\n    nr = len(row_bands)\n    nc = len(col_bands)\n\n    cell_colors = [[0 for _ in range(nc)] for _ in range(nr)]\n\n    for i, (r0, r1) in enumerate(row_bands):\n        for j, (c0, c1) in enumerate(col_bands):\n            found = 0\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        found = v\n                        break\n                if found:\n                    break\n            cell_colors[i][j] = found\n\n    # Fill between same-colored cells that share a row or a column.\n    colors = {}\n    for i in range(nr):\n        for j in range(nc):\n            v = cell_colors[i][j]\n            if v != 0:\n                colors.setdefault(v, []).append((i, j))\n\n    filled = [row[:] for row in cell_colors]\n\n    for color, pts in colors.items():\n        by_row = {}\n        by_col = {}\n        for i, j in pts:\n            by_row.setdefault(i, []).append(j)\n            by_col.setdefault(j, []).append(i)\n\n        for i, js in by_row.items():\n            if len(js) >= 2:\n                a, b = min(js), max(js)\n                for j in range(a, b + 1):\n                    filled[i][j] = color\n\n        for j, is_ in by_col.items():\n            if len(is_) >= 2:\n                a, b = min(is_), max(is_)\n                for i in range(a, b + 1):\n                    filled[i][j] = color\n\n    out = [row[:] for row in grid]\n\n    for i, (r0, r1) in enumerate(row_bands):\n        for j, (c0, c1) in enumerate(col_bands):\n            color = filled[i][j]\n            if color != 0:\n                for r in range(r0, r1 + 1):\n                    for c in range(c0, c1 + 1):\n                        out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    def is_uniform_row(r):\n        v = grid[r][0]\n        return all(grid[r][c] == v for c in range(w))\n\n    def is_uniform_col(c):\n        v = grid[0][c]\n        return all(grid[r][c] == v for r in range(h))\n\n    sep_rows = [r for r in range(h) if is_uniform_row(r)]\n    sep_cols = [c for c in range(w) if is_uniform_col(c)]\n\n    # Assume the separator color is the uniform value used by the grid lines.\n    sep_color = grid[sep_rows[0]][0] if sep_rows else grid[0][sep_cols[0]]\n\n    def make_bands(indices, size):\n        bands = []\n        start = 0\n        for x in indices:\n            if start <= x - 1:\n                bands.append((start, x - 1))\n            start = x + 1\n        if start <= size - 1:\n            bands.append((start, size - 1))\n        return bands\n\n    row_bands = make_bands(sep_rows, h)\n    col_bands = make_bands(sep_cols, w)\n\n    nr = len(row_bands)\n    nc = len(col_bands)\n\n    cell_colors = [[0 for _ in range(nc)] for _ in range(nr)]\n\n    for i, (r0, r1) in enumerate(row_bands):\n        for j, (c0, c1) in enumerate(col_bands):\n            found = 0\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    v = grid[r][c]\n                    if v != 0 and v != sep_color:\n                        found = v\n                        break\n                if found:\n                    break\n            cell_colors[i][j] = found\n\n    # Fill between same-colored cells that share a row or a column.\n    colors = {}\n    for i in range(nr):\n        for j in range(nc):\n            v = cell_colors[i][j]\n            if v != 0:\n                colors.setdefault(v, []).append((i, j))\n\n    filled = [row[:] for row in cell_colors]\n\n    for color, pts in colors.items():\n        by_row = {}\n        by_col = {}\n        for i, j in pts:\n            by_row.setdefault(i, []).append(j)\n            by_col.setdefault(j, []).append(i)\n\n        for i, js in by_row.items():\n            if len(js) >= 2:\n                a, b = min(js), max(js)\n                for j in range(a, b + 1):\n                    filled[i][j] = color\n\n        for j, is_ in by_col.items():\n            if len(is_) >= 2:\n                a, b = min(is_), max(is_)\n                for i in range(a, b + 1):\n                    filled[i][j] = color\n\n    out = [row[:] for row in grid]\n\n    for i, (r0, r1) in enumerate(row_bands):\n        for j, (c0, c1) in enumerate(col_bands):\n            color = filled[i][j]\n            if color != 0:\n                for r in range(r0, r1 + 1):\n                    for c in range(c0, c1 + 1):\n                        out[r][c] = color\n\n    return out",
