  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Count non-zero colors\n    counts = {}\n    for row in grid:\n        for v in row:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n\n    if not counts:\n        return grid\n\n    # In these tasks, 5 is the clue color.\n    clue_color = 5\n\n    # Find the main repeated color (largest non-zero count excluding 5 if possible)\n    main_color = None\n    main_count = -1\n    for c, cnt in counts.items():\n        if c == clue_color:\n            continue\n        if cnt > main_count:\n            main_count = cnt\n            main_color = c\n\n    if main_color is None:\n        return [row[:] for row in grid]\n\n    # Find clue cells and the marker color/cell\n    clue_cells = []\n    marker_pos = None\n    marker_color = None\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == clue_color:\n                clue_cells.append((r, c))\n            elif v != 0 and v != main_color:\n                marker_pos = (r, c)\n                marker_color = v\n\n    out = [row[:] for row in grid]\n\n    # Remove clue area\n    for r, c in clue_cells:\n        out[r][c] = 0\n    if marker_pos is not None:\n        out[marker_pos[0]][marker_pos[1]] = 0\n\n    if marker_pos is None or marker_color is None:\n        return out\n\n    # Search rays from the marker in diagonal directions.\n    # Ignore clue-color cells while traversing; place the marker on the last zero\n    # before the first main-color cell encountered.\n    dirs = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\n    best = None  # (distance_to_main, place_r, place_c)\n\n    mr, mc = marker_pos\n    for dr, dc in dirs:\n        r, c = mr + dr, mc + dc\n        last_zero = None\n        dist = 1\n\n        while 0 <= r < h and 0 <= c < w:\n            v = grid[r][c]\n            if v == clue_color or (r, c) == marker_pos:\n                pass\n            elif v == 0:\n                last_zero = (r, c)\n            elif v == main_color:\n                if last_zero is not None:\n                    cand = (dist, last_zero[0], last_zero[1])\n                    if best is None or cand < best:\n                        best = cand\n                break\n            else:\n                break\n            r += dr\n            c += dc\n            dist += 1\n\n    if best is not None:\n        _, pr, pc = best\n        out[pr][pc] = marker_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Count non-zero colors\n    counts = {}\n    for row in grid:\n        for v in row:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n\n    if not counts:\n        return grid\n\n    # In these tasks, 5 is the clue color.\n    clue_color = 5\n\n    # Find the main repeated color (largest non-zero count excluding 5 if possible)\n    main_color = None\n    main_count = -1\n    for c, cnt in counts.items():\n        if c == clue_color:\n            continue\n        if cnt > main_count:\n            main_count = cnt\n            main_color = c\n\n    if main_color is None:\n        return [row[:] for row in grid]\n\n    # Find clue cells and the marker color/cell\n    clue_cells = []\n    marker_pos = None\n    marker_color = None\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == clue_color:\n                clue_cells.append((r, c))\n            elif v != 0 and v != main_color:\n                marker_pos = (r, c)\n                marker_color = v\n\n    out = [row[:] for row in grid]\n\n    # Remove clue area\n    for r, c in clue_cells:\n        out[r][c] = 0\n    if marker_pos is not None:\n        out[marker_pos[0]][marker_pos[1]] = 0\n\n    if marker_pos is None or marker_color is None:\n        return out\n\n    # Search rays from the marker in diagonal directions.\n    # Ignore clue-color cells while traversing; place the marker on the last zero\n    # before the first main-color cell encountered.\n    dirs = [(-1, -1), (-1, 1), (1, -1), (1, 1)]\n    best = None  # (distance_to_main, place_r, place_c)\n\n    mr, mc = marker_pos\n    for dr, dc in dirs:\n        r, c = mr + dr, mc + dc\n        last_zero = None\n        dist = 1\n\n        while 0 <= r < h and 0 <= c < w:\n            v = grid[r][c]\n            if v == clue_color or (r, c) == marker_pos:\n                pass\n            elif v == 0:\n                last_zero = (r, c)\n            elif v == main_color:\n                if last_zero is not None:\n                    cand = (dist, last_zero[0], last_zero[1])\n                    if best is None or cand < best:\n                        best = cand\n                break\n            else:\n                break\n            r += dr\n            c += dc\n            dist += 1\n\n    if best is not None:\n        _, pr, pc = best\n        out[pr][pc] = marker_color\n\n    return out",
