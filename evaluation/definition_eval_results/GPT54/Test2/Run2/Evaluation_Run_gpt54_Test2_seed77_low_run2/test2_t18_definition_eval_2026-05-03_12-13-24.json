  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    nonzero = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n    if not nonzero:\n        return [row[:] for row in grid]\n\n    top = min(r for r, _ in nonzero)\n    bottom = max(r for r, _ in nonzero)\n    left = min(c for _, c in nonzero)\n    right = max(c for _, c in nonzero)\n\n    box_h = bottom - top + 1\n    dest_top = top + box_h + 1\n\n    out = [row[:] for row in grid]\n\n    for r in range(top, bottom + 1):\n        for c in range(left, right + 1):\n            val = grid[r][c]\n            if val != 0:\n                local_r = r - top\n                flipped_r = box_h - 1 - local_r\n                rr = dest_top + flipped_r\n                if 0 <= rr < h:\n                    out[rr][c] = val\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    nonzero = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n    if not nonzero:\n        return [row[:] for row in grid]\n\n    top = min(r for r, _ in nonzero)\n    bottom = max(r for r, _ in nonzero)\n    left = min(c for _, c in nonzero)\n    right = max(c for _, c in nonzero)\n\n    box_h = bottom - top + 1\n    dest_top = top + box_h + 1\n\n    out = [row[:] for row in grid]\n\n    for r in range(top, bottom + 1):\n        for c in range(left, right + 1):\n            val = grid[r][c]\n            if val != 0:\n                local_r = r - top\n                flipped_r = box_h - 1 - local_r\n                rr = dest_top + flipped_r\n                if 0 <= rr < h:\n                    out[rr][c] = val\n\n    return out",
