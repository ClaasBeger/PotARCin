  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    tl, tr, bl, br = [], [], [], []\n\n    mid_r = h // 2\n    mid_c = w // 2\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 0:\n                continue\n            if r < mid_r and c < mid_c:\n                tl.append((r, c, v))\n            elif r < mid_r and c >= mid_c:\n                tr.append((r, c, v))\n            elif r >= mid_r and c < mid_c:\n                bl.append((r, c, v))\n            else:\n                br.append((r, c, v))\n\n    top_cells = tl + tr\n    bottom_cells = bl + br\n    left_cells = tl + bl\n    right_cells = tr + br\n\n    max_top_row = max(r for r, c, v in top_cells)\n    min_bottom_row = min(r for r, c, v in bottom_cells)\n    max_left_col = max(c for r, c, v in left_cells)\n    min_right_col = min(c for r, c, v in right_cells)\n\n    shift_y = (min_bottom_row - max_top_row - 1) // 2\n    shift_x = (min_right_col - max_left_col - 1) // 2\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for r, c, v in tl:\n        out[r + shift_y][c + shift_x] = v\n    for r, c, v in tr:\n        out[r + shift_y][c - shift_x] = v\n    for r, c, v in bl:\n        out[r - shift_y][c + shift_x] = v\n    for r, c, v in br:\n        out[r - shift_y][c - shift_x] = v\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    tl, tr, bl, br = [], [], [], []\n\n    mid_r = h // 2\n    mid_c = w // 2\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 0:\n                continue\n            if r < mid_r and c < mid_c:\n                tl.append((r, c, v))\n            elif r < mid_r and c >= mid_c:\n                tr.append((r, c, v))\n            elif r >= mid_r and c < mid_c:\n                bl.append((r, c, v))\n            else:\n                br.append((r, c, v))\n\n    top_cells = tl + tr\n    bottom_cells = bl + br\n    left_cells = tl + bl\n    right_cells = tr + br\n\n    max_top_row = max(r for r, c, v in top_cells)\n    min_bottom_row = min(r for r, c, v in bottom_cells)\n    max_left_col = max(c for r, c, v in left_cells)\n    min_right_col = min(c for r, c, v in right_cells)\n\n    shift_y = (min_bottom_row - max_top_row - 1) // 2\n    shift_x = (min_right_col - max_left_col - 1) // 2\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for r, c, v in tl:\n        out[r + shift_y][c + shift_x] = v\n    for r, c, v in tr:\n        out[r + shift_y][c - shift_x] = v\n    for r, c, v in bl:\n        out[r - shift_y][c + shift_x] = v\n    for r, c, v in br:\n        out[r - shift_y][c - shift_x] = v\n\n    return out",
