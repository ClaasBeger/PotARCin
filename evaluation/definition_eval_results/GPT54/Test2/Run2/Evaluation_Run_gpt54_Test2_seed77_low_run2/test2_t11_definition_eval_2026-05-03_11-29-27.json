centers.add((rr, sc))\n                    d += 4\n        else:\n            for sgn in (-1, 1):\n                d = dist\n                while True:\n                    cc = sc + sgn * d\n                    if not (0 <= cc < w):\n                        break\n                    centers.add((sr, cc))\n                    d += 4\n\n    # Try both offset families; keep only centers not already occupied by seed-color rays\n    cand = set()\n    for base in (2, 4):\n        tmp = set()\n        centers.clear()\n        add_line_centers(base, True)\n        add_line_centers(base, False)\n        tmp |= centers\n        for r, c in tmp:\n            if out[r][c] == 0:\n                cand.add((r, c))\n\n    for r, c in cand:\n        out[r][c] = 1\n        for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:\n            rr, cc = r + dr, c + dc\n            if inside(rr, cc) and out[rr][cc] == 0:\n                out[rr][cc] = 3\n\n    # Preserve original seed if motifs touched it\n    out[sr][sc] = color\n    return out",
