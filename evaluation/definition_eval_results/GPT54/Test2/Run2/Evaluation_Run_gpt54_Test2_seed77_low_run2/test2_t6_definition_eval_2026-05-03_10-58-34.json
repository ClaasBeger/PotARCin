  "raw_response": "def solve(grid):\n    from collections import deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    if h == 0 or w == 0:\n        return out\n\n    # Find connected components of cells that are not walls (5).\n    seen = [[False] * w for _ in range(h)]\n    comps = []\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 5 or seen[r][c]:\n                continue\n            q = deque([(r, c)])\n            seen[r][c] = True\n            cells = []\n            touches_border = False\n            has_marker = False\n            while q:\n                x, y = q.popleft()\n                cells.append((x, y))\n                if x == 0 or x == h - 1 or y == 0 or y == w - 1:\n                    touches_border = True\n                if grid[x][y] not in (0, 5):\n                    has_marker = True\n                for dx, dy in dirs:\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] != 5:\n                        seen[nx][ny] = True\n                        q.append((nx, ny))\n            if not touches_border and has_marker:\n                rs = [r0 for r0, _ in cells]\n                cs = [c0 for _, c0 in cells]\n                comps.append({\n                    \"cells\": cells,\n                    \"r\": sum(rs) / len(rs),\n                    \"c\": sum(cs) / len(cs),\n                })\n\n    n = len(comps)\n    if n == 0:\n        return out\n\n    # Decide layout/orientation from component centroids.\n    rs = [comp[\"r\"] for comp in comps]\n    cs = [comp[\"c\"] for comp in comps]\n    row_span = max(rs) - min(rs) if n > 1 else 0\n    col_span = max(cs) - min(cs) if n > 1 else 0\n\n    if n == 1:\n        order = comps\n        palette = [3]\n    elif row_span > col_span * 1.5:\n        # Horizontal stacking\n        order = sorted(comps, key=lambda comp: comp[\"r\"])\n        palette = [2, 4, 3]\n    elif col_span > row_span * 1.5:\n        # Vertical stacking\n        order = sorted(comps, key=lambda comp: comp[\"c\"])\n        palette = [4, 3, 2]\n    else:\n        # Diagonal stacking (bottom-left, middle, top-right)\n        order = sorted(comps, key=lambda comp: comp[\"r\"] - comp[\"c\"], reverse=True)\n        palette = [3, 4, 2]\n\n    # Trim/extend palette if needed.\n    if n <= len(palette):\n        colors = palette[:n]\n    else:\n        base = [4, 3, 2]\n        colors = [base[i % len(base)] for i in range(n)]\n\n    for comp, color in zip(order, colors):\n        for r, c in comp[\"cells\"]:\n            if out[r][c] != 5:\n                out[r][c] = color\n\n    # Outside markers become background.\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 5:\n                if r == 0 or r == h - 1 or c == 0 or c == w - 1:\n                    # flood of outside non-5 should remain 0; border-touching markers are removed\n                    pass\n\n    # Recompute outside region and zero it out.\n    seen2 = [[False] * w for _ in range(h)]\n    q = deque()\n    for r in range(h):\n        for c in range(w):\n            if (r == 0 or r == h - 1 or c == 0 or c == w - 1) and out[r][c] != 5 and not seen2[r][c]:\n                seen2[r][c] = True\n                q.append((r, c))\n    while q:\n        x, y = q.popleft()\n        out[x][y] = 0\n        for dx, dy in dirs:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < h and 0 <= ny < w and out[nx][ny] != 5 and not seen2[nx][ny]:\n                seen2[nx][ny] = True\n                q.append((nx, ny))\n\n    return out",
