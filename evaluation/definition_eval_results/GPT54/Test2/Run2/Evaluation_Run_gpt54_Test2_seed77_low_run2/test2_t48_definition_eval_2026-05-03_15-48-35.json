  "raw_response": "def solve(grid):\n    from collections import Counter, deque\n\n    h = len(grid)\n    w = len(grid[0])\n\n    out = [row[:] for row in grid]\n\n    # Marker colors are given on the last row as the non-zero prefix.\n    markers = [v for v in grid[-1] if v != 0]\n\n    # Find the frame/border color from all rows except the last marker row.\n    cnt = Counter()\n    for r in range(h - 1):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                cnt[v] += 1\n    if not cnt:\n        return out\n    border = cnt.most_common(1)[0][0]\n\n    # Find enclosed zero-components (not touching the outer boundary)\n    # in the main drawing area (excluding the last row).\n    seen = [[False] * w for _ in range(h - 1)]\n    comps = []\n\n    for r in range(h - 1):\n        for c in range(w):\n            if grid[r][c] == 0 and not seen[r][c]:\n                q = deque([(r, c)])\n                seen[r][c] = True\n                cells = []\n                touches_edge = False\n\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    if x == 0 or y == 0 or x == h - 2 or y == w - 1:\n                        touches_edge = True\n\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h - 1 and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == 0:\n                            seen[nx][ny] = True\n                            q.append((nx, ny))\n\n                if not touches_edge:\n                    comps.append(cells)\n\n    if not comps or len(markers) < 2:\n        return out\n\n    # Sort enclosed blank regions top-to-bottom, then left-to-right.\n    comps.sort(key=lambda cells: (min(r for r, _ in cells), min(c for _, c in cells)))\n\n    # From the examples, the topmost blank gets the 2nd marker color,\n    # the next one gets the 1st marker color.\n    fill_colors = []\n    if len(comps) >= 1:\n        fill_colors.append(markers[1])\n    if len(comps) >= 2:\n        fill_colors.append(markers[0])\n\n    for comp, color in zip(comps, fill_colors):\n        for r, c in comp:\n            out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    from collections import Counter, deque\n\n    h = len(grid)\n    w = len(grid[0])\n\n    out = [row[:] for row in grid]\n\n    # Marker colors are given on the last row as the non-zero prefix.\n    markers = [v for v in grid[-1] if v != 0]\n\n    # Find the frame/border color from all rows except the last marker row.\n    cnt = Counter()\n    for r in range(h - 1):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                cnt[v] += 1\n    if not cnt:\n        return out\n    border = cnt.most_common(1)[0][0]\n\n    # Find enclosed zero-components (not touching the outer boundary)\n    # in the main drawing area (excluding the last row).\n    seen = [[False] * w for _ in range(h - 1)]\n    comps = []\n\n    for r in range(h - 1):\n        for c in range(w):\n            if grid[r][c] == 0 and not seen[r][c]:\n                q = deque([(r, c)])\n                seen[r][c] = True\n                cells = []\n                touches_edge = False\n\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    if x == 0 or y == 0 or x == h - 2 or y == w - 1:\n                        touches_edge = True\n\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h - 1 and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == 0:\n                            seen[nx][ny] = True\n                            q.append((nx, ny))\n\n                if not touches_edge:\n                    comps.append(cells)\n\n    if not comps or len(markers) < 2:\n        return out\n\n    # Sort enclosed blank regions top-to-bottom, then left-to-right.\n    comps.sort(key=lambda cells: (min(r for r, _ in cells), min(c for _, c in cells)))\n\n    # From the examples, the topmost blank gets the 2nd marker color,\n    # the next one gets the 1st marker color.\n    fill_colors = []\n    if len(comps) >= 1:\n        fill_colors.append(markers[1])\n    if len(comps) >= 2:\n        fill_colors.append(markers[0])\n\n    for comp, color in zip(comps, fill_colors):\n        for r, c in comp:\n            out[r][c] = color\n\n    return out",
