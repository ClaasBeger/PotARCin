  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = sorted({v for row in grid for v in row if v != 0})\n    out = [[0] * w for _ in range(h)]\n\n    positions = {}\n    for color in colors:\n        pts = []\n        for r in range(h):\n            for c in range(w):\n                if grid[r][c] == color:\n                    pts.append((r, c))\n        positions[color] = pts\n\n    def choose_med_col(pts):\n        cols = sorted(c for _, c in pts)\n        n = len(cols)\n        if n % 2 == 1:\n            return cols[n // 2]\n\n        low = cols[n // 2 - 1]\n        high = cols[n // 2]\n        if low == high:\n            return low\n\n        row_vals = sorted(r for r, _ in pts)\n        target_row = row_vals[n // 2]\n\n        def score(cand):\n            rows_here = [r for r, c in pts if c == cand]\n            freq = len(rows_here)\n            if freq == 0:\n                avg_dist = float(\"inf\")\n            else:\n                avg_row = sum(rows_here) / freq\n                avg_dist = abs(avg_row - target_row)\n            # Prefer more occurrences on the candidate column,\n            # then rows closer to the upper-median row,\n            # then larger column as final stable tie-break.\n            return (-freq, avg_dist, -cand)\n\n        best = min([low, high], key=score)\n        return best\n\n    for color in colors:\n        pts = positions[color]\n        if not pts:\n            continue\n\n        trunk_c = choose_med_col(pts)\n        min_r = min(r for r, _ in pts)\n        max_r = max(r for r, _ in pts)\n\n        for r in range(min_r, max_r + 1):\n            out[r][trunk_c] = color\n\n        for r, c in pts:\n            a, b = sorted((c, trunk_c))\n            for cc in range(a, b + 1):\n                out[r][cc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = sorted({v for row in grid for v in row if v != 0})\n    out = [[0] * w for _ in range(h)]\n\n    positions = {}\n    for color in colors:\n        pts = []\n        for r in range(h):\n            for c in range(w):\n                if grid[r][c] == color:\n                    pts.append((r, c))\n        positions[color] = pts\n\n    def choose_med_col(pts):\n        cols = sorted(c for _, c in pts)\n        n = len(cols)\n        if n % 2 == 1:\n            return cols[n // 2]\n\n        low = cols[n // 2 - 1]\n        high = cols[n // 2]\n        if low == high:\n            return low\n\n        row_vals = sorted(r for r, _ in pts)\n        target_row = row_vals[n // 2]\n\n        def score(cand):\n            rows_here = [r for r, c in pts if c == cand]\n            freq = len(rows_here)\n            if freq == 0:\n                avg_dist = float(\"inf\")\n            else:\n                avg_row = sum(rows_here) / freq\n                avg_dist = abs(avg_row - target_row)\n            # Prefer more occurrences on the candidate column,\n            # then rows closer to the upper-median row,\n            # then larger column as final stable tie-break.\n            return (-freq, avg_dist, -cand)\n\n        best = min([low, high], key=score)\n        return best\n\n    for color in colors:\n        pts = positions[color]\n        if not pts:\n            continue\n\n        trunk_c = choose_med_col(pts)\n        min_r = min(r for r, _ in pts)\n        max_r = max(r for r, _ in pts)\n\n        for r in range(min_r, max_r + 1):\n            out[r][trunk_c] = color\n\n        for r, c in pts:\n            a, b = sorted((c, trunk_c))\n            for cc in range(a, b + 1):\n                out[r][cc] = color\n\n    return out",
