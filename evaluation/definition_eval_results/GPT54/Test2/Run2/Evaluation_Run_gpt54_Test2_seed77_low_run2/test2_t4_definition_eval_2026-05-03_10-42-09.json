  "raw_response": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0]) if H else 0\n\n    # Find the border-2 rectangle\n    cells2 = [(r, c) for r in range(H) for c in range(W) if grid[r][c] == 2]\n    if not cells2:\n        return [row[:] for row in grid]\n\n    rmin = min(r for r, _ in cells2)\n    rmax = max(r for r, _ in cells2)\n    cmin = min(c for _, c in cells2)\n    cmax = max(c for _, c in cells2)\n\n    # Interior of the 2-frame\n    ir0, ir1 = rmin + 1, rmax - 1\n    ic0, ic1 = cmin + 1, cmax - 1\n\n    # Collect non-zero colors inside, in reading order, with their cells\n    colors = []\n    seen = set()\n    pos_by_color = {}\n    for r in range(ir0, ir1 + 1):\n        for c in range(ic0, ic1 + 1):\n            v = grid[r][c]\n            if v != 0:\n                pos_by_color.setdefault(v, []).append((r - ir0, c - ic0))\n                if v not in seen:\n                    seen.add(v)\n                    colors.append(v)\n\n    out = [[0] * W for _ in range(H)]\n    if not colors:\n        return out\n\n    unit_h = H // 3 if H % 3 == 0 else 4\n    unit_w = W // 3 if W % 3 == 0 else 4\n\n    # Layout: place components diagonally using the bbox size measured in interior cells\n    placements = []\n    cur_r = 0\n    cur_c = 0\n    for color in colors:\n        pts = pos_by_color[color]\n        prmin = min(r for r, _ in pts)\n        prmax = max(r for r, _ in pts)\n        pcmin = min(c for _, c in pts)\n        pcmax = max(c for _, c in pts)\n        bh = prmax - prmin + 1\n        bw = pcmax - pcmin + 1\n        h = bh * unit_h\n        w = bw * unit_w\n        placements.append((color, cur_r, cur_c, h, w, pts, prmin, pcmin))\n        cur_r += h\n        cur_c += w\n        if cur_r >= H or cur_c >= W:\n            break\n\n    for color, sr, sc, h, w, pts, prmin, pcmin in placements:\n        er = min(H, sr + h)\n        ec = min(W, sc + w)\n        if sr >= H or sc >= W:\n            continue\n\n        # Border\n        for c in range(sc, ec):\n            out[sr][c] = color\n            out[er - 1][c] = color\n        for r in range(sr, er):\n            out[r][sc] = color\n            out[r][ec - 1] = color\n\n        # Draw the color's own shape as 2s, scaled into the rectangle interior\n        # For 12x12 tasks this yields 1-cell markers for singletons and 1-row/1-col runs.\n        inner_h = max(0, h - 2)\n        inner_w = max(0, w - 2)\n        bh = max(r for r, _ in pts) - prmin + 1\n        bw = max(c for _, c in pts) - pcmin + 1\n\n        for rr, cc in pts:\n            rr -= prmin\n            cc -= pcmin\n\n            if bh == 1:\n                r0 = sr + 1 + inner_h // 2\n                r1 = r0 + 1\n            else:\n                r0 = sr + 1 + (rr * inner_h) // bh\n                r1 = sr + 1 + ((rr + 1) * inner_h) // bh\n                if r1 <= r0:\n                    r1 = r0 + 1\n\n            if bw == 1:\n                c0 = sc + 1 + inner_w // 2\n                c1 = c0 + 1\n            else:\n                c0 = sc + 1 + (cc * inner_w) // bw\n                c1 = sc + 1 + ((cc + 1) * inner_w) // bw\n                if c1 <= c0:\n                    c1 = c0 + 1\n\n            for r in range(max(sr + 1, r0), min(er - 1, r1)):\n                for c in range(max(sc + 1, c0), min(ec - 1, c1)):\n                    out[r][c] = 2\n\n        # Special handling for singleton components to better match the examples\n        if len(pts) == 1 and h >= 4 and w >= 4:\n            rr, cc = pts[0]\n            rr -= prmin\n            cc -= pcmin\n            for r in range(sr + 1, er - 1):\n                for c in range(sc + 1, ec - 1):\n                    if out[r][c] == 2:\n                        out[r][c] = 0\n\n            # Map original interior position to one marker spot in the 2x2 interior\n            gr, gc = pos_by_color[color][0]\n            mr = sr + 1 + (1 if gr >= 1 else 0)\n            mc = sc + 1 + (0 if gc >= 1 else 1)\n            if sr + 1 <= mr < er - 1 and sc + 1 <= mc < ec - 1:\n                out[mr][mc] = 2\n\n    return out",
