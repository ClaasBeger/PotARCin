  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find the main object color as the most frequent non-zero color.\n    freq = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                freq[v] = freq.get(v, 0) + 1\n    if not freq:\n        return [row[:] for row in grid]\n    main_color = max(freq.items(), key=lambda kv: kv[1])[0]\n\n    # Build output with only the main object retained.\n    out = [[0] * w for _ in range(h)]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == main_color:\n                out[r][c] = main_color\n\n    # Extract the top motif: non-zero, non-main colors from the top row,\n    # compressing consecutive duplicates.\n    motif = []\n    prev = None\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and v != main_color:\n            if v != prev:\n                motif.append(v)\n            prev = v\n        else:\n            prev = None\n\n    if not motif:\n        return out\n\n    # Rows selected by markers in the first column (excluding row 0).\n    marked_rows = [r for r in range(1, h) if grid[r][0] != 0 and grid[r][0] != main_color]\n\n    # Bounding box of the main object.\n    main_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == main_color]\n    if not main_cells:\n        return out\n    min_c = min(c for _, c in main_cells)\n    max_c = max(c for _, c in main_cells)\n\n    def choose_positions(occ, k):\n        if k == 1:\n            return [occ[len(occ) // 2]]\n        n = len(occ)\n        pos = []\n        for i in range(k):\n            idx = round(i * (n - 1) / (k - 1))\n            pos.append(occ[idx])\n        return pos\n\n    for r in marked_rows:\n        occ = [c for c in range(w) if grid[r][c] == main_color]\n        if not occ:\n            occ = list(range(min_c, max_c + 1))\n        cols = choose_positions(occ, len(motif))\n        for c, v in zip(cols, motif):\n            out[r][c] = v\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find the main object color as the most frequent non-zero color.\n    freq = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                freq[v] = freq.get(v, 0) + 1\n    if not freq:\n        return [row[:] for row in grid]\n    main_color = max(freq.items(), key=lambda kv: kv[1])[0]\n\n    # Build output with only the main object retained.\n    out = [[0] * w for _ in range(h)]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == main_color:\n                out[r][c] = main_color\n\n    # Extract the top motif: non-zero, non-main colors from the top row,\n    # compressing consecutive duplicates.\n    motif = []\n    prev = None\n    for c in range(w):\n        v = grid[0][c]\n        if v != 0 and v != main_color:\n            if v != prev:\n                motif.append(v)\n            prev = v\n        else:\n            prev = None\n\n    if not motif:\n        return out\n\n    # Rows selected by markers in the first column (excluding row 0).\n    marked_rows = [r for r in range(1, h) if grid[r][0] != 0 and grid[r][0] != main_color]\n\n    # Bounding box of the main object.\n    main_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == main_color]\n    if not main_cells:\n        return out\n    min_c = min(c for _, c in main_cells)\n    max_c = max(c for _, c in main_cells)\n\n    def choose_positions(occ, k):\n        if k == 1:\n            return [occ[len(occ) // 2]]\n        n = len(occ)\n        pos = []\n        for i in range(k):\n            idx = round(i * (n - 1) / (k - 1))\n            pos.append(occ[idx])\n        return pos\n\n    for r in marked_rows:\n        occ = [c for c in range(w) if grid[r][c] == main_color]\n        if not occ:\n            occ = list(range(min_c, max_c + 1))\n        cols = choose_positions(occ, len(motif))\n        for c, v in zip(cols, motif):\n            out[r][c] = v\n\n    return out",
