  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = sorted({v for row in grid for v in row if v != 0})\n    if not colors:\n        return [row[:] for row in grid]\n\n    def bbox(c):\n        pts = [(r, col) for r in range(h) for col in range(w) if grid[r][col] == c]\n        rs = [r for r, _ in pts]\n        cs = [col for _, col in pts]\n        return min(rs), max(rs), min(cs), max(cs), pts\n\n    def infer_shape(c):\n        r0, r1, c0, c1, pts = bbox(c)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        area = bh * bw\n        count = len(pts)\n        density = count / area if area else 0.0\n\n        mask = [[False] * w for _ in range(h)]\n        for r, col in pts:\n            mask[r][col] = True\n\n        changed = True\n        while changed:\n            changed = False\n            for r in range(r0, r1 + 1):\n                cols = [col for col in range(c0, c1 + 1) if mask[r][col]]\n                if len(cols) >= 2:\n                    a, b = min(cols), max(cols)\n                    for col in range(a, b + 1):\n                        if not mask[r][col]:\n                            mask[r][col] = True\n                            changed = True\n            for col in range(c0, c1 + 1):\n                rows = [r for r in range(r0, r1 + 1) if mask[r][col]]\n                if len(rows) >= 2:\n                    a, b = min(rows), max(rows)\n                    for r in range(a, b + 1):\n                        if not mask[r][col]:\n                            mask[r][col] = True\n                            changed = True\n\n        # If very dense in its bbox, treat as a solid rectangle.\n        if density >= 0.6:\n            for r in range(r0, r1 + 1):\n                for col in range(c0, c1 + 1):\n                    mask[r][col] = True\n\n        is_horizontal = len({r for r, _ in pts}) == 1\n        is_vertical = len({col for _, col in pts}) == 1\n        orient_priority = 1 if is_horizontal else 0\n\n        # Higher priority first.\n        # Dense/regular objects tend to occlude sparse ones.\n        # Smaller dense rectangles tend to win over larger ones.\n        # For equal line-like objects, later-diagonal and horizontal win.\n        priority = (\n            density,\n            -area,\n            (r0 + c0),\n            orient_priority,\n        )\n\n        return mask, priority\n\n    shapes = {}\n    for c in colors:\n        shapes[c] = infer_shape(c)\n\n    order = sorted(colors, key=lambda c: shapes[c][1], reverse=True)\n\n    out = [[0] * w for _ in range(h)]\n    for c in reversed(order):\n        mask, _ = shapes[c]\n        for r in range(h):\n            for col in range(w):\n                if mask[r][col]:\n                    out[r][col] = c\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = sorted({v for row in grid for v in row if v != 0})\n    if not colors:\n        return [row[:] for row in grid]\n\n    def bbox(c):\n        pts = [(r, col) for r in range(h) for col in range(w) if grid[r][col] == c]\n        rs = [r for r, _ in pts]\n        cs = [col for _, col in pts]\n        return min(rs), max(rs), min(cs), max(cs), pts\n\n    def infer_shape(c):\n        r0, r1, c0, c1, pts = bbox(c)\n        bh = r1 - r0 + 1\n        bw = c1 - c0 + 1\n        area = bh * bw\n        count = len(pts)\n        density = count / area if area else 0.0\n\n        mask = [[False] * w for _ in range(h)]\n        for r, col in pts:\n            mask[r][col] = True\n\n        changed = True\n        while changed:\n            changed = False\n            for r in range(r0, r1 + 1):\n                cols = [col for col in range(c0, c1 + 1) if mask[r][col]]\n                if len(cols) >= 2:\n                    a, b = min(cols), max(cols)\n                    for col in range(a, b + 1):\n                        if not mask[r][col]:\n                            mask[r][col] = True\n                            changed = True\n            for col in range(c0, c1 + 1):\n                rows = [r for r in range(r0, r1 + 1) if mask[r][col]]\n                if len(rows) >= 2:\n                    a, b = min(rows), max(rows)\n                    for r in range(a, b + 1):\n                        if not mask[r][col]:\n                            mask[r][col] = True\n                            changed = True\n\n        # If very dense in its bbox, treat as a solid rectangle.\n        if density >= 0.6:\n            for r in range(r0, r1 + 1):\n                for col in range(c0, c1 + 1):\n                    mask[r][col] = True\n\n        is_horizontal = len({r for r, _ in pts}) == 1\n        is_vertical = len({col for _, col in pts}) == 1\n        orient_priority = 1 if is_horizontal else 0\n\n        # Higher priority first.\n        # Dense/regular objects tend to occlude sparse ones.\n        # Smaller dense rectangles tend to win over larger ones.\n        # For equal line-like objects, later-diagonal and horizontal win.\n        priority = (\n            density,\n            -area,\n            (r0 + c0),\n            orient_priority,\n        )\n\n        return mask, priority\n\n    shapes = {}\n    for c in colors:\n        shapes[c] = infer_shape(c)\n\n    order = sorted(colors, key=lambda c: shapes[c][1], reverse=True)\n\n    out = [[0] * w for _ in range(h)]\n    for c in reversed(order):\n        mask, _ = shapes[c]\n        for r in range(h):\n            for col in range(w):\n                if mask[r][col]:\n                    out[r][col] = c\n\n    return out",
