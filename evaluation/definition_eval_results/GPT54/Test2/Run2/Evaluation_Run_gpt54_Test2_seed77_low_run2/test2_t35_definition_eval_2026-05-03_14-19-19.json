n        for j, k in enumerate(sorted_offsets):\n            start = starts[j]\n            for r in range(h):\n                c = k - r\n                if 0 <= c < pw:\n                    out[r][start + c] = color\n        return out\n\n    # Fallback: preserve grid if the simple diagonal-panel model does not fit.\n    return [row[:] for row in grid]",
