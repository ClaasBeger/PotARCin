2:\n            continue\n\n        n = len(comps)\n        used = [False] * n\n        used[0] = True\n\n        for _ in range(n - 1):\n            best = None\n            best_i = best_j = None\n            best_pair = None\n            for i in range(n):\n                if not used[i]:\n                    continue\n                for j in range(n):\n                    if used[j]:\n                        continue\n                    d, pair = nearest_pair(comps[i], comps[j])\n                    if best is None or d < best:\n                        best = d\n                        best_i, best_j = i, j\n                        best_pair = pair\n            used[best_j] = True\n            fill_all_shortest_paths(*best_pair)\n\n    return out",
