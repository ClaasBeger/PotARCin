  "raw_response": "def solve(grid):\n    from collections import defaultdict, deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                yield nr, nc\n\n    # Find 4-connected components for each non-zero color\n    by_color = defaultdict(list)\n    seen = [[False] * w for _ in range(h)]\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or seen[r][c]:\n                continue\n            q = deque([(r, c)])\n            seen[r][c] = True\n            cells = []\n            while q:\n                x, y = q.popleft()\n                cells.append((x, y))\n                for nx, ny in neighbors(x, y):\n                    if not seen[nx][ny] and grid[nx][ny] == color:\n                        seen[nx][ny] = True\n                        q.append((nx, ny))\n            by_color[color].append(cells)\n\n    out = [[0] * w for _ in range(h)]\n\n    def nearest_pair(comp_a, comp_b):\n        best = None\n        best_pair = None\n        for a in comp_a:\n            for b in comp_b:\n                d = abs(a[0] - b[0]) + abs(a[1] - b[1])\n                if best is None or d < best:\n                    best = d\n                    best_pair = (a, b)\n        return best, best_pair\n\n    def fill_all_shortest_paths(a, b):\n        r1, c1 = a\n        r2, c2 = b\n        total = abs(r1 - r2) + abs(c1 - c2)\n        rmin, rmax = sorted((r1, r2))\n        cmin, cmax = sorted((c1, c2))\n        for r in range(rmin, rmax + 1):\n            for c in range(cmin, cmax + 1):\n                if abs(r1 - r) + abs(c1 - c) + abs(r - r2) + abs(c - c2) == total:\n                    out[r][c] = 5\n\n    # For each color, connect its components by a nearest-component MST\n    for color, comps in by_color.items():\n        if len(comps) < 2:\n            continue\n\n        n = len(comps)\n        used = [False] * n\n        used[0] = True\n\n        for _ in range(n - 1):\n            best = None\n            best_i = best_j = None\n            best_pair = None\n            for i in range(n):\n                if not used[i]:\n                    continue\n                for j in range(n):\n                    if used[j]:\n                        continue\n                    d, pair = nearest_pair(comps[i], comps[j])\n                    if best is None or d < best:\n                        best = d\n                        best_i, best_j = i, j\n                        best_pair = pair\n            used[best_j] = True\n            fill_all_shortest_paths(*best_pair)\n\n    return out",
