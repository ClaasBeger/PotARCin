omponents from higher to lower, then left to right\n    six_comps.sort(key=lambda comp: (comp[\"min_r\"], comp[\"min_c\"]))\n\n    removed = [False] * len(top_comps)\n\n    for scomp in six_comps:\n        cols = scomp[\"cols\"]\n        for _ in range(scomp[\"size\"]):\n            candidates = []\n            for i, tcomp in enumerate(top_comps):\n                if removed[i]:\n                    continue\n                if tcomp[\"cols\"] & cols:\n                    candidates.append(i)\n            if not candidates:\n                continue\n            # Remove the lowest remaining intersecting top component\n            best = max(\n                candidates,\n                key=lambda i: (top_comps[i][\"max_r\"], top_comps[i][\"min_r\"], top_comps[i][\"min_c\"])\n            )\n            removed[best] = True\n\n    out = [[0] * w for _ in range(h)]\n\n    # Keep unremoved main-color components\n    for i, comp in enumerate(top_comps):\n        if not removed[i]:\n            for r, c in comp[\"cells\"]:\n                out[r][c] = main_color\n\n    # Keep all 5 cells\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 5:\n                out[r][c] = 5\n\n    return out",
