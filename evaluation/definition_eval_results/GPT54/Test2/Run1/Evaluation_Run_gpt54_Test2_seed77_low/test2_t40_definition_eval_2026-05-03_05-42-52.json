  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                colors = set()\n                min_r = max_r = r\n                min_c = max_c = c\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    colors.add(grid[x][y])\n                    if x < min_r:\n                        min_r = x\n                    if x > max_r:\n                        max_r = x\n                    if y < min_c:\n                        min_c = y\n                    if y > max_c:\n                        max_c = y\n\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and grid[nx][ny] != 0 and not visited[nx][ny]:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                comps.append({\n                    \"cells\": cells,\n                    \"colors\": colors,\n                    \"top\": min_r,\n                    \"bottom\": max_r,\n                    \"left\": min_c,\n                    \"right\": max_c,\n                })\n\n    n = len(comps)\n    bad = set(i for i, comp in enumerate(comps) if 2 in comp[\"colors\"])\n\n    changed = True\n    while changed:\n        changed = False\n        for i in range(n):\n            if i in bad:\n                continue\n            a = comps[i]\n            for j in bad:\n                b = comps[j]\n                horizontal_overlap = not (a[\"right\"] < b[\"left\"] or b[\"right\"] < a[\"left\"])\n                strictly_above = a[\"bottom\"] < b[\"top\"]\n                if horizontal_overlap and strictly_above:\n                    bad.add(i)\n                    changed = True\n                    break\n\n    out = [row[:] for row in grid]\n    for i in bad:\n        for r, c in comps[i][\"cells\"]:\n            out[r][c] = 0\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                colors = set()\n                min_r = max_r = r\n                min_c = max_c = c\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    colors.add(grid[x][y])\n                    if x < min_r:\n                        min_r = x\n                    if x > max_r:\n                        max_r = x\n                    if y < min_c:\n                        min_c = y\n                    if y > max_c:\n                        max_c = y\n\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and grid[nx][ny] != 0 and not visited[nx][ny]:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                comps.append({\n                    \"cells\": cells,\n                    \"colors\": colors,\n                    \"top\": min_r,\n                    \"bottom\": max_r,\n                    \"left\": min_c,\n                    \"right\": max_c,\n                })\n\n    n = len(comps)\n    bad = set(i for i, comp in enumerate(comps) if 2 in comp[\"colors\"])\n\n    changed = True\n    while changed:\n        changed = False\n        for i in range(n):\n            if i in bad:\n                continue\n            a = comps[i]\n            for j in bad:\n                b = comps[j]\n                horizontal_overlap = not (a[\"right\"] < b[\"left\"] or b[\"right\"] < a[\"left\"])\n                strictly_above = a[\"bottom\"] < b[\"top\"]\n                if horizontal_overlap and strictly_above:\n                    bad.add(i)\n                    changed = True\n                    break\n\n    out = [row[:] for row in grid]\n    for i in bad:\n        for r, c in comps[i][\"cells\"]:\n            out[r][c] = 0\n\n    return out",
