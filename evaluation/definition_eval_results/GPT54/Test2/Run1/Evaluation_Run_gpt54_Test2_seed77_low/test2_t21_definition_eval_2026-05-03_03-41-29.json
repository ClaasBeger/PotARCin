 0 2 0 0 0 2\n0 0 0 0 0 6 0 0 0 0 0 0\n4 5 5 0 0 6 6 0 9 0 8 8\n4 0 0 9 0 0 6 0 0 8 8 0\n4 4 4 9 0 0 6 3 0 8 4 4\n0 0 0 9 0 3 3 3 0 8 0 4\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0])\n\n    if n != m:\n        # Fallback: apply the same logic independently if ever rectangular.\n        rn = 2 if n % 2 == 0 else 5\n        rm = 2 if m % 2 == 0 else 5\n        r0 = (n - rn) // 2\n        c0 = (m - rm) // 2\n        keep_rows = list(range(r0 + rn, n)) + list(range(0, r0))\n        keep_cols = list(range(c0 + rm, m)) + list(range(0, c0))\n        return [[grid[i][j] for j in keep_cols] for i in keep_rows]\n\n    remove = 2 if n % 2 == 0 else 5\n    start = (n - remove) // 2\n\n    keep_rows = list(range(start + remove, n)) + list(range(0, start))\n    keep_cols = list(range(start + remove, n)) + list(range(0, start))\n\n    return [[grid[i][j] for j in keep_cols] for i in keep_rows]",
  "script": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0])\n\n    if n != m:\n        # Fallback: apply the same logic independently if ever rectangular.\n        rn = 2 if n % 2 == 0 else 5\n        rm = 2 if m % 2 == 0 else 5\n        r0 = (n - rn) // 2\n        c0 = (m - rm) // 2\n        keep_rows = list(range(r0 + rn, n)) + list(range(0, r0))\n        keep_cols = list(range(c0 + rm, m)) + list(range(0, c0))\n        return [[grid[i][j] for j in keep_cols] for i in keep_rows]\n\n    remove = 2 if n % 2 == 0 else 5\n    start = (n - remove) // 2\n\n    keep_rows = list(range(start + remove, n)) + list(range(0, start))\n    keep_cols = list(range(start + remove, n)) + list(range(0, start))\n\n    return [[grid[i][j] for j in keep_cols] for i in keep_rows]",
