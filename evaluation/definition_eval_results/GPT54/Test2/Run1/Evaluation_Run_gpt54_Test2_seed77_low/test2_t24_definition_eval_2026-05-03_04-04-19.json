  "raw_response": "def solve(grid):\n    from collections import deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find all cells with color 2 (usually a marker)\n    seeds = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not seeds:\n        return out\n\n    # 4-connected components of nonzero colors except 2\n    seen = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and grid[r][c] != 2 and not seen[r][c]:\n                color = grid[r][c]\n                q = deque([(r, c)])\n                seen[r][c] = True\n                cells = []\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == color:\n                            seen[nx][ny] = True\n                            q.append((nx, ny))\n                comps.append(cells)\n\n    if not comps:\n        for r, c in seeds:\n            out[r][c] = 0\n        return out\n\n    def cheb(a, b):\n        return max(abs(a[0] - b[0]), abs(a[1] - b[1]))\n\n    def comp_dist_cells(comp_a, comp_b):\n        best = 10**9\n        for p in comp_a:\n            for q in comp_b:\n                d = cheb(p, q)\n                if d < best:\n                    best = d\n        return best\n\n    def seed_dist(comp):\n        best = 10**9\n        for p in comp:\n            for s in seeds:\n                d = cheb(p, s)\n                if d < best:\n                    best = d\n        return best\n\n    # Heuristic inferred from examples:\n    # start from components near the 2-marker, then propagate through very close components.\n    selected = set()\n    for i, comp in enumerate(comps):\n        if seed_dist(comp) <= 2:\n            selected.add(i)\n\n    changed = True\n    while changed:\n        changed = False\n        for i in range(len(comps)):\n            if i in selected:\n                continue\n            # Strong propagation: directly touching/diagonal-near selected components\n            for j in list(selected):\n                if comp_dist_cells(comps[i], comps[j]) <= 1:\n                    selected.add(i)\n                    changed = True\n                    break\n\n    # Apply recoloring\n    for r, c in seeds:\n        out[r][c] = 0\n    for i in selected:\n        for r, c in comps[i]:\n            out[r][c] = 2\n\n    return out",
  "script": "def solve(grid):\n    from collections import deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find all cells with color 2 (usually a marker)\n    seeds = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    if not seeds:\n        return out\n\n    # 4-connected components of nonzero colors except 2\n    seen = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and grid[r][c] != 2 and not seen[r][c]:\n                color = grid[r][c]\n                q = deque([(r, c)])\n                seen[r][c] = True\n                cells = []\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not seen[nx][ny] and grid[nx][ny] == color:\n                            seen[nx][ny] = True\n                            q.append((nx, ny))\n                comps.append(cells)\n\n    if not comps:\n        for r, c in seeds:\n            out[r][c] = 0\n        return out\n\n    def cheb(a, b):\n        return max(abs(a[0] - b[0]), abs(a[1] - b[1]))\n\n    def comp_dist_cells(comp_a, comp_b):\n        best = 10**9\n        for p in comp_a:\n            for q in comp_b:\n                d = cheb(p, q)\n                if d < best:\n                    best = d\n        return best\n\n    def seed_dist(comp):\n        best = 10**9\n        for p in comp:\n            for s in seeds:\n                d = cheb(p, s)\n                if d < best:\n                    best = d\n        return best\n\n    # Heuristic inferred from examples:\n    # start from components near the 2-marker, then propagate through very close components.\n    selected = set()\n    for i, comp in enumerate(comps):\n        if seed_dist(comp) <= 2:\n            selected.add(i)\n\n    changed = True\n    while changed:\n        changed = False\n        for i in range(len(comps)):\n            if i in selected:\n                continue\n            # Strong propagation: directly touching/diagonal-near selected components\n            for j in list(selected):\n                if comp_dist_cells(comps[i], comps[j]) <= 1:\n                    selected.add(i)\n                    changed = True\n                    break\n\n    # Apply recoloring\n    for r, c in seeds:\n        out[r][c] = 0\n    for i in selected:\n        for r, c in comps[i]:\n            out[r][c] = 2\n\n    return out",
