  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    objects = []\n\n    # Find connected monochrome objects\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            min_r = min(x for x, _ in cells)\n            min_c = min(y for _, y in cells)\n            rel = sorted((x - min_r, y - min_c) for x, y in cells)\n            bh = max(x for x, _ in rel) + 1\n            bw = max(y for _, y in rel) + 1\n            objects.append({\n                \"color\": color,\n                \"cells\": rel,\n                \"bbox_h\": bh,\n                \"bbox_w\": bw,\n                \"orig\": (min_r, min_c),\n            })\n\n    # Destination corner by color\n    # 3 -> top-left, 6 -> top-right, 4 -> bottom-left, 8 -> bottom-right\n    corner = {\n        3: \"TL\",\n        6: \"TR\",\n        4: \"BL\",\n        8: \"BR\",\n    }\n\n    # Sort objects within each color by original position\n    objects.sort(key=lambda o: (o[\"color\"], o[\"orig\"][0], o[\"orig\"][1]))\n\n    out = [[0] * w for _ in range(h)]\n\n    def can_place(obj, r0, c0):\n        if r0 < 0 or c0 < 0 or r0 + obj[\"bbox_h\"] > h or c0 + obj[\"bbox_w\"] > w:\n            return False\n        for dr, dc in obj[\"cells\"]:\n            if out[r0 + dr][c0 + dc] != 0:\n                return False\n        return True\n\n    def place(obj, r0, c0):\n        for dr, dc in obj[\"cells\"]:\n            out[r0 + dr][c0 + dc] = obj[\"color\"]\n\n    def candidates(obj, mode):\n        if mode == \"TL\":\n            rows = range(0, h - obj[\"bbox_h\"] + 1)\n            cols = range(0, w - obj[\"bbox_w\"] + 1)\n        elif mode == \"TR\":\n            rows = range(0, h - obj[\"bbox_h\"] + 1)\n            cols = range(w - obj[\"bbox_w\"], -1, -1)\n        elif mode == \"BL\":\n            rows = range(h - obj[\"bbox_h\"], -1, -1)\n            cols = range(0, w - obj[\"bbox_w\"] + 1)\n        else:  # BR\n            rows = range(h - obj[\"bbox_h\"], -1, -1)\n            cols = range(w - obj[\"bbox_w\"], -1, -1)\n\n        for r0 in rows:\n            for c0 in cols:\n                yield r0, c0\n\n    for obj in objects:\n        mode = corner.get(obj[\"color\"], \"TL\")\n        for r0, c0 in candidates(obj, mode):\n            if can_place(obj, r0, c0):\n                place(obj, r0, c0)\n                break\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    objects = []\n\n    # Find connected monochrome objects\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            min_r = min(x for x, _ in cells)\n            min_c = min(y for _, y in cells)\n            rel = sorted((x - min_r, y - min_c) for x, y in cells)\n            bh = max(x for x, _ in rel) + 1\n            bw = max(y for _, y in rel) + 1\n            objects.append({\n                \"color\": color,\n                \"cells\": rel,\n                \"bbox_h\": bh,\n                \"bbox_w\": bw,\n                \"orig\": (min_r, min_c),\n            })\n\n    # Destination corner by color\n    # 3 -> top-left, 6 -> top-right, 4 -> bottom-left, 8 -> bottom-right\n    corner = {\n        3: \"TL\",\n        6: \"TR\",\n        4: \"BL\",\n        8: \"BR\",\n    }\n\n    # Sort objects within each color by original position\n    objects.sort(key=lambda o: (o[\"color\"], o[\"orig\"][0], o[\"orig\"][1]))\n\n    out = [[0] * w for _ in range(h)]\n\n    def can_place(obj, r0, c0):\n        if r0 < 0 or c0 < 0 or r0 + obj[\"bbox_h\"] > h or c0 + obj[\"bbox_w\"] > w:\n            return False\n        for dr, dc in obj[\"cells\"]:\n            if out[r0 + dr][c0 + dc] != 0:\n                return False\n        return True\n\n    def place(obj, r0, c0):\n        for dr, dc in obj[\"cells\"]:\n            out[r0 + dr][c0 + dc] = obj[\"color\"]\n\n    def candidates(obj, mode):\n        if mode == \"TL\":\n            rows = range(0, h - obj[\"bbox_h\"] + 1)\n            cols = range(0, w - obj[\"bbox_w\"] + 1)\n        elif mode == \"TR\":\n            rows = range(0, h - obj[\"bbox_h\"] + 1)\n            cols = range(w - obj[\"bbox_w\"], -1, -1)\n        elif mode == \"BL\":\n            rows = range(h - obj[\"bbox_h\"], -1, -1)\n            cols = range(0, w - obj[\"bbox_w\"] + 1)\n        else:  # BR\n            rows = range(h - obj[\"bbox_h\"], -1, -1)\n            cols = range(w - obj[\"bbox_w\"], -1, -1)\n\n        for r0 in rows:\n            for c0 in cols:\n                yield r0, c0\n\n    for obj in objects:\n        mode = corner.get(obj[\"color\"], \"TL\")\n        for r0, c0 in candidates(obj, mode):\n            if can_place(obj, r0, c0):\n                place(obj, r0, c0)\n                break\n\n    return out",
