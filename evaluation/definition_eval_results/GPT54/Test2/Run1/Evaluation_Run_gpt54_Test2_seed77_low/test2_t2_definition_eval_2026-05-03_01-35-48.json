  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    cells_by_color = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                cells_by_color.setdefault(v, []).append((r, c))\n\n    if not cells_by_color:\n        return [row[:] for row in grid]\n\n    info = []\n    for color, cells in cells_by_color.items():\n        n = len(cells)\n        sr = sum(r for r, _ in cells)\n        sc = sum(c for _, c in cells)\n        info.append((sr + sc, sr, sc, color, cells))\n\n    info.sort()\n\n    new_color_for = {}\n    k = len(info)\n    for i, (_, _, _, color, _) in enumerate(info):\n        prev_color = info[(i - 1) % k][3]\n        new_color_for[color] = prev_color\n\n    out = [[0] * w for _ in range(h)]\n    for color, cells in cells_by_color.items():\n        nc = new_color_for[color]\n        for r, c in cells:\n            out[r][c] = nc\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    cells_by_color = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                cells_by_color.setdefault(v, []).append((r, c))\n\n    if not cells_by_color:\n        return [row[:] for row in grid]\n\n    info = []\n    for color, cells in cells_by_color.items():\n        n = len(cells)\n        sr = sum(r for r, _ in cells)\n        sc = sum(c for _, c in cells)\n        info.append((sr + sc, sr, sc, color, cells))\n\n    info.sort()\n\n    new_color_for = {}\n    k = len(info)\n    for i, (_, _, _, color, _) in enumerate(info):\n        prev_color = info[(i - 1) % k][3]\n        new_color_for[color] = prev_color\n\n    out = [[0] * w for _ in range(h)]\n    for color, cells in cells_by_color.items():\n        nc = new_color_for[color]\n        for r, c in cells:\n            out[r][c] = nc\n\n    return out",
