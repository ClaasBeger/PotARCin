  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find dominant non-zero color: the main figure color\n    freq = {}\n    for row in grid:\n        for v in row:\n            if v != 0:\n                freq[v] = freq.get(v, 0) + 1\n    if not freq:\n        return grid\n    main = max(freq, key=freq.get)\n\n    # Copy only the main figure; all auxiliary markers will be removed\n    out = [[main if grid[r][c] == main else 0 for c in range(w)] for r in range(h)]\n\n    # Extract the top-row pattern (non-zero, non-main), preserving gaps\n    top_cells = [(0, c, grid[0][c]) for c in range(w) if grid[0][c] != 0 and grid[0][c] != main]\n    if not top_cells:\n        return out\n\n    min_c = min(c for _, c, _ in top_cells)\n    max_c = max(c for _, c, _ in top_cells)\n    pattern = [(c - min_c, v) for _, c, v in top_cells]\n\n    # Rows marked on the left edge (non-zero, non-main)\n    marked_rows = [r for r in range(1, h) if grid[r][0] != 0 and grid[r][0] != main]\n\n    # Paste the top pattern diagonally downward.\n    # Heuristic inferred from the examples:\n    # anchor pattern's left edge near the row index.\n    for r in marked_rows:\n        start_c = r\n        for dc, v in pattern:\n            c = start_c + dc\n            if 0 <= c < w:\n                out[r][c] = v\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find dominant non-zero color: the main figure color\n    freq = {}\n    for row in grid:\n        for v in row:\n            if v != 0:\n                freq[v] = freq.get(v, 0) + 1\n    if not freq:\n        return grid\n    main = max(freq, key=freq.get)\n\n    # Copy only the main figure; all auxiliary markers will be removed\n    out = [[main if grid[r][c] == main else 0 for c in range(w)] for r in range(h)]\n\n    # Extract the top-row pattern (non-zero, non-main), preserving gaps\n    top_cells = [(0, c, grid[0][c]) for c in range(w) if grid[0][c] != 0 and grid[0][c] != main]\n    if not top_cells:\n        return out\n\n    min_c = min(c for _, c, _ in top_cells)\n    max_c = max(c for _, c, _ in top_cells)\n    pattern = [(c - min_c, v) for _, c, v in top_cells]\n\n    # Rows marked on the left edge (non-zero, non-main)\n    marked_rows = [r for r in range(1, h) if grid[r][0] != 0 and grid[r][0] != main]\n\n    # Paste the top pattern diagonally downward.\n    # Heuristic inferred from the examples:\n    # anchor pattern's left edge near the row index.\n    for r in marked_rows:\n        start_c = r\n        for dc, v in pattern:\n            c = start_c + dc\n            if 0 <= c < w:\n                out[r][c] = v\n\n    return out",
