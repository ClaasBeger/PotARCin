  "raw_response": "def solve(grid):\n    from collections import deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Work on a copy\n    out = [row[:] for row in grid]\n\n    # Find connected components of non-5 cells.\n    # Components touching the outer border are considered background and become 0.\n    vis = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 5 and not vis[r][c]:\n                q = deque([(r, c)])\n                vis[r][c] = True\n                cells = []\n                touches_border = False\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    if x == 0 or x == h - 1 or y == 0 or y == w - 1:\n                        touches_border = True\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and grid[nx][ny] != 5 and not vis[nx][ny]:\n                            vis[nx][ny] = True\n                            q.append((nx, ny))\n                if touches_border:\n                    for x, y in cells:\n                        out[x][y] = 0\n                else:\n                    comps.append(cells)\n\n    if not comps:\n        return out\n\n    # Order enclosed regions.\n    # For predominantly horizontal strips, sort top-to-bottom.\n    # Otherwise sort by top-left appearance.\n    bboxes = []\n    for cells in comps:\n        rs = [r for r, _ in cells]\n        cs = [c for _, c in cells]\n        bboxes.append((min(rs), max(rs), min(cs), max(cs)))\n\n    same_col_span = len({(mn_c, mx_c) for _, _, mn_c, mx_c in bboxes}) == 1\n    same_row_span = len({(mn_r, mx_r) for mn_r, mx_r, _, _ in bboxes}) == 1\n\n    if same_col_span and len(comps) == 3:\n        order = sorted(range(len(comps)), key=lambda i: (bboxes[i][0], bboxes[i][2]))\n        palette = [2, 4, 3]\n    elif same_row_span:\n        order = sorted(range(len(comps)), key=lambda i: (bboxes[i][2], bboxes[i][0]))\n        palette = [4, 3, 2]\n    else:\n        order = sorted(range(len(comps)), key=lambda i: (bboxes[i][0] + bboxes[i][2], bboxes[i][0], bboxes[i][2]))\n        palette = [4, 3, 2]\n\n    # Extend palette if needed\n    while len(palette) < len(comps):\n        palette.append(palette[-1])\n\n    # Fill enclosed regions\n    for k, idx in enumerate(order):\n        color = palette[k]\n        for r, c in comps[idx]:\n            out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    from collections import deque\n\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Work on a copy\n    out = [row[:] for row in grid]\n\n    # Find connected components of non-5 cells.\n    # Components touching the outer border are considered background and become 0.\n    vis = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 5 and not vis[r][c]:\n                q = deque([(r, c)])\n                vis[r][c] = True\n                cells = []\n                touches_border = False\n                while q:\n                    x, y = q.popleft()\n                    cells.append((x, y))\n                    if x == 0 or x == h - 1 or y == 0 or y == w - 1:\n                        touches_border = True\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and grid[nx][ny] != 5 and not vis[nx][ny]:\n                            vis[nx][ny] = True\n                            q.append((nx, ny))\n                if touches_border:\n                    for x, y in cells:\n                        out[x][y] = 0\n                else:\n                    comps.append(cells)\n\n    if not comps:\n        return out\n\n    # Order enclosed regions.\n    # For predominantly horizontal strips, sort top-to-bottom.\n    # Otherwise sort by top-left appearance.\n    bboxes = []\n    for cells in comps:\n        rs = [r for r, _ in cells]\n        cs = [c for _, c in cells]\n        bboxes.append((min(rs), max(rs), min(cs), max(cs)))\n\n    same_col_span = len({(mn_c, mx_c) for _, _, mn_c, mx_c in bboxes}) == 1\n    same_row_span = len({(mn_r, mx_r) for mn_r, mx_r, _, _ in bboxes}) == 1\n\n    if same_col_span and len(comps) == 3:\n        order = sorted(range(len(comps)), key=lambda i: (bboxes[i][0], bboxes[i][2]))\n        palette = [2, 4, 3]\n    elif same_row_span:\n        order = sorted(range(len(comps)), key=lambda i: (bboxes[i][2], bboxes[i][0]))\n        palette = [4, 3, 2]\n    else:\n        order = sorted(range(len(comps)), key=lambda i: (bboxes[i][0] + bboxes[i][2], bboxes[i][0], bboxes[i][2]))\n        palette = [4, 3, 2]\n\n    # Extend palette if needed\n    while len(palette) < len(comps):\n        palette.append(palette[-1])\n\n    # Fill enclosed regions\n    for k, idx in enumerate(order):\n        color = palette[k]\n        for r, c in comps[idx]:\n            out[r][c] = color\n\n    return out",
