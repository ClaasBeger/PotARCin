  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find vertical separator columns: columns filled with the same non-zero value.\n    sep_cols = []\n    for c in range(w):\n        col_vals = [grid[r][c] for r in range(h)]\n        v = col_vals[0]\n        if v != 0 and all(x == v for x in col_vals):\n            sep_cols.append(c)\n\n    # Group separator columns into contiguous runs.\n    sep_runs = []\n    if sep_cols:\n        start = prev = sep_cols[0]\n        for c in sep_cols[1:]:\n            if c == prev + 1:\n                prev = c\n            else:\n                sep_runs.append((start, prev))\n                start = prev = c\n        sep_runs.append((start, prev))\n\n    # Split grid into blocks between separator runs.\n    blocks = []\n    seps = []\n    cur = 0\n    for a, b in sep_runs:\n        blocks.append([row[cur:a] for row in grid])\n        seps.append([row[a:b + 1] for row in grid])\n        cur = b + 1\n    blocks.append([row[cur:w] for row in grid])\n\n    # Determine separator colors to ignore when scoring.\n    sep_values = set()\n    for a, b in sep_runs:\n        sep_values.add(grid[0][a])\n\n    def block_score(block):\n        vals = []\n        bw = len(block[0]) if block and block[0] else 0\n        for r in range(len(block)):\n            for c in range(bw):\n                v = block[r][c]\n                if v != 0 and v not in sep_values:\n                    vals.append(c + 1)  # local 1-based column index\n        if not vals:\n            return float(\"inf\")\n        return sum(vals) / len(vals)\n\n    # Stable sort blocks by average local column of colored cells.\n    indexed_blocks = list(enumerate(blocks))\n    indexed_blocks.sort(key=lambda x: (block_score(x[1]), x[0]))\n    sorted_blocks = [b for _, b in indexed_blocks]\n\n    # Reassemble with separators unchanged.\n    out = [[] for _ in range(h)]\n    for i, block in enumerate(sorted_blocks):\n        for r in range(h):\n            out[r].extend(block[r])\n        if i < len(seps):\n            for r in range(h):\n                out[r].extend(seps[i][r])\n\n    return out",
