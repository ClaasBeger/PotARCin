  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    out = [row[:] for row in grid]\n\n    # Clear the metadata rows.\n    for r in range(min(2, h)):\n        out[r] = [0] * w\n\n    color = grid[0][0]\n    seq = [color] + [grid[0][i] for i in range(3, w, 4)]\n\n    # Candidate value positions occur at the centers of the 3x3 tiles.\n    centers = [(r, c) for r in range(3, h, 4) for c in range(2, w, 4)]\n\n    positions_by_value = {}\n    for r, c in centers:\n        positions_by_value.setdefault(grid[r][c], []).append((r, c))\n\n    def aligned(a, b):\n        return a[0] == b[0] or a[1] == b[1]\n\n    # Find a path through occurrences of the sequence values.\n    path = None\n\n    def dfs(i, chosen):\n        nonlocal path\n        if path is not None:\n            return\n        if i == len(seq):\n            path = chosen[:]\n            return\n\n        val = seq[i]\n        candidates = positions_by_value.get(val, [])\n        if i == 0:\n            for p in candidates:\n                dfs(i + 1, chosen + [p])\n        else:\n            prev = chosen[-1]\n            for p in candidates:\n                if aligned(prev, p):\n                    dfs(i + 1, chosen + [p])\n\n    dfs(0, [])\n\n    if path is None:\n        return out\n\n    # Draw each segment, coloring from the source up to but not including the destination.\n    for (r1, c1), (r2, c2) in zip(path, path[1:]):\n        if r1 == r2:\n            step = 1 if c2 > c1 else -1\n            for c in range(c1, c2, step):\n                out[r1][c] = color\n        else:\n            step = 1 if r2 > r1 else -1\n            for r in range(r1, r2, step):\n                out[r][c1] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    out = [row[:] for row in grid]\n\n    # Clear the metadata rows.\n    for r in range(min(2, h)):\n        out[r] = [0] * w\n\n    color = grid[0][0]\n    seq = [color] + [grid[0][i] for i in range(3, w, 4)]\n\n    # Candidate value positions occur at the centers of the 3x3 tiles.\n    centers = [(r, c) for r in range(3, h, 4) for c in range(2, w, 4)]\n\n    positions_by_value = {}\n    for r, c in centers:\n        positions_by_value.setdefault(grid[r][c], []).append((r, c))\n\n    def aligned(a, b):\n        return a[0] == b[0] or a[1] == b[1]\n\n    # Find a path through occurrences of the sequence values.\n    path = None\n\n    def dfs(i, chosen):\n        nonlocal path\n        if path is not None:\n            return\n        if i == len(seq):\n            path = chosen[:]\n            return\n\n        val = seq[i]\n        candidates = positions_by_value.get(val, [])\n        if i == 0:\n            for p in candidates:\n                dfs(i + 1, chosen + [p])\n        else:\n            prev = chosen[-1]\n            for p in candidates:\n                if aligned(prev, p):\n                    dfs(i + 1, chosen + [p])\n\n    dfs(0, [])\n\n    if path is None:\n        return out\n\n    # Draw each segment, coloring from the source up to but not including the destination.\n    for (r1, c1), (r2, c2) in zip(path, path[1:]):\n        if r1 == r2:\n            step = 1 if c2 > c1 else -1\n            for c in range(c1, c2, step):\n                out[r1][c] = color\n        else:\n            step = 1 if r2 > r1 else -1\n            for r in range(r1, r2, step):\n                out[r][c1] = color\n\n    return out",
