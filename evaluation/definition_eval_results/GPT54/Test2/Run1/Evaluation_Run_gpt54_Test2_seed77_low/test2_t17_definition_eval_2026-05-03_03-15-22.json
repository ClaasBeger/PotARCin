hape, offset):\n        ch = len(subshape)\n        cw = len(subshape[0])\n        if cw != tw or offset < 0 or offset + ch > th:\n            return False\n        for i in range(ch):\n            for j in range(cw):\n                if subshape[i][j] != T[offset + i][j]:\n                    return False\n        return True\n\n    out = [[0] * w for _ in range(h)]\n    dy = th\n\n    for comp in comps:\n        ch, cw = comp[\"h\"], comp[\"w\"]\n        matched = False\n        match_offset = 0\n\n        if cw == tw:\n            for off in range(th - ch + 1):\n                if rows_match(comp[\"shape\"], off):\n                    matched = True\n                    match_offset = off\n                    break\n\n        if not matched:\n            # Fallback: treat component itself as the drawable shape\n            for x, y in comp[\"cells\"]:\n                nx = x + dy\n                if 0 <= nx < h:\n                    out[nx][y] = color\n            continue\n\n        orig_top = comp[\"r0\"] - match_offset\n        new_top = orig_top + dy\n        left = comp[\"c0\"]\n\n        for i in range(th):\n            for j in range(tw):\n                if T[i][j]:\n                    nr = new_top + i\n                    nc = left + j\n                    if 0 <= nr < h and 0 <= nc < w:\n                        out[nr][nc] = color\n\n    return out",
