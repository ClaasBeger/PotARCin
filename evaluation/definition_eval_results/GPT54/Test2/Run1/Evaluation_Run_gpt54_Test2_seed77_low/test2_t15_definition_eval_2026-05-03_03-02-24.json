  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    cr = h // 2\n    cc = w // 2\n\n    moves = []\n    for r in range(h):\n        for c in range(w):\n            val = grid[r][c]\n            if val == 0:\n                continue\n            dr = r - cr\n            dc = c - cc\n            nr = cr + dc\n            nc = cc - dr\n            if 0 <= nr < h and 0 <= nc < w and grid[nr][nc] == 0:\n                moves.append((r, c, nr, nc, val))\n\n    for r, c, nr, nc, val in moves:\n        out[r][c] = 0\n        out[nr][nc] = val\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    cr = h // 2\n    cc = w // 2\n\n    moves = []\n    for r in range(h):\n        for c in range(w):\n            val = grid[r][c]\n            if val == 0:\n                continue\n            dr = r - cr\n            dc = c - cc\n            nr = cr + dc\n            nc = cc - dr\n            if 0 <= nr < h and 0 <= nc < w and grid[nr][nc] == 0:\n                moves.append((r, c, nr, nc, val))\n\n    for r, c, nr, nc, val in moves:\n        out[r][c] = 0\n        out[nr][nc] = val\n\n    return out",
