  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [[0] * w for _ in range(h)]\n\n    nonzero_rows = sorted({r for r in range(h) for c in range(w) if grid[r][c] != 0})\n    nonzero_cols = sorted({c for r in range(h) for c in range(w) if grid[r][c] != 0})\n\n    if not nonzero_rows or not nonzero_cols:\n        return out\n\n    def largest_gap_split(vals):\n        best_i = None\n        best_gap = -1\n        for i in range(len(vals) - 1):\n            gap = vals[i + 1] - vals[i] - 1\n            if gap > best_gap:\n                best_gap = gap\n                best_i = i\n        if best_i is None:\n            return vals[-1], vals[0], 0\n        return vals[best_i], vals[best_i + 1], best_gap\n\n    top_end, bottom_start, vgap = largest_gap_split(nonzero_rows)\n    left_end, right_start, hgap = largest_gap_split(nonzero_cols)\n\n    vshift = vgap // 2\n    hshift = hgap // 2\n\n    for r in range(h):\n        for c in range(w):\n            val = grid[r][c]\n            if val == 0:\n                continue\n\n            if r <= top_end:\n                nr = r + vshift\n            else:\n                nr = r - vshift\n\n            if c <= left_end:\n                nc = c + hshift\n            else:\n                nc = c - hshift\n\n            out[nr][nc] = val\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [[0] * w for _ in range(h)]\n\n    nonzero_rows = sorted({r for r in range(h) for c in range(w) if grid[r][c] != 0})\n    nonzero_cols = sorted({c for r in range(h) for c in range(w) if grid[r][c] != 0})\n\n    if not nonzero_rows or not nonzero_cols:\n        return out\n\n    def largest_gap_split(vals):\n        best_i = None\n        best_gap = -1\n        for i in range(len(vals) - 1):\n            gap = vals[i + 1] - vals[i] - 1\n            if gap > best_gap:\n                best_gap = gap\n                best_i = i\n        if best_i is None:\n            return vals[-1], vals[0], 0\n        return vals[best_i], vals[best_i + 1], best_gap\n\n    top_end, bottom_start, vgap = largest_gap_split(nonzero_rows)\n    left_end, right_start, hgap = largest_gap_split(nonzero_cols)\n\n    vshift = vgap // 2\n    hshift = hgap // 2\n\n    for r in range(h):\n        for c in range(w):\n            val = grid[r][c]\n            if val == 0:\n                continue\n\n            if r <= top_end:\n                nr = r + vshift\n            else:\n                nr = r - vshift\n\n            if c <= left_end:\n                nc = c + hshift\n            else:\n                nc = c - hshift\n\n            out[nr][nc] = val\n\n    return out",
