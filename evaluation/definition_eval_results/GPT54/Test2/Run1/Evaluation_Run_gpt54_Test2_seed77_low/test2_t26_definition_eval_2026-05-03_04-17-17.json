  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n    if not eights:\n        return out\n\n    min_r = min(r for r, _ in eights)\n    max_r = max(r for r, _ in eights)\n    min_c = min(c for _, c in eights)\n    max_c = max(c for _, c in eights)\n\n    colored = []\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != 8:\n                colored.append((r, c, v))\n\n    for r, c, v in colored:\n        rr = min_r + max_r - r\n        cc = min_c + max_c - c\n        for nr, nc in ((r, c), (r, cc), (rr, c), (rr, cc)):\n            if 0 <= nr < h and 0 <= nc < w and out[nr][nc] != 8:\n                out[nr][nc] = v\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    eights = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n    if not eights:\n        return out\n\n    min_r = min(r for r, _ in eights)\n    max_r = max(r for r, _ in eights)\n    min_c = min(c for _, c in eights)\n    max_c = max(c for _, c in eights)\n\n    colored = []\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != 8:\n                colored.append((r, c, v))\n\n    for r, c, v in colored:\n        rr = min_r + max_r - r\n        cc = min_c + max_c - c\n        for nr, nc in ((r, c), (r, cc), (rr, c), (rr, cc)):\n            if 0 <= nr < h and 0 <= nc < w and out[nr][nc] != 8:\n                out[nr][nc] = v\n\n    return out",
