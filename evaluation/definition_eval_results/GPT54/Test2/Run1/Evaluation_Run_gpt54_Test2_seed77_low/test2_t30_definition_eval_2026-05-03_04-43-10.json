  "raw_response": "def solve(grid):\n    def is_sep(row):\n        return len(row) > 0 and all(v == 6 for v in row)\n\n    # Split into panels by separator rows\n    panels = []\n    cur = []\n    sep_width = None\n    for row in grid:\n        if is_sep(row):\n            sep_width = len(row)\n            panels.append(cur)\n            cur = []\n        else:\n            cur.append(row[:])\n    if cur:\n        panels.append(cur)\n\n    if not panels:\n        return grid\n\n    h = len(panels[0])\n    w = len(panels[0][0])\n\n    # Find drawing color (non 0, non 6)\n    colors = {}\n    for p in panels:\n        for row in p:\n            for v in row:\n                if v not in (0, 6):\n                    colors[v] = colors.get(v, 0) + 1\n    if not colors:\n        return grid\n    color = max(colors, key=colors.get)\n\n    def row_sig(panel, r):\n        return tuple(i for i, v in enumerate(panel[r]) if v == color)\n\n    def active_rows(panel):\n        return [r for r in range(h) if any(v == color for v in panel[r])]\n\n    # Detect the row-prefix growth pattern seen in the task:\n    # each later panel contains one more non-empty row, and the pattern\n    # for a given row is consistent across panels where it appears.\n    row_patterns = {}\n    known_counts = []\n    zero_idx = []\n\n    for i, p in enumerate(panels):\n        ars = active_rows(p)\n        if not ars:\n            zero_idx.append(i)\n        else:\n            known_counts.append((i, len(ars)))\n            for r in ars:\n                sig = row_sig(p, r)\n                if r not in row_patterns and sig:\n                    row_patterns[r] = sig\n\n    # Try to infer counts by panel index from known non-empty panels\n    count_by_idx = {}\n    for i, c in known_counts:\n        count_by_idx[i] = c\n\n    inferred = False\n    if known_counts:\n        # If counts are linear with panel index among known panels, use that.\n        if len(known_counts) >= 2:\n            i1, c1 = known_counts[0]\n            i2, c2 = known_counts[1]\n            di = i2 - i1\n            dc = c2 - c1\n            linear = di != 0 and all((c - c1) * di == (i - i1) * dc for i, c in known_counts)\n            if linear:\n                for i in range(len(panels)):\n                    if i not in count_by_idx:\n                        num = c1 * di + (i - i1) * dc\n                        if num % di == 0:\n                            count_by_idx[i] = num // di\n                inferred = True\n\n        if not inferred:\n            # Fallback: if non-empty counts are consecutive except for zero panels at start/end,\n            # extend by step 1.\n            known_counts_sorted = sorted(known_counts)\n            counts = [c for _, c in known_counts_sorted]\n            if len(counts) >= 2 and all(counts[i + 1] - counts[i] == 1 for i in range(len(counts) - 1)):\n                first_i, first_c = known_counts_sorted[0]\n                for i in range(len(panels)):\n                    if i not in count_by_idx:\n                        count_by_idx[i] = first_c + (i - first_i)\n                inferred = True\n\n    if inferred:\n        new_panels = []\n        for i, p in enumerate(panels):\n            ars = active_rows(p)\n            if ars:\n                new_panels.append(p)\n                continue\n            cnt = count_by_idx.get(i, 0)\n            if cnt <= 0:\n                new_panels.append(p)\n                continue\n            np = [[0] * w for _ in range(h)]\n            for r in range(min(cnt, h)):\n                sig = row_patterns.get(r, ())\n                for c in sig:\n                    np[r][c] = color\n            new_panels.append(np)\n        panels = new_panels\n\n    # Reassemble\n    out = []\n    for idx, p in enumerate(panels):\n        out.extend(p)\n        if idx != len(panels) - 1:\n            out.append([6] * (sep_width if sep_width is not None else w))\n    return out",
