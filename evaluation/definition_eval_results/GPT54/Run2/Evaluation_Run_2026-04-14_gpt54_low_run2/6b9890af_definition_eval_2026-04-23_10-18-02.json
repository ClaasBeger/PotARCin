  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find the rectangular frame made of color 2\n    frame_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    min_r = min(r for r, c in frame_cells)\n    max_r = max(r for r, c in frame_cells)\n    min_c = min(c for r, c in frame_cells)\n    max_c = max(c for r, c in frame_cells)\n\n    out_h = max_r - min_r + 1\n    out_w = max_c - min_c + 1\n    inner_h = out_h - 2\n    inner_w = out_w - 2\n\n    # Find the non-zero, non-2 pattern\n    pattern_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] not in (0, 2)]\n    pmin_r = min(r for r, c in pattern_cells)\n    pmax_r = max(r for r, c in pattern_cells)\n    pmin_c = min(c for r, c in pattern_cells)\n    pmax_c = max(c for r, c in pattern_cells)\n\n    pat_h = pmax_r - pmin_r + 1\n    pat_w = pmax_c - pmin_c + 1\n\n    pattern = [row[pmin_c:pmax_c + 1] for row in grid[pmin_r:pmax_r + 1]]\n\n    # Uniform scale factor\n    sr = inner_h // pat_h\n    sc = inner_w // pat_w\n    s = min(sr, sc)\n\n    # Build output with frame\n    out = [[0] * out_w for _ in range(out_h)]\n    for r in range(out_h):\n        for c in range(out_w):\n            if r == 0 or r == out_h - 1 or c == 0 or c == out_w - 1:\n                out[r][c] = 2\n\n    # Fill scaled pattern into the interior\n    for pr in range(pat_h):\n        for pc in range(pat_w):\n            val = pattern[pr][pc]\n            for dr in range(s):\n                for dc in range(s):\n                    out[1 + pr * s + dr][1 + pc * s + dc] = val\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find the rectangular frame made of color 2\n    frame_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 2]\n    min_r = min(r for r, c in frame_cells)\n    max_r = max(r for r, c in frame_cells)\n    min_c = min(c for r, c in frame_cells)\n    max_c = max(c for r, c in frame_cells)\n\n    out_h = max_r - min_r + 1\n    out_w = max_c - min_c + 1\n    inner_h = out_h - 2\n    inner_w = out_w - 2\n\n    # Find the non-zero, non-2 pattern\n    pattern_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] not in (0, 2)]\n    pmin_r = min(r for r, c in pattern_cells)\n    pmax_r = max(r for r, c in pattern_cells)\n    pmin_c = min(c for r, c in pattern_cells)\n    pmax_c = max(c for r, c in pattern_cells)\n\n    pat_h = pmax_r - pmin_r + 1\n    pat_w = pmax_c - pmin_c + 1\n\n    pattern = [row[pmin_c:pmax_c + 1] for row in grid[pmin_r:pmax_r + 1]]\n\n    # Uniform scale factor\n    sr = inner_h // pat_h\n    sc = inner_w // pat_w\n    s = min(sr, sc)\n\n    # Build output with frame\n    out = [[0] * out_w for _ in range(out_h)]\n    for r in range(out_h):\n        for c in range(out_w):\n            if r == 0 or r == out_h - 1 or c == 0 or c == out_w - 1:\n                out[r][c] = 2\n\n    # Fill scaled pattern into the interior\n    for pr in range(pat_h):\n        for pc in range(pat_w):\n            val = pattern[pr][pc]\n            for dr in range(s):\n                for dc in range(s):\n                    out[1 + pr * s + dr][1 + pc * s + dc] = val\n\n    return out",
