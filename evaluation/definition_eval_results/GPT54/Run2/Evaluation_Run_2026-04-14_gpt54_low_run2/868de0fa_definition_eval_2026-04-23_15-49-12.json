  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    visited = [[False] * w for _ in range(h)]\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 1 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            comp = []\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n                for dx, dy in dirs:\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 1:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            min_r = min(x for x, y in comp)\n            max_r = max(x for x, y in comp)\n            min_c = min(y for x, y in comp)\n            max_c = max(y for x, y in comp)\n\n            if max_r - min_r < 2 or max_c - min_c < 2:\n                continue\n\n            comp_set = set(comp)\n\n            is_frame = True\n\n            for rr in range(min_r, max_r + 1):\n                for cc in range(min_c, max_c + 1):\n                    on_border = rr == min_r or rr == max_r or cc == min_c or cc == max_c\n                    if on_border:\n                        if grid[rr][cc] != 1:\n                            is_frame = False\n                            break\n                    else:\n                        if (rr, cc) in comp_set:\n                            is_frame = False\n                            break\n                if not is_frame:\n                    break\n\n            if not is_frame:\n                continue\n\n            inner_h = max_r - min_r - 1\n            inner_w = max_c - min_c - 1\n            color = 7 if (inner_h % 2 == 1 and inner_w % 2 == 1) else 2\n\n            for rr in range(min_r + 1, max_r):\n                for cc in range(min_c + 1, max_c):\n                    if out[rr][cc] == 0:\n                        out[rr][cc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    visited = [[False] * w for _ in range(h)]\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 1 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            comp = []\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n                for dx, dy in dirs:\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 1:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            min_r = min(x for x, y in comp)\n            max_r = max(x for x, y in comp)\n            min_c = min(y for x, y in comp)\n            max_c = max(y for x, y in comp)\n\n            if max_r - min_r < 2 or max_c - min_c < 2:\n                continue\n\n            comp_set = set(comp)\n\n            is_frame = True\n\n            for rr in range(min_r, max_r + 1):\n                for cc in range(min_c, max_c + 1):\n                    on_border = rr == min_r or rr == max_r or cc == min_c or cc == max_c\n                    if on_border:\n                        if grid[rr][cc] != 1:\n                            is_frame = False\n                            break\n                    else:\n                        if (rr, cc) in comp_set:\n                            is_frame = False\n                            break\n                if not is_frame:\n                    break\n\n            if not is_frame:\n                continue\n\n            inner_h = max_r - min_r - 1\n            inner_w = max_c - min_c - 1\n            color = 7 if (inner_h % 2 == 1 and inner_w % 2 == 1) else 2\n\n            for rr in range(min_r + 1, max_r):\n                for cc in range(min_c + 1, max_c):\n                    if out[rr][cc] == 0:\n                        out[rr][cc] = color\n\n    return out",
