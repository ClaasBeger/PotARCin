  "raw_response": "def solve(grid):\n    out = [row[:] for row in grid]\n    for r, row in enumerate(grid):\n        nonzeros = [(c, v) for c, v in enumerate(row) if v != 0]\n        for c, v in nonzeros:\n            for j in range(c, len(row)):\n                out[r][j] = v if (j - c) % 2 == 0 else 5\n    return out",
