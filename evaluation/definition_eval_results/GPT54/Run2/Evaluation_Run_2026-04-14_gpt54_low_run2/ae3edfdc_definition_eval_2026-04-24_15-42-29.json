  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    marker_for_anchor = {1: 7, 2: 3}\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    anchors = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] in marker_for_anchor:\n                anchors.append((r, c, grid[r][c]))\n\n    for r, c, a in anchors:\n        out[r][c] = a\n        marker = marker_for_anchor[a]\n\n        for dr, dc in directions:\n            rr, cc = r + dr, c + dc\n            found = False\n            while 0 <= rr < h and 0 <= cc < w:\n                if grid[rr][cc] == marker:\n                    found = True\n                    break\n                rr += dr\n                cc += dc\n\n            nr, nc = r + dr, c + dc\n            if found and 0 <= nr < h and 0 <= nc < w:\n                out[nr][nc] = marker\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    marker_for_anchor = {1: 7, 2: 3}\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    anchors = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] in marker_for_anchor:\n                anchors.append((r, c, grid[r][c]))\n\n    for r, c, a in anchors:\n        out[r][c] = a\n        marker = marker_for_anchor[a]\n\n        for dr, dc in directions:\n            rr, cc = r + dr, c + dc\n            found = False\n            while 0 <= rr < h and 0 <= cc < w:\n                if grid[rr][cc] == marker:\n                    found = True\n                    break\n                rr += dr\n                cc += dc\n\n            nr, nc = r + dr, c + dc\n            if found and 0 <= nr < h and 0 <= nc < w:\n                out[nr][nc] = marker\n\n    return out",
