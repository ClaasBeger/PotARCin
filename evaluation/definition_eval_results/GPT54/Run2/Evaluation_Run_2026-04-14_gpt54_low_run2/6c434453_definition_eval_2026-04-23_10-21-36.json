  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    rings = []\n\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            if grid[r][c] != 0:\n                continue\n            ok = True\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    if grid[r + dr][c + dc] != 1:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                rings.append((r, c))\n\n    for r, c in rings:\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                out[r + dr][c + dc] = 0\n        out[r - 1][c] = 2\n        out[r][c - 1] = 2\n        out[r][c] = 2\n        out[r][c + 1] = 2\n        out[r + 1][c] = 2\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    rings = []\n\n    for r in range(1, h - 1):\n        for c in range(1, w - 1):\n            if grid[r][c] != 0:\n                continue\n            ok = True\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    if dr == 0 and dc == 0:\n                        continue\n                    if grid[r + dr][c + dc] != 1:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                rings.append((r, c))\n\n    for r, c in rings:\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                out[r + dr][c + dc] = 0\n        out[r - 1][c] = 2\n        out[r][c - 1] = 2\n        out[r][c] = 2\n        out[r][c + 1] = 2\n        out[r + 1][c] = 2\n\n    return out",
