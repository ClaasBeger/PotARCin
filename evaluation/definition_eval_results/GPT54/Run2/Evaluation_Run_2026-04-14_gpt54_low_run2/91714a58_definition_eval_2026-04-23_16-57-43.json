  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n else 0\n\n    best_area = 0\n    best = None  # (top, left, bottom, right, color)\n\n    colors = set()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                colors.add(v)\n\n    for color in colors:\n        for top in range(n):\n            valid_cols = [True] * m\n            for bottom in range(top, n):\n                for col in range(m):\n                    if valid_cols[col] and grid[bottom][col] != color:\n                        valid_cols[col] = False\n\n                col = 0\n                while col < m:\n                    if not valid_cols[col]:\n                        col += 1\n                        continue\n                    start = col\n                    while col < m and valid_cols[col]:\n                        col += 1\n                    end = col - 1\n                    area = (bottom - top + 1) * (end - start + 1)\n                    if area > best_area:\n                        best_area = area\n                        best = (top, start, bottom, end, color)\n\n    out = [[0] * m for _ in range(n)]\n    if best is not None:\n        top, left, bottom, right, color = best\n        for r in range(top, bottom + 1):\n            for c in range(left, right + 1):\n                out[r][c] = color\n    return out",
  "script": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n else 0\n\n    best_area = 0\n    best = None  # (top, left, bottom, right, color)\n\n    colors = set()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                colors.add(v)\n\n    for color in colors:\n        for top in range(n):\n            valid_cols = [True] * m\n            for bottom in range(top, n):\n                for col in range(m):\n                    if valid_cols[col] and grid[bottom][col] != color:\n                        valid_cols[col] = False\n\n                col = 0\n                while col < m:\n                    if not valid_cols[col]:\n                        col += 1\n                        continue\n                    start = col\n                    while col < m and valid_cols[col]:\n                        col += 1\n                    end = col - 1\n                    area = (bottom - top + 1) * (end - start + 1)\n                    if area > best_area:\n                        best_area = area\n                        best = (top, start, bottom, end, color)\n\n    out = [[0] * m for _ in range(n)]\n    if best is not None:\n        top, left, bottom, right, color = best\n        for r in range(top, bottom + 1):\n            for c in range(left, right + 1):\n                out[r][c] = color\n    return out",
