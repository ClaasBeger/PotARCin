  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0])\n\n    def is_frame(top, left, h, w, color):\n        if h < 3 or w < 3:\n            return False\n        # border must be color\n        for c in range(left, left + w):\n            if grid[top][c] != color or grid[top + h - 1][c] != color:\n                return False\n        for r in range(top, top + h):\n            if grid[r][left] != color or grid[r][left + w - 1] != color:\n                return False\n        # interior must be 0\n        for r in range(top + 1, top + h - 1):\n            for c in range(left + 1, left + w - 1):\n                if grid[r][c] != 0:\n                    return False\n        return True\n\n    # Find the largest hollow rectangle frame already present.\n    best = None  # (area, top, left, h, w, color)\n    colors = sorted({v for row in grid for v in row if v != 0})\n    for color in colors:\n        for top in range(n):\n            for left in range(m):\n                if grid[top][left] != color:\n                    continue\n                for h in range(3, n - top + 1):\n                    for w in range(3, m - left + 1):\n                        area = h * w\n                        if best is not None and area <= best[0]:\n                            continue\n                        if is_frame(top, left, h, w, color):\n                            best = (area, top, left, h, w, color)\n\n    if best is None:\n        return [row[:] for row in grid]\n\n    _, src_top, src_left, h, w, color = best\n    ih, iw = h - 2, w - 2\n\n    # Find another location with the same zero interior size.\n    # Prefer one whose border is not already the frame color.\n    target = None\n    for top in range(n - h + 1):\n        for left in range(m - w + 1):\n            if top == src_top and left == src_left:\n                continue\n\n            ok = True\n            for r in range(top + 1, top + h - 1):\n                for c in range(left + 1, left