st[3], best[4])\n                            if bg_cnt > best_bg_cnt:\n                                best = candidate\n\n    if best is None:\n        return grid\n\n    _, r1, c1, r2, c2, bg, fg = best\n    h = r2 - r1\n    w = c2 - c1\n\n    fg_rows = set()\n    fg_cols = set()\n    for i in range(h):\n        for j in range(w):\n            if grid[r1 + i][c1 + j] == fg:\n                fg_rows.add(i)\n                fg_cols.add(j)\n\n    out = []\n    for i in range(h):\n        row = []\n        for j in range(w):\n            if i in fg_rows or j in fg_cols:\n                row.append(fg)\n            else:\n                row.append(bg)\n        out.append(row)\n\n    return out",
  "script": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n else 0\n\n    # Prefix sums for digits 0..9\n    pref = [[[0] * (m + 1) for _ in range(n + 1)] for _ in range(10)]\n    for d in range(10):\n        for i in range(n):\n            row_acc = 0\n            for j in range(m):\n                row_acc += 1 if grid[i][j] == d else 0\n                pref[d][i + 1][j + 1] = pref[d][i][j + 1] + row_acc\n\n    def count_digit(d, r1, c1, r2, c2):\n        return (\n            pref[d][r2][c2]\n            - pref[d][r1][c2]\n            - pref[d][r2][c1]\n            + pref[d][r1][c1]\n        )\n\n    best = None  # (area, r1, c1, r2, c2, bg, fg)\n\n    for r1 in range(n):\n        for r2 in range(r1 + 1, n + 1):\n            for c1 in range(m):\n                for c2 in range(c1 + 1, m + 1):\n                    area = (r2 - r1) * (c2 - c1)\n                    if best is not None and area < best[0]:\n                        continue\n\n                    counts = []\n                    for d in range(10):\n                        cnt = count_digit(d, r1, c1, r2, c2)\n                        if cnt:\n                            counts.append((cnt, d))\n\n                    if len(counts) != 2:\n                        continue\n\n                    counts.sort(reverse=True)\n                    bg_cnt, bg = counts[0]\n                    fg_cnt, fg = counts[1]\n\n                    if fg_cnt == 0 or bg_cnt <= fg_cnt:\n                        continue\n\n                    candidate = (area, r1, c1, r2, c2, bg, fg)\n\n                    if best is None:\n                        best = candidate\n                    else:\n                        # Prefer larger area, then stronger background dominance\n                        if candidate[0] > best[0]:\n                            best = candidate\n                        elif candidate[0] == best[0]:\n                            best_bg_cnt = count_digit(best[5], best[1], best[2], best[3], best[4])\n                            if bg_cnt > best_bg_cnt:\n                                best = candidate\n\n    if best is None:\n        return grid\n\n    _, r1, c1, r2, c2, bg, fg = best\n    h = r2 - r1\n    w = c2 - c1\n\n    fg_rows = set()\n    fg_cols = set()\n    for i in range(h):\n        for j in range(w):\n            if grid[r1 + i][c1 + j] == fg:\n                fg_rows.add(i)\n                fg_cols.add(j)\n\n    out = []\n    for i in range(h):\n        row = []\n        for j in range(w):\n            if i in fg_rows or j in fg_cols:\n                row.append(fg)\n            else:\n                row.append(bg)\n        out.append(row)\n\n    return out",
