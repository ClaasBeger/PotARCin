  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def all_zero_row(r):\n        return all(v == 0 for v in grid[r])\n\n    def all_zero_col(c):\n        return all(grid[r][c] == 0 for r in range(h))\n\n    def get_bands(is_zero, n):\n        bands = []\n        i = 0\n        while i < n:\n            while i < n and is_zero(i):\n                i += 1\n            if i >= n:\n                break\n            j = i\n            while j < n and not is_zero(j):\n                j += 1\n            bands.append((i, j))\n            i = j\n        return bands\n\n    row_bands = get_bands(all_zero_row, h)\n    col_bands = get_bands(all_zero_col, w)\n\n    blocks = []\n    color_counts = {}\n\n    for r0, r1 in row_bands:\n        for c0, c1 in col_bands:\n            sub = [row[c0:c1] for row in grid[r0:r1]]\n            colors = {v for row in sub for v in row if v != 0}\n            if not colors:\n                continue\n            if len(colors) == 1:\n                color = next(iter(colors))\n                blocks.append((color, sub))\n                color_counts[color] = color_counts.get(color, 0) + 1\n\n    for color, sub in blocks:\n        if color_counts.get(color, 0) == 1:\n            return sub\n\n    return grid",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def all_zero_row(r):\n        return all(v == 0 for v in grid[r])\n\n    def all_zero_col(c):\n        return all(grid[r][c] == 0 for r in range(h))\n\n    def get_bands(is_zero, n):\n        bands = []\n        i = 0\n        while i < n:\n            while i < n and is_zero(i):\n                i += 1\n            if i >= n:\n                break\n            j = i\n            while j < n and not is_zero(j):\n                j += 1\n            bands.append((i, j))\n            i = j\n        return bands\n\n    row_bands = get_bands(all_zero_row, h)\n    col_bands = get_bands(all_zero_col, w)\n\n    blocks = []\n    color_counts = {}\n\n    for r0, r1 in row_bands:\n        for c0, c1 in col_bands:\n            sub = [row[c0:c1] for row in grid[r0:r1]]\n            colors = {v for row in sub for v in row if v != 0}\n            if not colors:\n                continue\n            if len(colors) == 1:\n                color = next(iter(colors))\n                blocks.append((color, sub))\n                color_counts[color] = color_counts.get(color, 0) + 1\n\n    for color, sub in blocks:\n        if color_counts.get(color, 0) == 1:\n            return sub\n\n    return grid",
