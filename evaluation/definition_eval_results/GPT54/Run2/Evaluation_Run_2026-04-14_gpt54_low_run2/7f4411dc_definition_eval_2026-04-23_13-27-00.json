  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = set()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                colors.add(v)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for color in colors:\n        rects = []\n\n        # Find all solid rectangles of this color with height >= 2 and width >= 2\n        for r1 in range(h):\n            for c1 in range(w):\n                if grid[r1][c1] != color:\n                    continue\n                for r2 in range(r1 + 1, h):\n                    for c2 in range(c1 + 1, w):\n                        ok = True\n                        for r in range(r1, r2 + 1):\n                            for c in range(c1, c2 + 1):\n                                if grid[r][c] != color:\n                                    ok = False\n                                    break\n                            if not ok:\n                                break\n                        if ok:\n                            rects.append((r1, c1, r2, c2))\n\n        # Keep only rectangles not strictly contained in another solid rectangle\n        maximal_rects = []\n        for i, a in enumerate(rects):\n            r1, c1, r2, c2 = a\n            contained = False\n            for j, b in enumerate(rects):\n                if i == j:\n                    continue\n                rr1, cc1, rr2, cc2 = b\n                if rr1 <= r1 and cc1 <= c1 and rr2 >= r2 and cc2 >= c2:\n                    if (rr1, cc1, rr2, cc2) != (r1, c1, r2, c2):\n                        contained = True\n                        break\n            if not contained:\n                maximal_rects.append(a)\n\n        # Paint the union of maximal rectangles\n        for r1, c1, r2, c2 in maximal_rects:\n            for r in range(r1, r2 + 1):\n                for c in range(c1, c2 + 1):\n                    out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = set()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                colors.add(v)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for color in colors:\n        rects = []\n\n        # Find all solid rectangles of this color with height >= 2 and width >= 2\n        for r1 in range(h):\n            for c1 in range(w):\n                if grid[r1][c1] != color:\n                    continue\n                for r2 in range(r1 + 1, h):\n                    for c2 in range(c1 + 1, w):\n                        ok = True\n                        for r in range(r1, r2 + 1):\n                            for c in range(c1, c2 + 1):\n                                if grid[r][c] != color:\n                                    ok = False\n                                    break\n                            if not ok:\n                                break\n                        if ok:\n                            rects.append((r1, c1, r2, c2))\n\n        # Keep only rectangles not strictly contained in another solid rectangle\n        maximal_rects = []\n        for i, a in enumerate(rects):\n            r1, c1, r2, c2 = a\n            contained = False\n            for j, b in enumerate(rects):\n                if i == j:\n                    continue\n                rr1, cc1, rr2, cc2 = b\n                if rr1 <= r1 and cc1 <= c1 and rr2 >= r2 and cc2 >= c2:\n                    if (rr1, cc1, rr2, cc2) != (r1, c1, r2, c2):\n                        contained = True\n                        break\n            if not contained:\n                maximal_rects.append(a)\n\n        # Paint the union of maximal rectangles\n        for r1, c1, r2, c2 in maximal_rects:\n            for r in range(r1, r2 + 1):\n                for c in range(c1, c2 + 1):\n                    out[r][c] = color\n\n    return out",
