text or markdown.",
  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    components = 0\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 8 and not visited[r][c]:\n                components += 1\n                stack = [(r, c)]\n                visited[r][c] = True\n\n                while stack:\n                    x, y = stack.pop()\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 8:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n    out = [[0] * components for _ in range(components)]\n    for i in range(components):\n        out[i][i] = 8\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    components = 0\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 8 and not visited[r][c]:\n                components += 1\n                stack = [(r, c)]\n                visited[r][c] = True\n\n                while stack:\n                    x, y = stack.pop()\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 8:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n    out = [[0] * components for _ in range(components)]\n    for i in range(components):\n        out[i][i] = 8\n    return out",
