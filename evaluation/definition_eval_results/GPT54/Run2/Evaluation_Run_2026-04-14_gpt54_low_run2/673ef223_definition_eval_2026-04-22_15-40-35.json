  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find connected components of color 2\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 2:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n                comps.append(cells)\n\n    bars = []\n    for cells in comps:\n        rows = [r for r, _ in cells]\n        cols = [c for _, c in cells]\n        # Expect vertical bars\n        bar = {\n            \"col\": cols[0],\n            \"top\": min(rows),\n            \"bottom\": max(rows),\n            \"cells\": set(cells),\n        }\n        bars.append(bar)\n\n    if len(bars) != 2:\n        return out\n\n    bars.sort(key=lambda b: b[\"col\"])\n    left_bar, right_bar = bars\n\n    def draw_from_bar_to_eight(bar, r, c8):\n        if bar[\"col\"] < c8:\n            for c in range(bar[\"col\"] + 1, c8):\n                out[r][c] = 8\n            out[r][c8] = 4\n        elif bar[\"col\"] > c8:\n            for c in range(c8 + 1, bar[\"col\"]):\n                out[r][c] = 8\n            out[r][c8] = 4\n\n    def draw_full_row_to_bar(bar, r):\n        if bar[\"col\"] == 0:\n            for c in range(1, w):\n                if out[r][c] != 2:\n                    out[r][c] = 8\n        elif bar[\"col\"] == w - 1:\n            for c in range(0, w - 1):\n                if out[r][c] != 2:\n                    out[r][c] = 8\n        else:\n            for c in range(w):\n                if c != bar[\"col\"] and out[r][c] != 2:\n                    out[r][c] = 8\n\n    # Process 8s associated with each bar region and transfer row-pattern to the other bar\n    for src_bar, dst_bar in ((left_bar, right_bar), (right_bar, left_bar)):\n        for r in range(src_bar[\"top\"], src_bar[\"bottom\"] + 1):\n            eights = [c for c in range(w) if grid[r][c] == 8]\n            for c8 in eights:\n                draw_from_bar_to_eight(src_bar, r, c8)\n                rr = dst_bar[\"top\"] + (r - src_bar[\"top\"])\n                if 0 <= rr < h:\n                    draw_full_row_to_bar(dst_bar, rr)\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    # Find connected components of color 2\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 2 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == 2:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n                comps.append(cells)\n\n    bars = []\n    for cells in comps:\n        rows = [r for r, _ in cells]\n        cols = [c for _, c in cells]\n        # Expect vertical bars\n        bar = {\n            \"col\": cols[0],\n            \"top\": min(rows),\n            \"bottom\": max(rows),\n            \"cells\": set(cells),\n        }\n        bars.append(bar)\n\n    if len(bars) != 2:\n        return out\n\n    bars.sort(key=lambda b: b[\"col\"])\n    left_bar, right_bar = bars\n\n    def draw_from_bar_to_eight(bar, r, c8):\n        if bar[\"col\"] < c8:\n            for c in range(bar[\"col\"] + 1, c8):\n                out[r][c] = 8\n            out[r][c8] = 4\n        elif bar[\"col\"] > c8:\n            for c in range(c8 + 1, bar[\"col\"]):\n                out[r][c] = 8\n            out[r][c8] = 4\n\n    def draw_full_row_to_bar(bar, r):\n        if bar[\"col\"] == 0:\n            for c in range(1, w):\n                if out[r][c] != 2:\n                    out[r][c] = 8\n        elif bar[\"col\"] == w - 1:\n            for c in range(0, w - 1):\n                if out[r][c] != 2:\n                    out[r][c] = 8\n        else:\n            for c in range(w):\n                if c != bar[\"col\"] and out[r][c] != 2:\n                    out[r][c] = 8\n\n    # Process 8s associated with each bar region and transfer row-pattern to the other bar\n    for src_bar, dst_bar in ((left_bar, right_bar), (right_bar, left_bar)):\n        for r in range(src_bar[\"top\"], src_bar[\"bottom\"] + 1):\n            eights = [c for c in range(w) if grid[r][c] == 8]\n            for c8 in eights:\n                draw_from_bar_to_eight(src_bar, r, c8)\n                rr = dst_bar[\"top\"] + (r - src_bar[\"top\"])\n                if 0 <= rr < h:\n                    draw_full_row_to_bar(dst_bar, rr)\n\n    return out",
