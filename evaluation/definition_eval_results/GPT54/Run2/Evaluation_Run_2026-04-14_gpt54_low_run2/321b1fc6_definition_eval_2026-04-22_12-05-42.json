  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                yield nr, nc\n\n    # Find all connected components of non-zero cells.\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                colors = set()\n                while stack:\n                    cr, cc = stack.pop()\n                    cells.append((cr, cc))\n                    colors.add(grid[cr][cc])\n                    for nr, nc in neighbors(cr, cc):\n                        if grid[nr][nc] != 0 and not visited[nr][nc]:\n                            visited[nr][nc] = True\n                            stack.append((nr, nc))\n                components.append((cells, colors))\n\n    # The template is the unique component containing colors other than 8.\n    template_cells = None\n    for cells, colors in components:\n        if any(v != 8 for v in colors):\n            template_cells = cells\n            break\n\n    if template_cells is None:\n        return [row[:] for row in grid]\n\n    # Build template relative pattern with colors.\n    min_r = min(r for r, c in template_cells)\n    min_c = min(c for r, c in template_cells)\n    template = {}\n    for r, c in template_cells:\n        template[(r - min_r, c - min_c)] = grid[r][c]\n\n    template_shape = set(template.keys())\n\n    # Start with empty grid.\n    out = [[0] * w for _ in range(h)]\n\n    # Replace every pure-8 component having the same shape with the template colors.\n    for cells, colors in components:\n        if colors == {8}:\n            cmin_r = min(r for r, c in cells)\n            cmin_c = min(c for r, c in cells)\n            shape = {(r - cmin_r, c - cmin_c) for r, c in cells}\n            if shape == template_shape:\n                for (dr, dc), val in template.items():\n                    out[cmin_r + dr][cmin_c + dc] = val\n\n    return out",
