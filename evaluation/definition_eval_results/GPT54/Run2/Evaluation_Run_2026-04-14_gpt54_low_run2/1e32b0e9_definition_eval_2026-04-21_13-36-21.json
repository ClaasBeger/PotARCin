  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Find separator color: a nonzero color that forms at least one full row and one full column\n    row_full_colors = {}\n    for r in range(h):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            c = grid[r][0]\n            if c != 0:\n                row_full_colors[c] = row_full_colors.get(c, 0) + 1\n\n    col_full_colors = {}\n    for c in range(w):\n        vals = {grid[r][c] for r in range(h)}\n        if len(vals) == 1:\n            v = grid[0][c]\n            if v != 0:\n                col_full_colors[v] = col_full_colors.get(v, 0) + 1\n\n    sep_color = None\n    for c in row_full_colors:\n        if c in col_full_colors:\n            sep_color = c\n            break\n\n    # Separator rows/cols\n    sep_rows = [r for r in range(h) if all(grid[r][c] == sep_color for c in range(w))]\n    sep_cols = [c for c in range(w) if all(grid[r][c] == sep_color for r in range(h))]\n\n    # Non-separator row/col segments\n    row_segments = []\n    start = 0\n    for r in sep_rows + [h]:\n        if start < r:\n            row_segments.append((start, r))\n        start = r + 1\n\n    col_segments = []\n    start = 0\n    for c in sep_cols + [w]:\n        if start < c:\n            col_segments.append((start, c))\n        start = c + 1\n\n    cell_h = row_segments[0][1] - row_segments[0][0]\n    cell_w = col_segments[0][1] - col_segments[0][0]\n\n    # Find the non-separator, non-zero object color\n    obj_color = None\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0 and v != sep_color:\n                obj_color = v\n                break\n        if obj_color is not None:\n            break\n\n    # Build template as union of object-colored cells across all subgrids\n    template = [[False] * cell_w for _ in range(cell_h)]\n    for rs, re in row_segments:\n        for cs, ce in col_segments:\n            for i in range(cell_h):\n                for j in range(cell_w):\n                    if grid[rs + i][cs + j] == obj_color:\n                        template[i][j] = True\n\n    # Apply template to every subgrid:\n    # keep object cells, fill template holes with separator color\n    out = [row[:] for row in grid]\n    for rs, re in row_segments:\n        for cs, ce in col_segments:\n            for i in range(cell_h):\n                for j in range(cell_w):\n                    if template[i][j] and out[rs + i][cs + j] == 0:\n                        out[rs + i][cs + j] = sep_color\n\n    return out",
