_h):\n                for j in range(cell_w):\n                    if grid[rs + i][cs + j] == obj_color:\n                        template[i][j] = True\n\n    # Apply template to every subgrid:\n    # keep object cells, fill template holes with separator color\n    out = [row[:] for row in grid]\n    for rs, re in row_segments:\n        for cs, ce in col_segments:\n            for i in range(cell_h):\n                for j in range(cell_w):\n                    if template[i][j] and out[rs + i][cs + j] == 0:\n                        out[rs + i][cs + j] = sep_color\n\n    return out",
