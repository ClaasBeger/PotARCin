  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    one_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 1]\n\n    col_counts = [0] * w\n    for r, c in one_cells:\n        col_counts[c] += 1\n\n    max_count = max(col_counts) if col_counts else 0\n\n    if max_count >= h - 1:\n        axis = col_counts.index(max_count)\n        for r, c in one_cells:\n            mc = 2 * axis - c\n            if 0 <= mc < w and out[r][mc] == 0:\n                out[r][mc] = 2\n    else:\n        for r, c in one_cells:\n            rr = h - 1 - r\n            cc = w - 1 - c\n            if 0 <= rr < h and 0 <= cc < w and out[rr][cc] == 0:\n                out[rr][cc] = 2\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    one_cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 1]\n\n    col_counts = [0] * w\n    for r, c in one_cells:\n        col_counts[c] += 1\n\n    max_count = max(col_counts) if col_counts else 0\n\n    if max_count >= h - 1:\n        axis = col_counts.index(max_count)\n        for r, c in one_cells:\n            mc = 2 * axis - c\n            if 0 <= mc < w and out[r][mc] == 0:\n                out[r][mc] = 2\n    else:\n        for r, c in one_cells:\n            rr = h - 1 - r\n            cc = w - 1 - c\n            if 0 <= rr < h and 0 <= cc < w and out[rr][cc] == 0:\n                out[rr][cc] = 2\n\n    return out",
