n            br = 2\n        else:\n            br = min(a[\"row\"], b[\"row\"])\n\n        # Paint left endpoint on bridge row.\n        if out[br][lcol] == 0:\n            out[br][lcol] = a[\"color\"]\n\n        # Paint remainder toward the right component with right color.\n        for cc in range(lcol + 1, rcol + 1):\n            out[br][cc] = b[\"color\"]\n\n    return out",
