  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find colors that form a complete row or column\n    row_lines = {}  # color -> set(rows)\n    col_lines = {}  # color -> set(cols)\n\n    for r in range(h):\n        color = grid[r][0]\n        if color != 0 and all(grid[r][c] == color for c in range(w)):\n            row_lines.setdefault(color, set()).add(r)\n\n    for c in range(w):\n        color = grid[0][c]\n        if color != 0 and all(grid[r][c] == color for r in range(h)):\n            col_lines.setdefault(color, set()).add(c)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Preserve the complete lines\n    for color, rows in row_lines.items():\n        for r in rows:\n            for c in range(w):\n                out[r][c] = color\n\n    for color, cols in col_lines.items():\n        for c in cols:\n            for r in range(h):\n                out[r][c] = color\n\n    # Project scattered cells of a line-color to the cell adjacent to its line\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0:\n                continue\n\n            if color in row_lines:\n                # Ignore cells already on a full row of that color\n                if r in row_lines[color]:\n                    continue\n                # Use the nearest full row; place adjacent on the same side\n                target_row = min(row_lines[color], key=lambda rr: abs(rr - r))\n                if r < target_row:\n                    pr = target_row - 1\n                else:\n                    pr = target_row + 1\n                if 0 <= pr < h:\n                    out[pr][c] = color\n\n            elif color in col_lines:\n                # Ignore cells already on a full column of that color\n                if c in col_lines[color]:\n                    continue\n                # Use the nearest full column; place adjacent on the same side\n              