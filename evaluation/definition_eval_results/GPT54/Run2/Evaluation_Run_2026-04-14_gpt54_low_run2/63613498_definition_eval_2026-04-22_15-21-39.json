  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                components.append({\"color\": color, \"cells\": cells})\n\n    def normalize(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        return tuple(sorted((r - min_r, c - min_c) for r, c in cells))\n\n    def comp_distance(a_cells, b_cells):\n        best = float(\"inf\")\n        for r1, c1 in a_cells:\n            for r2, c2 in b_cells:\n                d = abs(r1 - r2) + abs(c1 - c2)\n                if d < best:\n                    best = d\n        return best\n\n    five_comp = None\n    others = []\n    for comp in components:\n        if comp[\"color\"] == 5:\n            five_comp = comp\n        else:\n            comp[\"shape\"] = normalize(comp[\"cells\"])\n            others.append(comp)\n\n    shape_groups = {}\n    for comp in others:\n        shape_groups.setdefault(comp[\"shape\"], []).append(comp)\n\n    target = None\n    for group in shape_groups.values():\n        if len(group) >= 2:\n            if five_comp is None:\n                target = group[-1]\n            else:\n                target = max(group, key=lambda comp: comp_distance(comp[\"cells