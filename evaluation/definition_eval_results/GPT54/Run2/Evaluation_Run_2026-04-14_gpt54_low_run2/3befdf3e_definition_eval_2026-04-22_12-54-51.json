  "raw_response": "def solve(grid):\n    from collections import deque, Counter\n\n    R, C = len(grid), len(grid[0])\n    out = [[0 for _ in range(C)] for _ in range(R)]\n    visited = [[False for _ in range(C)] for _ in range(R)]\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < R and 0 <= nc < C:\n                yield nr, nc\n\n    components = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0 and not visited[r][c]:\n                q = deque([(r, c)])\n                visited[r][c] = True\n                cells = []\n                while q:\n                    cr, cc = q.popleft()\n                    cells.append((cr, cc))\n                    for nr, nc in neighbors(cr, cc):\n                        if grid[nr][nc] != 0 and not visited[nr][nc]:\n                            visited[nr][nc] = True\n                            q.append((nr, nc))\n                components.append(cells)\n\n    for cells in components:\n        rs = [r for r, _ in cells]\n        cs = [c for _, c in cells]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        H, W = r1 - r0 + 1, c1 - c0 + 1\n\n        color_counts = Counter(grid[r][c] for r, c in cells)\n        colors = list(color_counts.keys())\n        if len(colors) != 2:\n            for r, c in cells:\n                out[r][c] = grid[r][c]\n            continue\n\n        border_cells = []\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                if r == r0 or r == r1 or c == c0 or c == c1:\n                    border_cells.append(grid[r][c])\n\n        border_count = Counter(v for v in border_cells if v != 0)\n        outer = border_count.most_common(1)[0][0]\n        inner = colors[0] if colors[1] == outer else colors[1]\n\n        inner_cells = [(r, c) for r, c in cells if grid[r][c] == inner]\n        ir0 = min(r for r, _ in inner_cells)\n        ir1 = max(r for r, _ in inner_cells)\n        ic0 = min(c for _, c in inner_cells)\n        ic1 = max(c for _, c in inner_cells)\n        h = ir1 - ir0 + 1\n        w = ic1 - ic0 + 1\n\n        nr0, nc0 = r0 - h, c0 - w\n\n        def paint(rr, cc, val):\n            if 0 <= rr < R and 0 <= cc < C:\n                out[rr][cc] = val\n\n        for rr in range(h):\n            for cc in range(W):\n                paint(nr0 + rr, nc0 + w + cc, outer)\n\n        for rr in range(H):\n            for cc in range(w):\n                paint(nr0 + h + rr, nc0 + cc, outer)\n                paint(nr0 + h + rr, nc0 + w + W + cc, outer)\n\n        for rr in range(h):\n            for cc in range(W):\n                paint(nr0 + h + H + rr, nc0 + w + cc, outer)\n\n        for rr in range(H):\n            for cc in range(W):\n                val = grid[r0 + rr][c0 + cc]\n                paint(nr0 + h + rr, nc0 + w + cc, inner if val == outer else outer)\n\n    return out",
  "script": "def solve(grid):\n    from collections import deque, Counter\n\n    R, C = len(grid), len(grid[0])\n    out = [[0 for _ in range(C)] for _ in range(R)]\n    visited = [[False for _ in range(C)] for _ in range(R)]\n\n    def neighbors(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < R and 0 <= nc < C:\n                yield nr, nc\n\n    components = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0 and not visited[r][c]:\n                q = deque([(r, c)])\n                visited[r][c] = True\n                cells = []\n                while q:\n                    cr, cc = q.popleft()\n                    cells.append((cr, cc))\n                    for nr, nc in neighbors(cr, cc):\n                        if grid[nr][nc] != 0 and not visited[nr][nc]:\n                            visited[nr][nc] = True\n                            q.append((nr, nc))\n                components.append(cells)\n\n    for cells in components:\n        rs = [r for r, _ in cells]\n        cs = [c for _, c in cells]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n        H, W = r1 - r0 + 1, c1 - c0 + 1\n\n        color_counts = Counter(grid[r][c] for r, c in cells)\n        colors = list(color_counts.keys())\n        if len(colors) != 2:\n            for r, c in cells:\n                out[r][c] = grid[r][c]\n            continue\n\n        border_cells = []\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                if r == r0 or r == r1 or c == c0 or c == c1:\n                    border_cells.append(grid[r][c])\n\n        border_count = Counter(v for v in border_cells if v != 0)\n        outer = border_count.most_common(1)[0][0]\n        inner = colors[0] if colors[1] == outer else colors[1]\n\n        inner_cells = [(r, c) for r, c in cells if grid[r][c] == inner]\n        ir0 = min(r for r, _ in inner_cells)\n        ir1 = max(r for r, _ in inner_cells)\n        ic0 = min(c for _, c in inner_cells)\n        ic1 = max(c for _, c in inner_cells)\n        h = ir1 - ir0 + 1\n        w = ic1 - ic0 + 1\n\n        nr0, nc0 = r0 - h, c0 - w\n\n        def paint(rr, cc, val):\n            if 0 <= rr < R and 0 <= cc < C:\n                out[rr][cc] = val\n\n        for rr in range(h):\n            for cc in range(W):\n                paint(nr0 + rr, nc0 + w + cc, outer)\n\n        for rr in range(H):\n            for cc in range(w):\n                paint(nr0 + h + rr, nc0 + cc, outer)\n                paint(nr0 + h + rr, nc0 + w + W + cc, outer)\n\n        for rr in range(h):\n            for cc in range(W):\n                paint(nr0 + h + H + rr, nc0 + w + cc, outer)\n\n        for rr in range(H):\n            for cc in range(W):\n                val = grid[r0 + rr][c0 + cc]\n                paint(nr0 + h + rr, nc0 + w + cc, inner if val == outer else outer)\n\n    return out",
