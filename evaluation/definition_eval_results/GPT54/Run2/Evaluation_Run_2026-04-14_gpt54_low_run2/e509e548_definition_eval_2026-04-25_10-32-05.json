lor = 1 if corner_count <= 1 else 6\n\n            for cr, cc in comp:\n                out[cr][cc] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def neighbors(r, c, comp_set=None):\n        res = []\n        for dr, dc in dirs:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                if comp_set is None:\n                    if grid[nr][nc] == 3:\n                        res.append((nr, nc))\n                else:\n                    if (nr, nc) in comp_set:\n                        res.append((nr, nc))\n        return res\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 3 or visited[r][c]:\n                continue\n\n            # Collect one connected component of 3s\n            stack = [(r, c)]\n            visited[r][c] = True\n            comp = []\n\n            while stack:\n                cr, cc = stack.pop()\n                comp.append((cr, cc))\n                for nr, nc in neighbors(cr, cc):\n                    if not visited[nr][nc]:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            comp_set = set(comp)\n\n            # Build local degree info\n            deg3_or_more = False\n            corner_count = 0\n\n            for cr, cc in comp:\n                nbs = neighbors(cr, cc, comp_set)\n                d = len(nbs)\n\n                if d >= 3:\n                    deg3_or_more = True\n\n                if d == 2:\n                    (r1, c1), (r2, c2) = nbs\n                    dr1, dc1 = r1 - cr, c1 - cc\n                    dr2, dc2 = r2 - cr, c2 - cc\n                    # Corner if the two incident directions are orthogonal\n                    if not (dr1 == -dr2 and dc1 == -dc2):\n                        corner_count += 1\n\n            if deg3_or_more:\n                color = 2\n            else:\n                color = 1 if corner_count <= 1 else 6\n\n            for cr, cc in comp:\n                out[cr][cc] = color\n\n    return out",
