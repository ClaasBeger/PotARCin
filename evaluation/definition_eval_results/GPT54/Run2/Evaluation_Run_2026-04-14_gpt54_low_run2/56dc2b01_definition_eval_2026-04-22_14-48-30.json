ght_col = min3c + dc - 1\n        else:\n            # shape is right -> place directly right of 2, 8-col right of shape\n            dc = (line_col + 1) - min3c\n            eight_col = max3c + dc + 1\n\n        # Draw moved 3s\n        for r, c in threes:\n            nr, nc = r, c + dc\n            if 0 <= nr < h and 0 <= nc < w:\n                out[nr][nc] = 3\n\n        # Draw 8-line\n        if 0 <= eight_col < w:\n            for r in range(line_min_r, line_max_r + 1):\n                out[r][eight_col] = 8\n\n    return out",
