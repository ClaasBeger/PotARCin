  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    # Collect non-zero colors\n    colors = set()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                colors.add(v)\n\n    if not colors:\n        return grid\n\n    # Find connected components for all non-zero colors\n    visited = [[False] * w for _ in range(h)]\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n            comps.append((len(cells), color, cells))\n\n    # Largest connected component is the frame/object to extract\n    comps.sort(reverse=True, key=lambda x: x[0])\n    _, frame_color, frame_cells = comps[0]\n\n    min_r = min(r for r, c in frame_cells)\n    max_r = max(r for r, c in frame_cells)\n    min_c = min(c for r, c in frame_cells)\n    max_c = max(c for r, c in frame_cells)\n\n    out_h = max_r - min_r + 1\n    out_w = max_c - min_c + 1\n\n    # Marker color = any other non-zero color\n    marker_color = None\n    for color in colors:\n        if color != frame_color:\n            marker_color = color\n            break\n\n    if marker_color is None:\n        return [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n\n    # Build output: border in marker color, interior zeros\n    out = [[0] * out_w for _ in range(out_h)]\n    for r in range(out_h):\n        for c in range(out_w):\n            if r == 0 or r == 