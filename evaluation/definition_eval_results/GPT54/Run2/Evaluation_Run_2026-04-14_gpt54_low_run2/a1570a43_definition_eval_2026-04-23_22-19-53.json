  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    threes = []\n    twos = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 3:\n                threes.append((r, c))\n            elif grid[r][c] == 2:\n                twos.append((r, c))\n\n    if not twos:\n        return [row[:] for row in grid]\n\n    min_r3 = min(r for r, c in threes)\n    min_c3 = min(c for r, c in threes)\n\n    min_r2 = min(r for r, c in twos)\n    min_c2 = min(c for r, c in twos)\n\n    dr = (min_r3 + 1) - min_r2\n    dc = (min_c3 + 1) - min_c2\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for r, c in threes:\n        out[r][c] = 3\n\n    for r, c in twos:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < h and 0 <= nc < w:\n            out[nr][nc] = 2\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    threes = []\n    twos = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 3:\n                threes.append((r, c))\n            elif grid[r][c] == 2:\n                twos.append((r, c))\n\n    if not twos:\n        return [row[:] for row in grid]\n\n    min_r3 = min(r for r, c in threes)\n    min_c3 = min(c for r, c in threes)\n\n    min_r2 = min(r for r, c in twos)\n    min_c2 = min(c for r, c in twos)\n\n    dr = (min_r3 + 1) - min_r2\n    dc = (min_c3 + 1) - min_c2\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    for r, c in threes:\n        out[r][c] = 3\n\n    for r, c in twos:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < h and 0 <= nc < w:\n            out[nr][nc] = 2\n\n    return out",
