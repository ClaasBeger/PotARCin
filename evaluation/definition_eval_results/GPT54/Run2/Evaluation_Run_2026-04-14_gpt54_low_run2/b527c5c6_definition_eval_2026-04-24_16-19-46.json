  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0]) if H else 0\n    out = [row[:] for row in grid]\n\n    visited = [[False] * W for _ in range(H)]\n    comps = []\n\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] != 0 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < H and 0 <= ny < W and grid[nx][ny] != 0 and not visited[nx][ny]:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n                comps.append(cells)\n\n    for cells in comps:\n        rs = [r for r, c in cells]\n        cs = [c for r, c in cells]\n        minr, maxr = min(rs), max(rs)\n        minc, maxc = min(cs), max(cs)\n        h = maxr - minr + 1\n        w = maxc - minc + 1\n\n        two_pos = None\n        for r, c in cells:\n            if grid[r][c] == 2:\n                two_pos = (r, c)\n                break\n        if two_pos is None:\n            continue\n\n        r2, c2 = two_pos\n\n        if w > h:\n            t = h\n            half = t - 1\n            c_start = max(0, c2 - half)\n            c_end = min(W - 1, c2 + half)\n\n            if r2 == minr:\n                row_iter = range(0, minr)\n            elif r2 == maxr:\n                row_iter = range(maxr + 1, H)\n            else:\n                continue\n\n            for r in row_iter:\n                for c in range(c_start, c_end + 1):\n                    out[r][c] = 2 if c == c2 else 3\n\n        elif h > w:\n            t = w\n            half = t - 1\n            r_start = max(0, r2 - half)\n            r_end = min(H - 1, r2 + half)\n\n            if c2 == minc:\n                col_iter = range(0, minc)\n            elif c2 == maxc:\n                col_iter = range(maxc + 1, W)\n            else:\n                continue\n\n            for c in col_iter:\n                for r in range(r_start, r_end + 1):\n                    out[r][c] = 2 if r == r2 else 3\n\n    return out",
