  "raw_response": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n\n    def neighbors8(r, c):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W:\n                    yield nr, nc\n\n    # Find 8-connected components for each non-zero color\n    seen = [[False] * W for _ in range(H)]\n    comps = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] != 0 and not seen[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                seen[r][c] = True\n                cells = []\n                while stack:\n                    cr, cc = stack.pop()\n                    cells.append((cr, cc))\n                    for nr, nc in neighbors8(cr, cc):\n                        if not seen[nr][nc] and grid[nr][nc] == color:\n                            seen[nr][nc] = True\n                            stack.append((nr, nc))\n                comps.append((color, cells))\n\n    # Largest component is the template\n    template_color, template_cells_abs = max(comps, key=lambda x: len(x[1]))\n    min_r = min(r for r, c in template_cells_abs)\n    max_r = max(r for r, c in template_cells_abs)\n    min_c = min(c for r, c in template_cells_abs)\n    max_c = max(c for r, c in template_cells_abs)\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n\n    template_rel = {(r - min_r, c - min_c) for r, c in template_cells_abs}\n\n    out = [row[:] for row in grid]\n\n    step_rs = (-h - 1, 0, h + 1)\n    step_cs = (-w - 1, 0, w + 1)\n    candidate_steps = [(dr, dc) for dr in step_rs for dc in step_cs if not (dr == 0 and dc == 0)]\n\n    for color, cells in comps:\n        if color == template_color and set(cells) == set(template_cells_abs):\n            continue\n\n        cellset = set(cells)\n        chosen = None\n\n        # Find which neighboring translated template contains this marker object\n        for dr, dc in candidate_steps:\n            shifted = {(min_r + dr + rr, min_c + dc + cc) for rr, cc in template_rel}\n            if cellset.issubset(shifted):\n                chosen = (dr, dc)\n                break\n\n        if chosen is None:\n            continue\n\n        dr, dc = chosen\n        k = 1\n        while True:\n            base_r = min_r + k * dr\n            base_c = min_c + k * dc\n\n            any_inside = False\n            for rr, cc in template_rel:\n                r = base_r + rr\n                c = base_c + cc\n                if 0 <= r < H and 0 <= c < W:\n                    out[r][c] = color\n                    any_inside = True\n\n            if not any_inside:\n                break\n            k += 1\n\n    return out",
