ranslated template contains this marker object\n        for dr, dc in candidate_steps:\n            shifted = {(min_r + dr + rr, min_c + dc + cc) for rr, cc in template_rel}\n            if cellset.issubset(shifted):\n                chosen = (dr, dc)\n                break\n\n        if chosen is None:\n            continue\n\n        dr, dc = chosen\n        k = 1\n        while True:\n            base_r = min_r + k * dr\n            base_c = min_c + k * dc\n\n            any_inside = False\n            for rr, cc in template_rel:\n                r = base_r + rr\n                c = base_c + cc\n                if 0 <= r < H and 0 <= c < W:\n                    out[r][c] = color\n                    any_inside = True\n\n            if not any_inside:\n                break\n            k += 1\n\n    return out",
