0 4 9 0 6 0 0 0 6 0 0\n0 0 4 6 3 9 4 6 0 9 0 9 0 0 0 0\n9 9 4 4 4 4 4 9 9 0 9 9 0 0 0 6\nOutput:\n3 3 0\n9 3 9\n6 6 0\n9 0 0\n6 3 9\n\nExample 3:\n\nInput:\n2 5 0 0 3 0 0 2 0 0 0 0 0 0 3 5 3 5\n2 0 0 2 0 2 2 2 2 2 2 5 3 0 3 2 0 5\n0 5 5 8 8 8 8 8 8 8 8 8 8 8 8 5 0 0\n2 0 2 8 0 0 5 3 3 3 2 2 5 0 8 2 5 5\n5 0 3 8 3 0 0 5 5 5 5 2 0 5 8 3 3 3\n0 5 5 8 3 5 0 2 0 3 0 5 3 0 8 0 2 5\n5 2 2 8 3 2 5 5 0 5 3 0 5 0 8 0 0 0\n0 0 0 8 5 2 5 2 5 0 2 2 2 2 8 2 0 5\n5 0 5 8 0 5 2 5 0 0 0 0 3 3 8 0 0 5\n3 0 0 8 2 3 2 3 0 0 5 0 5 0 8 3 2 0\n3 5 0 8 3 2 5 0 5 0 0 0 5 5 8 0 0 2\n3 3 0 8 8 8 8 8 8 8 8 8 8 8 8 0 2 0\n5 0 0 3 0 3 3 5 2 5 0 0 0 0 0 5 0 0\n2 5 2 5 2 2 0 0 0 5 2 0 2 0 3 0 3 0\n0 2 2 2 2 0 0 2 0 2 3 3 2 0 2 5 2 5\n3 0 0 0 0 5 3 0 0 0 2 2 5 0 2 3 2 0\n0 0 2 5 0 5 0 3 0 0 0 0 2 3 3 5 2 3\nOutput:\n0 0 5 3 3 3 2 2 5 0\n3 0 0 5 5 5 5 2 0 5\n3 5 0 2 0 3 0 5 3 0\n3 2 5 5 0 5 3 0 5 0\n5 2 5 2 5 0 2 2 2 2\n0 5 2 5 0 0 0 0 3 3\n2 3 2 3 0 0 5 0 5 0\n3 2 5 0 5 0 0 0 5 5\n\nBelow is a test input grid.\n\nInput:\n0 0 0 8 1 1 8 0 0 8 0 8 0 0 0 8\n0 1 0 8 8 1 0 1 1 2 8 1 1 2 0 2\n0 0 8 8 1 1 8 8 1 1 8 0 8 0 0 1\n1 0 1 0 8 0 1 8 1 0 1 1 8 8 8 0\n8 0 8 3 3 3 3 3 3 3 3 3 3 3 0 2\n1 0 8 3 2 0 8 1 1 1 0 1 0 3 0 0\n0 8 8 3 8 1 0 8 2 8 1 2 8 3 1 8\n1 0 8 3 8 2 0 2 0 1 1 8 1 3 8 8\n0 8 0 3 0 1 8 8 1 1 8 1 8 3 2 1\n1 0 0 3 0 1 8 8 0 8 0 2 0 3 8 1\n0 8 8 3 0 8 8 2 8 8 8 8 8 3 8 8\n1 1 1 3 8 0 2 0 0 0 0 8 8 3 8 0\n1 8 0 3 0 2 8 8 1 2 0 0 2 3 8 1\n8 1 1 3 3 3 3 3 3 3 3 3 3 3 0 2\n8 1 0 0 0 0 8 8 0 1 2 8 8 8 1 8\n8 1 0 0 1 1 8 0 1 2 8 1 0 1 2 0\n8 0 8 2 8 0 8 2 0 1 8 1 8 1 8 8\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    best = None  # (area, top, left, bottom, right)\n\n    colors = set()\n    for row in grid:\n        colors.update(row)\n\n    for c in colors:\n        for top in range(h):\n            for bottom in range(top + 2, h):\n                # possible left/right pairs\n                for left in range(w):\n                    if grid[top][left] != c or grid[bottom][left] != c:\n                        continue\n                    for right in range(left + 2, w):\n                        if grid[top][right] != c or grid[bottom][right] != c:\n                            continue\n\n                        ok = True\n\n                        # top and bottom borders\n                        for x in range(left, right + 1):\n                            if grid[top][x] != c or grid[bottom][x] != c:\n                                ok = False\n                                break\n                        if not ok:\n                            continue\n\n                        # left and right borders\n                        for y in range(top, bottom + 1):\n                            if grid[y][left] != c or grid[y][right] != c:\n                                ok = False\n                                break\n                        if not ok:\n                            continue\n\n                        area = (bottom - top - 1) * (right - left - 1)\n                        if area <= 0:\n                            continue\n\n                        if best is None or area > best[0]:\n                            best = (area, top, left, bottom, right)\n\n    if best is None:\n        return grid\n\n    _, top, left, bottom, right = best\n    return [row[left + 1:right] for row in grid[top + 1:bottom]]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    best = None  # (area, top, left, bottom, right)\n\n    colors = set()\n    for row in grid:\n        colors.update(row)\n\n    for c in colors:\n        for top in range(h):\n            for bottom in range(top + 2, h):\n                # possible left/right pairs\n                for left in range(w):\n                    if grid[top][left] != c or grid[bottom][left] != c:\n                        continue\n                    for right in range(left + 2, w):\n                        if grid[top][right] != c or grid[bottom][right] != c:\n                            continue\n\n                        ok = True\n\n                        # top and bottom borders\n                        for x in range(left, right + 1):\n                            if grid[top][x] != c or grid[bottom][x] != c:\n                                ok = False\n                                break\n                        if not ok:\n                            continue\n\n                        # left and right borders\n                        for y in range(top, bottom + 1):\n                            if grid[y][left] != c or grid[y][right] != c:\n                                ok = False\n                                break\n                        if not ok:\n                            continue\n\n                        area = (bottom - top - 1) * (right - left - 1)\n                        if area <= 0:\n                            continue\n\n                        if best is None or area > best[0]:\n                            best = (area, top, left, bottom, right)\n\n    if best is None:\n        return grid\n\n    _, top, left, bottom, right = best\n    return [row[left + 1:right] for row in grid[top + 1:bottom]]",
