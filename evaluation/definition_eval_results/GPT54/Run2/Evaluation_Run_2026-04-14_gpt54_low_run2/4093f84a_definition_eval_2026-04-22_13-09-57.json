  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Find bounding box of the 5-region\n    rows = []\n    cols = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == 5:\n                rows.append(r)\n                cols.append(c)\n\n    if not rows:\n        return [row[:] for row in grid]\n\n    rmin, rmax = min(rows), max(rows)\n    cmin, cmax = min(cols), max(cols)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Copy the original 5-rectangle\n    for r in range(rmin, rmax + 1):\n        for c in range(cmin, cmax + 1):\n            if grid[r][c] == 5:\n                out[r][c] = 5\n\n    rect_h = rmax - rmin + 1\n    rect_w = cmax - cmin + 1\n\n    # Horizontal bar: propagate counts vertically by column\n    if rect_w >= rect_h:\n        for c in range(w):\n            above_count = 0\n            below_count = 0\n\n            for r in range(0, rmin):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    above_count += 1\n\n            for r in range(rmax + 1, h):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    below_count += 1\n\n            for k in range(above_count):\n                rr = rmin - 1 - k\n                if 0 <= rr < h:\n                    out[rr][c] = 5\n\n            for k in range(below_count):\n                rr = rmax + 1 + k\n                if 0 <= rr < h:\n                    out[rr][c] = 5\n\n    # Vertical bar: propagate counts horizontally by row\n    else:\n        for r in range(h):\n            left_count = 0\n            right_count = 0\n\n            for c in range(0, cmin):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    left_count += 1\n\n            for c in range(cmax + 1, w):\n                if grid[r][c] != 0 and grid[r][c] != 5:\n                    right_count += 1\n\n            for k in range(left_count):\n                cc = cmin - 1 - 