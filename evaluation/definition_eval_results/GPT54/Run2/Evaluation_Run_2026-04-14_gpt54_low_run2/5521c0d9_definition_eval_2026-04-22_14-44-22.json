  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    out = [[0] * w for _ in range(h)]\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n            min_r = r\n            max_r = r\n\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                if x < min_r:\n                    min_r = x\n                if x > max_r:\n                    max_r = x\n\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            height = max_r - min_r + 1\n\n            for x, y in cells:\n                nx = x - height\n                if 0 <= nx < h:\n                    out[nx][y] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    out = [[0] * w for _ in range(h)]\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n            min_r = r\n            max_r = r\n\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                if x < min_r:\n                    min_r = x\n                if x > max_r:\n                    max_r = x\n\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            height = max_r - min_r + 1\n\n            for x, y in cells:\n                nx = x - height\n                if 0 <= nx < h:\n                    out[nx][y] = color\n\n    return out",
