  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    nonzero = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n    if not nonzero:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, _ in nonzero)\n    max_r = max(r for r, _ in nonzero)\n    min_c = min(c for _, c in nonzero)\n    max_c = max(c for _, c in nonzero)\n\n    out = [row[:] for row in grid]\n\n    for r, c in nonzero:\n        color = grid[r][c]\n        rr = max_r - (r - min_r)\n        cc = max_c - (c - min_c)\n        for nr, nc in ((r, c), (r, cc), (rr, c), (rr, cc)):\n            if 0 <= nr < h and 0 <= nc < w and out[nr][nc] == 0:\n                out[nr][nc] = color\n\n    return out",
