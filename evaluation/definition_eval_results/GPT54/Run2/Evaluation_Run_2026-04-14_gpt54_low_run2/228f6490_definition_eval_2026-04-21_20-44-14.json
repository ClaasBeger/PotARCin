     continue\n\n                q = deque([(r, c)])\n                local_seen.add((r, c))\n                region = []\n                touches_boundary = False\n\n                while q:\n                    x, y = q.popleft()\n                    region.append((x, y))\n                    if x == min_r or x == max_r or y == min_c or y == max_c:\n                        touches_boundary = True\n                    for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):\n                        if min_r <= nx <= max_r and min_c <= ny <= max_c:\n                            if (nx, ny) not in cells_set and (nx, ny) not in local_seen and grid[nx][ny] == 0:\n                                local_seen.add((nx, ny))\n                                q.append((nx, ny))\n\n                if not touches_boundary:\n                    holes.append({\n                        \"cells\": region,\n                        \"shape\": norm_shape(region),\n                    })\n\n    # Candidate movable components are all non-zero, non-5 components\n    candidates_by_shape = defaultdict(list)\n    for comp in components:\n        if comp[\"color\"] == 5:\n            continue\n        candidates_by_shape[norm_shape(comp[\"cells\"])].append(comp)\n\n    out = [row[:] for row in grid]\n\n    # Match holes with same-shaped components\n    for hole in holes:\n        shape = hole[\"shape\"]\n        if candidates_by_shape[shape]:\n            comp = candidates_by_shape[shape].pop(0)\n            color = comp[\"color\"]\n\n            for r, c in comp[\"cells\"]:\n                out[r][c] = 0\n            for r, c in hole[\"cells\"]:\n                out[r][c] = color\n\n    return out",
