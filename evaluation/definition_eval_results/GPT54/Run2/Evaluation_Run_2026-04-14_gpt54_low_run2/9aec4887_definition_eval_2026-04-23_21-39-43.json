  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Collect non-8 colored frame parts\n    color_cells = {}\n    eights = []\n\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v == 8:\n                eights.append((r, c))\n            elif v != 0:\n                color_cells.setdefault(v, []).append((r, c))\n\n    # Identify frame colors by orientation/position\n    horizontals = []\n    verticals = []\n    for color, cells in color_cells.items():\n        rows = {r for r, _ in cells}\n        cols = {c for _, c in cells}\n        if len(rows) == 1:\n            horizontals.append((next(iter(rows)), color))\n        elif len(cols) == 1:\n            verticals.append((next(iter(cols)), color))\n\n    top_color = min(horizontals)[1]\n    bottom_color = max(horizontals)[1]\n    left_color = min(verticals)[1]\n    right_color = max(verticals)[1]\n\n    # Bounding box of the 8-pattern\n    min_r = min(r for r, c in eights)\n    max_r = max(r for r, c in eights)\n    min_c = min(c for r, c in eights)\n    max_c = max(c for r, c in eights)\n\n    ih = max_r - min_r + 1\n    iw = max_c - min_c + 1\n\n    # Extract normalized 8 pattern\n    pattern = [[0] * iw for _ in range(ih)]\n    eight_set = set()\n    for r, c in eights:\n        rr = r - min_r\n        cc = c - min_c\n        pattern[rr][cc] = 8\n        eight_set.add((rr, cc))\n\n    # Build output with border\n    out = [[0] * (iw + 2) for _ in range(ih + 2)]\n\n    for c in range(1, iw + 1):\n        out[0][c] = top_color\n        out[ih + 1][c] = bottom_color\n    for r in range(1, ih + 1):\n        out[r][0] = left_color\n        out[r][iw + 1] = right_color\n\n    for r in range(ih):\n        for c in range(iw):\n            out[r + 1][c + 1] = pattern[r][c]\n\n    def middle_indices(n):\n        if n % 2 == 1:\n            return [n // 2]\n        return [n // 2 - 1, n // 2]\n\n    # Top rays\n    for c in middle_indices(iw):\n        for r in range(ih):\n            if (r, c) in eight_set:\n                if r == 0:\n                    out[r + 1][c + 1] = top_color\n                break\n\n    # Bottom rays\n    for c in middle_indices(iw):\n        for r in range(ih - 1, -1, -1):\n            if (r, c) in eight_set:\n                if r == ih - 1:\n                    out[r + 1][c + 1] = bottom_color\n                break\n\n    # Left rays\n    for r in middle_indices(ih):\n        for c in range(iw):\n            if (r, c) in eight_set:\n                if c == 0:\n                    out[r + 1][c + 1] = left_color\n                break\n\n    # Right rays\n    for r in middle_indices(ih):\n        for c in range(iw - 1, -1, -1):\n            if (r, c) in eight_set:\n                if c == iw - 1:\n                    out[r + 1][c + 1] = right_color\n                break\n\n    return out",
