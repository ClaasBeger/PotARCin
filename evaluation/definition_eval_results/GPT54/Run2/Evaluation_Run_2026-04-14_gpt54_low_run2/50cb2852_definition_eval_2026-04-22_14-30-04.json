  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n\n    def neighbors(r, c):\n        if r > 0:\n            yield r - 1, c\n        if r + 1 < h:\n            yield r + 1, c\n        if c > 0:\n            yield r, c - 1\n        if c + 1 < w:\n            yield r, c + 1\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                for nr, nc in neighbors(cr, cc):\n                    if not visited[nr][nc] and grid[nr][nc] == color:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            min_r = min(x for x, y in cells)\n            max_r = max(x for x, y in cells)\n            min_c = min(y for x, y in cells)\n            max_c = max(y for x, y in cells)\n\n            for rr, cc in cells:\n                if min_r < rr < max_r and min_c < cc < max_c:\n                    out[rr][cc] = 8\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n    visited = [[False] * w for _ in range(h)]\n\n    def neighbors(r, c):\n        if r > 0:\n            yield r - 1, c\n        if r + 1 < h:\n            yield r + 1, c\n        if c > 0:\n            yield r, c - 1\n        if c + 1 < w:\n            yield r, c + 1\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            stack = [(r, c)]\n            visited[r][c] = True\n            cells = []\n\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                for nr, nc in neighbors(cr, cc):\n                    if not visited[nr][nc] and grid[nr][nc] == color:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n\n            min_r = min(x for x, y in cells)\n            max_r = max(x for x, y in cells)\n            min_c = min(y for x, y in cells)\n            max_c = max(y for x, y in cells)\n\n            for rr, cc in cells:\n                if min_r < rr < max_r and min_c < cc < max_c:\n                    out[rr][cc] = 8\n\n    return out",
