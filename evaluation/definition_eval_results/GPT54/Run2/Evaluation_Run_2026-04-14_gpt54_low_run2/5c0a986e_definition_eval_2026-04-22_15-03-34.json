  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    def cells_of(color):\n        return [(r, c) for r in range(h) for c in range(w) if grid[r][c] == color]\n\n    for color in (1, 2):\n        cells = cells_of(color)\n        if not cells:\n            continue\n\n        min_r = min(r for r, _ in cells)\n        min_c = min(c for _, c in cells)\n        max_r = max(r for r, _ in cells)\n        max_c = max(c for _, c in cells)\n\n        if color == 1:\n            r, c = min_r - 1, min_c - 1\n            while 0 <= r < h and 0 <= c < w:\n                out[r][c] = 1\n                r -= 1\n                c -= 1\n        else:  # color == 2\n            r, c = max_r + 1, max_c + 1\n            while 0 <= r < h and 0 <= c < w:\n                out[r][c] = 2\n                r += 1\n                c += 1\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    def cells_of(color):\n        return [(r, c) for r in range(h) for c in range(w) if grid[r][c] == color]\n\n    for color in (1, 2):\n        cells = cells_of(color)\n        if not cells:\n            continue\n\n        min_r = min(r for r, _ in cells)\n        min_c = min(c for _, c in cells)\n        max_r = max(r for r, _ in cells)\n        max_c = max(c for _, c in cells)\n\n        if color == 1:\n            r, c = min_r - 1, min_c - 1\n            while 0 <= r < h and 0 <= c < w:\n                out[r][c] = 1\n                r -= 1\n                c -= 1\n        else:  # color == 2\n            r, c = max_r + 1, max_c + 1\n            while 0 <= r < h and 0 <= c < w:\n                out[r][c] = 2\n                r += 1\n                c += 1\n\n    return out",
