  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    colors = sorted({grid[r][c] for r in range(h) for c in range(w) if grid[r][c] != 0})\n\n    for color in colors:\n        # Connect pairs in the same row\n        for r in range(h):\n            cols = [c for c in range(w) if grid[r][c] == color]\n            if len(cols) == 2:\n                c1, c2 = min(cols), max(cols)\n                for c in range(c1, c2 + 1):\n                    out[r][c] = color\n\n        # Connect pairs in the same column\n        for c in range(w):\n            rows = [r for r in range(h) if grid[r][c] == color]\n            if len(rows) == 2:\n                r1, r2 = min(rows), max(rows)\n                for r in range(r1, r2 + 1):\n                    out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n    out = [row[:] for row in grid]\n\n    colors = sorted({grid[r][c] for r in range(h) for c in range(w) if grid[r][c] != 0})\n\n    for color in colors:\n        # Connect pairs in the same row\n        for r in range(h):\n            cols = [c for c in range(w) if grid[r][c] == color]\n            if len(cols) == 2:\n                c1, c2 = min(cols), max(cols)\n                for c in range(c1, c2 + 1):\n                    out[r][c] = color\n\n        # Connect pairs in the same column\n        for c in range(w):\n            rows = [r for r in range(h) if grid[r][c] == color]\n            if len(rows) == 2:\n                r1, r2 = min(rows), max(rows)\n                for r in range(r1, r2 + 1):\n                    out[r][c] = color\n\n    return out",
