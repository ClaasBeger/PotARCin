  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    colors = sorted({grid[r][c] for r in range(h) for c in range(w) if grid[r][c] != 0})\n    if len(colors) < 2:\n        return [row[:] for row in grid]\n\n    cells_by_color = {}\n    for color in colors:\n        cells = []\n        for r in range(h):\n            for c in range(w):\n                if grid[r][c] == color:\n                    cells.append((r, c))\n        cells_by_color[color] = cells\n\n    anchor_color = None\n    pattern_color = None\n\n    for color in colors:\n        cells = cells_by_color[color]\n        rs = [r for r, _ in cells]\n        cs = [c for _, c in cells]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n\n        expected = {\n            (r0, c0),\n            (r0, c1),\n            (r0 + (r1 - r0) // 2, c0 + (c1 - c0) // 2),\n            (r1, c0),\n            (r1, c1),\n        }\n\n        if r1 - r0 == 2 and c1 - c0 == 2 and set(cells) == expected:\n            anchor_color = color\n        else:\n            pattern_color = color\n\n    if anchor_color is None or pattern_color is None:\n        return [row[:] for row in grid]\n\n    out = [row[:] for row in grid]\n\n    anchor_cells = cells_by_color[anchor_color]\n    ar = sorted(r for r, _ in anchor_cells)\n    ac = sorted(c for _, c in anchor_cells)\n    center_r = (min(ar) + max(ar)) // 2\n    center_c = (min(ac) + max(ac)) // 2\n\n    for r, c in cells_by_color[pattern_color]:\n        targets = [\n            (r, c),\n            (r, 2 * center_c - c),\n            (2 * center_r - r, c),\n            (2 * center_r - r, 2 * center_c - c),\n        ]\n        for rr, cc in targets:\n            if 0 <= rr < h and 0 <= cc < w and out[rr][cc] == 0:\n                out[rr][cc] = pattern_color\n\n    return out",
