  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Copy grid\n    out = [row[:] for row in grid]\n\n    # Find non-zero colors and their cells\n    cells_by_color = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                cells_by_color.setdefault(v, []).append((r, c))\n\n    if len(cells_by_color) != 2:\n        return out\n\n    # The special color appears once; the other is the surrounding shape color\n    items = sorted(cells_by_color.items(), key=lambda kv: len(kv[1]))\n    special_color, special_cells = items[0]\n    shape_color, shape_cells = items[1]\n\n    if len(special_cells) != 1:\n        return out\n\n    sr, sc = special_cells[0]\n\n    # Determine extension direction by where the shape lies most strongly\n    up = sum(1 for r, c in shape_cells if r < sr)\n    down = sum(1 for r, c in shape_cells if r > sr)\n    left = sum(1 for r, c in shape_cells if c < sc)\n    right = sum(1 for r, c in shape_cells if c > sc)\n\n    direction = max(\n        [(\"up\", up), (\"down\", down), (\"left\", left), (\"right\", right)],\n        key=lambda x: x[1]\n    )[0]\n\n    dr, dc = {\n        \"up\": (-1, 0),\n        \"down\": (1, 0),\n        \"left\": (0, -1),\n        \"right\": (0, 1),\n    }[direction]\n\n    # Walk from the special cell along the chosen direction.\n    # Find the last non-zero cell on that ray, then fill beyond it to the edge.\n    path = []\n    r, c = sr + dr, sc + dc\n    while 0 <= r < h and 0 <= c < w:\n        path.append((r, c))\n        r += dr\n        c += dc\n\n    last_nonzero_idx = -1\n    for i, (r, c) in enumerate(path):\n        if grid[r][c] != 0:\n            last_nonzero_idx = i\n\n    start_fill = last_nonzero_idx + 1\n    for i in range(start_fill, len(path)):\n        r, c = path[i]\n        if out[r][c] == 0:\n            out[r][c] = special_color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Copy grid\n    out = [row[:] for row in grid]\n\n    # Find non-zero colors and their cells\n    cells_by_color = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                cells_by_color.setdefault(v, []).append((r, c))\n\n    if len(cells_by_color) != 2:\n        return out\n\n    # The special color appears once; the other is the surrounding shape color\n    items = sorted(cells_by_color.items(), key=lambda kv: len(kv[1]))\n    special_color, special_cells = items[0]\n    shape_color, shape_cells = items[1]\n\n    if len(special_cells) != 1:\n        return out\n\n    sr, sc = special_cells[0]\n\n    # Determine extension direction by where the shape lies most strongly\n    up = sum(1 for r, c in shape_cells if r < sr)\n    down = sum(1 for r, c in shape_cells if r > sr)\n    left = sum(1 for r, c in shape_cells if c < sc)\n    right = sum(1 for r, c in shape_cells if c > sc)\n\n    direction = max(\n        [(\"up\", up), (\"down\", down), (\"left\", left), (\"right\", right)],\n        key=lambda x: x[1]\n    )[0]\n\n    dr, dc = {\n        \"up\": (-1, 0),\n        \"down\": (1, 0),\n        \"left\": (0, -1),\n        \"right\": (0, 1),\n    }[direction]\n\n    # Walk from the special cell along the chosen direction.\n    # Find the last non-zero cell on that ray, then fill beyond it to the edge.\n    path = []\n    r, c = sr + dr, sc + dc\n    while 0 <= r < h and 0 <= c < w:\n        path.append((r, c))\n        r += dr\n        c += dc\n\n    last_nonzero_idx = -1\n    for i, (r, c) in enumerate(path):\n        if grid[r][c] != 0:\n            last_nonzero_idx = i\n\n    start_fill = last_nonzero_idx + 1\n    for i in range(start_fill, len(path)):\n        r, c = path[i]\n        if out[r][c] == 0:\n            out[r][c] = special_color\n\n    return out",
