  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    result = [row[:] for row in grid]\n\n    def neighbors(r, c):\n        if r > 0:\n            yield r - 1, c\n        if r + 1 < h:\n            yield r + 1, c\n        if c > 0:\n            yield r, c - 1\n        if c + 1 < w:\n            yield r, c + 1\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 1 or visited[r][c]:\n                continue\n\n            # Collect one connected component of 1s\n            stack = [(r, c)]\n            visited[r][c] = True\n            comp = []\n            min_r = max_r = r\n            min_c = max_c = c\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n                if x < min_r:\n                    min_r = x\n                if x > max_r:\n                    max_r = x\n                if y < min_c:\n                    min_c = y\n                if y > max_c:\n                    max_c = y\n\n                for nx, ny in neighbors(x, y):\n                    if not visited[nx][ny] and grid[nx][ny] == 1:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            comp_set = set(comp)\n\n            # Check whether this component encloses a hole:\n            # within its bounding box, any non-component region not touching\n            # the bounding-box boundary is a hole.\n            seen_bg = set()\n            has_hole = False\n\n            for x in range(min_r, max_r + 1):\n                if has_hole:\n                    break\n                for y in range(min_c, max_c + 1):\n                    if (x, y) in comp_set or (x, y) in seen_bg:\n                        continue\n\n                    stack2 = [(x, y)]\n                    seen_bg.add((x, y))\n                    touches_boundary = False\n\n                    while stack2:\n                        i, j = stack2.pop()\n\n                        if i == min_r or i == max_r or j == min_c or j == max_c:\n                            touches_boundary = True\n\n                        for ni, nj in ((i - 1, j), (i + 1, j), (i, j - 1), (i, j + 1)):\n                            if min_r <= ni <= max_r and min_c <= nj <= max_c:\n                                if (ni, nj) not in comp_set and (ni, nj) not in seen_bg:\n                                    seen_bg.add((ni, nj))\n                                    stack2.append((ni, nj))\n\n                    if not touches_boundary:\n                        has_hole = True\n                        break\n\n            if has_hole:\n                for x, y in comp:\n                    result[x][y] = 8\n\n    return result",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    result = [row[:] for row in grid]\n\n    def neighbors(r, c):\n        if r > 0:\n            yield r - 1, c\n        if r + 1 < h:\n            yield r + 1, c\n        if c > 0:\n            yield r, c - 1\n        if c + 1 < w:\n            yield r, c + 1\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 1 or visited[r][c]:\n                continue\n\n            # Collect one connected component of 1s\n            stack = [(r, c)]\n            visited[r][c] = True\n            comp = []\n            min_r = max_r = r\n            min_c = max_c = c\n\n            while stack:\n                x, y = stack.pop()\n                comp.append((x, y))\n                if x < min_r:\n                    min_r = x\n                if x > max_r:\n                    max_r = x\n                if y < min_c:\n                    min_c = y\n                if y > max_c:\n                    max_c = y\n\n                for nx, ny in neighbors(x, y):\n                    if not visited[nx][ny] and grid[nx][ny] == 1:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            comp_set = set(comp)\n\n            # Check whether this component encloses a hole:\n            # within its bounding box, any non-component region not touching\n            # the bounding-box boundary is a hole.\n            seen_bg = set()\n            has_hole = False\n\n            for x in range(min_r, max_r + 1):\n                if has_hole:\n                    break\n                for y in range(min_c, max_c + 1):\n                    if (x, y) in comp_set or (x, y) in seen_bg:\n                        continue\n\n                    stack2 = [(x, y)]\n                    seen_bg.add((x, y))\n                    touches_boundary = False\n\n                    while stack2:\n                        i, j = stack2.pop()\n\n                        if i == min_r or i == max_r or j == min_c or j == max_c:\n                            touches_boundary = True\n\n                        for ni, nj in ((i - 1, j), (i + 1, j), (i, j - 1), (i, j + 1)):\n                            if min_r <= ni <= max_r and min_c <= nj <= max_c:\n                                if (ni, nj) not in comp_set and (ni, nj) not in seen_bg:\n                                    seen_bg.add((ni, nj))\n                                    stack2.append((ni, nj))\n\n                    if not touches_boundary:\n                        has_hole = True\n                        break\n\n            if has_hole:\n                for x, y in comp:\n                    result[x][y] = 8\n\n    return result",
