  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    # Collect positions for each non-zero color\n    pos = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                pos.setdefault(v, []).append((r, c))\n\n    best_color = None\n    best_rows = []\n    best_cols = []\n\n    # Find the color that defines full border-to-border row/column lines\n    for color, cells in pos.items():\n        cellset = set(cells)\n\n        rows = [r for r in range(h) if (r, 0) in cellset and (r, w - 1) in cellset]\n        cols = [c for c in range(w) if (0, c) in cellset and (h - 1, c) in cellset]\n\n        if rows or cols:\n            if best_color is None or (len(rows) + len(cols) > len(best_rows) + len(best_cols)):\n                best_color = color\n                best_rows = rows\n                best_cols = cols\n\n    # Fallback for the common \"cross\" case where the special color appears 4 times:\n    # one row has two occurrences and one column has two occurrences.\n    if best_color is None:\n        for color, cells in pos.items():\n            row_counts = {}\n            col_counts = {}\n            for r, c in cells:\n                row_counts[r] = row_counts.get(r, 0) + 1\n                col_counts[c] = col_counts.get(c, 0) + 1\n\n            rows = [r for r, cnt in row_counts.items() if cnt >= 2 and ((r, 0) in cells or (r, w - 1) in cells)]\n            cols = [c for c, cnt in col_counts.items() if cnt >= 2 and ((0, c) in cells or (h - 1, c) in cells)]\n\n            if rows or cols:\n                best_color = color\n                best_rows = rows\n                best_cols = cols\n                break\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    if best_color is None:\n        return out\n\n    for r in best_rows:\n        for c in range(w):\n            out[r][c] = best_color\n\n    for c in best_cols:\n        for r in range(h):\n            out[r][c] = best_color\n\n    return out",
