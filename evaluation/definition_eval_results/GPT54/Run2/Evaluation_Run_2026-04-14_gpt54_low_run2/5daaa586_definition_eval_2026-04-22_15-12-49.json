  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0])\n\n    full_rows = [r for r in range(h) if all(v != 0 for v in grid[r])]\n    full_cols = [c for c in range(w) if all(grid[r][c] != 0 for r in range(h))]\n\n    if len(full_rows) < 2 or len(full_cols) < 2:\n        return grid\n\n    top_r, bottom_r = full_rows[0], full_rows[-1]\n    left_c, right_c = full_cols[0], full_cols[-1]\n\n    crop = [row[left_c:right_c + 1] for row in grid[top_r:bottom_r + 1]]\n    ch = len(crop)\n    cw = len(crop[0])\n\n    def side_color(vals):\n        counts = {}\n        for v in vals:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n        if not counts:\n            return 0\n        return max(counts, key=counts.get)\n\n    top_color = side_color(crop[0])\n    bottom_color = side_color(crop[-1])\n    left_color = side_color([crop[r][0] for r in range(ch)])\n    right_color = side_color([crop[r][-1] for r in range(ch)])\n\n    out = [[0] * cw for _ in range(ch)]\n\n    for c in range(cw):\n        out[0][c] = crop[0][c]\n        out[-1][c] = crop[-1][c]\n    for r in range(ch):\n        out[r][0] = crop[r][0]\n        out[r][-1] = crop[r][-1]\n\n    if top_color != 0:\n        for c in range(1, cw - 1):\n            lowest = None\n            for r in range(1, ch - 1):\n                if crop[r][c] == top_color:\n                    lowest = r\n            if lowest is not None:\n                for r in range(1, lowest + 1):\n                    out[r][c] = top_color\n\n    if bottom_color != 0:\n        for c in range(1, cw - 1):\n            highest = None\n            for r in range(1, ch - 1):\n                if crop[r][c] == bottom_color:\n                    highest = r\n                    break\n            if highest is not None:\n                for r in range(highest, ch - 1):\n                    out[r][c] = bottom_color\n\n    if left_color != 0:\n        for r in range(1, ch - 1):\n            rightmost = None\n 