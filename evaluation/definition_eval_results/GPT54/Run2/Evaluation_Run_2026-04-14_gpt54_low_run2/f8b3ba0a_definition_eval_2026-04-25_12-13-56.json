  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    counts = {}\n    first_seen = {}\n    seen_order = 0\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            if color not in first_seen:\n                first_seen[color] = seen_order\n                seen_order += 1\n\n            stack = [(r, c)]\n            visited[r][c] = True\n\n            while stack:\n                x, y = stack.pop()\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            counts[color] = counts.get(color, 0) + 1\n\n    if not counts:\n        return []\n\n    dominant = max(counts, key=lambda col: (counts[col], -first_seen[col]))\n\n    others = [col for col in counts if col != dominant]\n    others.sort(key=lambda col: (-counts[col], first_seen[col]))\n\n    return [[col] for col in others]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    counts = {}\n    first_seen = {}\n    seen_order = 0\n\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or visited[r][c]:\n                continue\n\n            if color not in first_seen:\n                first_seen[color] = seen_order\n                seen_order += 1\n\n            stack = [(r, c)]\n            visited[r][c] = True\n\n            while stack:\n                x, y = stack.pop()\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and not visited[nx][ny] and grid[nx][ny] == color:\n                        visited[nx][ny] = True\n                        stack.append((nx, ny))\n\n            counts[color] = counts.get(color, 0) + 1\n\n    if not counts:\n        return []\n\n    dominant = max(counts, key=lambda col: (counts[col], -first_seen[col]))\n\n    others = [col for col in counts if col != dominant]\n    others.sort(key=lambda col: (-counts[col], first_seen[col]))\n\n    return [[col] for col in others]",
