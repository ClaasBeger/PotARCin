  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    def apply_box(cells):\n        rs = [r for r, c in cells]\n        cs = [c for r, c in cells]\n        r0 = max(0, min(rs) - 1)\n        r1 = min(h - 1, max(rs) + 1)\n        c0 = max(0, min(cs) - 1)\n        c1 = min(w - 1, max(cs) + 1)\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                if out[r][c] == 0:\n                    out[r][c] = 3\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 2:\n                continue\n            if c + 1 < w and grid[r][c + 1] == 2:\n                apply_box([(r, c), (r, c + 1)])\n            if r + 1 < h and grid[r + 1][c] == 2:\n                apply_box([(r, c), (r + 1, c)])\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    out = [row[:] for row in grid]\n\n    def apply_box(cells):\n        rs = [r for r, c in cells]\n        cs = [c for r, c in cells]\n        r0 = max(0, min(rs) - 1)\n        r1 = min(h - 1, max(rs) + 1)\n        c0 = max(0, min(cs) - 1)\n        c1 = min(w - 1, max(cs) + 1)\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                if out[r][c] == 0:\n                    out[r][c] = 3\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 2:\n                continue\n            if c + 1 < w and grid[r][c + 1] == 2:\n                apply_box([(r, c), (r, c + 1)])\n            if r + 1 < h and grid[r + 1][c] == 2:\n                apply_box([(r, c), (r + 1, c)])\n\n    return out",
