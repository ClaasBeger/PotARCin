  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    positions = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                positions.setdefault(v, []).append((r, c))\n\n    out = [row[:] for row in grid]\n\n    horizontals = []\n    verticals = []\n\n    for color, cells in positions.items():\n        if len(cells) != 2:\n            continue\n        (r1, c1), (r2, c2) = cells\n        if r1 == r2:\n            horizontals.append((color, r1, min(c1, c2), max(c1, c2)))\n        elif c1 == c2:\n            verticals.append((color, c1, min(r1, r2), max(r1, r2)))\n\n    for color, r, c1, c2 in horizontals:\n        for c in range(c1, c2 + 1):\n            out[r][c] = color\n\n    for color, c, r1, r2 in verticals:\n        for r in range(r1, r2 + 1):\n            out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    positions = {}\n    for r in range(h):\n        for c in range(w):\n            v = grid[r][c]\n            if v != 0:\n                positions.setdefault(v, []).append((r, c))\n\n    out = [row[:] for row in grid]\n\n    horizontals = []\n    verticals = []\n\n    for color, cells in positions.items():\n        if len(cells) != 2:\n            continue\n        (r1, c1), (r2, c2) = cells\n        if r1 == r2:\n            horizontals.append((color, r1, min(c1, c2), max(c1, c2)))\n        elif c1 == c2:\n            verticals.append((color, c1, min(r1, r2), max(r1, r2)))\n\n    for color, r, c1, c2 in horizontals:\n        for c in range(c1, c2 + 1):\n            out[r][c] = color\n\n    for color, c, r1, r2 in verticals:\n        for r in range(r1, r2 + 1):\n            out[r][c] = color\n\n    return out",
