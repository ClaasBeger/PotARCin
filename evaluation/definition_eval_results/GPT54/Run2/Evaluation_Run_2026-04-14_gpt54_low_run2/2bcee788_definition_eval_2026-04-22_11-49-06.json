        if c < w - 1 and grid[r][c + 1] == shape_color:\n                orientation = 'vertical'\n                side = 'right'\n                break\n\n    if orientation == 'vertical':\n        mc = next(iter(marker_cols))\n        if side is None:\n            # Determine which side the shape touches\n            left_touch = any(c == mc - 1 for r, c in shape_cells)\n            right_touch = any(c == mc + 1 for r, c in shape_cells)\n            side = 'left' if left_touch and not right_touch else 'right' if right_touch and not left_touch else 'left'\n\n        for r, c in shape_cells:\n            if side == 'left':\n                rc = 2 * mc - 1 - c\n            else:\n                rc = 2 * mc + 1 - c\n            if 0 <= rc < w:\n                out[r][rc] = shape_color\n\n    elif orientation == 'horizontal':\n        mr = next(iter(marker_rows))\n        if side is None:\n            above_touch = any(r == mr - 1 for r, c in shape_cells)\n            below_touch = any(r == mr + 1 for r, c in shape_cells)\n            side = 'above' if above_touch and not below_touch else 'below' if below_touch and not above_touch else 'above'\n\n        for r, c in shape_cells:\n            if side == 'above':\n                rr = 2 * mr - 1 - r\n            else:\n                rr = 2 * mr + 1 - r\n            if 0 <= rr < h:\n                out[rr][c] = shape_color\n\n    return out",
