  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n\n    layers = []\n    r0, r1 = 0, rows - 1\n    c0, c1 = 0, cols - 1\n\n    while True:\n        color = grid[r0][c0]\n        layers.append(color)\n\n        min_r, max_r = rows, -1\n        min_c, max_c = cols, -1\n\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                if grid[r][c] != color:\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n        if max_r == -1:\n            break\n\n        r0, r1, c0, c1 = min_r, max_r, min_c, max_c\n\n    n = len(layers)\n    size = 2 * n - 1\n    out = [[0] * size for _ in range(size)]\n\n    for i, color in enumerate(layers):\n        for r in range(i, size - i):\n            for c in range(i, size - i):\n                out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n\n    layers = []\n    r0, r1 = 0, rows - 1\n    c0, c1 = 0, cols - 1\n\n    while True:\n        color = grid[r0][c0]\n        layers.append(color)\n\n        min_r, max_r = rows, -1\n        min_c, max_c = cols, -1\n\n        for r in range(r0, r1 + 1):\n            for c in range(c0, c1 + 1):\n                if grid[r][c] != color:\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n        if max_r == -1:\n            break\n\n        r0, r1, c0, c1 = min_r, max_r, min_c, max_c\n\n    n = len(layers)\n    size = 2 * n - 1\n    out = [[0] * size for _ in range(size)]\n\n    for i, color in enumerate(layers):\n        for r in range(i, size - i):\n            for c in range(i, size - i):\n                out[r][c] = color\n\n    return out",
