  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def neighbors8(r, c):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w:\n                    yield nr, nc\n\n    # Find 8-connected monochrome components\n    seen = [[False] * w for _ in range(h)]\n    comps = []\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or seen[r][c]:\n                continue\n            stack = [(r, c)]\n            seen[r][c] = True\n            cells = []\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                for nr, nc in neighbors8(cr, cc):\n                    if not seen[nr][nc] and grid[nr][nc] == color:\n                        seen[nr][nc] = True\n                        stack.append((nr, nc))\n            rs = [x for x, _ in cells]\n            cs = [y for _, y in cells]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n            norm = {(rr - r0, cc - c0) for rr, cc in cells}\n            comps.append({\n                \"color\": color,\n                \"cells\": cells,\n                \"set\": set(cells),\n                \"r0\": r0, \"r1\": r1,\n                \"c0\": c0, \"c1\": c1,\n                \"h\": r1 - r0 + 1,\n                \"w\": c1 - c0 + 1,\n                \"norm\": norm,\n                \"size\": len(cells),\n            })\n\n    if not comps:\n        return grid\n\n    # Reference is the largest component\n    ref = max(comps, key=lambda comp: comp[\"size\"])\n    ref_shape = ref[\"norm\"]\n    ref_h = ref[\"h\"]\n    ref_w = ref[\"w\"]\n\n    out = [row[:] for row in grid]\n\n    def stamp(top, left, color):\n        for dr, dc in ref_shape:\n            r = top + dr\n            c = left + dc\n            if 0 <= r < h and 0 <= c < w:\n                out[r][c] = color\n\n    for comp in comps:\n        if comp is ref:\n            continue\n\n        candidates = []\n        comp_cells = comp[\"cells\"]\n\n        # Find placements where this component is a subset of the reference shape\n        for rr, cc in ref_shape:\n            for ar, ac in comp_cells:\n                top = ar - rr\n                left = ac - cc\n                ok = True\n                for xr, xc in comp_cells:\n                    if (xr - top, xc - left) not in ref_shape:\n                        ok = False\n                        break\n                if ok:\n                    candidates.append((top, left))\n\n        # Deduplicate\n        candidates = list(dict.fromkeys(candidates))\n        if not candidates:\n            continue\n\n        best = None\n        best_score = None\n\n        for top, left in candidates:\n            dr = top - ref[\"r0\"]\n            dc = left - ref[\"c0\"]\n\n            sr = 0 if dr == 0 else (1 if dr > 0 else -1)\n            sc = 0 if dc == 0 else (1 if dc > 0 else -1)\n            if sr == 0 and sc == 0:\n                continue\n\n            # Must be on the expected lattice relative to the reference\n            if sr != 0 and abs(dr) % (ref_h + 1) != 0:\n                continue\n            if sc != 0 and abs(dc) % (ref_w + 1) != 0:\n                continue\n\n            kr = abs(dr) // (ref_h + 1) if sr != 0 else 1\n            kc = abs(dc) // (ref_w + 1) if sc != 0 else 1\n            if sr != 0 and kr < 1:\n                continue\n            if sc != 0 and kc < 1:\n                continue\n\n            score = (abs(dr) + abs(dc), top, left)\n            if best is None or score < best_score:\n                best = (top, left, sr, sc)\n                best_score = score\n\n        if best is None:\n            # Fallback: choose nearest valid subset placement by direction\n            for top, left in candidates:\n                dr = top - ref[\"r0\"]\n                dc = left - ref[\"c0\"]\n                sr = 0 if dr == 0 else (1 if dr > 0 else -1)\n                sc = 0 if dc == 0 else (1 if dc > 0 else -1)\n                if sr == 0 and sc == 0:\n                    continue\n                score = (abs(dr) + abs(dc), top, left)\n                if best is None or score < best_score:\n                    best = (top, left, sr, sc)\n                    best_score = score\n\n        if best is None:\n            continue\n\n        top, left, sr, sc = best\n        step_r = sr * (ref_h + 1) if sr != 0 else 0\n        step_c = sc * (ref_w + 1) if sc != 0 else 0\n\n        cur_top, cur_left = top, left\n        while True:\n            # Stop if translated bounding box is completely outside\n            if cur_top >= h or cur_left >= w or cur_top + ref_h - 1 < 0 or cur_left + ref_w - 1 < 0:\n                break\n            stamp(cur_top, cur_left, comp[\"color\"])\n            cur_top += step_r\n            cur_left += step_c\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    def neighbors8(r, c):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < h and 0 <= nc < w:\n                    yield nr, nc\n\n    # Find 8-connected monochrome components\n    seen = [[False] * w for _ in range(h)]\n    comps = []\n    for r in range(h):\n        for c in range(w):\n            color = grid[r][c]\n            if color == 0 or seen[r][c]:\n                continue\n            stack = [(r, c)]\n            seen[r][c] = True\n            cells = []\n            while stack:\n                cr, cc = stack.pop()\n                cells.append((cr, cc))\n                for nr, nc in neighbors8(cr, cc):\n                    if not seen[nr][nc] and grid[nr][nc] == color:\n                        seen[nr][nc] = True\n                        stack.append((nr, nc))\n            rs = [x for x, _ in cells]\n            cs = [y for _, y in cells]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n            norm = {(rr - r0, cc - c0) for rr, cc in cells}\n            comps.append({\n                \"color\": color,\n                \"cells\": cells,\n                \"set\": set(cells),\n                \"r0\": r0, \"r1\": r1,\n                \"c0\": c0, \"c1\": c1,\n                \"h\": r1 - r0 + 1,\n                \"w\": c1 - c0 + 1,\n                \"norm\": norm,\n                \"size\": len(cells),\n            })\n\n    if not comps:\n        return grid\n\n    # Reference is the largest component\n    ref = max(comps, key=lambda comp: comp[\"size\"])\n    ref_shape = ref[\"norm\"]\n    ref_h = ref[\"h\"]\n    ref_w = ref[\"w\"]\n\n    out = [row[:] for row in grid]\n\n    def stamp(top, left, color):\n        for dr, dc in ref_shape:\n            r = top + dr\n            c = left + dc\n            if 0 <= r < h and 0 <= c < w:\n                out[r][c] = color\n\n    for comp in comps:\n        if comp is ref:\n            continue\n\n        candidates = []\n        comp_cells = comp[\"cells\"]\n\n        # Find placements where this component is a subset of the reference shape\n        for rr, cc in ref_shape:\n            for ar, ac in comp_cells:\n                top = ar - rr\n                left = ac - cc\n                ok = True\n                for xr, xc in comp_cells:\n                    if (xr - top, xc - left) not in ref_shape:\n                        ok = False\n                        break\n                if ok:\n                    candidates.append((top, left))\n\n        # Deduplicate\n        candidates = list(dict.fromkeys(candidates))\n        if not candidates:\n            continue\n\n        best = None\n        best_score = None\n\n        for top, left in candidates:\n            dr = top - ref[\"r0\"]\n            dc = left - ref[\"c0\"]\n\n            sr = 0 if dr == 0 else (1 if dr > 0 else -1)\n            sc = 0 if dc == 0 else (1 if dc > 0 else -1)\n            if sr == 0 and sc == 0:\n                continue\n\n            # Must be on the expected lattice relative to the reference\n            if sr != 0 and abs(dr) % (ref_h + 1) != 0:\n                continue\n            if sc != 0 and abs(dc) % (ref_w + 1) != 0:\n                continue\n\n            kr = abs(dr) // (ref_h + 1) if sr != 0 else 1\n            kc = abs(dc) // (ref_w + 1) if sc != 0 else 1\n            if sr != 0 and kr < 1:\n                continue\n            if sc != 0 and kc < 1:\n                continue\n\n            score = (abs(dr) + abs(dc), top, left)\n            if best is None or score < best_score:\n                best = (top, left, sr, sc)\n                best_score = score\n\n        if best is None:\n            # Fallback: choose nearest valid subset placement by direction\n            for top, left