  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    color = 0\n    sr = sc = None\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                color = grid[r][c]\n                sr, sc = r, c\n                break\n        if sr is not None:\n            break\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n    if sr is None:\n        return out\n\n    for r in range(h):\n        c1 = r - (sr - sc)\n        if 0 <= c1 < w:\n            out[r][c1] = color\n\n        c2 = (sr + sc) - r\n        if 0 <= c2 < w:\n            out[r][c2] = color\n\n    return out",
