  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    nz = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n    if not nz:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, c in nz)\n    max_r = max(r for r, c in nz)\n    min_c = min(c for r, c in nz)\n    max_c = max(c for r, c in nz)\n\n    # Find the drawing color (the nonzero color other than 2)\n    color = None\n    for r, c in nz:\n        v = grid[r][c]\n        if v != 2:\n            color = v\n            break\n    if color is None:\n        return [row[:] for row in grid]\n\n    # Assume the nonzero pattern occupies a 2x2 box\n    r0, c0 = min_r, min_c\n\n    # Corner values in the 2x2 box\n    tl = grid[r0][c0]\n    tr = grid[r0][c0 + 1]\n    bl = grid[r0 + 1][c0]\n    br = grid[r0 + 1][c0 + 1]\n\n    # A 2 on tl or br indicates the main-diagonal band.\n    # A 2 on tr or bl indicates the anti-diagonal band.\n    draw_main = (tl == 2) or (br == 2)\n    draw_anti = (tr == 2) or (bl == 2)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Main-diagonal band: |(c-r) - k| <= 1, where k matches tl/br of the 2x2\n    if draw_main:\n        k = c0 - r0\n        for r in range(h):\n            for c in range(w):\n                if abs((c - r) - k) <= 1:\n                    out[r][c] = color\n\n    # Anti-diagonal band: |(r+c) - s| <= 1, where s matches tr/bl of the 2x2\n    if draw_anti:\n        s = r0 + c0 + 1\n        for r in range(h):\n            for c in range(w):\n                if abs((r + c) - s) <= 1:\n                    out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    nz = [(r, c) for r in range(h) for c in range(w) if grid[r][c] != 0]\n    if not nz:\n        return [row[:] for row in grid]\n\n    min_r = min(r for r, c in nz)\n    max_r = max(r for r, c in nz)\n    min_c = min(c for r, c in nz)\n    max_c = max(c for r, c in nz)\n\n    # Find the drawing color (the nonzero color other than 2)\n    color = None\n    for r, c in nz:\n        v = grid[r][c]\n        if v != 2:\n            color = v\n            break\n    if color is None:\n        return [row[:] for row in grid]\n\n    # Assume the nonzero pattern occupies a 2x2 box\n    r0, c0 = min_r, min_c\n\n    # Corner values in the 2x2 box\n    tl = grid[r0][c0]\n    tr = grid[r0][c0 + 1]\n    bl = grid[r0 + 1][c0]\n    br = grid[r0 + 1][c0 + 1]\n\n    # A 2 on tl or br indicates the main-diagonal band.\n    # A 2 on tr or bl indicates the anti-diagonal band.\n    draw_main = (tl == 2) or (br == 2)\n    draw_anti = (tr == 2) or (bl == 2)\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    # Main-diagonal band: |(c-r) - k| <= 1, where k matches tl/br of the 2x2\n    if draw_main:\n        k = c0 - r0\n        for r in range(h):\n            for c in range(w):\n                if abs((c - r) - k) <= 1:\n                    out[r][c] = color\n\n    # Anti-diagonal band: |(r+c) - s| <= 1, where s matches tr/bl of the 2x2\n    if draw_anti:\n        s = r0 + c0 + 1\n        for r in range(h):\n            for c in range(w):\n                if abs((r + c) - s) <= 1:\n                    out[r][c] = color\n\n    return out",
