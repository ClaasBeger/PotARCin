  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                min_r = max_r = r\n                min_c = max_c = c\n                count2 = 0\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    if grid[x][y] == 2:\n                        count2 += 1\n                    if x < min_r:\n                        min_r = x\n                    if x > max_r:\n                        max_r = x\n                    if y < min_c:\n                        min_c = y\n                    if y > max_c:\n                        max_c = y\n\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and grid[nx][ny] != 0 and not visited[nx][ny]:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                area = (max_r - min_r + 1) * (max_c - min_c + 1)\n                components.append((count2, area, min_r, min_c, max_r, max_c))\n\n    if not components:\n        return []\n\n    components.sort(key=lambda x: (-x[0], -x[1], x[2], x[3]))\n    _, _, min_r, min_c, max_r, max_c = components[0]\n\n    return [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    visited = [[False] * w for _ in range(h)]\n    components = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0 and not visited[r][c]:\n                stack = [(r, c)]\n                visited[r][c] = True\n                cells = []\n                min_r = max_r = r\n                min_c = max_c = c\n                count2 = 0\n\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    if grid[x][y] == 2:\n                        count2 += 1\n                    if x < min_r:\n                        min_r = x\n                    if x > max_r:\n                        max_r = x\n                    if y < min_c:\n                        min_c = y\n                    if y > max_c:\n                        max_c = y\n\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and grid[nx][ny] != 0 and not visited[nx][ny]:\n                            visited[nx][ny] = True\n                            stack.append((nx, ny))\n\n                area = (max_r - min_r + 1) * (max_c - min_c + 1)\n                components.append((count2, area, min_r, min_c, max_r, max_c))\n\n    if not components:\n        return []\n\n    components.sort(key=lambda x: (-x[0], -x[1], x[2], x[3]))\n    _, _, min_r, min_c, max_r, max_c = components[0]\n\n    return [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]",
