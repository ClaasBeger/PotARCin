  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    points = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                points.append((r, c, grid[r][c]))\n                \n    if len(points) != 2:\n        return grid\n        \n    p1, p2 = points\n    dr = abs(p1[0] - p2[0])\n    dc = abs(p1[1] - p2[1])\n    \n    out_grid = [[0 for _ in range(C)] for _ in range(R)]\n    \n    # Determine the varying axis\n    if (dr > dc and dc > 0) or dr == 0:\n        # Varies with c (vertical lines)\n        points.sort(key=lambda x: x[1])\n        start_c = points[0][1]\n        step = dc\n        c_val = {}\n        idx = 0\n        for c in range(start_c, C, step):\n            c_val[c] = points[idx % 2][2]\n            idx += 1\n        for r in range(R):\n            for c in range(C):\n                if c in c_val:\n                    out_grid[r][c] = c_val[c]\n    else:\n        # Varies with r (horizontal lines)\n        points.sort(key=lambda x: x[0])\n        start_r = points[0][0]\n        step = dr\n        r_val = {}\n        idx = 0\n        for r in range(start_r, R, step):\n            r_val[r] = points[idx % 2][2]\n            idx += 1\n        for r in range(R):\n            for c in range(C):\n                if r in r_val:\n                    out_grid[r][c] = r_val[r]\n                    \n    return out_grid\n```",
  "script": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    points = []\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                points.append((r, c, grid[r][c]))\n                \n    if len(points) != 2:\n        return grid\n        \n    p1, p2 = points\n    dr = abs(p1[0] - p2[0])\n    dc = abs(p1[1] - p2[1])\n    \n    out_grid = [[0 for _ in range(C)] for _ in range(R)]\n    \n    # Determine the varying axis\n    if (dr > dc and dc > 0) or dr == 0:\n        # Varies with c (vertical lines)\n        points.sort(key=lambda x: x[1])\n        start_c = points[0][1]\n        step = dc\n        c_val = {}\n        idx = 0\n        for c in range(start_c, C, step):\n            c_val[c] = points[idx % 2][2]\n            idx += 1\n        for r in range(R):\n            for c in range(C):\n                if c in c_val:\n                    out_grid[r][c] = c_val[c]\n    else:\n        # Varies with r (horizontal lines)\n        points.sort(key=lambda x: x[0])\n        start_r = points[0][0]\n        step = dr\n        r_val = {}\n        idx = 0\n        for r in range(start_r, R, step):\n            r_val[r] = points[idx % 2][2]\n            idx += 1\n        for r in range(R):\n            for c in range(C):\n                if r in r_val:\n                    out_grid[r][c] = r_val[r]\n                    \n    return out_grid",
