  "raw_response": "```python\ndef solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    visited = [[False for _ in range(cols)] for _ in range(rows)]\n    queue = []\n    \n    # Enqueue all 0s on the boundary\n    for r in range(rows):\n        if grid[r][0] == 0:\n            queue.append((r, 0))\n        if grid[r][cols - 1] == 0:\n            queue.append((r, cols - 1))\n            \n    for c in range(cols):\n        if grid[0][c] == 0:\n            queue.append((0, c))\n        if grid[rows - 1][c] == 0:\n            queue.append((rows - 1, c))\n            \n    # Flood fill from boundaries\n    while queue:\n        r, c = queue.pop(0)\n        \n        if r < 0 or r >= rows or c < 0 or c >= cols:\n            continue\n            \n        if visited[r][c] or grid[r][c] != 0:\n            continue\n            \n        visited[r][c] = True\n        \n        queue.append((r + 1, c))\n        queue.append((r - 1, c))\n        queue.append((r, c + 1))\n        queue.append((r, c - 1))\n        \n    # Create the output grid\n    output_grid = [[grid[r][c] for c in range(cols)] for r in range(rows)]\n    \n    # Convert unvisited 0s to 4\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                output_grid[r][c] = 4\n                \n    return output_grid\n```",
  "script": "def solve(grid):\n    if not grid or not grid[0]:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    visited = [[False for _ in range(cols)] for _ in range(rows)]\n    queue = []\n    \n    # Enqueue all 0s on the boundary\n    for r in range(rows):\n        if grid[r][0] == 0:\n            queue.append((r, 0))\n        if grid[r][cols - 1] == 0:\n            queue.append((r, cols - 1))\n            \n    for c in range(cols):\n        if grid[0][c] == 0:\n            queue.append((0, c))\n        if grid[rows - 1][c] == 0:\n            queue.append((rows - 1, c))\n            \n    # Flood fill from boundaries\n    while queue:\n        r, c = queue.pop(0)\n        \n        if r < 0 or r >= rows or c < 0 or c >= cols:\n            continue\n            \n        if visited[r][c] or grid[r][c] != 0:\n            continue\n            \n        visited[r][c] = True\n        \n        queue.append((r + 1, c))\n        queue.append((r - 1, c))\n        queue.append((r, c + 1))\n        queue.append((r, c - 1))\n        \n    # Create the output grid\n    output_grid = [[grid[r][c] for c in range(cols)] for r in range(rows)]\n    \n    # Convert unvisited 0s to 4\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                output_grid[r][c] = 4\n                \n    return output_grid",
