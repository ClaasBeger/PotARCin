  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    # Find the all-zero rows and columns\n    zero_rows = [i for i in range(rows) if all(v == 0 for v in grid[i])]\n    zero_cols = [j for j in range(cols) if all(grid[i][j] == 0 for i in range(rows))]\n    \n    # Find contiguous zero row/col bands\n    def find_band(indices):\n        bands = []\n        start = indices[0]\n        for i in range(1, len(indices)):\n            if indices[i] != indices[i-1] + 1:\n                bands.append((start, indices[i-1]))\n                start = indices[i]\n        bands.append((start, indices[-1]))\n        return bands\n    \n    row_bands = find_band(zero_rows)\n    col_bands = find_band(zero_cols)\n    \n    # Determine quadrants\n    rb = row_bands[0]\n    cb = col_bands[0]\n    \n    # 4 quadrants: top-left, top-right, bottom-left, bottom-right\n    regions = []\n    row_ranges = [(0, rb[0]-1), (rb[1]+1, rows-1)]\n    col_ranges = [(0, cb[0]-1), (cb[1]+1, cols-1)]\n    \n    # Find which region has non-0/8/1 colors (the special colored one) vs all-zero\n    def extract(r1,r2,c1,c2):\n        return [[grid[i][j] for j in range(c1,c2+1)] for i in range(r1,r2+1)]\n    \n    def get_values(r1,r2,c1,c2):\n        vals = set()\n        for i in range(r1,r2+1):\n            for j in range(c1,c2+1):\n                vals.add(grid[i][j])\n        return vals\n    \n    # Find the non-zero, non-trivial quadrant that has a color other than 0\n    # and isn't all zeros\n    result = None\n    for rr in row_ranges:\n        for cr in col_ranges:\n            vals = get_values(rr[0],rr[1],cr[0],cr[1])\n            non_zero = vals - {0}\n            if len(non_zero) == 1:\n                v = non_zero.pop()\n                if v not in (1, 8):  # or more generally, find the unique special color\n                    result = extract(rr[0],rr[1],cr[0],cr[1])\n    \n    if result is None:\n        # Try: find quadrant with color not shared by others\n        color_counts = {}\n        for rr in row_ranges:\n            for cr in col_ranges:\n                vals = get_values(rr[0],rr[1],cr[0],cr[1]) - {0}\n                for v in vals:\n                    color_counts[v] = color_counts.get(v, 0) + 1\n        # The answer is the region whose non-zero color appears fewest times\n        for rr in row_ranges:\n            for cr in col_ranges:\n                vals = get_values(rr[0],rr[1],cr[0],cr[1]) - {0}\n                if len(vals) == 1:\n                    v = vals.pop()\n                    if color_counts.get(v,0) == 1:\n                        result = extract(rr[0],rr[1],cr[0],cr[1])\n                        break\n    \n    if result is None:\n        # Fallback: find the quadrant that's all zeros and skip it, return the colored one\n        for rr in row_ranges:\n            for cr in col_ranges:\n                vals = get_values(rr[0],rr[1],cr[0],cr[1])\n                if vals != {0}:\n                    non_zero = vals - {0}\n                    if len(non_zero) == 1:\n                        result = extract(rr[0],rr[1],cr[0],cr[1])\n                        break\n    \n    return result",
