  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    sep = [i for i in range(rows) if all(grid[i][c] == 6 for c in range(cols))]\n    \n    sec_bounds = []\n    prev = 0\n    for s in sep:\n        sec_bounds.append((prev, s))\n        prev = s + 1\n    sec_bounds.append((prev, rows))\n    \n    n = len(sec_bounds)\n    sr = sec_bounds[0][1] - sec_bounds[0][0]\n    \n    color = 0\n    sec_cells = []\n    for start, end in sec_bounds:\n        cells = set()\n        for r in range(start, end):\n            for c in range(cols):\n                if grid[r][c] not in (0, 6):\n                    cells.add((r - start, c))\n                    color = grid[r][c]\n        sec_cells.append(cells)\n    \n    empty = [i for i in range(n) if not sec_cells[i]]\n    nonempty = sorted(i for i in range(n) if sec_cells[i])\n    result = [s.copy() for s in sec_cells]\n    \n    if not empty:\n        return grid\n    \n    def nb4(r, c):\n        return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]\n    def nb8(r, c):\n        return [(r+dr,c+dc) for dr in [-1,0,1] for dc in [-1,0,1] if dr or dc]\n    \n    def bfs(seed, allowed, nf):\n        dist = {c:0 for c in seed}\n        q = list(seed)\n        qi = 0\n        while qi < len(q):\n            cell = q[qi]; qi += 1\n            for nr, nc in nf(*cell):\n                if (nr,nc) in allowed and (nr,nc) not in dist:\n                    dist[(nr,nc)] = dist[cell] + 1\n                    q.append((nr,nc))\n        return dist\n    \n    all_grid = {(r,c) for r in range(sr) for c in range(cols)}\n    solved = False\n    \n    is_cum = len(nonempty) >= 2 and all(\n        sec_cells[nonempty[i]].issubset(sec_cells[nonempty[i+1]])\n        for i in range(len(nonempty)-1))\n    \n    if is_cum:\n        target = sec_cells[nonempty[-1]]\n        for nf in [nb4, nb8]:\n            for root in sorted(target):\n                dist = bfs({root}, target, nf)\n                if len(dist) < len(target): continue\n                d_map = {}\n                ok = True\n                for idx in nonempty:\n                    mx = max(dist[c] for c in sec_cells[idx])\n                    if {c for c in target if dist[c] <= mx} != sec_cells[idx]:\n                        ok = False; break\n                    d_map[idx] = mx\n                if not ok: continue\n                \n                for idx in empty:\n                    p = max((i for i in nonempty if i < idx), default=None)\n                    nx = min((i for i in nonempty if i > idx), default=None)\n                    if p is not None and nx is not None:\n                        dk = d_map[p]+(d_map[nx]-d_map[p])*(idx-p)/(nx-p)\n                    elif p is not None:\n                        r2 = (d_map[nonempty[-1]]-d_map[nonempty[-2]])/(nonempty[-1]-nonempty[-2]) if len(nonempty)>=2 else 1\n                        dk = d_map[p]+r2*(idx-p)\n                    else:\n                        r2 = (d_map[nonempty[1]]-d_map[nonempty[0]])/(nonempty[1]-nonempty[0]) if len(nonempty)>=2 else 1\n                        dk = d_map[nx]-r2*(nx-idx)\n                    dk = int(dk+1e-9)\n                    result[idx] = {c for c in target if dist[c] <= max(0,dk)}\n                solved = True; break\n            if solved: break\n    \n    if not solved:\n        seed = sec_cells[nonempty[0]]\n        for nf in [nb4, nb8]:\n            dist = bfs(seed, all_grid, nf)\n            if all({c for c,d in dist.items() if d==idx} == sec_cells[idx] for idx in nonempty):\n                for idx in empty:\n                    result[idx] = {c for c,d in dist.items() if d==idx}\n                solved = True; break\n    \n    if not solved:\n        all_known = set()\n        for i in nonempty: all_known |= sec_cells[i]\n        seed = sec_cells[nonempty[0]]\n        for nf in [nb4, nb8]:\n            dist = bfs(seed, all_known, nf)\n            if all({c for c,d in dist.items() if d==idx} == sec_cells[idx] fo