  "raw_response": "def solve(grid):\n    import copy\n    from collections import Counter\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = copy.deepcopy(grid)\n    \n    key = []\n    key_row = -1\n    for r in range(rows - 1, -1, -1):\n        non_zero = [v for v in grid[r] if v != 0]\n        if len(non_zero) >= 2:\n            key = non_zero\n            key_row = r\n            break\n    \n    color_count = Counter()\n    for r in range(rows):\n        if r == key_row:\n            continue\n        for c in range(cols):\n            if grid[r][c] != 0:\n                color_count[grid[r][c]] += 1\n    border_color = color_count.most_common(1)[0][0]\n    \n    key_map = {}\n    for i in range(len(key)):\n        key_map[key[i]] = key[(i + 1) % len(key)]\n    \n    visited = [[False] * cols for _ in range(rows)]\n    \n    def flood_fill(sr, sc):\n        stack = [(sr, sc)]\n        visited[sr][sc] = True\n        region = []\n        while stack:\n            r, c = stack.pop()\n            region.append((r, c))\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == 0:\n                    visited[nr][nc] = True\n                    stack.append((nr, nc))\n        return region\n    \n    zero_regions = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                region = flood_fill(r, c)\n                zero_regions.append(region)\n    \n    for region in zero_regions:\n        touches = any(r == 0 or r == rows-1 or c == 0 or c == cols-1 for r,c in region)\n        if touches:\n            continue\n        \n        border_cells = set()\n        for r, c in region:\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < rows and 0 <= nc < cols and grid[nr][nc] == border_color:\n                    border_cells.add((nr, nc))\n        \n        adjacent_colors = set()\n        for br, bc in border_cells:\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = br + dr, bc + dc\n                if 0 <= nr < rows and 0 <= nc < cols:\n                    v = grid[nr][nc]\n                    if v != 0 and v != border_color:\n                        adjacent_colors.add(v)\n        \n        fill_color = 0\n        for color in adjacent_colors:\n            if color in key_map and key_map[color] not in adjacent_colors:\n                fill_color = key_map[color]\n                break\n        \n        for r, c in region:\n            result[r][c] = fill_color\n    \n    return result",
