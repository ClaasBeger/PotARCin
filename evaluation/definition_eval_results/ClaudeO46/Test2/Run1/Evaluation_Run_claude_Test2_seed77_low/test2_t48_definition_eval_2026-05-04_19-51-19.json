er_color:\n                    border_cells.add((nr, nc))\n        \n        adjacent_colors = set()\n        for br, bc in border_cells:\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = br + dr, bc + dc\n                if 0 <= nr < rows and 0 <= nc < cols:\n                    v = grid[nr][nc]\n                    if v != 0 and v != border_color:\n                        adjacent_colors.add(v)\n        \n        fill_color = 0\n        for color in adjacent_colors:\n            if color in key_map and key_map[color] not in adjacent_colors:\n                fill_color = key_map[color]\n                break\n        \n        for r, c in region:\n            result[r][c] = fill_color\n    \n    return result",
