  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    twos = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    min_r = min(r for r, c in twos)\n    max_r = max(r for r, c in twos)\n    min_c = min(c for r, c in twos)\n    max_c = max(c for r, c in twos)\n    \n    int_r1, int_r2 = min_r + 1, max_r - 1\n    int_c1, int_c2 = min_c + 1, max_c - 1\n    int_h = int_r2 - int_r1 + 1\n    int_w = int_c2 - int_c1 + 1\n    \n    interior = [[grid[r][c] for c in range(int_c1, int_c2 + 1)] for r in range(int_r1, int_r2 + 1)]\n    \n    colors = {}\n    for r in range(int_h):\n        for c in range(int_w):\n            v = interior[r][c]\n            if v != 0:\n                colors.setdefault(v, []).append((r, c))\n    \n    scale_r = rows // int_h\n    scale_c = cols // int_w\n    \n    box_center_r = (min_r + max_r) / 2\n    box_center_c = (min_c + max_c) / 2\n    corner_top = box_center_r < rows / 2\n    corner_left = box_center_c < cols / 2\n    \n    output = [[0] * cols for _ in range(rows)]\n    \n    for color, positions in colors.items():\n        pr_min = min(r for r, c in positions)\n        pr_max = max(r for r, c in positions)\n        pc_min = min(c for r, c in positions)\n        pc_max = max(c for r, c in positions)\n        \n        out_r1 = pr_min * scale_r\n        out_r2 = (pr_max + 1) * scale_r - 1\n        out_c1 = pc_min * scale_c\n        out_c2 = (pc_max + 1) * scale_c - 1\n        \n        for r in range(out_r1, out_r2 + 1):\n            for c in range(out_c1, out_c2 + 1):\n                if r == out_r1 or r == out_r2 or c == out_c1 or c == out_c2:\n                    output[r][c] = color\n        \n        oi_r1, oi_r2 = out_r1 + 1, out_r2 - 1\n        oi_c1, oi_c2 = out_c1 + 1, out_c2 - 1\n        oi_h = oi_r2 - oi_r1 + 1\n        oi_w = oi_c2 - oi_c1 + 1\n        \n        block_h = oi_h // 2\n        block_w = oi_w // 2\n        \n        br1 = oi_r1 if corner_top else oi_r1 + (oi_h - block_h)\n        bc1 = oi_c1 if corner_left else oi_c1 + (oi_w - block_w)\n        \n        for r in range(br1, br1 + block_h):\n            for c in range(bc1, bc1 + block_w):\n                output[r][c] = 2\n    \n    return output\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    twos = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    min_r = min(r for r, c in twos)\n    max_r = max(r for r, c in twos)\n    min_c = min(c for r, c in twos)\n    max_c = max(c for r, c in twos)\n    \n    int_r1, int_r2 = min_r + 1, max_r - 1\n    int_c1, int_c2 = min_c + 1, max_c - 1\n    int_h = int_r2 - int_r1 + 1\n    int_w = int_c2 - int_c1 + 1\n    \n    interior = [[grid[r][c] for c in range(int_c1, int_c2 + 1)] for r in range(int_r1, int_r2 + 1)]\n    \n    colors = {}\n    for r in range(int_h):\n        for c in range(int_w):\n            v = interior[r][c]\n            if v != 0:\n                colors.setdefault(v, []).append((r, c))\n    \n    scale_r = rows // int_h\n    scale_c = cols // int_w\n    \n    box_center_r = (min_r + max_r) / 2\n    box_center_c = (min_c + max_c) / 2\n    corner_top = box_center_r < rows / 2\n    corner_left = box_center_c < cols / 2\n    \n    output = [[0] * cols for _ in range(rows)]\n    \n    for color, positions in colors.items():\n        pr_min = min(r for r, c in positions)\n        pr_max = max(r for r, c in positions)\n        pc_min = min(c for r, c in positions)\n        pc_max = max(c for r, c in positions)\n        \n        out_r1 = pr_min * scale_r\n        out_r2 = (pr_max + 1) * scale_r - 1\n        out_c1 = pc_min * scale_c\n        out_c2 = (pc_max + 1) * scale_c - 1\n        \n        for r in range(out_r1, out_r2 + 1):\n            for c in range(out_c1, out_c2 + 1):\n                if r == out_r1 or r == out_r2 or c == out_c1 or c == out_c2:\n                    output[r][c] = color\n        \n        oi_r1, oi_r2 = out_r1 + 1, out_r2 - 1\n        oi_c1, oi_c2 = out_c1 + 1, out_c2 - 1\n        oi_h = oi_r2 - oi_r1 + 1\n        oi_w = oi_c2 - oi_c1 + 1\n        \n        block_h = oi_h // 2\n        block_w = oi_w // 2\n        \n        br1 = oi_r1 if corner_top else oi_r1 + (oi_h - block_h)\n        bc1 = oi_c1 if corner_left else oi_c1 + (oi_w - block_w)\n        \n        for r in range(br1, br1 + block_h):\n            for c in range(bc1, bc1 + block_w):\n                output[r][c] = 2\n    \n    return output",
