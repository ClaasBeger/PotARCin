{p for p in nz if p[0]+p[1]>k}\n                if lo and hi: return 'dsum', k\n        return None, None\n    \n    gt, gv = find_gap()\n    if gt is None: return [r[:] for r in grid]\n    \n    def side(cells, gt, gv):\n        if gt=='row': return 1 if sum(r for r,c in cells)/len(cells)>gv else -1\n        if gt=='col': return 1 if sum(c for r,c in cells)/len(cells)>gv else -1\n        if gt=='dsum': return 1 if sum(r+c for r,c in cells)/len(cells)>gv else -1\n    \n    def dist9(cells):\n        if not nine_pos: return float('inf')\n        return min(abs(r-nr)+abs(c-nc) for r,c in cells for nr,nc in nine_pos)\n    \n    moving = shapes[0]\n    if len(shapes)>=2:\n        if dist9(shapes[0][1])<=dist9(shapes[1][1]): moving=shapes[0]\n        else: moving=shapes[1]\n    \n    mc = set(moving[1])\n    s = side(moving[1], gt, gv)\n    if gt=='row': step=(-s,0)\n    elif gt=='col': step=(0,-s)\n    else: step=(-s,-s)\n    sr,sc=step\n    \n    max_n=0\n    for n in range(1,rows+cols):\n        shr,shc=n*sr,n*sc\n        if not all(0<=r+shr<rows and 0<=c+shc<cols for r,c in mc): break\n        tmp=[row[:] for row in grid]\n        for r,c in mc: tmp[r][c]=0\n        nps=[(r+shr,c+shc,grid[r][c]) for r,c in mc]\n        nps.sort(key=lambda x:-(x[0]*sr+x[1]*sc))\n        ok=True\n        for nr,nc,val in nps:\n            if tmp[nr][nc]!=0:\n                cr,cc=nr,nc\n                while 0<=cr<rows and 0<=cc<cols and tmp[cr][cc]!=0: cr+=sr;cc+=sc\n                if not(0<=cr<rows and 0<=cc<cols): ok=False;break\n                while(cr,cc)!=(nr,nc):\n                    pr,pc=cr-sr,cc-sc;tmp[cr][cc]=tmp[pr][pc];cr,cc=pr,pc\n            tmp[nr][nc]=val\n        if ok: max_n=n\n        else: break\n    \n    if max_n==0: return [r[:] for r in grid]\n    shr,shc=max_n*sr,max_n*sc\n    res=[row[:] for row in grid]\n    for r,c in mc: res[r][c]=0\n    nps=[(r+shr,c+shc,grid[r][c]) for r,c in mc]\n    nps.sort(key=lambda x:-(x[0]*sr+x[1]*sc))\n    for nr,nc,val in nps: