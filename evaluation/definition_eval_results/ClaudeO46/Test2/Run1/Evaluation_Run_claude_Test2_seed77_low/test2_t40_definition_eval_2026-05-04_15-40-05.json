  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    rectangles = []\n    \n    for color in set(val for row in grid for val in row if val != 0 and val != 2):\n        cells = {(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == color}\n        visited = set()\n        \n        for start in cells:\n            if start in visited:\n                continue\n            component = set()\n            stack = [start]\n            while stack:\n                pos = stack.pop()\n                if pos in component or pos not in cells or pos in visited:\n                    continue\n                component.add(pos)\n                visited.add(pos)\n                r, c = pos\n                for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    stack.append((r+dr, c+dc))\n            \n            min_r = min(r for r, c in component)\n            max_r = max(r for r, c in component)\n            min_c = min(c for r, c in component)\n            max_c = max(c for r, c in component)\n            \n            has_2 = any(grid[r][c] == 2 for r in range(min_r+1, max_r) for c in range(min_c+1, max_c))\n            \n            rectangles.append({\n                'color': color,\n                'min_r': min_r, 'max_r': max_r,\n                'min_c': min_c, 'max_c': max_c,\n                'has_2': has_2,\n                'cells': component\n            })\n    \n    to_remove = set()\n    has_2_indices = [i for i, r in enumerate(rectangles) if r['has_2']]\n    for i in has_2_indices:\n        to_remove.add(i)\n    \n    for i in has_2_indices:\n        r2 = rectangles[i]\n        for j, r1 in enumerate(rectangles):\n            if r1['has_2'] or j in to_remove:\n                continue\n            if r1['max_r'] + 1 == r2['min_r']:\n                overlap_start = max(r1['min_c'], r2['min_c'])\n                overlap_end = min(r1['max_c'], r2['max_c'])\n                if overlap_start <= overlap_end:\n                    overlap = overlap_end - overlap_start + 1\n                    r1_width = r1['max_c'] - r1['min_c'] + 1\n                    if overlap / r1_width >= 0.5:\n                        to_remove.add(j)\n    \n    result = [[0]*cols for _ in range(rows)]\n    for i, rect in enumerate(rectangles):\n        if i not in to_remove:\n            for r, c in rect['cells']:\n                result[r][c] = rect['color']\n    \n    return result",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    rectangles = []\n    \n    for color in set(val for row in grid for val in row if val != 0 and val != 2):\n        cells = {(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == color}\n        visited = set()\n        \n        for start in cells:\n            if start in visited:\n                continue\n            component = set()\n            stack = [start]\n            while stack:\n                pos = stack.pop()\n                if pos in component or pos not in cells or pos in visited:\n                    continue\n                component.add(pos)\n                visited.add(pos)\n                r, c = pos\n                for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    stack.append((r+dr, c+dc))\n            \n            min_r = min(r for r, c in component)\n            max_r = max(r for r, c in component)\n            min_c = min(c for r, c in component)\n            max_c = max(c for r, c in component)\n            \n            has_2 = any(grid[r][c] == 2 for r in range(min_r+1, max_r) for c in range(min_c+1, max_c))\n            \n            rectangles.append({\n                'color': color,\n                'min_r': min_r, 'max_r': max_r,\n                'min_c': min_c, 'max_c': max_c,\n                'has_2': has_2,\n                'cells': component\n            })\n    \n    to_remove = set()\n    has_2_indices = [i for i, r in enumerate(rectangles) if r['has_2']]\n    for i in has_2_indices:\n        to_remove.add(i)\n    \n    for i in has_2_indices:\n        r2 = rectangles[i]\n        for j, r1 in enumerate(rectangles):\n            if r1['has_2'] or j in to_remove:\n                continue\n            if r1['max_r'] + 1 == r2['min_r']:\n                overlap_start = max(r1['min_c'], r2['min_c'])\n                overlap_end = min(r1['max_c'], r2['max_c'])\n                if overlap_start <= overlap_end:\n                    overlap = overlap_end - overlap_start + 1\n                    r1_width = r1['max_c'] - r1['min_c'] + 1\n                    if overlap / r1_width >= 0.5:\n                        to_remove.add(j)\n    \n    result = [[0]*cols for _ in range(rows)]\n    for i, rect in enumerate(rectangles):\n        if i not in to_remove:\n            for r, c in rect['cells']:\n                result[r][c] = rect['color']\n    \n    return result",
