  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    from collections import defaultdict\n    value_cells = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                value_cells[grid[r][c]].append((r, c))\n    \n    def depth(r, c):\n        return min(r, c, rows - 1 - r, cols - 1 - c)\n    \n    centers = {}\n    for val, cells in value_cells.items():\n        best = max(cells, key=lambda rc: (depth(rc[0], rc[1]), -(abs(rc[0] - (rows-1)/2.0) + abs(rc[1] - (cols-1)/2.0))))\n        centers[val] = best\n    \n    sorted_vals = sorted(value_cells.keys(), key=lambda v: (centers[v][0], centers[v][1]))\n    \n    out = [[0] * cols for _ in range(rows)]\n    \n    for val in sorted_vals:\n        cr, cc = centers[val]\n        for (sr, sc) in value_cells[val]:\n            c_min, c_max = min(sc, cc), max(sc, cc)\n            for c in range(c_min, c_max + 1):\n                out[sr][c] = val\n            r_min, r_max = min(sr, cr), max(sr, cr)\n            for r in range(r_min, r_max + 1):\n                out[r][cc] = val\n    \n    return out\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    from collections import defaultdict\n    value_cells = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                value_cells[grid[r][c]].append((r, c))\n    \n    def depth(r, c):\n        return min(r, c, rows - 1 - r, cols - 1 - c)\n    \n    centers = {}\n    for val, cells in value_cells.items():\n        best = max(cells, key=lambda rc: (depth(rc[0], rc[1]), -(abs(rc[0] - (rows-1)/2.0) + abs(rc[1] - (cols-1)/2.0))))\n        centers[val] = best\n    \n    sorted_vals = sorted(value_cells.keys(), key=lambda v: (centers[v][0], centers[v][1]))\n    \n    out = [[0] * cols for _ in range(rows)]\n    \n    for val in sorted_vals:\n        cr, cc = centers[val]\n        for (sr, sc) in value_cells[val]:\n            c_min, c_max = min(sc, cc), max(sc, cc)\n            for c in range(c_min, c_max + 1):\n                out[sr][c] = val\n            r_min, r_max = min(sr, cr), max(sr, cr)\n            for r in range(r_min, r_max + 1):\n                out[r][cc] = val\n    \n    return out",
