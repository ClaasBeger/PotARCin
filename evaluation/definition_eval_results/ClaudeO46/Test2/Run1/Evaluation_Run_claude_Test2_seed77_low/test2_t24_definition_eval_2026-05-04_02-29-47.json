  "raw_response": "Looking at the examples, I identified a multi-step rule:\n\n1. Find the marker cell (value 2) - it always becomes 0\n2. The marker's 8-connected component of non-zero cells always changes to color 2\n3. Among remaining components: if one dominates (larger than sum of others), it stays and others change\n4. Otherwise, use a \"border swap\" rule based on same-color 4-connected components and whether they touch the grid border\n\n```python\ndef solve(grid):\n    import collections\n    rows, cols = len(grid), len(grid[0])\n    marker_val = 2\n    marker_pos = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == marker_val:\n                marker_pos = (r, c)\n    visited = [[False]*cols for _ in range(rows)]\n    comp8_id = [[-1]*cols for _ in range(rows)]\n    components8 = []\n    def bfs8(sr, sc, cid):\n        q = collections.deque([(sr, sc)])\n        visited[sr][sc] = True\n        comp8_id[sr][sc] = cid\n        cells = [(sr, sc)]\n        while q:\n            r, c = q.popleft()\n            for dr in [-1, 0, 1]:\n                for dc in [-1, 0, 1]:\n                    if dr == 0 and dc == 0: continue\n                    nr, nc = r+dr, c+dc\n                    if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] != 0:\n                        visited[nr][nc] = True\n                        comp8_id[nr][nc] = cid\n                        q.append((nr, nc))\n                        cells.append((nr, nc))\n        return cells\n    cid = 0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                components8.append(bfs8(r, c, cid))\n                cid += 1\n    marker_8cid = comp8_id[marker_pos[0]][marker_pos[1]]\n    change_cells = set()\n    for r, c in components8[marker_8cid]:\n        change_cells.add((r, c))\n    remaining = [(i, comp) for i, comp in enumerate(components8) if i != marker_8cid]\n    if remaining:\n        sizes = [len(comp) for _, comp in remaining]\n        max_size = max(sizes)\n        sum_others = sum(sizes) - max_size\n        if max_size > sum_others:\n            for i, comp in remaining:\n                if len(comp) != max_size:\n                    for r, c in comp:\n                        change_cells.add((r, c))\n        else:\n            visited2 = [[False]*cols for _ in range(rows)]\n            color_comps = []\n            def bfs4c(sr, sc):\n                color = grid[sr][sc]\n                q = collections.deque([(sr, sc)])\n                visited2[sr][sc] = True\n                cells = [(sr, sc)]\n                while q:\n                    r, c = q.popleft()\n                    for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited2[nr][nc] and grid[nr][nc] == color:\n                            visited2[nr][nc] = True\n                            q.append((nr, nc))\n                            cells.append((nr, nc))\n                return cells, color\n            for r in range(rows):\n                for c in range(cols):\n                    if grid[r][c] != 0 and grid[r][c] != marker_val and not visited2[r][c]:\n                        color_comps.append(bfs4c(r, c))\n            def is_border(cells):\n                return any(r == 0 or r == rows-1 or c == 0 or c == cols-1 for r, c in cells)\n            border_colors, non_border_colors = set(), set()\n            for cells, color in color_comps:\n                (border_colors if is_border(cells) else non_border_colors).add(color)\n            for cells, color in color_comps:\n                on_border = is_border(cells)\n                if (on_border and color in non_border_colors) or (not on_border and color not in border_colors):\n                    for r, c in cells:\n                        change_cells.add((r, c))\n    result = [row[:] for row in grid]\n    for r, c in change_cells:\n        result[r][c] = 0 if (r, c) == marker_pos else marker_val\n    return result\n```",
  "script": "def solve(grid):\n    import collections\n    rows, cols = len(grid), len(grid[0])\n    marker_val = 2\n    marker_pos = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == marker_val:\n                marker_pos = (r, c)\n    visited = [[False]*cols for _ in range(rows)]\n    comp8_id = [[-1]*cols for _ in range(rows)]\n    components8 = []\n    def bfs8(sr, sc, cid):\n        q = collections.deque([(sr, sc)])\n        visited[sr][sc] = True\n        comp8_id[sr][sc] = cid\n        cells = [(sr, sc)]\n        while q:\n            r, c = q.popleft()\n            for dr in [-1, 0, 1]:\n                for dc in [-1, 0, 1]:\n                    if dr == 0 and dc == 0: continue\n                    nr, nc = r+dr, c+dc\n                    if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] != 0:\n                        visited[nr][nc] = True\n                        comp8_id[nr][nc] = cid\n                        q.append((nr, nc))\n                        cells.append((nr, nc))\n        return cells\n    cid = 0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                components8.append(bfs8(r, c, cid))\n                cid += 1\n    marker_8cid = comp8_id[marker_pos[0]][marker_pos[1]]\n    change_cells = set()\n    for r, c in components8[marker_8cid]:\n        change_cells.add((r, c))\n    remaining = [(i, comp) for i, comp in enumerate(components8) if i != marker_8cid]\n    if remaining:\n        sizes = [len(comp) for _, comp in remaining]\n        max_size = max(sizes)\n        sum_others = sum(sizes) - max_size\n        if max_size > sum_others:\n            for i, comp in remaining:\n                if len(comp) != max_size:\n                    for r, c in comp:\n                        change_cells.add((r, c))\n        else:\n            visited2 = [[False]*cols for _ in range(rows)]\n            color_comps = []\n            def bfs4c(sr, sc):\n                color = grid[sr][sc]\n                q = collections.deque([(sr, sc)])\n                visited2[sr][sc] = True\n                cells = [(sr, sc)]\n                while q:\n                    r, c = q.popleft()\n                    for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited2[nr][nc] and grid[nr][nc] == color:\n                            visited2[nr][nc] = True\n                            q.append((nr, nc))\n                            cells.append((nr, nc))\n                return cells, color\n            for r in range(rows):\n                for c in range(cols):\n                    if grid[r][c] != 0 and grid[r][c] != marker_val and not visited2[r][c]:\n                        color_comps.append(bfs4c(r, c))\n            def is_border(cells):\n                return any(r == 0 or r == rows-1 or c == 0 or c == cols-1 for r, c in cells)\n            border_colors, non_border_colors = set(), set()\n            for cells, color in color_comps:\n                (border_colors if is_border(cells) else non_border_colors).add(color)\n            for cells, color in color_comps:\n                on_border = is_border(cells)\n                if (on_border and color in non_border_colors) or (not on_border and color not in border_colors):\n                    for r, c in cells:\n                        change_cells.add((r, c))\n    result = [row[:] for row in grid]\n    for r, c in change_cells:\n        result[r][c] = 0 if (r, c) == marker_pos else marker_val\n    return result",
