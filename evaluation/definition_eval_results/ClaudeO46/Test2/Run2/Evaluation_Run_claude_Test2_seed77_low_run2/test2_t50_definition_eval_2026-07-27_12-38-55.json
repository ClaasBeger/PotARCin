  "raw_response": "```python\ndef solve(grid):\n    from collections import deque\n    grid = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    special_color = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] not in (0, 5, 7):\n                special_color = grid[r][c]\n                grid[r][c] = 5\n                break\n        if special_color:\n            break\n    \n    five_rows = sorted(set(r for r in range(rows) for c in range(cols) if grid[r][c] == 5))\n    five_cols = sorted(set(c for r in range(rows) for c in range(cols) if grid[r][c] == 5))\n    \n    cell_rows = [(five_rows[i], five_rows[i+1]) for i in range(len(five_rows)-1)]\n    cell_cols = [(five_cols[i], five_cols[i+1]) for i in range(len(five_cols)-1)]\n    nr, nc = len(cell_rows), len(cell_cols)\n    \n    def h_wall(r, c1, c2):\n        return any(grid[r][c] == 7 for c in range(c1+1, c2))\n    \n    def v_wall(c, r1, r2):\n        return any(grid[r][c] == 7 for r in range(r1+1, r2))\n    \n    visited = [[False]*nc for _ in range(nr)]\n    queue = deque()\n    \n    for i in range(nr):\n        for j in range(nc):\n            r1, r2 = cell_rows[i]\n            c1, c2 = cell_cols[j]\n            ext = False\n            if i == 0 and not h_wall(r1, c1, c2): ext = True\n            if i == nr-1 and not h_wall(r2, c1, c2): ext = True\n            if j == 0 and not v_wall(c1, r1, r2): ext = True\n            if j == nc-1 and not v_wall(c2, r1, r2): ext = True\n            if ext:\n                visited[i][j] = True\n                queue.append((i, j))\n    \n    while queue:\n        i, j = queue.popleft()\n        r1, r2 = cell_rows[i]\n        c1, c2 = cell_cols[j]\n        for di, dj in [(-1,0),(1,0),(0,-1),(0,1)]:\n            ni, nj = i+di, j+dj\n            if 0 <= ni < nr and 0 <= nj < nc and not visited[ni][nj]:\n                wall = False\n                if di == -1: wall = h_wall(r1, c1, c2)\n                e