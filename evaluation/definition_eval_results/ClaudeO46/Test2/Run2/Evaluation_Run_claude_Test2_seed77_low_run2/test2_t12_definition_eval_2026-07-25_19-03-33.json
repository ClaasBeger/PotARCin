         for pr,pc in tp:\n                    if(pr,pc)in sp: continue\n                    sp.add((pr,pc)); npr,npc=pr+dr,pc+dc\n                    if npr<0 or npr>=rows or npc<0 or npc>=cols or(npr,npc)in nine_cells: ok=False; break\n                    pushes.append(((pr,pc),(npr,npc)))\n                    if g2[npr][npc]!=0 and(npr,npc)not in ns and(npr,npc)not in sp: nxt.append((npr,npc))\n                if not ok: break\n                tp=nxt\n            if not ok: break\n            for(pr,pc),(npr,npc) in reversed(pushes): g2[npr][npc]=g2[pr][pc]; g2[pr][pc]=0\n            cur=nc2; k+=1\n        return k\n    best=[]\n    for dr,dc in directions:\n        k=try_dir(dr,dc); best.append((k,(dr,dc)in perp_dirs,dr,dc))\n    best.sort(key=lambda x:(x[0],x[1]),reverse=True)\n    bk,_,bdr,bdc=best[0]\n    if bk==0: return grid\n    result=[row[:] for row in grid]\n    for r,c in shape_set: result[r][c]=0\n    cur={(r,c):grid[r][c] for r,c in shape_set}\n    for _ in range(bk):\n        nc2={(r+bdr,c+bdc):v for(r,c),v in cur.items()}\n        ns=set(nc2.keys()); os=set(cur.keys()); entering=ns-os\n        tp=[(nr,nc) for nr,nc in entering if result[nr][nc]!=0]; pushes=[]; sp=set()\n        while tp:\n            nxt=[]\n            for pr,pc in tp:\n                if(pr,pc)in sp: continue\n                sp.add((pr,pc)); npr,npc=pr+bdr,pc+bdc\n                pushes.append(((pr,pc),(npr,npc)))\n                if result[npr][npc]!=0 and(npr,npc)not in ns and(npr,npc)not in sp: nxt.append((npr,npc))\n            tp=nxt\n        for(pr,pc),(npr,npc) in reversed(pushes): result[npr][npc]=result[pr][pc]; result[pr][pc]=0\n        cur=nc2\n    for(r,c),v in cur.items(): result[r][c]=v\n    return result",
