  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    fives = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5:\n                fives.append((r, c))\n    \n    mid_row = (fives[0][0] + fives[1][0]) / 2\n    \n    color_cells = {}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v not in (0, 5):\n                color_cells.setdefault(v, []).append((r, c))\n    \n    group_a = []\n    group_b = []\n    for color, cells in color_cells.items():\n        centroid_r = sum(r for r, c in cells) / len(cells)\n        if centroid_r < mid_row:\n            group_a.append(color)\n        else:\n            group_b.append(color)\n    \n    out = [[0]*cols for _ in range(rows)]\n    \n    for group_colors, other_five_idx in [(group_a, 1), (group_b, 0)]:\n        if not group_colors:\n            continue\n        \n        all_cells = []\n        for color in group_colors:\n            all_cells.extend(color_cells[color])\n        \n        min_r = min(r for r, c in all_cells)\n        max_r = max(r for r, c in all_cells)\n        min_c = min(c for r, c in all_cells)\n        max_c = max(c for r, c in all_cells)\n        \n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n        \n        if h == 1 or w == 1:\n            size = max(h, w)\n            of = fives[other_five_idx]\n            if w == 1:\n                if of[1] > min_c:\n                    max_c = min_c + size - 1\n                else:\n                    min_c = max_c - size + 1\n            else:\n                if of[0] > min_r:\n                    max_r = min_r + size - 1\n                else:\n                    min_r = max_r - size + 1\n        \n        fill = group_colors[0] if len(group_colors) == 1 else 5\n        \n        for r in range(min_r, max_r + 1):\n            for c in range(min_c, max_c + 1):\n                out[r][c] = fill\n    \n    for r, c in fives:\n        out[r][c] = 5\n    \n    return out\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    fives = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5:\n                fives.append((r, c))\n    \n    mid_row = (fives[0][0] + fives[1][0]) / 2\n    \n    color_cells = {}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v not in (0, 5):\n                color_cells.setdefault(v, []).append((r, c))\n    \n    group_a = []\n    group_b = []\n    for color, cells in color_cells.items():\n        centroid_r = sum(r for r, c in cells) / len(cells)\n        if centroid_r < mid_row:\n            group_a.append(color)\n        else:\n            group_b.append(color)\n    \n    out = [[0]*cols for _ in range(rows)]\n    \n    for group_colors, other_five_idx in [(group_a, 1), (group_b, 0)]:\n        if not group_colors:\n            continue\n        \n        all_cells = []\n        for color in group_colors:\n            all_cells.extend(color_cells[color])\n        \n        min_r = min(r for r, c in all_cells)\n        max_r = max(r for r, c in all_cells)\n        min_c = min(c for r, c in all_cells)\n        max_c = max(c for r, c in all_cells)\n        \n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n        \n        if h == 1 or w == 1:\n            size = max(h, w)\n            of = fives[other_five_idx]\n            if w == 1:\n                if of[1] > min_c:\n                    max_c = min_c + size - 1\n                else:\n                    min_c = max_c - size + 1\n            else:\n                if of[0] > min_r:\n                    max_r = min_r + size - 1\n                else:\n                    min_r = max_r - size + 1\n        \n        fill = group_colors[0] if len(group_colors) == 1 else 5\n        \n        for r in range(min_r, max_r + 1):\n            for c in range(min_c, max_c + 1):\n                out[r][c] = fill\n    \n    for r, c in fives:\n        out[r][c] = 5\n    \n    return out",
