  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    twos = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    min_r2 = min(r for r, c in twos)\n    max_r2 = max(r for r, c in twos)\n    min_c2 = min(c for r, c in twos)\n    max_c2 = max(c for r, c in twos)\n    \n    int_r1, int_r2 = min_r2 + 1, max_r2 - 1\n    int_c1, int_c2 = min_c2 + 1, max_c2 - 1\n    h_int = int_r2 - int_r1 + 1\n    w_int = int_c2 - int_c1 + 1\n    \n    interior = []\n    for r in range(int_r1, int_r2 + 1):\n        interior.append([grid[r][c] for c in range(int_c1, int_c2 + 1)])\n    \n    scale_r = rows // h_int\n    scale_c = cols // w_int\n    \n    box_center_r = (min_r2 + max_r2) / 2.0\n    box_center_c = (min_c2 + max_c2) / 2.0\n    quad_top = box_center_r < rows / 2.0\n    quad_left = box_center_c < cols / 2.0\n    \n    from collections import defaultdict\n    color_cells = defaultdict(list)\n    for r in range(h_int):\n        for c in range(w_int):\n            if interior[r][c] != 0:\n                color_cells[interior[r][c]].append((r, c))\n    \n    out = [[0] * cols for _ in range(rows)]\n    \n    for color, cells in color_cells.items():\n        min_cr = min(r for r, c in cells)\n        max_cr = max(r for r, c in cells)\n        min_cc = min(c for r, c in cells)\n        max_cc = max(c for r, c in cells)\n        \n        box_r1 = min_cr * scale_r\n        box_r2 = (max_cr + 1) * scale_r - 1\n        box_c1 = min_cc * scale_c\n        box_c2 = (max_cc + 1) * scale_c - 1\n        \n        for r in range(box_r1, box_r2 + 1):\n            for c in range(box_c1, box_c2 + 1):\n                if r == box_r1 or r == box_r2 or c == box_c1 or c == box_c2:\n                    out[r][c] = color\n        \n        ib_r1, ib_r2 = box_r1 + 1, box_r2 - 1\n        ib_c1, ib_c2 = box_c1 + 1, box_c2 - 1\n        ih = ib_r2 - ib_r1 + 1\n        iw = ib_c2 - ib_c1 + 1\n        half_h = ih // 2\n        half_w = iw // 2\n    