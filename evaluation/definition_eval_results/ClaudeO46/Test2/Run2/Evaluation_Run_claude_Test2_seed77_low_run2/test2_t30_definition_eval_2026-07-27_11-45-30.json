= nbr8 if use_8 else nbr4\n    \n    if cumulative:\n        first_ne = sorted_ne[0]\n        if first_ne == 0:\n            seed = section_cells[0]\n        else:\n            smallest = section_cells[first_ne]\n            if len(sorted_ne) >= 2:\n                nxt_new = section_cells[sorted_ne[1]] - smallest\n                frontier = {c for c in smallest if any(n in nxt_new for n in nbr(*c))}\n                core = smallest - frontier\n                seed = core if core else smallest\n            else:\n                seed = smallest\n        \n        dist = do_bfs(seed, composite, nbr)\n        \n        growth_rate = 1\n        for idx in sorted_ne:\n            if idx == 0: continue\n            md = max((dist.get(c, 0) for c in section_cells[idx]), default=0)\n            if idx > 0:\n                growth_rate = max(1, round(md / idx))\n                break\n        \n        for ei in empty_indices:\n            section_cells[ei] = {c for c, d in dist.items() if d <= ei * growth_rate}\n    \n    else:\n        seed_idx = sorted_ne[0]\n        current = section_cells[seed_idx]\n        cum = set(current)\n        parent = {c: None for c in current}\n        \n        for idx in range(seed_idx + 1, n_sec):\n            frontier = set()\n            for r, c in current:\n                for nr, nc in nbr(r, c):\n                    if 0 <= nr < sec_h and 0 <= nc < cols and (nr, nc) not in cum:\n                        frontier.add((nr, nc))\n            \n            if idx in empty_indices:\n                is_edge = all(j in empty_indices for j in range(idx, n_sec))\n                if is_edge and len(frontier) > len(current):\n                    dir_f = set()\n                    for r, c in current:\n                        p = parent.get((r, c))\n                        if p:\n                            dr, dc = r - p[0], c - p[1]\n                            nr, nc = r + dr, c + dc\n                            if (nr, nc) in frontier:\n                                dir_f.add((nr, nc))\n                    if dir_f:\n                        frontier = dir_f\n                section_cells[idx] = frontier\n            \n            for fc in section_cells[idx]:\n                if fc not in parent:\n                    for nr, nc in nbr(*fc):\n                        if (nr, nc) in current:\n                            parent[fc] = (nr, nc)\n                            break\n            \n            cum |= section_cells[idx]\n            current = section_cells[idx]\n    \n    output = [row[:] for row in grid]\n    for i in empty_indices:\n        s = sec_starts[i]\n        sh = len(sections[i])\n        for r in range(sh):\n            for c in range(cols):\n                output[s + r][c] = color if (r, c) in section_cells[i] else 0\n    \n    return output",
