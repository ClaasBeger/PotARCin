  "raw_response": "```python\ndef solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    quadrants = [[], [], [], []]\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                qr = 0 if r < rows//2 else 1\n                qc = 0 if c < cols//2 else 1\n                quadrants[qr*2+qc].append((r, c, grid[r][c]))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for qi in range(4):\n        cells = quadrants[qi]\n        if not cells:\n            continue\n        rs = [c[0] for c in cells]\n        cs = [c[1] for c in cells]\n        \n        if qi == 0:\n            dr = (rows//2 - 1) - max(rs)\n            dc = (cols//2 - 1) - max(cs)\n        elif qi == 1:\n            dr = (rows//2 - 1) - max(rs)\n            dc = (cols//2) - min(cs)\n        elif qi == 2:\n            dr = (rows//2) - min(rs)\n            dc = (cols//2 - 1) - max(cs)\n        else:\n            dr = (rows//2) - min(rs)\n            dc = (cols//2) - min(cs)\n        \n        for r, c, v in cells:\n            result[r+dr][c+dc] = v\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    quadrants = [[], [], [], []]\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                qr = 0 if r < rows//2 else 1\n                qc = 0 if c < cols//2 else 1\n                quadrants[qr*2+qc].append((r, c, grid[r][c]))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for qi in range(4):\n        cells = quadrants[qi]\n        if not cells:\n            continue\n        rs = [c[0] for c in cells]\n        cs = [c[1] for c in cells]\n        \n        if qi == 0:\n            dr = (rows//2 - 1) - max(rs)\n            dc = (cols//2 - 1) - max(cs)\n        elif qi == 1:\n            dr = (rows//2 - 1) - max(rs)\n            dc = (cols//2) - min(cs)\n        elif qi == 2:\n            dr = (rows//2) - min(rs)\n            dc = (cols//2 - 1) - max(cs)\n        else:\n            dr = (rows//2) - min(rs)\n            dc = (cols//2) - min(cs)\n        \n        for r, c, v in cells:\n            result[r+dr][c+dc] = v\n    \n    return result",
