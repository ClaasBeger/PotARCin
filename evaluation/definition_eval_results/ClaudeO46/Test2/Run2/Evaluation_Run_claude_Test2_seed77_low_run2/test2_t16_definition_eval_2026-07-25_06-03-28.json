  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    color = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] not in (0, 5):\n                color = grid[r][c]\n                break\n        if color is not None:\n            break\n    \n    if color is None:\n        return [row[:] for row in grid]\n    \n    from collections import deque\n    from itertools import combinations\n    \n    def find_components(val):\n        visited = [[False]*cols for _ in range(rows)]\n        comps = []\n        for r in range(rows):\n            for c in range(cols):\n                if grid[r][c] == val and not visited[r][c]:\n                    comp = set()\n                    q = deque([(r, c)])\n                    visited[r][c] = True\n                    while q:\n                        cr, cc = q.popleft()\n                        comp.add((cr, cc))\n                        for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                            nr, nc = cr+dr, cc+dc\n                            if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == val:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n                    comps.append(comp)\n        return comps\n    \n    markers = find_components(color)\n    fives = find_components(5)\n    \n    def normalize(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        return frozenset((r - min_r, c - min_c) for r, c in cells)\n    \n    def get_orientations(shape):\n        orients = set()\n        cells = list(shape)\n        for _ in range(4):\n            cells = [(c, -r) for r, c in cells]\n            orients.add(normalize(cells))\n            orients.add(normalize([(r, -c) for r, c in cells]))\n        return list(orients)\n    \n    marker_norms = [normalize(m) for m in markers]\n    marker_orients = [get_orientations(mn) for mn in marker_norms]\n    \n    def can_tile(target_set, m_indices):\n        total = sum(len(marker_norms[i]) for i in m_indices)\n        if total != len(target_set):\n            return False\n        \n        def bt(remaining, unused):\n            if not remaining and not unused:\n                return True\n            if not remaining or not unused:\n                return False\n            first = min(remaining)\n            fr, fc = first\n            for idx in list(unused):\n                for orient in marker_orients[idx]:\n                    for ar, ac in orient:\n                        placed = frozenset((fr - ar + r, fc - ac + c) for r, c in orient)\n                        if placed.issubset(remaining):\n                            if bt(remaining - placed, unused - {idx}):\n                                return True\n            return False\n        \n        return bt(frozenset(target_set), frozenset(m_indices))\n    \n    result = [row[:] for row in grid]\n    \n    for fi, five_comp in enumerate(fives):\n        five_size = len(five_comp)\n        five_norm = normalize(five_comp)\n        found = False\n        for k in range(1, len(markers) + 1):\n            for subset in combinations(range(len(markers)), k):\n                if sum(len(marker_norms[i]) for i in subset) == five_size:\n                    if can_tile(five_norm, list(subset)):\n                        for r, c in five_comp:\n                            result[r][c] = color\n                        found = True\n                        break\n            if found:\n                break\n    \n    for m in markers:\n        for r, c in m:\n            result[r][c] = 0\n    \n    return result",
