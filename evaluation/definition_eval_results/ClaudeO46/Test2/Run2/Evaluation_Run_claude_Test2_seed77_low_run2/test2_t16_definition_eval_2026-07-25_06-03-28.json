ntations(mn) for mn in marker_norms]\n    \n    def can_tile(target_set, m_indices):\n        total = sum(len(marker_norms[i]) for i in m_indices)\n        if total != len(target_set):\n            return False\n        \n        def bt(remaining, unused):\n            if not remaining and not unused:\n                return True\n            if not remaining or not unused:\n                return False\n            first = min(remaining)\n            fr, fc = first\n            for idx in list(unused):\n                for orient in marker_orients[idx]:\n                    for ar, ac in orient:\n                        placed = frozenset((fr - ar + r, fc - ac + c) for r, c in orient)\n                        if placed.issubset(remaining):\n                            if bt(remaining - placed, unused - {idx}):\n                                return True\n            return False\n        \n        return bt(frozenset(target_set), frozenset(m_indices))\n    \n    result = [row[:] for row in grid]\n    \n    for fi, five_comp in enumerate(fives):\n        five_size = len(five_comp)\n        five_norm = normalize(five_comp)\n        found = False\n        for k in range(1, len(markers) + 1):\n            for subset in combinations(range(len(markers)), k):\n                if sum(len(marker_norms[i]) for i in subset) == five_size:\n                    if can_tile(five_norm, list(subset)):\n                        for r, c in five_comp:\n                            result[r][c] = color\n                        found = True\n                        break\n            if found:\n                break\n    \n    for m in markers:\n        for r, c in m:\n            result[r][c] = 0\n    \n    return result",
