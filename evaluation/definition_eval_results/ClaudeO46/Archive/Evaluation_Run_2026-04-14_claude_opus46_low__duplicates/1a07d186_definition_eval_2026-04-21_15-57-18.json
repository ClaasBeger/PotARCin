  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find horizontal and vertical lines\n    h_lines = {}  # row -> color\n    v_lines = {}  # col -> color\n    \n    for r in range(rows):\n        counts = {}\n        for c in range(cols):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] = counts.get(grid[r][c], 0) + 1\n        for color, cnt in counts.items():\n            if cnt == cols:\n                h_lines[r] = color\n    \n    for c in range(cols):\n        counts = {}\n        for r in range(rows):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] = counts.get(grid[r][c], 0) + 1\n        for color, cnt in counts.items():\n            if cnt == rows:\n                v_lines[c] = color\n    \n    # Find stray points (not on any line)\n    strays = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and r not in h_lines and c not in v_lines:\n                strays.append((r, c, grid[r][c]))\n    \n    # Create output with just the lines\n    out = [[0]*cols for _ in range(rows)]\n    for r in h_lines:\n        for c in range(cols):\n            out[r][c] = h_lines[r]\n    for c in v_lines:\n        for r in range(rows):\n            out[r][c] = v_lines[c]\n    \n    # For each stray, find nearest line of same color and move it adjacent\n    for r, c, color in strays:\n        # Find nearest horizontal or vertical line of same color\n        best_dist = float('inf')\n        best_pos = None\n        \n        for lr, lc in h_lines.items():\n            if lc == color:\n                dist = abs(r - lr)\n                if dist < best_dist:\n                    best_dist = dist\n                    if r < lr:\n                        best_pos = (lr - 1, c)\n                    else:\n                        best_pos = (lr + 1, c)\n        \n        for lc, lcolor in v_lines.items():\n            if lcolor == color:\n                dist = abs(c - lc)\n                if dist < best_dist:\n                    best_dist = dist\n                    if c < lc:\n                        best_pos = (r, lc - 1)\n                    else:\n                        best_pos = (r, lc + 1)\n        \n        if best_pos:\n            br, bc = best_pos\n            out[br][bc] = color\n    \n    return out",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find horizontal and vertical lines\n    h_lines = {}  # row -> color\n    v_lines = {}  # col -> color\n    \n    for r in range(rows):\n        counts = {}\n        for c in range(cols):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] = counts.get(grid[r][c], 0) + 1\n        for color, cnt in counts.items():\n            if cnt == cols:\n                h_lines[r] = color\n    \n    for c in range(cols):\n        counts = {}\n        for r in range(rows):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] = counts.get(grid[r][c], 0) + 1\n        for color, cnt in counts.items():\n            if cnt == rows:\n                v_lines[c] = color\n    \n    # Find stray points (not on any line)\n    strays = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and r not in h_lines and c not in v_lines:\n                strays.append((r, c, grid[r][c]))\n    \n    # Create output with just the lines\n    out = [[0]*cols for _ in range(rows)]\n    for r in h_lines:\n        for c in range(cols):\n            out[r][c] = h_lines[r]\n    for c in v_lines:\n        for r in range(rows):\n            out[r][c] = v_lines[c]\n    \n    # For each stray, find nearest line of same color and move it adjacent\n    for r, c, color in strays:\n        # Find nearest horizontal or vertical line of same color\n        best_dist = float('inf')\n        best_pos = None\n        \n        for lr, lc in h_lines.items():\n            if lc == color:\n                dist = abs(r - lr)\n                if dist < best_dist:\n                    best_dist = dist\n                    if r < lr:\n                        best_pos = (lr - 1, c)\n                    else:\n                        best_pos = (lr + 1, c)\n        \n        for lc, lcolor in v_lines.items():\n            if lcolor == color:\n                dist = abs(c - lc)\n                if dist < best_dist:\n                    best_dist = dist\n                    if c < lc:\n                        best_pos = (r, lc - 1)\n                    else:\n                        best_pos = (r, lc + 1)\n        \n        if best_pos:\n            br, bc = best_pos\n            out[br][bc] = color\n    \n    return out",
