  "raw_response": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    result = g.copy()\n    \n    # Find enclosed regions of 0s surrounded by 3s\n    # Use flood fill from edges to find exterior 0s\n    from collections import deque\n    \n    # For each connected component of 0s, check if it's enclosed by 3s\n    visited = np.zeros_like(g, dtype=bool)\n    \n    # First, find all 0s reachable from edges (exterior)\n    exterior = np.zeros_like(g, dtype=bool)\n    q = deque()\n    for r in range(rows):\n        for c in range(cols):\n            if (r == 0 or r == rows-1 or c == 0 or c == cols-1) and g[r,c] == 0:\n                if not exterior[r,c]:\n                    exterior[r,c] = True\n                    q.append((r,c))\n    \n    while q:\n        r,c = q.popleft()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            nr,nc = r+dr,c+dc\n            if 0<=nr<rows and 0<=nc<cols and not exterior[nr,nc] and g[nr,nc]==0:\n                exterior[nr,nc] = True\n                q.append((nr,nc))\n    \n    # Find connected components of interior 0s\n    visited = np.zeros_like(g, dtype=bool)\n    for r in range(rows):\n        for c in range(cols):\n            if g[r,c] == 0 and not exterior[r,c] and not visited[r,c]:\n                # BFS to find this component\n                comp = []\n                q2 = deque([(r,c)])\n                visited[r,c] = True\n                while q2:\n                    cr,cc = q2.popleft()\n                    comp.append((cr,cc))\n                    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        nr,nc = cr+dr,cc+dc\n                        if 0<=nr<rows and 0<=nc<cols and not visited[nr,nc] and g[nr,nc]==0 and not exterior[nr,nc]:\n                            visited[nr,nc] = True\n                            q2.append((nr,nc))\n                \n                # Check if this region is bounded by a rectangular-ish border of 3s\n                # Fill with 4\n                for cr,cc in comp:\n                    result[cr][cc] = 4\n    \n    return result.tolist()",
  "script": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    result = g.copy()\n    \n    # Find enclosed regions of 0s surrounded by 3s\n    # Use flood fill from edges to find exterior 0s\n    from collections import deque\n    \n    # For each connected component of 0s, check if it's enclosed by 3s\n    visited = np.zeros_like(g, dtype=bool)\n    \n    # First, find all 0s reachable from edges (exterior)\n    exterior = np.zeros_like(g, dtype=bool)\n    q = deque()\n    for r in range(rows):\n        for c in range(cols):\n            if (r == 0 or r == rows-1 or c == 0 or c == cols-1) and g[r,c] == 0:\n                if not exterior[r,c]:\n                    exterior[r,c] = True\n                    q.append((r,c))\n    \n    while q:\n        r,c = q.popleft()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            nr,nc = r+dr,c+dc\n            if 0<=nr<rows and 0<=nc<cols and not exterior[nr,nc] and g[nr,nc]==0:\n                exterior[nr,nc] = True\n                q.append((nr,nc))\n    \n    # Find connected components of interior 0s\n    visited = np.zeros_like(g, dtype=bool)\n    for r in range(rows):\n        for c in range(cols):\n            if g[r,c] == 0 and not exterior[r,c] and not visited[r,c]:\n                # BFS to find this component\n                comp = []\n                q2 = deque([(r,c)])\n                visited[r,c] = True\n                while q2:\n                    cr,cc = q2.popleft()\n                    comp.append((cr,cc))\n                    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        nr,nc = cr+dr,cc+dc\n                        if 0<=nr<rows and 0<=nc<cols and not visited[nr,nc] and g[nr,nc]==0 and not exterior[nr,nc]:\n                            visited[nr,nc] = True\n                            q2.append((nr,nc))\n                \n                # Check if this region is bounded by a rectangular-ish border of 3s\n                # Fill with 4\n                for cr,cc in comp:\n                    result[cr][cc] = 4\n    \n    return result.tolist()",
