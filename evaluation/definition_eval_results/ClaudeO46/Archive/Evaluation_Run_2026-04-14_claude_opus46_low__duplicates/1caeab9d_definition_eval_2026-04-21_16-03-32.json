positions = np.argwhere(g == c)\n        if len(positions) > 0:\n            colors[c] = positions\n    \n    # Color 1 is the anchor - find its row range\n    anchor = colors[1]\n    anchor_rmin = anchor[:, 0].min()\n    anchor_rmax = anchor[:, 0].max()\n    \n    result = np.zeros_like(g)\n    \n    for c, pos in colors.items():\n        rmin = pos[:, 0].min()\n        row_shift = anchor_rmin - rmin\n        for r, col in pos:\n            nr = r + row_shift\n            if 0 <= nr < rows:\n                result[nr][col] = c\n    \n    return result.tolist()\n```",
  "script": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    \n    # Find bounding box for each color\n    colors = {}\n    for c in [1, 2, 4]:\n        positions = np.argwhere(g == c)\n        if len(positions) > 0:\n            colors[c] = positions\n    \n    # Color 1 is the anchor - find its row range\n    anchor = colors[1]\n    anchor_rmin = anchor[:, 0].min()\n    anchor_rmax = anchor[:, 0].max()\n    \n    result = np.zeros_like(g)\n    \n    for c, pos in colors.items():\n        rmin = pos[:, 0].min()\n        row_shift = anchor_rmin - rmin\n        for r, col in pos:\n            nr = r + row_shift\n            if 0 <= nr < rows:\n                result[nr][col] = c\n    \n    return result.tolist()",
