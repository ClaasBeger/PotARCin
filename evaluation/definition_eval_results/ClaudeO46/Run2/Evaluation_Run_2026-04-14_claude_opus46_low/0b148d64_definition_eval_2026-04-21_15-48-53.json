  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    # Find separator rows/cols of all zeros\n    zero_rows = [r for r in range(rows) if all(v == 0 for v in grid[r])]\n    zero_cols = [c for c in range(cols) if all(grid[r][c] == 0 for r in range(rows))]\n    \n    # Find quadrants - regions separated by zero rows/cols\n    # Group consecutive zero rows/cols\n    def get_ranges(size, zeros):\n        regions = []\n        i = 0\n        while i < size:\n            if i in zeros:\n                i += 1\n                continue\n            j = i\n            while j < size and j not in zeros:\n                j += 1\n            regions.append((i, j))\n            i = j\n        return regions\n    \n    row_ranges = get_ranges(rows, set(zero_rows))\n    col_ranges = get_ranges(cols, set(zero_cols))\n    \n    # Extract quadrants and find the one with non-0/8/1 colors (not background)\n    # Find quadrant that has a unique color (not 0 and not the majority)\n    quadrants = {}\n    for ri, (r1, r2) in enumerate(row_ranges):\n        for ci, (c1, c2) in enumerate(col_ranges):\n            block = []\n            for r in range(r1, r2):\n                block.append([grid[r][c] for c in range(c1, c2)])\n            quadrants[(ri, ci)] = block\n    \n    # Find which quadrant has all zeros (separator) vs content\n    # Look for quadrant with unique non-zero color\n    def get_colors(block):\n        colors = set()\n        for row in block:\n            for v in row:\n                if v != 0:\n                    colors.add(v)\n        return colors\n    \n    # Find the quadrant whose non-zero values appear only in that quadrant\n    all_colors = {}\n    for key, block in quadrants.items():\n        for c in get_colors(block):\n            if c not in all_colors:\n                all_colors[c] = []\n            all_colors[c].append(key)\n    \n    # Find color that appears in exactly one quadrant (the special one)\n    for color, keys in all_colors.items():\n        if len(keys) == 1:\n            return quadrants[keys[0]]\n    \n    # Fallback: return largest non-all-zero quadrant with fewest zeros\n    best = None\n    best_count = -1\n    for key, block in quadrants.items():\n        c = sum(1 for row in block for v in row if v != 0)\n        if c > best_count:\n            best_count = c\n            best = block\n    return best",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    # Find separator rows/cols of all zeros\n    zero_rows = [r for r in range(rows) if all(v == 0 for v in grid[r])]\n    zero_cols = [c for c in range(cols) if all(grid[r][c] == 0 for r in range(rows))]\n    \n    # Find quadrants - regions separated by zero rows/cols\n    # Group consecutive zero rows/cols\n    def get_ranges(size, zeros):\n        regions = []\n        i = 0\n        while i < size:\n            if i in zeros:\n                i += 1\n                continue\n            j = i\n            while j < size and j not in zeros:\n                j += 1\n            regions.append((i, j))\n            i = j\n        return regions\n    \n    row_ranges = get_ranges(rows, set(zero_rows))\n    col_ranges = get_ranges(cols, set(zero_cols))\n    \n    # Extract quadrants and find the one with non-0/8/1 colors (not background)\n    # Find quadrant that has a unique color (not 0 and not the majority)\n    quadrants = {}\n    for ri, (r1, r2) in enumerate(row_ranges):\n        for ci, (c1, c2) in enumerate(col_ranges):\n            block = []\n            for r in range(r1, r2):\n                block.append([grid[r][c] for c in range(c1, c2)])\n            quadrants[(ri, ci)] = block\n    \n    # Find which quadrant has all zeros (separator) vs content\n    # Look for quadrant with unique non-zero color\n    def get_colors(block):\n        colors = set()\n        for row in block:\n            for v in row:\n                if v != 0:\n                    colors.add(v)\n        return colors\n    \n    # Find the quadrant whose non-zero values appear only in that quadrant\n    all_colors = {}\n    for key, block in quadrants.items():\n        for c in get_colors(block):\n            if c not in all_colors:\n                all_colors[c] = []\n            all_colors[c].append(key)\n    \n    # Find color that appears in exactly one quadrant (the special one)\n    for color, keys in all_colors.items():\n        if len(keys) == 1:\n            return quadrants[keys[0]]\n    \n    # Fallback: return largest non-all-zero quadrant with fewest zeros\n    best = None\n    best_count = -1\n    for key, block in quadrants.items():\n        c = sum(1 for row in block for v in row if v != 0)\n        if c > best_count:\n            best_count = c\n            best = block\n    return best",
