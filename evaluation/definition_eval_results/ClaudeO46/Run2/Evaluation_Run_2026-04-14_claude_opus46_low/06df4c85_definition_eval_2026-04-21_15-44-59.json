  "raw_response": "def solve(grid):\n    import copy\n    grid = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find grid separator value and cell size\n    # Determine cell positions\n    # Find separator rows/cols\n    sep_val = grid[2][0]  # the separator value\n    \n    # Find separator row indices\n    sep_rows = [r for r in range(rows) if all(grid[r][c] == sep_val for c in range(cols))]\n    sep_cols = [c for c in range(cols) if all(grid[r][c] == sep_val for r in range(rows))]\n    \n    # Get cell blocks between separators\n    def get_blocks(seps, total):\n        blocks = []\n        prev = -1\n        for s in seps:\n            if s - prev > 1:\n                blocks.append((prev+1, s-1))\n            prev = s\n        if prev < total - 1:\n            blocks.append((prev+1, total-1))\n        return blocks\n    \n    row_blocks = get_blocks(sep_rows, rows)\n    col_blocks = get_blocks(sep_cols, cols)\n    \n    # Read cell values (non-zero, non-sep)\n    def cell_val(rb, cb):\n        r1, r2 = rb\n        c1, c2 = cb\n        for r in range(r1, r2+1):\n            for c in range(c1, c2+1):\n                if grid[r][c] != 0 and grid[r][c] != sep_val:\n                    return grid[r][c]\n        return 0\n    \n    cell_vals = {}\n    for i, rb in enumerate(row_blocks):\n        for j, cb in enumerate(col_blocks):\n            v = cell_val(rb, cb)\n            if v != 0:\n                cell_vals[(i,j)] = v\n    \n    # For each color, find positions and determine if it appears in same row or same column\n    from collections import defaultdict\n    color_positions = defaultdict(list)\n    for (i,j), v in cell_vals.items():\n        color_positions[v].append((i,j))\n    \n    # For colors with exactly 2 occurrences in same row, fill between them\n    # For colors with more, figure out the pattern\n    # Rule: for each color with 2+ occurrences sharing a row, fill that row between min and max col\n    # Same for column\n    \n    def set_cell(i, j, v):\n        rb = row_blocks[i]\n        cb = col_blocks[j]\n        for r in range(rb[0], rb[1]+1):\n            for c in range(cb[0], cb[1]+1):\n                grid[r][c] = v\n    \n    for color, positions in color_positions.items():\n        # Group by row\n        row_groups = defaultdict(list)\n        col_groups = defaultdict(list)\n        for (i,j) in positions:\n            row_groups[i].append(j)\n            col_groups[j].append(i)\n        \n        for r, cs in row_groups.items():\n            if len(cs) >= 2:\n                mn, mx = min(cs), max(cs)\n                for c in range(mn, mx+1):\n                    set_cell(r, c, color)\n        \n        for c, rs in col_groups.items():\n            if len(rs) >= 2:\n                mn, mx = min(rs), max(rs)\n                for r in range(mn, mx+1):\n                    set_cell(r, c, color)\n    \n    return grid",
  "script": "def solve(grid):\n    import copy\n    grid = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find grid separator value and cell size\n    # Determine cell positions\n    # Find separator rows/cols\n    sep_val = grid[2][0]  # the separator value\n    \n    # Find separator row indices\n    sep_rows = [r for r in range(rows) if all(grid[r][c] == sep_val for c in range(cols))]\n    sep_cols = [c for c in range(cols) if all(grid[r][c] == sep_val for r in range(rows))]\n    \n    # Get cell blocks between separators\n    def get_blocks(seps, total):\n        blocks = []\n        prev = -1\n        for s in seps:\n            if s - prev > 1:\n                blocks.append((prev+1, s-1))\n            prev = s\n        if prev < total - 1:\n            blocks.append((prev+1, total-1))\n        return blocks\n    \n    row_blocks = get_blocks(sep_rows, rows)\n    col_blocks = get_blocks(sep_cols, cols)\n    \n    # Read cell values (non-zero, non-sep)\n    def cell_val(rb, cb):\n        r1, r2 = rb\n        c1, c2 = cb\n        for r in range(r1, r2+1):\n            for c in range(c1, c2+1):\n                if grid[r][c] != 0 and grid[r][c] != sep_val:\n                    return grid[r][c]\n        return 0\n    \n    cell_vals = {}\n    for i, rb in enumerate(row_blocks):\n        for j, cb in enumerate(col_blocks):\n            v = cell_val(rb, cb)\n            if v != 0:\n                cell_vals[(i,j)] = v\n    \n    # For each color, find positions and determine if it appears in same row or same column\n    from collections import defaultdict\n    color_positions = defaultdict(list)\n    for (i,j), v in cell_vals.items():\n        color_positions[v].append((i,j))\n    \n    # For colors with exactly 2 occurrences in same row, fill between them\n    # For colors with more, figure out the pattern\n    # Rule: for each color with 2+ occurrences sharing a row, fill that row between min and max col\n    # Same for column\n    \n    def set_cell(i, j, v):\n        rb = row_blocks[i]\n        cb = col_blocks[j]\n        for r in range(rb[0], rb[1]+1):\n            for c in range(cb[0], cb[1]+1):\n                grid[r][c] = v\n    \n    for color, positions in color_positions.items():\n        # Group by row\n        row_groups = defaultdict(list)\n        col_groups = defaultdict(list)\n        for (i,j) in positions:\n            row_groups[i].append(j)\n            col_groups[j].append(i)\n        \n        for r, cs in row_groups.items():\n            if len(cs) >= 2:\n                mn, mx = min(cs), max(cs)\n                for c in range(mn, mx+1):\n                    set_cell(r, c, color)\n        \n        for c, rs in col_groups.items():\n            if len(rs) >= 2:\n                mn, mx = min(rs), max(rs)\n                for r in range(mn, mx+1):\n                    set_cell(r, c, color)\n    \n    return grid",
