  "raw_response": "```python\ndef solve(grid):\n    from collections import Counter\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find all non-zero colors and their bounding boxes/areas\n    colors = {}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0:\n                if v not in colors:\n                    colors[v] = [r, r, c, c, 0]\n                colors[v][0] = min(colors[v][0], r)\n                colors[v][1] = max(colors[v][1], r)\n                colors[v][2] = min(colors[v][2], c)\n                colors[v][3] = max(colors[v][3], c)\n                colors[v][4] += 1\n\n    # Find the smallest region by cell count\n    smallest = min(colors, key=lambda v: colors[v][4])\n    r0, r1, c0, c1 = colors[smallest][:4]\n    \n    result = []\n    for r in range(r0, r1+1):\n        row = []\n        for c in range(c0, c1+1):\n            row.append(smallest)\n        result.append(row)\n    return result\n```",
  "script": "def solve(grid):\n    from collections import Counter\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find all non-zero colors and their bounding boxes/areas\n    colors = {}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0:\n                if v not in colors:\n                    colors[v] = [r, r, c, c, 0]\n                colors[v][0] = min(colors[v][0], r)\n                colors[v][1] = max(colors[v][1], r)\n                colors[v][2] = min(colors[v][2], c)\n                colors[v][3] = max(colors[v][3], c)\n                colors[v][4] += 1\n\n    # Find the smallest region by cell count\n    smallest = min(colors, key=lambda v: colors[v][4])\n    r0, r1, c0, c1 = colors[smallest][:4]\n    \n    result = []\n    for r in range(r0, r1+1):\n        row = []\n        for c in range(c0, c1+1):\n            row.append(smallest)\n        result.append(row)\n    return result",
