  "raw_response": "def solve(grid):\n    from collections import defaultdict\n    points = defaultdict(list)\n    rows, cols = len(grid), len(grid[0])\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]: points[grid[r][c]].append((r,c))\n    out = [[0]*cols for _ in range(rows)]\n    for v, pts in points.items():\n        r1,c1 = pts[0]; r2,c2 = pts[1]\n        for r in range(min(r1,r2), max(r1,r2)+1):\n            for c in range(min(c1,c2), max(c1,c2)+1):\n                out[r][c] = v\n    return out",
  "script": "def solve(grid):\n    from collections import defaultdict\n    points = defaultdict(list)\n    rows, cols = len(grid), len(grid[0])\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]: points[grid[r][c]].append((r,c))\n    out = [[0]*cols for _ in range(rows)]\n    for v, pts in points.items():\n        r1,c1 = pts[0]; r2,c2 = pts[1]\n        for r in range(min(r1,r2), max(r1,r2)+1):\n            for c in range(min(c1,c2), max(c1,c2)+1):\n                out[r][c] = v\n    return out",
