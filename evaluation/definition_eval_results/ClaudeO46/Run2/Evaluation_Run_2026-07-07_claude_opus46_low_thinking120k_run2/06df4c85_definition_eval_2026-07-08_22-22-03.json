  "raw_response": "def solve(grid):\n    import copy\n    from collections import defaultdict\n    \n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    sep = grid[2][0]\n    \n    cell_rows, cell_cols = [], []\n    r = 0\n    while r < rows:\n        if grid[r][0] != sep:\n            cell_rows.append(r)\n            r += 2\n        r += 1\n    c = 0\n    while c < cols:\n        if grid[0][c] != sep:\n            cell_cols.append(c)\n            c += 2\n        c += 1\n    \n    cells = {}\n    for i, r in enumerate(cell_rows):\n        for j, c in enumerate(cell_cols):\n            if grid[r][c] not in (0, sep):\n                cells[(i,j)] = grid[r][c]\n    \n    color_cells = defaultdict(list)\n    for k, v in cells.items():\n        color_cells[v].append(k)\n    \n    for color, positions in color_cells.items():\n        rg = defaultdict(list)\n        cg = defaultdict(list)\n        for i,j in positions:\n            rg[i].append(j)\n            cg[j].append(i)\n        for i, js in rg.items():\n            if len(js)>=2:\n                for j in range(min(js), max(js)+1):\n                    cells.setdefault((i,j), color)\n        for j, is_ in cg.items():\n            if len(is_)>=2:\n                for i in range(min(is_), max(is_)+1):\n                    cells.setdefault((i,j), color)\n    \n    for (i,j), color in cells.items():\n        r, c = cell_rows[i], cell_cols[j]\n        for dr in range(2):\n            for dc in range(2):\n                result[r+dr][c+dc] = color\n    return result",
  "script": "def solve(grid):\n    import copy\n    from collections import defaultdict\n    \n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    sep = grid[2][0]\n    \n    cell_rows, cell_cols = [], []\n    r = 0\n    while r < rows:\n        if grid[r][0] != sep:\n            cell_rows.append(r)\n            r += 2\n        r += 1\n    c = 0\n    while c < cols:\n        if grid[0][c] != sep:\n            cell_cols.append(c)\n            c += 2\n        c += 1\n    \n    cells = {}\n    for i, r in enumerate(cell_rows):\n        for j, c in enumerate(cell_cols):\n            if grid[r][c] not in (0, sep):\n                cells[(i,j)] = grid[r][c]\n    \n    color_cells = defaultdict(list)\n    for k, v in cells.items():\n        color_cells[v].append(k)\n    \n    for color, positions in color_cells.items():\n        rg = defaultdict(list)\n        cg = defaultdict(list)\n        for i,j in positions:\n            rg[i].append(j)\n            cg[j].append(i)\n        for i, js in rg.items():\n            if len(js)>=2:\n                for j in range(min(js), max(js)+1):\n                    cells.setdefault((i,j), color)\n        for j, is_ in cg.items():\n            if len(is_)>=2:\n                for i in range(min(is_), max(is_)+1):\n                    cells.setdefault((i,j), color)\n    \n    for (i,j), color in cells.items():\n        r, c = cell_rows[i], cell_cols[j]\n        for dr in range(2):\n            for dc in range(2):\n                result[r+dr][c+dc] = color\n    return result",
