  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    groups = []\n    i = 0\n    while i < rows:\n        if any(grid[i][j] == 8 for j in range(cols)):\n            start = i\n            while i < rows and any(grid[i][j] == 8 for j in range(cols)):\n                i += 1\n            groups.append((start, i))\n        else:\n            i += 1\n    \n    template_group = max(groups, key=lambda g: sum(grid[r][c] == 8 for r in range(g[0], g[1]) for c in range(cols)))\n    \n    result = [row[:] for row in grid]\n    \n    for g in groups:\n        if g == template_group:\n            continue\n        for ri in range(g[1] - g[0]):\n            t_row = grid[template_group[0] + ri]\n            g_row = result[g[0] + ri]\n            for c in range(cols):\n                if t_row[c] == 8 and g_row[c] == 0:\n                    g_row[c] = 1\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    groups = []\n    i = 0\n    while i < rows:\n        if any(grid[i][j] == 8 for j in range(cols)):\n            start = i\n            while i < rows and any(grid[i][j] == 8 for j in range(cols)):\n                i += 1\n            groups.append((start, i))\n        else:\n            i += 1\n    \n    template_group = max(groups, key=lambda g: sum(grid[r][c] == 8 for r in range(g[0], g[1]) for c in range(cols)))\n    \n    result = [row[:] for row in grid]\n    \n    for g in groups:\n        if g == template_group:\n            continue\n        for ri in range(g[1] - g[0]):\n            t_row = grid[template_group[0] + ri]\n            g_row = result[g[0] + ri]\n            for c in range(cols):\n                if t_row[c] == 8 and g_row[c] == 0:\n                    g_row[c] = 1\n    \n    return result",
