  "raw_response": "def solve(grid):\n    # Find the bounding box of non-zero cells\n    rows, cols = len(grid), len(grid[0])\n    r1,r2,c1,c2 = rows,0,cols,0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]:\n                r1,r2,c1,c2 = min(r1,r),max(r2,r),min(c1,c),max(c2,c)\n    sub = [row[c1:c2+1] for row in grid[r1:r2+1]]\n    vals = set(v for row in sub for v in row)\n    # Find inner and outer color\n    outer = grid[r1][c1]\n    inner = (vals - {outer}).pop()\n    return [[inner if v==outer else outer for v in row] for row in sub]",
  "script": "def solve(grid):\n    # Find the bounding box of non-zero cells\n    rows, cols = len(grid), len(grid[0])\n    r1,r2,c1,c2 = rows,0,cols,0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]:\n                r1,r2,c1,c2 = min(r1,r),max(r2,r),min(c1,c),max(c2,c)\n    sub = [row[c1:c2+1] for row in grid[r1:r2+1]]\n    vals = set(v for row in sub for v in row)\n    # Find inner and outer color\n    outer = grid[r1][c1]\n    inner = (vals - {outer}).pop()\n    return [[inner if v==outer else outer for v in row] for row in sub]",
