  "raw_response": "```python\ndef solve(grid):\n    from collections import Counter\n    \n    rows, cols = len(grid), len(grid[0])\n    \n    border_vals = []\n    for c in range(cols):\n        border_vals.extend([grid[0][c], grid[rows-1][c]])\n    for r in range(rows):\n        border_vals.extend([grid[r][0], grid[r][cols-1]])\n    bg = Counter(border_vals).most_common(1)[0][0]\n    \n    visited = [[False]*cols for _ in range(rows)]\n    components = []\n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c] and grid[r][c] != bg:\n                queue = [(r, c)]\n                visited[r][c] = True\n                cells = [(r, c)]\n                idx = 0\n                while idx < len(queue):\n                    cr, cc = queue[idx]; idx += 1\n                    for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        nr, nc = cr+dr, cc+dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] != bg:\n                            visited[nr][nc] = True\n                            queue.append((nr, nc))\n                            cells.append((nr, nc))\n                components.append(cells)\n    \n    rects = []\n    template_comp = None\n    for comp in components:\n        rs = [c[0] for c in comp]; cs = [c[1] for c in comp]\n        r1, r2, c1, c2 = min(rs), max(rs), min(cs), max(cs)\n        if len(comp) == (r2-r1+1)*(c2-c1+1):\n            color_count = Counter(grid[r][c] for r, c in comp)\n            fill_color = color_count.most_common(1)[0][0]\n            markers = [(r, c) for r, c in comp if grid[r][c] != fill_color]\n            rects.append((r1, c1, r2, c2, fill_color, markers))\n        else:\n            template_comp = comp\n    \n    marker_val = None\n    for _, _, _, _, _, markers in rects:\n        if markers:\n            marker_val = grid[markers[0][0]][markers[0][1]]\n            break\n    \n    center = None\n    for r, c in template