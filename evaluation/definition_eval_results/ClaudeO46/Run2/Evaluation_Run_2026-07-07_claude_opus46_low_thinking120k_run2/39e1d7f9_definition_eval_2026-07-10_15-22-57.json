  "raw_response": "```python\ndef solve(grid):\n    grid = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    sep_rows = []\n    sep_val = None\n    for r in range(rows):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            sep_rows.append(r)\n            sep_val = grid[r][0]\n    \n    block_row_ranges = []\n    start = 0\n    for r in sep_rows:\n        if r > start:\n            block_row_ranges.append((start, r))\n        start = r + 1\n    if start < rows:\n        block_row_ranges.append((start, rows))\n    \n    sep_cols = []\n    for c in range(cols):\n        if all(grid[r][c] == sep_val for r in range(rows)):\n            sep_cols.append(c)\n    \n    block_col_ranges = []\n    start = 0\n    for c in sep_cols:\n        if c > start:\n            block_col_ranges.append((start, c))\n        start = c + 1\n    if start < cols:\n        block_col_ranges.append((start, cols))\n    \n    n_br = len(block_row_ranges)\n    n_bc = len(block_col_ranges)\n    \n    block_vals = {}\n    for bi, (r1, r2) in enumerate(block_row_ranges):\n        for bj, (c1, c2) in enumerate(block_col_ranges):\n            block_vals[(bi, bj)] = grid[r1][c1]\n    \n    non_zero = {k for k, v in block_vals.items() if v != 0}\n    visited = set()\n    components = []\n    for block in non_zero:\n        if block in visited:\n            continue\n        comp = []\n        stack = [block]\n        while stack:\n            b = stack.pop()\n            if b in visited:\n                continue\n            visited.add(b)\n            comp.append(b)\n            bi, bj = b\n            for di, dj in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nb = (bi+di, bj+dj)\n                if nb in non_zero and nb not in visited:\n                    stack.append(nb)\n        components.append(comp)\n    \n    main_comp = None\n    isolated = []\n    for comp in components:\n        vals = set(block_vals[b] for b in comp)\n        if len(vals) > 1:\n            main_comp = comp\n        else:\n            isolated.extend(comp)\n    \n    if main_comp is None:\n        return grid\n    \n    from collections import Counter\n    val_counts = Counter(block_vals[b] for b in main_comp)\n    center_val = min(val_counts, key=val_counts.get)\n    center_blocks = [b for b in main_comp if block_vals[b] == center_val]\n    center = center_blocks[0]\n    \n    pattern = {}\n    for b in main_comp:\n        rel = (b[0] - center[0], b[1] - center[1])\n        pattern[rel] = block_vals[b]\n    \n    for ib in isolated:\n        for rel, val in pattern.items():\n            tb = (ib[0] + rel[0], ib[1] + rel[1])\n            if 0 <= tb[0] < n_br and 0 <= tb[1] < n_bc:\n                r1, r2 = block_row_ranges[tb[0]]\n                c1, c2 = block_col_ranges[tb[1]]\n                for r in range(r1, r2):\n                    for c in range(c1, c2):\n                        grid[r][c] = val\n    \n    return grid\n```",
  "script": "def solve(grid):\n    grid = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    sep_rows = []\n    sep_val = None\n    for r in range(rows):\n        vals = set(grid[r])\n        if len(vals) == 1:\n            sep_rows.append(r)\n            sep_val = grid[r][0]\n    \n    block_row_ranges = []\n    start = 0\n    for r in sep_rows:\n        if r > start:\n            block_row_ranges.append((start, r))\n        start = r + 1\n    if start < rows:\n        block_row_ranges.append((start, rows))\n    \n    sep_cols = []\n    for c in range(cols):\n        if all(grid[r][c] == sep_val for r in range(rows)):\n            sep_cols.append(c)\n    \n    block_col_ranges = []\n    start = 0\n    for c in sep_cols:\n        if c > start:\n            block_col_ranges.append((start, c))\n        start = c + 1\n    if start < cols:\n        block_col_ranges.append((start, cols))\n    \n    n_br = len(block_row_ranges)\n    n_bc = len(block_col_ranges)\n    \n    block_vals = {}\n    for bi, (r1, r2) in enumerate(block_row_ranges):\n        for bj, (c1, c2) in enumerate(block_col_ranges):\n            block_vals[(bi, bj)] = grid[r1][c1]\n    \n    non_zero = {k for k, v in block_vals.items() if v != 0}\n    visited = set()\n    components = []\n    for block in non_zero:\n        if block in visited:\n            continue\n        comp = []\n        stack = [block]\n        while stack:\n            b = stack.pop()\n            if b in visited:\n                continue\n            visited.add(b)\n            comp.append(b)\n            bi, bj = b\n            for di, dj in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nb = (bi+di, bj+dj)\n                if nb in non_zero and nb not in visited:\n                    stack.append(nb)\n        components.append(comp)\n    \n    main_comp = None\n    isolated = []\n    for comp in components:\n        vals = set(block_vals[b] for b in comp)\n        if len(vals) > 1:\n            main_comp = comp\n        else:\n            isolated.extend(comp)\n    \n    if main_comp is None:\n        return grid\n    \n    from collections import Counter\n    val_counts = Counter(block_vals[b] for b in main_comp)\n    center_val = min(val_counts, key=val_counts.get)\n    center_blocks = [b for b in main_comp if block_vals[b] == center_val]\n    center = center_blocks[0]\n    \n    pattern = {}\n    for b in main_comp:\n        rel = (b[0] - center[0], b[1] - center[1])\n        pattern[rel] = block_vals[b]\n    \n    for ib in isolated:\n        for rel, val in pattern.items():\n            tb = (ib[0] + rel[0], ib[1] + rel[1])\n            if 0 <= tb[0] < n_br and 0 <= tb[1] < n_bc:\n                r1, r2 = block_row_ranges[tb[0]]\n                c1, c2 = block_col_ranges[tb[1]]\n                for r in range(r1, r2):\n                    for c in range(c1, c2):\n                        grid[r][c] = val\n    \n    return grid",
