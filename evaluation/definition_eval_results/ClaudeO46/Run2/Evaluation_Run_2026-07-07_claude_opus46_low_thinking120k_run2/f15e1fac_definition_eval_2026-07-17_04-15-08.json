  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    eights = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 8]\n    twos = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    eight_rows = set(r for r,c in eights)\n    eight_cols = set(c for r,c in eights)\n    \n    if all(r == 0 for r,c in eights): eight_edge = 'top'; eight_positions = sorted(set(c for r,c in eights))\n    elif all(r == rows-1 for r,c in eights): eight_edge = 'bottom'; eight_positions = sorted(set(c for r,c in eights))\n    elif all(c == 0 for r,c in eights): eight_edge = 'left'; eight_positions = sorted(set(r for r,c in eights))\n    else: eight_edge = 'right'; eight_positions = sorted(set(r for r,c in eights))\n    \n    if all(c == 0 for r,c in twos): two_edge = 'left'; two_positions = sorted(set(r for r,c in twos))\n    elif all(c == cols-1 for r,c in twos): two_edge = 'right'; two_positions = sorted(set(r for r,c in twos))\n    elif all(r == 0 for r,c in twos): two_edge = 'top'; two_positions = sorted(set(c for r,c in twos))\n    else: two_edge = 'bottom'; two_positions = sorted(set(c for r,c in twos))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    if eight_edge in ('top', 'bottom'):\n        if two_edge == 'left': shift_dir = 1\n        else: shift_dir = -1\n        \n        sorted_twos = sorted(two_positions) if eight_edge == 'top' else sorted(two_positions, reverse=True)\n        shift_count = [0] * rows\n        for t in sorted_twos:\n            if eight_edge == 'top':\n                for r in range(t, rows): shift_count[r] += 1\n            else:\n                for r in range(t, -1, -1): shift_count[r] += 1\n        \n        for r in range(rows):\n            for p in eight_positions:\n                c = p + shift_dir * shift_count[r]\n                if 0 <= c < cols: result[r][c] = 8\n    else:\n        if two_edge == 'bottom': shift_dir = -1\n        else: shift_dir = 1\n        \n        sorted_twos = sorted(two_positions) if eight_edge == 'left' else sorted(two_positions, reverse=True)\n        shift_count = [0] * cols\n        for t in sorted_twos:\n            if eight_edge == 'left':\n                for c in range(t, cols): shift_count[c] += 1\n            else:\n                for c in range(t, -1, -1): shift_count[c] += 1\n        \n        for c in range(cols):\n            for p in eight_positions:\n                r = p + shift_dir * shift_count[c]\n                if 0 <= r < rows: result[r][c] = 8\n    \n    for r,c in twos:\n        result[r][c] = 2\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    eights = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 8]\n    twos = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    eight_rows = set(r for r,c in eights)\n    eight_cols = set(c for r,c in eights)\n    \n    if all(r == 0 for r,c in eights): eight_edge = 'top'; eight_positions = sorted(set(c for r,c in eights))\n    elif all(r == rows-1 for r,c in eights): eight_edge = 'bottom'; eight_positions = sorted(set(c for r,c in eights))\n    elif all(c == 0 for r,c in eights): eight_edge = 'left'; eight_positions = sorted(set(r for r,c in eights))\n    else: eight_edge = 'right'; eight_positions = sorted(set(r for r,c in eights))\n    \n    if all(c == 0 for r,c in twos): two_edge = 'left'; two_positions = sorted(set(r for r,c in twos))\n    elif all(c == cols-1 for r,c in twos): two_edge = 'right'; two_positions = sorted(set(r for r,c in twos))\n    elif all(r == 0 for r,c in twos): two_edge = 'top'; two_positions = sorted(set(c for r,c in twos))\n    else: two_edge = 'bottom'; two_positions = sorted(set(c for r,c in twos))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    if eight_edge in ('top', 'bottom'):\n        if two_edge == 'left': shift_dir = 1\n        else: shift_dir = -1\n        \n        sorted_twos = sorted(two_positions) if eight_edge == 'top' else sorted(two_positions, reverse=True)\n        shift_count = [0] * rows\n        for t in sorted_twos:\n            if eight_edge == 'top':\n                for r in range(t, rows): shift_count[r] += 1\n            else:\n                for r in range(t, -1, -1): shift_count[r] += 1\n        \n        for r in range(rows):\n            for p in eight_positions:\n                c = p + shift_dir * shift_count[r]\n                if 0 <= c < cols: result[r][c] = 8\n    else:\n        if two_edge == 'bottom': shift_dir = -1\n        else: shift_dir = 1\n        \n        sorted_twos = sorted(two_positions) if eight_edge == 'left' else sorted(two_positions, reverse=True)\n        shift_count = [0] * cols\n        for t in sorted_twos:\n            if eight_edge == 'left':\n                for c in range(t, cols): shift_count[c] += 1\n            else:\n                for c in range(t, -1, -1): shift_count[c] += 1\n        \n        for c in range(cols):\n            for p in eight_positions:\n                r = p + shift_dir * shift_count[c]\n                if 0 <= r < rows: result[r][c] = 8\n    \n    for r,c in twos:\n        result[r][c] = 2\n    \n    return result",
