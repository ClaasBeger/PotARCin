  "script": "def solve(grid):\n    from collections import Counter, deque\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    color_counts = Counter()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                color_counts[grid[r][c]] += 1\n    filler = color_counts.most_common(1)[0][0]\n\n    all_nonzero = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                all_nonzero.add((r, c))\n\n    visited = set()\n    components = []\n    for cell in sorted(all_nonzero):\n        if cell in visited:\n            continue\n        q = deque([cell])\n        visited.add(cell)\n        comp = {}\n        while q:\n            r, c = q.popleft()\n            comp[(r, c)] = grid[r][c]\n            for dr in [-1, 0, 1]:\n                for dc in [-1, 0, 1]:\n                    if dr == 0 and dc == 0: continue\n                    nr, nc = r + dr, c + dc\n                    if (nr, nc) in all_nonzero and (nr, nc) not in visited:\n                        visited.add((nr, nc))\n                        q.append((nr, nc))\n        components.append(comp)\n\n    template_comps = []\n    isolated_cells = []\n    for comp in components:\n        if filler in comp.values():\n            template_comps.append(comp)\n        else:\n            for (r, c), v in comp.items():\n                isolated_cells.append((r, c, v))\n\n    def apply_t(idx, r, c):\n        if idx == 0: return (r, c)\n        if idx == 1: return (-c, r)\n        if idx == 2: return (-r, -c)\n        if idx == 3: return (c, -r)\n        if idx == 4: return (r, -c)\n        if idx == 5: return (-r, c)\n        if idx == 6: return (c, r)\n        if idx == 7: return (-c, -r)\n\n    out = [[0] * cols for _ in range(rows)]\n    used_cells = set()\n\n    for template in template_comps:\n        anchor_list = [(r, c, v) for (r, c), v in template.items() if v != filler]\n        if not anchor_list:\n            continue\n\n        ref_r, ref_c, ref_color = anchor_list[0]\n        rel_cells = [(r - ref_r, c - ref_c, v) for (r, c), v in template.items()]\n        rel_other_anchors = [(r - ref_r, c - ref_c, v) for r, c, v in anchor_list[1:]]\n\n        for ic_r, ic_c, ic_v in isolated_cells:\n            if ic_v != ref_color or (ic_r, ic_c) in used_cells:\n                continue\n\n            for ti in range(8):\n                valid = True\n                matched = {(ic_r, ic_c)}\n\n                for dr, dc, color in rel_other_anchors:\n                    tdr, tdc = apply_t(ti, dr, dc)\n                    target_r, target_c = ic_r + tdr, ic_c + tdc\n\n                    found = False\n                    for jr, jc, jv in isolated_cells:\n                        if jr == target_r and jc == target_c and jv == color and (jr, jc) not in used_cells and (jr, jc) not in matched:\n                            found = True\n                            matched.add((jr, jc))\n                            break\n                    if not found:\n                        valid = False\n                        break\n\n                if valid:\n                    for dr, dc, color in rel_cells:\n                        tdr, tdc = apply_t(ti, dr, dc)\n                        pr, pc = ic_r + tdr, ic_c + tdc\n                        if 0 <= pr < rows and 0 <= pc < cols:\n                            out[pr][pc] = color\n                    for pos in matched:\n                        used_cells.add(pos)\n                    break\n\n    return out",
