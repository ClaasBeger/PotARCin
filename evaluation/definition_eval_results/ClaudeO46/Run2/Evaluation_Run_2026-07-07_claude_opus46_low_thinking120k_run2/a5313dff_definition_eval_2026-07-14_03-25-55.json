e the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    for r1 in range(rows):\n        for c1 in range(cols):\n            if grid[r1][c1] != 2:\n                continue\n            for r2 in range(r1+2, rows):\n                for c2 in range(c1+2, cols):\n                    valid = True\n                    for c in range(c1, c2+1):\n                        if grid[r1][c] != 2 or grid[r2][c] != 2:\n                            valid = False; break\n                    if not valid: continue\n                    for r in range(r1, r2+1):\n                        if grid[r][c1] != 2 or grid[r][c2] != 2:\n                            valid = False; break\n                    if not valid: continue\n                    \n                    has_inner_2 = any(grid[r][c] == 2 for r in range(r1+1, r2) for c in range(c1+1, c2))\n                    \n                    if has_inner_2:\n                        for r in range(r1+1, r2):\n                            for c in range(c1+1, c2):\n                                if grid[r][c] == 0:\n                                    result[r][c] = 1\n    \n    return result",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    for r1 in range(rows):\n        for c1 in range(cols):\n            if grid[r1][c1] != 2:\n                continue\n            for r2 in range(r1+2, rows):\n                for c2 in range(c1+2, cols):\n                    valid = True\n                    for c in range(c1, c2+1):\n                        if grid[r1][c] != 2 or grid[r2][c] != 2:\n                            valid = False; break\n                    if not valid: continue\n                    for r in range(r1, r2+1):\n                        if grid[r][c1] != 2 or grid[r][c2] != 2:\n                            valid = False; break\n                    if not valid: continue\n                    \n                    has_inner_2 = any(grid[r][c] == 2 for r in range(r1+1, r2) for c in range(c1+1, c2))\n                    \n                    if has_inner_2:\n                        for r in range(r1+1, r2):\n                            for c in range(c1+1, c2):\n                                if grid[r][c] == 0:\n                                    result[r][c] = 1\n    \n    return result",
