  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find separator rows (all zeros)\n    sep_rows = [r for r in range(rows) if all(grid[r][c] == 0 for c in range(cols))]\n    \n    # Find separator cols (all zeros)\n    sep_cols = [c for c in range(cols) if all(grid[r][c] == 0 for r in range(rows))]\n    \n    # Get row ranges between separators\n    def get_ranges(seps, total):\n        boundaries = [-1] + seps + [total]\n        ranges = []\n        for i in range(len(boundaries)-1):\n            s, e = boundaries[i]+1, boundaries[i+1]\n            if s < e:\n                ranges.append((s, e))\n        return ranges\n    \n    row_ranges = get_ranges(sep_rows, rows)\n    col_ranges = get_ranges(sep_cols, cols)\n    \n    output = []\n    for rs, re in row_ranges:\n        row = []\n        for cs, ce in col_ranges:\n            # Find the non-zero color in this block\n            color = 0\n            for r in range(rs, re):\n                for c in range(cs, ce):\n                    if grid[r][c] != 0:\n                        color = grid[r][c]\n                        break\n                if color:\n                    break\n            row.append(color)\n        output.append(row)\n    \n    return output",
