  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    h_lines = {}\n    v_lines = {}\n    \n    for r in range(rows):\n        vals = set(grid[r][c] for c in range(cols))\n        if len(vals) == 1 and 0 not in vals:\n            h_lines[r] = vals.pop()\n    \n    for c in range(cols):\n        vals = set(grid[r][c] for r in range(rows))\n        if len(vals) == 1 and 0 not in vals:\n            v_lines[c] = vals.pop()\n    \n    out = [[0]*cols for _ in range(rows)]\n    for r in h_lines:\n        for c in range(cols):\n            out[r][c] = h_lines[r]\n    for c in v_lines:\n        for r in range(rows):\n            out[r][c] = v_lines[c]\n    \n    color_to_hlines = {}\n    for r, col in h_lines.items():\n        color_to_hlines.setdefault(col, []).append(r)\n    color_to_vlines = {}\n    for c, col in v_lines.items():\n        color_to_vlines.setdefault(col, []).append(c)\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 or r in h_lines or c in v_lines:\n                continue\n            color = grid[r][c]\n            if color in color_to_vlines:\n                for lc in color_to_vlines[color]:\n                    if c > lc:\n                        out[r][lc+1] = color\n                    else:\n                        out[r][lc-1] = color\n            if color in color_to_hlines:\n                for lr in color_to_hlines[color]:\n                    if r > lr:\n                        out[lr+1][c] = color\n                    else:\n                        out[lr-1][c] = color\n    \n    return out",
