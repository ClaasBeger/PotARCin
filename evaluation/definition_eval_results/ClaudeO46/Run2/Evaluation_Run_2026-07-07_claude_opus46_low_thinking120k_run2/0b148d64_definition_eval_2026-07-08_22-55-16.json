  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find separator rows/cols (all zeros)\n    sep_rows = [r for r in range(rows) if all(grid[r][c] == 0 for c in range(cols))]\n    sep_cols = [c for c in range(cols) if all(grid[r][c] == 0 for r in range(rows))]\n    \n    # Find contiguous blocks of separator rows/cols\n    def get_ranges(indices, total):\n        if not indices:\n            return [(0, total)]\n        groups = []\n        start = indices[0]\n        end = indices[0]\n        for i in indices[1:]:\n            if i == end + 1:\n                end = i\n            else:\n                groups.append((start, end))\n                start = end = i\n        groups.append((start, end))\n        \n        ranges = []\n        prev = 0\n        for s, e in groups:\n            if s > prev:\n                ranges.append((prev, s))\n            prev = e + 1\n        if prev < total:\n            ranges.append((prev, total))\n        return ranges\n    \n    row_ranges = get_ranges(sep_rows, rows)\n    col_ranges = get_ranges(sep_cols, cols)\n    \n    # Find quadrants and their unique non-zero colors\n    quadrants = []\n    for r_start, r_end in row_ranges:\n        for c_start, c_end in col_ranges:\n            colors = set()\n            for r in range(r_start, r_end):\n                for c in range(c_start, c_end):\n                    if grid[r][c] != 0:\n                        colors.add(grid[r][c])\n            quadrants.append((r_start, r_end, c_start, c_end, colors))\n    \n    # Count how many quadrants each color appears in\n    from collections import Counter\n    color_count = Counter()\n    for _, _, _, _, colors in quadrants:\n        for c in colors:\n            color_count[c] += 1\n    \n    # Find quadrant with a color that appears in only one quadrant\n    for r_start, r_end, c_start, c_end, colors in quadrants:\n        if any(color_count[c] == 1 for c in colors):\n            return [row[c_sta