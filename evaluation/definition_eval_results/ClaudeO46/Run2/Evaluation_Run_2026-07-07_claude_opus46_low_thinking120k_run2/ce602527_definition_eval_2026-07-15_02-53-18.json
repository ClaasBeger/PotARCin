  "raw_response": "def solve(grid):\n    from collections import Counter\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    flat = [grid[r][c] for r in range(rows) for c in range(cols)]\n    bg = Counter(flat).most_common(1)[0][0]\n    \n    colors = set(flat) - {bg}\n    \n    objects = {}\n    for color in colors:\n        positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == color]\n        min_r = min(r for r, c in positions)\n        max_r = max(r for r, c in positions)\n        min_c = min(c for r, c in positions)\n        max_c = max(c for r, c in positions)\n        pattern = []\n        full_pattern = []\n        for r in range(min_r, max_r + 1):\n            row = []\n            full_row = []\n            for c in range(min_c, max_c + 1):\n                row.append(1 if grid[r][c] == color else 0)\n                full_row.append(grid[r][c])\n            pattern.append(row)\n            full_pattern.append(full_row)\n        objects[color] = {\n            'pattern': pattern,\n            'full_pattern': full_pattern,\n            'area': (max_r - min_r + 1) * (max_c - min_c + 1)\n        }\n    \n    large_color = max(objects.keys(), key=lambda c: objects[c]['area'])\n    small_colors = [c for c in objects.keys() if c != large_color]\n    \n    pat = objects[large_color]['pattern']\n    h = len(pat)\n    w = len(pat[0])\n    \n    row_reps = [0]\n    for i in range(1, h):\n        if pat[i] != pat[i-1]:\n            row_reps.append(i)\n    \n    col_reps = [0]\n    for i in range(1, w):\n        if any(pat[r][i] != pat[r][i-1] for r in range(h)):\n            col_reps.append(i)\n    \n    logical = [[pat[r][c] for c in col_reps] for r in row_reps]\n    lh = len(logical)\n    lw = len(logical[0])\n    \n    for sc in small_colors:\n        sp = objects[sc]['pattern']\n        sh = len(sp)\n        sw = len(sp[0])\n        \n        for dr in range(sh - lh + 1):\n            for dc in range(sw - lw + 1):\n                match = all(\n                    sp[dr + r][dc + c] == logical[r][c]\n                    for r in range(lh) for c in range(lw)\n                )\n                if match:\n                    return objects[sc]['full_pattern']\n    \n    return objects[small_colors[0]]['full_pattern']",
