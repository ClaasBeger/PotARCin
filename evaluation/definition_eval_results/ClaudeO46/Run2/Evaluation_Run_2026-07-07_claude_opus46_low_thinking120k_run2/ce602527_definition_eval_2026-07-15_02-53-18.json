tch = all(\n                    sp[dr + r][dc + c] == logical[r][c]\n                    for r in range(lh) for c in range(lw)\n                )\n                if match:\n                    return objects[sc]['full_pattern']\n    \n    return objects[small_colors[0]]['full_pattern']",
