  "raw_response": "```python\ndef solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    # Find each colored shape\n    from collections import defaultdict\n    cells = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                cells[grid[r][c]].append((r, c))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for color, positions in cells.items():\n        min_r = min(r for r, c in positions)\n        max_r = max(r for r, c in positions)\n        h = max_r - min_r + 1\n        new_bottom = rows - 1 - h\n        shift = new_bottom - max_r\n        for r, c in positions:\n            result[r + shift][c] = color\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    # Find each colored shape\n    from collections import defaultdict\n    cells = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                cells[grid[r][c]].append((r, c))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for color, positions in cells.items():\n        min_r = min(r for r, c in positions)\n        max_r = max(r for r, c in positions)\n        h = max_r - min_r + 1\n        new_bottom = rows - 1 - h\n        shift = new_bottom - max_r\n        for r, c in positions:\n            result[r + shift][c] = color\n    \n    return result",
