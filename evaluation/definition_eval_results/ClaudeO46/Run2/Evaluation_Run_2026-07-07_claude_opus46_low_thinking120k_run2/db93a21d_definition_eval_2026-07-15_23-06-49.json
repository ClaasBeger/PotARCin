  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    visited = [[False]*cols for _ in range(rows)]\n    blocks = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 9 and not visited[r][c]:\n                r2, c2 = r, c\n                while c2+1 < cols and grid[r][c2+1] == 9:\n                    c2 += 1\n                while r2+1 < rows and grid[r2+1][c] == 9:\n                    r2 += 1\n                for rr in range(r, r2+1):\n                    for cc in range(c, c2+1):\n                        visited[rr][cc] = True\n                blocks.append((r, c, r2, c2))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for (r1, c1, r2, c2) in blocks:\n        w = c2 - c1 + 1\n        h = r2 - r1 + 1\n        border = max(w, h) // 2\n        for r in range(r2 + border + 1, rows):\n            for c in range(c1, c2+1):\n                result[r][c] = 1\n    \n    for (r1, c1, r2, c2) in blocks:\n        w = c2 - c1 + 1\n        h = r2 - r1 + 1\n        border = max(w, h) // 2\n        br1 = max(0, r1 - border)\n        bc1 = max(0, c1 - border)\n        br2 = min(rows-1, r2 + border)\n        bc2 = min(cols-1, c2 + border)\n        for r in range(br1, br2+1):\n            for c in range(bc1, bc2+1):\n                result[r][c] = 3\n    \n    for (r1, c1, r2, c2) in blocks:\n        for r in range(r1, r2+1):\n            for c in range(c1, c2+1):\n                result[r][c] = 9\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    visited = [[False]*cols for _ in range(rows)]\n    blocks = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 9 and not visited[r][c]:\n                r2, c2 = r, c\n                while c2+1 < cols and grid[r][c2+1] == 9:\n                    c2 += 1\n                while r2+1 < rows and grid[r2+1][c] == 9:\n                    r2 += 1\n                for rr in range(r, r2+1):\n                    for cc in range(c, c2+1):\n                        visited[rr][cc] = True\n                blocks.append((r, c, r2, c2))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for (r1, c1, r2, c2) in blocks:\n        w = c2 - c1 + 1\n        h = r2 - r1 + 1\n        border = max(w, h) // 2\n        for r in range(r2 + border + 1, rows):\n            for c in range(c1, c2+1):\n                result[r][c] = 1\n    \n    for (r1, c1, r2, c2) in blocks:\n        w = c2 - c1 + 1\n        h = r2 - r1 + 1\n        border = max(w, h) // 2\n        br1 = max(0, r1 - border)\n        bc1 = max(0, c1 - border)\n        br2 = min(rows-1, r2 + border)\n        bc2 = min(cols-1, c2 + border)\n        for r in range(br1, br2+1):\n            for c in range(bc1, bc2+1):\n                result[r][c] = 3\n    \n    for (r1, c1, r2, c2) in blocks:\n        for r in range(r1, r2+1):\n            for c in range(c1, c2+1):\n                result[r][c] = 9\n    \n    return result",
