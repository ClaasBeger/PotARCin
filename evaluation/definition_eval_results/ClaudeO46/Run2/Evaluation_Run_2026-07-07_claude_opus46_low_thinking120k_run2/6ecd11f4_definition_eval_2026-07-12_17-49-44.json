  "raw_response": "```python\ndef solve(grid):\n    import numpy as np\n    from collections import Counter\n    \n    g = np.array(grid)\n    \n    nonzero = g[g != 0]\n    counts = Counter(nonzero.tolist())\n    shape_val = counts.most_common(1)[0][0]\n    \n    shape_cells = np.argwhere(g == shape_val)\n    sr1, sc1 = shape_cells.min(axis=0)\n    sr2, sc2 = shape_cells.max(axis=0)\n    \n    key_mask = (g != 0).copy()\n    key_mask[sr1:sr2+1, sc1:sc2+1] = False\n    key_cells = np.argwhere(key_mask)\n    kr1, kc1 = key_cells.min(axis=0)\n    kr2, kc2 = key_cells.max(axis=0)\n    key = g[kr1:kr2+1, kc1:kc2+1]\n    \n    krows, kcols = key.shape\n    block_h = (sr2 - sr1 + 1) // krows\n    block_w = (sc2 - sc1 + 1) // kcols\n    \n    result = []\n    for i in range(krows):\n        row = []\n        for j in range(kcols):\n            r = sr1 + i * block_h\n            c = sc1 + j * block_w\n            if g[r, c] == shape_val:\n                row.append(int(key[i, j]))\n            else:\n                row.append(0)\n        result.append(row)\n    \n    return result\n```",
  "script": "def solve(grid):\n    import numpy as np\n    from collections import Counter\n    \n    g = np.array(grid)\n    \n    nonzero = g[g != 0]\n    counts = Counter(nonzero.tolist())\n    shape_val = counts.most_common(1)[0][0]\n    \n    shape_cells = np.argwhere(g == shape_val)\n    sr1, sc1 = shape_cells.min(axis=0)\n    sr2, sc2 = shape_cells.max(axis=0)\n    \n    key_mask = (g != 0).copy()\n    key_mask[sr1:sr2+1, sc1:sc2+1] = False\n    key_cells = np.argwhere(key_mask)\n    kr1, kc1 = key_cells.min(axis=0)\n    kr2, kc2 = key_cells.max(axis=0)\n    key = g[kr1:kr2+1, kc1:kc2+1]\n    \n    krows, kcols = key.shape\n    block_h = (sr2 - sr1 + 1) // krows\n    block_w = (sc2 - sc1 + 1) // kcols\n    \n    result = []\n    for i in range(krows):\n        row = []\n        for j in range(kcols):\n            r = sr1 + i * block_h\n            c = sc1 + j * block_w\n            if g[r, c] == shape_val:\n                row.append(int(key[i, j]))\n            else:\n                row.append(0)\n        result.append(row)\n    \n    return result",
