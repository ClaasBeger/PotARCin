  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    frame_cells = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] not in (0, 8):\n                frame_cells[(r,c)] = grid[r][c]\n    \n    frame_rs = [r for r,c in frame_cells]\n    frame_cs = [c for r,c in frame_cells]\n    fr_min, fr_max = min(frame_rs), max(frame_rs)\n    fc_min, fc_max = min(frame_cs), max(frame_cs)\n    \n    top_color = grid[fr_min][fc_min+1]\n    bottom_color = grid[fr_max][fc_min+1]\n    left_color = grid[fr_min+1][fc_min]\n    right_color = grid[fr_min+1][fc_max]\n    \n    int_h = fr_max - fr_min - 1\n    int_w = fc_max - fc_min - 1\n    \n    eight_cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 8]\n    er_min = min(r for r,c in eight_cells)\n    ec_min = min(c for r,c in eight_cells)\n    \n    pattern = [[0]*int_w for _ in range(int_h)]\n    for r,c in eight_cells:\n        pr, pc = r - er_min, c - ec_min\n        if 0 <= pr < int_h and 0 <= pc < int_w:\n            pattern[pr][pc] = 8\n    \n    out_h = fr_max - fr_min + 1\n    out_w = fc_max - fc_min + 1\n    out = [[0]*out_w for _ in range(out_h)]\n    \n    for (r,c), v in frame_cells.items():\n        out[r-fr_min][c-fc_min] = v\n    \n    for pr in range(int_h):\n        for pc in range(int_w):\n            if pattern[pr][pc] == 8:\n                val = 8\n                is_top = (pr == 0)\n                is_bot = (pr == int_h-1)\n                is_left = (pc == 0)\n                is_right = (pc == int_w-1)\n                \n                if (is_top or is_bot) and (is_left or is_right):\n                    val = 8\n                elif is_top:\n                    val = top_color\n                elif is_bot:\n                    val = bottom_color\n                elif is_left:\n                    val = left_color\n                elif is_right:\n                    val = right_color\n                \n                o