  "raw_response": "```python\ndef solve(grid):\n    import copy\n    result = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find connected components of 5s\n    def flood_fill(r, c):\n        stack = [(r, c)]\n        cells = []\n        while stack:\n            cr, cc = stack.pop()\n            if 0 <= cr < rows and 0 <= cc < cols and not visited[cr][cc] and grid[cr][cc] == 5:\n                visited[cr][cc] = True\n                cells.append((cr, cc))\n                for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    stack.append((cr+dr, cc+dc))\n        return cells\n    \n    rectangles = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5 and not visited[r][c]:\n                cells = flood_fill(r, c)\n                if cells:\n                    min_r = min(x[0] for x in cells)\n                    max_r = max(x[0] for x in cells)\n                    min_c = min(x[1] for x in cells)\n                    max_c = max(x[1] for x in cells)\n                    # Find interior 0s\n                    zeros = []\n                    for ir in range(min_r+1, max_r):\n                        for ic in range(min_c+1, max_c):\n                            if grid[ir][ic] == 0:\n                                zeros.append((ir, ic))\n                    if zeros:\n                        rectangles.append((min_r, max_r, min_c, max_c, zeros))\n    \n    # Find the largest hole area\n    if not rectangles:\n        return result\n    \n    max_area = max(len(z[4]) for z in rectangles)\n    \n    for min_r, max_r, min_c, max_c, zeros in rectangles:\n        area = len(zeros)\n        if area < max_area:\n            for r, c in zeros:\n                result[r][c] = 2\n    \n    return result\n```",
  "script": "def solve(grid):\n    import copy\n    result = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find connected components of 5s\n    def flood_fill(r, c):\n        stack = [(r, c)]\n        cells = []\n        while stack:\n            cr, cc = stack.pop()\n            if 0 <= cr < rows and 0 <= cc < cols and not visited[cr][cc] and grid[cr][cc] == 5:\n                visited[cr][cc] = True\n                cells.append((cr, cc))\n                for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    stack.append((cr+dr, cc+dc))\n        return cells\n    \n    rectangles = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5 and not visited[r][c]:\n                cells = flood_fill(r, c)\n                if cells:\n                    min_r = min(x[0] for x in cells)\n                    max_r = max(x[0] for x in cells)\n                    min_c = min(x[1] for x in cells)\n                    max_c = max(x[1] for x in cells)\n                    # Find interior 0s\n                    zeros = []\n                    for ir in range(min_r+1, max_r):\n                        for ic in range(min_c+1, max_c):\n                            if grid[ir][ic] == 0:\n                                zeros.append((ir, ic))\n                    if zeros:\n                        rectangles.append((min_r, max_r, min_c, max_c, zeros))\n    \n    # Find the largest hole area\n    if not rectangles:\n        return result\n    \n    max_area = max(len(z[4]) for z in rectangles)\n    \n    for min_r, max_r, min_c, max_c, zeros in rectangles:\n        area = len(zeros)\n        if area < max_area:\n            for r, c in zeros:\n                result[r][c] = 2\n    \n    return result",
