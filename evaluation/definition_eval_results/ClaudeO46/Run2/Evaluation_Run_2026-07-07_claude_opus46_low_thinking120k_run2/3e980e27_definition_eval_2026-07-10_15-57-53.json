  "raw_response": "```python\ndef solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    result = copy.deepcopy(grid)\n    \n    visited = [[False]*cols for _ in range(rows)]\n    components = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                comp = []\n                stack = [(r, c)]\n                visited[r][c] = True\n                while stack:\n                    cr, cc = stack.pop()\n                    comp.append((cr, cc, grid[cr][cc]))\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0: continue\n                            nr, nc = cr+dr, cc+dc\n                            if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] != 0:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n                components.append(comp)\n    \n    templates = []\n    lone_pixels = []\n    for comp in components:\n        if len(comp) == 1:\n            lone_pixels.append(comp[0])\n        else:\n            templates.append(comp)\n    \n    template_info = []\n    for comp in templates:\n        color_count = {}\n        for r, c, v in comp:\n            color_count[v] = color_count.get(v, 0) + 1\n        key_color = None\n        for color, count in color_count.items():\n            if count == 1:\n                key_color = color\n                break\n        key_pos = None\n        non_key_offsets = []\n        for r, c, v in comp:\n            if v == key_color:\n                key_pos = (r, c)\n        for r, c, v in comp:\n            if v != key_color:\n                non_key_offsets.append((r - key_pos[0], c - key_pos[1], v))\n        template_info.append((key_color, key_pos, non_key_offsets))\n    \n    for lr, lc, lv in lone_pixels:\n        for key_color, key_pos, non_key_offsets in template_info:\n            if lv == key_color:\n                mirror = (key_color % 2 == 0)\n                for dr, dc, v in non_key_offsets:\n                    if mirror:\n                        dc = -dc\n                    nr, nc = lr + dr, lc + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        result[nr][nc] = v\n                break\n    \n    return result\n```",
  "script": "def solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    result = copy.deepcopy(grid)\n    \n    visited = [[False]*cols for _ in range(rows)]\n    components = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                comp = []\n                stack = [(r, c)]\n                visited[r][c] = True\n                while stack:\n                    cr, cc = stack.pop()\n                    comp.append((cr, cc, grid[cr][cc]))\n                    for dr in [-1, 0, 1]:\n                        for dc in [-1, 0, 1]:\n                            if dr == 0 and dc == 0: continue\n                            nr, nc = cr+dr, cc+dc\n                            if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] != 0:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n                components.append(comp)\n    \n    templates = []\n    lone_pixels = []\n    for comp in components:\n        if len(comp) == 1:\n            lone_pixels.append(comp[0])\n        else:\n            templates.append(comp)\n    \n    template_info = []\n    for comp in templates:\n        color_count = {}\n        for r, c, v in comp:\n            color_count[v] = color_count.get(v, 0) + 1\n        key_color = None\n        for color, count in color_count.items():\n            if count == 1:\n                key_color = color\n                break\n        key_pos = None\n        non_key_offsets = []\n        for r, c, v in comp:\n            if v == key_color:\n                key_pos = (r, c)\n        for r, c, v in comp:\n            if v != key_color:\n                non_key_offsets.append((r - key_pos[0], c - key_pos[1], v))\n        template_info.append((key_color, key_pos, non_key_offsets))\n    \n    for lr, lc, lv in lone_pixels:\n        for key_color, key_pos, non_key_offsets in template_info:\n            if lv == key_color:\n                mirror = (key_color % 2 == 0)\n                for dr, dc, v in non_key_offsets:\n                    if mirror:\n                        dc = -dc\n                    nr, nc = lr + dr, lc + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        result[nr][nc] = v\n                break\n    \n    return result",
