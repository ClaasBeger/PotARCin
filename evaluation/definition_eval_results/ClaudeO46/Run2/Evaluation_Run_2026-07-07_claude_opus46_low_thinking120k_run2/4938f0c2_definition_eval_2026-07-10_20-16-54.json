  "raw_response": "```python\ndef solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    out = copy.deepcopy(grid)\n    \n    # Find 3-block cells\n    threes = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 3]\n    cr = sum(r for r,c in threes) / len(threes)\n    cc = sum(c for r,c in threes) / len(threes)\n    \n    # Find 2-block cells\n    twos = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    # Reflect each 2-cell in all 4 quadrants\n    for r,c in twos:\n        for nr, nc in [(r,c), (2*cr-r, c), (r, 2*cc-c), (2*cr-r, 2*cc-c)]:\n            ri, ci = int(round(nr)), int(round(nc))\n            if 0 <= ri < rows and 0 <= ci < cols:\n                out[ri][ci] = 2\n    \n    return out\n```",
  "script": "def solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    out = copy.deepcopy(grid)\n    \n    # Find 3-block cells\n    threes = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 3]\n    cr = sum(r for r,c in threes) / len(threes)\n    cc = sum(c for r,c in threes) / len(threes)\n    \n    # Find 2-block cells\n    twos = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    # Reflect each 2-cell in all 4 quadrants\n    for r,c in twos:\n        for nr, nc in [(r,c), (2*cr-r, c), (r, 2*cc-c), (2*cr-r, 2*cc-c)]:\n            ri, ci = int(round(nr)), int(round(nc))\n            if 0 <= ri < rows and 0 <= ci < cols:\n                out[ri][ci] = 2\n    \n    return out",
