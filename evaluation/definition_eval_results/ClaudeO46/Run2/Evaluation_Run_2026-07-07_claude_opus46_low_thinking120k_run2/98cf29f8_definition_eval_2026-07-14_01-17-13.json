  "raw_response": "```python\ndef solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    colors = set(g.flatten()) - {0}\n    \n    color_cells = {}\n    for c in colors:\n        cells = set(zip(*np.where(g == c)))\n        color_cells[c] = cells\n    \n    # Find which color is non-rectangular (has a connecting line) = moving\n    moving_color = None\n    for c in colors:\n        cells = color_cells[c]\n        rs = [r for r,_ in cells]; cs = [c2 for _,c2 in cells]\n        if (max(rs)-min(rs)+1)*(max(cs)-min(cs)+1) != len(cells):\n            moving_color = c\n    \n    stationary_color = (colors - {moving_color}).pop()\n    moving_cells = color_cells[moving_color]\n    stat_cells = color_cells[stationary_color]\n    \n    srs = [r for r,_ in stat_cells]; scs = [c for _,c in stat_cells]\n    s_rmin, s_rmax, s_cmin, s_cmax = min(srs), max(srs), min(scs), max(scs)\n    \n    mrs = [r for r,_ in moving_cells]; mcs = [c for _,c in moving_cells]\n    m_rmin, m_rmax, m_cmin, m_cmax = min(mrs), max(mrs), min(mcs), max(mcs)\n    \n    best_rect = None; best_area = 0\n    for r1 in range(m_rmin, m_rmax+1):\n        for r2 in range(r1, m_rmax+1):\n            for c1 in range(m_cmin, m_cmax+1):\n                for c2 in range(c1, m_cmax+1):\n                    area = (r2-r1+1)*(c2-c1+1)\n                    if area <= best_area: continue\n                    if all((r,c) in moving_cells for r in range(r1,r2+1) for c in range(c1,c2+1)):\n                        best_rect = (r1,r2,c1,c2); best_area = area\n    \n    rect_r1, rect_r2, rect_c1, rect_c2 = best_rect\n    rect_h = rect_r2 - rect_r1 + 1; rect_w = rect_c2 - rect_c1 + 1\n    \n    line_cells = moving_cells - {(r,c) for r in range(rect_r1,rect_r2+1) for c in range(rect_c1,rect_c2+1)}\n    lrs = [r for r,_ in line_cells]; lcs = [c for _,c in line_cells]\n    \n    if max(lcs)-min(lcs) == 0:  # vertical line\n        direction = 'up' if min(lrs) < rect_r1 else 'down'\n    else:\n        direction = 'left' 