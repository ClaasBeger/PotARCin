  "raw_response": "```python\ndef solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    cells = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] != 0:\n                cells.append((r, c, grid[r][c]))\n    \n    rect_r1, rect_c1 = 1, 1\n    rect_r2, rect_c2 = H-2, W-2\n    \n    avg_r = sum(r for r,c,v in cells) / len(cells)\n    avg_c = sum(c for r,c,v in cells) / len(cells)\n    \n    mid_r = (rect_r1 + rect_r2) / 2\n    mid_c = (rect_c1 + rect_c2) / 2\n    \n    if avg_r <= mid_r:\n        corner_r, dr_sign = rect_r1, 1\n    else:\n        corner_r, dr_sign = rect_r2, -1\n    \n    if avg_c <= mid_c:\n        corner_c, dc_sign = rect_c1, 1\n    else:\n        corner_c, dc_sign = rect_c2, -1\n    \n    size_r = rect_r2 - rect_r1\n    size_c = rect_c2 - rect_c1\n    \n    result = [[0]*W for _ in range(H)]\n    \n    for r, c, v in cells:\n        dr = (r - corner_r) * dr_sign\n        dc = (c - corner_c) * dc_sign\n        \n        dr_m = size_r - dr\n        dc_m = size_c - dc\n        \n        if dr == dc:\n            for rr in [dr, dr_m]:\n                for cc in [dc, dc_m]:\n                    result[corner_r + rr*dr_sign][corner_c + cc*dc_sign] = v\n        elif dr < dc:\n            lo, hi = min(dc, dc_m), max(dc, dc_m)\n            for rr in [dr, dr_m]:\n                for cc in range(lo, hi+1, 2):\n                    result[corner_r + rr*dr_sign][corner_c + cc*dc_sign] = v\n        else:\n            lo, hi = min(dr, dr_m), max(dr, dr_m)\n            for cc in [dc, dc_m]:\n                for rr in range(lo, hi+1, 2):\n                    result[corner_r + rr*dr_sign][corner_c + cc*dc_sign] = v\n    \n    return result\n```",
  "script": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0])\n    \n    cells = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] != 0:\n                cells.append((r, c, grid[r][c]))\n    \n    rect_r1, rect_c1 = 1, 1\n    rect_r2, rect_c2 = H-2, W-2\n    \n    avg_r = sum(r for r,c,v in cells) / len(cells)\n    avg_c = sum(c for r,c,v in cells) / len(cells)\n    \n    mid_r = (rect_r1 + rect_r2) / 2\n    mid_c = (rect_c1 + rect_c2) / 2\n    \n    if avg_r <= mid_r:\n        corner_r, dr_sign = rect_r1, 1\n    else:\n        corner_r, dr_sign = rect_r2, -1\n    \n    if avg_c <= mid_c:\n        corner_c, dc_sign = rect_c1, 1\n    else:\n        corner_c, dc_sign = rect_c2, -1\n    \n    size_r = rect_r2 - rect_r1\n    size_c = rect_c2 - rect_c1\n    \n    result = [[0]*W for _ in range(H)]\n    \n    for r, c, v in cells:\n        dr = (r - corner_r) * dr_sign\n        dc = (c - corner_c) * dc_sign\n        \n        dr_m = size_r - dr\n        dc_m = size_c - dc\n        \n        if dr == dc:\n            for rr in [dr, dr_m]:\n                for cc in [dc, dc_m]:\n                    result[corner_r + rr*dr_sign][corner_c + cc*dc_sign] = v\n        elif dr < dc:\n            lo, hi = min(dc, dc_m), max(dc, dc_m)\n            for rr in [dr, dr_m]:\n                for cc in range(lo, hi+1, 2):\n                    result[corner_r + rr*dr_sign][corner_c + cc*dc_sign] = v\n        else:\n            lo, hi = min(dr, dr_m), max(dr, dr_m)\n            for cc in [dc, dc_m]:\n                for rr in range(lo, hi+1, 2):\n                    result[corner_r + rr*dr_sign][corner_c + cc*dc_sign] = v\n    \n    return result",
