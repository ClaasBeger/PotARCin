  "raw_response": "```python\ndef solve(grid):\n    from collections import deque\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    visited = [[False]*cols for _ in range(rows)]\n    components = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 4 and not visited[r][c]:\n                comp = []\n                q = deque([(r,c)])\n                visited[r][c] = True\n                while q:\n                    cr, cc = q.popleft()\n                    comp.append((cr,cc))\n                    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        nr,nc = cr+dr, cc+dc\n                        if 0<=nr<rows and 0<=nc<cols and not visited[nr][nc] and grid[nr][nc]==4:\n                            visited[nr][nc] = True\n                            q.append((nr,nc))\n                components.append(comp)\n    \n    def get_decorations(comp):\n        comp_set = set(comp)\n        decos = {}\n        checked = set()\n        for r,c in comp:\n            for dr in range(-2, 3):\n                for dc in range(-2, 3):\n                    nr, nc = r+dr, c+dc\n                    if 0<=nr<rows and 0<=nc<cols and (nr,nc) not in comp_set and (nr,nc) not in checked:\n                        checked.add((nr,nc))\n                        if grid[nr][nc] != 0 and grid[nr][nc] != 4:\n                            decos[(nr,nc)] = grid[nr][nc]\n        return decos\n    \n    template = None\n    incomplete = []\n    \n    for comp in components:\n        decos = get_decorations(comp)\n        values = set(decos.values())\n        if 1 in values and 3 in values:\n            template = (comp, decos)\n        elif 2 in values:\n            incomplete.append((comp, decos))\n    \n    if template is None:\n        return result\n    \n    t_comp, t_decos = template\n    t_min_r = min(r for r,c in t_comp)\n    t_min_c = min(c for r,c in t_comp)\n    t_rel = set((r-t_min_r, c-t_min_c) for r,c in t_comp)\n    H = max(r for r,c in t_rel)\n    W = max(c for r,c in t_rel)\n    \n    t_decos_rel = {(r-t_min_r, c-t_min_c): v for (r,c),v in t_decos.items()}\n    t_2_rel = [k for k,v in t_decos_rel.items() if v == 2][0]\n    \n    def apply_transform(r, c, ti):\n        if ti == 0: return (r, c)\n        elif ti == 1: return (c, H-r)\n        elif ti == 2: return (H-r, W-c)\n        elif ti == 3: return (W-c, r)\n        elif ti == 4: return (r, W-c)\n        elif ti == 5: return (H-r, c)\n        elif ti == 6: return (c, r)\n        elif ti == 7: return (W-c, H-r)\n    \n    for comp, decos in incomplete:\n        c_min_r = min(r for r,c in comp)\n        c_min_c = min(c for r,c in comp)\n        c_rel = set((r-c_min_r, c-c_min_c) for r,c in comp)\n        \n        c_2_pos = [(r,c) for (r,c),v in decos.items() if v == 2][0]\n        c_2_rel = (c_2_pos[0]-c_min_r, c_2_pos[1]-c_min_c)\n        \n        for ti in range(8):\n            transformed = set()\n            for r,c in t_rel:\n                transformed.add(apply_transform(r, c, ti))\n            \n            min_tr = min(r for r,c in transformed)\n            min_tc = min(c for r,c in transformed)\n            transformed_norm = set((r-min_tr, c-min_tc) for r,c in transformed)\n            \n            if transformed_norm == c_rel:\n                t2_t = apply_transform(t_2_rel[0], t_2_rel[1], ti)\n                t2_norm = (t2_t[0]-min_tr, t2_t[1]-min_tc)\n                \n                if t2_norm == c_2_rel:\n                    for (dr, dc), v in t_decos_rel.items():\n                        if v == 2:\n                            continue\n                        new_pos = apply_transform(dr, dc, ti)\n                        new_r = new_pos[0] - min_tr + c_min_r\n                        new_c = new_pos[1] - min_tc + c_min_c\n                        if 0<=new_r<rows and 0<=new_c<cols:\n                            result[new_r][new_c] = v\n                    break\n   