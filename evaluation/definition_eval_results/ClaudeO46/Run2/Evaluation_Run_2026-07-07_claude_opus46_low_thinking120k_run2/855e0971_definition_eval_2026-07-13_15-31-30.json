    # Check if columns share same color -> horizontal bands\n    # Actually let me detect vertical bands too\n    \n    result = [row[:] for row in grid]\n    \n    # Try horizontal bands first\n    def get_base(val_list):\n        for v in val_list:\n            if v != 0:\n                return v\n        return 0\n    \n    # Detect horizontal bands\n    h_bands = []\n    i = 0\n    while i < rows:\n        color = get_base(grid[i])\n        j = i\n        while j < rows and get_base(grid[j]) == color:\n            j += 1\n        h_bands.append((i, j, color))\n        i = j\n    \n    # Detect vertical bands\n    v_bands = []\n    i = 0\n    while i < cols:\n        color = get_base([grid[r][i] for r in range(rows)])\n        j = i\n        while j < cols and get_base([grid[r][j] for r in range(rows)]) == color:\n            j += 1\n        v_bands.append((i, j, color))\n        i = j\n    \n    # Use whichever has more bands\n    if len(h_bands) >= len(v_bands):\n        # Horizontal bands: fill column within band\n        for start, end, color in h_bands:\n            for r in range(start, end):\n                for c in range(cols):\n                    if grid[r][c] == 0:\n                        for rr in range(start, end):\n                            result[rr][c] = 0\n    else:\n        # Vertical bands: fill row within band\n        for cstart, cend, color in v_bands:\n            for r in range(rows):\n                for c in range(cstart, cend):\n                    if grid[r][c] == 0:\n                        for cc in range(cstart, cend):\n                            result[r][cc] = 0\n    \n    return result",
