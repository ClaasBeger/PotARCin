  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    r8=c8=r2=c2=0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]==8: r8,c8=r,c\n            if grid[r][c]==2: r2,c2=r,c\n    import copy\n    out=copy.deepcopy(grid)\n    dr=1 if r2>r8 else -1\n    dc=1 if c2>c8 else -1\n    for r in range(r8+dr,r2+dr,dr):\n        out[r][c8]=4\n    for c in range(c8+dc,c2+dc,dc):\n        out[r2][c]=4\n    return out\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    r8=c8=r2=c2=0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]==8: r8,c8=r,c\n            if grid[r][c]==2: r2,c2=r,c\n    import copy\n    out=copy.deepcopy(grid)\n    dr=1 if r2>r8 else -1\n    dc=1 if c2>c8 else -1\n    for r in range(r8+dr,r2+dr,dr):\n        out[r][c8]=4\n    for c in range(c8+dc,c2+dc,dc):\n        out[r2][c]=4\n    return out",
