  "raw_response": "```python\ndef solve(grid):\n    import copy\n    from collections import Counter\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = copy.deepcopy(grid)\n    \n    cells = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                cells[(r,c)] = grid[r][c]\n    \n    parent = {}\n    for pos in cells:\n        parent[pos] = pos\n    \n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n    \n    def union(a, b):\n        a, b = find(a), find(b)\n        if a != b:\n            parent[a] = b\n    \n    cell_list = list(cells.keys())\n    for i in range(len(cell_list)):\n        for j in range(i+1, len(cell_list)):\n            r1,c1 = cell_list[i]\n            r2,c2 = cell_list[j]\n            if max(abs(r1-r2), abs(c1-c2)) <= 2:\n                union(cell_list[i], cell_list[j])\n    \n    clusters = {}\n    for pos in cells:\n        root = find(pos)\n        clusters.setdefault(root, []).append(pos)\n    \n    templates = []\n    incomplete = []\n    \n    for root, cc in clusters.items():\n        values = [cells[p] for p in cc]\n        val_counts = Counter(values)\n        \n        if len(cc) >= 3 and len(val_counts) >= 2:\n            sorted_vals = sorted(val_counts.items(), key=lambda x: x[1])\n            center_val = sorted_vals[0][0]\n            surround_val = sorted_vals[1][0]\n            \n            center_pos = [p for p in cc if cells[p] == center_val]\n            surround_pos = [p for p in cc if cells[p] == surround_val]\n            \n            if len(center_pos) == 1:\n                cr, crc = center_pos[0]\n                offsets = [(r-cr, c-crc) for r,c in surround_pos]\n                templates.append({\n                    'center_val': center_val,\n                    'surround_val': surround_val,\n                    'offsets': offsets\n                })\n        else:\n            incomplete.append(cc)\n    \n    for cc in incomplete:\n        values = [cells[p] for p in cc]\n        val = values[0]\n        \n        if len(cc) == 1:\n            pos = cc[0]\n            for t in templates:\n                if t['center_val'] == val:\n                    for dr, dc in t['offsets']:\n                        nr, nc = pos[0]+dr, pos[1]+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            result[nr][nc] = t['surround_val']\n                    break\n        else:\n            for t in templates:\n                if t['surround_val'] == val and len(cc) == len(t['offsets']):\n                    found = False\n                    for idx, offset in enumerate(t['offsets']):\n                        cr = cc[0][0] - offset[0]\n                        crc = cc[0][1] - offset[1]\n                        expected = set((cr+dr, crc+dc) for dr,dc in t['offsets'])\n                        if expected == set(cc):\n                            result[cr][crc] = t['center_val']\n                            found = True\n                            break\n                    if found:\n                        break\n    \n    return result\n```",
  "script": "def solve(grid):\n    import copy\n    from collections import Counter\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = copy.deepcopy(grid)\n    \n    cells = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                cells[(r,c)] = grid[r][c]\n    \n    parent = {}\n    for pos in cells:\n        parent[pos] = pos\n    \n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n    \n    def union(a, b):\n        a, b = find(a), find(b)\n        if a != b:\n            parent[a] = b\n    \n    cell_list = list(cells.keys())\n    for i in range(len(cell_list)):\n        for j in range(i+1, len(cell_list)):\n            r1,c1 = cell_list[i]\n            r2,c2 = cell_list[j]\n            if max(abs(r1-r2), abs(c1-c2)) <= 2:\n                union(cell_list[i], cell_list[j])\n    \n    clusters = {}\n    for pos in cells:\n        root = find(pos)\n        clusters.setdefault(root, []).append(pos)\n    \n    templates = []\n    incomplete = []\n    \n    for root, cc in clusters.items():\n        values = [cells[p] for p in cc]\n        val_counts = Counter(values)\n        \n        if len(cc) >= 3 and len(val_counts) >= 2:\n            sorted_vals = sorted(val_counts.items(), key=lambda x: x[1])\n            center_val = sorted_vals[0][0]\n            surround_val = sorted_vals[1][0]\n            \n            center_pos = [p for p in cc if cells[p] == center_val]\n            surround_pos = [p for p in cc if cells[p] == surround_val]\n            \n            if len(center_pos) == 1:\n                cr, crc = center_pos[0]\n                offsets = [(r-cr, c-crc) for r,c in surround_pos]\n                templates.append({\n                    'center_val': center_val,\n                    'surround_val': surround_val,\n                    'offsets': offsets\n                })\n        else:\n            incomplete.append(cc)\n    \n    for cc in incomplete:\n        values = [cells[p] for p in cc]\n        val = values[0]\n        \n        if len(cc) == 1:\n            pos = cc[0]\n            for t in templates:\n                if t['center_val'] == val:\n                    for dr, dc in t['offsets']:\n                        nr, nc = pos[0]+dr, pos[1]+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            result[nr][nc] = t['surround_val']\n                    break\n        else:\n            for t in templates:\n                if t['surround_val'] == val and len(cc) == len(t['offsets']):\n                    found = False\n                    for idx, offset in enumerate(t['offsets']):\n                        cr = cc[0][0] - offset[0]\n                        crc = cc[0][1] - offset[1]\n                        expected = set((cr+dr, crc+dc) for dr,dc in t['offsets'])\n                        if expected == set(cc):\n                            result[cr][crc] = t['center_val']\n                            found = True\n                            break\n                    if found:\n                        break\n    \n    return result",
