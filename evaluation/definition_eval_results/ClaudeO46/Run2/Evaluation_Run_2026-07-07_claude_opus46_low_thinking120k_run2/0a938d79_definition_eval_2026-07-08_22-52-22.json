  "raw_response": "```python\ndef solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    points = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                points.append((r, c, grid[r][c]))\n    \n    (r1, c1, v1), (r2, c2, v2) = points[0], points[1]\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    if r1 == 0 or r2 == 0:  # column-based pattern\n        if c1 > c2:\n            c1, c2, v1, v2 = c2, c1, v2, v1\n        gap = c2 - c1\n        for c in range(c1, cols):\n            steps = c - c1\n            if steps % gap == 0:\n                val = v1 if (steps // gap) % 2 == 0 else v2\n                for r in range(rows):\n                    result[r][c] = val\n    else:  # row-based pattern\n        if r1 > r2:\n            r1, r2, v1, v2 = r2, r1, v2, v1\n        gap = r2 - r1\n        for r in range(r1, rows):\n            steps = r - r1\n            if steps % gap == 0:\n                val = v1 if (steps // gap) % 2 == 0 else v2\n                for c in range(cols):\n                    result[r][c] = val\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    points = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                points.append((r, c, grid[r][c]))\n    \n    (r1, c1, v1), (r2, c2, v2) = points[0], points[1]\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    if r1 == 0 or r2 == 0:  # column-based pattern\n        if c1 > c2:\n            c1, c2, v1, v2 = c2, c1, v2, v1\n        gap = c2 - c1\n        for c in range(c1, cols):\n            steps = c - c1\n            if steps % gap == 0:\n                val = v1 if (steps // gap) % 2 == 0 else v2\n                for r in range(rows):\n                    result[r][c] = val\n    else:  # row-based pattern\n        if r1 > r2:\n            r1, r2, v1, v2 = r2, r1, v2, v1\n        gap = r2 - r1\n        for r in range(r1, rows):\n            steps = r - r1\n            if steps % gap == 0:\n                val = v1 if (steps // gap) % 2 == 0 else v2\n                for c in range(cols):\n                    result[r][c] = val\n    \n    return result",
