  "raw_response": "def solve(grid):\n    import copy\n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find connected components of non-zero cells\n    def flood(r, c, val):\n        stack = [(r,c)]\n        cells = []\n        while stack:\n            x,y = stack.pop()\n            if x<0 or x>=rows or y<0 or y>=cols: continue\n            if visited[x][y] or grid[x][y]!=val: continue\n            visited[x][y]=True\n            cells.append((x,y))\n            for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n                stack.append((x+dx,y+dy))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c] and grid[r][c]!=0:\n                val = grid[r][c]\n                cells = flood(r,c,val)\n                rs = [x for x,y in cells]\n                cs = [y for x,y in cells]\n                r1,r2,c1,c2 = min(rs),max(rs),min(cs),max(cs)\n                for i in range(r1+1,r2):\n                    for j in range(c1+1,c2):\n                        result[i][j] = 8\n    return result",
  "script": "def solve(grid):\n    import copy\n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find connected components of non-zero cells\n    def flood(r, c, val):\n        stack = [(r,c)]\n        cells = []\n        while stack:\n            x,y = stack.pop()\n            if x<0 or x>=rows or y<0 or y>=cols: continue\n            if visited[x][y] or grid[x][y]!=val: continue\n            visited[x][y]=True\n            cells.append((x,y))\n            for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n                stack.append((x+dx,y+dy))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c] and grid[r][c]!=0:\n                val = grid[r][c]\n                cells = flood(r,c,val)\n                rs = [x for x,y in cells]\n                cs = [y for x,y in cells]\n                r1,r2,c1,c2 = min(rs),max(rs),min(cs),max(cs)\n                for i in range(r1+1,r2):\n                    for j in range(c1+1,c2):\n                        result[i][j] = 8\n    return result",
