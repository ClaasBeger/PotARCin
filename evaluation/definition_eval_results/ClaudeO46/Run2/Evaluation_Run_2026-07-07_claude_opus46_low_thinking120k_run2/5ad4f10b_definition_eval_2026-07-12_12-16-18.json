  "raw_response": "```python\ndef solve(grid):\n    colors = set()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                colors.add(v)\n    colors = list(colors)\n    \n    for shape_color in colors:\n        scatter_color = [c for c in colors if c != shape_color][0]\n        \n        positions = [(r,c) for r in range(len(grid)) for c in range(len(grid[0])) if grid[r][c] == shape_color]\n        if not positions:\n            continue\n        min_r = min(r for r,c in positions)\n        max_r = max(r for r,c in positions)\n        min_c = min(c for r,c in positions)\n        max_c = max(c for r,c in positions)\n        \n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n        \n        if h % 3 != 0 or w % 3 != 0:\n            continue\n            \n        bh = h // 3\n        bw = w // 3\n        \n        pattern = [[0]*3 for _ in range(3)]\n        valid = True\n        for bi in range(3):\n            for bj in range(3):\n                r_start = min_r + bi * bh\n                c_start = min_c + bj * bw\n                count = sum(1 for r in range(r_start, r_start+bh) for c in range(c_start, c_start+bw) if grid[r][c] == shape_color)\n                if count == bh * bw:\n                    pattern[bi][bj] = 1\n                elif count > 0:\n                    valid = False\n                    break\n            if not valid:\n                break\n        \n        if valid:\n            return [[scatter_color if pattern[i][j] else 0 for j in range(3)] for i in range(3)]\n    \n    return grid\n```",
  "script": "def solve(grid):\n    colors = set()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                colors.add(v)\n    colors = list(colors)\n    \n    for shape_color in colors:\n        scatter_color = [c for c in colors if c != shape_color][0]\n        \n        positions = [(r,c) for r in range(len(grid)) for c in range(len(grid[0])) if grid[r][c] == shape_color]\n        if not positions:\n            continue\n        min_r = min(r for r,c in positions)\n        max_r = max(r for r,c in positions)\n        min_c = min(c for r,c in positions)\n        max_c = max(c for r,c in positions)\n        \n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n        \n        if h % 3 != 0 or w % 3 != 0:\n            continue\n            \n        bh = h // 3\n        bw = w // 3\n        \n        pattern = [[0]*3 for _ in range(3)]\n        valid = True\n        for bi in range(3):\n            for bj in range(3):\n                r_start = min_r + bi * bh\n                c_start = min_c + bj * bw\n                count = sum(1 for r in range(r_start, r_start+bh) for c in range(c_start, c_start+bw) if grid[r][c] == shape_color)\n                if count == bh * bw:\n                    pattern[bi][bj] = 1\n                elif count > 0:\n                    valid = False\n                    break\n            if not valid:\n                break\n        \n        if valid:\n            return [[scatter_color if pattern[i][j] else 0 for j in range(3)] for i in range(3)]\n    \n    return grid",
