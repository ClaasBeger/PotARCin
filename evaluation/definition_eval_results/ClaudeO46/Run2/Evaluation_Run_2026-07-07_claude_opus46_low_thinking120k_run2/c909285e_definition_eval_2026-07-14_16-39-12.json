  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Count all values to find the grid's \"separator\" value (most common besides 0)\n    # Find the special border color: appears in a rectangular outline\n    # Strategy: find cells that differ from the expected pattern - the unique color\n    \n    from collections import Counter\n    counts = Counter()\n    for r in range(rows):\n        for c in range(cols):\n            counts[grid[r][c]] += 1\n    \n    # Find positions of each value and identify which forms a rectangle border\n    all_vals = set(counts.keys())\n    \n    for val in all_vals:\n        positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == val]\n        if len(positions) < 4:\n            continue\n        rs = [p[0] for p in positions]\n        cs = [p[1] for p in positions]\n        min_r, max_r = min(rs), max(rs)\n        min_c, max_c = min(cs), max(cs)\n        \n        # Check if positions form a rectangle border\n        expected = set()\n        for r in range(min_r, max_r + 1):\n            expected.add((r, min_c))\n            expected.add((r, max_c))\n        for c in range(min_c, max_c + 1):\n            expected.add((min_r, c))\n            expected.add((max_r, c))\n        \n        if set(positions) == expected:\n            # Extract the subgrid\n            result = []\n            for r in range(min_r, max_r + 1):\n                row = []\n                for c in range(min_c, max_c + 1):\n                    row.append(grid[r][c])\n                result.append(row)\n            return result\n    \n    return grid\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Count all values to find the grid's \"separator\" value (most common besides 0)\n    # Find the special border color: appears in a rectangular outline\n    # Strategy: find cells that differ from the expected pattern - the unique color\n    \n    from collections import Counter\n    counts = Counter()\n    for r in range(rows):\n        for c in range(cols):\n            counts[grid[r][c]] += 1\n    \n    # Find positions of each value and identify which forms a rectangle border\n    all_vals = set(counts.keys())\n    \n    for val in all_vals:\n        positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == val]\n        if len(positions) < 4:\n            continue\n        rs = [p[0] for p in positions]\n        cs = [p[1] for p in positions]\n        min_r, max_r = min(rs), max(rs)\n        min_c, max_c = min(cs), max(cs)\n        \n        # Check if positions form a rectangle border\n        expected = set()\n        for r in range(min_r, max_r + 1):\n            expected.add((r, min_c))\n            expected.add((r, max_c))\n        for c in range(min_c, max_c + 1):\n            expected.add((min_r, c))\n            expected.add((max_r, c))\n        \n        if set(positions) == expected:\n            # Extract the subgrid\n            result = []\n            for r in range(min_r, max_r + 1):\n                row = []\n                for c in range(min_c, max_c + 1):\n                    row.append(grid[r][c])\n                result.append(row)\n            return result\n    \n    return grid",
