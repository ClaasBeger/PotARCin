  "raw_response": "```python\nfrom itertools import combinations\n\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    ones = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1:\n                ones.add((r, c))\n    \n    if not ones:\n        return grid\n    \n    t_min_r = min(r for r, c in ones)\n    t_max_r = max(r for r, c in ones)\n    t_min_c = min(c for r, c in ones)\n    t_max_c = max(c for r, c in ones)\n    \n    template_fours = []\n    outside_fours = []\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 4:\n                if t_min_r <= r <= t_max_r and t_min_c <= c <= t_max_c:\n                    template_fours.append((r, c))\n                else:\n                    outside_fours.append((r, c))\n    \n    if not template_fours:\n        return grid\n    \n    n = len(template_fours)\n    f_min_r = min(r for r, c in template_fours)\n    f_max_r = max(r for r, c in template_fours)\n    f_min_c = min(c for r, c in template_fours)\n    f_max_c = max(c for r, c in template_fours)\n    t_h = f_max_r - f_min_r + 1\n    t_w = f_max_c - f_min_c + 1\n    \n    valid_bbs = {(t_h, t_w)}\n    if t_h != t_w:\n        valid_bbs.add((t_w, t_h))\n    \n    result = [row[:] for row in grid]\n    \n    valid_groups = []\n    for combo in combinations(range(len(outside_fours)), n):\n        pts = [outside_fours[i] for i in combo]\n        bb_min_r = min(r for r, c in pts)\n        bb_max_r = max(r for r, c in pts)\n        bb_min_c = min(c for r, c in pts)\n        bb_max_c = max(c for r, c in pts)\n        h = bb_max_r - bb_min_r + 1\n        w = bb_max_c - bb_min_c + 1\n        if (h, w) in valid_bbs:\n            valid_groups.append(combo)\n    \n    used = set()\n    for combo in valid_groups:\n        if any(i in used for i in combo):\n            continue\n        pts = [outside_fours[i] for i in combo]\n        bb_min_r = min(r for r, c in pts)\n        bb_max_r = max(r for r, c in pts)\n        bb_min_c = min(c for r, c in pts)\n        bb_max_c = max(c for r, c in pts)\n        \n        rect_min_r = bb_min_r - 1\n        rect_max_r = bb_max_r + 1\n        rect_min_c = bb_min_c - 1\n        rect_max_c = bb_max_c + 1\n        \n        pts_set = set(combo)\n        conflict = False\n        for idx, pt in enumerate(outside_fours):\n            if idx not in pts_set and rect_min_r <= pt[0] <= rect_max_r and rect_min_c <= pt[1] <= rect_max_c:\n                conflict = True\n                break\n        if conflict:\n            continue\n        \n        for i in combo:\n            used.add(i)\n        \n        for r in range(max(0, rect_min_r), min(rows, rect_max_r + 1)):\n            for c in range(max(0, rect_min_c), min(cols, rect_max_c + 1)):\n                if result[r][c] == 0:\n                    result[r][c] = 1\n    \n    return result\n```",
