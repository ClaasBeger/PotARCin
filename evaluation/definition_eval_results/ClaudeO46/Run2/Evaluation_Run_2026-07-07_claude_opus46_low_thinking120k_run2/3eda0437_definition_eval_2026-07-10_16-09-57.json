  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    best = (0, 0, 0, 0, 0)\n    for r1 in range(rows):\n        for c1 in range(cols):\n            for r2 in range(r1, rows):\n                for c2 in range(c1, cols):\n                    all_zero = True\n                    for r in range(r1, r2+1):\n                        for c in range(c1, c2+1):\n                            if grid[r][c] != 0:\n                                all_zero = False\n                                break\n                        if not all_zero:\n                            break\n                    if all_zero:\n                        area = (r2-r1+1)*(c2-c1+1)\n                        if area > best[0]:\n                            best = (area, r1, c1, r2, c2)\n    \n    result = [row[:] for row in grid]\n    _, r1, c1, r2, c2 = best\n    for r in range(r1, r2+1):\n        for c in range(c1, c2+1):\n            result[r][c] = 6\n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    best = (0, 0, 0, 0, 0)\n    for r1 in range(rows):\n        for c1 in range(cols):\n            for r2 in range(r1, rows):\n                for c2 in range(c1, cols):\n                    all_zero = True\n                    for r in range(r1, r2+1):\n                        for c in range(c1, c2+1):\n                            if grid[r][c] != 0:\n                                all_zero = False\n                                break\n                        if not all_zero:\n                            break\n                    if all_zero:\n                        area = (r2-r1+1)*(c2-c1+1)\n                        if area > best[0]:\n                            best = (area, r1, c1, r2, c2)\n    \n    result = [row[:] for row in grid]\n    _, r1, c1, r2, c2 = best\n    for r in range(r1, r2+1):\n        for c in range(c1, c2+1):\n            result[r][c] = 6\n    return result",
