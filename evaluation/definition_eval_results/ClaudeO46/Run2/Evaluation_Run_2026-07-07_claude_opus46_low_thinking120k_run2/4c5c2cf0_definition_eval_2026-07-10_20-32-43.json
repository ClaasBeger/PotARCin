  "raw_response": "```python\ndef solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    colors = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                v = grid[r][c]\n                if v not in colors:\n                    colors[v] = []\n                colors[v].append((r, c))\n    \n    x_color = None\n    center = None\n    for color, cells in colors.items():\n        cells_set = set(cells)\n        for r, c in cells:\n            if (r-1,c-1) in cells_set and (r-1,c+1) in cells_set and (r+1,c-1) in cells_set and (r+1,c+1) in cells_set:\n                x_color = color\n                center = (r, c)\n                break\n        if x_color:\n            break\n    \n    other_color = None\n    for color in colors:\n        if color != x_color:\n            other_color = color\n    \n    result = [row[:] for row in grid]\n    cr, cc = center\n    \n    for r, c in colors[other_color]:\n        dr, dc = r - cr, c - cc\n        for sr, sc in [(-1,1),(1,-1),(-1,-1)]:\n            nr, nc = cr + sr*dr, cc + sc*dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                result[nr][nc] = other_color\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    colors = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                v = grid[r][c]\n                if v not in colors:\n                    colors[v] = []\n                colors[v].append((r, c))\n    \n    x_color = None\n    center = None\n    for color, cells in colors.items():\n        cells_set = set(cells)\n        for r, c in cells:\n            if (r-1,c-1) in cells_set and (r-1,c+1) in cells_set and (r+1,c-1) in cells_set and (r+1,c+1) in cells_set:\n                x_color = color\n                center = (r, c)\n                break\n        if x_color:\n            break\n    \n    other_color = None\n    for color in colors:\n        if color != x_color:\n            other_color = color\n    \n    result = [row[:] for row in grid]\n    cr, cc = center\n    \n    for r, c in colors[other_color]:\n        dr, dc = r - cr, c - cc\n        for sr, sc in [(-1,1),(1,-1),(-1,-1)]:\n            nr, nc = cr + sr*dr, cc + sc*dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                result[nr][nc] = other_color\n    \n    return result",
