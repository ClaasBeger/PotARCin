  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    visited = [[False]*cols for _ in range(rows)]\n    \n    def find_rect(r, c):\n        from collections import deque\n        q = deque([(r, c)])\n        visited[r][c] = True\n        cells = [(r, c)]\n        while q:\n            cr, cc = q.popleft()\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = cr+dr, cc+dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] != 0:\n                    visited[nr][nc] = True\n                    q.append((nr, nc))\n                    cells.append((nr, nc))\n        return cells\n    \n    rectangles = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                rectangles.append(find_rect(r, c))\n    \n    for cells in rectangles:\n        min_r = min(r for r, c in cells)\n        max_r = max(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        max_c = max(c for r, c in cells)\n        \n        two_r = two_c = None\n        for r, c in cells:\n            if grid[r][c] == 2:\n                two_r, two_c = r, c\n                break\n        if two_r is None:\n            continue\n        \n        if two_r == min_r:\n            bh = max_r - min_r\n            for r in range(0, min_r):\n                for dc in range(-bh, bh+1):\n                    nc = two_c + dc\n                    if 0 <= nc < cols:\n                        result[r][nc] = 2 if dc == 0 else 3\n        elif two_r == max_r:\n            bh = max_r - min_r\n            for r in range(max_r + 1, rows):\n                for dc in range(-bh, bh+1):\n                    nc = two_c + dc\n                    if 0 <= nc < cols:\n                        result[r][nc] = 2 if dc == 0 else 3\n        elif two_c == min_c:\n            bh = max_c - min_c\n    