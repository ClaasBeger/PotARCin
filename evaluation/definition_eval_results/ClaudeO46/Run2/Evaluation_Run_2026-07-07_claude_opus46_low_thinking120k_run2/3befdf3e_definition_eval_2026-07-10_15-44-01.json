  "raw_response": "```python\ndef solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find connected components of non-zero cells\n    def flood(r, c, val):\n        stack = [(r,c)]\n        cells = []\n        while stack:\n            y,x = stack.pop()\n            if y<0 or y>=rows or x<0 or x>=cols: continue\n            if visited[y][x] or grid[y][x]==0: continue\n            visited[y][x] = True\n            cells.append((y,x))\n            for dy,dx in [(-1,0),(1,0),(0,-1),(0,1)]:\n                stack.append((y+dy,x+dx))\n        return cells\n    \n    objects = []\n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c] and grid[r][c] != 0:\n                cells = flood(r, c, grid[r][c])\n                objects.append(cells)\n    \n    for cells in objects:\n        min_r = min(r for r,c in cells)\n        max_r = max(r for r,c in cells)\n        min_c = min(c for r,c in cells)\n        max_c = max(c for r,c in cells)\n        \n        # Extract subgrid\n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n        \n        border_color = grid[min_r][min_c]\n        # Find inner color\n        inner_colors = set()\n        for r,c in cells:\n            if grid[r][c] != border_color:\n                inner_colors.add(grid[r][c])\n        if not inner_colors:\n            continue\n        inner_color = inner_colors.pop()\n        \n        # Find inner region bounds\n        inner_cells = [(r,c) for r,c in cells if grid[r][c]==inner_color]\n        ih = max(r for r,c in inner_cells) - min(r for r,c in inner_cells) + 1\n        iw = max(c for r,c in inner_cells) - min(c for r,c in inner_cells) + 1\n        \n        # New expanded rectangle: grow by ih on top/bottom, iw on left/right\n        new_min_r = min_r - ih\n        new_max_r = max_r + ih\n        new_min_c = min_c - iw\n        new_max_c = max_c + iw\n        \n        # Clear original area first\n        for r in range(min_r, max_r+1):\n            for c in range(min_c, max_c+1):\n                result[r][c] = 0\n        \n        # Draw new pattern: outer border = border_color (thickness ih/iw), then swap inner\n        for r in range(new_min_r, new_max_r+1):\n            for c in range(new_min_c, new_max_c+1):\n                if 0 <= r < rows and 0 <= c < cols:\n                    # Check if in outer ring\n                    if r < min_r or r > max_r or c < min_c or c > max_c:\n                        result[r][c] = border_color\n                    elif r < min_r + 1 or r > max_r - 1 or c < min_c + 1 or c > max_c - 1:\n                        # original border -> inner_color\n                        result[r][c] = inner_color\n                    else:\n                        # original inner -> border_color\n                        result[r][c] = border_color\n        \n        # Actually let me redo: just swap colors in original region and add outer border\n        for r in range(new_min_r, new_max_r+1):\n            for c in range(new_min_c, new_max_c+1):\n                if 0 <= r < rows and 0 <= c < cols:\n                    if min_r <= r <= max_r and min_c <= c <= max_c:\n                        orig = grid[r][c]\n                        if orig == border_color:\n                            result[r][c] = inner_color\n                        else:\n                            result[r][c] = border_color\n                    else:\n                        result[r][c] = border_color\n    \n    return result\n```",
