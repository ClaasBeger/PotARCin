  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                # Check if this is a center (has all 4 neighbors same and different from center)\n                center = grid[r][c]\n                if (r-1 >= 0 and r+1 < rows and c-1 >= 0 and c+1 < cols and\n                    grid[r-1][c] != 0 and grid[r+1][c] != 0 and\n                    grid[r][c-1] != 0 and grid[r][c+1] != 0 and\n                    grid[r-1][c] == grid[r+1][c] == grid[r][c-1] == grid[r][c+1] and\n                    grid[r-1][c] != center):\n                    \n                    arm = grid[r-1][c]\n                    # Add diagonal neighbors at dist 1 with center color\n                    for dr, dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            out[nr][nc] = center\n                    # Add at dist 2 on axes with center color\n                    for dr, dc in [(-2,0),(2,0),(0,-2),(0,2)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            out[nr][nc] = arm\n                    # Add at dist 2 diagonals with center color\n                    for dr, dc in [(-2,-2),(-2,2),(2,-2),(2,2)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            out[nr][nc] = center\n    \n    return out",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                # Check if this is a center (has all 4 neighbors same and different from center)\n                center = grid[r][c]\n                if (r-1 >= 0 and r+1 < rows and c-1 >= 0 and c+1 < cols and\n                    grid[r-1][c] != 0 and grid[r+1][c] != 0 and\n                    grid[r][c-1] != 0 and grid[r][c+1] != 0 and\n                    grid[r-1][c] == grid[r+1][c] == grid[r][c-1] == grid[r][c+1] and\n                    grid[r-1][c] != center):\n                    \n                    arm = grid[r-1][c]\n                    # Add diagonal neighbors at dist 1 with center color\n                    for dr, dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            out[nr][nc] = center\n                    # Add at dist 2 on axes with center color\n                    for dr, dc in [(-2,0),(2,0),(0,-2),(0,2)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            out[nr][nc] = arm\n                    # Add at dist 2 diagonals with center color\n                    for dr, dc in [(-2,-2),(-2,2),(2,-2),(2,2)]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            out[nr][nc] = center\n    \n    return out",
