  "raw_response": "```python\ndef solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    result = [row[:] for row in grid]\n    \n    visited = [[False]*cols for _ in range(rows)]\n    \n    def get_component(r, c):\n        comp = []\n        stack = [(r, c)]\n        while stack:\n            cr, cc = stack.pop()\n            if 0 <= cr < rows and 0 <= cc < cols and not visited[cr][cc] and grid[cr][cc] == 2:\n                visited[cr][cc] = True\n                comp.append((cr, cc))\n                for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    stack.append((cr+dr, cc+dc))\n        return comp\n    \n    components = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2 and not visited[r][c]:\n                comp = get_component(r, c)\n                components.append(comp)\n    \n    for comp in components:\n        if len(comp) == 2:\n            cells = set(comp)\n            for r, c in comp:\n                for dr in [-1, 0, 1]:\n                    for dc in [-1, 0, 1]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells and result[nr][nc] == 0:\n                            result[nr][nc] = 3\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    result = [row[:] for row in grid]\n    \n    visited = [[False]*cols for _ in range(rows)]\n    \n    def get_component(r, c):\n        comp = []\n        stack = [(r, c)]\n        while stack:\n            cr, cc = stack.pop()\n            if 0 <= cr < rows and 0 <= cc < cols and not visited[cr][cc] and grid[cr][cc] == 2:\n                visited[cr][cc] = True\n                comp.append((cr, cc))\n                for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                    stack.append((cr+dr, cc+dc))\n        return comp\n    \n    components = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2 and not visited[r][c]:\n                comp = get_component(r, c)\n                components.append(comp)\n    \n    for comp in components:\n        if len(comp) == 2:\n            cells = set(comp)\n            for r, c in comp:\n                for dr in [-1, 0, 1]:\n                    for dc in [-1, 0, 1]:\n                        nr, nc = r+dr, c+dc\n                        if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells and result[nr][nc] == 0:\n                            result[nr][nc] = 3\n    \n    return result",
