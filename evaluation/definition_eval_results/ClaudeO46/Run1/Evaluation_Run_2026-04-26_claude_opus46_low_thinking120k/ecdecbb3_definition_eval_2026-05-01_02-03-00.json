  "raw_response": "```python\ndef solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    out = copy.deepcopy(grid)\n    \n    h_lines = [r for r in range(rows) if all(grid[r][c] == 8 for c in range(cols))]\n    v_lines = [c for c in range(cols) if all(grid[r][c] == 8 for r in range(rows))]\n    twos = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    def patch8(cr, cc):\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = cr + dr, cc + dc\n                if 0 <= nr < rows and 0 <= nc < cols:\n                    if nr == cr and nc == cc:\n                        out[nr][nc] = 2\n                    else:\n                        out[nr][nc] = 8\n    \n    for r2, c2 in twos:\n        for hl in sorted(h_lines, reverse=True):\n            if hl < r2:\n                for r in range(hl, r2): out[r][c2] = 2\n                patch8(hl, c2)\n                break\n        for hl in sorted(h_lines):\n            if hl > r2:\n                for r in range(r2+1, hl+1): out[r][c2] = 2\n                patch8(hl, c2)\n                break\n        for vl in sorted(v_lines, reverse=True):\n            if vl < c2:\n                for c in range(vl, c2): out[r2][c] = 2\n                patch8(r2, vl)\n                break\n        for vl in sorted(v_lines):\n            if vl > c2:\n                for c in range(c2+1, vl+1): out[r2][c] = 2\n                patch8(r2, vl)\n                break\n    \n    return out\n```",
  "script": "def solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    out = copy.deepcopy(grid)\n    \n    h_lines = [r for r in range(rows) if all(grid[r][c] == 8 for c in range(cols))]\n    v_lines = [c for c in range(cols) if all(grid[r][c] == 8 for r in range(rows))]\n    twos = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    def patch8(cr, cc):\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = cr + dr, cc + dc\n                if 0 <= nr < rows and 0 <= nc < cols:\n                    if nr == cr and nc == cc:\n                        out[nr][nc] = 2\n                    else:\n                        out[nr][nc] = 8\n    \n    for r2, c2 in twos:\n        for hl in sorted(h_lines, reverse=True):\n            if hl < r2:\n                for r in range(hl, r2): out[r][c2] = 2\n                patch8(hl, c2)\n                break\n        for hl in sorted(h_lines):\n            if hl > r2:\n                for r in range(r2+1, hl+1): out[r][c2] = 2\n                patch8(hl, c2)\n                break\n        for vl in sorted(v_lines, reverse=True):\n            if vl < c2:\n                for c in range(vl, c2): out[r2][c] = 2\n                patch8(r2, vl)\n                break\n        for vl in sorted(v_lines):\n            if vl > c2:\n                for c in range(c2+1, vl+1): out[r2][c] = 2\n                patch8(r2, vl)\n                break\n    \n    return out",
