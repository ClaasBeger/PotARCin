0 0 0 3 0 0 0 0\n0 0 0 0 0 3 3 0 0 0\n8 8 8 0 0 0 0 0 4 0\n8 0 0 0 0 0 0 0 4 0\n0 0 0 0 7 7 7 0 4 0\n0 0 0 0 0 0 7 0 0 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "```python\ndef solve(grid):\n    import copy\n    grid = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the cross of 5s - determine the quadrant boundary\n    border_row, border_col = 0, 0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5:\n                border_row = max(border_row, r)\n                border_col = max(border_col, c)\n    \n    # Extract shapes as sets of relative coordinates\n    def get_shape(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        return frozenset((r - min_r, c - min_c) for r, c in cells)\n    \n    def flood_fill(sr, sc, visited):\n        color = grid[sr][sc]\n        cells = []\n        stack = [(sr, sc)]\n        while stack:\n            r, c = stack.pop()\n            if (r, c) in visited or r < 0 or r >= rows or c < 0 or c >= cols:\n                continue\n            if grid[r][c] != color:\n                continue\n            visited.add((r, c))\n            cells.append((r, c))\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                stack.append((r+dr, c+dc))\n        return cells\n    \n    # Find reference shapes in top-left quadrant (excluding 5s and 0s)\n    visited = set()\n    ref_shapes = {}\n    for r in range(border_row + 1):\n        for c in range(border_col + 1):\n            if (r, c) not in visited and grid[r][c] not in (0, 5):\n                cells = flood_fill(r, c, visited)\n                shape = get_shape(cells)\n                ref_shapes[shape] = grid[r][c]\n    \n    # Find all other shapes outside the quadrant\n    other_groups = []\n    for r in range(rows):\n        for c in range(cols):\n            if (r, c) not in visited and grid[r][c] not in (0, 5):\n                cells = flood_fill(r, c, visited)\n                other_groups.append(cells)\n    \n    # Check each outside shape against reference shapes\n    for cells in other_groups:\n        shape = get_shape(cells)\n        if shape in ref_shapes:\n            for r, c in cells:\n                grid[r][c] = 5\n    \n    return grid\n```",
  "script": "def solve(grid):\n    import copy\n    grid = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the cross of 5s - determine the quadrant boundary\n    border_row, border_col = 0, 0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5:\n                border_row = max(border_row, r)\n                border_col = max(border_col, c)\n    \n    # Extract shapes as sets of relative coordinates\n    def get_shape(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        return frozenset((r - min_r, c - min_c) for r, c in cells)\n    \n    def flood_fill(sr, sc, visited):\n        color = grid[sr][sc]\n        cells = []\n        stack = [(sr, sc)]\n        while stack:\n            r, c = stack.pop()\n            if (r, c) in visited or r < 0 or r >= rows or c < 0 or c >= cols:\n                continue\n            if grid[r][c] != color:\n                continue\n            visited.add((r, c))\n            cells.append((r, c))\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                stack.append((r+dr, c+dc))\n        return cells\n    \n    # Find reference shapes in top-left quadrant (excluding 5s and 0s)\n    visited = set()\n    ref_shapes = {}\n    for r in range(border_row + 1):\n        for c in range(border_col + 1):\n            if (r, c) not in visited and grid[r][c] not in (0, 5):\n                cells = flood_fill(r, c, visited)\n                shape = get_shape(cells)\n                ref_shapes[shape] = grid[r][c]\n    \n    # Find all other shapes outside the quadrant\n    other_groups = []\n    for r in range(rows):\n        for c in range(cols):\n            if (r, c) not in visited and grid[r][c] not in (0, 5):\n                cells = flood_fill(r, c, visited)\n                other_groups.append(cells)\n    \n    # Check each outside shape against reference shapes\n    for cells in other_groups:\n        shape = get_shape(cells)\n        if shape in ref_shapes:\n            for r, c in cells:\n                grid[r][c] = 5\n    \n    return grid",
