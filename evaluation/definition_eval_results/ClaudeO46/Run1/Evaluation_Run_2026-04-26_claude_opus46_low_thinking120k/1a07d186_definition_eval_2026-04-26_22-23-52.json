  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    h_lines = {}\n    for r in range(rows):\n        if all(grid[r][c] == grid[r][0] for c in range(cols)) and grid[r][0] != 0:\n            h_lines.setdefault(grid[r][0], []).append(r)\n    \n    v_lines = {}\n    for c in range(cols):\n        if all(grid[r][c] == grid[0][c] for r in range(rows)) and grid[0][c] != 0:\n            v_lines.setdefault(grid[0][c], []).append(c)\n    \n    h_line_rows = set()\n    v_line_cols = set()\n    for rlist in h_lines.values(): h_line_rows.update(rlist)\n    for clist in v_lines.values(): v_line_cols.update(clist)\n    \n    out = [[0]*cols for _ in range(rows)]\n    \n    for r in h_line_rows:\n        for c in range(cols):\n            out[r][c] = grid[r][c]\n    for c in v_line_cols:\n        for r in range(rows):\n            out[r][c] = grid[r][c]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 or r in h_line_rows or c in v_line_cols:\n                continue\n            color = grid[r][c]\n            \n            if color in v_lines:\n                nearest = min(v_lines[color], key=lambda lc: abs(c - lc))\n                if c < nearest:\n                    out[r][nearest-1] = color\n                else:\n                    out[r][nearest+1] = color\n            \n            if color in h_lines:\n                nearest = min(h_lines[color], key=lambda lr: abs(r - lr))\n                if r < nearest:\n                    out[nearest-1][c] = color\n                else:\n                    out[nearest+1][c] = color\n    \n    return out\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    h_lines = {}\n    for r in range(rows):\n        if all(grid[r][c] == grid[r][0] for c in range(cols)) and grid[r][0] != 0:\n            h_lines.setdefault(grid[r][0], []).append(r)\n    \n    v_lines = {}\n    for c in range(cols):\n        if all(grid[r][c] == grid[0][c] for r in range(rows)) and grid[0][c] != 0:\n            v_lines.setdefault(grid[0][c], []).append(c)\n    \n    h_line_rows = set()\n    v_line_cols = set()\n    for rlist in h_lines.values(): h_line_rows.update(rlist)\n    for clist in v_lines.values(): v_line_cols.update(clist)\n    \n    out = [[0]*cols for _ in range(rows)]\n    \n    for r in h_line_rows:\n        for c in range(cols):\n            out[r][c] = grid[r][c]\n    for c in v_line_cols:\n        for r in range(rows):\n            out[r][c] = grid[r][c]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 or r in h_line_rows or c in v_line_cols:\n                continue\n            color = grid[r][c]\n            \n            if color in v_lines:\n                nearest = min(v_lines[color], key=lambda lc: abs(c - lc))\n                if c < nearest:\n                    out[r][nearest-1] = color\n                else:\n                    out[r][nearest+1] = color\n            \n            if color in h_lines:\n                nearest = min(h_lines[color], key=lambda lr: abs(r - lr))\n                if r < nearest:\n                    out[nearest-1][c] = color\n                else:\n                    out[nearest+1][c] = color\n    \n    return out",
