7 7 4 0 0 0 0 4\n0 0 0 8 0 0 7 0 0 0\n0 0 0 0 0 9 0 4 0 0\n5 5 0 3 0 0 6 7 0 7\n0 0 3 0 0 0 0 0 0 2\n1 0 1 0 0 0 0 0 6 7\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "```python\ndef solve(grid):\n    from collections import Counter\n    rows, cols = len(grid), len(grid[0])\n    counts = Counter()\n    pos = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] += 1\n                pos[grid[r][c]] = (r, c)\n    \n    unique = [v for v, cnt in counts.items() if cnt == 1][0]\n    ur, uc = pos[unique]\n    \n    out = [[0]*cols for _ in range(rows)]\n    for dr in range(-1, 2):\n        for dc in range(-1, 2):\n            nr, nc = ur+dr, uc+dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                out[nr][nc] = unique if (dr == 0 and dc == 0) else 2\n    return out\n```",
  "script": "def solve(grid):\n    from collections import Counter\n    rows, cols = len(grid), len(grid[0])\n    counts = Counter()\n    pos = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] += 1\n                pos[grid[r][c]] = (r, c)\n    \n    unique = [v for v, cnt in counts.items() if cnt == 1][0]\n    ur, uc = pos[unique]\n    \n    out = [[0]*cols for _ in range(rows)]\n    for dr in range(-1, 2):\n        for dc in range(-1, 2):\n            nr, nc = ur+dr, uc+dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                out[nr][nc] = unique if (dr == 0 and dc == 0) else 2\n    return out",
