  "raw_response": "```python\ndef solve(grid):\n    import itertools\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    fours = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 4]\n    \n    # Find rectangles of 4 corners\n    for (r1,c1),(r2,c2),(r3,c3),(r4,c4) in itertools.combinations(fours,4):\n        rs = sorted(set([r1,r2,r3,r4]))\n        cs = sorted(set([c1,c2,c3,c4]))\n        if len(rs)==2 and len(cs)==2:\n            corners = {(rs[0],cs[0]),(rs[0],cs[1]),(rs[1],cs[0]),(rs[1],cs[1])}\n            if corners == {(r1,c1),(r2,c2),(r3,c3),(r4,c4)}:\n                for r in range(rs[0]+1, rs[1]):\n                    for c in range(cs[0]+1, cs[1]):\n                        result[r][c] = 2\n    return result\n```",
  "script": "def solve(grid):\n    import itertools\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    fours = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 4]\n    \n    # Find rectangles of 4 corners\n    for (r1,c1),(r2,c2),(r3,c3),(r4,c4) in itertools.combinations(fours,4):\n        rs = sorted(set([r1,r2,r3,r4]))\n        cs = sorted(set([c1,c2,c3,c4]))\n        if len(rs)==2 and len(cs)==2:\n            corners = {(rs[0],cs[0]),(rs[0],cs[1]),(rs[1],cs[0]),(rs[1],cs[1])}\n            if corners == {(r1,c1),(r2,c2),(r3,c3),(r4,c4)}:\n                for r in range(rs[0]+1, rs[1]):\n                    for c in range(cs[0]+1, cs[1]):\n                        result[r][c] = 2\n    return result",
