ython script itself, no other text or markdown.",
  "raw_response": "Looking at the examples, I identified this pattern:\n\n1. Each grid has a background color and exactly 3 non-background shapes\n2. One shape has **2\u00d72 block structure** (rows come in identical pairs) \u2014 the \"scaled\" shape\n3. Downscaling this shape (merging paired rows and adjacent identical columns) produces a boolean pattern\n4. This downscaled pattern appears as a **sub-pattern** within exactly one of the other two shapes\n5. The **output** is the bounding box of that matching shape\n\nI verified this rule works for all 4 examples and the test input.\n\n```python\ndef solve(grid):\n    from collections import Counter\n\n    rows, cols = len(grid), len(grid[0])\n    flat = [grid[r][c] for r in range(rows) for c in range(cols)]\n    bg = Counter(flat).most_common(1)[0][0]\n    colors = set(flat) - {bg}\n\n    shapes = []\n    for color in colors:\n        positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == color]\n        min_r = min(r for r, c in positions)\n        max_r = max(r for r, c in positions)\n        min_c = min(c for r, c in positions)\n        max_c = max(c for r, c in positions)\n        bbox = [grid[r][min_c:max_c+1] for r in range(min_r, max_r+1)]\n        pattern = [[1 if cell == color else 0 for cell in row] for row in bbox]\n        shapes.append({'color': color, 'bbox': bbox, 'pattern': pattern})\n\n    def get_row_scale(pattern):\n        h = len(pattern)\n        for scale in [2, 3, 4]:\n            if h % scale != 0:\n                continue\n            ok = True\n            for r in range(0, h, scale):\n                for s in range(1, scale):\n                    if pattern[r] != pattern[r + s]:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                return scale\n        return 0\n\n    def downscale(pattern, rs):\n        w = len(pattern[0])\n        dr = [pattern[r] for r in range(0, len(pattern), rs)]\n        dh = len(dr)\n        cg = [0]\n        for c in range(1, w):\n            if not all(dr[r][c] == dr[r][c-1] for r in range(dh)):\n                cg.append(c)\n        return [[dr[r][c] for c in cg] for r in range(dh)]\n\n    def has_sub(big, small):\n        bh, bw = len(big), len(big[0])\n        sh, sw = len(small), len(small[0])\n        for r in range(bh - sh + 1):\n            for c in range(bw - sw + 1):\n                if all(big[r+i][c+j] == small[i][j] for i in range(sh) for j in range(sw)):\n                    return True\n        return False\n\n    for i, s in enumerate(shapes):\n        rs = get_row_scale(s['pattern'])\n        if rs < 2:\n            continue\n        ds = downscale(s['pattern'], rs)\n        for j, o in enumerate(shapes):\n            if j == i:\n                continue\n            if has_sub(o['pattern'], ds):\n                return o['bbox']\n\n    return shapes[0]['bbox']\n```",
  "script": "def solve(grid):\n    from collections import Counter\n\n    rows, cols = len(grid), len(grid[0])\n    flat = [grid[r][c] for r in range(rows) for c in range(cols)]\n    bg = Counter(flat).most_common(1)[0][0]\n    colors = set(flat) - {bg}\n\n    shapes = []\n    for color in colors:\n        positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == color]\n        min_r = min(r for r, c in positions)\n        max_r = max(r for r, c in positions)\n        min_c = min(c for r, c in positions)\n        max_c = max(c for r, c in positions)\n        bbox = [grid[r][min_c:max_c+1] for r in range(min_r, max_r+1)]\n        pattern = [[1 if cell == color else 0 for cell in row] for row in bbox]\n        shapes.append({'color': color, 'bbox': bbox, 'pattern': pattern})\n\n    def get_row_scale(pattern):\n        h = len(pattern)\n        for scale in [2, 3, 4]:\n            if h % scale != 0:\n                continue\n            ok = True\n            for r in range(0, h, scale):\n                for s in range(1, scale):\n                    if pattern[r] != pattern[r + s]:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                return scale\n        return 0\n\n    def downscale(pattern, rs):\n        w = len(pattern[0])\n        dr = [pattern[r] for r in range(0, len(pattern), rs)]\n        dh = len(dr)\n        cg = [0]\n        for c in range(1, w):\n            if not all(dr[r][c] == dr[r][c-1] for r in range(dh)):\n                cg.append(c)\n        return [[dr[r][c] for c in cg] for r in range(dh)]\n\n    def has_sub(big, small):\n        bh, bw = len(big), len(big[0])\n        sh, sw = len(small), len(small[0])\n        for r in range(bh - sh + 1):\n            for c in range(bw - sw + 1):\n                if all(big[r+i][c+j] == small[i][j] for i in range(sh) for j in range(sw)):\n                    return True\n        return False\n\n    for i, s in enumerate(shapes):\n        rs = get_row_scale(s['pattern'])\n        if rs < 2:\n            continue\n        ds = downscale(s['pattern'], rs)\n        for j, o in enumerate(shapes):\n            if j == i:\n                continue\n            if has_sub(o['pattern'], ds):\n                return o['bbox']\n\n    return shapes[0]['bbox']",
