  "raw_response": "```python\ndef solve(grid):\n    import copy\n    from collections import defaultdict\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    # Find pairs of identical non-zero values\n    positions = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                positions[grid[r][c]].append((r, c))\n    \n    horizontal = []\n    vertical = []\n    \n    for val, pts in positions.items():\n        if len(pts) == 2:\n            (r1,c1),(r2,c2) = pts\n            if r1 == r2:\n                horizontal.append((val, r1, min(c1,c2), max(c1,c2)))\n            elif c1 == c2:\n                vertical.append((val, c1, min(r1,r2), max(r1,r2)))\n    \n    # Draw horizontal first, then vertical\n    for val, r, c1, c2 in horizontal:\n        for c in range(c1, c2+1):\n            result[r][c] = val\n    \n    for val, c, r1, r2 in vertical:\n        for r in range(r1, r2+1):\n            result[r][c] = val\n    \n    return result\n```",
  "script": "def solve(grid):\n    import copy\n    from collections import defaultdict\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    # Find pairs of identical non-zero values\n    positions = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                positions[grid[r][c]].append((r, c))\n    \n    horizontal = []\n    vertical = []\n    \n    for val, pts in positions.items():\n        if len(pts) == 2:\n            (r1,c1),(r2,c2) = pts\n            if r1 == r2:\n                horizontal.append((val, r1, min(c1,c2), max(c1,c2)))\n            elif c1 == c2:\n                vertical.append((val, c1, min(r1,r2), max(r1,r2)))\n    \n    # Draw horizontal first, then vertical\n    for val, r, c1, c2 in horizontal:\n        for c in range(c1, c2+1):\n            result[r][c] = val\n    \n    for val, c, r1, r2 in vertical:\n        for r in range(r1, r2+1):\n            result[r][c] = val\n    \n    return result",
