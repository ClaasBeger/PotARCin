 >= 10:\n                break\n            map_r = extra - 1\n            if map_r < rows:\n                for c in range(cols):\n                    if grid[map_r][c] != 0:\n                        nc = c + dc\n                        if 0 <= nc < cols:\n                            result[src_r][nc] = grid[map_r][c]\n    \n    # Fallback: try example 1 style - detect segment shift\n    # Re-examine: pattern continues beyond input grid\n    # Use the approach: find repeating unit and tile\n    \n    return result",
