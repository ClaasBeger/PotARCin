  "raw_response": "def solve(grid):\n    from collections import deque\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    q = deque()\n    for r in range(rows):\n        for c in range(cols):\n            if (r == 0 or r == rows-1 or c == 0 or c == cols-1) and grid[r][c] == 0:\n                visited[r][c] = True\n                q.append((r,c))\n    while q:\n        r,c = q.popleft()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            nr,nc = r+dr,c+dc\n            if 0<=nr<rows and 0<=nc<cols and not visited[nr][nc] and grid[nr][nc]==0:\n                visited[nr][nc] = True\n                q.append((nr,nc))\n    result = [row[:] for row in grid]\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0:\n                result[r][c] = 3 if visited[r][c] else 2\n    return result",
  "script": "def solve(grid):\n    from collections import deque\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    q = deque()\n    for r in range(rows):\n        for c in range(cols):\n            if (r == 0 or r == rows-1 or c == 0 or c == cols-1) and grid[r][c] == 0:\n                visited[r][c] = True\n                q.append((r,c))\n    while q:\n        r,c = q.popleft()\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            nr,nc = r+dr,c+dc\n            if 0<=nr<rows and 0<=nc<cols and not visited[nr][nc] and grid[nr][nc]==0:\n                visited[nr][nc] = True\n                q.append((nr,nc))\n    result = [row[:] for row in grid]\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0:\n                result[r][c] = 3 if visited[r][c] else 2\n    return result",
