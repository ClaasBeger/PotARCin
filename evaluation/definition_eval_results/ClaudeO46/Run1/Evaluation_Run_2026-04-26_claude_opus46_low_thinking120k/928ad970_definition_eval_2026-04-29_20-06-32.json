  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    color = 0\n    fives = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5:\n                fives.append((r, c))\n            elif grid[r][c] != 0:\n                color = grid[r][c]\n    \n    top5 = min(fives, key=lambda x: x[0])\n    bot5 = max(fives, key=lambda x: x[0])\n    left5 = min(fives, key=lambda x: x[1])\n    right5 = max(fives, key=lambda x: x[1])\n    \n    otop = top5[0] + 1\n    obot = bot5[0] - 1\n    oleft = left5[1] + 1\n    oright = right5[1] - 1\n    \n    result = [row[:] for row in grid]\n    \n    for c in range(oleft, oright + 1):\n        result[otop][c] = color\n        result[obot][c] = color\n    for r in range(otop, obot + 1):\n        result[r][oleft] = color\n        result[r][oright] = color\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    color = 0\n    fives = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5:\n                fives.append((r, c))\n            elif grid[r][c] != 0:\n                color = grid[r][c]\n    \n    top5 = min(fives, key=lambda x: x[0])\n    bot5 = max(fives, key=lambda x: x[0])\n    left5 = min(fives, key=lambda x: x[1])\n    right5 = max(fives, key=lambda x: x[1])\n    \n    otop = top5[0] + 1\n    obot = bot5[0] - 1\n    oleft = left5[1] + 1\n    oright = right5[1] - 1\n    \n    result = [row[:] for row in grid]\n    \n    for c in range(oleft, oright + 1):\n        result[otop][c] = color\n        result[obot][c] = color\n    for r in range(otop, obot + 1):\n        result[r][oleft] = color\n        result[r][oright] = color\n    \n    return result",
