  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    colors = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                colors.add(grid[r][c])\n    \n    rect_color = None\n    pat_color = None\n    for color in colors:\n        cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == color]\n        rs = [r for r,c in cells]\n        cs = [c for r,c in cells]\n        rmin,rmax = min(rs),max(rs)\n        cmin,cmax = min(cs),max(cs)\n        if len(cells) == (rmax-rmin+1)*(cmax-cmin+1):\n            rect_color = color\n        else:\n            pat_color = color\n    \n    pat_cells = set((r,c) for r in range(rows) for c in range(cols) if grid[r][c] == pat_color)\n    rect_cells = set((r,c) for r in range(rows) for c in range(cols) if grid[r][c] == rect_color)\n    \n    best_axis = None\n    best_type = None\n    \n    all_cs = [c for r,c in pat_cells|rect_cells]\n    for axis2 in range(min(all_cs)*2, max(all_cs)*2+1):\n        axis = axis2 / 2.0\n        valid = True\n        for r,c in pat_cells:\n            mc_f = 2*axis - c\n            mc = int(mc_f)\n            if mc != mc_f:\n                valid = False\n                break\n            if (r,mc) not in pat_cells and (r,mc) not in rect_cells:\n                valid = False\n                break\n        if valid and len(pat_cells) > 0:\n            best_axis = axis\n            best_type = 'v'\n            break\n    \n    if best_type is None:\n        all_rs = [r for r,c in pat_cells|rect_cells]\n        for axis2 in range(min(all_rs)*2, max(all_rs)*2+1):\n            axis = axis2 / 2.0\n            valid = True\n            for r,c in pat_cells:\n                mr_f = 2*axis - r\n                mr = int(mr_f)\n                if mr != mr_f:\n                    valid = False\n                    break\n                if (mr,c) not in pat_cells and (mr,c) not in rect_cells:\n                    valid = False\n                    break\n            if valid:\n                best_axis = axis\n                best_type = 'h'\n                break\n    \n    result = [row[:] for row in grid]\n    \n    for r,c in rect_cells:\n        result[r][c] = 0\n    \n    if best_type == 'v':\n        for r,c in pat_cells:\n            mc = int(2*best_axis - c)\n            if (r,mc) in rect_cells:\n                result[r][mc] = pat_color\n    elif best_type == 'h':\n        for r,c in pat_cells:\n            mr = int(2*best_axis - r)\n            if (mr,c) in rect_cells:\n                result[mr][c] = pat_color\n    \n    return result\n```",
