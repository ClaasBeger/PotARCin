  "raw_response": "```python\ndef solve(grid):\n    import numpy as np\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find distinct non-zero colors and their bounding boxes\n    from collections import defaultdict\n    colors = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                colors[grid[r][c]].append((r, c))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for color, cells in colors.items():\n        min_r = min(r for r, c in cells)\n        max_r = max(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        max_c = max(c for r, c in cells)\n        height = max_r - min_r + 1\n        \n        # Move up by height\n        new_min_r = min_r - height\n        \n        for r, c in cells:\n            nr = r - height\n            if 0 <= nr < rows:\n                result[nr][c] = color\n    \n    return result\n```",
  "script": "def solve(grid):\n    import numpy as np\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find distinct non-zero colors and their bounding boxes\n    from collections import defaultdict\n    colors = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                colors[grid[r][c]].append((r, c))\n    \n    result = [[0]*cols for _ in range(rows)]\n    \n    for color, cells in colors.items():\n        min_r = min(r for r, c in cells)\n        max_r = max(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        max_c = max(c for r, c in cells)\n        height = max_r - min_r + 1\n        \n        # Move up by height\n        new_min_r = min_r - height\n        \n        for r, c in cells:\n            nr = r - height\n            if 0 <= nr < rows:\n                result[nr][c] = color\n    \n    return result",
