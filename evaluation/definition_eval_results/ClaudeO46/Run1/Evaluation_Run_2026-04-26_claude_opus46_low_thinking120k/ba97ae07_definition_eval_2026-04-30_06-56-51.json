  "raw_response": "def solve(grid):\n    import copy\n    rows, cols = len(grid), len(grid[0])\n    out = copy.deepcopy(grid)\n    \n    # Find vertical band columns (same non-zero value in most rows)\n    # Find horizontal band rows (same non-zero value in most cols)\n    \n    # Detect horizontal bands: rows where all/most cells share a non-zero value\n    h_rows = {}\n    for r in range(rows):\n        vals = [grid[r][c] for c in range(cols)]\n        non_zero = [v for v in vals if v != 0]\n        if non_zero:\n            from collections import Counter\n            cnt = Counter(non_zero)\n            val, freq = cnt.most_common(1)[0]\n            if freq > cols // 2:\n                h_rows[r] = val\n    \n    # Detect vertical bands: columns where all/most cells share a non-zero value\n    v_cols = {}\n    for c in range(cols):\n        vals = [grid[r][c] for r in range(rows)]\n        non_zero = [v for v in vals if v != 0]\n        if non_zero:\n            from collections import Counter\n            cnt = Counter(non_zero)\n            val, freq = cnt.most_common(1)[0]\n            if freq > rows // 2:\n                v_cols[c] = val\n    \n    # Count extent: vertical band spans more rows, horizontal spans more cols\n    # At intersection, the longer band wins\n    v_count = len([r for r in range(rows) if r not in h_rows])  # rows the vertical band owns\n    h_count = len([c for c in range(cols) if c not in v_cols])\n    \n    # Determine which is \"longer\" by comparing their span relative to grid\n    # Vertical band: number of rows it spans vs horizontal band rows\n    # Horizontal band: number of cols it spans vs vertical band cols\n    \n    v_span = rows  # vertical goes full height\n    h_span = cols  # horizontal goes full width\n    v_band_size = len(v_cols)\n    h_band_size = len(h_rows)\n    \n    # The one with more cells outside intersection dominates\n    v_non_intersection = (rows - h_band_size) * v_band_size\n    h_non_intersection = (cols - v_band_size) * h_band_size\n    \n    for r in h_rows:\n        for c in v_cols:\n            if v_non_intersection >= h_non_intersection:\n                out[r][c] = v_cols[c]\n            else:\n                out[r][c] = h_rows[r]\n    \n    return out",
