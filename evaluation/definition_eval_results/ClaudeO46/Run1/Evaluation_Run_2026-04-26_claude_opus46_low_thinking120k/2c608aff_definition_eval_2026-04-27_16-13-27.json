  "raw_response": "def solve(grid):\n    from collections import Counter\n    rows = len(grid)\n    cols = len(grid[0])\n    flat = [v for row in grid for v in row]\n    bg = Counter(flat).most_common(1)[0][0]\n    \n    non_bg = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != bg:\n                non_bg.setdefault(grid[r][c], []).append((r, c))\n    \n    rect_color = max(non_bg, key=lambda v: len(non_bg[v]))\n    rect_cells = non_bg[rect_color]\n    min_r = min(r for r, c in rect_cells)\n    max_r = max(r for r, c in rect_cells)\n    min_c = min(c for r, c in rect_cells)\n    max_c = max(c for r, c in rect_cells)\n    \n    result = [row[:] for row in grid]\n    \n    for color, cells in non_bg.items():\n        if color == rect_color:\n            continue\n        for (dr, dc) in cells:\n            if min_r <= dr <= max_r:\n                if dc < min_c:\n                    for c in range(dc, min_c):\n                        result[dr][c] = color\n                elif dc > max_c:\n                    for c in range(max_c + 1, dc + 1):\n                        result[dr][c] = color\n            if min_c <= dc <= max_c:\n                if dr < min_r:\n                    for r in range(dr, min_r):\n                        result[r][dc] = color\n                elif dr > max_r:\n                    for r in range(max_r + 1, dr + 1):\n                        result[r][dc] = color\n    \n    return result",
  "script": "def solve(grid):\n    from collections import Counter\n    rows = len(grid)\n    cols = len(grid[0])\n    flat = [v for row in grid for v in row]\n    bg = Counter(flat).most_common(1)[0][0]\n    \n    non_bg = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != bg:\n                non_bg.setdefault(grid[r][c], []).append((r, c))\n    \n    rect_color = max(non_bg, key=lambda v: len(non_bg[v]))\n    rect_cells = non_bg[rect_color]\n    min_r = min(r for r, c in rect_cells)\n    max_r = max(r for r, c in rect_cells)\n    min_c = min(c for r, c in rect_cells)\n    max_c = max(c for r, c in rect_cells)\n    \n    result = [row[:] for row in grid]\n    \n    for color, cells in non_bg.items():\n        if color == rect_color:\n            continue\n        for (dr, dc) in cells:\n            if min_r <= dr <= max_r:\n                if dc < min_c:\n                    for c in range(dc, min_c):\n                        result[dr][c] = color\n                elif dc > max_c:\n                    for c in range(max_c + 1, dc + 1):\n                        result[dr][c] = color\n            if min_c <= dc <= max_c:\n                if dr < min_r:\n                    for r in range(dr, min_r):\n                        result[r][dc] = color\n                elif dr > max_r:\n                    for r in range(max_r + 1, dr + 1):\n                        result[r][dc] = color\n    \n    return result",
