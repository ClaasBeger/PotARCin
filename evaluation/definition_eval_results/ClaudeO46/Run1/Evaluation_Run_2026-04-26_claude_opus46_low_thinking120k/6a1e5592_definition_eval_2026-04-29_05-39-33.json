  "raw_response": "```python\ndef solve(grid):\n    from collections import deque\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    two_rows = {r for r in range(rows) if 2 in grid[r]}\n    \n    def bfs(start_r, start_c, target, visited, region=None):\n        q = deque([(start_r, start_c)])\n        visited[start_r][start_c] = True\n        cells = [(start_r, start_c)]\n        while q:\n            r, c = q.popleft()\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = r+dr, c+dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == target:\n                    if region is None or nr in region:\n                        visited[nr][nc] = True\n                        q.append((nr, nc))\n                        cells.append((nr, nc))\n        return cells\n    \n    visited = [[False]*cols for _ in range(rows)]\n    zero_holes = []\n    for r in sorted(two_rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                zero_holes.append(bfs(r, c, 0, visited, two_rows))\n    \n    visited2 = [[False]*cols for _ in range(rows)]\n    five_shapes = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5 and not visited2[r][c]:\n                five_shapes.append(bfs(r, c, 5, visited2))\n    \n    def normalize(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells if r == min_r)\n        return sorted([(r - min_r, c - min_c) for r, c in cells])\n    \n    def get_anchor(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells if r == min_r)\n        return min_r, min_c\n    \n    for hole in zero_holes:\n        hole_norm = normalize(hole)\n        hole_height = max(r for r, c in hole_norm) + 1\n        anchor_r, anchor_c = get_anchor(hole)\n        \n        for shape in five_shapes:\n            shape_norm = normalize(shape)\n            top_part = sorted([(r, c) for r, c in shape_norm if r < hole_height])\n            if top_part == hole_norm:\n                for dr, dc in shape_norm:\n                    nr, nc = anchor_r + dr, anchor_c + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        result[nr][nc] = 1\n                break\n    \n    for r in range(rows):\n        for c in range(cols):\n            if result[r][c] == 5:\n                result[r][c] = 0\n    \n    return result\n```",
  "script": "def solve(grid):\n    from collections import deque\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    two_rows = {r for r in range(rows) if 2 in grid[r]}\n    \n    def bfs(start_r, start_c, target, visited, region=None):\n        q = deque([(start_r, start_c)])\n        visited[start_r][start_c] = True\n        cells = [(start_r, start_c)]\n        while q:\n            r, c = q.popleft()\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = r+dr, c+dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == target:\n                    if region is None or nr in region:\n                        visited[nr][nc] = True\n                        q.append((nr, nc))\n                        cells.append((nr, nc))\n        return cells\n    \n    visited = [[False]*cols for _ in range(rows)]\n    zero_holes = []\n    for r in sorted(two_rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                zero_holes.append(bfs(r, c, 0, visited, two_rows))\n    \n    visited2 = [[False]*cols for _ in range(rows)]\n    five_shapes = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 5 and not visited2[r][c]:\n                five_shapes.append(bfs(r, c, 5, visited2))\n    \n    def normalize(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells if r == min_r)\n        return sorted([(r - min_r, c - min_c) for r, c in cells])\n    \n    def get_anchor(cells):\n        min_r = min(r for r, c in cells)\n        min_c = min(c for r, c in cells if r == min_r)\n        return min_r, min_c\n    \n    for hole in zero_holes:\n        hole_norm = normalize(hole)\n        hole_height = max(r for r, c in hole_norm) + 1\n        anchor_r, anchor_c = get_anchor(hole)\n        \n        for shape in five_shapes:\n            shape_norm = normalize(shape)\n            top_part = sorted([(r, c) for r, c in shape_norm if r < hole_height])\n            if top_part == hole_norm:\n                for dr, dc in shape_norm:\n                    nr, nc = anchor_r + dr, anchor_c + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        result[nr][nc] = 1\n                break\n    \n    for r in range(rows):\n        for c in range(cols):\n            if result[r][c] == 5:\n                result[r][c] = 0\n    \n    return result",
