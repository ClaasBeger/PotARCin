  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find connected components of 1s\n    visited = [[False]*cols for _ in range(rows)]\n    components = []\n    \n    def bfs(r, c):\n        from collections import deque\n        q = deque([(r, c)])\n        visited[r][c] = True\n        cells = []\n        while q:\n            cr, cc = q.popleft()\n            cells.append((cr, cc))\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = cr+dr, cc+dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == 1:\n                    visited[nr][nc] = True\n                    q.append((nr, nc))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and not visited[r][c]:\n                components.append(bfs(r, c))\n    \n    # Check if a component encloses any 9s\n    # A 9-cell is enclosed if it can't reach the border via other 9s\n    def encloses_space(comp):\n        comp_set = set(comp)\n        # Find bounding box\n        min_r = min(r for r,c in comp_set)\n        max_r = max(r for r,c in comp_set)\n        min_c = min(c for r,c in comp_set)\n        max_c = max(c for r,c in comp_set)\n        \n        # Find 9-cells inside bounding box that are not reachable from outside\n        # Flood fill from all border 9-cells\n        from collections import deque\n        visited2 = [[False]*cols for _ in range(rows)]\n        q = deque()\n        \n        # Start from all border cells of the grid that are 9 (not in component)\n        for r in range(rows):\n            for c in range(cols):\n                if (r == 0 or r == rows-1 or c == 0 or c == cols-1):\n                    if (r, c) not in comp_set and not visited2[r][c]:\n                        visited2[r][c] = True\n                        q.append((r, c))\n        \n        while q:\n            cr, cc = q.popleft()\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = cr+dr, cc+dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited2[nr][nc] and (nr, nc) not in comp_set:\n                    visited2[nr][nc] = True\n                    q.append((nr, nc))\n        \n        # Check if any cell inside bounding box is unreachable\n        for r in range(min_r, max_r+1):\n            for c in range(min_c, max_c+1):\n                if (r, c) not in comp_set and not visited2[r][c]:\n                    return True\n        return False\n    \n    result = [row[:] for row in grid]\n    for comp in components:\n        if encloses_space(comp):\n            for r, c in comp:\n                result[r][c] = 8\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find connected components of 1s\n    visited = [[False]*cols for _ in range(rows)]\n    components = []\n    \n    def bfs(r, c):\n        from collections import deque\n        q = deque([(r, c)])\n        visited[r][c] = True\n        cells = []\n        while q:\n            cr, cc = q.popleft()\n            cells.append((cr, cc))\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = cr+dr, cc+dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == 1:\n                    visited[nr][nc] = True\n                    q.append((nr, nc))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and not visited[r][c]:\n                components.append(bfs(r, c))\n    \n    # Check if a component encloses any 9s\n    # A 9-cell is enclosed if it can't reach the border via other 9s\n    def encloses_space(comp):\n        comp_set = set(comp)\n        # Find bounding box\n        min_r = min(r for r,c in comp_set)\n        max_r = max(r for r,c in comp_set)\n        min_c = min(c for r,c in comp_set)\n        max_c = max(c for r,c in comp_set)\n        \n        # Find 9-cells inside bounding box that are not reachable from outside\n        # Flood fill from all border 9-cells\n        from collections import deque\n        visited2 = [[False]*cols for _ in range(rows)]\n        q = deque()\n        \n        # Start from all border cells of the grid that are 9 (not in component)\n        for r in range(rows):\n            for c in range(cols):\n                if (r == 0 or r == rows-1 or c == 0 or c == cols-1):\n                    if (r, c) not in comp_set and not visited2[r][c]:\n                        visited2[r][c] = True\n                        q.append((r, c))\n        \n        while q:\n            cr, cc = q.popleft()\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = cr+dr, cc+dc\n                if 0 <= nr < rows and 0 <= nc < cols and not visited2[nr][nc] and (nr, nc) not in comp_set:\n                    visited2[nr][nc] = True\n                    q.append((nr, nc))\n        \n        # Check if any cell inside bounding box is unreachable\n        for r in range(min_r, max_r+1):\n            for c in range(min_c, max_c+1):\n                if (r, c) not in comp_set and not visited2[r][c]:\n                    return True\n        return False\n    \n    result = [row[:] for row in grid]\n    for comp in components:\n        if encloses_space(comp):\n            for r, c in comp:\n                result[r][c] = 8\n    \n    return result",
