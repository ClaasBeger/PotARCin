  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    for r in range(rows-1):\n        for c in range(cols-1):\n            block = [grid[r][c], grid[r][c+1], grid[r+1][c], grid[r+1][c+1]]\n            if all(v != 0 for v in block):\n                color = [v for v in block if v != 2][0]\n                directions = []\n                if grid[r][c] == 2: directions.append((-1,-1))\n                if grid[r][c+1] == 2: directions.append((-1,1))\n                if grid[r+1][c] == 2: directions.append((1,-1))\n                if grid[r+1][c+1] == 2: directions.append((1,1))\n                out = [[0]*cols for _ in range(rows)]\n                for dr in range(2):\n                    for dc in range(2):\n                        out[r+dr][c+dc] = color\n                for dy, dx in directions:\n                    for step in range(1, max(rows,cols)):\n                        nr, nc = r + dy*step, c + dx*step\n                        any_visible = False\n                        for dr in range(2):\n                            for dc in range(2):\n                                rr, cc = nr+dr, nc+dc\n                                if 0 <= rr < rows and 0 <= cc < cols:\n                                    out[rr][cc] = color\n                                    any_visible = True\n                        if not any_visible:\n                            break\n                return out\n    return grid",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    for r in range(rows-1):\n        for c in range(cols-1):\n            block = [grid[r][c], grid[r][c+1], grid[r+1][c], grid[r+1][c+1]]\n            if all(v != 0 for v in block):\n                color = [v for v in block if v != 2][0]\n                directions = []\n                if grid[r][c] == 2: directions.append((-1,-1))\n                if grid[r][c+1] == 2: directions.append((-1,1))\n                if grid[r+1][c] == 2: directions.append((1,-1))\n                if grid[r+1][c+1] == 2: directions.append((1,1))\n                out = [[0]*cols for _ in range(rows)]\n                for dr in range(2):\n                    for dc in range(2):\n                        out[r+dr][c+dc] = color\n                for dy, dx in directions:\n                    for step in range(1, max(rows,cols)):\n                        nr, nc = r + dy*step, c + dx*step\n                        any_visible = False\n                        for dr in range(2):\n                            for dc in range(2):\n                                rr, cc = nr+dr, nc+dc\n                                if 0 <= rr < rows and 0 <= cc < cols:\n                                    out[rr][cc] = color\n                                    any_visible = True\n                        if not any_visible:\n                            break\n                return out\n    return grid",
