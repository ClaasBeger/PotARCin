  "raw_response": "```python\ndef solve(grid):\n    from collections import Counter\n    \n    rows, cols = len(grid), len(grid[0])\n    \n    # Find all connected components of non-zero cells\n    visited = [[False]*cols for _ in range(rows)]\n    \n    def flood(r, c, val):\n        stack = [(r,c)]\n        cells = []\n        while stack:\n            cr, cc = stack.pop()\n            if cr<0 or cr>=rows or cc<0 or cc>=cols: continue\n            if visited[cr][cc] or grid[cr][cc] != val: continue\n            visited[cr][cc] = True\n            cells.append((cr,cc))\n            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                stack.append((cr+dr,cc+dc))\n        return cells\n    \n    # Extract patches (groups of same non-zero color, possibly not connected but nearby)\n    # Better: find bounding boxes of each isolated cluster\n    # Let me find connected components allowing diagonal\n    visited2 = [[False]*cols for _ in range(rows)]\n    \n    def flood2(r, c):\n        stack = [(r,c)]\n        cells = []\n        while stack:\n            cr, cc = stack.pop()\n            if cr<0 or cr>=rows or cc<0 or cc>=cols: continue\n            if visited2[cr][cc] or grid[cr][cc] == 0: continue\n            visited2[cr][cc] = True\n            cells.append((cr,cc, grid[cr][cc]))\n            for dr in [-1,0,1]:\n                for dc in [-1,0,1]:\n                    if dr==0 and dc==0: continue\n                    stack.append((cr+dr,cc+dc))\n        return cells\n    \n    components = []\n    for r in range(rows):\n        for c in range(cols):\n            if not visited2[r][c] and grid[r][c] != 0:\n                comp = flood2(r, c)\n                if comp:\n                    components.append(comp)\n    \n    # Normalize each component to a pattern\n    def normalize(comp):\n        min_r = min(r for r,c,v in comp)\n        min_c = min(c for r,c,v in comp)\n        max_r = max(r for r,c,v in comp)\n        max_c = max(c for r,c,v in comp)\n        h, w = max_r-min_r+1, max_c-min_c+1\n        pat = tuple(tuple(0 for _ in range(w)) for _ in range(h))\n        pat = [[0]*w for _ in range(h)]\n        for r,c,v in comp:\n            pat[r-min_r][c-min_c] = v\n        return tuple(tuple(row) for row in pat)\n    \n    # For each component, get its color set and shape\n    patterns = []\n    for comp in components:\n        colors = set(v for r,c,v in comp)\n        pat = normalize(comp)\n        patterns.append((pat, colors))\n    \n    # The pattern that uses only one color and appears 3+ times (same shape) is the answer\n    # Actually, let me look at it differently: find the shape that appears most\n    \n    # Normalize ignoring color (just shape)\n    def shape_key(comp):\n        min_r = min(r for r,c,v in comp)\n        min_c = min(c for r,c,v in comp)\n        return tuple(sorted((r-min_r, c-min_c) for r,c,v in comp))\n    \n    shape_counts = Counter()\n    shape_to_comps = {}\n    for i, comp in enumerate(components):\n        key = shape_key(comp)\n        shape_counts[key] += 1\n        shape_to_comps.setdefault(key, []).append(i)\n    \n    # The most common shape is the answer pattern\n    most_common_shape, count = shape_counts.most_common(1)[0]\n    \n    # Among components with this shape, find one that has a single color\n    # Actually just pick the one with the \"main\" color\n    # Look at example 1: the answer merges patterns. Let me reconsider.\n    \n    # The repeated shape appears with different colors. The answer uses the non-2 color typically.\n    # Actually the answer is the shape filled with the color that's not the \"duplicate\" marker.\n    \n    best_idx = shape_to_comps[most_common_shape][0]\n    comp = components[best_idx]\n    pat = normalize(comp)\n    # Find dominant non-2 color? Actually just use whatever color appears most among those components\n    \n    # Check: which color appears in components with unique shapes\n    unique_colors = set()\n    for key, cnt in shape_counts.items():\n        if cnt == 1:\n            idx = shape_to_comps[key][0]\n            for r,c,v in components[idx]:\n                unique_colors.add(v)\n    \n    # The repeated shape should use the non-unique color\n    comp = components[best_idx]\n    colors_in_repeated = set(v for r,c,v in comp)\n    main_color = (colors_in_repeated - unique_colors)\n    if main_color:\n        main_color = main_color.pop()\n    else:\n        main_color = colors_in_repeated.pop()\n    \n    # Build output with main_color\n    min_r = min(r for r,c,v in comp)\n    min_c = min(c for r,c,v in comp)\n    max_r = max(r for r,c,v in comp)\n    max_c = max(c for r,c,v in comp)\n    h, w = max_r-min_r+1, max_c-min_c+1\n    result = [[0]*w for _ in range(h)]\n    for r,c,v in comp:\n        result[r-min_r][c-min_c] = main_color\n    \n    return result",
