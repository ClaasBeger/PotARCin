  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    sep_color = None\n    sep_rows = []\n    sep_cols = []\n    \n    for r in range(rows):\n        if all(grid[r][c] != 0 for c in range(cols)):\n            sep_rows.append(r)\n            sep_color = grid[r][0]\n    \n    for c in range(cols):\n        if all(grid[r][c] != 0 for r in range(rows)):\n            sep_cols.append(c)\n    \n    row_bounds = []\n    prev = 0\n    for sr in sep_rows:\n        row_bounds.append((prev, sr))\n        prev = sr + 1\n    row_bounds.append((prev, rows))\n    \n    col_bounds = []\n    prev = 0\n    for sc in sep_cols:\n        col_bounds.append((prev, sc))\n        prev = sc + 1\n    col_bounds.append((prev, cols))\n    \n    cells = {}\n    for i, (r0, r1) in enumerate(row_bounds):\n        for j, (c0, c1) in enumerate(col_bounds):\n            pattern = {}\n            for r in range(r0, r1):\n                for c in range(c0, c1):\n                    if grid[r][c] != 0 and grid[r][c] != sep_color:\n                        pattern[(r - r0, c - c0)] = grid[r][c]\n            cells[(i, j)] = pattern\n    \n    master_positions = set(max(cells.values(), key=len).keys())\n    \n    output = [row[:] for row in grid]\n    \n    for i, (r0, r1) in enumerate(row_bounds):\n        for j, (c0, c1) in enumerate(col_bounds):\n            cell_pattern = cells[(i, j)]\n            for (dr, dc) in master_positions:\n                r, c = r0 + dr, c0 + dc\n                if 0 <= r < r1 and 0 <= c < c1:\n                    if (dr, dc) in cell_pattern:\n                        output[r][c] = cell_pattern[(dr, dc)]\n                    else:\n                        output[r][c] = sep_color\n    \n    return output",
