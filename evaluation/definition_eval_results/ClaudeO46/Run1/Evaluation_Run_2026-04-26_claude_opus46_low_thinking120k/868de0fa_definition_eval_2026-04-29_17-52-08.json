  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    visited = [[False]*cols for _ in range(rows)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                # Flood fill to find connected region of 0s\n                stack = [(r,c)]\n                visited[r][c] = True\n                region = []\n                while stack:\n                    y,x = stack.pop()\n                    region.append((y,x))\n                    for dy,dx in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        ny,nx = y+dy, x+dx\n                        if 0<=ny<rows and 0<=nx<cols and not visited[ny][nx] and grid[ny][nx]==0:\n                            visited[ny][nx] = True\n                            stack.append((ny,nx))\n                # Check if fully enclosed by 1s\n                border = False\n                for y,x in region:\n                    if y==0 or y==rows-1 or x==0 or x==cols-1:\n                        border = True\n                        break\n                if not border:\n                    area = len(region)\n                    fill = 7 if area % 2 == 1 else 2\n                    for y,x in region:\n                        result[y][x] = fill\n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    visited = [[False]*cols for _ in range(rows)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                # Flood fill to find connected region of 0s\n                stack = [(r,c)]\n                visited[r][c] = True\n                region = []\n                while stack:\n                    y,x = stack.pop()\n                    region.append((y,x))\n                    for dy,dx in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        ny,nx = y+dy, x+dx\n                        if 0<=ny<rows and 0<=nx<cols and not visited[ny][nx] and grid[ny][nx]==0:\n                            visited[ny][nx] = True\n                            stack.append((ny,nx))\n                # Check if fully enclosed by 1s\n                border = False\n                for y,x in region:\n                    if y==0 or y==rows-1 or x==0 or x==cols-1:\n                        border = True\n                        break\n                if not border:\n                    area = len(region)\n                    fill = 7 if area % 2 == 1 else 2\n                    for y,x in region:\n                        result[y][x] = fill\n    return result",
