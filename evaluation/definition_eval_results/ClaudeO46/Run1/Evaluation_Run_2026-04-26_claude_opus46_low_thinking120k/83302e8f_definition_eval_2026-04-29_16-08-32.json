  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    from collections import Counter\n    vals = Counter()\n    for r in grid:\n        for v in r:\n            if v != 0:\n                vals[v] += 1\n    line_val = vals.most_common(1)[0][0]\n    \n    h_lines = []\n    for r in range(rows):\n        count = sum(1 for c in range(cols) if grid[r][c] == line_val)\n        if count > cols * 0.5:\n            h_lines.append(r)\n    \n    v_lines = []\n    for c in range(cols):\n        count = sum(1 for r in range(rows) if grid[r][c] == line_val)\n        if count > rows * 0.5:\n            v_lines.append(c)\n    \n    out = [row[:] for row in grid]\n    \n    h_bounds = [-1] + h_lines + [rows]\n    v_bounds = [-1] + v_lines + [cols]\n    \n    for hi in range(len(h_bounds) - 1):\n        for vi in range(len(v_bounds) - 1):\n            r_start = h_bounds[hi] + 1\n            r_end = h_bounds[hi + 1]\n            c_start = v_bounds[vi] + 1\n            c_end = v_bounds[vi + 1]\n            \n            if r_start >= r_end or c_start >= c_end:\n                continue\n            \n            has_gap = False\n            \n            if h_bounds[hi] >= 0:\n                r = h_bounds[hi]\n                for c in range(c_start, c_end):\n                    if grid[r][c] != line_val:\n                        has_gap = True\n                        break\n            \n            if not has_gap and h_bounds[hi + 1] < rows:\n                r = h_bounds[hi + 1]\n                for c in range(c_start, c_end):\n                    if grid[r][c] != line_val:\n                        has_gap = True\n                        break\n            \n            if not has_gap and v_bounds[vi] >= 0:\n                c = v_bounds[vi]\n                for r in range(r_start, r_end):\n                    if grid[r][c] != line_val:\n                        has_gap = True\n                        break\n            \n           