  "raw_response": "```python\ndef solve(grid):\n    import copy\n    grid = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find two groups of 2s\n    groups = []  # each: (set of (r,c), orientation)\n    \n    # Find connected segments of 2s\n    twos = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                twos.add((r, c))\n    \n    visited = set()\n    for t in twos:\n        if t in visited:\n            continue\n        # BFS\n        group = set()\n        queue = [t]\n        while queue:\n            cur = queue.pop()\n            if cur in visited:\n                continue\n            visited.add(cur)\n            group.add(cur)\n            r, c = cur\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = r+dr, c+dc\n                if (nr, nc) in twos and (nr, nc) not in visited:\n                    queue.append((nr, nc))\n        groups.append(group)\n    \n    # For each group, determine: which side is the wall, row/col range\n    def analyze_group(g):\n        rs = [r for r, c in g]\n        cs = [c for r, c in g]\n        if len(set(cs)) == 1:  # vertical wall\n            col = cs[0]\n            min_r, max_r = min(rs), max(rs)\n            side = 'left' if col == 0 else 'right'\n            return {'type': 'vertical', 'col': col, 'min_r': min_r, 'max_r': max_r, 'side': side}\n        else:\n            row = rs[0]\n            min_c, max_c = min(cs), max(cs)\n            side = 'top' if row == 0 else 'bottom'\n            return {'type': 'horizontal', 'row': row, 'min_c': min_c, 'max_c': max_c, 'side': side}\n    \n    infos = [analyze_group(g) for g in groups]\n    \n    # Find 8s and associate with groups\n    eights = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n    \n    # Determine which group has 8s nearby\n    for i, info in enumerate(infos):\n        info['eights'] = []\n        for r8, c8 in eights:\n            if info['type'] == 'vertical':\n                if info['min_r'] <= r8 <= info['max_r']:\n                    info['eights'].append((r8, c8))\n    \n    # Process\n    source = None\n    target = None\n    for i, info in enumerate(infos):\n        if info['eights']:\n            source = i\n        else:\n            target = i\n    \n    if source is None or target is None:\n        return grid\n    \n    si = infos[source]\n    ti = infos[target]\n    \n    for r8, c8 in si['eights']:\n        rel = r8 - si['min_r']\n        \n        # Fill source: from wall to 8 with 8s, 8 position becomes 4\n        if si['type'] == 'vertical':\n            if si['side'] == 'left':\n                for c in range(si['col'] + 1, c8):\n                    grid[r8][c] = 8\n                grid[r8][c8] = 4\n            else:\n                for c in range(c8 + 1, si['col']):\n                    grid[r8][c] = 8\n                grid[r8][c8] = 4\n        \n        # Fill target: corresponding row fully with 8s\n        tr = ti['min_r'] + rel\n        if ti['type'] == 'vertical':\n            if ti['side'] == 'left':\n                for c in range(ti['col'] + 1, cols):\n                    grid[tr][c] = 8\n            else:\n                for c in range(0, ti['col']):\n                    grid[tr][c] = 8\n    \n    return grid\n```",
  "script": "def solve(grid):\n    import copy\n    grid = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find two groups of 2s\n    groups = []  # each: (set of (r,c), orientation)\n    \n    # Find connected segments of 2s\n    twos = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                twos.add((r, c))\n    \n    visited = set()\n    for t in twos:\n        if t in visited:\n            continue\n        # BFS\n        group = set()\n        queue = [t]\n        while queue:\n            cur = queue.pop()\n            if cur in visited:\n                continue\n            visited.add(cur)\n            group.add(cur)\n            r, c = cur\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = r+dr, c+dc\n                if (nr, nc) in twos and (nr, nc) not in visited:\n                    queue.append((nr, nc))\n        groups.append(group)\n    \n    # For each group, determine: which side is the wall, row/col range\n    def analyze_group(g):\n        rs = [r for r, c in g]\n        cs = [c for r, c in g]\n        if len(set(cs)) == 1:  # vertical wall\n            col = cs[0]\n            min_r, max_r = min(rs), max(rs)\n            side = 'left' if col == 0 else 'right'\n            return {'type': 'vertical', 'col': col, 'min_r': min_r, 'max_r': max_r, 'side': side}\n        else:\n            row = rs[0]\n            min_c, max_c = min(cs), max(cs)\n            side = 'top' if row == 0 else 'bottom'\n            return {'type': 'horizontal', 'row': row, 'min_c': min_c, 'max_c': max_c, 'side': side}\n    \n    infos = [analyze_group(g) for g in groups]\n    \n    # Find 8s and associate with groups\n    eights = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n    \n    # Determine which group has 8s nearby\n    for i, info in enumerate(infos):\n        info['eights'] = []\n        for r8, c8 in eights:\n            if info['type'] == 'vertical':\n                if info['min_r'] <= r8 <= info['max_r']:\n                    info['eights'].append((r8, c8))\n    \n    # Process\n    source = None\n    target = None\n    for i, info in enumerate(infos):\n        if info['eights']:\n            source = i\n        else:\n            target = i\n    \n    if source is None or target is None:\n        return grid\n    \n    si = infos[source]\n    ti = infos[target]\n    \n    for r8, c8 in si['eights']:\n        rel = r8 - si['min_r']\n        \n        # Fill source: from wall to 8 with 8s, 8 position becomes 4\n        if si['type'] == 'vertical':\n            if si['side'] == 'left':\n                for c in range(si['col'] + 1, c8):\n                    grid[r8][c] = 8\n                grid[r8][c8] = 4\n            else:\n                for c in range(c8 + 1, si['col']):\n                    grid[r8][c] = 8\n                grid[r8][c8] = 4\n        \n        # Fill target: corresponding row fully with 8s\n        tr = ti['min_r'] + rel\n        if ti['type'] == 'vertical':\n            if ti['side'] == 'left':\n                for c in range(ti['col'] + 1, cols):\n                    grid[tr][c] = 8\n            else:\n                for c in range(0, ti['col']):\n                    grid[tr][c] = 8\n    \n    return grid",
