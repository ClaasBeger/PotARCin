  "raw_response": "```python\ndef solve(grid):\n    import copy\n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                val = grid[r][c]\n                # Find bounding box\n                mr, mc = r, c\n                while mr < rows and grid[mr][c] == val:\n                    mr += 1\n                while mc < cols and grid[r][mc] == val:\n                    mc += 1\n                # Mark visited and hollow\n                for i in range(r, mr):\n                    for j in range(c, mc):\n                        visited[i][j] = True\n                        if r < i < mr-1 and c < j < mc-1:\n                            result[i][j] = 0\n    return result\n```",
  "script": "def solve(grid):\n    import copy\n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and not visited[r][c]:\n                val = grid[r][c]\n                # Find bounding box\n                mr, mc = r, c\n                while mr < rows and grid[mr][c] == val:\n                    mr += 1\n                while mc < cols and grid[r][mc] == val:\n                    mc += 1\n                # Mark visited and hollow\n                for i in range(r, mr):\n                    for j in range(c, mc):\n                        visited[i][j] = True\n                        if r < i < mr-1 and c < j < mc-1:\n                            result[i][j] = 0\n    return result",
