  "raw_response": "```python\ndef solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find separator value (most common in first row that forms grid lines)\n    sep = grid[2][0]  # The separator row\n    \n    # Find cell boundaries\n    sep_rows = [r for r in range(rows) if all(grid[r][c] == sep for c in range(cols))]\n    sep_cols = [c for c in range(cols) if all(grid[r][c] == sep for r in range(rows))]\n    \n    # Build cell ranges\n    def get_ranges(seps, total):\n        ranges = []\n        prev = 0\n        for s in seps:\n            if s > prev:\n                ranges.append((prev, s))\n            prev = s + 1\n        if prev < total:\n            ranges.append((prev, total))\n        return ranges\n    \n    row_ranges = get_ranges(sep_rows, rows)\n    col_ranges = get_ranges(sep_cols, cols)\n    \n    # Read cell values\n    nr, nc = len(row_ranges), len(col_ranges)\n    cell_val = [[0]*nc for _ in range(nr)]\n    for ri, (r1, r2) in enumerate(row_ranges):\n        for ci, (c1, c2) in enumerate(col_ranges):\n            v = grid[r1][c1]\n            cell_val[ri][ci] = v\n    \n    # For each color, find all positions, then for each pair in same row/col, fill between\n    from collections import defaultdict\n    color_positions = defaultdict(list)\n    for r in range(nr):\n        for c in range(nc):\n            if cell_val[r][c] != 0:\n                color_positions[cell_val[r][c]].append((r, c))\n    \n    result = [row[:] for row in grid]\n    \n    for color, positions in color_positions.items():\n        # Same row pairs\n        row_groups = defaultdict(list)\n        for r, c in positions:\n            row_groups[r].append(c)\n        for r, cs in row_groups.items():\n            if len(cs) >= 2:\n                mn, mx = min(cs), max(cs)\n                for c in range(mn, mx + 1):\n                    r1, r2 = row_ranges[r]\n                    c1, c2 = col_ranges[c]\n                    for rr in range(r1, r2):\n           