  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    twos = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    fives = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 5]\n    \n    min_r = min(r for r,c in twos)\n    max_r = max(r for r,c in twos)\n    min_c = min(c for r,c in twos)\n    max_c = max(c for r,c in twos)\n    \n    top_solid = all(grid[min_r][c] == 2 for c in range(min_c, max_c+1))\n    bot_solid = all(grid[max_r][c] == 2 for c in range(min_c, max_c+1))\n    left_solid = all(grid[r][min_c] == 2 for r in range(min_r, max_r+1))\n    right_solid = all(grid[r][max_c] == 2 for r in range(min_r, max_r+1))\n    \n    result = [row[:] for row in grid]\n    for r,c in fives:\n        result[r][c] = 0\n    \n    center_r = (min_r + max_r) / 2\n    center_c = (min_c + max_c) / 2\n    \n    if top_solid and bot_solid:\n        for r,c in fives:\n            nr = 2 * min_r - r if r < center_r else 2 * max_r - r\n            if 0 <= nr < rows:\n                result[nr][c] = 5\n    elif left_solid and right_solid:\n        for r,c in fives:\n            nc = 2 * min_c - c if c < center_c else 2 * max_c - c\n            if 0 <= nc < cols:\n                result[r][nc] = 5\n    \n    return result\n```",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    twos = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    fives = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 5]\n    \n    min_r = min(r for r,c in twos)\n    max_r = max(r for r,c in twos)\n    min_c = min(c for r,c in twos)\n    max_c = max(c for r,c in twos)\n    \n    top_solid = all(grid[min_r][c] == 2 for c in range(min_c, max_c+1))\n    bot_solid = all(grid[max_r][c] == 2 for c in range(min_c, max_c+1))\n    left_solid = all(grid[r][min_c] == 2 for r in range(min_r, max_r+1))\n    right_solid = all(grid[r][max_c] == 2 for r in range(min_r, max_r+1))\n    \n    result = [row[:] for row in grid]\n    for r,c in fives:\n        result[r][c] = 0\n    \n    center_r = (min_r + max_r) / 2\n    center_c = (min_c + max_c) / 2\n    \n    if top_solid and bot_solid:\n        for r,c in fives:\n            nr = 2 * min_r - r if r < center_r else 2 * max_r - r\n            if 0 <= nr < rows:\n                result[nr][c] = 5\n    elif left_solid and right_solid:\n        for r,c in fives:\n            nc = 2 * min_c - c if c < center_c else 2 * max_c - c\n            if 0 <= nc < cols:\n                result[r][nc] = 5\n    \n    return result",
