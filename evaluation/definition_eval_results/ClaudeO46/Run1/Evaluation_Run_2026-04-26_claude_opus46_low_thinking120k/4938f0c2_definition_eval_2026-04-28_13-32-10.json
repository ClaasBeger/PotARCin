  "raw_response": "```python\ndef solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    # Find 3-block (2x2)\n    three_cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 3]\n    min_r3 = min(r for r,c in three_cells)\n    max_r3 = max(r for r,c in three_cells)\n    min_c3 = min(c for r,c in three_cells)\n    max_c3 = max(c for r,c in three_cells)\n    \n    # Center of the 3-block\n    cr = (min_r3 + max_r3 + 1) / 2.0\n    cc = (min_c3 + max_c3 + 1) / 2.0\n    \n    # Find 2-cells\n    two_cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    # Reflect across both axes and diagonal - 4-fold symmetry around center\n    for r, c in two_cells:\n        # Mirror row and col around center\n        mr = int(2*cr - 1 - r)\n        mc = int(2*cc - 1 - c)\n        \n        # Place in all 4 quadrants\n        for nr, nc in [(r, c), (r, mc), (mr, c), (mr, mc)]:\n            if 0 <= nr < rows and 0 <= nc < cols:\n                result[nr][nc] = 2\n    \n    return result\n```",
  "script": "def solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    result = [row[:] for row in grid]\n    \n    # Find 3-block (2x2)\n    three_cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 3]\n    min_r3 = min(r for r,c in three_cells)\n    max_r3 = max(r for r,c in three_cells)\n    min_c3 = min(c for r,c in three_cells)\n    max_c3 = max(c for r,c in three_cells)\n    \n    # Center of the 3-block\n    cr = (min_r3 + max_r3 + 1) / 2.0\n    cc = (min_c3 + max_c3 + 1) / 2.0\n    \n    # Find 2-cells\n    two_cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    \n    # Reflect across both axes and diagonal - 4-fold symmetry around center\n    for r, c in two_cells:\n        # Mirror row and col around center\n        mr = int(2*cr - 1 - r)\n        mc = int(2*cc - 1 - c)\n        \n        # Place in all 4 quadrants\n        for nr, nc in [(r, c), (r, mc), (mr, c), (mr, mc)]:\n            if 0 <= nr < rows and 0 <= nc < cols:\n                result[nr][nc] = 2\n    \n    return result",
