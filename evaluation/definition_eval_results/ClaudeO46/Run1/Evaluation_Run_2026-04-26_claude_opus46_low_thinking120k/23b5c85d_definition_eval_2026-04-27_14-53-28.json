  "raw_response": "```python\ndef solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    from collections import defaultdict\n    \n    colors = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                colors[grid[r][c]].append((r, c))\n    \n    rects = {}\n    for color, cells in colors.items():\n        min_r = min(r for r, c in cells)\n        max_r = max(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        max_c = max(c for r, c in cells)\n        rects[color] = (min_r, max_r, min_c, max_c, (max_r - min_r + 1) * (max_c - min_c + 1))\n    \n    smallest = min(rects, key=lambda c: rects[c][4])\n    min_r, max_r, min_c, max_c, _ = rects[smallest]\n    \n    result = []\n    for r in range(min_r, max_r + 1):\n        row = [smallest] * (max_c - min_c + 1)\n        result.append(row)\n    return result\n```",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    from collections import defaultdict\n    \n    colors = defaultdict(list)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                colors[grid[r][c]].append((r, c))\n    \n    rects = {}\n    for color, cells in colors.items():\n        min_r = min(r for r, c in cells)\n        max_r = max(r for r, c in cells)\n        min_c = min(c for r, c in cells)\n        max_c = max(c for r, c in cells)\n        rects[color] = (min_r, max_r, min_c, max_c, (max_r - min_r + 1) * (max_c - min_c + 1))\n    \n    smallest = min(rects, key=lambda c: rects[c][4])\n    min_r, max_r, min_c, max_c, _ = rects[smallest]\n    \n    result = []\n    for r in range(min_r, max_r + 1):\n        row = [smallest] * (max_c - min_c + 1)\n        result.append(row)\n    return result",
