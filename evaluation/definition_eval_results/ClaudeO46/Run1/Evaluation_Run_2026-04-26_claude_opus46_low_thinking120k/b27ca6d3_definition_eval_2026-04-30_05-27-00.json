  "raw_response": "def solve(grid):\n    from collections import deque\n    rows, cols = len(grid), len(grid[0])\n    g = [row[:] for row in grid]\n    visited = [[False]*cols for _ in range(rows)]\n    \n    def bfs(r, c):\n        q = deque([(r,c)])\n        visited[r][c] = True\n        cells = [(r,c)]\n        while q:\n            cr, cc = q.popleft()\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = cr+dr, cc+dc\n                if 0<=nr<rows and 0<=nc<cols and not visited[nr][nc] and grid[nr][nc]==2:\n                    visited[nr][nc] = True\n                    q.append((nr,nc))\n                    cells.append((nr,nc))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]==2 and not visited[r][c]:\n                cells = bfs(r,c)\n                if len(cells)>=2:\n                    minr = min(x[0] for x in cells)\n                    maxr = max(x[0] for x in cells)\n                    minc = min(x[1] for x in cells)\n                    maxc = max(x[1] for x in cells)\n                    for rr in range(minr-1, maxr+2):\n                        for cc in range(minc-1, maxc+2):\n                            if 0<=rr<rows and 0<=cc<cols and g[rr][cc]==0:\n                                if rr==minr-1 or rr==maxr+1 or cc==minc-1 or cc==maxc+1:\n                                    g[rr][cc]=3\n    return g",
  "script": "def solve(grid):\n    from collections import deque\n    rows, cols = len(grid), len(grid[0])\n    g = [row[:] for row in grid]\n    visited = [[False]*cols for _ in range(rows)]\n    \n    def bfs(r, c):\n        q = deque([(r,c)])\n        visited[r][c] = True\n        cells = [(r,c)]\n        while q:\n            cr, cc = q.popleft()\n            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                nr, nc = cr+dr, cc+dc\n                if 0<=nr<rows and 0<=nc<cols and not visited[nr][nc] and grid[nr][nc]==2:\n                    visited[nr][nc] = True\n                    q.append((nr,nc))\n                    cells.append((nr,nc))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]==2 and not visited[r][c]:\n                cells = bfs(r,c)\n                if len(cells)>=2:\n                    minr = min(x[0] for x in cells)\n                    maxr = max(x[0] for x in cells)\n                    minc = min(x[1] for x in cells)\n                    maxc = max(x[1] for x in cells)\n                    for rr in range(minr-1, maxr+2):\n                        for cc in range(minc-1, maxc+2):\n                            if 0<=rr<rows and 0<=cc<cols and g[rr][cc]==0:\n                                if rr==minr-1 or rr==maxr+1 or cc==minc-1 or cc==maxc+1:\n                                    g[rr][cc]=3\n    return g",
