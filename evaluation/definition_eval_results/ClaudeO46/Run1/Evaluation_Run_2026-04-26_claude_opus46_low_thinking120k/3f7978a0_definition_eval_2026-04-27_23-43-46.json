  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    five_positions = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 5]\n    min_r = min(r for r,c in five_positions) - 1\n    max_r = max(r for r,c in five_positions) + 1\n    min_c = min(c for r,c in five_positions)\n    max_c = max(c for r,c in five_positions)\n    return [[grid[r][c] for c in range(min_c, max_c+1)] for r in range(min_r, max_r+1)]",
