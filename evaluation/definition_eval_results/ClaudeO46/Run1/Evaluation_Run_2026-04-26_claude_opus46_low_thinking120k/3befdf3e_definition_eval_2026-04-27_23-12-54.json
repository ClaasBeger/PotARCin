r = max(inner_max_r, i)\n                    inner_min_c = min(inner_min_c, j)\n                    inner_max_c = max(inner_max_c, j)\n        \n        ih = inner_max_r - inner_min_r + 1\n        iw = inner_max_c - inner_min_c + 1\n        \n        # The new pattern: expand outward by inner dimensions\n        # New outer ring of border_color (ih thick on top/bottom, iw thick on left/right)\n        # Then inner_color where border was, border_color where inner was\n        \n        new_h = h + 2 * ih\n        new_w = w + 2 * iw\n        new_min_r = min_r - ih\n        new_min_c = min_c - iw\n        \n        for i in range(new_h):\n            for j in range(new_w):\n                gr, gc = new_min_r + i, new_min_c + j\n                if gr < 0 or gr >= rows or gc < 0 or gc >= cols:\n                    continue\n                \n                # Map back to original sub coordinates\n                si, sj = i - ih, j - iw\n                \n                if 0 <= si < h and 0 <= sj < w:\n                    # Inside original bounds: swap colors\n                    orig = sub[si][sj]\n                    if orig == border_color:\n                        result[gr][gc] = inner_color\n                    else:\n                        result[gr][gc] = border_color\n                else:\n                    # Outside original but inside new: border_color\n                    # Check if this aligns with the border extension\n                    # Top/bottom strips\n                    in_vert = (0 <= sj < w)\n                    in_horiz = (0 <= si < h)\n                    if in_vert or in_horiz:\n                        if in_vert and (si < 0 or si >= h):\n                            result[gr][gc] = border_color\n                        elif in_horiz and (sj < 0 or sj >= w):\n                            result[gr][gc] = border_color\n    \n    return result",
