  "raw_response": "```python\ndef solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    eights = []\n    twos = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                eights.append((r, c))\n            elif grid[r][c] == 2:\n                twos.append((r, c))\n    \n    eight_rows = [r for r, c in eights]\n    eight_cols = [c for r, c in eights]\n    two_rows = [r for r, c in twos]\n    two_cols = [c for r, c in twos]\n    \n    if len(set(eight_rows)) == 1:\n        eight_edge = 'row'\n        eight_edge_idx = eight_rows[0]\n        eight_pattern = eight_cols\n    else:\n        eight_edge = 'col'\n        eight_edge_idx = eight_cols[0]\n        eight_pattern = eight_rows\n    \n    if len(set(two_rows)) == 1:\n        two_edge = 'row'\n        two_edge_idx = two_rows[0]\n        two_positions = sorted(two_cols)\n    else:\n        two_edge = 'col'\n        two_edge_idx = two_cols[0]\n        two_positions = sorted(two_rows)\n    \n    result = [[0]*cols for _ in range(rows)]\n    for r, c in twos:\n        result[r][c] = 2\n    \n    if eight_edge == 'row' and two_edge == 'col':\n        if two_edge_idx == 0:\n            shift_dir = +1\n        else:\n            shift_dir = -1\n        \n        prev = 0\n        for idx, tp in enumerate(two_positions):\n            for r in range(prev, tp):\n                for p in eight_pattern:\n                    nc = p + shift_dir * idx\n                    if 0 <= nc < cols:\n                        result[r][nc] = 8\n            prev = tp\n        for r in range(prev, rows):\n            for p in eight_pattern:\n                nc = p + shift_dir * len(two_positions)\n                if 0 <= nc < cols:\n                    result[r][nc] = 8\n    \n    elif eight_edge == 'col' and two_edge == 'row':\n        if eight_edge_idx == 0:\n            if two_edge_idx == 0:\n                shift_dir = +1\n            else:\n                shift_dir = -1\n            \n            prev = 0\n            for idx, tp in enumerate(two_positions):\n                for c in range(prev, tp):\n                    for p in eight_pattern:\n                        nr = p + shift_dir * idx\n                        if 0 <= nr < rows:\n                            result[nr][c] = 8\n                prev = tp\n            for c in range(prev, cols):\n                for p in eight_pattern:\n                    nr = p + shift_dir * len(two_positions)\n                    if 0 <= nr < rows:\n                        result[nr][c] = 8\n        else:\n            if two_edge_idx >= rows - 1:\n                shift_dir = -1\n            else:\n                shift_dir = +1\n            \n            prev = cols - 1\n            for idx, tp in enumerate(sorted(two_positions, reverse=True)):\n                for c in range(prev, tp, -1):\n                    for p in eight_pattern:\n                        nr = p + shift_dir * idx\n                        if 0 <= nr < rows:\n                            result[nr][c] = 8\n                prev = tp\n            for c in range(prev, -1, -1):\n                for p in eight_pattern:\n                    nr = p + shift_dir * len(two_positions)\n                    if 0 <= nr < rows:\n                        result[nr][c] = 8\n    \n    return result\n```",
