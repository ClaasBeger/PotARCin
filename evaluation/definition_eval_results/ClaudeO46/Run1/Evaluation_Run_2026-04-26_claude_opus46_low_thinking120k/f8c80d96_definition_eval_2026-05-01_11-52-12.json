4 0 0 4 0 0 0 0\n0 0 4 0 0 4 0 0 0 0\n4 4 4 0 0 4 0 0 0 0\n0 0 0 0 0 4 0 0 0 0\n0 0 0 0 0 4 0 0 0 0\n4 4 4 4 4 4 0 0 0 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "```python\ndef solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n    \n    color = 0\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0:\n                color = grid[r][c]\n                break\n        if color: break\n    if not color:\n        return [row[:] for row in grid]\n    \n    h_segs = []\n    for r in range(R):\n        c = 0\n        while c < C:\n            if grid[r][c] == color:\n                start = c\n                while c < C and grid[r][c] == color:\n                    c += 1\n                if c - start >= 2:\n                    h_segs.append((r, start, c - 1))\n            else:\n                c += 1\n    \n    v_segs = []\n    for c in range(C):\n        r = 0\n        while r < R:\n            if grid[r][c] == color:\n                start = r\n                while r < R and grid[r][c] == color:\n                    r += 1\n                if r - start >= 2:\n                    v_segs.append((c, start, r - 1))\n            else:\n                r += 1\n    \n    import math\n    h_rows = sorted(set(s[0] for s in h_segs))\n    v_cols = sorted(set(s[0] for s in v_segs))\n    \n    step = 0\n    for lst in [h_rows, v_cols]:\n        if len(lst) >= 2:\n            for i in range(len(lst) - 1):\n                d = lst[i + 1] - lst[i]\n                step = math.gcd(step, d) if step else d\n    if step == 0:\n        step = max(R, C)\n    \n    ext_h_rows = sorted(r for r in range(R) if h_rows and r % step == h_rows[0] % step)\n    ext_v_cols = sorted(c for c in range(C) if v_cols and c % step == v_cols[0] % step)\n    \n    def extrap(keys, vals, key, lo, hi):\n        kv = dict(zip(keys, vals))\n        if key in kv:\n            return kv[key]\n        if not keys:\n            return None\n        if len(keys) == 1:\n            return max(lo, min(hi, vals[0]))\n        if key > keys[-1]:\n            k1, k2 = keys[-2], keys[-1]\n        elif key < keys[0]:\n            k1, k2 = keys[0], keys[1]\n        else:\n            k1, k2 = keys[0], keys[1]\n            for i in range(len(keys) - 1):\n                if keys[i] <= key <= keys[i + 1]:\n                    k1, k2 = keys[i], keys[i + 1]\n                    break\n        v1, v2 = kv[k1], kv[k2]\n        slope = (v2 - v1) / (k2 - k1)\n        v = v1 + slope * (key - k1)\n        return max(lo, min(hi, round(v)))\n    \n    h_data = {}\n    for r, s, e in h_segs:\n        if r not in h_data or (e - s) > (h_data[r][1] - h_data[r][0]):\n            h_data[r] = (s, e)\n    \n    v_data = {}\n    for c, s, e in v_segs:\n        if c not in v_data or (e - s) > (v_data[c][1] - v_data[c][0]):\n            v_data[c] = (s, e)\n    \n    colored = set()\n    \n    hk = sorted(h_data.keys())\n    hs = [h_data[k][0] for k in hk]\n    he = [h_data[k][1] for k in hk]\n    for r in ext_h_rows:\n        s = extrap(hk, hs, r, 0, C - 1)\n        e = extrap(hk, he, r, 0, C - 1)\n        if s is not None and e is not None and s <= e:\n            for c in range(s, e + 1):\n                colored.add((r, c))\n    \n    vk = sorted(v_data.keys())\n    vs = [v_data[k][0] for k in vk]\n    ve = [v_data[k][1] for k in vk]\n    for c in ext_v_cols:\n        s = extrap(vk, vs, c, 0, R - 1)\n        e = extrap(vk, ve, c, 0, R - 1)\n        if s is not None and e is not None and s <= e:\n            for r in range(s, e + 1):\n                colored.add((r, c))\n    \n    result = [[5] * C for _ in range(R)]\n    for r, c in colored:\n        result[r][c] = color\n    \n    return result\n```",
