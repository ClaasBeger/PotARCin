  "raw_response": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    ys, xs = np.where(g != 0)\n    r1,r2,c1,c2 = ys.min(), ys.max(), xs.min(), xs.max()\n    sub = g[r1:r2+1, c1:c2+1].copy()\n    vals = set(sub.flatten())\n    # find inner and outer\n    outer = sub[0,0]\n    inner = (vals - {outer}).pop()\n    out = np.full_like(sub, inner)\n    out[sub == inner] = outer\n    return out.tolist()",
  "script": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    ys, xs = np.where(g != 0)\n    r1,r2,c1,c2 = ys.min(), ys.max(), xs.min(), xs.max()\n    sub = g[r1:r2+1, c1:c2+1].copy()\n    vals = set(sub.flatten())\n    # find inner and outer\n    outer = sub[0,0]\n    inner = (vals - {outer}).pop()\n    out = np.full_like(sub, inner)\n    out[sub == inner] = outer\n    return out.tolist()",
