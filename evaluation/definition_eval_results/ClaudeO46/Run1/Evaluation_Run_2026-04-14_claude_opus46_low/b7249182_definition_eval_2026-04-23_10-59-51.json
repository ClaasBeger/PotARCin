  "raw_response": "def solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find the two non-zero points\n    points = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                points.append((r, c, grid[r][c]))\n    \n    (r1, c1, v1), (r2, c2, v2) = points\n    \n    out = [[0]*cols for _ in range(rows)]\n    \n    # Determine if they share same row or same column\n    if c1 == c2:  # vertical arrangement\n        # distance between them\n        dist = abs(r2 - r1)\n        half = dist // 2\n        # midpoint area\n        mid_r = (r1 + r2) / 2.0\n        \n        # Each point draws: a line from itself toward the other (length = half cells),\n        # then a horizontal bar perpendicular at the end, and corner connections\n        \n        # Point 1 line along column\n        top, bot = min(r1, r2), max(r1, r2)\n        tv, bv = (v1, v2) if r1 < r2 else (v2, v1)\n        \n        # top point draws down, bot point draws up\n        # They each go half the distance\n        # Perpendicular bar width = half on each side\n        \n        for r in range(top, top + half):\n            out[r][c1] = tv\n        for r in range(bot - half + 1, bot + 1):\n            out[r][c1] = bv\n        \n        # Horizontal bars\n        bar_top_r = top + half\n        bar_bot_r = bot - half\n        \n        for c in range(c1 - half, c1 + half + 1):\n            if 0 <= c < cols:\n                out[bar_top_r][c] = tv\n                out[bar_bot_r][c] = bv\n        \n        # Vertical sides\n        for r in range(bar_top_r, bar_bot_r + 1):\n            if 0 <= c1 - half < cols:\n                out[r][c1 - half] = tv if r <= (bar_top_r + bar_bot_r)//2 else bv\n            if 0 <= c1 + half < cols:\n                out[r][c1 + half] = tv if r <= (bar_top_r + bar_bot_r)//2 else bv\n        \n    else:  # horizontal arrangement (same row)\n        left, right = (c1, c2) if c1 < c2 else (c2, c1)\n        lv, rv = (v1, v2) if c1 < c2 else (v2, v1)\n        \n        dist = right - left\n        half = dist // 2\n        \n        for c in range(left, left + half):\n            out[r1][c] = lv\n        for c in range(right - half + 1, right + 1):\n            out[r1][c] = rv\n        \n        bar_left_c = left + half\n        bar_right_c = right - half\n        \n        for r in range(r1 - half, r1 + half + 1):\n            if 0 <= r < rows:\n                out[r][bar_left_c] = lv\n                out[r][bar_right_c] = rv\n        \n        for c in range(bar_left_c, bar_right_c + 1):\n            if 0 <= r1 - half < rows:\n                out[r1 - half][c] = lv if c <= (bar_left_c + bar_right_c)//2 else rv\n            if 0 <= r1 + half < rows:\n                out[r1 + half][c] = lv if c <= (bar_left_c + bar_right_c)//2 else rv\n    \n    return out",
