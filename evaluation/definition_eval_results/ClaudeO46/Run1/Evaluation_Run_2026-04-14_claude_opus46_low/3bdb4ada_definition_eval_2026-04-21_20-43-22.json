  "raw_response": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find rectangular blocks of non-zero same-colored cells\n    for r in range(rows):\n        for c in range(cols):\n            if g[r][c] != 0 and not visited[r][c]:\n                color = g[r][c]\n                # Find extent\n                r2, c2 = r, c\n                while c2+1 < cols and g[r][c2+1] == color: c2 += 1\n                while r2+1 < rows and all(g[r2+1][cc] == color for cc in range(c, c2+1)): r2 += 1\n                for rr in range(r, r2+1):\n                    for cc in range(c, c2+1):\n                        visited[rr][cc] = True\n                # Middle row: set every other cell to 0\n                mid = r + 1\n                if mid <= r2 - 1:\n                    for cc in range(c, c2+1):\n                        if (cc - c) % 2 == 1:\n                            g[mid][cc] = 0\n    return g",
  "script": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find rectangular blocks of non-zero same-colored cells\n    for r in range(rows):\n        for c in range(cols):\n            if g[r][c] != 0 and not visited[r][c]:\n                color = g[r][c]\n                # Find extent\n                r2, c2 = r, c\n                while c2+1 < cols and g[r][c2+1] == color: c2 += 1\n                while r2+1 < rows and all(g[r2+1][cc] == color for cc in range(c, c2+1)): r2 += 1\n                for rr in range(r, r2+1):\n                    for cc in range(c, c2+1):\n                        visited[rr][cc] = True\n                # Middle row: set every other cell to 0\n                mid = r + 1\n                if mid <= r2 - 1:\n                    for cc in range(c, c2+1):\n                        if (cc - c) % 2 == 1:\n                            g[mid][cc] = 0\n    return g",
