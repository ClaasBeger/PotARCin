  "raw_response": "def solve(grid):\n    import copy\n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the rectangle bordered by a non-0/non-background color\n    # Find bounding box of the special color (2, 3, 4, 8 etc) that forms a rectangle border\n    \n    # Detect the rectangle: find cells with special border color forming a rectangle\n    # The border color is the one forming a closed rectangle pattern\n    \n    def find_rect(grid, color):\n        positions = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == color]\n        if not positions:\n            return None\n        min_r = min(r for r,c in positions)\n        max_r = max(r for r,c in positions)\n        min_c = min(c for r,c in positions)\n        max_c = max(c for r,c in positions)\n        # Check if it forms a rectangle border\n        expected = set()\n        for c in range(min_c, max_c+1):\n            expected.add((min_r, c))\n            expected.add((max_r, c))\n        for r in range(min_r, max_r+1):\n            expected.add((r, min_c))\n            expected.add((r, max_c))\n        if expected == set(positions):\n            return (min_r, max_r, min_c, max_c)\n        return None\n    \n    # Try each possible color\n    rect = None\n    border_color = None\n    for color in range(10):\n        r = find_rect(grid, color)\n        if r:\n            rect = r\n            border_color = color\n            break\n    \n    if rect is None:\n        return result\n    \n    min_r, max_r, min_c, max_c = rect\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n    \n    # Interior is all zeros - find the interior content\n    interior = []\n    for r in range(min_r, max_r+1):\n        row = []\n        for c in range(min_c, max_c+1):\n            row.append(grid[r][c])\n        interior.append(row)\n    \n    # Count interior zeros (non-border cells)\n    inner_h = h - 2\n    inner_w = w - 2\n    \n    # Now find where to place the second rectangle\n    # Look for a cluster of 0s of same size (inner_h x inner_w) elsewhere\n    # Search for rectangular region of 0s matching inner dimensions\n    \n    for r in range(rows - inner_h + 1):\n        for c in range(cols - inner_w + 1):\n            # Skip if overlaps with original rect\n            if (r + inner_h - 1 >= min_r and r <= max_r and c + inner_w - 1 >= min_c and c <= max_c):\n                continue\n            # Check if all cells in this region are 0\n            all_zero = True\n            for dr in range(inner_h):\n                for dc in range(inner_w):\n                    if grid[r+dr][c+dc] != 0:\n                        all_zero = False\n                        break\n                if not all_zero:\n                    break\n            if all_zero:\n                # Place rectangle border around this region\n                br = r - 1\n                bc = c - 1\n                er = r + inner_h\n                ec = c + inner_w\n                if br >= 0 and bc >= 0 and er < rows and ec < cols:\n                    for cc in range(bc, ec+1):\n                        result[br][cc] = border_color\n                        result[er][cc] = border_color\n                    for rr in range(br, er+1):\n                        result[rr][bc] = border_color\n                        result[rr][ec] = border_color\n                    return result\n    \n    return result",
  "script": "def solve(grid):\n    import copy\n    result = copy.deepcopy(grid)\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the rectangle bordered by a non-0/non-background color\n    # Find bounding box of the special color (2, 3, 4, 8 etc) that forms a rectangle border\n    \n    # Detect the rectangle: find cells with special border color forming a rectangle\n    # The border color is the one forming a closed rectangle pattern\n    \n    def find_rect(grid, color):\n        positions = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == color]\n        if not positions:\n            return None\n        min_r = min(r for r,c in positions)\n        max_r = max(r for r,c in positions)\n        min_c = min(c for r,c in positions)\n        max_c = max(c for r,c in positions)\n        # Check if it forms a rectangle border\n        expected = set()\n        for c in range(min_c, max_c+1):\n            expected.add((min_r, c))\n            expected.add((max_r, c))\n        for r in range(min_r, max_r+1):\n            expected.add((r, min_c))\n            expected.add((r, max_c))\n        if expected == set(positions):\n            return (min_r, max_r, min_c, max_c)\n        return None\n    \n    # Try each possible color\n    rect = None\n    border_color = None\n    for color in range(10):\n        r = find_rect(grid, color)\n        if r:\n            rect = r\n            border_color = color\n            break\n    \n    if rect is None:\n        return result\n    \n    min_r, max_r, min_c, max_c = rect\n    h = max_r - min_r + 1\n    w = max_c - min_c + 1\n    \n    # Interior is all zeros - find the interior content\n    interior = []\n    for r in range(min_r, max_r+1):\n        row = []\n        for c in range(min_c, max_c+1):\n            row.append(grid[r][c])\n        interior.append(row)\n    \n    # Count interior zeros (non-border cells)\n    inner_h = h - 2\n    inner_w = w - 2\n    \n    # Now find where to place the second rectangle\n    # Look for a cluster of 0s of same size (inner_h x inner_w) elsewhere\n    # Search for rectangular region of 0s matching inner dimensions\n    \n    for r in range(rows - inner_h + 1):\n        for c in range(cols - inner_w + 1):\n            # Skip if overlaps with original rect\n            if (r + inner_h - 1 >= min_r and r <= max_r and c + inner_w - 1 >= min_c and c <= max_c):\n                continue\n            # Check if all cells in this region are 0\n            all_zero = True\n            for dr in range(inner_h):\n                for dc in range(inner_w):\n                    if grid[r+dr][c+dc] != 0:\n                        all_zero = False\n                        break\n                if not all_zero:\n                    break\n            if all_zero:\n                # Place rectangle border around this region\n                br = r - 1\n                bc = c - 1\n                er = r + inner_h\n                ec = c + inner_w\n                if br >= 0 and bc >= 0 and er < rows and ec < cols:\n                    for cc in range(bc, ec+1):\n                        result[br][cc] = border_color\n                        result[er][cc] = border_color\n                    for rr in range(br, er+1):\n                        result[rr][bc] = border_color\n                        result[rr][ec] = border_color\n                    return result\n    \n    return result",
