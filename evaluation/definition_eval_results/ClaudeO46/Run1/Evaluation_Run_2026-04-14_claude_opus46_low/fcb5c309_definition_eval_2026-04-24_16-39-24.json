  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find all rectangles made of a single non-zero, non-background value\n    # Find the largest rectangle\n    best = None\n    best_area = 0\n    \n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v == 0:\n                continue\n            # Check if this could be top-left of a rectangle border\n            # Find horizontal extent\n            c2 = c\n            while c2 < cols and grid[r][c2] == v:\n                c2 += 1\n            c2 -= 1\n            if c2 - c < 2:\n                continue\n            # Find vertical extent\n            r2 = r\n            while r2 < rows and grid[r2][c] == v:\n                r2 += 1\n            r2 -= 1\n            if r2 - r < 2:\n                continue\n            # Verify rectangle border\n            w = c2 - c + 1\n            h = r2 - r + 1\n            # Check all border cells\n            valid = True\n            for cc in range(c, c2+1):\n                if grid[r][cc] != v or grid[r2][cc] != v:\n                    valid = False; break\n            if not valid: continue\n            for rr in range(r, r2+1):\n                if grid[rr][c] != v or grid[rr][c2] != v:\n                    valid = False; break\n            if not valid: continue\n            \n            area = w * h\n            if area > best_area:\n                best_area = area\n                best = (r, c, r2, c2, v)\n    \n    r1, c1, r2, c2, border_val = best\n    h = r2 - r1 + 1\n    w = c2 - c1 + 1\n    \n    # Find the other color inside\n    other = 0\n    for r in range(r1, r2+1):\n        for c in range(c1, c2+1):\n            if grid[r][c] != border_val and grid[r][c] != 0:\n                other = grid[r][c]\n                break\n        if other: break\n    \n    # Build output: border becomes `other`, interior keeps other-colored cells\n    result = [[0]*w for _ in range(h)]\n    for r in range(h):\n        for c in range(w):\n            gr, gc = r1+r, c1+c\n            if grid[gr][gc] == border_val:\n                result[r][c] = other\n            elif grid[gr][gc] == other:\n                result[r][c] = other\n            else:\n                result[r][c] = 0\n    \n    return result",
