  "raw_response": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    \n    # Find the two colored regions\n    colors = [c for c in np.unique(g) if c != 0]\n    \n    # Find bounding boxes for each color\n    def get_cells(color):\n        return list(zip(*np.where(g == color)))\n    \n    c1, c2 = colors[0], colors[1]\n    cells1, cells2 = get_cells(c1), get_cells(c2)\n    \n    # The \"symmetry\" pattern (like 7) has the X pattern with corners and center\n    # Find which is the \"stencil\" (2x2 diagonal pattern) and which is the \"shape\"\n    # The stencil seems to be the one forming a 2x2-ish symmetric pattern (like 3x3 with corners+center)\n    \n    # Detect which color is the \"mirror template\" (has symmetric pattern like corners of a rectangle + center)\n    # It's the one that forms a pattern like: X.X / .X. / X.X (diagonal cross in 3x3)\n    \n    def is_mirror_template(cells):\n        rs = [r for r,c in cells]\n        cs = [c for r,c in cells]\n        mr, mc = (min(rs)+max(rs))/2, (min(cs)+max(cs))/2\n        # Check if for every cell (r,c), the mirrored versions also exist\n        cell_set = set(cells)\n        for r,c in cells:\n            if (int(2*mr-r), int(2*mc-c)) not in cell_set:\n                return False\n            if (int(2*mr-r), c) not in cell_set:\n                return False\n            if (r, int(2*mc-c)) not in cell_set:\n                return False\n        return True\n    \n    if is_mirror_template(cells1):\n        template_color, shape_color = c1, c2\n        template_cells, shape_cells = cells1, cells2\n    else:\n        template_color, shape_color = c2, c1\n        template_cells, shape_cells = cells2, cells1\n    \n    # Template center\n    trs = [r for r,c in template_cells]\n    tcs = [c for r,c in template_cells]\n    tcr, tcc = (min(trs)+max(trs))/2, (min(tcs)+max(tcs))/2\n    \n    # Shape relative to template center\n    shape_rel = [(r - tcr, c - tcc) for r,c i