  "raw_response": "def solve(grid):\n    import copy\n    rows, cols = len(grid), len(grid[0])\n    out = [row[:] for row in grid]\n    \n    # Find rectangular patches of non-zero values\n    visited = [[False]*cols for _ in range(rows)]\n    \n    # Find connected components of non-zero cells\n    def flood(r, c):\n        stack = [(r,c)]\n        cells = []\n        while stack:\n            y,x = stack.pop()\n            if y<0 or y>=rows or x<0 or x>=cols: continue\n            if visited[y][x] or grid[y][x]==0: continue\n            visited[y][x]=True\n            cells.append((y,x))\n            for dy,dx in [(-1,0),(1,0),(0,-1),(0,1)]:\n                stack.append((y+dy,x+dx))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c]!=0 and not visited[r][c]:\n                cells = flood(r,c)\n                minr = min(y for y,x in cells)\n                maxr = max(y for y,x in cells)\n                minc = min(x for y,x in cells)\n                maxc = max(x for y,x in cells)\n                \n                # Identify border color and inner color\n                border = grid[minr][minc]\n                # inner region\n                inner_minr, inner_maxr = minr+1, maxr-1\n                inner_minc, inner_maxc = minc+1, maxc-1\n                inner_color = grid[inner_minr][inner_minc]\n                \n                inner_h = inner_maxr - inner_minr + 1\n                inner_w = inner_maxc - inner_minc + 1\n                \n                # New expanded: border expands outward by inner dimensions\n                # Original border ring stays but swaps colors, and new outer ring of border color\n                # Pattern: grow outward, swap border<->inner\n                \n                new_minr = minr - inner_h\n                new_maxr = maxr + inner_h\n                new_minc = minc - inner_w\n                new_maxc = maxc + inner_w\n                \n                # Clear original area first (it'll be rewritten)\n                # Write outer ring (new border) with border color\n                for y in range(new_minr, new_maxr+1):\n                    for x in range(new_minc, new_maxc+1):\n                        if 0<=y<rows and 0<=x<cols:\n                            # Check if in outer ring or inner parts\n                            in_original = (minr<=y<=maxr and minc<=x<=maxc)\n                            in_inner = (inner_minr<=y<=inner_maxr and inner_minc<=x<=inner_maxc)\n                            in_new = (new_minr<=y<=new_maxr and new_minc<=x<=new_maxc)\n                            in_orig_outer = in_original and not in_inner\n                            \n                            if in_inner:\n                                # center becomes border color\n                                out[y][x] = border\n                            elif in_original and not in_inner:\n                                # original border becomes inner color\n                                out[y][x] = inner_color\n                            elif in_new and not in_original:\n                                # new outer ring = border color\n                                # but only the \"frame\" part matching the border thickness\n                                # Actually looking at examples: the outer expansion is border color in same shape\n                                out[y][x] = border\n                \n                # Wait, let me re-check: outer expansion should only be where the border projects outward\n                # The outer ring is: for each side, extend by inner_h or inner_w\n                # But only along the border columns/rows\n                \n                # Reset and redo more carefully\n                for y in range(new_minr, new_maxr+1):\n                    for x in range(new_minc, new_maxc+1):\n                        if 0<=y<rows and 0<=x<cols:\n                            in_inner = (inner_minr<=y<=inner_maxr and inner_minc<=x<=inner_maxc)\n                            in_original = (minr<=y<=maxr and minc<=x<=maxc)\n                            \n                            if in_inner:\n                                out[y][x] = border\n                            elif in_original:\n                                out[y][x] = inner_color\n                            else:\n                                # outside original but inside new bounds\n                                # only if projecting from border columns or rows\n                                in_col_range = (minc<=x<=maxc)\n                                in_row_range = (minr<=y<=maxr)\n                                if in_col_range or in_row_range:\n                                    out[y][x] = border\n                                else:\n                                    pass  # stays 0\n    \n    return out",
