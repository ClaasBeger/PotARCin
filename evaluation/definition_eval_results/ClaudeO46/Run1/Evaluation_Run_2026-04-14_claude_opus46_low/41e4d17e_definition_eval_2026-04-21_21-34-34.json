 8\n8 8 8 8 8 6 8 8 8 8 6 8 8 8 8\n8 8 8 8 8 6 8 8 8 8 6 8 8 8 8\n8 8 8 1 1 1 1 1 8 8 6 8 8 8 8\n8 8 8 1 8 6 8 1 8 8 6 8 8 8 8\n6 6 6 1 6 6 6 1 6 6 6 6 6 6 6\n8 8 8 1 8 6 8 1 8 8 6 8 8 8 8\n8 8 8 1 1 1 1 1 8 8 6 8 8 8 8\n8 8 8 8 8 6 8 8 8 8 6 8 8 8 8\n8 8 8 8 8 6 8 8 1 1 1 1 1 8 8\n8 8 8 8 8 6 8 8 1 8 6 8 1 8 8\n6 6 6 6 6 6 6 6 1 6 6 6 1 6 6\n8 8 8 8 8 6 8 8 1 8 6 8 1 8 8\n8 8 8 8 8 6 8 8 1 1 1 1 1 8 8\n8 8 8 8 8 6 8 8 8 8 6 8 8 8 8\n\nBelow is a test input grid.\n\nInput:\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n8 8 8 8 8 8 1 1 1 1 1 8 8 8 8\n8 8 8 8 8 8 1 8 8 8 1 8 8 8 8\n8 8 8 8 8 8 1 8 8 8 1 8 8 8 8\n8 8 8 8 8 8 1 8 8 8 1 8 8 8 8\n8 8 8 8 8 8 1 1 1 1 1 8 8 8 8\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n8 8 8 1 1 1 1 1 8 8 8 8 8 8 8\n8 8 8 1 8 8 8 1 8 8 8 8 8 8 8\n8 8 8 1 8 8 8 1 8 8 8 8 8 8 8\n8 8 8 1 8 8 8 1 8 8 8 8 8 8 8\n8 8 8 1 1 1 1 1 8 8 8 8 8 8 8\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    result = copy.deepcopy(grid)\n    \n    # Find rectangles\n    rects = []\n    visited = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and (r,c) not in visited:\n                # Find bounding box of this rectangle\n                # Top-left corner: find extent\n                r2, c2 = r, c\n                while c2+1 < cols and grid[r][c2+1] == 1:\n                    c2 += 1\n                while r2+1 < rows and grid[r2+1][c] == 1:\n                    r2 += 1\n                # Check if it's a valid 5x5 rectangle border\n                if r2-r == 4 and c2-c == 4:\n                    rects.append((r, c, r2, c2))\n                    for rr in range(r, r2+1):\n                        for cc in range(c, c2+1):\n                            visited.add((rr, cc))\n    \n    for (r1, c1, r2, c2) in rects:\n        mid_r = (r1 + r2) // 2\n        mid_c = (c1 + c2) // 2\n        # Draw horizontal line through mid_r\n        for c in range(cols):\n            if result[mid_r][c] == 8:\n                result[mid_r][c] = 6\n        # Draw vertical line through mid_c\n        for r in range(rows):\n            if result[r][mid_c] == 8:\n                result[r][mid_c] = 6\n    \n    return result",
  "script": "def solve(grid):\n    import copy\n    rows = len(grid)\n    cols = len(grid[0])\n    result = copy.deepcopy(grid)\n    \n    # Find rectangles\n    rects = []\n    visited = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and (r,c) not in visited:\n                # Find bounding box of this rectangle\n                # Top-left corner: find extent\n                r2, c2 = r, c\n                while c2+1 < cols and grid[r][c2+1] == 1:\n                    c2 += 1\n                while r2+1 < rows and grid[r2+1][c] == 1:\n                    r2 += 1\n                # Check if it's a valid 5x5 rectangle border\n                if r2-r == 4 and c2-c == 4:\n                    rects.append((r, c, r2, c2))\n                    for rr in range(r, r2+1):\n                        for cc in range(c, c2+1):\n                            visited.add((rr, cc))\n    \n    for (r1, c1, r2, c2) in rects:\n        mid_r = (r1 + r2) // 2\n        mid_c = (c1 + c2) // 2\n        # Draw horizontal line through mid_r\n        for c in range(cols):\n            if result[mid_r][c] == 8:\n                result[mid_r][c] = 6\n        # Draw vertical line through mid_c\n        for r in range(rows):\n            if result[r][mid_c] == 8:\n                result[r][mid_c] = 6\n    \n    return result",
