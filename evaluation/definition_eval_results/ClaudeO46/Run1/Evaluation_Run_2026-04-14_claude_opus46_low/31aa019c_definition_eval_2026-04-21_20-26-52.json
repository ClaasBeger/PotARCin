ch value.\n    \n    center_val = None\n    center_pos = None\n    for v in singletons:\n        # Check: is this the center? The surrounding value is 2.\n        pos = positions[v][0]\n        center_val = v\n        center_pos = pos\n    \n    # If multiple singletons, we need to pick the right one.\n    # The surrounding is always 2. So pick singleton that isn't 2.\n    for v in singletons:\n        if v != 2:\n            # Could be it. Let me just pick based on: appears exactly once and isn't 2\n            center_val = v\n            center_pos = positions[v][0]\n    \n    # For test input, let me see: 9 appears once at (6,5), 1 appears at (9,0),(9,2) twice,\n    # 6 appears at (1,4),(7,6),(9,8) three times... let me just trust the logic.\n    \n    result = [[0]*cols for _ in range(rows)]\n    r, c = center_pos\n    for dr in range(-1, 2):\n        for dc in range(-1, 2):\n            nr, nc = r+dr, c+dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                if dr == 0 and dc == 0:\n                    result[nr][nc] = center_val\n                else:\n                    result[nr][nc] = 2\n    \n    return result",
