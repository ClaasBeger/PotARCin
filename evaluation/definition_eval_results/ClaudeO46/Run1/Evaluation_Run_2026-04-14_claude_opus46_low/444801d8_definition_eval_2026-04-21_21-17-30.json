  "raw_response": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    \n    # Find each rectangle with a colored center\n    for r in range(rows):\n        for c in range(cols):\n            v = g[r][c]\n            if v not in (0, 1):\n                # Find the 1-border rectangle containing this cell\n                # Find bounds by looking for the 1s\n                # The gap in the top row indicates direction to fill\n                # Find the bounding box of 1s connected to this region\n                \n                # Search for the enclosing rectangle of 1s\n                # Look for bottom-right corner area\n                for tr in range(r-2, r+1):\n                    for tc in range(c-2, c+1):\n                        if tr < 0 or tc < 0: continue\n                        br = tr + 4\n                        bc = tc + 4\n                        if br >= rows and bc >= cols: continue\n                        # Check if this forms a valid rectangle\n                        # Just find the 1-rectangle properly\n                \n                # Simpler: find all 1s nearby and determine the box\n                min_r = max_r = r\n                min_c = max_c = c\n                visited = set()\n                stack = [(r,c)]\n                ones = set()\n                visited.add((r,c))\n                # BFS to find connected non-zero region\n                while stack:\n                    cr, cc = stack.pop()\n                    for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                        nr, nc = cr+dr, cc+dc\n                        if 0<=nr<rows and 0<=nc<cols and (nr,nc) not in visited:\n                            if grid[nr][nc] != 0:\n                                visited.add((nr,nc))\n                                stack.append((nr,nc))\n                \n                for (rr,cc) in visited:\n                    min_r=min(min_r,rr); max_r=max(max_r,rr)\n                    min_c=min(min_c,cc); max_c=max(max_c,cc)\n                \n                # Find the gap in the 1-border\n                # Check top row for gap\n                gap_dir = None\n                for cc in range(min_c, max_c+1):\n                    if grid[min_r][cc] == 0:\n                        gap_dir = 'top'; break\n                if not gap_dir:\n                    for cc in range(min_c, max_c+1):\n                        if grid[max_r][cc] == 0:\n                            gap_dir = 'bottom'; break\n                if not gap_dir:\n                    for rr in range(min_r, max_r+1):\n                        if grid[rr][min_c] == 0:\n                            gap_dir = 'left'; break\n                if not gap_dir:\n                    for rr in range(min_r, max_r+1):\n                        if grid[rr][max_c] == 0:\n                            gap_dir = 'right'; break\n                \n                # Fill interior with v\n                for rr in range(min_r+1, max_r):\n                    for cc in range(min_c+1, max_c):\n                        if grid[rr][cc] != 1:\n                            g[rr][cc] = v\n                \n                # Fill the row/col outside the gap\n                if gap_dir == 'top':\n                    ext_r = min_r - 1\n                    if ext_r >= 0:\n                        for cc in range(min_c, max_c+1):\n                            g[ext_r][cc] = v\n                    # Also fill gap cells in top row\n                    for cc in range(min_c, max_c+1):\n                        if grid[min_r][cc] == 0:\n                            g[min_r][cc] = v\n                elif gap_dir == 'bottom':\n                    ext_r = max_r + 1\n                    if ext_r < rows:\n                        for cc in range(min_c, max_c+1):\n                            g[ext_r][cc] = v\n                    for cc in range(min_c, max_c+1):\n                        if grid[max_r][cc] == 0:\n                       