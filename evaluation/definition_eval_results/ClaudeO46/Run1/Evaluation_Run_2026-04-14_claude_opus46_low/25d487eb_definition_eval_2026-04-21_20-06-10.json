  "raw_response": "def solve(grid):\n    import copy\n    result = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the unique color (appears once) among non-zero cells\n    from collections import Counter\n    counts = Counter()\n    pos = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] += 1\n                if grid[r][c] not in pos:\n                    pos[grid[r][c]] = (r, c)\n    \n    # Find the special color (appears exactly once)\n    special = [k for k, v in counts.items() if v == 1][0]\n    sr, sc = pos[special]\n    \n    # The arrow shape points away from the special cell. Find the direction\n    # by looking at where the bulk of the other color is relative to special.\n    other = [k for k in counts if k != special][0]\n    \n    # Compute centroid of other-colored cells\n    orows, ocols = [], []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == other:\n                orows.append(r)\n                ocols.append(c)\n    \n    cr = sum(orows) / len(orows) - sr\n    cc = sum(ocols) / len(ocols) - sc\n    \n    # Direction from special to centroid of other; the trail goes opposite\n    if abs(cr) >= abs(cc):\n        dr, dc = (-1 if cr > 0 else 1, 0)\n    else:\n        dr, dc = (0, -1 if cc > 0 else 1)\n    \n    # Draw trail from special cell in that direction to edge\n    r, c = sr + dr, sc + dc\n    while 0 <= r < rows and 0 <= c < cols:\n        if result[r][c] == 0:\n            result[r][c] = special\n        r += dr\n        c += dc\n    \n    return result",
  "script": "def solve(grid):\n    import copy\n    result = [row[:] for row in grid]\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the unique color (appears once) among non-zero cells\n    from collections import Counter\n    counts = Counter()\n    pos = {}\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                counts[grid[r][c]] += 1\n                if grid[r][c] not in pos:\n                    pos[grid[r][c]] = (r, c)\n    \n    # Find the special color (appears exactly once)\n    special = [k for k, v in counts.items() if v == 1][0]\n    sr, sc = pos[special]\n    \n    # The arrow shape points away from the special cell. Find the direction\n    # by looking at where the bulk of the other color is relative to special.\n    other = [k for k in counts if k != special][0]\n    \n    # Compute centroid of other-colored cells\n    orows, ocols = [], []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == other:\n                orows.append(r)\n                ocols.append(c)\n    \n    cr = sum(orows) / len(orows) - sr\n    cc = sum(ocols) / len(ocols) - sc\n    \n    # Direction from special to centroid of other; the trail goes opposite\n    if abs(cr) >= abs(cc):\n        dr, dc = (-1 if cr > 0 else 1, 0)\n    else:\n        dr, dc = (0, -1 if cc > 0 else 1)\n    \n    # Draw trail from special cell in that direction to edge\n    r, c = sr + dr, sc + dc\n    while 0 <= r < rows and 0 <= c < cols:\n        if result[r][c] == 0:\n            result[r][c] = special\n        r += dr\n        c += dc\n    \n    return result",
