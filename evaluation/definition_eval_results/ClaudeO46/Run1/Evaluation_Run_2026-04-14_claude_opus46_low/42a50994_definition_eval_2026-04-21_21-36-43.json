  "raw_response": "def solve(grid):\n    import numpy as np\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    g = [row[:] for row in grid]\n    val = 0\n    for r in range(rows):\n        for c in range(cols):\n            if g[r][c] != 0:\n                val = g[r][c]\n                break\n        if val: break\n    \n    # Find connected components of non-zero cells\n    visited = [[False]*cols for _ in range(rows)]\n    components = []\n    \n    def bfs(sr, sc):\n        from collections import deque\n        q = deque([(sr, sc)])\n        visited[sr][sc] = True\n        cells = [(sr, sc)]\n        while q:\n            r, c = q.popleft()\n            for dr in range(-1, 2):\n                for dc in range(-1, 2):\n                    if dr == 0 and dc == 0: continue\n                    nr, nc = r+dr, c+dc\n                    if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and g[nr][nc] != 0:\n                        visited[nr][nc] = True\n                        q.append((nr, nc))\n                        cells.append((nr, nc))\n        return cells\n    \n    for r in range(rows):\n        for c in range(cols):\n            if g[r][c] != 0 and not visited[r][c]:\n                comp = bfs(r, c)\n                components.append(comp)\n    \n    # Find the largest component, keep it. Remove all others (set to 0).\n    # Wait, looking at examples more carefully...\n    # Actually it seems like isolated/small clusters are removed and larger ones kept.\n    \n    # Let me check: sort by size, keep largest ones?\n    # Example 1: input has several clusters. Output keeps some.\n    # It seems like singleton cells (size 1) are removed, clusters of size >= 2 are kept.\n    # Let me verify with example 1...\n    \n    # Actually looking more carefully, in example 1 output, cells like (0,1),(1,0) are kept (size 2),\n    # (2,4),(3,4) kept (size 2), (4,2),(4,3),(5,3),(6,2) kept (size 4), etc.\n    # Singletons like (2,7),(2,9),(5,8),(6,6) ar