  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the unique color (not part of the regular pattern) that forms a rectangle border\n    # Look for a value that appears in a rectangular border pattern\n    \n    # Find all cells that differ when comparing symmetric blocks\n    # Strategy: find the rectangle of the special color\n    \n    for val in range(10):\n        cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == val]\n        if not cells:\n            continue\n        min_r = min(r for r,c in cells)\n        max_r = max(r for r,c in cells)\n        min_c = min(c for r,c in cells)\n        max_c = max(c for r,c in cells)\n        \n        # Check if these cells form exactly the border of a rectangle\n        border = set()\n        for r in range(min_r, max_r+1):\n            for c in range(min_c, max_c+1):\n                if r == min_r or r == max_r or c == min_c or c == max_c:\n                    border.add((r,c))\n        \n        if set(cells) == border and len(cells) > 4:\n            # Found it\n            result = []\n            for r in range(min_r, max_r+1):\n                row = []\n                for c in range(min_c, max_c+1):\n                    row.append(grid[r][c])\n                result.append(row)\n            return result\n    \n    return grid",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find the unique color (not part of the regular pattern) that forms a rectangle border\n    # Look for a value that appears in a rectangular border pattern\n    \n    # Find all cells that differ when comparing symmetric blocks\n    # Strategy: find the rectangle of the special color\n    \n    for val in range(10):\n        cells = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == val]\n        if not cells:\n            continue\n        min_r = min(r for r,c in cells)\n        max_r = max(r for r,c in cells)\n        min_c = min(c for r,c in cells)\n        max_c = max(c for r,c in cells)\n        \n        # Check if these cells form exactly the border of a rectangle\n        border = set()\n        for r in range(min_r, max_r+1):\n            for c in range(min_c, max_c+1):\n                if r == min_r or r == max_r or c == min_c or c == max_c:\n                    border.add((r,c))\n        \n        if set(cells) == border and len(cells) > 4:\n            # Found it\n            result = []\n            for r in range(min_r, max_r+1):\n                row = []\n                for c in range(min_c, max_c+1):\n                    row.append(grid[r][c])\n                result.append(row)\n            return result\n    \n    return grid",
