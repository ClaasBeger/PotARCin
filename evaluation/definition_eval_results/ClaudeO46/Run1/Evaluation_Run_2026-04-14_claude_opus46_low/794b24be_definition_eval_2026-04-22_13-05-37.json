  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0])\n    count = sum(grid[i][j] for i in range(n) for j in range(m))\n    result = [[0]*m for _ in range(n)]\n    # Fill count 2's in reading order\n    k = 0\n    for i in range(n):\n        for j in range(m):\n            if k < count:\n                result[i][j] = 2\n                k += 1\n    return result",
