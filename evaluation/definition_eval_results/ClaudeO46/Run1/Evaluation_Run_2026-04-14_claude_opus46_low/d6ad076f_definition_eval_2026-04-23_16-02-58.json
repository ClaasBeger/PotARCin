  "raw_response": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    \n    # Find rectangles\n    rects = []\n    visited = set()\n    for r in range(rows):\n        for c in range(cols):\n            if g[r,c] != 0 and (r,c) not in visited:\n                val = g[r,c]\n                # Find extent\n                r2, c2 = r, c\n                while r2+1 < rows and g[r2+1,c] == val: r2 += 1\n                while c2+1 < cols and g[r,c2+1] == val: c2 += 1\n                for rr in range(r, r2+1):\n                    for cc in range(c, c2+1):\n                        visited.add((rr,cc))\n                rects.append((r, c, r2, c2))\n    \n    # Find overlap region between the two rectangles' projections\n    r1, r2 = rects[0], rects[1]\n    # Overlap in rows\n    row_start = max(r1[0], r2[0])\n    row_end = min(r1[2], r2[2])\n    col_start = max(r1[1], r2[1])\n    col_end = min(r1[3], r2[3])\n    \n    # The gap between them - find the intersection of their spans\n    # Project each rect's row range and col range, find where gap is\n    # The 8s fill the gap between the two rectangles in overlapping dimension\n    \n    result = g.copy()\n    \n    # Check if they're separated horizontally or vertically\n    # Horizontal separation: no column overlap, check row overlap\n    if col_end < col_start:  # no col overlap -> horizontal gap\n        r_start = max(r1[0], r2[0])\n        r_end = min(r1[2], r2[2])\n        c_start = min(r1[3], r2[3]) + 1\n        c_end = max(r1[1], r2[1]) - 1\n        for r in range(r_start, r_end+1):\n            for c in range(c_start, c_end+1):\n                result[r,c] = 8\n    else:  # vertical gap\n        c_start = max(r1[1], r2[1])\n        c_end = min(r1[3], r2[3])\n        r_start = min(r1[2], r2[2]) + 1\n        r_end = max(r1[0], r2[0]) - 1\n        for r in range(r_start, r_end+1):\n            for c in range(c_start, c_end+1):\n                result[r,c] = 8\n    \n    return result.tolist()",
  "script": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    \n    # Find rectangles\n    rects = []\n    visited = set()\n    for r in range(rows):\n        for c in range(cols):\n            if g[r,c] != 0 and (r,c) not in visited:\n                val = g[r,c]\n                # Find extent\n                r2, c2 = r, c\n                while r2+1 < rows and g[r2+1,c] == val: r2 += 1\n                while c2+1 < cols and g[r,c2+1] == val: c2 += 1\n                for rr in range(r, r2+1):\n                    for cc in range(c, c2+1):\n                        visited.add((rr,cc))\n                rects.append((r, c, r2, c2))\n    \n    # Find overlap region between the two rectangles' projections\n    r1, r2 = rects[0], rects[1]\n    # Overlap in rows\n    row_start = max(r1[0], r2[0])\n    row_end = min(r1[2], r2[2])\n    col_start = max(r1[1], r2[1])\n    col_end = min(r1[3], r2[3])\n    \n    # The gap between them - find the intersection of their spans\n    # Project each rect's row range and col range, find where gap is\n    # The 8s fill the gap between the two rectangles in overlapping dimension\n    \n    result = g.copy()\n    \n    # Check if they're separated horizontally or vertically\n    # Horizontal separation: no column overlap, check row overlap\n    if col_end < col_start:  # no col overlap -> horizontal gap\n        r_start = max(r1[0], r2[0])\n        r_end = min(r1[2], r2[2])\n        c_start = min(r1[3], r2[3]) + 1\n        c_end = max(r1[1], r2[1]) - 1\n        for r in range(r_start, r_end+1):\n            for c in range(c_start, c_end+1):\n                result[r,c] = 8\n    else:  # vertical gap\n        c_start = max(r1[1], r2[1])\n        c_end = min(r1[3], r2[3])\n        r_start = min(r1[2], r2[2]) + 1\n        r_end = max(r1[0], r2[0]) - 1\n        for r in range(r_start, r_end+1):\n            for c in range(c_start, c_end+1):\n                result[r,c] = 8\n    \n    return result.tolist()",
