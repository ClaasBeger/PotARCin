  "raw_response": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    \n    # Find bounding box of all 1s\n    ones = [(r,c) for r in range(rows) for c in range(cols) if g[r][c]==1]\n    minr = min(r for r,c in ones)\n    maxr = max(r for r,c in ones)\n    minc = min(c for r,c in ones)\n    maxc = max(c for r,c in ones)\n    \n    # Fill borders: top row, bottom row, left col, right col of bounding box\n    # Where there's a 0 on these borders, put 2\n    for c in range(minc, maxc+1):\n        if g[minr][c] == 0: g[minr][c] = 2\n        if g[maxr][c] == 0: g[maxr][c] = 2\n    for r in range(minr, maxr+1):\n        if g[r][minc] == 0: g[r][minc] = 2\n        if g[r][maxc] == 0: g[r][maxc] = 2\n    \n    # Check for internal horizontal borders (rows that have 1s spanning left to right)\n    # Look for rows between minr and maxr where there are 1s on both edges\n    for r in range(minr+1, maxr):\n        if grid[r][minc] in [1] and grid[r][maxc] in [1]:\n            # This might be an internal border row\n            # Check if it has any 1s besides edges\n            has_ones = any(grid[r][c]==1 for c in range(minc+1, maxc))\n            if has_ones:\n                for c in range(minc, maxc+1):\n                    if g[r][c] == 0: g[r][c] = 2\n    \n    for c in range(minc+1, maxc):\n        if grid[minr][c] in [1] and grid[maxr][c] in [1]:\n            has_ones = any(grid[r][c]==1 for r in range(minr+1, maxr))\n            if has_ones:\n                for r in range(minr, maxr+1):\n                    if g[r][c] == 0: g[r][c] = 2\n    \n    return g",
  "script": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    \n    # Find bounding box of all 1s\n    ones = [(r,c) for r in range(rows) for c in range(cols) if g[r][c]==1]\n    minr = min(r for r,c in ones)\n    maxr = max(r for r,c in ones)\n    minc = min(c for r,c in ones)\n    maxc = max(c for r,c in ones)\n    \n    # Fill borders: top row, bottom row, left col, right col of bounding box\n    # Where there's a 0 on these borders, put 2\n    for c in range(minc, maxc+1):\n        if g[minr][c] == 0: g[minr][c] = 2\n        if g[maxr][c] == 0: g[maxr][c] = 2\n    for r in range(minr, maxr+1):\n        if g[r][minc] == 0: g[r][minc] = 2\n        if g[r][maxc] == 0: g[r][maxc] = 2\n    \n    # Check for internal horizontal borders (rows that have 1s spanning left to right)\n    # Look for rows between minr and maxr where there are 1s on both edges\n    for r in range(minr+1, maxr):\n        if grid[r][minc] in [1] and grid[r][maxc] in [1]:\n            # This might be an internal border row\n            # Check if it has any 1s besides edges\n            has_ones = any(grid[r][c]==1 for c in range(minc+1, maxc))\n            if has_ones:\n                for c in range(minc, maxc+1):\n                    if g[r][c] == 0: g[r][c] = 2\n    \n    for c in range(minc+1, maxc):\n        if grid[minr][c] in [1] and grid[maxr][c] in [1]:\n            has_ones = any(grid[r][c]==1 for r in range(minr+1, maxr))\n            if has_ones:\n                for r in range(minr, maxr+1):\n                    if g[r][c] == 0: g[r][c] = 2\n    \n    return g",
