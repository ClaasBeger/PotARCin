  "raw_response": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    hlines = [r for r in range(rows) if all(grid[r][c] == 8 for c in range(cols))]\n    vlines = [c for c in range(cols) if all(grid[r][c] == 8 for r in range(rows))]\n    \n    # Find regions between consecutive h/v lines\n    # The \"cross\" is formed by exactly 2 hlines and 2 vlines, creating a center cell\n    # Center gets 6, top-center 2, bottom-center 1, left-center 4, right-center 3\n    \n    h = hlines  # horizontal line rows\n    v = vlines  # vertical line cols\n    \n    result = [row[:] for row in grid]\n    \n    # Build row bands and col bands\n    row_bands = []\n    prev = -1\n    for hl in h:\n        if hl > prev + 1:\n            row_bands.append((prev + 1, hl - 1))\n        prev = hl\n    if prev < rows - 1:\n        row_bands.append((prev + 1, rows - 1))\n    \n    col_bands = []\n    prev = -1\n    for vl in v:\n        if vl > prev + 1:\n            col_bands.append((prev + 1, vl - 1))\n        prev = vl\n    if prev < cols - 1:\n        col_bands.append((prev + 1, cols - 1))\n    \n    # ri, ci indices: center is where both are 1 (middle band between the two lines)\n    # With 2 lines we get 3 bands each (indices 0,1,2)\n    # top=0, middle=1, bottom=2 for rows; left=0, center=1, right=2 for cols\n    \n    color_map = {\n        (1, 1): 6,  # center\n        (0, 1): 2,  # top-center\n        (2, 1): 1,  # bottom-center\n        (1, 0): 4,  # middle-left\n        (1, 2): 3,  # middle-right\n    }\n    \n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            if (ri, ci) in color_map:\n                color = color_map[(ri, ci)]\n                for r in range(r0, r1 + 1):\n                    for c in range(c0, c1 + 1):\n                        result[r][c] = color\n    \n    return result",
  "script": "def solve(grid):\n    rows, cols = len(grid), len(grid[0])\n    hlines = [r for r in range(rows) if all(grid[r][c] == 8 for c in range(cols))]\n    vlines = [c for c in range(cols) if all(grid[r][c] == 8 for r in range(rows))]\n    \n    # Find regions between consecutive h/v lines\n    # The \"cross\" is formed by exactly 2 hlines and 2 vlines, creating a center cell\n    # Center gets 6, top-center 2, bottom-center 1, left-center 4, right-center 3\n    \n    h = hlines  # horizontal line rows\n    v = vlines  # vertical line cols\n    \n    result = [row[:] for row in grid]\n    \n    # Build row bands and col bands\n    row_bands = []\n    prev = -1\n    for hl in h:\n        if hl > prev + 1:\n            row_bands.append((prev + 1, hl - 1))\n        prev = hl\n    if prev < rows - 1:\n        row_bands.append((prev + 1, rows - 1))\n    \n    col_bands = []\n    prev = -1\n    for vl in v:\n        if vl > prev + 1:\n            col_bands.append((prev + 1, vl - 1))\n        prev = vl\n    if prev < cols - 1:\n        col_bands.append((prev + 1, cols - 1))\n    \n    # ri, ci indices: center is where both are 1 (middle band between the two lines)\n    # With 2 lines we get 3 bands each (indices 0,1,2)\n    # top=0, middle=1, bottom=2 for rows; left=0, center=1, right=2 for cols\n    \n    color_map = {\n        (1, 1): 6,  # center\n        (0, 1): 2,  # top-center\n        (2, 1): 1,  # bottom-center\n        (1, 0): 4,  # middle-left\n        (1, 2): 3,  # middle-right\n    }\n    \n    for ri, (r0, r1) in enumerate(row_bands):\n        for ci, (c0, c1) in enumerate(col_bands):\n            if (ri, ci) in color_map:\n                color = color_map[(ri, ci)]\n                for r in range(r0, r1 + 1):\n                    for c in range(c0, c1 + 1):\n                        result[r][c] = color\n    \n    return result",
