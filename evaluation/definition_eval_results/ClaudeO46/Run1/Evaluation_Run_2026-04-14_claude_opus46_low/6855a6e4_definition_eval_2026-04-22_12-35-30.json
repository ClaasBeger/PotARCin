  result[nr][c] = 5\n    else:\n        if dc < 0:  # 5s left\n            for r,c in fives:\n                nc = 2*c2min - c\n                if 0 <= nc < cols:\n                    result[r][nc] = 5\n        else:  # 5s right\n            for r,c in fives:\n                nc = 2*c2max - c\n                if 0 <= nc < cols:\n                    result[r][nc] = 5\n    \n    return result",
