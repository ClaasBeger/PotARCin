  "raw_response": "def solve(grid):\n    import copy\n    rows, cols = len(grid), len(grid[0])\n    \n    # Find 2-cells and 5-cells\n    twos = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 2]\n    fives = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] == 5]\n    \n    # Find the bounding box of the 2-rectangle\n    r2min = min(r for r,c in twos)\n    r2max = max(r for r,c in twos)\n    c2min = min(c for r,c in twos)\n    c2max = max(c for r,c in twos)\n    \n    # The opening is on the side where 2s are missing\n    # Find the interior of the rectangle\n    # The 5s need to be reflected into the interior through the opening\n    \n    # Determine which side(s) the 5-pattern is on relative to the 2-box\n    f_rcenter = sum(r for r,c in fives)/len(fives)\n    f_ccenter = sum(c for r,c in fives)/len(fives)\n    r2center = (r2min+r2max)/2\n    c2center = (c2min+c2max)/2\n    \n    result = copy.deepcopy(grid)\n    # Clear all 5s\n    for r,c in fives:\n        result[r][c] = 0\n    \n    # Determine direction of 5s relative to box center\n    dr = f_rcenter - r2center\n    dc = f_ccenter - c2center\n    \n    # Find the opening edge - the edge closest to the 5s\n    # Mirror 5s through that edge into the box interior\n    if abs(dr) > abs(dc):\n        # top or bottom\n        if dr < 0:  # 5s above, opening is top edge (r2min)\n            for r,c in fives:\n                nr = 2*r2min - r + 1  # reflect: distance from r to r2min is r2min-r, place at r2min + (r2min-r) +1? \n                # Actually: reflect into interior. The opening row is r2min+1 (first interior row)\n                # Distance of 5 from r2min: d = r2min - r\n                # New position: r2min + d = 2*r2min - r\n                nr = 2*r2min - r\n                if 0 <= nr < rows:\n                    result[nr][c] = 5\n        else:  # 5s below\n            for r,c in fives:\n                nr = 2*r2max - r\n                if 0 <= nr < rows:\n                    result[nr][c] = 5\n    else:\n        if dc < 0:  # 5s left\n            for r,c in fives:\n                nc = 2*c2min - c\n                if 0 <= nc < cols:\n                    result[r][nc] = 5\n        else:  # 5s right\n            for r,c in fives:\n                nc = 2*c2max - c\n                if 0 <= nc < cols:\n                    result[r][nc] = 5\n    \n    return result",
