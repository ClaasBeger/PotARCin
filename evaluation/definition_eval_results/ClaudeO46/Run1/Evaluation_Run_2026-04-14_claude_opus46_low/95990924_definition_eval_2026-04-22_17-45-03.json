  "raw_response": "def solve(grid):\n    import copy\n    out = copy.deepcopy(grid)\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find all 2x2 blocks of 5s\n    blocks = []\n    visited = set()\n    for r in range(rows-1):\n        for c in range(cols-1):\n            if (r,c) not in visited and grid[r][c]==5 and grid[r][c+1]==5 and grid[r+1][c]==5 and grid[r+1][c+1]==5:\n                blocks.append((r,c))\n                visited.update([(r,c),(r,c+1),(r+1,c),(r+1,c+1)])\n    \n    for (r,c) in blocks:\n        # Place 1,2,3,4 at corners diagonal to the block\n        out[r-1][c-1] = 1\n        out[r-1][c+2] = 2\n        out[r+2][c-1] = 3\n        out[r+2][c+2] = 4\n    \n    return out",
  "script": "def solve(grid):\n    import copy\n    out = copy.deepcopy(grid)\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find all 2x2 blocks of 5s\n    blocks = []\n    visited = set()\n    for r in range(rows-1):\n        for c in range(cols-1):\n            if (r,c) not in visited and grid[r][c]==5 and grid[r][c+1]==5 and grid[r+1][c]==5 and grid[r+1][c+1]==5:\n                blocks.append((r,c))\n                visited.update([(r,c),(r,c+1),(r+1,c),(r+1,c+1)])\n    \n    for (r,c) in blocks:\n        # Place 1,2,3,4 at corners diagonal to the block\n        out[r-1][c-1] = 1\n        out[r-1][c+2] = 2\n        out[r+2][c-1] = 3\n        out[r+2][c+2] = 4\n    \n    return out",
