  "script": "def solve(grid):\n    # Find non-zero region bounds\n    rows, cols = len(grid), len(grid[0])\n    non_zero = [(r,c) for r in range(rows) for c in range(cols) if grid[r][c] != 0]\n    r_min = min(r for r,c in non_zero)\n    r_max = max(r for r,c in non_zero)\n    c_min = min(c for r,c in non_zero)\n    c_max = max(c for r,c in non_zero)\n    \n    # Find row boundaries where color changes\n    row_bounds = [r_min]\n    for r in range(r_min+1, r_max+1):\n        row_vals = [grid[r][c] for c in range(c_min, c_max+1)]\n        prev_vals = [grid[r-1][c] for c in range(c_min, c_max+1)]\n        if row_vals != prev_vals:\n            row_bounds.append(r)\n    row_bounds.append(r_max+1)\n    \n    col_bounds = [c_min]\n    for c in range(c_min+1, c_max+1):\n        col_vals = [grid[r][c] for r in range(r_min, r_max+1)]\n        prev_vals = [grid[r][c-1] for r in range(r_min, r_max+1)]\n        if col_vals != prev_vals:\n            col_bounds.append(c)\n    col_bounds.append(c_max+1)\n    \n    result = []\n    for i in range(len(row_bounds)-1):\n        row = []\n        for j in range(len(col_bounds)-1):\n            row.append(grid[row_bounds[i]][col_bounds[j]])\n        result.append(row)\n    return result",
