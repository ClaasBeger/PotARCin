ython script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    bg = grid[0][0]\n    \n    def find_objects(grid, bg):\n        rows, cols = len(grid), len(grid[0])\n        visited = [[False]*cols for _ in range(rows)]\n        objects = []\n        for r in range(rows):\n            for c in range(cols):\n                if grid[r][c] != bg and not visited[r][c]:\n                    color = grid[r][c]\n                    stack = [(r,c)]\n                    cells = []\n                    while stack:\n                        cr,cc = stack.pop()\n                        if 0<=cr<rows and 0<=cc<cols and not visited[cr][cc] and grid[cr][cc]==color:\n                            visited[cr][cc]=True\n                            cells.append((cr,cc))\n                            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n                                stack.append((cr+dr,cc+dc))\n                    objects.append((color, cells))\n        return objects\n    \n    objects = find_objects(grid, bg)\n    \n    # For each object, get bounding box and pattern\n    def get_bbox(cells):\n        rs = [r for r,c in cells]\n        cs = [c for r,c in cells]\n        return min(rs),min(cs),max(rs),max(cs)\n    \n    def get_pattern(color, cells, bg):\n        r1,c1,r2,c2 = get_bbox(cells)\n        h,w = r2-r1+1, c2-c1+1\n        pat = [[bg]*w for _ in range(h)]\n        for r,c in cells:\n            pat[r-r1][c-c1] = color\n        return pat\n    \n    # Find the object whose bounding box has cells that are 2x2 scaled (duplicated)\n    # That's the \"selector\" shape. The non-scaled objects are candidates.\n    \n    def is_scaled(cells, factor=2):\n        r1,c1,r2,c2 = get_bbox(cells)\n        h,w = r2-r1+1, c2-c1+1\n        if h%factor!=0 or w%factor!=0: return False\n        cell_set = set(cells)\n        sh,sw = h//factor, w//factor\n        for sr in range(sh):\n            for sc in range(sw):\n                block = [(r1+sr*factor+dr, c1+sc*factor+dc) for dr in range(factor) for dc in range(factor)]\n                present = all(b in cell_set for b in block)\n                absent = all(b not in cell_set for b in block)\n                if not present and not absent:\n                    return False\n        return True\n    \n    scaled_obj = None\n    small_objs = []\n    for color, cells in objects:\n        if is_scaled(cells, 2):\n            scaled_obj = (color, cells)\n        else:\n            small_objs.append((color, cells))\n    \n    # The scaled object gives the template shape. Downscale it.\n    r1,c1,r2,c2 = get_bbox(scaled_obj[1])\n    cell_set = set(scaled_obj[1])\n    sh,sw = (r2-r1+1)//2, (c2-c1+1)//2\n    template = [[False]*sw for _ in range(sh)]\n    for sr in range(sh):\n        for sc in range(sw):\n            if (r1+sr*2, c1+sc*2) in cell_set:\n                template[sr][sc] = True\n    \n    # Find which small object matches the template shape\n    for color, cells in small_objs:\n        pat = get_pattern(color, cells, bg)\n        h,w = len(pat), len(pat[0])\n        if h==sh and w==sw:\n            match = True\n            for r in range(h):\n                for c in range(w):\n                    filled = pat[r][c]!=bg\n                    if filled != template[r][c]:\n                        match = False\n                        break\n                if not match: break\n            if match:\n                # The other small object is the answer\n                for c2, cells2 in small_objs:\n                    if cells2 is not cells:\n                        return get_pattern(c2, cells2, bg)\n    \n    # If no match with scaled, try the other way\n    for color, cells in small_objs:\n        pat = get_pattern(color, cells, bg)\n        h,w = len(pat), len(pat[0])\n        if h!=sh or w!=sw:\n            continue\n        # just return the other one\n    \n    for c2, cells2 in small_objs:\n        return get_pattern(c2, cells2, bg)",
