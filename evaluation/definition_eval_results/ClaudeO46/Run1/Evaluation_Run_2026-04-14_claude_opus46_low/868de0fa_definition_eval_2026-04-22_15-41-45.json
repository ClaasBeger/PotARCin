  "raw_response": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    rects = []\n    for r in range(rows):\n        for c in range(cols):\n            if g[r][c] == 1 and not visited[r][c]:\n                # Find rectangle of 1s border\n                # Find bottom-right corner\n                c2 = c\n                while c2+1 < cols and g[r][c2+1] == 1:\n                    c2 += 1\n                r2 = r\n                while r2+1 < rows and g[r2+1][c] == 1:\n                    r2 += 1\n                # Verify it's a rectangle border\n                if r2 > r and c2 > c and g[r2][c2] == 1 and g[r][c2] == 1 and g[r2][c] == 1:\n                    # Check all borders are 1 and interior is 0\n                    valid = True\n                    for cc in range(c, c2+1):\n                        if g[r][cc] != 1 or g[r2][cc] != 1:\n                            valid = False\n                    for rr in range(r, r2+1):\n                        if g[rr][c] != 1 or g[rr][c2] != 1:\n                            valid = False\n                    for rr in range(r+1, r2):\n                        for cc in range(c+1, c2):\n                            if g[rr][cc] != 0:\n                                valid = False\n                    if valid:\n                        rects.append((r, c, r2, c2))\n                        for rr in range(r, r2+1):\n                            for cc in range(c, c2+1):\n                                visited[rr][cc] = True\n    \n    # Sort by interior area, fill odd-sized with 7, even with 2... \n    # Looking at pattern: smallest interior gets 7, largest gets 2? No.\n    # Actually: odd interior area -> 7, even -> 2? Let me check.\n    # Ex1: 2x2=4->2, 1x1=1->7, 3x3=9->7. Hmm.\n    # Let me think differently. Smaller area -> 7, larger -> 2? \n    # 1->7, 4->2, 9->7. No.\n    # Odd area -> 7, even area -> 2. Yes! 1->7, 4->2, 9->7. Checks out for all examples.\n    \n    for (r1, c1, r2, c2) in rects:\n        ih = r2 - r1 - 1\n        iw = c2 - c1 - 1\n        area = ih * iw\n        fill = 7 if area % 2 == 1 else 2\n        for rr in range(r1+1, r2):\n            for cc in range(c1+1, c2):\n                g[rr][cc] = fill\n    \n    return g",
  "script": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    visited = [[False]*cols for _ in range(rows)]\n    \n    rects = []\n    for r in range(rows):\n        for c in range(cols):\n            if g[r][c] == 1 and not visited[r][c]:\n                # Find rectangle of 1s border\n                # Find bottom-right corner\n                c2 = c\n                while c2+1 < cols and g[r][c2+1] == 1:\n                    c2 += 1\n                r2 = r\n                while r2+1 < rows and g[r2+1][c] == 1:\n                    r2 += 1\n                # Verify it's a rectangle border\n                if r2 > r and c2 > c and g[r2][c2] == 1 and g[r][c2] == 1 and g[r2][c] == 1:\n                    # Check all borders are 1 and interior is 0\n                    valid = True\n                    for cc in range(c, c2+1):\n                        if g[r][cc] != 1 or g[r2][cc] != 1:\n                            valid = False\n                    for rr in range(r, r2+1):\n                        if g[rr][c] != 1 or g[rr][c2] != 1:\n                            valid = False\n                    for rr in range(r+1, r2):\n                        for cc in range(c+1, c2):\n                            if g[rr][cc] != 0:\n                                valid = False\n                    if valid:\n                        rects.append((r, c, r2, c2))\n                        for rr in range(r, r2+1):\n                            for cc in range(c, c2+1):\n                                visited[rr][cc] = True\n    \n    # Sort by interior area, fill odd-sized with 7, even with 2... \n    # Looking at pattern: smallest interior gets 7, largest gets 2? No.\n    # Actually: odd interior area -> 7, even -> 2? Let me check.\n    # Ex1: 2x2=4->2, 1x1=1->7, 3x3=9->7. Hmm.\n    # Let me think differently. Smaller area -> 7, larger -> 2? \n    # 1->7, 4->2, 9->7. No.\n    # Odd area -> 7, even area -> 2. Yes! 1->7, 4->2, 9->7. Checks out for all examples.\n    \n    for (r1, c1, r2, c2) in rects:\n        ih = r2 - r1 - 1\n        iw = c2 - c1 - 1\n        area = ih * iw\n        fill = 7 if area % 2 == 1 else 2\n        for rr in range(r1+1, r2):\n            for cc in range(c1+1, c2):\n                g[rr][cc] = fill\n    \n    return g",
