            if valid:\n                # Check we can reconstruct zeros\n                result = []\n                for r in range(min_r, max_r + 1):\n                    row = []\n                    for c in range(min_c, max_c + 1):\n                        # Find equivalent non-zero cell\n                        val = None\n                        for mr in range(rows):\n                            if mr % pr == r % pr:\n                                for mc in range(cols):\n                                    if mc % pc == c % pc and grid[mr][mc] != 0:\n                                        val = grid[mr][mc]\n                                        break\n                                if val is not None:\n                                    break\n                        row.append(val)\n                    result.append(row)\n                return result\n    \n    return result",
