  "raw_response": "def solve(grid):\n    row = grid[0]\n    n = len(row)\n    nonzero = [(i,v) for i,v in enumerate(row) if v]\n    size = n * max((i for i,v in nonzero), default=0) if nonzero else n\n    # Output is n*max_nonzero_index square, with diagonal pattern\n    max_idx = max(i for i,v in nonzero)\n    N = n * max_idx\n    out = [[0]*N for _ in range(N)]\n    for r in range(N):\n        for i,v in nonzero:\n            c = N - 1 - r + i\n            if 0 <= c < N:\n                out[r][c] = v\n    return out",
