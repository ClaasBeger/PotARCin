  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find horizontal and vertical lines of 4s\n    hlines = [r for r in range(rows) if all(grid[r][c] == 4 for c in range(cols))]\n    vlines = [c for c in range(cols) if all(grid[r][c] == 4 for r in range(rows))]\n    \n    # Define quadrant boundaries\n    row_bounds = [-1] + hlines + [rows]\n    col_bounds = [-1] + vlines + [cols]\n    \n    # Find the non-empty quadrant\n    source = None\n    for i in range(len(row_bounds)-1):\n        for j in range(len(col_bounds)-1):\n            r0, r1 = row_bounds[i]+1, row_bounds[i+1]\n            c0, c1 = col_bounds[j]+1, col_bounds[j+1]\n            has_content = any(grid[r][c] != 0 for r in range(r0, r1) for c in range(c0, c1))\n            if has_content:\n                source = (r0, r1, c0, c1, i, j)\n    \n    if source is None:\n        return grid\n    \n    sr0, sr1, sc0, sc1, si, sj = source\n    \n    result = [row[:] for row in grid]\n    \n    for i in range(len(row_bounds)-1):\n        for j in range(len(col_bounds)-1):\n            r0, r1 = row_bounds[i]+1, row_bounds[i+1]\n            c0, c1 = col_bounds[j]+1, col_bounds[j+1]\n            if (r1-r0) == (sr1-sr0) and (c1-c0) == (sc1-sc0):\n                for dr in range(sr1-sr0):\n                    for dc in range(sc1-sc0):\n                        result[r0+dr][c0+dc] = grid[sr0+dr][sc0+dc]\n    \n    return result",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find horizontal and vertical lines of 4s\n    hlines = [r for r in range(rows) if all(grid[r][c] == 4 for c in range(cols))]\n    vlines = [c for c in range(cols) if all(grid[r][c] == 4 for r in range(rows))]\n    \n    # Define quadrant boundaries\n    row_bounds = [-1] + hlines + [rows]\n    col_bounds = [-1] + vlines + [cols]\n    \n    # Find the non-empty quadrant\n    source = None\n    for i in range(len(row_bounds)-1):\n        for j in range(len(col_bounds)-1):\n            r0, r1 = row_bounds[i]+1, row_bounds[i+1]\n            c0, c1 = col_bounds[j]+1, col_bounds[j+1]\n            has_content = any(grid[r][c] != 0 for r in range(r0, r1) for c in range(c0, c1))\n            if has_content:\n                source = (r0, r1, c0, c1, i, j)\n    \n    if source is None:\n        return grid\n    \n    sr0, sr1, sc0, sc1, si, sj = source\n    \n    result = [row[:] for row in grid]\n    \n    for i in range(len(row_bounds)-1):\n        for j in range(len(col_bounds)-1):\n            r0, r1 = row_bounds[i]+1, row_bounds[i+1]\n            c0, c1 = col_bounds[j]+1, col_bounds[j+1]\n            if (r1-r0) == (sr1-sr0) and (c1-c0) == (sc1-sc0):\n                for dr in range(sr1-sr0):\n                    for dc in range(sc1-sc0):\n                        result[r0+dr][c0+dc] = grid[sr0+dr][sc0+dc]\n    \n    return result",
