  "raw_response": "def solve(grid):\n    import copy\n    g = copy.deepcopy(grid)\n    rows, cols = len(g), len(g[0])\n    \n    # Find vertical line columns (non-zero, non-background in most rows)\n    # Find horizontal line rows\n    # At intersection, the minority band yields to majority band\n    \n    # Count per column how many rows have a consistent non-zero value\n    col_vals = {}\n    for c in range(cols):\n        vals = [g[r][c] for r in range(rows) if g[r][c] != 0]\n        if vals:\n            from collections import Counter\n            cnt = Counter(vals)\n            most = cnt.most_common(1)[0]\n            col_vals[c] = (most[0], most[1])\n    \n    row_vals = {}\n    for r in range(rows):\n        vals = [g[r][c] for c in range(cols) if g[r][c] != 0]\n        if vals:\n            from collections import Counter\n            cnt = Counter(vals)\n            most = cnt.most_common(1)[0]\n            row_vals[r] = (most[0], most[1])\n    \n    # Identify vertical band: columns where the dominant value appears in most rows\n    vert_cols = {}\n    for c, (v, count) in col_vals.items():\n        if count >= rows - 3:  # appears in almost all rows\n            vert_cols[c] = v\n    \n    horiz_rows = {}\n    for r, (v, count) in row_vals.items():\n        if count >= cols - 3:\n            horiz_rows[r] = v\n    \n    # Determine which is thicker/more numerous\n    vert_span = len(vert_cols)\n    horiz_span = len(horiz_rows)\n    \n    # Count total cells: vertical band covers vert_span * rows, horizontal covers horiz_span * cols\n    vert_size = vert_span * (rows - horiz_span)\n    horiz_size = horiz_span * (cols - vert_span)\n    \n    # The larger one wins at intersection\n    if vert_size >= horiz_size:\n        # Vertical wins - at intersection, use vertical value\n        for r in horiz_rows:\n            for c in vert_cols:\n                g[r][c] = vert_cols[c]\n    else:\n        # Horizontal wins\n        for r in horiz_rows:\n            for c in vert_cols:\n                g[r][c] = horiz_rows[r]\n    \n    return g",
