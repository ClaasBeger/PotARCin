  "raw_response": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    \n    # Find 3s bounding box (center)\n    r3, c3 = np.where(g == 3)\n    cr_min, cr_max = r3.min(), r3.max()\n    cc_min, cc_max = c3.min(), c3.max()\n    # Center of 3s block\n    cy = (cr_min + cr_max) / 2.0\n    cx = (cc_min + cc_max) / 2.0\n    \n    # Find 2s\n    r2, c2 = np.where(g == 2)\n    \n    out = g.copy()\n    \n    # Reflect 2s in 4 quadrants around the 3-center\n    for r, c in zip(r2, c2):\n        # Mirror horizontally\n        mr = int(2 * cy - r)\n        mc = c\n        if 0 <= mr < rows and 0 <= mc < cols:\n            out[mr][mc] = 2\n        # Mirror vertically\n        mr = r\n        mc = int(2 * cx - c)\n        if 0 <= mr < rows and 0 <= mc < cols:\n            out[mr][mc] = 2\n        # Mirror both\n        mr = int(2 * cy - r)\n        mc = int(2 * cx - c)\n        if 0 <= mr < rows and 0 <= mc < cols:\n            out[mr][mc] = 2\n    \n    return out.tolist()",
  "script": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    rows, cols = g.shape\n    \n    # Find 3s bounding box (center)\n    r3, c3 = np.where(g == 3)\n    cr_min, cr_max = r3.min(), r3.max()\n    cc_min, cc_max = c3.min(), c3.max()\n    # Center of 3s block\n    cy = (cr_min + cr_max) / 2.0\n    cx = (cc_min + cc_max) / 2.0\n    \n    # Find 2s\n    r2, c2 = np.where(g == 2)\n    \n    out = g.copy()\n    \n    # Reflect 2s in 4 quadrants around the 3-center\n    for r, c in zip(r2, c2):\n        # Mirror horizontally\n        mr = int(2 * cy - r)\n        mc = c\n        if 0 <= mr < rows and 0 <= mc < cols:\n            out[mr][mc] = 2\n        # Mirror vertically\n        mr = r\n        mc = int(2 * cx - c)\n        if 0 <= mr < rows and 0 <= mc < cols:\n            out[mr][mc] = 2\n        # Mirror both\n        mr = int(2 * cy - r)\n        mc = int(2 * cx - c)\n        if 0 <= mr < rows and 0 <= mc < cols:\n            out[mr][mc] = 2\n    \n    return out.tolist()",
