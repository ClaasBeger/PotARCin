  "raw_response": "def solve(grid):\n    # Find the small pattern made of a unique color (not 0 and not the scattered colors)\n    from collections import Counter\n    \n    counts = Counter()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                counts[v] += 1\n    \n    # Find connected components for each color to identify the pattern\n    # The pattern color forms a compact cluster\n    import numpy as np\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # For each non-zero color, find bounding box of all occurrences\n    # The pattern should have a small bounding box with high density\n    color_positions = {}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0:\n                if v not in color_positions:\n                    color_positions[v] = []\n                color_positions[v].append((r, c))\n    \n    best_color = None\n    best_score = -1\n    \n    for color, positions in color_positions.items():\n        rs = [p[0] for p in positions]\n        cs = [p[1] for p in positions]\n        h = max(rs) - min(rs) + 1\n        w = max(cs) - min(cs) + 1\n        area = h * w\n        density = len(positions) / area\n        # Pattern: small bounding box, high density\n        if area <= 30 and density > 0.4 and len(positions) >= 3:\n            if density > best_score:\n                best_score = density\n                best_color = color\n    \n    positions = color_positions[best_color]\n    rs = [p[0] for p in positions]\n    cs = [p[1] for p in positions]\n    min_r, max_r = min(rs), max(rs)\n    min_c, max_c = min(cs), max(cs)\n    \n    result = []\n    for r in range(min_r, max_r + 1):\n        row = []\n        for c in range(min_c, max_c + 1):\n            row.append(grid[r][c])\n        result.append(row)\n    \n    return result",
  "script": "def solve(grid):\n    # Find the small pattern made of a unique color (not 0 and not the scattered colors)\n    from collections import Counter\n    \n    counts = Counter()\n    for row in grid:\n        for v in row:\n            if v != 0:\n                counts[v] += 1\n    \n    # Find connected components for each color to identify the pattern\n    # The pattern color forms a compact cluster\n    import numpy as np\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # For each non-zero color, find bounding box of all occurrences\n    # The pattern should have a small bounding box with high density\n    color_positions = {}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0:\n                if v not in color_positions:\n                    color_positions[v] = []\n                color_positions[v].append((r, c))\n    \n    best_color = None\n    best_score = -1\n    \n    for color, positions in color_positions.items():\n        rs = [p[0] for p in positions]\n        cs = [p[1] for p in positions]\n        h = max(rs) - min(rs) + 1\n        w = max(cs) - min(cs) + 1\n        area = h * w\n        density = len(positions) / area\n        # Pattern: small bounding box, high density\n        if area <= 30 and density > 0.4 and len(positions) >= 3:\n            if density > best_score:\n                best_score = density\n                best_color = color\n    \n    positions = color_positions[best_color]\n    rs = [p[0] for p in positions]\n    cs = [p[1] for p in positions]\n    min_r, max_r = min(rs), max(rs)\n    min_c, max_c = min(cs), max(cs)\n    \n    result = []\n    for r in range(min_r, max_r + 1):\n        row = []\n        for c in range(min_c, max_c + 1):\n            row.append(grid[r][c])\n        result.append(row)\n    \n    return result",
