  "raw_response": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    \n    # Find rectangle (2s)\n    twos = np.argwhere(g == 2)\n    r1, c1 = twos.min(axis=0)\n    r2, c2 = twos.max(axis=0)\n    inner_h = r2 - r1 - 1\n    inner_w = c2 - c1 - 1\n    \n    # Find pattern (non-zero, non-2)\n    mask = (g != 0) & (g != 2)\n    pts = np.argwhere(mask)\n    pr1, pc1 = pts.min(axis=0)\n    pr2, pc2 = pts.max(axis=0)\n    pat = g[pr1:pr2+1, pc1:pc2+1]\n    color = g[mask][0]\n    \n    ph, pw = pat.shape\n    # Scale factor: inner_h / ph and inner_w / pw\n    sh = inner_h // ph\n    sw = inner_w // pw\n    \n    # Build output\n    out = np.full((r2-r1+1, c2-c1+1), 0)\n    # Border\n    out[0, :] = 2\n    out[-1, :] = 2\n    out[:, 0] = 2\n    out[:, -1] = 2\n    \n    # Fill inner with scaled pattern\n    for i in range(ph):\n        for j in range(pw):\n            if pat[i, j] != 0:\n                out[1+i*sh:1+(i+1)*sh, 1+j*sw:1+(j+1)*sw] = color\n    \n    return out.tolist()",
  "script": "def solve(grid):\n    import numpy as np\n    g = np.array(grid)\n    \n    # Find rectangle (2s)\n    twos = np.argwhere(g == 2)\n    r1, c1 = twos.min(axis=0)\n    r2, c2 = twos.max(axis=0)\n    inner_h = r2 - r1 - 1\n    inner_w = c2 - c1 - 1\n    \n    # Find pattern (non-zero, non-2)\n    mask = (g != 0) & (g != 2)\n    pts = np.argwhere(mask)\n    pr1, pc1 = pts.min(axis=0)\n    pr2, pc2 = pts.max(axis=0)\n    pat = g[pr1:pr2+1, pc1:pc2+1]\n    color = g[mask][0]\n    \n    ph, pw = pat.shape\n    # Scale factor: inner_h / ph and inner_w / pw\n    sh = inner_h // ph\n    sw = inner_w // pw\n    \n    # Build output\n    out = np.full((r2-r1+1, c2-c1+1), 0)\n    # Border\n    out[0, :] = 2\n    out[-1, :] = 2\n    out[:, 0] = 2\n    out[:, -1] = 2\n    \n    # Fill inner with scaled pattern\n    for i in range(ph):\n        for j in range(pw):\n            if pat[i, j] != 0:\n                out[1+i*sh:1+(i+1)*sh, 1+j*sw:1+(j+1)*sw] = color\n    \n    return out.tolist()",
