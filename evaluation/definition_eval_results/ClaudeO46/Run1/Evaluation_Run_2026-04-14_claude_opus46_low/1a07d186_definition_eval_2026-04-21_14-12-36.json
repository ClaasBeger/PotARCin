  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find full lines (horizontal or vertical) - these are the \"walls\"\n    # A full line is a row or column entirely filled with one non-zero color\n    \n    h_lines = {}  # row_idx -> color\n    for r in range(rows):\n        vals = [v for v in grid[r] if v != 0]\n        if len(vals) == cols and len(set(vals)) == 1:\n            h_lines[r] = vals[0]\n    \n    v_lines = {}  # col_idx -> color\n    for c in range(cols):\n        col_vals = [grid[r][c] for r in range(rows)]\n        vals = [v for v in col_vals if v != 0]\n        if len(vals) == rows and len(set(vals)) == 1:\n            v_lines[c] = vals[0]\n    \n    # Find stray points (non-zero cells not on a wall line)\n    stray = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and r not in h_lines and c not in v_lines:\n                stray.append((r, c, grid[r][c]))\n    \n    # Create output: start with just the wall lines\n    out = [[0]*cols for _ in range(rows)]\n    for r in h_lines:\n        for c in range(cols):\n            out[r][c] = h_lines[r]\n    for c in v_lines:\n        for r in range(rows):\n            out[r][c] = v_lines[c]\n    \n    # For each stray point, find the nearest wall of matching color and move it adjacent\n    for r, c, color in stray:\n        # Find nearest wall line of same color\n        best_dist = float('inf')\n        best_pos = None\n        \n        # Check vertical lines\n        for vc, vc_color in v_lines.items():\n            if vc_color == color:\n                dist = abs(c - vc)\n                if dist < best_dist and dist > 0:\n                    best_dist = dist\n                    # Place adjacent: one step from wall toward the point\n                    if c > vc:\n                        best_pos = (r, vc + 1)\n                    else:\n                        best_pos = (r, vc - 1)\n        \n        # Check horizontal lines\n        for hr, hr_color in h_lines.items():\n            if hr_color == color:\n                dist = abs(r - hr)\n                if dist < best_dist and dist > 0:\n                    best_dist = dist\n                    if r > hr:\n                        best_pos = (hr + 1, c)\n                    else:\n                        best_pos = (hr - 1, c)\n        \n        if best_pos:\n            out[best_pos[0]][best_pos[1]] = color\n    \n    return out",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Find full lines (horizontal or vertical) - these are the \"walls\"\n    # A full line is a row or column entirely filled with one non-zero color\n    \n    h_lines = {}  # row_idx -> color\n    for r in range(rows):\n        vals = [v for v in grid[r] if v != 0]\n        if len(vals) == cols and len(set(vals)) == 1:\n            h_lines[r] = vals[0]\n    \n    v_lines = {}  # col_idx -> color\n    for c in range(cols):\n        col_vals = [grid[r][c] for r in range(rows)]\n        vals = [v for v in col_vals if v != 0]\n        if len(vals) == rows and len(set(vals)) == 1:\n            v_lines[c] = vals[0]\n    \n    # Find stray points (non-zero cells not on a wall line)\n    stray = []\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0 and r not in h_lines and c not in v_lines:\n                stray.append((r, c, grid[r][c]))\n    \n    # Create output: start with just the wall lines\n    out = [[0]*cols for _ in range(rows)]\n    for r in h_lines:\n        for c in range(cols):\n            out[r][c] = h_lines[r]\n    for c in v_lines:\n        for r in range(rows):\n            out[r][c] = v_lines[c]\n    \n    # For each stray point, find the nearest wall of matching color and move it adjacent\n    for r, c, color in stray:\n        # Find nearest wall line of same color\n        best_dist = float('inf')\n        best_pos = None\n        \n        # Check vertical lines\n        for vc, vc_color in v_lines.items():\n            if vc_color == color:\n                dist = abs(c - vc)\n                if dist < best_dist and dist > 0:\n                    best_dist = dist\n                    # Place adjacent: one step from wall toward the point\n                    if c > vc:\n                        best_pos = (r, vc + 1)\n                    else:\n                        best_pos = (r, vc - 1)\n        \n        # Check horizontal lines\n        for hr, hr_color in h_lines.items():\n            if hr_color == color:\n                dist = abs(r - hr)\n                if dist < best_dist and dist > 0:\n                    best_dist = dist\n                    if r > hr:\n                        best_pos = (hr + 1, c)\n                    else:\n                        best_pos = (hr - 1, c)\n        \n        if best_pos:\n            out[best_pos[0]][best_pos[1]] = color\n    \n    return out",
