  "raw_response": "def solve(grid):\n    n = len(grid)\n    # deep copy to avoid modifying input\n    out = [row[:] for row in grid]\n    top_left = grid[0][0]\n\n    # 1) copy non\u2011zero symmetric values\n    for i in range(n):\n        for j in range(i + 1, n):\n            if out[i][j] == 0 and out[j][i] != 0:\n                out[i][j] = out[j][i]\n            elif out[j][i] == 0 and out[i][j] != 0:\n                out[j][i] = out[i][j]\n\n    # 2) fill diagonal zeros with the top\u2011left element\n    for i in range(n):\n        if out[i][i] == 0:\n            out[i][i] = top_left\n\n    # 3) remaining zeros (both off\u2011diagonal positions are zero)\n    #    fill with the most frequent non\u2011zero value in the union of its row and column\n    for i in range(n):\n        for j in range(i + 1, n):\n            if out[i][j] == 0 and out[j][i] == 0:\n                counts = {}\n                # row i\n                for v in out[i]:\n                    if v != 0:\n                        counts[v] = counts.get(v, 0) + 1\n                # column j\n                for row in out:\n                    v = row[j]\n                    if v != 0:\n                        counts[v] = counts.get(v, 0) + 1\n                # choose the most common, fallback to top_left\n                if counts:\n                    most = max(counts, key=counts.get)\n                else:\n                    most = top_left\n                out[i][j] = most\n                out[j][i] = most\n\n    return out",
  "script": "def solve(grid):\n    n = len(grid)\n    # deep copy to avoid modifying input\n    out = [row[:] for row in grid]\n    top_left = grid[0][0]\n\n    # 1) copy non\u2011zero symmetric values\n    for i in range(n):\n        for j in range(i + 1, n):\n            if out[i][j] == 0 and out[j][i] != 0:\n                out[i][j] = out[j][i]\n            elif out[j][i] == 0 and out[i][j] != 0:\n                out[j][i] = out[i][j]\n\n    # 2) fill diagonal zeros with the top\u2011left element\n    for i in range(n):\n        if out[i][i] == 0:\n            out[i][i] = top_left\n\n    # 3) remaining zeros (both off\u2011diagonal positions are zero)\n    #    fill with the most frequent non\u2011zero value in the union of its row and column\n    for i in range(n):\n        for j in range(i + 1, n):\n            if out[i][j] == 0 and out[j][i] == 0:\n                counts = {}\n                # row i\n                for v in out[i]:\n                    if v != 0:\n                        counts[v] = counts.get(v, 0) + 1\n                # column j\n                for row in out:\n                    v = row[j]\n                    if v != 0:\n                        counts[v] = counts.get(v, 0) + 1\n                # choose the most common, fallback to top_left\n                if counts:\n                    most = max(counts, key=counts.get)\n                else:\n                    most = top_left\n                out[i][j] = most\n                out[j][i] = most\n\n    return out",
