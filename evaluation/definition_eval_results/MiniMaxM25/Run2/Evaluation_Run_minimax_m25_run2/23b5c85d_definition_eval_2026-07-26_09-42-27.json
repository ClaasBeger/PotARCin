  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n\n    h = len(grid)\n    w = len(grid[0]) if grid[0] else 0\n    visited = [[False] * w for _ in range(h)]\n\n    from collections import deque\n    best_bounds = None\n    best_area = float('inf')\n\n    for i in range(h):\n        for j in range(w):\n            val = grid[i][j]\n            if val != 0 and not visited[i][j]:\n                # BFS to collect the component\n                q = deque()\n                q.append((i, j))\n                visited[i][j] = True\n\n                min_r, max_r = i, i\n                min_c, max_c = j, j\n                area = 0\n\n                while q:\n                    r, c = q.popleft()\n                    area += 1\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n                    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                        nr, nc = r + dr, c + dc\n                        if 0 <= nr < h and 0 <= nc < w:\n                            if not visited[nr][nc] and grid[nr][nc] == val:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n\n                if area < best_area:\n                    best_area = area\n                    best_bounds = (min_r, max_r, min_c, max_c)\n\n    if best_bounds is None:\n        return []\n\n    min_r, max_r, min_c, max_c = best_bounds\n    result = []\n    for r in range(min_r, max_r + 1):\n        row = [grid[r][c] for c in range(min_c, max_c + 1)]\n        result.append(row)\n\n    return result",
  "script": "def solve(grid):\n    if not grid:\n        return []\n\n    h = len(grid)\n    w = len(grid[0]) if grid[0] else 0\n    visited = [[False] * w for _ in range(h)]\n\n    from collections import deque\n    best_bounds = None\n    best_area = float('inf')\n\n    for i in range(h):\n        for j in range(w):\n            val = grid[i][j]\n            if val != 0 and not visited[i][j]:\n                # BFS to collect the component\n                q = deque()\n                q.append((i, j))\n                visited[i][j] = True\n\n                min_r, max_r = i, i\n                min_c, max_c = j, j\n                area = 0\n\n                while q:\n                    r, c = q.popleft()\n                    area += 1\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n                    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n                        nr, nc = r + dr, c + dc\n                        if 0 <= nr < h and 0 <= nc < w:\n                            if not visited[nr][nc] and grid[nr][nc] == val:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n\n                if area < best_area:\n                    best_area = area\n                    best_bounds = (min_r, max_r, min_c, max_c)\n\n    if best_bounds is None:\n        return []\n\n    min_r, max_r, min_c, max_c = best_bounds\n    result = []\n    for r in range(min_r, max_r + 1):\n        row = [grid[r][c] for c in range(min_c, max_c + 1)]\n        result.append(row)\n\n    return result",
