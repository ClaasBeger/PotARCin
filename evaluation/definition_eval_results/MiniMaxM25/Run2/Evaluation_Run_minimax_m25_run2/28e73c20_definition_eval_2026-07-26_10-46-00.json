  "raw_response": "def solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    # create output filled with 3 (wall)\n    out = [[3] * cols for _ in range(rows)]\n\n    # need at least a border to draw the spiral\n    if rows < 2 or cols < 2:\n        return out\n\n    # start position \u2013 entrance at (1,0)\n    r, c = 1, 0\n    visited = {(r, c)}\n    out[r][c] = 0\n\n    # directions in clockwise order: right, down, left, up\n    dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    dir_idx = 0\n\n    while True:\n        moved = False\n        # try up to four directions (turning right each time)\n        for _ in range(4):\n            dr, dc = dirs[dir_idx]\n            nr, nc = r + dr, c + dc\n\n            # must stay inside the interior (not on the outer border)\n            if not (0 < nr < rows - 1 and 0 < nc < cols - 1):\n                dir_idx = (dir_idx + 1) % 4\n                continue\n            # cell must not be already part of the path\n            if (nr, nc) in visited:\n                dir_idx = (dir_idx + 1) % 4\n                continue\n\n            # adjacency rule: cannot be orthogonally adjacent to any visited cell\n            # except the cell we are moving from\n            adj_ok = True\n            for ar, ac in ((nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)):\n                if (ar, ac) == (r, c):\n                    continue\n                if (ar, ac) in visited:\n                    adj_ok = False\n                    break\n            if not adj_ok:\n                dir_idx = (dir_idx + 1) % 4\n                continue\n\n            # \"beyond\" rule: the cell two steps ahead in the current direction\n            # must not already be visited\n            br, bc = r + 2 * dr, c + 2 * dc\n            if 0 <= br < rows and 0 <= bc < cols and (br, bc) in visited:\n                dir_idx = (dir_idx + 1) % 4\n                continue\n\n            # all checks passed \u2013 move to the new cell\n            r, c = nr, nc\n            visited.add((r, c))\n            out[r][c] = 0\n            moved = True\n            break\n        if not moved:\n            break\n\n    return out",
  "script": "def solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    # create output filled with 3 (wall)\n    out = [[3] * cols for _ in range(rows)]\n\n    # need at least a border to draw the spiral\n    if rows < 2 or cols < 2:\n        return out\n\n    # start position \u2013 entrance at (1,0)\n    r, c = 1, 0\n    visited = {(r, c)}\n    out[r][c] = 0\n\n    # directions in clockwise order: right, down, left, up\n    dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    dir_idx = 0\n\n    while True:\n        moved = False\n        # try up to four directions (turning right each time)\n        for _ in range(4):\n            dr, dc = dirs[dir_idx]\n            nr, nc = r + dr, c + dc\n\n            # must stay inside the interior (not on the outer border)\n            if not (0 < nr < rows - 1 and 0 < nc < cols - 1):\n                dir_idx = (dir_idx + 1) % 4\n                continue\n            # cell must not be already part of the path\n            if (nr, nc) in visited:\n                dir_idx = (dir_idx + 1) % 4\n                continue\n\n            # adjacency rule: cannot be orthogonally adjacent to any visited cell\n            # except the cell we are moving from\n            adj_ok = True\n            for ar, ac in ((nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)):\n                if (ar, ac) == (r, c):\n                    continue\n                if (ar, ac) in visited:\n                    adj_ok = False\n                    break\n            if not adj_ok:\n                dir_idx = (dir_idx + 1) % 4\n                continue\n\n            # \"beyond\" rule: the cell two steps ahead in the current direction\n            # must not already be visited\n            br, bc = r + 2 * dr, c + 2 * dc\n            if 0 <= br < rows and 0 <= bc < cols and (br, bc) in visited:\n                dir_idx = (dir_idx + 1) % 4\n                continue\n\n            # all checks passed \u2013 move to the new cell\n            r, c = nr, nc\n            visited.add((r, c))\n            out[r][c] = 0\n            moved = True\n            break\n        if not moved:\n            break\n\n    return out",
