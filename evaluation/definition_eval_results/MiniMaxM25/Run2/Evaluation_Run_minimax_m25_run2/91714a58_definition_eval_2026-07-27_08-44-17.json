  "raw_response": "def solve(grid):\n    \"\"\"\n    Given a 2D list of ints, returns a new grid where the largest\n    axis\u2011aligned rectangle consisting of a single non\u2011zero value is kept\n    unchanged and all other cells are set to 0.\n    \"\"\"\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    best_area = 0\n    best_val = 0\n    best_rect = None  # (r1, c1, r2, c2)\n\n    # Enumerate all possible rectangles\n    for r1 in range(rows):\n        for c1 in range(cols):\n            val = grid[r1][c1]\n            if val == 0:\n                continue\n            for r2 in range(r1, rows):\n                for c2 in range(c1, cols):\n                    h = r2 - r1 + 1\n                    w = c2 - c1 + 1\n                    area = h * w\n                    if area <= best_area:\n                        # No need to check smaller or equal areas\n                        continue\n                    # Check if all cells in this rectangle equal `val`\n                    ok = True\n                    for i in range(r1, r2 + 1):\n                        row = grid[i]\n                        for j in range(c1, c2 + 1):\n                            if row[j] != val:\n                                ok = False\n                                break\n                        if not ok:\n                            break\n                    if ok:\n                        best_area = area\n                        best_val = val\n                        best_rect = (r1, c1, r2, c2)\n\n    # If no non\u2011zero rectangle was found (should not happen for given tasks), return all zeros\n    if best_rect is None:\n        return [[0] * cols for _ in range(rows)]\n\n    r1, c1, r2, c2 = best_rect\n\n    # Build output grid\n    out = [[0] * cols for _ in range(rows)]\n    for i in range(r1, r2 + 1):\n        for j in range(c1, c2 + 1):\n            out[i][j] = best_val\n\n    return out",
  "script": "def solve(grid):\n    \"\"\"\n    Given a 2D list of ints, returns a new grid where the largest\n    axis\u2011aligned rectangle consisting of a single non\u2011zero value is kept\n    unchanged and all other cells are set to 0.\n    \"\"\"\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    best_area = 0\n    best_val = 0\n    best_rect = None  # (r1, c1, r2, c2)\n\n    # Enumerate all possible rectangles\n    for r1 in range(rows):\n        for c1 in range(cols):\n            val = grid[r1][c1]\n            if val == 0:\n                continue\n            for r2 in range(r1, rows):\n                for c2 in range(c1, cols):\n                    h = r2 - r1 + 1\n                    w = c2 - c1 + 1\n                    area = h * w\n                    if area <= best_area:\n                        # No need to check smaller or equal areas\n                        continue\n                    # Check if all cells in this rectangle equal `val`\n                    ok = True\n                    for i in range(r1, r2 + 1):\n                        row = grid[i]\n                        for j in range(c1, c2 + 1):\n                            if row[j] != val:\n                                ok = False\n                                break\n                        if not ok:\n                            break\n                    if ok:\n                        best_area = area\n                        best_val = val\n                        best_rect = (r1, c1, r2, c2)\n\n    # If no non\u2011zero rectangle was found (should not happen for given tasks), return all zeros\n    if best_rect is None:\n        return [[0] * cols for _ in range(rows)]\n\n    r1, c1, r2, c2 = best_rect\n\n    # Build output grid\n    out = [[0] * cols for _ in range(rows)]\n    for i in range(r1, r2 + 1):\n        for j in range(c1, c2 + 1):\n            out[i][j] = best_val\n\n    return out",
