0 0 0 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    # Find the separator row: a full row of the same non\u2011zero value\n    sep_row = -1\n    sep_val = None\n    for i, row in enumerate(grid):\n        if not row:\n            continue\n        first = row[0]\n        if first != 0 and all(cell == first for cell in row):\n            sep_row = i\n            sep_val = first\n            break\n\n    # If no separator row is found, return a deep copy of the input\n    if sep_row == -1:\n        return [row[:] for row in grid]\n\n    shift = sep_row + 1\n    # Create a deep copy that we will modify\n    new_grid = [row[:] for row in grid]\n    nrows = len(grid)\n\n    # Move every non\u2011zero cell below the separator up by `shift` rows\n    for r in range(sep_row + 1, nrows):\n        for c, val in enumerate(grid[r]):\n            if val != 0 and val != sep_val:\n                new_r = r - shift\n                new_grid[new_r][c] = val   # place it in the upper part\n                new_grid[r][c] = 0         # clear the original position\n\n    return new_grid",
  "script": "def solve(grid):\n    # Find the separator row: a full row of the same non\u2011zero value\n    sep_row = -1\n    sep_val = None\n    for i, row in enumerate(grid):\n        if not row:\n            continue\n        first = row[0]\n        if first != 0 and all(cell == first for cell in row):\n            sep_row = i\n            sep_val = first\n            break\n\n    # If no separator row is found, return a deep copy of the input\n    if sep_row == -1:\n        return [row[:] for row in grid]\n\n    shift = sep_row + 1\n    # Create a deep copy that we will modify\n    new_grid = [row[:] for row in grid]\n    nrows = len(grid)\n\n    # Move every non\u2011zero cell below the separator up by `shift` rows\n    for r in range(sep_row + 1, nrows):\n        for c, val in enumerate(grid[r]):\n            if val != 0 and val != sep_val:\n                new_r = r - shift\n                new_grid[new_r][c] = val   # place it in the upper part\n                new_grid[r][c] = 0         # clear the original position\n\n    return new_grid",
