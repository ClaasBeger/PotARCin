o tr, at target column tc\n                if cur_r != tr:\n                    step_r = 1 if tr > cur_r else -1\n                    r = cur_r + step_r\n                    while r != tr:\n                        if grid[r][tc] != 0:\n                            # skip obstacle\n                            r += step_r\n                            continue\n                        new_cells.append((r, tc))\n                        r += step_r\n            else:\n                # vertical first\n                if sr == tr:\n                    continue\n                step_r = 1 if tr > sr else -1\n                cur_r = sr + step_r\n                while cur_r != tr + step_r:\n                    if grid[cur_r][sc] != 0:\n                        break\n                    new_cells.append((cur_r, sc))\n                    cur_r += step_r\n                if cur_r == tr + step_r:\n                    cur_r, cur_c = tr, sc\n                else:\n                    cur_r = cur_r - step_r\n                    cur_c = sc\n                # second move: horizontal at target row tr, from cur_c to tc\n                if cur_c != tc:\n                    step_c = 1 if tc > cur_c else -1\n                    c = cur_c + step_c\n                    while c != tc:\n                        if grid[tr][c] != 0:\n                            c += step_c\n                            continue\n                        new_cells.append((tr, c))\n                        c += step_c\n            # keep only positions that are currently zero\n            valid = [(r, c) for (r, c) in new_cells if grid[r][c] == 0]\n            if len(valid) > len(best):\n                best = valid\n        return best\n\n    # process each non\u2011block colour\n    for col, pts in color_positions.items():\n        if col in block_colors:\n            continue\n        if len(pts) <= 1:\n            continue\n\n        # decide source point: interior points preferred, otherwise top\u2011most\n        interior = [(r, c) for (r, c) in pts if 0 < r < max_r and 0 < c < max_c]\n        if interior:\n            # pick interior point with smallest row (then column)\n            interior.sort(key=lambda x: (x[0], x[1]))\n            source = interior[0]\n        else:\n            pts.sort(key=lambda x: (x[0], x[1]))\n            source = pts[0]\n\n        # try all other points as targets\n        best_target = None\n        best_path = []\n        for target in pts:\n            if target == source:\n                continue\n            path = compute_path(source[0], source[1], target[0], target[1])\n            if len(path) > len(best_path):\n                best_path = path\n                best_target = target\n                # tie\u2011break \u2013 keep the one with smallest target row/col\n            elif len(path) == len(best_path) and len(path) > 0:\n                if (target[0], target[1]) < (best_target[0], best_target[1]):\n                    best_target = target\n                    best_path = path\n\n        # apply the best path\n        for (r, c) in best_path:\n            grid[r][c] = col\n\n    return grid",
