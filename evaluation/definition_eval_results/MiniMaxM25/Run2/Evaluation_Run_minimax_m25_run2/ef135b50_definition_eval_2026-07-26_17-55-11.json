  "raw_response": "def solve(grid):\n    n = len(grid)\n    new_grid = [row[:] for row in grid]\n    for i in range(1, n - 1):\n        row = grid[i]\n        left = None\n        right = None\n        for j, val in enumerate(row):\n            if val == 2:\n                if left is None:\n                    left = j\n                right = j\n        if left is not None and right is not None and left < right:\n            for j in range(left + 1, right):\n                if new_grid[i][j] == 0:\n                    new_grid[i][j] = 9\n    return new_grid",
  "script": "def solve(grid):\n    n = len(grid)\n    new_grid = [row[:] for row in grid]\n    for i in range(1, n - 1):\n        row = grid[i]\n        left = None\n        right = None\n        for j, val in enumerate(row):\n            if val == 2:\n                if left is None:\n                    left = j\n                right = j\n        if left is not None and right is not None and left < right:\n            for j in range(left + 1, right):\n                if new_grid[i][j] == 0:\n                    new_grid[i][j] = 9\n    return new_grid",
