  "script": "def solve(grid):\n    from collections import Counter\n\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # frequencies\n    flat = [cell for row in grid for cell in row]\n    cnt = Counter(flat)\n    # background = most common\n    background = max(cnt, key=cnt.get)\n    # block color = second most common (the rectangular region)\n    # remove background and find next highest\n    remaining = {k: v for k, v in cnt.items() if k != background}\n    block_color = max(remaining, key=remaining.get)\n\n    # bounding box of the block\n    r_min = r_max = c_min = c_max = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == block_color:\n                if r_min is None:\n                    r_min = r_max = r\n                    c_min = c_max = c\n                else:\n                    r_min = min(r_min, r)\n                    r_max = max(r_max, r)\n                    c_min = min(c_min, c)\n                    c_max = max(c_max, c)\n\n    # collect positions of other colors (outliers)\n    outliers = []\n    for r in range(rows):\n        for c in range(cols):\n            color = grid[r][c]\n            if color != background and color != block_color:\n                outliers.append((r, c, color))\n\n    # extend each aligned outlier\n    for r, c, color in outliers:\n        # horizontal alignment: same row as block\n        if r_min <= r <= r_max:\n            if c < c_min:\n                # extend left to just before block\n                for cc in range(c, c_min):\n                    grid[r][cc] = color\n            elif c > c_max:\n                # extend right\n                for cc in range(c_max + 1, c + 1):\n                    grid[r][cc] = color\n        # vertical alignment: same column as block\n        elif c_min <= c <= c_max:\n            if r < r_min:\n                # extend upward\n                for rr in range(r, r_min):\n                    grid[rr][c] = color\n            elif r > r_max:\n                # extend downward\n                for rr in range(r_max + 1, r + 1):\n                    grid[rr][c] = color\n\n    return grid",
