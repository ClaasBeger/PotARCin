ython script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    import collections\n\n    # Count all cell colors\n    flat = [cell for row in grid for cell in row]\n    cnt = collections.Counter(flat)\n\n    # Background is the most frequent color\n    background = max(cnt, key=cnt.get)\n\n    # Consider all colors except the background\n    other = {color: c for color, c in cnt.items() if color != background}\n\n    # If there is only one other color, that is the target\n    if len(other) == 1:\n        target = next(iter(other))\n    else:\n        # Find the second highest distinct count among the remaining colors\n        distinct_counts = sorted(set(other.values()), reverse=True)\n        if len(distinct_counts) >= 2:\n            second_count = distinct_counts[1]\n        else:\n            second_count = distinct_counts[0]   # all counts are equal\n\n        # All colors with this count are candidates\n        candidates = [color for color, c in other.items() if c == second_count]\n\n        # Choose the candidate that appears last in scanning order (row\u2011major)\n        first_occurrence = {}\n        for r, row in enumerate(grid):\n            for c, val in enumerate(row):\n                if val in candidates:\n                    if val not in first_occurrence:\n                        first_occurrence[val] = (r, c)\n\n        # The one with the greatest (row, col) is the later one\n        target = max(candidates, key=lambda x: first_occurrence[x])\n\n    # Compute the bounding box of the target color\n    min_r = min_c = None\n    max_r = max_c = None\n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val == target:\n                if min_r is None:\n                    min_r = max_r = r\n                    min_c = max_c = c\n                else:\n                    if r < min_r: min_r = r\n                    if r > max_r: max_r = r\n                    if c < min_c: min_c = c\n                    if c > max_c: max_c = c\n\n    # Extract the sub\u2011grid\n    result = [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n    return result",
  "script": "def solve(grid):\n    import collections\n\n    # Count all cell colors\n    flat = [cell for row in grid for cell in row]\n    cnt = collections.Counter(flat)\n\n    # Background is the most frequent color\n    background = max(cnt, key=cnt.get)\n\n    # Consider all colors except the background\n    other = {color: c for color, c in cnt.items() if color != background}\n\n    # If there is only one other color, that is the target\n    if len(other) == 1:\n        target = next(iter(other))\n    else:\n        # Find the second highest distinct count among the remaining colors\n        distinct_counts = sorted(set(other.values()), reverse=True)\n        if len(distinct_counts) >= 2:\n            second_count = distinct_counts[1]\n        else:\n            second_count = distinct_counts[0]   # all counts are equal\n\n        # All colors with this count are candidates\n        candidates = [color for color, c in other.items() if c == second_count]\n\n        # Choose the candidate that appears last in scanning order (row\u2011major)\n        first_occurrence = {}\n        for r, row in enumerate(grid):\n            for c, val in enumerate(row):\n                if val in candidates:\n                    if val not in first_occurrence:\n                        first_occurrence[val] = (r, c)\n\n        # The one with the greatest (row, col) is the later one\n        target = max(candidates, key=lambda x: first_occurrence[x])\n\n    # Compute the bounding box of the target color\n    min_r = min_c = None\n    max_r = max_c = None\n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val == target:\n                if min_r is None:\n                    min_r = max_r = r\n                    min_c = max_c = c\n                else:\n                    if r < min_r: min_r = r\n                    if r > max_r: max_r = r\n                    if c < min_c: min_c = c\n                    if c > max_c: max_c = c\n\n    # Extract the sub\u2011grid\n    result = [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n    return result",
