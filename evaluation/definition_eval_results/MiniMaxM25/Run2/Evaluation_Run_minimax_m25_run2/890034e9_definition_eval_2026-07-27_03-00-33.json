  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n else 0\n\n    # ----- find the rectangular frame colour X -----\n    X = None\n    orig = None\n    colors = set()\n    for row in grid:\n        colors.update(row)\n\n    for col in colors:\n        if col == 0:\n            continue\n        min_r, max_r = n, -1\n        min_c, max_c = m, -1\n        for i in range(n):\n            for j in range(m):\n                if grid[i][j] == col:\n                    if i < min_r:\n                        min_r = i\n                    if i > max_r:\n                        max_r = i\n                    if j < min_c:\n                        min_c = j\n                    if j > max_c:\n                        max_c = j\n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n\n        # border must be completely filled with this colour\n        border_ok = True\n        for i in range(min_r, max_r + 1):\n            if grid[i][min_c] != col or grid[i][max_c] != col:\n                border_ok = False\n                break\n        if border_ok:\n            for j in range(min_c, max_c + 1):\n                if grid[min_r][j] != col or grid[max_r][j] != col:\n                    border_ok = False\n                    break\n        if not border_ok:\n            continue\n\n        # interior must not contain the colour\n        interior_ok = True\n        for i in range(min_r + 1, max_r):\n            for j in range(min_c + 1, max_c):\n                if grid[i][j] == col:\n                    interior_ok = False\n                    break\n            if not interior_ok:\n                break\n        if interior_ok:\n            X = col\n            orig = (min_r, min_c, h, w)\n            break\n\n    if X is None:\n        return grid\n\n    # ----- find a second location of the same size with zero interior -----\n    target = None\n    h, w = orig[2], orig[3]\n\n    for r in range(n - h + 1):\n        for c in range(m - w + 1):\n            # interior must be all zeros\n            interior_ok = True\n            for i in range(r + 1, r + h - 1):\n                for j in range(c + 1, c + w - 1):\n                    if grid[i][j] != 0:\n                        interior_ok = False\n                        break\n                if not interior_ok:\n                    break\n            if not interior_ok:\n                continue\n\n            # border must not already contain X (otherwise it's the original rectangle)\n            bad = False\n            for i in range(r, r + h):\n                if grid[i][c] == X or grid[i][c + w - 1] == X:\n                    bad = True\n                    break\n            if not bad:\n                for j in range(c, c + w):\n                    if grid[r][j] == X or grid[r + h - 1][j] == X:\n                        bad = True\n                        break\n            if bad:\n                continue\n\n            target = (r, c)\n            break\n        if target is not None:\n            break\n\n    if target is None:\n        return grid\n\n    # ----- draw the border of the target rectangle with colour X -----\n    r, c = target\n    for i in range(r, r + h):\n        for j in range(c, c + w):\n            if i == r or i == r + h - 1 or j == c or j == c + w - 1:\n                grid[i][j] = X\n\n    return grid",
