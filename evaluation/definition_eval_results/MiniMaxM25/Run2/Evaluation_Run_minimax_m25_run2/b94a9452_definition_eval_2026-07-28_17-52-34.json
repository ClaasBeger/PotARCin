e(min_r, max_r + 1):\n                if grid[r][c] != 0:\n                    outer_color = grid[r][c]\n                    break\n            if outer_color is not None:\n                break\n\n    # Gather interior colors (excluding border)\n    interior_colors = {}\n    for r in range(min_r + 1, max_r):\n        for c in range(min_c + 1, max_c):\n            val = grid[r][c]\n            if val != 0:\n                interior_colors[val] = interior_colors.get(val, 0) + 1\n\n    # If no distinct inner color exists, just keep the original region unchanged\n    if not interior_colors or outer_color not in interior_colors:\n        # return the original region as\u2011is\n        return [[grid[min_r + i][min_c + j] for j in range(width)] for i in range(height)]\n\n    # Choose the most frequent interior color that is different from the border\n    inner_color = max(\n        (cnt, color) for color, cnt in interior_colors.items() if color != outer_color\n    )[1]\n\n    # Build the transformed region\n    result = []\n    for r in range(min_r, max_r + 1):\n        row = []\n        for c in range(min_c, max_c + 1):\n            if r == min_r or r == max_r or c == min_c or c == max_c:\n                # border cell -> inner color\n                row.append(inner_color)\n            else:\n                # interior cell -> outer color\n                row.append(outer_color)\n        result.append(row)\n\n    return result",
