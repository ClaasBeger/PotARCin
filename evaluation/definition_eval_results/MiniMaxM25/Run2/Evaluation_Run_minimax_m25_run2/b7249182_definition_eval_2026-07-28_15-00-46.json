 = c + (L - 1)\n            else:                             # shape extends to the left\n                mid_col = c - (L - 2)\n                corner_col = c - (L - 1)\n\n            # stem: horizontal line from the original cell towards the opposite side\n            for j in range(1, L - 1):\n                grid[r][c + direction * j] = val\n\n            # full vertical line one column before the far side\n            for row in range(top, bottom + 1):\n                grid[row][mid_col] = val\n\n            # corners on the far side\n            grid[top][corner_col] = val\n            grid[bottom][corner_col] = val\n    # ---------------------------------------------------------------------\n\n    draw_shape(v1, r1, c1, dir1)\n    draw_shape(v2, r2, c2, dir2)\n\n    return grid",
