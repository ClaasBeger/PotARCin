  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    n = len(grid)\n    m = len(grid[0])\n    out = [[0] * m for _ in range(n)]\n\n    for i in range(n):\n        for j in range(m):\n            if grid[i][j] == 5:          # the marker value from the examples\n                for di in (-1, 0, 1):\n                    for dj in (-1, 0, 1):\n                        ni, nj = i + di, j + dj\n                        if 0 <= ni < n and 0 <= nj < m:\n                            out[ni][nj] = 1\n    return out",
