alise output grid\n    out = [[0] * N for _ in range(N)]\n\n    # Place outer edges\n    for c in range(1, N - 1):\n        out[0][c] = top_col\n        out[N - 1][c] = bottom_col\n    for r in range(1, N - 1):\n        out[r][0] = left_col\n        out[r][N - 1] = right_col\n\n    # Place the complex shape (crop/clip to L\u00d7L if necessary)\n    cmin_r, cmax_r, cmin_c, cmax_c = central_box\n    h_center = cmax_r - cmin_r + 1\n    w_center = cmax_c - cmin_c + 1\n    for i in range(min(h_center, L)):\n        for j in range(min(w_center, L)):\n            out[1 + i][1 + j] = grid[cmin_r + i][cmin_c + j]\n\n    # Decide which edge bumps are omitted (when L is even and the edge colour equals L)\n    skip_top = skip_bottom = skip_left = skip_right = False\n    if L % 2 == 0:\n        if top_col == L:    skip_top = True\n        if bottom_col == L: skip_bottom = True\n        if left_col == L:   skip_left = True\n        if right_col == L:  skip_right = True\n\n    # Bump positions\n    offset = (L - 1) // 2               # for horizontal edges\n    if not skip_top:\n        out[1][1 + offset] = top_col\n    if not skip_bottom:\n        out[L][1 + offset] = bottom_col\n\n    left_offset  = L // 2               # lower middle for left edge\n    right_offset = (L - 1) // 2         # upper middle for right edge\n    if not skip_left:\n        out[1 + left_offset][1] = left_col\n    if not skip_right:\n        out[1 + right_offset][L] = right_col\n\n    return out",
