 < m:\n                            if (nr, nc) not in seen and grid[nr][nc] == 0 and not outside[nr][nc]:\n                                seen.add((nr, nc))\n                                dq.append((nr, nc))\n\n                # bounding box\n                min_r = min(r for r, _ in comp)\n                max_r = max(r for r, _ in comp)\n                min_c = min(c for _, c in comp)\n                max_c = max(c for _, c in comp)\n                height = max_r - min_r + 1\n                width = max_c - min_c + 1\n\n                # fill only if it is a perfect square of zeros\n                if height == width and len(comp) == height * width:\n                    for r, c in comp:\n                        grid[r][c] = 2\n\n    return grid",
