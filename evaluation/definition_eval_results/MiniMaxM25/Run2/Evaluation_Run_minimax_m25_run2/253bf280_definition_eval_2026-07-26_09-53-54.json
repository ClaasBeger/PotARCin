  "raw_response": "def solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return grid\n    cols = len(grid[0])\n\n    # Horizontal lines: fill between leftmost and rightmost 8 in each row\n    for r in range(rows):\n        positions = [c for c in range(cols) if grid[r][c] == 8]\n        if len(positions) >= 2:\n            left, right = min(positions), max(positions)\n            for c in range(left + 1, right):\n                if grid[r][c] != 8:\n                    grid[r][c] = 3\n\n    # Vertical lines: fill between topmost and bottommost 8 in each column\n    for c in range(cols):\n        positions = [r for r in range(rows) if grid[r][c] == 8]\n        if len(positions) >= 2:\n            top, bottom = min(positions), max(positions)\n            for r in range(top + 1, bottom):\n                if grid[r][c] != 8:\n                    grid[r][c] = 3\n\n    return grid",
