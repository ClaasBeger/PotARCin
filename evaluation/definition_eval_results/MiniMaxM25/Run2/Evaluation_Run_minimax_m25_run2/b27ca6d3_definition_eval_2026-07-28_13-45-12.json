  "raw_response": "def solve(grid):\n    if not grid:\n        return grid\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n    visited = [[False] * cols for _ in range(rows)]\n    ortho_dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 2 and not visited[i][j]:\n                # BFS to collect the whole orthogonal component of 2's\n                component = []\n                stack = [(i, j)]\n                visited[i][j] = True\n                while stack:\n                    r, c = stack.pop()\n                    component.append((r, c))\n                    for dr, dc in ortho_dirs:\n                        nr, nc = r + dr, c + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if not visited[nr][nc] and grid[nr][nc] == 2:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n\n                # If the component has at least two 2's, fill neighbours with 3\n                if len(component) >= 2:\n                    for (r, c) in component:\n                        for dr in (-1, 0, 1):\n                            for dc in (-1, 0, 1):\n                                if dr == 0 and dc == 0:\n                                    continue\n                                nr, nc = r + dr, c + dc\n                                if 0 <= nr < rows and 0 <= nc < cols:\n                                    if out[nr][nc] == 0:\n                                        out[nr][nc] = 3\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return grid\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n    visited = [[False] * cols for _ in range(rows)]\n    ortho_dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 2 and not visited[i][j]:\n                # BFS to collect the whole orthogonal component of 2's\n                component = []\n                stack = [(i, j)]\n                visited[i][j] = True\n                while stack:\n                    r, c = stack.pop()\n                    component.append((r, c))\n                    for dr, dc in ortho_dirs:\n                        nr, nc = r + dr, c + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if not visited[nr][nc] and grid[nr][nc] == 2:\n                                visited[nr][nc] = True\n                                stack.append((nr, nc))\n\n                # If the component has at least two 2's, fill neighbours with 3\n                if len(component) >= 2:\n                    for (r, c) in component:\n                        for dr in (-1, 0, 1):\n                            for dc in (-1, 0, 1):\n                                if dr == 0 and dc == 0:\n                                    continue\n                                nr, nc = r + dr, c + dc\n                                if 0 <= nr < rows and 0 <= nc < cols:\n                                    if out[nr][nc] == 0:\n                                        out[nr][nc] = 3\n    return out",
