  "raw_response": "def solve(grid):\n    \"\"\"\n    Replaces every cell that is part of a 2\u00d72 block of zeros in the input grid\n    with the value 2. All other cells remain unchanged.\n    \n    Parameters\n    ----------\n    grid : list[list[int]]\n        The input matrix consisting of integers (0, 5, \u2026).\n    \n    Returns\n    -------\n    list[list[int]]\n        The transformed grid.\n    \"\"\"\n    if not grid:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Collect all positions that belong to a 2x2 zero block\n    replace = set()\n    for i in range(rows - 1):\n        for j in range(cols - 1):\n            if (grid[i][j] == 0 and grid[i][j + 1] == 0 and\n                grid[i + 1][j] == 0 and grid[i + 1][j + 1] == 0):\n                replace.add((i, j))\n                replace.add((i, j + 1))\n                replace.add((i + 1, j))\n                replace.add((i + 1, j + 1))\n    \n    # Apply the replacement\n    for i, j in replace:\n        grid[i][j] = 2\n    \n    return grid",
  "script": "def solve(grid):\n    \"\"\"\n    Replaces every cell that is part of a 2\u00d72 block of zeros in the input grid\n    with the value 2. All other cells remain unchanged.\n    \n    Parameters\n    ----------\n    grid : list[list[int]]\n        The input matrix consisting of integers (0, 5, \u2026).\n    \n    Returns\n    -------\n    list[list[int]]\n        The transformed grid.\n    \"\"\"\n    if not grid:\n        return grid\n    \n    rows = len(grid)\n    cols = len(grid[0])\n    \n    # Collect all positions that belong to a 2x2 zero block\n    replace = set()\n    for i in range(rows - 1):\n        for j in range(cols - 1):\n            if (grid[i][j] == 0 and grid[i][j + 1] == 0 and\n                grid[i + 1][j] == 0 and grid[i + 1][j + 1] == 0):\n                replace.add((i, j))\n                replace.add((i, j + 1))\n                replace.add((i + 1, j))\n                replace.add((i + 1, j + 1))\n    \n    # Apply the replacement\n    for i, j in replace:\n        grid[i][j] = 2\n    \n    return grid",
