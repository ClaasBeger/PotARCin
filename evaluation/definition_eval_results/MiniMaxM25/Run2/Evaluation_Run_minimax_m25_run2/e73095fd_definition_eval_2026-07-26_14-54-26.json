  "raw_response": "from collections import deque\n\ndef solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return grid\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    components = []\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 0 and not visited[i][j]:\n                q = deque()\n                q.append((i, j))\n                visited[i][j] = True\n                comp = []\n                while q:\n                    x, y = q.popleft()\n                    comp.append((x, y))\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < rows and 0 <= ny < cols:\n                            if grid[nx][ny] == 0 and not visited[nx][ny]:\n                                visited[nx][ny] = True\n                                q.append((nx, ny))\n                components.append(comp)\n\n    # find the largest connected component of zeros\n    max_size = -1\n    largest_idx = -1\n    for idx, comp in enumerate(components):\n        size = len(comp)\n        if size > max_size:\n            max_size = size\n            largest_idx = idx\n\n    # fill all other zero components with color 4\n    for idx, comp in enumerate(components):\n        if idx == largest_idx:\n            continue\n        for x, y in comp:\n            grid[x][y] = 4\n\n    return grid",
  "script": "from collections import deque\n\ndef solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return grid\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    components = []\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 0 and not visited[i][j]:\n                q = deque()\n                q.append((i, j))\n                visited[i][j] = True\n                comp = []\n                while q:\n                    x, y = q.popleft()\n                    comp.append((x, y))\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < rows and 0 <= ny < cols:\n                            if grid[nx][ny] == 0 and not visited[nx][ny]:\n                                visited[nx][ny] = True\n                                q.append((nx, ny))\n                components.append(comp)\n\n    # find the largest connected component of zeros\n    max_size = -1\n    largest_idx = -1\n    for idx, comp in enumerate(components):\n        size = len(comp)\n        if size > max_size:\n            max_size = size\n            largest_idx = idx\n\n    # fill all other zero components with color 4\n    for idx, comp in enumerate(components):\n        if idx == largest_idx:\n            continue\n        for x, y in comp:\n            grid[x][y] = 4\n\n    return grid",
