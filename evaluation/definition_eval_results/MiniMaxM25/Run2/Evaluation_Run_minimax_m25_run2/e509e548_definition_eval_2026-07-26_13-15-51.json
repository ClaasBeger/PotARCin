  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    out = [[0] * cols for _ in range(rows)]\n\n    # directions\n    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_elbow(x, y):\n        # collect neighbour directions\n        nd = []\n        for dx, dy in dirs:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < rows and 0 <= ny < cols and grid[nx][ny] != 0:\n                nd.append((dx, dy))\n        if len(nd) != 2:\n            return False\n        # if the two directions are opposite \u2192 linear, else orthogonal \u2192 elbow\n        d1, d2 = nd\n        return not (d1[0] == -d2[0] and d1[1] == -d2[1])\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] != 0 and not visited[i][j]:\n                # collect one connected component\n                stack = [(i, j)]\n                visited[i][j] = True\n                comp = []\n                while stack:\n                    x, y = stack.pop()\n                    comp.append((x, y))\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < rows and 0 <= ny < cols:\n                            if grid[nx][ny] != 0 and not visited[nx][ny]:\n                                visited[nx][ny] = True\n                                stack.append((nx, ny))\n\n                # degree of each cell inside the component\n                deg = {}\n                for x, y in comp:\n                    d = 0\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < rows and 0 <= ny < cols and grid[nx][ny] != 0:\n                            d += 1\n                    deg[(x, y)] = d\n\n                leaves = sum(1 for d in deg.values() if d == 1)\n                elbows = sum(1 for (x, y), d in deg.items() if d == 2 and is_elbow(x, y))\n                junctions = sum(1 for d in deg.values() if d >= 3)\n\n                # decide the output number\n                if junctions > 0:\n                    out_val = 2                # T\u2011shape\n                elif leaves == 2:\n                    if elbows == 1:\n                        out_val = 1            # L\u2011shape\n                    elif elbows == 2:\n                        out_val = 6            # U\u2011shape\n                    else:\n                        out_val = 1            # default for missing cases\n                else:\n                    out_val = 2                # any other case (e.g. 3 leaves without junction)\n\n                # write the number into the result grid\n                for x, y in comp:\n                    out[x][y] = out_val\n\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return []\n    rows = len(grid)\n    cols = len(grid[0])\n    visited = [[False] * cols for _ in range(rows)]\n    out = [[0] * cols for _ in range(rows)]\n\n    # directions\n    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_elbow(x, y):\n        # collect neighbour directions\n        nd = []\n        for dx, dy in dirs:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < rows and 0 <= ny < cols and grid[nx][ny] != 0:\n                nd.append((dx, dy))\n        if len(nd) != 2:\n            return False\n        # if the two directions are opposite \u2192 linear, else orthogonal \u2192 elbow\n        d1, d2 = nd\n        return not (d1[0] == -d2[0] and d1[1] == -d2[1])\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] != 0 and not visited[i][j]:\n                # collect one connected component\n                stack = [(i, j)]\n                visited[i][j] = True\n                comp = []\n                while stack:\n                    x, y = stack.pop()\n                    comp.append((x, y))\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < rows and 0 <= ny < cols:\n                            if grid[nx][ny] != 0 and not visited[nx][ny]:\n                                visited[nx][ny] = True\n                                stack.append((nx, ny))\n\n                # degree of each cell inside the component\n                deg = {}\n                for x, y in comp:\n                    d = 0\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < rows and 0 <= ny < cols and grid[nx][ny] != 0:\n                            d += 1\n                    deg[(x, y)] = d\n\n                leaves = sum(1 for d in deg.values() if d == 1)\n                elbows = sum(1 for (x, y), d in deg.items() if d == 2 and is_elbow(x, y))\n                junctions = sum(1 for d in deg.values() if d >= 3)\n\n                # decide the output number\n                if junctions > 0:\n                    out_val = 2                # T\u2011shape\n                elif leaves == 2:\n                    if elbows == 1:\n                        out_val = 1            # L\u2011shape\n                    elif elbows == 2:\n                        out_val = 6            # U\u2011shape\n                    else:\n                        out_val = 1            # default for missing cases\n                else:\n                    out_val = 2                # any other case (e.g. 3 leaves without junction)\n\n                # write the number into the result grid\n                for x, y in comp:\n                    out[x][y] = out_val\n\n    return out",
