not solid:\n                        break\n                if not solid:\n                    continue\n\n                area = (max_r - min_r + 1) * (max_c - min_c + 1)\n\n                if (twos > best_twos) or (twos == best_twos and area > best_area):\n                    best_twos = twos\n                    best_area = area\n                    best = (min_r, max_r, min_c, max_c)\n\n    if best is None:\n        return []\n\n    min_r, max_r, min_c, max_c = best\n    result = [grid[r][min_c:max_c+1] for r in range(min_r, max_r+1)]\n    return result",
