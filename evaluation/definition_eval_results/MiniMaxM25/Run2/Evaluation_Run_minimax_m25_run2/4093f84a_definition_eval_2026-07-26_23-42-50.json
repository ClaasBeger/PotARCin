  "raw_response": "def solve(grid):\n    \"\"\"\n    Transform the input grid according to the discovered rule.\n    The grid contains a rectangular block of 5's. All other non\u2011zero cells\n    (the \"source\" cells) are projected onto the row/column adjacent to the\n    block, preserving their orthogonal coordinate. If several sources share\n    the same orthogonal coordinate they are stacked outward from the block.\n    The source cells are removed and the projected positions become 5.\n    \"\"\"\n    if not grid:\n        return grid\n\n    H = len(grid)\n    W = len(grid[0])\n\n    # locate the block of 5's\n    rows_5 = []\n    cols_5 = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == 5:\n                rows_5.append(r)\n                cols_5.append(c)\n\n    if not rows_5:                     # no 5 at all \u2013 nothing to do\n        return grid\n\n    row_min, row_max = min(rows_5), max(rows_5)\n    col_min, col_max = min(cols_5), max(cols_5)\n\n    # initialise output with zeros, then fill the 5 block\n    out = [[0] * W for _ in range(H)]\n    for r in range(row_min, row_max + 1):\n        for c in range(col_min, col_max + 1):\n            out[r][c] = 5\n\n    # collect all source cells (any non\u2011zero value other than 5)\n    sources = []\n    for r in range(H):\n        for c in range(W):\n            val = grid[r][c]\n            if val != 0 and val != 5:\n                sources.append((r, c))\n\n    # group sources by side of the block\n    from collections import defaultdict\n    above = defaultdict(list)   # key: column\n    below = defaultdict(list)   # key: column\n    left  = defaultdict(list)   # key: row\n    right = defaultdict(list)   # key: row\n\n    for r, c in sources:\n        if r < row_min:\n            above[c].append((r, c))\n        elif r > row_max:\n            below[c].append((r, c))\n        elif c < col_min:\n            left[r].append((r, c))\n        elif c > col_max:\n            right[r].append((r, c))\n        # else: source inside the block \u2013 ignore (should not happen)\n\n    # ----- above the block -----\n    border_above = row_min - 1\n    if border_above >= 0:\n        for col, lst in above.items():\n            # nearest to the block comes first\n            lst.sort(key=lambda x: border_above - x[0])\n            for i, (r, c) in enumerate(lst):\n                target_r = border_above - i\n                if 0 <= target_r < H:\n                    out[target_r][col] = 5\n\n    # ----- below the block -----\n    border_below = row_max + 1\n    if border_below < H:\n        for col, lst in below.items():\n            lst.sort(key=lambda x: x[0] - border_below)\n            for i, (r, c) in enumerate(lst):\n                target_r = border_below + i\n                if 0 <= target_r < H:\n                    out[target_r][col] = 5\n\n    # ----- left of the block -----\n    border_left = col_min - 1\n    if border_left >= 0:\n        for row, lst in left.items():\n            lst.sort(key=lambda x: border_left - x[1])\n            for i, (r, c) in enumerate(lst):\n                target_c = border_left - i\n                if 0 <= target_c < W:\n                    out[row][target_c] = 5\n\n    # ----- right of the block -----\n    border_right = col_max + 1\n    if border_right < W:\n        for row, lst in right.items():\n            lst.sort(key=lambda x: x[1] - border_right)\n            for i, (r, c) in enumerate(lst):\n                target_c = border_right + i\n                if 0 <= target_c < W:\n                    out[row][target_c] = 5\n\n    return out",
