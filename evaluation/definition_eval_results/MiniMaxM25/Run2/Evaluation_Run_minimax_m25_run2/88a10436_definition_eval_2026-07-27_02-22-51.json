elif comp['size'] > 1:\n            if pattern_comp is None:\n                pattern_comp = comp\n\n    # If the input does not match expectations, return it unchanged\n    if pattern_comp is None or anchor_comp is None:\n        return grid\n\n    # --------------------------------------------------------------------\n    # Bounding box of the pattern\n    # --------------------------------------------------------------------\n    rows_pts = [r for r, _ in pattern_comp['coords']]\n    cols_pts = [c for _, c in pattern_comp['coords']]\n    min_r, max_r = min(rows_pts), max(rows_pts)\n    min_c, max_c = min(cols_pts), max(cols_pts)\n    height = max_r - min_r + 1\n    width = max_c - min_c + 1\n\n    # Extract the pattern sub\u2011matrix (including zeros inside the bounding box)\n    pattern_matrix = [\n        [grid[min_r + i][min_c + j] for j in range(width)]\n        for i in range(height)\n    ]\n\n    # --------------------------------------------------------------------\n    # Position of the isolated anchor cell\n    # --------------------------------------------------------------------\n    anchor_r, anchor_c = anchor_comp['coords'][0]\n\n    # --------------------------------------------------------------------\n    # Compute new top\u2011left corner so that the pattern centre aligns with anchor\n    # --------------------------------------------------------------------\n    offset_r = height // 2\n    offset_c = width // 2\n    new_top_r = anchor_r - offset_r\n    new_top_c = anchor_c - offset_c\n\n    # --------------------------------------------------------------------\n    # Copy the pattern to the new location (overwrites whatever was there)\n    # --------------------------------------------------------------------\n    for i in range(height):\n        for j in range(width):\n            grid[new_top_r + i][new_top_c + j] = pattern_matrix[i][j]\n\n    return grid",
