  "raw_response": "def solve(grid):\n    from collections import deque\n\n    rows = len(grid)\n    if rows == 0:\n        return grid\n    cols = len(grid[0])\n\n    # copy for output\n    out = [row[:] for row in grid]\n\n    visited = [[False] * cols for _ in range(rows)]\n\n    # directions for 4\u2011neighbourhood\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and not visited[r][c]:\n                # BFS to collect the component\n                q = deque()\n                q.append((r, c))\n                visited[r][c] = True\n                component = []\n                while q:\n                    cr, cc = q.popleft()\n                    component.append((cr, cc))\n                    for dr, dc in dirs:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 1 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n\n                # Determine bounding box\n                min_r = min(cr for cr, _ in component)\n                max_r = max(cr for cr, _ in component)\n                min_c = min(cc for _, cc in component)\n                max_c = max(cc for _, cc in component)\n\n                width = max_c - min_c + 1\n                height = max_r - min_r + 1\n\n                # A perfect border rectangle must have exactly border cell count\n                border_needed = 2 * width + 2 * height - 4\n                if len(component) != border_needed:\n                    # not a clean border shape, skip\n                    continue\n\n                # interior must be present\n                if width <= 2 or height <= 2:\n                    continue\n\n                interior_w = width - 2\n                interior_h = height - 2\n                interior_area = interior_w * interior_h\n\n                # decide fill value\n                fill = 2 if interior_area % 2 == 0 else 7\n\n                # fill interior cells that are currently 0\n                for ir in range(min_r + 1, max_r):\n                    for ic in range(min_c + 1, max_c):\n                        if grid[ir][ic] == 0:\n                            out[ir][ic] = fill\n\n    return out",
  "script": "def solve(grid):\n    from collections import deque\n\n    rows = len(grid)\n    if rows == 0:\n        return grid\n    cols = len(grid[0])\n\n    # copy for output\n    out = [row[:] for row in grid]\n\n    visited = [[False] * cols for _ in range(rows)]\n\n    # directions for 4\u2011neighbourhood\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 1 and not visited[r][c]:\n                # BFS to collect the component\n                q = deque()\n                q.append((r, c))\n                visited[r][c] = True\n                component = []\n                while q:\n                    cr, cc = q.popleft()\n                    component.append((cr, cc))\n                    for dr, dc in dirs:\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 1 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n\n                # Determine bounding box\n                min_r = min(cr for cr, _ in component)\n                max_r = max(cr for cr, _ in component)\n                min_c = min(cc for _, cc in component)\n                max_c = max(cc for _, cc in component)\n\n                width = max_c - min_c + 1\n                height = max_r - min_r + 1\n\n                # A perfect border rectangle must have exactly border cell count\n                border_needed = 2 * width + 2 * height - 4\n                if len(component) != border_needed:\n                    # not a clean border shape, skip\n                    continue\n\n                # interior must be present\n                if width <= 2 or height <= 2:\n                    continue\n\n                interior_w = width - 2\n                interior_h = height - 2\n                interior_area = interior_w 