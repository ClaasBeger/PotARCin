  "raw_response": "def solve(grid):\n    # Find bounding box of non-zero cells\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    \n    non_zero_positions = [(i, j) for i in range(rows) for j in range(cols) if grid[i][j] != 0]\n    if not non_zero_positions:\n        return []\n    \n    row_min = min(i for i, _ in non_zero_positions)\n    row_max = max(i for i, _ in non_zero_positions)\n    col_min = min(j for _, j in non_zero_positions)\n    col_max = max(j for _, j in non_zero_positions)\n\n    # Extract colour runs from a row (ignoring zeros)\n    def row_runs(row):\n        nonzero = [row[c] for c in range(col_min, col_max + 1) if row[c] != 0]\n        runs = []\n        for v in nonzero:\n            if not runs or v != runs[-1]:\n                runs.append(v)\n        return runs\n\n    # Compute runs for each non\u2011zero row and track maximum number of runs\n    runs_per_row = []\n    max_runs = 0\n    for r in range(row_min, row_max + 1):\n        runs = row_runs(grid[r])\n        if runs:\n            runs_per_row.append(runs)\n            if len(runs) > max_runs:\n                max_runs = len(runs)\n\n    if not runs_per_row:\n        return []\n\n    # Group consecutive rows with identical run patterns into horizontal bands\n    bands = []\n    prev = None\n    for runs in runs_per_row:\n        if prev is None or runs != prev:\n            bands.append(runs)\n            prev = runs\n\n    V = max_runs\n    output = []\n    for band in bands:\n        out_row = band[:]        # copy\n        if out_row:\n            last = out_row[-1]\n            while len(out_row) < V:\n                out_row.append(last)\n        output.append(out_row)\n\n    return output",
  "script": "def solve(grid):\n    # Find bounding box of non-zero cells\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n    \n    non_zero_positions = [(i, j) for i in range(rows) for j in range(cols) if grid[i][j] != 0]\n    if not non_zero_positions:\n        return []\n    \n    row_min = min(i for i, _ in non_zero_positions)\n    row_max = max(i for i, _ in non_zero_positions)\n    col_min = min(j for _, j in non_zero_positions)\n    col_max = max(j for _, j in non_zero_positions)\n\n    # Extract colour runs from a row (ignoring zeros)\n    def row_runs(row):\n        nonzero = [row[c] for c in range(col_min, col_max + 1) if row[c] != 0]\n        runs = []\n        for v in nonzero:\n            if not runs or v != runs[-1]:\n                runs.append(v)\n        return runs\n\n    # Compute runs for each non\u2011zero row and track maximum number of runs\n    runs_per_row = []\n    max_runs = 0\n    for r in range(row_min, row_max + 1):\n        runs = row_runs(grid[r])\n        if runs:\n            runs_per_row.append(runs)\n            if len(runs) > max_runs:\n                max_runs = len(runs)\n\n    if not runs_per_row:\n        return []\n\n    # Group consecutive rows with identical run patterns into horizontal bands\n    bands = []\n    prev = None\n    for runs in runs_per_row:\n        if prev is None or runs != prev:\n            bands.append(runs)\n            prev = runs\n\n    V = max_runs\n    output = []\n    for band in bands:\n        out_row = band[:]        # copy\n        if out_row:\n            last = out_row[-1]\n            while len(out_row) < V:\n                out_row.append(last)\n        output.append(out_row)\n\n    return output",
