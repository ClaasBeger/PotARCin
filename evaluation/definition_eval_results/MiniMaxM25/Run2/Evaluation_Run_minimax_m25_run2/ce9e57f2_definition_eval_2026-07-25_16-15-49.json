  "raw_response": "def solve(grid):\n    # Create a deep copy to avoid mutating the input\n    out = [row[:] for row in grid]\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    for c in range(cols):\n        # Collect rows in this column that contain the value 2\n        positions = [r for r in range(rows) if grid[r][c] == 2]\n        if not positions:\n            continue\n        n = len(positions)\n        half = n // 2            # floor division \u2013 number of cells to turn to 8\n        # The bottom half (largest row indices) become 8\n        for r in positions[-half:]:\n            out[r][c] = 8\n\n    return out",
