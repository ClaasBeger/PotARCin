  "raw_response": "def solve(grid):\n    # Find all\u2011zero rows (the separator)\n    zero_rows = [i for i, row in enumerate(grid) if all(v == 0 for v in row)]\n    if not zero_rows:\n        # No separator \u2013 return the grid unchanged\n        return grid\n\n    # Identify the longest consecutive block of all\u2011zero rows\n    zero_start = zero_end = zero_rows[0]\n    cur_start = cur_end = zero_rows[0]\n    for idx in zero_rows[1:]:\n        if idx == cur_end + 1:\n            cur_end = idx\n        else:\n            if cur_end - cur_start > zero_end - zero_start:\n                zero_start, zero_end = cur_start, cur_end\n            cur_start = cur_end = idx\n    if cur_end - cur_start > zero_end - zero_start:\n        zero_start, zero_end = cur_start, cur_end\n\n    top_region = grid[:zero_start]          # rows above the zero block\n    bottom_region = grid[zero_end + 1:]     # rows below the zero block\n\n    # Non\u2011zero colours in the top and bottom parts\n    top_non_zero = {v for row in top_region for v in row if v != 0}\n    bottom_non_zero = {v for row in bottom_region for v in row if v != 0}\n\n    # Determine the target colour(s) B: the colour(s) that appear in the bottom\n    # part but not in the top part.  If there is none, fall back to the colours\n    # present in the bottom part.\n    B = bottom_non_zero - top_non_zero\n    if not B:\n        B = bottom_non_zero\n\n    # Bounding box of the target colour(s) within the bottom region\n    min_row = len(grid)\n    max_row = -1\n    min_col = len(grid[0])\n    max_col = -1\n\n    for r, row in enumerate(bottom_region):\n        for c, v in enumerate(row):\n            if v in B:\n                abs_r = r + zero_end + 1\n                if abs_r < min_row:\n                    min_row = abs_r\n                if abs_r > max_row:\n                    max_row = abs_r\n                if c < min_col:\n                    min_col = c\n                if c > max_col:\n                    max_col = c\n\n    # Extract and return the sub\u2011grid defined by the bounding box\n    result = [grid[rr][min_col:max_col + 1] for rr in range(min_row, max_row + 1)]\n    return result",
  "script": "def solve(grid):\n    # Find all\u2011zero rows (the separator)\n    zero_rows = [i for i, row in enumerate(grid) if all(v == 0 for v in row)]\n    if not zero_rows:\n        # No separator \u2013 return the grid unchanged\n        return grid\n\n    # Identify the longest consecutive block of all\u2011zero rows\n    zero_start = zero_end = zero_rows[0]\n    cur_start = cur_end = zero_rows[0]\n    for idx in zero_rows[1:]:\n        if idx == cur_end + 1:\n            cur_end = idx\n        else:\n            if cur_end - cur_start > zero_end - zero_start:\n                zero_start, zero_end = cur_start, cur_end\n            cur_start = cur_end = idx\n    if cur_end - cur_start > zero_end - zero_start:\n        zero_start, zero_end = cur_start, cur_end\n\n    top_region = grid[:zero_start]          # rows above the zero block\n    bottom_region = grid[zero_end + 1:]     # rows below the zero block\n\n    # Non\u2011zero colours in the top and bottom parts\n    top_non_zero = {v for row in top_region for v in row if v != 0}\n    bottom_non_zero = {v for row in bottom_region for v in row if v != 0}\n\n    # Determine the target colour(s) B: the colour(s) that appear in the bottom\n    # part but not in the top part.  If there is none, fall back to the colours\n    # present in the bottom part.\n    B = bottom_non_zero - top_non_zero\n    if not B:\n        B = bottom_non_zero\n\n    # Bounding box of the target colour(s) within the bottom region\n    min_row = len(grid)\n    max_row = -1\n    min_col = len(grid[0])\n    max_col = -1\n\n    for r, row in enumerate(bottom_region):\n        for c, v in enumerate(row):\n            if v in B:\n                abs_r = r + zero_end + 1\n                if abs_r < min_row:\n                    min_row = abs_r\n                if abs_r > max_row:\n                    max_row = abs_r\n                if c < min_col:\n                    min_col = c\n                if c > max_col:\n                    max_col = c