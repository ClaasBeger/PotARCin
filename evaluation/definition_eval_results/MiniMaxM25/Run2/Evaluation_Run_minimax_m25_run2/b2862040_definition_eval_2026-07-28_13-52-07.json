  "raw_response": "def solve(grid):\n    from collections import deque\n\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # copy output grid\n    out = [row[:] for row in grid]\n\n    # ------------------------------------------------------------\n    # 1) find all 9 cells that are reachable from the border\n    # ------------------------------------------------------------\n    visited = [[False] * cols for _ in range(rows)]\n    q = deque()\n\n    # border cells that are 9\n    for i in range(rows):\n        for j in (0, cols - 1):\n            if grid[i][j] == 9 and not visited[i][j]:\n                visited[i][j] = True\n                q.append((i, j))\n    for j in range(cols):\n        for i in (0, rows - 1):\n            if grid[i][j] == 9 and not visited[i][j]:\n                visited[i][j] = True\n                q.append((i, j))\n\n    # BFS through 9 cells\n    while q:\n        i, j = q.popleft()\n        for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            ni, nj = i + di, j + dj\n            if 0 <= ni < rows and 0 <= nj < cols:\n                if not visited[ni][nj] and grid[ni][nj] == 9:\n                    visited[ni][nj] = True\n                    q.append((ni, nj))\n\n    # ------------------------------------------------------------\n    # 2) identify interior 9 cells (holes)\n    # ------------------------------------------------------------\n    interior_9 = [[False] * cols for _ in range(rows)]\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 9 and not visited[i][j]:\n                interior_9[i][j] = True\n\n    # ------------------------------------------------------------\n    # 3) find connected components of 1's; if a component touches\n    #    an interior 9, turn the whole component into 8.\n    # ------------------------------------------------------------\n    visited_1 = [[False] * cols for _ in range(rows)]\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 1 and not visited_1[i][j]:\n                # BFS for this component\n                comp = []\n                queue = deque()\n                queue.append((i, j))\n                visited_1[i][j] = True\n                touches_interior = False\n\n                while queue:\n                    x, y = queue.popleft()\n                    comp.append((x, y))\n\n                    # check neighbours for interior 9\n                    for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + di, y + dj\n                        if 0 <= nx < rows and 0 <= ny < cols:\n                            if interior_9[nx][ny]:\n                                touches_interior = True\n                            if grid[nx][ny] == 1 and not visited_1[nx][ny]:\n                                visited_1[nx][ny] = True\n                                queue.append((nx, ny))\n\n                # if the component encloses a hole, recolor all its 1's to 8\n                if touches_interior:\n                    for (x, y) in comp:\n                        out[x][y] = 8\n\n    return out",
