  "raw_response": "def solve(grid):\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n    last_col = cols - 1\n\n    # Determine the pattern from the first row (row 0)\n    pattern_cols = [c for c, v in enumerate(grid[0]) if v == 5]\n\n    # Apply the pattern to every row that has a 5 in the last column\n    for r in range(rows):\n        if grid[r][last_col] == 5:\n            for c in pattern_cols:\n                if grid[r][c] == 0:\n                    grid[r][c] = 2\n\n    return grid",
