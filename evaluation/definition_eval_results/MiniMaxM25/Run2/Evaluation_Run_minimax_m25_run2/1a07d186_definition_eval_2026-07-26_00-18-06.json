  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n\n    h = len(grid)\n    w = len(grid[0])\n\n    # collect non\u2011zero colours\n    colours = set()\n    for row in grid:\n        for v in row:\n            if v:\n                colours.add(v)\n\n    # find spine (full row or full column) for each colour\n    spines = {}  # colour -> ('row', index) or ('col', index) or None\n    for c in colours:\n        spine = None\n        # try full row\n        for i in range(h):\n            if all(grid[i][j] == c for j in range(w)):\n                spine = ('row', i)\n                break\n        if spine is None:\n            # try full column\n            for j in range(w):\n                if all(grid[i][j] == c for i in range(h)):\n                    spine = ('col', j)\n                    break\n        spines[c] = spine  # None if no spine\n\n    # initialise output with zeros\n    out = [[0] * w for _ in range(h)]\n\n    # place the spines\n    for c, sp in spines.items():\n        if sp is None:\n            continue\n        typ, idx = sp\n        if typ == 'row':\n            for j in range(w):\n                out[idx][j] = c\n        else:  # column\n            for i in range(h):\n                out[i][idx] = c\n\n    # move extras adjacent to the spine\n    for c, sp in spines.items():\n        if sp is None:\n            continue\n        typ, idx = sp\n        for i in range(h):\n            for j in range(w):\n                if grid[i][j] != c:\n                    continue\n                # skip spine cells\n                if typ == 'row' and i == idx:\n                    continue\n                if typ == 'col' and j == idx:\n                    continue\n                # compute target position\n                if typ == 'row':\n                    if i < idx:\n                        ti = idx - 1\n                    else:\n                        ti = idx + 1\n                    tj = j\n                else:  # col\n                    ti = i\n                    if j < idx:\n                        tj = idx - 1\n                    else:\n                        tj = idx + 1\n                # place if inside bounds\n                if 0 <= ti < h and 0 <= tj < w:\n                    out[ti][tj] = c\n\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return []\n\n    h = len(grid)\n    w = len(grid[0])\n\n    # collect non\u2011zero colours\n    colours = set()\n    for row in grid:\n        for v in row:\n            if v:\n                colours.add(v)\n\n    # find spine (full row or full column) for each colour\n    spines = {}  # colour -> ('row', index) or ('col', index) or None\n    for c in colours:\n        spine = None\n        # try full row\n        for i in range(h):\n            if all(grid[i][j] == c for j in range(w)):\n                spine = ('row', i)\n                break\n        if spine is None:\n            # try full column\n            for j in range(w):\n                if all(grid[i][j] == c for i in range(h)):\n                    spine = ('col', j)\n                    break\n        spines[c] = spine  # None if no spine\n\n    # initialise output with zeros\n    out = [[0] * w for _ in range(h)]\n\n    # place the spines\n    for c, sp in spines.items():\n        if sp is None:\n            continue\n        typ, idx = sp\n        if typ == 'row':\n            for j in range(w):\n                out[idx][j] = c\n        else:  # column\n            for i in range(h):\n                out[i][idx] = c\n\n    # move extras adjacent to the spine\n    for c, sp in spines.items():\n        if sp is None:\n            continue\n        typ, idx = sp\n        for i in range(h):\n            for j in range(w):\n                if grid[i][j] != c:\n                    continue\n                # skip spine cells\n                if typ == 'row' and i == idx:\n                    continue\n                if typ == 'col' and j == idx:\n                    continue\n                # compute target position\n                if typ == 'row':\n                    if i < idx:\n                        ti = idx - 1\n                    else:\n                        ti = idx + 1\n                    tj = j\n                else:  # col\n                    ti = i\n                    if j < idx:\n                        tj = idx - 1\n                    else:\n                        tj = idx + 1\n                # place if inside bounds\n                if 0 <= ti < h and 0 <= tj < w:\n                    out[ti][tj] = c\n\n    return out",
