         zero_rows[v].add(r)\n                    break\n\n    # Propagate zeros inside each region\n    for v in region:\n        info = region[v]\n        if orient[v] == 'horizontal':\n            for col in zero_cols.get(v, set()):\n                for row in range(info['min_r'], info['max_r'] + 1):\n                    grid[row][col] = 0\n        else:  # vertical\n            for row in zero_rows.get(v, set()):\n                for col in range(info['min_c'], info['max_c'] + 1):\n                    grid[row][col] = 0\n\n    return grid",
