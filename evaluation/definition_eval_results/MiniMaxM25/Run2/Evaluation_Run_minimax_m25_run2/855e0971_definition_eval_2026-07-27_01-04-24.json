  "raw_response": "def solve(grid):\n    if not grid:\n        return grid\n\n    n_rows = len(grid)\n    n_cols = len(grid[0])\n\n    # Gather bounding boxes for each non\u2011zero colour\n    region = {}  # colour -> {'min_r','max_r','min_c','max_c'}\n    for r in range(n_rows):\n        for c in range(n_cols):\n            v = grid[r][c]\n            if v == 0:\n                continue\n            if v not in region:\n                region[v] = {'min_r': r, 'max_r': r, 'min_c': c, 'max_c': c}\n            else:\n                info = region[v]\n                if r < info['min_r']: info['min_r'] = r\n                if r > info['max_r']: info['max_r'] = r\n                if c < info['min_c']: info['min_c'] = c\n                if c > info['max_c']: info['max_c'] = c\n\n    # Determine orientation of each region (horizontal = full width, vertical = full height)\n    orient = {}  # colour -> 'horizontal' or 'vertical'\n    for v, info in region.items():\n        if info['min_c'] == 0 and info['max_c'] == n_cols - 1:\n            orient[v] = 'horizontal'\n        elif info['min_r'] == 0 and info['max_r'] == n_rows - 1:\n            orient[v] = 'vertical'\n        else:\n            # default (should not appear in the task)\n            orient[v] = 'horizontal'\n\n    # Collect zero lines for each region\n    zero_cols = {v: set() for v in region if orient[v] == 'horizontal'}\n    zero_rows = {v: set() for v in region if orient[v] == 'vertical'}\n\n    # Assign each zero to its region and record the line (row or column)\n    for r in range(n_rows):\n        for c in range(n_cols):\n            if grid[r][c] != 0:\n                continue\n            # find the region that contains this zero\n            for v, info in region.items():\n                if info['min_r'] <= r <= info['max_r'] and info['min_c'] <= c <= info['max_c']:\n                    if orient[v] == 'horizontal':\n                        zero_cols[v].add(c)\n                    else:\n                        zero_rows[v].add(r)\n                    break\n\n    # Propagate zeros inside each region\n    for v in region:\n        info = region[v]\n        if orient[v] == 'horizontal':\n            for col in zero_cols.get(v, set()):\n                for row in range(info['min_r'], info['max_r'] + 1):\n                    grid[row][col] = 0\n        else:  # vertical\n            for row in zero_rows.get(v, set()):\n                for col in range(info['min_c'], info['max_c'] + 1):\n                    grid[row][col] = 0\n\n    return grid",
