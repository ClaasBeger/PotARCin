  "raw_response": "def solve(grid):\n    # Find rows and columns that are completely filled with 5 (the separators)\n    rows = len(grid)\n    cols = len(grid[0])\n    sep_rows = [i for i in range(rows) if all(cell == 5 for cell in grid[i])]\n    sep_cols = [j for j in range(cols) if all(grid[i][j] == 5 for i in range(rows))]\n\n    # Partition the grid into blocks using the separators\n    block_rows = []\n    start = 0\n    for r in sep_rows:\n        block_rows.append((start, r - 1))\n        start = r + 1\n    block_rows.append((start, rows - 1))\n\n    block_cols = []\n    start = 0\n    for c in sep_cols:\n        block_cols.append((start, c - 1))\n        start = c + 1\n    block_cols.append((start, cols - 1))\n\n    bh = block_rows[0][1] - block_rows[0][0] + 1   # block height\n    bw = block_cols[0][1] - block_cols[0][0] + 1   # block width\n\n    # Locate the block with the most non\u2011zero cells\n    max_cnt = -1\n    source = (0, 0)\n    for br, (rs, re) in enumerate(block_rows):\n        for bc, (cs, ce) in enumerate(block_cols):\n            cnt = 0\n            for r in range(rs, re + 1):\n                for c in range(cs, ce + 1):\n                    if grid[r][c] != 0:\n                        cnt += 1\n            if (cnt > max_cnt or\n                (cnt == max_cnt and (br > source[0] or (br == source[0] and bc > source[1])))):\n                max_cnt = cnt\n                source = (br, bc)\n\n    # Determine the target block (transpose of the source)\n    sr, sc = source\n    if sr != sc:\n        tr, tc = sc, sr          # transpose\n    else:\n        # fallback when the source lies on the main diagonal\n        tr, tc = 1, 0            # middle\u2011left block (exists for the 3\u00d73 case)\n\n    # Build the output grid, preserving the separator lines\n    out = [[0] * cols for _ in range(rows)]\n    for r in sep_rows:\n        for c in range(cols):\n            out[r][c] = 5\n    for c in sep_cols:\n        for r in range(rows):\n            out[r][c] = 5\n\n    # Copy the non\u2011zero values from the source block to the target block\n    rs = block_rows[sr][0]\n    cs = block_cols[sc][0]\n    rt = block_rows[tr][0]\n    ct = block_cols[tc][0]\n    for dr in range(bh):\n        for dc in range(bw):\n            val = grid[rs + dr][cs + dc]\n            if val != 0:\n                out[rt + dr][ct + dc] = val\n\n    return out",
  "script": "def solve(grid):\n    # Find rows and columns that are completely filled with 5 (the separators)\n    rows = len(grid)\n    cols = len(grid[0])\n    sep_rows = [i for i in range(rows) if all(cell == 5 for cell in grid[i])]\n    sep_cols = [j for j in range(cols) if all(grid[i][j] == 5 for i in range(rows))]\n\n    # Partition the grid into blocks using the separators\n    block_rows = []\n    start = 0\n    for r in sep_rows:\n        block_rows.append((start, r - 1))\n        start = r + 1\n    block_rows.append((start, rows - 1))\n\n    block_cols = []\n    start = 0\n    for c in sep_cols:\n        block_cols.append((start, c - 1))\n        start = c + 1\n    block_cols.append((start, cols - 1))\n\n    bh = block_rows[0][1] - block_rows[0][0] + 1   # block height\n    bw = block_cols[0][1] - block_cols[0][0] + 1   # block width\n\n    # Locate the block with the most non\u2011zero cells\n    max_cnt = -1\n    source = (0, 0)\n    for br, (rs, re) in enumerate(block_rows):\n        for bc, (cs, ce) in enumerate(block_cols):\n            cnt = 0\n            for r in range(rs, re + 1):\n                for c in range(cs, ce + 1):\n                    if grid[r][c] != 0:\n                        cnt += 1\n            if (cnt > max_cnt or\n                (cnt == max_cnt and (br > source[0] or (br == source[0] and bc > source[1])))):\n                max_cnt = cnt\n                source = (br, bc)\n\n    # Determine the target block (transpose of the source)\n    sr, sc = source\n    if sr != sc:\n        tr, tc = sc, sr          # transpose\n    else:\n        # fallback when the source lies on the main diagonal\n        tr, tc = 1, 0            # middle\u2011left block (exists for the 3\u00d73 case)\n\n    # Build the output grid, preserving the separator lines\n    out = [[0] * cols for _ in range(rows)]\n    for r in sep_rows:\n        for c in range(cols):\n            out[r][c] = 5\n    for c in sep_cols:\n        for r in range(rows):\n            out[r][c] = 5\n\n    # Copy the non\u2011zero values from the source block to the target block\n    rs = block_rows[sr][0]\n    cs = block_cols[sc][0]\n    rt = block_rows[tr][0]\n    ct = block_cols[tc][0]\n    for dr in range(bh):\n        for dc in range(bw):\n            val = grid[rs + dr][cs + dc]\n            if val != 0:\n                out[rt + dr][ct + dc] = val\n\n    return out",
