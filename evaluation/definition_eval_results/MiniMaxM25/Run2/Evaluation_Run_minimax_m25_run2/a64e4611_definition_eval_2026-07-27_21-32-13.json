  "raw_response": "```python\nfrom collections import deque\nfrom typing import List\n\ndef solve(grid: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Fill the interior of the shape formed by the non\u2011zero colour.\n    Starting from every zero in the top row we perform a monotone\n    flood\u2011fill (only moves down or right).  Any zero that cannot be\n    reached by this fill is considered interior and is recoloured with 3.\n    All other cells remain unchanged.\n    \"\"\"\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # visited mask\n    visited = [[False] * cols for _ in range(rows)]\n    q = deque()\n\n    # start from every zero in the top row (row 0)\n    for c in range(cols):\n        if grid[0][c] == 0:\n            visited[0][c] = True\n            q.append((0, c))\n\n    # monotone BFS: only move down (r+1, c) or right (r, c+1)\n    while q:\n        r, c = q.popleft()\n        # down\n        nr = r + 1\n        if nr < rows and not visited[nr][c] and grid[nr][c] == 0:\n            visited[nr][c] = True\n            q.append((nr, c))\n        # right\n        nc = c + 1\n        if nc < cols and not visited[r][nc] and grid[r][nc] == 0:\n            visited[r][nc] = True\n            q.append((r, nc))\n\n    # colour interior (unvisited) zeros with 3\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                grid[r][c] = 3\n\n    return grid\n```",
  "script": "from collections import deque\nfrom typing import List\n\ndef solve(grid: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Fill the interior of the shape formed by the non\u2011zero colour.\n    Starting from every zero in the top row we perform a monotone\n    flood\u2011fill (only moves down or right).  Any zero that cannot be\n    reached by this fill is considered interior and is recoloured with 3.\n    All other cells remain unchanged.\n    \"\"\"\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # visited mask\n    visited = [[False] * cols for _ in range(rows)]\n    q = deque()\n\n    # start from every zero in the top row (row 0)\n    for c in range(cols):\n        if grid[0][c] == 0:\n            visited[0][c] = True\n            q.append((0, c))\n\n    # monotone BFS: only move down (r+1, c) or right (r, c+1)\n    while q:\n        r, c = q.popleft()\n        # down\n        nr = r + 1\n        if nr < rows and not visited[nr][c] and grid[nr][c] == 0:\n            visited[nr][c] = True\n            q.append((nr, c))\n        # right\n        nc = c + 1\n        if nc < cols and not visited[r][nc] and grid[r][nc] == 0:\n            visited[r][nc] = True\n            q.append((r, nc))\n\n    # colour interior (unvisited) zeros with 3\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 0 and not visited[r][c]:\n                grid[r][c] = 3\n\n    return grid",
