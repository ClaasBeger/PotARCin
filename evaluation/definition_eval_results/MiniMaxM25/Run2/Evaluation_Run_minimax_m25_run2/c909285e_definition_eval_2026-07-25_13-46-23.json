  "raw_response": "def solve(grid):\n    # Find the value that appears exactly on a rectangular border\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Collect all distinct values in the grid\n    distinct = set()\n    for r in grid:\n        distinct.update(r)\n\n    target = None\n    min_r = max_r = min_c = max_c = None\n\n    for v in distinct:\n        # Determine bounding box of all cells containing v\n        m_r = M_r = m_c = M_c = None\n        count = 0\n        for i in range(rows):\n            for j in range(cols):\n                if grid[i][j] == v:\n                    count += 1\n                    if m_r is None:\n                        m_r = M_r = i\n                        m_c = M_c = j\n                    else:\n                        if i < m_r: m_r = i\n                        if i > M_r: M_r = i\n                        if j < m_c: m_c = j\n                        if j > M_c: M_c = j\n        if m_r is None:\n            continue\n\n        height = M_r - m_r + 1\n        width = M_c - m_c + 1\n        if height < 2 or width < 2:\n            continue\n\n        # Expected number of cells on the perimeter of a rectangle\n        expected = 2 * height + 2 * width - 4\n        if count != expected:\n            continue\n\n        # Ensure no v appears inside the rectangle\n        interior_clear = True\n        for i in range(m_r + 1, M_r):\n            for j in range(m_c + 1, M_c):\n                if grid[i][j] == v:\n                    interior_clear = False\n                    break\n            if not interior_clear:\n                break\n\n        if interior_clear:\n            target = v\n            min_r, max_r, min_c, max_c = m_r, M_r, m_c, M_c\n            break\n\n    # Extract the sub\u2011grid defined by the border\n    if target is None:\n        return grid  # should not happen for valid inputs\n\n    result = [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n    return result",
  "script": "def solve(grid):\n    # Find the value that appears exactly on a rectangular border\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Collect all distinct values in the grid\n    distinct = set()\n    for r in grid:\n        distinct.update(r)\n\n    target = None\n    min_r = max_r = min_c = max_c = None\n\n    for v in distinct:\n        # Determine bounding box of all cells containing v\n        m_r = M_r = m_c = M_c = None\n        count = 0\n        for i in range(rows):\n            for j in range(cols):\n                if grid[i][j] == v:\n                    count += 1\n                    if m_r is None:\n                        m_r = M_r = i\n                        m_c = M_c = j\n                    else:\n                        if i < m_r: m_r = i\n                        if i > M_r: M_r = i\n                        if j < m_c: m_c = j\n                        if j > M_c: M_c = j\n        if m_r is None:\n            continue\n\n        height = M_r - m_r + 1\n        width = M_c - m_c + 1\n        if height < 2 or width < 2:\n            continue\n\n        # Expected number of cells on the perimeter of a rectangle\n        expected = 2 * height + 2 * width - 4\n        if count != expected:\n            continue\n\n        # Ensure no v appears inside the rectangle\n        interior_clear = True\n        for i in range(m_r + 1, M_r):\n            for j in range(m_c + 1, M_c):\n                if grid[i][j] == v:\n                    interior_clear = False\n                    break\n            if not interior_clear:\n                break\n\n        if interior_clear:\n            target = v\n            min_r, max_r, min_c, max_c = m_r, M_r, m_c, M_c\n            break\n\n    # Extract the sub\u2011grid defined by the border\n    if target is None:\n        return grid  # should not happen for valid inputs\n\n    result = [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n    return result",
