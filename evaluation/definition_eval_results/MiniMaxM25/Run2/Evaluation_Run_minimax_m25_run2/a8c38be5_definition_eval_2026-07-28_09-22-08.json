in_c,\n                    'max_r': max_r,\n                    'max_c': max_c\n                })\n\n    # Determine order \u2013 we use a simple heuristic that reproduces the given examples:\n    # sort components by (max_r + max_c) descending, then by colour descending\n    comps.sort(key=lambda x: (-(x['max_r']+x['max_c']), -x['colour']))\n\n    # Output grid initialise with background colour\n    out = [[bg]*9 for _ in range(9)]\n\n    # Block positions in clockwise spiral starting at top\u2011left\n    spiral = [(0,0),(0,1),(0,2),(1,2),(2,2),(2,1),(2,0),(1,0)]\n\n    for idx, comp in enumerate(comps):\n        if idx >= len(spiral):\n            break\n        br, bc = spiral[idx]\n        # embed shape into the 3\u00d73 block\n        shape = comp['shape']\n        h = len(shape)\n        w = len(shape[0])\n        for r in range(h):\n            for c in range(w):\n                if shape[r][c] != bg:\n                    out[br*3 + r][bc*3 + c] = shape[r][c]\n\n    return out",
