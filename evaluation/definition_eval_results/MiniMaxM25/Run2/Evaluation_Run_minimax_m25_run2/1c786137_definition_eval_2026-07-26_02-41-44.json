0 4 9 0 6 0 0 0 6 0 0\n0 0 4 6 3 9 4 6 0 9 0 9 0 0 0 0\n9 9 4 4 4 4 4 9 9 0 9 9 0 0 0 6\nOutput:\n3 3 0\n9 3 9\n6 6 0\n9 0 0\n6 3 9\n\nExample 3:\n\nInput:\n2 5 0 0 3 0 0 2 0 0 0 0 0 0 3 5 3 5\n2 0 0 2 0 2 2 2 2 2 2 5 3 0 3 2 0 5\n0 5 5 8 8 8 8 8 8 8 8 8 8 8 8 5 0 0\n2 0 2 8 0 0 5 3 3 3 2 2 5 0 8 2 5 5\n5 0 3 8 3 0 0 5 5 5 5 2 0 5 8 3 3 3\n0 5 5 8 3 5 0 2 0 3 0 5 3 0 8 0 2 5\n5 2 2 8 3 2 5 5 0 5 3 0 5 0 8 0 0 0\n0 0 0 8 5 2 5 2 5 0 2 2 2 2 8 2 0 5\n5 0 5 8 0 5 2 5 0 0 0 0 3 3 8 0 0 5\n3 0 0 8 2 3 2 3 0 0 5 0 5 0 8 3 2 0\n3 5 0 8 3 2 5 0 5 0 0 0 5 5 8 0 0 2\n3 3 0 8 8 8 8 8 8 8 8 8 8 8 8 0 2 0\n5 0 0 3 0 3 3 5 2 5 0 0 0 0 0 5 0 0\n2 5 2 5 2 2 0 0 0 5 2 0 2 0 3 0 3 0\n0 2 2 2 2 0 0 2 0 2 3 3 2 0 2 5 2 5\n3 0 0 0 0 5 3 0 0 0 2 2 5 0 2 3 2 0\n0 0 2 5 0 5 0 3 0 0 0 0 2 3 3 5 2 3\nOutput:\n0 0 5 3 3 3 2 2 5 0\n3 0 0 5 5 5 5 2 0 5\n3 5 0 2 0 3 0 5 3 0\n3 2 5 5 0 5 3 0 5 0\n5 2 5 2 5 0 2 2 2 2\n0 5 2 5 0 0 0 0 3 3\n2 3 2 3 0 0 5 0 5 0\n3 2 5 0 5 0 0 0 5 5\n\nBelow is a test input grid.\n\nInput:\n0 0 0 8 1 1 8 0 0 8 0 8 0 0 0 8\n0 1 0 8 8 1 0 1 1 2 8 1 1 2 0 2\n0 0 8 8 1 1 8 8 1 1 8 0 8 0 0 1\n1 0 1 0 8 0 1 8 1 0 1 1 8 8 8 0\n8 0 8 3 3 3 3 3 3 3 3 3 3 3 0 2\n1 0 8 3 2 0 8 1 1 1 0 1 0 3 0 0\n0 8 8 3 8 1 0 8 2 8 1 2 8 3 1 8\n1 0 8 3 8 2 0 2 0 1 1 8 1 3 8 8\n0 8 0 3 0 1 8 8 1 1 8 1 8 3 2 1\n1 0 0 3 0 1 8 8 0 8 0 2 0 3 8 1\n0 8 8 3 0 8 8 2 8 8 8 8 8 3 8 8\n1 1 1 3 8 0 2 0 0 0 0 8 8 3 8 0\n1 8 0 3 0 2 8 8 1 2 0 0 2 3 8 1\n8 1 1 3 3 3 3 3 3 3 3 3 3 3 0 2\n8 1 0 0 0 0 8 8 0 1 2 8 8 8 1 8\n8 1 0 0 1 1 8 0 1 2 8 1 0 1 2 0\n8 0 8 2 8 0 8 2 0 1 8 1 8 1 8 8\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    \"\"\"\n    Extracts the interior of the rectangular frame formed by a single colour.\n    The frame is a rectangle whose border (top, bottom, left, right sides) are\n    all the same colour. The interior (the cells strictly inside the border)\n    is returned as a new grid.\n    \"\"\"\n    if not grid:\n        return []\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # Gather bounding box for each colour appearing in the grid\n    bounds = {}\n    for i in range(rows):\n        for j in range(cols):\n            v = grid[i][j]\n            if v not in bounds:\n                bounds[v] = {'min_r': i, 'max_r': i, 'min_c': j, 'max_c': j}\n            else:\n                b = bounds[v]\n                if i < b['min_r']:\n                    b['min_r'] = i\n                if i > b['max_r']:\n                    b['max_r'] = i\n                if j < b['min_c']:\n                    b['min_c'] = j\n                if j > b['max_c']:\n                    b['max_c'] = j\n\n    candidates = []\n    for v, b in bounds.items():\n        min_r, max_r = b['min_r'], b['max_r']\n        min_c, max_c = b['min_c'], b['max_c']\n\n        # Rectangle must be at least 3x3 to have an interior\n        if max_r - min_r < 2 or max_c - min_c < 2:\n            continue\n\n        # Verify that the whole border consists of colour v\n        top_ok = all(grid[min_r][c] == v for c in range(min_c, max_c + 1))\n        bottom_ok = all(grid[max_r][c] == v for c in range(min_c, max_c + 1))\n        left_ok = all(grid[r][min_c] == v for r in range(min_r, max_r + 1))\n        right_ok = all(grid[r][max_c] == v for r in range(min_r, max_r + 1))\n\n        if top_ok and bottom_ok and left_ok and right_ok:\n            area = (max_r - min_r + 1) * (max_c - min_c + 1)\n            candidates.append((area, min_r, max_r, min_c, max_c))\n\n    if not candidates:\n        # No frame found \u2013 return empty (should not happen for valid inputs)\n        return []\n\n    # Choose the frame with the largest area (prefer the obvious one)\n    candidates.sort(key=lambda x: -x[0])\n    _, min_r, max_r, min_c, max_c = candidates[0]\n\n    # Extract interior: rows (min_r+1 .. max_r-1), columns (min_c+1 .. max_c-1)\n    interior = [row[min_c + 1:max_c] for row in grid[min_r + 1:max_r]]\n    return interior",
