  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n else 0\n\n    # locate the 8\n    r0 = c0 = -1\n    for i in range(n):\n        for j in range(m):\n            if grid[i][j] == 8:\n                r0, c0 = i, j\n                break\n        if r0 != -1:\n            break\n    if r0 == -1:\n        return grid\n\n    # upward (negative row offset)\n    k = 1\n    while True:\n        r = r0 - k\n        if r < 0:\n            break\n        if k & 1:                     # odd k\n            offset = k - 1\n            c = c0 + offset\n            if 0 <= c < m and grid[r][c] == 0:\n                grid[r][c] = 5\n        else:                         # even k\n            for offset in range(k - 2, k + 1):\n                c = c0 + offset\n                if 0 <= c < m and grid[r][c] == 0:\n                    grid[r][c] = 5\n        k += 1\n\n    # downward (positive row offset)\n    k = 1\n    while True:\n        r = r0 + k\n        if r >= n:\n            break\n        if k & 1:                     # odd k\n            offset = -(k - 1)\n            c = c0 + offset\n            if 0 <= c < m and grid[r][c] == 0:\n                grid[r][c] = 5\n        else:                         # even k\n            for offset in range(-k, -(k - 2) + 1):\n                c = c0 + offset\n                if 0 <= c < m and grid[r][c] == 0:\n                    grid[r][c] = 5\n        k += 1\n\n    return grid",
