if grid[r][c] != 0 and grid[r][c] != marker_color and not visited[r][c]:\n                color = grid[r][c]\n                cells = bfs(r,c,color)\n                # bounding box\n                min_r = min(cells, key=lambda p:p[0])[0]\n                max_r = max(cells, key=lambda p:p[0])[0]\n                min_c = min(cells, key=lambda p:p[1])[1]\n                max_c = max(cells, key=lambda p:p[1])[1]\n                bbox = (min_r, max_r, min_c, max_c)\n                components.append({\n                    'cells': cells,\n                    'color': color,\n                    'bbox': bbox,\n                    'area': (max_r-min_r+1)*(max_c-min_c+1)\n                })\n\n    # ------------------------------------------------------------------\n    # 3. keep only components whose colour appears once (i.e. a single\n    #    connected component).  Colours with more than one component are ignored.\n    # ------------------------------------------------------------------\n    color_to_num_components = {}\n    for comp in components:\n        col = comp['color']\n        color_to_num_components[col] = color_to_num_components.get(col, 0) + 1\n\n    filtered_components = [comp for comp in components\n                           if color_to_num_components[comp['color']] == 1]\n\n    # ------------------------------------------------------------------\n    # 4. compute Chebyshev distance from the marker to each component\n    # ------------------------------------------------------------------\n    def chebyshev_distance(comp):\n        # minimum Chebyshev distance from marker to any cell of the component\n        return min( max(abs(mr - cr), abs(mc - cc)) for cr, cc in comp['cells'] )\n\n    distances = [ (comp, chebyshev_distance(comp)) for comp in filtered_components ]\n\n    # ------------------------------------------------------------------\n    # 5. pick the component(s) with smallest distance, then smallest bbox area\n    # ------------------------------------------------------------------\n    min_dist = min(d for _,d in distances)\n    best_comps = [comp for comp, d in distances if d == min_dist]\n    # tie\u2011break by bounding\u2011box area\n    best = min(best_comps, key=lambda c: c['area'])\n\n    # ------------------------------------------------------------------\n    # 6. fill orthogonal neighbours of the chosen component with the marker colour\n    # ------------------------------------------------------------------\n    # work on a copy so we can modify it\n    out_grid = [row[:] for row in grid]\n\n    for (r,c) in best['cells']:\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            nr, nc = r+dr, c+dc\n            if 0 <= nr < rows and 0 <= nc < cols:\n                if out_grid[nr][nc] == 0:          # only fill empty cells\n                    out_grid[nr][nc] = marker_color\n\n    return out_grid",
