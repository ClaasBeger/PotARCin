  "raw_response": "def solve(grid):\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # collect distinct non\u2011zero values, process in decreasing order\n    values = sorted({v for row in grid for v in row if v != 0}, reverse=True)\n\n    # for each value, repeatedly expand horizontally and vertically until nothing changes\n    for v in values:\n        # current positions of this value (includes the seeds that are already placed)\n        positions = {(i, j) for i in range(rows) for j in range(cols) if grid[i][j] == v}\n        while True:\n            added = False\n\n            # map rows to list of columns and columns to list of rows for current value\n            row_cols = {}\n            col_rows = {}\n            for i, j in positions:\n                row_cols.setdefault(i, []).append(j)\n                col_rows.setdefault(j, []).append(i)\n\n            # horizontal fills\n            for i, lst in row_cols.items():\n                c_min = min(lst)\n                c_max = max(lst)\n                for c in range(c_min, c_max + 1):\n                    if grid[i][c] != v and (grid[i][c] == 0 or grid[i][c] > v):\n                        grid[i][c] = v\n                        added = True\n                        positions.add((i, c))\n\n            # vertical fills\n            for j, lst in col_rows.items():\n                r_min = min(lst)\n                r_max = max(lst)\n                for r in range(r_min, r_max + 1):\n                    if grid[r][j] != v and (grid[r][j] == 0 or grid[r][j] > v):\n                        grid[r][j] = v\n                        added = True\n                        positions.add((r, j))\n\n            if not added:\n                break\n\n    return grid",
  "script": "def solve(grid):\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # collect distinct non\u2011zero values, process in decreasing order\n    values = sorted({v for row in grid for v in row if v != 0}, reverse=True)\n\n    # for each value, repeatedly expand horizontally and vertically until nothing changes\n    for v in values:\n        # current positions of this value (includes the seeds that are already placed)\n        positions = {(i, j) for i in range(rows) for j in range(cols) if grid[i][j] == v}\n        while True:\n            added = False\n\n            # map rows to list of columns and columns to list of rows for current value\n            row_cols = {}\n            col_rows = {}\n            for i, j in positions:\n                row_cols.setdefault(i, []).append(j)\n                col_rows.setdefault(j, []).append(i)\n\n            # horizontal fills\n            for i, lst in row_cols.items():\n                c_min = min(lst)\n                c_max = max(lst)\n                for c in range(c_min, c_max + 1):\n                    if grid[i][c] != v and (grid[i][c] == 0 or grid[i][c] > v):\n                        grid[i][c] = v\n                        added = True\n                        positions.add((i, c))\n\n            # vertical fills\n            for j, lst in col_rows.items():\n                r_min = min(lst)\n                r_max = max(lst)\n                for r in range(r_min, r_max + 1):\n                    if grid[r][j] != v and (grid[r][j] == 0 or grid[r][j] > v):\n                        grid[r][j] = v\n                        added = True\n                        positions.add((r, j))\n\n            if not added:\n                break\n\n    return grid",
