  "raw_response": "def solve(grid):\n    # Find dimensions\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Count non\u2011zero colors\n    counts = {}\n    for r in range(rows):\n        for v in grid[r]:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n\n    if not counts:\n        return grid  # no action\n\n    # Dominant color: the one with the largest count (if tie, smallest value)\n    max_cnt = max(counts.values())\n    dominant = min(v for v, c in counts.items() if c == max_cnt)\n\n    # Unique color: the one that appears exactly once\n    unique = None\n    for v, c in counts.items():\n        if c == 1:\n            unique = v\n            break\n\n    # If there is no unique color, nothing to move\n    if unique is None:\n        # Just erase all non\u2011dominant colors\n        out = [row[:] for row in grid]\n        for r in range(rows):\n            for c in range(cols):\n                if out[r][c] != 0 and out[r][c] != dominant:\n                    out[r][c] = 0\n        return out\n\n    # Locate the original position of the unique cell\n    orig_pos = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == unique:\n                orig_pos = (r, c)\n                break\n        if orig_pos is not None:\n            break\n\n    # Build a set of positions of the dominant colour\n    dominant_pos = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == dominant:\n                dominant_pos.add((r, c))\n\n    # Helper to test adjacency (including diagonals)\n    def is_adjacent(r, c):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) in dominant_pos:\n                    return True\n        return False\n\n    # Find all empty cells adjacent to any dominant cell\n    best = None\n    best_dist = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:  # not empty\n                continue\n            if (r, c) == orig_pos:\n                continue  # don't consider the original spot\n            if is_adjacent(r, c):\n                dist = abs(r - orig_pos[0]) + abs(c - orig_pos[1])\n                if best_dist is None or dist < best_dist or (dist == best_dist and (r < best[0] or (r == best[0] and c < best[1]))):\n                    best_dist = dist\n                    best = (r, c)\n\n    # Build output grid: start from the original, erase all colors except dominant and unique\n    out = [row[:] for row in grid]\n    for r in range(rows):\n        for c in range(cols):\n            if out[r][c] != 0 and out[r][c] != dominant and out[r][c] != unique:\n                out[r][c] = 0\n\n    # Move the unique cell if a target position was found\n    if best is not None:\n        # clear original position\n        out[orig_pos[0]][orig_pos[1]] = 0\n        # place unique at new position\n        out[best[0]][best[1]] = unique\n\n    return out",
  "script": "def solve(grid):\n    # Find dimensions\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Count non\u2011zero colors\n    counts = {}\n    for r in range(rows):\n        for v in grid[r]:\n            if v != 0:\n                counts[v] = counts.get(v, 0) + 1\n\n    if not counts:\n        return grid  # no action\n\n    # Dominant color: the one with the largest count (if tie, smallest value)\n    max_cnt = max(counts.values())\n    dominant = min(v for v, c in counts.items() if c == max_cnt)\n\n    # Unique color: the one that appears exactly once\n    unique = None\n    for v, c in counts.items():\n        if c == 1:\n            unique = v\n            break\n\n    # If there is no unique color, nothing to move\n    if unique is None:\n        # Just erase all non\u2011dominant colors\n        out = [row[:] for row in grid]\n        for r in range(rows):\n            for c in range(cols):\n                if out[r][c] != 0 and out[r][c] != dominant:\n                    out[r][c] = 0\n        return out\n\n    # Locate the original position of the unique cell\n    orig_pos = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == unique:\n                orig_pos = (r, c)\n                break\n        if orig_pos is not None:\n            break\n\n    # Build a set of positions of the dominant colour\n    dominant_pos = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == dominant:\n                dominant_pos.add((r, c))\n\n    # Helper to test adjacency (including diagonals)\n    def is_adjacent(r, c):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) in dominant_pos:\n                    return True\n        return False\n\n    # Find all empty cells adjacent to any dominant cell\n    best = None\n    best_dist = None\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:  # not empty\n                continue\n            if (r, c) == orig_pos:\n                continue  # don't consider the original spot\n            if is_adjacent(r, c):\n                dist = abs(r - orig_pos[0]) + abs(c - orig_pos[1])\n                if best_dist is None or dist < best_dist or (dist == best_dist and (r < best[0] or (r == best[0] and c < best[1]))):\n                    best_dist = dist\n                    best = (r, c)\n\n    # Build output grid: start from the original, erase all colors except dominant and unique\n    out = [row[:] for row in grid]\n    for r in range(rows):\n        for c in range(cols):\n            if out[r][c] != 0 and out[r][c] != dominant and out[r][c] != unique:\n                out[r][c] = 0\n\n    # Move the unique cell if a target position was found\n    if best is not None:\n        # clear original position\n        out[orig_pos[0]][orig_pos[1]] = 0\n        # place unique at new position\n        out[best[0]][best[1]] = unique\n\n    return out",
