side_start, centre_r + d + 1))\n\n        # if a zero appears among the three sampled cells, keep values up to that zero\n        first_zero = -1\n        for i, v in enumerate(vals):\n            if v == 0:\n                first_zero = i\n                break\n        if first_zero != -1:\n            # keep everything up to and including the zero, pad with zeros after it\n            for i in range(first_zero + 1, 3):\n                vals[i] = 0\n        else:\n            # no zero in the three sampled cells\n            if side_has_zero:\n                # there is a zero somewhere on the side \u2192 keep only the first cell\n                vals = [vals[0], 0, 0]\n            # else keep the three cells as they are\n\n        out.append(vals)\n\n    return out",
