or markdown.",
  "raw_response": "def solve(grid):\n    from collections import deque\n\n    R = len(grid)\n    C = len(grid[0]) if R else 0\n    # find connected components of non\u2011zero cells\n    visited = [[False]*C for _ in range(R)]\n    components = []                     # list of (color, list of cells)\n\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0 and not visited[r][c]:\n                col = grid[r][c]\n                q = [(r,c)]\n                visited[r][c] = True\n                cells = []\n                while q:\n                    cr, cc = q.pop()\n                    cells.append((cr,cc))\n                    for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                        nr, nc = cr+dr, cc+dc\n                        if 0 <= nr < R and 0 <= nc < C:\n                            if not visited[nr][nc] and grid[nr][nc] == col:\n                                visited[nr][nc] = True\n                                q.append((nr,nc))\n                components.append((col, cells))\n\n    # output grid initially empty\n    out = [[0]*C for _ in range(R)]\n\n    # helper: for a component (list of coordinates) compute its bounding box and missing corner\n    for color, cells in components:\n        if len(cells) != 3:\n            continue                       # ignore anything that is not a triple\n        rows = [r for r,_ in cells]\n        cols = [c for _,c in cells]\n        min_r, max_r = min(rows), max(rows)\n        min_c, max_c = min(cols), max(cols)\n        # bounding box must be 2x2\n        if max_r - min_r != 1 or max_c - min_c != 1:\n            continue\n\n        cell_set = set(cells)\n        # which corner is missing?\n        missing = None\n        for cr, cc, name in ((min_r, min_c, 'TL'), (min_r, max_c, 'TR'),\n                              (max_r, min_c, 'BL'), (max_r, max_c, 'BR')):\n            if (cr, cc) not in cell_set:\n                missing = name\n                break\n\n        # direction towards the opposite corner\n        dir_map = {\n            'TL': ( 1,  1),   # move SE\n            'TR': ( 1, -1),   # move SW\n            'BL': (-1,  1),   # move NE\n            'BR': (-1, -1),   # move NW\n        }\n        dr, dc = dir_map[missing]\n\n        # how many diagonal steps are possible?\n        if dr == -1:\n            steps_row = min_r\n        else:\n            steps_row = (R-1) - max_r\n        if dc == -1:\n            steps_col = min_c\n        else:\n            steps_col = (C-1) - max_c\n        max_shift = min(steps_row, steps_col)\n\n        # try to place the shape as far as possible, avoiding collisions with different colours\n        shift = max_shift\n        while shift >= 0:\n            new_cells = [(r + dr*shift, c + dc*shift) for (r,c) in cells]\n            ok = True\n            for nr, nc in new_cells:\n                if out[nr][nc] != 0 and out[nr][nc] != color:\n                    ok = False\n                    break\n            if ok:\n                break\n            shift -= 1\n\n        # write the shape\n        for (r,c) in new_cells:\n            out[r][c] = color\n\n    return out",
  "script": "def solve(grid):\n    from collections import deque\n\n    R = len(grid)\n    C = len(grid[0]) if R else 0\n    # find connected components of non\u2011zero cells\n    visited = [[False]*C for _ in range(R)]\n    components = []                     # list of (color, list of cells)\n\n    for r in range(R):\n        for c in range(C):\n            if grid[r][c] != 0 and not visited[r][c]:\n                col = grid[r][c]\n                q = [(r,c)]\n                visited[r][c] = True\n                cells = []\n                while q:\n                    cr, cc = q.pop()\n                    cells.append((cr,cc))\n                    for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                        nr, nc = cr+dr, cc+dc\n                        if 0 <= nr < R and 0 <= nc < C:\n                            if not visited[nr][nc] and grid[nr][nc] == col:\n                                visited[nr][nc] = True\n                                q.append((nr,nc))\n                components.append((col, cells))\n\n    # output grid initially empty\n    out = [[0]*C for _ in range(R)]\n\n    # helper: for a component (list of coordinates) compute its bounding box and missing corner\n    for color, cells in components:\n        if len(cells) != 3:\n            continue                       # ignore anything that is not a triple\n        rows = [r for r,_ in cells]\n        cols = [c for _,c in cells]\n        min_r, max_r = min(rows), max(rows)\n        min_c, max_c = min(cols), max(cols)\n        # bounding box must be 2x2\n        if max_r - min_r != 1 or max_c - min_c != 1:\n            continue\n\n        cell_set = set(cells)\n        # which corner is missing?\n        missing = None\n        for cr, cc, name in ((min_r, min_c, 'TL'), (min_r, max_c, 'TR'),\n                              (max_r, min_c, 'BL'), (max_r, max_c, 'BR')):\n            if (cr, cc) not in cell_set:\n                missing = name\n                break\n\n        # direction towards the opposite corner\n        dir_map = {\n            'TL': ( 1,  1),   # move SE\n            'TR': ( 1, -1),   # move SW\n            'BL': (-1,  1),   # move NE\n            'BR': (-1, -1),   # move NW\n        }\n        dr, dc = dir_map[missing]\n\n        # how many diagonal steps are possible?\n        if dr == -1:\n            steps_row = min_r\n        else:\n            steps_row = (R-1) - max_r\n        if dc == -1:\n            steps_col = min_c\n        else:\n            steps_col = (C-1) - max_c\n        max_shift = min(steps_row, steps_col)\n\n        # try to place the shape as far as possible, avoiding collisions with different colours\n        shift = max_shift\n        while shift >= 0:\n            new_cells = [(r + dr*shift, c + dc*shift) for (r,c) in cells]\n            ok = True\n            for nr, nc in new_cells:\n                if out[nr][nc] != 0 and out[nr][nc] != color:\n                    ok = False\n                    break\n            if ok:\n                break\n            shift -= 1\n\n        # write the shape\n        for (r,c) in new_cells:\n            out[r][c] = color\n\n    return out",
