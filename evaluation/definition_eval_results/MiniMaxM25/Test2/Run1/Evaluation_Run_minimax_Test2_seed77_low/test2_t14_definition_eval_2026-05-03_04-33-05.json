e\n            if g[r - 1][target_col] != 0:\n                continue\n            if g[r + 1][target_col] != 0:\n                continue\n            if g[r][target_col - 1] != 0:\n                continue\n            if g[r][target_col + 1] != 0:\n                continue\n            # all cells are empty \u2013 draw the plus\n            g[r][target_col] = 4\n            g[r - 1][target_col] = 4\n            g[r + 1][target_col] = 4\n            g[r][target_col - 1] = 4\n            g[r][target_col + 1] = 4\n            break\n        return g",
