5 8 0 0 0 8 0 0 0 9 0\n0 5 0 0 0 0 0 6 0 0 9 0\n0 5 0 0 0 0 6 0 6 0 9 0\n0 0 0 3 0 6 0 0 0 6 9 0\n0 3 0 0 0 0 0 0 0 6 9 0\n0 0 8 0 0 6 0 0 0 6 9 8\n0 0 0 0 0 0 6 0 6 0 9 0\n0 0 0 0 0 0 0 6 0 0 9 0\n0 0 5 0 0 3 0 0 0 0 9 0\n0 0 0 0 0 0 0 5 0 0 9 0\n0 0 0 0 8 0 0 0 8 0 9 8\n0 0 3 0 0 0 0 0 0 0 9 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    # Determine the dimensions\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Identify rows that consist only of a single non\u2011zero colour (e.g. a line of 9s).   Those rows are left untouched.\n    uniform_rows = set()\n    for r in range(rows):\n        row = grid[r]\n        if all(v == row[0] and row[0] != 0 for v in row):\n            uniform_rows.add(r)\n    if not uniform_rows:\n        # If there is no uniform row, look for a uniform column.\n        uniform_cols = set()\n        for c in range(cols):\n            col_vals = [grid[r][c] for r in range(rows)]\n            if all(v == col_vals[0] and col_vals[0] != 0 for v in col_vals):\n                uniform_cols.add(c)\n        # For a uniform column we treat the region left of it.\n        # Compression will be performed column\u2011wise.\n        if uniform_cols:\n            # Choose the uniform column that separates the grid.\n            col = sorted(uniform_cols)[0]   # leftmost uniform column\n            # Build a new grid, initially copy of the original.\n            new_grid = [row[:] for row in grid]\n            # For each column left of the uniform column, perform vertical compression.\n            for c in range(col):\n                # Gather non\u2011zero values (ignore zeros) while preserving order from top to bottom.\n                vals = []\n                for r in range(rows):\n                    v = grid[r][c]\n                    if v != 0:\n                        vals.append(v)\n                if not vals:\n                    continue\n                # Compute gaps\n                first = None\n                last = None\n                for r in range(rows):\n                    if grid[r][c] != 0:\n                        first = r\n                        break\n                for r in range(rows-1, -1, -1):\n                    if grid[r][c] != 0:\n                        last = r\n                        break\n                top_gap = first if first is not None else 0\n                bottom_gap = (rows-1-last) if last is not None else 0\n                # Choose side with larger empty space\n                if top_gap >= bottom_gap:\n                    # compress upwards\n                    pos = 0\n                    for v in vals:\n                        new_grid[pos][c] = v\n                        pos += 1\n                else:\n                    # compress downwards\n                    pos = rows-1\n                    for v in reversed(vals):\n                        new_grid[pos][c] = v\n                        pos -= 1\n                # remaining cells become 0 already because new_grid was initialised with original values\n            return new_grid\n\n    # Default: treat rows, i.e. normal case (the examples given).\n    new_grid = [row[:] for row in grid]\n    # Process each non\u2011uniform row (rows that are not pure constant)\n    for r in range(rows):\n        if r in uniform_rows:\n            continue          # leave rows like the line of 9s unchanged\n        row = grid[r]\n        # collect non\u2011zero values (ignore 0)\n        vals = [v for v in row if v != 0]\n        if not vals:\n            continue\n        # find first and last non\u2011zero column indices\n        first = next((c for c, v in enumerate(row) if v != 0), None)\n        last = next((c for c in range(cols-1, -1, -1) if row[c] != 0), None)\n        if first is None or last is None:\n            continue\n        left_gap = first\n        right_gap = cols-1-last\n        # decide direction: side with larger empty space\n        if right_gap > left_gap:\n            # compress to the right\n            # place values preserving order starting at rightmost\u2011len(vals)+1\n            start = cols - len(vals)\n            for c, v in enumerate(vals):\n                new_grid[r][start + c] = v\n        else:\n            # compress to the left\n            start = 0\n            for c, v in enumerate(vals):\n                new_grid[r][start + c] = v\n        # remaining columns in that row are already zero from the initial copy\n    return new_grid",
