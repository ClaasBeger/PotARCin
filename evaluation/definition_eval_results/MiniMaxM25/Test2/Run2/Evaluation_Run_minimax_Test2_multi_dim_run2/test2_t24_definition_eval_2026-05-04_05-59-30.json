  "raw_response": "def solve(grid):\n    from collections import deque\n\n    rows = len(grid)\n    if rows == 0:\n        return grid\n    cols = len(grid[0])\n\n    # copy for output\n    out = [row[:] for row in grid]\n\n    visited = [[False] * cols for _ in range(rows)]\n\n    components = []  # each element is dict with keys: 'color', 'cells', 'touches_border', 'is_interior', 'is_isolated'\n\n    # find all connected components of non\u2011zero cells (4\u2011direction)\n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c] and grid[r][c] != 0:\n                color = grid[r][c]\n                q = deque()\n                q.append((r, c))\n                visited[r][c] = True\n                cells = []\n                touches_border = False\n                while q:\n                    cr, cc = q.popleft()\n                    cells.append((cr, cc))\n                    if cr == 0 or cr == rows - 1 or cc == 0 or cc == cols - 1:\n                        touches_border = True\n                    for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if not visited[nr][nc] and grid[nr][nc] == color:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n\n                # decide whether the component is isolated (no orthogonal neighbour of a different non\u2011zero colour)\n                isolated = True\n                for cr, cc in cells:\n                    for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] != 0 and grid[nr][nc] != color:\n                                isolated = False\n                                break\n                    if not isolated:\n                        break\n\n                components.append({\n                    'color': color,\n                    'cells': cells,\n                    'touches_border': touches_border,\n                    'is_interior': not touches_border,\n                    'is_isolated': isolated\n                })\n\n    # group components by colour\n    comps_by_colour = {}\n    for comp in components:\n        col = comp['color']\n        comps_by_colour.setdefault(col, []).append(comp)\n\n    # process each colour\n    for colour, comp_list in comps_by_colour.items():\n        # consider only interior isolated components\n        candidates = [c for c in comp_list if c['is_interior'] and c['is_isolated']]\n        if not candidates:\n            # no isolated interior component for this colour\n            continue\n        # choose the one with greatest row index (lowest on the grid)\n        best = max(candidates, key=lambda c: max(r for r, _ in c['cells']))\n        # apply transformation\n        if colour == 2:\n            # original 2's disappear\n            for r, c in best['cells']:\n                out[r][c] = 0\n        else:\n            for r, c in best['cells']:\n                out[r][c] = 2\n\n    # remove any remaining original 2's (in case they were not part of an isolated interior component)\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 2:\n                out[r][c] = 0\n\n    return out",
