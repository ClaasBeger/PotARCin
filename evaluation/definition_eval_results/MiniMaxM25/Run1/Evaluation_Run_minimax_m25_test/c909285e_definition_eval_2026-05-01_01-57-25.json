  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n    values = set()\n    for row in grid:\n        values.update(row)\n\n    best = None\n    best_area = -1\n    for c in values:\n        min_r, max_r = rows, -1\n        min_c, max_c = cols, -1\n        for i in range(rows):\n            for j in range(cols):\n                if grid[i][j] == c:\n                    if i < min_r:\n                        min_r = i\n                    if i > max_r:\n                        max_r = i\n                    if j < min_c:\n                        min_c = j\n                    if j > max_c:\n                        max_c = j\n        if max_r == -1:\n            continue\n\n        ok = True\n        # top row\n        for j in range(min_c, max_c + 1):\n            if grid[min_r][j] != c:\n                ok = False\n                break\n        if not ok:\n            continue\n        # bottom row\n        for j in range(min_c, max_c + 1):\n            if grid[max_r][j] != c:\n                ok = False\n                break\n        if not ok:\n            continue\n        # left column\n        for i in range(min_r, max_r + 1):\n            if grid[i][min_c] != c:\n                ok = False\n                break\n        if not ok:\n            continue\n        # right column\n        for i in range(min_r, max_r + 1):\n            if grid[i][max_c] != c:\n                ok = False\n                break\n        if not ok:\n            continue\n        # interior must not contain the border colour\n        for i in range(min_r + 1, max_r):\n            for j in range(min_c + 1, max_c):\n                if grid[i][j] == c:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if not ok:\n            continue\n\n        area = (max_r - min_r + 1) * (max_c - min_c + 1)\n        if area > best_area:\n            best_area = area\n            best = (c, 