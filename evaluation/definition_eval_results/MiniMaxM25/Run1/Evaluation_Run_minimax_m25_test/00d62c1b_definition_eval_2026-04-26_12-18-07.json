  "raw_response": "def solve(grid):\n    \"\"\"\n    Fill every cell that is zero and cannot be reached from the outer border\n    by moving orthogonally through zeros (treating any non\u2011zero as a wall).\n    Such cells are considered interior \u201choles\u201d and are coloured with 4.\n    All original 3 cells stay unchanged.\n    \"\"\"\n    if not grid:\n        return grid\n\n    n = len(grid)\n    m = len(grid[0])\n\n    # visited[i][j] == True  <=>  cell (i,j) is reachable from the border\n    visited = [[False] * m for _ in range(n)]\n    from collections import deque\n    q = deque()\n\n    # initialise queue with all border zeros\n    for i in range(n):\n        for j in (0, m - 1):\n            if 0 <= j < m and grid[i][j] == 0 and not visited[i][j]:\n                visited[i][j] = True\n                q.append((i, j))\n    for j in range(m):\n        for i in (0, n - 1):\n            if 0 <= i < n and grid[i][j] == 0 and not visited[i][j]:\n                visited[i][j] = True\n                q.append((i, j))\n\n    # orthogonal neighbours\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    while q:\n        x, y = q.popleft()\n        for dx, dy in dirs:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < n and 0 <= ny < m:\n                if not visited[nx][ny] and grid[nx][ny] == 0:\n                    visited[nx][ny] = True\n                    q.append((nx, ny))\n\n    # build output grid\n    result = [[0] * m for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            if grid[i][j] != 0:          # original non\u2011zero (e.g. 3)\n                result[i][j] = grid[i][j]\n            elif not visited[i][j]:       # interior zero -> 4\n                result[i][j] = 4\n            else:                         # reachable zero -> stay 0\n                result[i][j] = 0\n\n    return result",
  "script": "def solve(grid):\n    \"\"\"\n    Fill every cell that is zero and cannot be reached from the outer border\n    by moving orthogonally through zeros (treating any non\u2011zero as a wall).\n    Such cells are considered interior \u201choles\u201d and are coloured with 4.\n    All original 3 cells stay unchanged.\n    \"\"\"\n    if not grid:\n        return grid\n\n    n = len(grid)\n    m = len(grid[0])\n\n    # visited[i][j] == True  <=>  cell (i,j) is reachable from the border\n    visited = [[False] * m for _ in range(n)]\n    from collections import deque\n    q = deque()\n\n    # initialise queue with all border zeros\n    for i in range(n):\n        for j in (0, m - 1):\n            if 0 <= j < m and grid[i][j] == 0 and not visited[i][j]:\n                visited[i][j] = True\n                q.append((i, j))\n    for j in range(m):\n        for i in (0, n - 1):\n            if 0 <= i < n and grid[i][j] == 0 and not visited[i][j]:\n                visited[i][j] = True\n                q.append((i, j))\n\n    # orthogonal neighbours\n    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))\n    while q:\n        x, y = q.popleft()\n        for dx, dy in dirs:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < n and 0 <= ny < m:\n                if not visited[nx][ny] and grid[nx][ny] == 0:\n                    visited[nx][ny] = True\n                    q.append((nx, ny))\n\n    # build output grid\n    result = [[0] * m for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            if grid[i][j] != 0:          # original non\u2011zero (e.g. 3)\n                result[i][j] = grid[i][j]\n            elif not visited[i][j]:       # interior zero -> 4\n                result[i][j] = 4\n            else:                         # reachable zero -> stay 0\n                result[i][j] = 0\n\n    return result",
