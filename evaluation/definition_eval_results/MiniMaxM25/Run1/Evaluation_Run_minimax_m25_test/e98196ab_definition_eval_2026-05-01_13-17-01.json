0 0 0 0\n\nYour final answer should just be the python script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    # Find the separator row (all entries identical and non\u2011zero)\n    sep_index = None\n    for i, row in enumerate(grid):\n        if not row:\n            continue\n        first = row[0]\n        if first != 0 and all(x == first for x in row):\n            sep_index = i\n            break\n\n    # If no separator exists, return the grid unchanged\n    if sep_index is None:\n        return grid\n\n    # Rows above the separator form the output area\n    top = [row[:] for row in grid[:sep_index]]\n    # Rows below the separator are moved up\n    bottom = grid[sep_index+1:]\n\n    # Overlay bottom rows onto the top rows (union of non\u2011zero cells)\n    for j in range(min(len(top), len(bottom))):\n        for c in range(len(top[0])):\n            bv = bottom[j][c]\n            if bv != 0 and top[j][c] == 0:\n                top[j][c] = bv\n\n    return top",
  "script": "def solve(grid):\n    # Find the separator row (all entries identical and non\u2011zero)\n    sep_index = None\n    for i, row in enumerate(grid):\n        if not row:\n            continue\n        first = row[0]\n        if first != 0 and all(x == first for x in row):\n            sep_index = i\n            break\n\n    # If no separator exists, return the grid unchanged\n    if sep_index is None:\n        return grid\n\n    # Rows above the separator form the output area\n    top = [row[:] for row in grid[:sep_index]]\n    # Rows below the separator are moved up\n    bottom = grid[sep_index+1:]\n\n    # Overlay bottom rows onto the top rows (union of non\u2011zero cells)\n    for j in range(min(len(top), len(bottom))):\n        for c in range(len(top[0])):\n            bv = bottom[j][c]\n            if bv != 0 and top[j][c] == 0:\n                top[j][c] = bv\n\n    return top",
