  "raw_response": "def solve(grid):\n    \"\"\"\n    Finds the smallest non\u2011zero coloured region (by number of cells) in the grid,\n    extracts its minimal bounding rectangle and returns that sub\u2011grid.\n    \"\"\"\n    from collections import defaultdict\n\n    # Store for each color: [count, min_row, max_row, min_col, max_col]\n    info = {}\n\n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val == 0:\n                continue\n            if val not in info:\n                # initialise with current position\n                info[val] = [1, r, r, c, c]\n            else:\n                cnt, min_r, max_r, min_c, max_c = info[val]\n                info[val][0] = cnt + 1\n                if r < min_r:\n                    info[val][1] = r\n                if r > max_r:\n                    info[val][2] = r\n                if c < min_c:\n                    info[val][3] = c\n                if c > max_c:\n                    info[val][4] = c\n\n    # Choose the colour with the smallest cell count (tie\u2011break by lower colour value)\n    target = None\n    min_count = None\n    for colour, data in info.items():\n        cnt = data[0]\n        if min_count is None or cnt < min_count or (cnt == min_count and colour < target):\n            min_count = cnt\n            target = colour\n\n    # Bounding box of the selected colour\n    _, min_r, max_r, min_c, max_c = info[target]\n\n    # Extract the sub\u2011grid\n    result = [grid[row][min_c:max_c + 1] for row in range(min_r, max_r + 1)]\n    return result",
  "script": "def solve(grid):\n    \"\"\"\n    Finds the smallest non\u2011zero coloured region (by number of cells) in the grid,\n    extracts its minimal bounding rectangle and returns that sub\u2011grid.\n    \"\"\"\n    from collections import defaultdict\n\n    # Store for each color: [count, min_row, max_row, min_col, max_col]\n    info = {}\n\n    for r, row in enumerate(grid):\n        for c, val in enumerate(row):\n            if val == 0:\n                continue\n            if val not in info:\n                # initialise with current position\n                info[val] = [1, r, r, c, c]\n            else:\n                cnt, min_r, max_r, min_c, max_c = info[val]\n                info[val][0] = cnt + 1\n                if r < min_r:\n                    info[val][1] = r\n                if r > max_r:\n                    info[val][2] = r\n                if c < min_c:\n                    info[val][3] = c\n                if c > max_c:\n                    info[val][4] = c\n\n    # Choose the colour with the smallest cell count (tie\u2011break by lower colour value)\n    target = None\n    min_count = None\n    for colour, data in info.items():\n        cnt = data[0]\n        if min_count is None or cnt < min_count or (cnt == min_count and colour < target):\n            min_count = cnt\n            target = colour\n\n    # Bounding box of the selected colour\n    _, min_r, max_r, min_c, max_c = info[target]\n\n    # Extract the sub\u2011grid\n    result = [grid[row][min_c:max_c + 1] for row in range(min_r, max_r + 1)]\n    return result",
