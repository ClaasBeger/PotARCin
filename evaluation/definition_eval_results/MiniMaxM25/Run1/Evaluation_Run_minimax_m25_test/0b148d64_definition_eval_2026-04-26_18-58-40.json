  "raw_response": "def solve(grid):\n    # Count frequencies of each non\u2011zero value\n    from collections import Counter\n    flat = [cell for row in grid for cell in row]\n    freq = Counter()\n    for v in flat:\n        if v != 0:\n            freq[v] += 1\n\n    if not freq:                # no non\u2011zero values\n        return []\n\n    # Choose the colour with the smallest occurrence count\n    min_count = min(freq.values())\n    target = min((k for k, v in freq.items() if v == min_count),\n                 key=lambda x: x)\n\n    # Find the bounding rectangle of all cells equal to target\n    min_r = max_r = min_c = max_c = None\n    for r, row in enumerate(grid):\n        for c, cell in enumerate(row):\n            if cell == target:\n                if min_r is None:\n                    min_r = max_r = r\n                    min_c = max_c = c\n                else:\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n    # Extract the sub\u2011grid defined by the bounding box\n    result = [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n    return result",
  "script": "def solve(grid):\n    # Count frequencies of each non\u2011zero value\n    from collections import Counter\n    flat = [cell for row in grid for cell in row]\n    freq = Counter()\n    for v in flat:\n        if v != 0:\n            freq[v] += 1\n\n    if not freq:                # no non\u2011zero values\n        return []\n\n    # Choose the colour with the smallest occurrence count\n    min_count = min(freq.values())\n    target = min((k for k, v in freq.items() if v == min_count),\n                 key=lambda x: x)\n\n    # Find the bounding rectangle of all cells equal to target\n    min_r = max_r = min_c = max_c = None\n    for r, row in enumerate(grid):\n        for c, cell in enumerate(row):\n            if cell == target:\n                if min_r is None:\n                    min_r = max_r = r\n                    min_c = max_c = c\n                else:\n                    if r < min_r:\n                        min_r = r\n                    if r > max_r:\n                        max_r = r\n                    if c < min_c:\n                        min_c = c\n                    if c > max_c:\n                        max_c = c\n\n    # Extract the sub\u2011grid defined by the bounding box\n    result = [row[min_c:max_c + 1] for row in grid[min_r:max_r + 1]]\n    return result",
