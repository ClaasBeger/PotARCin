for r, cnt in row_counts[core_colour].items() if cnt >= 2]\n    core_cols = [c for c, cnt in col_counts[core_colour].items() if cnt >= 2]\n    # if the core has only one row/column we still need a centre \u2013 use min/max\n    if not core_rows:\n        core_rows = [r for r, _ in core_pos]\n    if not core_cols:\n        core_cols = [c for _, c in core_pos]\n    min_r = min(core_rows)\n    max_r = max(core_rows)\n    min_c = min(core_cols)\n    max_c = max(core_cols)\n\n    row_centre = (min_r + max_r) / 2.0\n    col_centre = (min_c + max_c) / 2.0\n\n    # make a copy of the original grid for the answer\n    out = [row[:] for row in grid]\n\n    # reflect each non\u2011zero cell across the three axes\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v == 0:\n                continue\n\n            # vertical reflection\n            rc, cc = r, int(2 * col_centre - c)\n            if 0 <= rc < rows and 0 <= cc < cols and grid[rc][cc] == 0:\n                out[rc][cc] = v\n\n            # horizontal reflection\n            rr, cc = int(2 * row_centre - r), c\n            if 0 <= rr < rows and 0 <= cc < cols and grid[rr][cc] == 0:\n                out[rr][cc] = v\n\n            # 180\u00b0 rotation (both reflections)\n            rr, cc = int(2 * row_centre - r), int(2 * col_centre - c)\n            if 0 <= rr < rows and 0 <= cc < cols and grid[rr][cc] == 0:\n                out[rr][cc] = v\n\n    return out",
