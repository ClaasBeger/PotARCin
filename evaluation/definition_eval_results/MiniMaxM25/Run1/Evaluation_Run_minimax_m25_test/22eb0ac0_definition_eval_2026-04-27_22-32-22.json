  "raw_response": "def solve(grid):\n    \"\"\"\n    Transform the input grid according to the rule:\n    If a row has non\u2011zero values at its first and last cells and those\n    values are equal, replace the entire row with that value.\n    \"\"\"\n    # Create a deep copy to avoid mutating the original\n    out = [row[:] for row in grid]\n    num_rows = len(grid)\n    num_cols = len(grid[0]) if num_rows else 0\n\n    for r in range(num_rows):\n        if grid[r][0] != 0 and grid[r][-1] != 0 and grid[r][0] == grid[r][-1]:\n            fill_value = grid[r][0]\n            out[r] = [fill_value] * num_cols\n\n    return out",
