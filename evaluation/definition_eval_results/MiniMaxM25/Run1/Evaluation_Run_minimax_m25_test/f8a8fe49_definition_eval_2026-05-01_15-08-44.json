  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Find bounding box of the color 2 (the rectangular frame)\n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 2:\n                if i < min_r:\n                    min_r = i\n                if i > max_r:\n                    max_r = i\n                if j < min_c:\n                    min_c = j\n                if j > max_c:\n                    max_c = j\n\n    height = max_r - min_r\n    width = max_c - min_c\n\n    # Create output grid and remove original 5's\n    out = [row[:] for row in grid]\n    five_positions = []\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 5:\n                five_positions.append((i, j))\n                out[i][j] = 0\n\n    # Reflect 5's across the nearest side of the 2\u2011rectangle\n    if height > width:          # taller \u2192 reflect vertically (top/bottom)\n        for r, c in five_positions:\n            dtop = r - min_r\n            dbottom = max_r - r\n            if dtop <= dbottom:\n                new_r = min_r - dtop\n            else:\n                new_r = max_r + dbottom\n            out[new_r][c] = 5\n    else:                       # wider or square \u2192 reflect horizontally (left/right)\n        for r, c in five_positions:\n            dleft = c - min_c\n            dright = max_c - c\n            if dleft <= dright:\n                new_c = min_c - dleft\n            else:\n                new_c = max_c + dright\n            out[r][new_c] = 5\n\n    return out",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Find bounding box of the color 2 (the rectangular frame)\n    min_r, max_r = rows, -1\n    min_c, max_c = cols, -1\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 2:\n                if i < min_r:\n                    min_r = i\n                if i > max_r:\n                    max_r = i\n                if j < min_c:\n                    min_c = j\n                if j > max_c:\n                    max_c = j\n\n    height = max_r - min_r\n    width = max_c - min_c\n\n    # Create output grid and remove original 5's\n    out = [row[:] for row in grid]\n    five_positions = []\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 5:\n                five_positions.append((i, j))\n                out[i][j] = 0\n\n    # Reflect 5's across the nearest side of the 2\u2011rectangle\n    if height > width:          # taller \u2192 reflect vertically (top/bottom)\n        for r, c in five_positions:\n            dtop = r - min_r\n            dbottom = max_r - r\n            if dtop <= dbottom:\n                new_r = min_r - dtop\n            else:\n                new_r = max_r + dbottom\n            out[new_r][c] = 5\n    else:                       # wider or square \u2192 reflect horizontally (left/right)\n        for r, c in five_positions:\n            dleft = c - min_c\n            dright = max_c - c\n            if dleft <= dright:\n                new_c = min_c - dleft\n            else:\n                new_c = max_c + dright\n            out[r][new_c] = 5\n\n    return out",
