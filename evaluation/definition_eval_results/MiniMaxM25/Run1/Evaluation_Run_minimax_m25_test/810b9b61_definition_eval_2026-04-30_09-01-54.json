  "raw_response": "def solve(grid):\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n\n    visited = [[False] * cols for _ in range(rows)]\n    from collections import deque\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 1 and not visited[i][j]:\n                # BFS to collect the whole component of 1s\n                q = deque()\n                q.append((i, j))\n                visited[i][j] = True\n                component = []\n\n                while q:\n                    r, c = q.popleft()\n                    component.append((r, c))\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = r + dr, c + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 1 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n\n                # Determine bounding box\n                min_r = min(r for r, _ in component)\n                max_r = max(r for r, _ in component)\n                min_c = min(c for _, c in component)\n                max_c = max(c for _, c in component)\n\n                height = max_r - min_r + 1\n                width = max_c - min_c + 1\n\n                # A ring must be at least 2x2\n                if height >= 2 and width >= 2:\n                    expected = 2 * height + 2 * width - 4  # perimeter cell count\n                    if len(component) == expected:\n                        # Verify that the interior contains no 1s\n                        is_ring = True\n                        for r in range(min_r + 1, max_r):\n                            for c in range(min_c + 1, max_c):\n                                if grid[r][c] == 1:\n                                    is_ring = False\n                                    break\n                            if not is_ring:\n                                break\n                        if is_ring:\n                            # Replace the whole border with 3\n                            for r, c in component:\n                                out[r][c] = 3\n\n    return out",
  "script": "def solve(grid):\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n\n    visited = [[False] * cols for _ in range(rows)]\n    from collections import deque\n\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 1 and not visited[i][j]:\n                # BFS to collect the whole component of 1s\n                q = deque()\n                q.append((i, j))\n                visited[i][j] = True\n                component = []\n\n                while q:\n                    r, c = q.popleft()\n                    component.append((r, c))\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = r + dr, c + dc\n                        if 0 <= nr < rows and 0 <= nc < cols:\n                            if grid[nr][nc] == 1 and not visited[nr][nc]:\n                                visited[nr][nc] = True\n                                q.append((nr, nc))\n\n                # Determine bounding box\n                min_r = min(r for r, _ in component)\n                max_r = max(r for r, _ in component)\n                min_c = min(c for _, c in component)\n                max_c = max(c for _, c in component)\n\n                height = max_r - min_r + 1\n                width = max_c - min_c + 1\n\n                # A ring must be at least 2x2\n                if height >= 2 and width >= 2:\n                    expected = 2 * height + 2 * width - 4  # perimeter cell count\n                    if len(component) == expected:\n                        # Verify that the interior contains no 1s\n                        is_ring = True\n                        for r in range(min_r + 1, max_r):\n                            for c in range(min_c + 1, max_c):\n                                if grid[r][c] == 1:\n                                    is_ring = False\n                                    break\n                            if not is_ring:\n                                break\n                        if is_ring:\n                            # Replace the whole border with 3\n                            for r, c in component:\n                                out[r][c] = 3\n\n    return out",
