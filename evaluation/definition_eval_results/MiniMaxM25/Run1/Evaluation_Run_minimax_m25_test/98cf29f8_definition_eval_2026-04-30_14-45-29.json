  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0])\n    out = [row[:] for row in grid]\n\n    # find distinct non\u2011zero colours\n    colours = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                colours.add(grid[r][c])\n\n    for colour in colours:\n        # collect all cells of this colour\n        positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == colour]\n        if not positions:\n            continue\n\n        min_r = min(r for r, c in positions)\n        max_r = max(r for r, c in positions)\n        min_c = min(c for r, c in positions)\n        max_c = max(c for r, c in positions)\n\n        # count cells per row and per column inside the bounding box\n        row_cnt = [0] * (max_r - min_r + 1)\n        col_cnt = [0] * (max_c - min_c + 1)\n        for r, c in positions:\n            row_cnt[r - min_r] += 1\n            col_cnt[c - min_c] += 1\n\n        max_row = max(row_cnt)\n        min_row = min(row_cnt)\n        max_col = max(col_cnt)\n        min_col = min(col_cnt)\n\n        # decide whether the stem is vertical or horizontal\n        if min_row < min_col:\n            # ----- vertical stem -----\n            rows_with_max = [min_r + i for i, cnt in enumerate(row_cnt) if cnt == max_row]\n            first_max = min(rows_with_max)\n            last_max = max(rows_with_max)\n\n            # rows with minimal count above and below the rectangle\n            top_min = [i for i in range(0, first_max - min_r) if row_cnt[i] == min_row]\n            bottom_min = [i for i in range(last_max - min_r + 1, max_r - min_r + 1) if row_cnt[i] == min_row]\n\n            if top_min and not bottom_min:\n                direction = 'up'\n                stem_len = len(top_min)\n            elif bottom_min and not top_min:\n                direction = 'down'\n                stem_len = len(bottom_min)\n            else:\n                continue  # no clear stem\n\n            core_rows = rows_with_max\n            h = len(core_rows)\n            core_cols = [min_c + i for i, cnt in enumerate(col_cnt) if cnt >= h]\n\n        else:\n            # ----- horizontal stem -----\n            cols_with_max = [min_c + i for i, cnt in enumerate(col_cnt) if cnt == max_col]\n            first_max = min(cols_with_max)\n            last_max = max(cols_with_max)\n\n            left_min = [i for i in range(0, first_max - min_c) if col_cnt[i] == min_col]\n            right_min = [i for i in range(last_max - min_c + 1, max_c - min_c + 1) if col_cnt[i] == min_col]\n\n            if left_min and not right_min:\n                direction = 'left'\n                stem_len = len(left_min)\n            elif right_min and not left_min:\n                direction = 'right'\n                stem_len = len(right_min)\n            else:\n                continue  # no clear stem\n\n            core_cols = cols_with_max\n            core_rows = [r for r in range(min_r, max_r + 1) if any(grid[r][c] == colour for c in core_cols)]\n\n        # remove the original shape\n        for r, c in positions:\n            out[r][c] = 0\n\n        # place the rectangle in its new position\n        if direction == 'up':\n            new_rows = [r - stem_len for r in core_rows]\n            new_cols = core_cols\n        elif direction == 'down':\n            new_rows = [r + stem_len for r in core_rows]\n            new_cols = core_cols\n        elif direction == 'left':\n            new_rows = core_rows\n            new_cols = [c - stem_len for c in core_cols]\n        else:  # right\n            new_rows = core_rows\n            new_cols = [c + stem_len for c in core_cols]\n\n        for r in new_rows:\n            for c in new_cols:\n                out[r][c] = colour\n\n    return out",
