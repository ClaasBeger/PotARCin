ar stem\n\n            core_rows = rows_with_max\n            h = len(core_rows)\n            core_cols = [min_c + i for i, cnt in enumerate(col_cnt) if cnt >= h]\n\n        else:\n            # ----- horizontal stem -----\n            cols_with_max = [min_c + i for i, cnt in enumerate(col_cnt) if cnt == max_col]\n            first_max = min(cols_with_max)\n            last_max = max(cols_with_max)\n\n            left_min = [i for i in range(0, first_max - min_c) if col_cnt[i] == min_col]\n            right_min = [i for i in range(last_max - min_c + 1, max_c - min_c + 1) if col_cnt[i] == min_col]\n\n            if left_min and not right_min:\n                direction = 'left'\n                stem_len = len(left_min)\n            elif right_min and not left_min:\n                direction = 'right'\n                stem_len = len(right_min)\n            else:\n                continue  # no clear stem\n\n            core_cols = cols_with_max\n            core_rows = [r for r in range(min_r, max_r + 1) if any(grid[r][c] == colour for c in core_cols)]\n\n        # remove the original shape\n        for r, c in positions:\n            out[r][c] = 0\n\n        # place the rectangle in its new position\n        if direction == 'up':\n            new_rows = [r - stem_len for r in core_rows]\n            new_cols = core_cols\n        elif direction == 'down':\n            new_rows = [r + stem_len for r in core_rows]\n            new_cols = core_cols\n        elif direction == 'left':\n            new_rows = core_rows\n            new_cols = [c - stem_len for c in core_cols]\n        else:  # right\n            new_rows = core_rows\n            new_cols = [c + stem_len for c in core_cols]\n\n        for r in new_rows:\n            for c in new_cols:\n                out[r][c] = colour\n\n    return out",
