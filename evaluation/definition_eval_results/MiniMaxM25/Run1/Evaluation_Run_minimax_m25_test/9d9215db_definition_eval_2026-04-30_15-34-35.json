  "raw_response": "def solve(grid):\n    H = len(grid)\n    W = len(grid[0]) if H else 0\n\n    # copy original grid\n    out = [row[:] for row in grid]\n\n    # collect positions for each non\u2011zero value\n    pos = {}\n    for i in range(H):\n        for j in range(W):\n            v = grid[i][j]\n            if v:\n                pos.setdefault(v, []).append((i, j))\n\n    # reflect each original point\n    for v, lst in pos.items():\n        for (r, c) in lst:\n            rp = H - 1 - r\n            cp = W - 1 - c\n            # place only if empty\n            if out[r][c] == 0:\n                out[r][c] = v\n            if out[r][cp] == 0:\n                out[r][cp] = v\n            if out[rp][c] == 0:\n                out[rp][c] = v\n            if out[rp][cp] == 0:\n                out[rp][cp] = v\n\n    # process each value to fill edges of its rectangle\n    for v, lst in pos.items():\n        # bounding rectangle of all reflected positions\n        min_r = H - 1\n        max_r = 0\n        min_c = W - 1\n        max_c = 0\n        for (r, c) in lst:\n            rp = H - 1 - r\n            cp = W - 1 - c\n            min_r = min(min_r, r, rp)\n            max_r = max(max_r, r, rp)\n            min_c = min(min_c, c, cp)\n            max_c = max(max_c, c, cp)\n\n        if min_r == max_r or min_c == max_c:\n            continue  # no edge\n\n        # find other values on the edges (excluding corners)\n        edge_vals = set()\n        for i in range(min_r, max_r + 1):\n            for j in range(min_c, max_c + 1):\n                val = grid[i][j]\n                if val == 0 or val == v:\n                    continue\n                # edge but not corner\n                if (i == min_r or i == max_r) and (min_c < j < max_c):\n                    edge_vals.add(val)\n                elif (j == min_c or j == max_c) and (min_r < i < max_r):\n                    edge_vals.add(val)\n\n        fill = None\n        if edge_vals:\n            fill = min(edge_vals)  # smallest different value\n        elif len(pos[v]) >= 2:\n            fill = v  # use own value\n\n        if fill is None:\n            continue\n\n        # parity of the filling value (from its original positions)\n        fpos = pos[fill][0]\n        parity_r = fpos[0] % 2\n        parity_c = fpos[1] % 2\n\n        # top and bottom edges\n        for j in range(min_c + 1, max_c):\n            if (min_r % 2 == parity_r) and (j % 2 == parity_c):\n                if out[min_r][j] == 0:\n                    out[min_r][j] = fill\n            if (max_r % 2 == parity_r) and (j % 2 == parity_c):\n                if out[max_r][j] == 0:\n                    out[max_r][j] = fill\n\n        # left and right edges\n        for i in range(min_r + 1, max_r):\n            if (i % 2 == parity_r) and (min_c % 2 == parity_c):\n                if out[i][min_c] == 0:\n                    out[i][min_c] = fill\n            if (i % 2 == parity_r) and (max_c % 2 == parity_c):\n                if out[i][max_c] == 0:\n                    out[i][max_c] = fill\n\n    return out",
