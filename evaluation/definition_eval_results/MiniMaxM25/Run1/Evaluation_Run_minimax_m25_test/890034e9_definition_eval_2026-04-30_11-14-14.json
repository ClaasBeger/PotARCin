  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Find the colour that forms a hollow rectangular border\n    color_info = {}\n    for i in range(rows):\n        for j in range(cols):\n            v = grid[i][j]\n            if v == 0:\n                continue\n            if v not in color_info:\n                color_info[v] = {'min_r': i, 'max_r': i, 'min_c': j, 'max_c': j}\n            else:\n                info = color_info[v]\n                if i < info['min_r']: info['min_r'] = i\n                if i > info['max_r']: info['max_r'] = i\n                if j < info['min_c']: info['min_c'] = j\n                if j > info['max_c']: info['max_c'] = j\n\n    border_color = None\n    for val, info in color_info.items():\n        min_r, max_r = info['min_r'], info['max_r']\n        min_c, max_c = info['min_c'], info['max_c']\n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n        if h < 3 or w < 3:\n            continue\n\n        # verify border cells are all this colour\n        border_ok = True\n        for i in range(min_r, max_r + 1):\n            for j in range(min_c, max_c + 1):\n                if i == min_r or i == max_r or j == min_c or j == max_c:\n                    if grid[i][j] != val:\n                        border_ok = False\n                        break\n            if not border_ok:\n                break\n        if not border_ok:\n            continue\n\n        # verify no such colour inside\n        interior_ok = True\n        for i in range(min_r + 1, max_r):\n            for j in range(min_c + 1, max_c):\n                if grid[i][j] == val:\n                    interior_ok = False\n                    break\n            if not interior_ok:\n                break\n        if interior_ok:\n            border_color = val\n            break\n\n    if border_color is None:\n        return grid\n\n    info = color_info[border_color]\n    h = info['max_r'] - info['min_r'] + 1\n    w = info['max_c'] - info['min_c'] + 1\n\n    # Find the first location where the interior is all zeros and the region contains no border_color\n    newR = newC = None\n    for r in range(rows - h + 1):\n        found = False\n        for c in range(cols - w + 1):\n            # region must not contain the border colour\n            region_has = False\n            for i in range(r, r + h):\n                for j in range(c, c + w):\n                    if grid[i][j] == border_color:\n                        region_has = True\n                        break\n                if region_has:\n                    break\n            if region_has:\n                continue\n            # interior must be all zeros\n            interior_ok = True\n            for i in range(r + 1, r + h - 1):\n                for j in range(c + 1, c + w - 1):\n                    if grid[i][j] != 0:\n                        interior_ok = False\n                        break\n                if not interior_ok:\n                    break\n            if interior_ok:\n                newR, newC = r, c\n                found = True\n                break\n        if found:\n            break\n\n    if newR is None:\n        return grid\n\n    # Create output grid and draw the new border\n    new_grid = [row[:] for row in grid]\n    for i in range(newR, newR + h):\n        for j in range(newC, newC + w):\n            if i == newR or i == newR + h - 1 or j == newC or j == newC + w - 1:\n                new_grid[i][j] = border_color\n\n    return new_grid",
  "script": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # Find the colour that forms a hollow rectangular border\n    color_info = {}\n    for i in range(rows):\n        for j in range(cols):\n            v = grid[i][j]\n            if v == 0:\n                continue\n            if v not in color_info:\n                color_info[v] = {'min_r': i, 'max_r': i, 'min_c': j, 'max_c': j}\n            else:\n                info = color_info[v]\n                if i < info['min_r']: info['min_r'] = i\n                if i > info['max_r']: info['max_r'] = i\n                if j < info['min_c']: info['min_c'] = j\n                if j > info['max_c']: info['max_c'] = j\n\n    border_color = None\n    for val, info in color_info.items():\n        min_r, max_r = info['min_r'], info['max_r']\n        min_c, max_c = info['min_c'], info['max_c']\n        h = max_r - min_r + 1\n        w = max_c - min_c + 1\n        if h < 3 or w < 3:\n            continue\n\n        # verify border cells are all this colour\n        border_ok = True\n        for i in range(min_r, max_r + 1):\n            for j in range(min_c, max_c + 1):\n                if i == min_r or i == max_r or j == min_c or j == max_c:\n                    if grid[i][j] != val:\n                        border_ok = False\n                        break\n            if not border_ok:\n                break\n        if not border_ok:\n            continue\n\n        # verify no such colour inside\n        interior_ok = True\n        for i in range(min_r + 1, max_r):\n            for j in range(min_c + 1, max_c):\n                if grid[i][j] == val:\n                    interior_ok = False\n                    break\n            if not interior_ok:\n                break\n        if interior_ok:\n            border_color = val\n            break\n\n    if border_color is None:\n        return grid\n\n    info = color_info[border_color]\n    h = info['max_r'] - info['min_r'] + 1\n    w = info['max_c'] - info['min_c'] + 1\n\n    # Find the first location where the interior is all zeros and the region contains no border_color\n    newR = newC = None\n    for r in range(rows - h + 1):\n        found = False\n        for c in range(cols - w + 1):\n            # region must not contain the border colour\n            region_has = False\n            for i in range(r, r + h):\n                for j in range(c, c + w):\n                    if grid[i][j] == border_color:\n                        region_has = True\n                        break\n                if region_has:\n                    break\n            if region_has:\n                continue\n            # interior must be all zeros\n            interior_ok = True\n            for i in range(r + 1, r + h - 1):\n                for j in range(c + 1, c + w - 1):\n                    if grid[i][j] != 0:\n                        interior_ok = False\n                        break\n                if not interior_ok:\n                    break\n            if interior_ok:\n                newR, newC = r, c\n                found = True\n                break\n        if found:\n            break\n\n    if newR is None:\n        return grid\n\n    # Create output grid and draw the new border\n    new_grid = [row[:] for row in grid]\n    for i in range(newR, newR + h):\n        for j in range(newC, newC + w):\n            if i == newR or i == newR + h - 1 or j == newC or j == newC + w - 1:\n                new_grid[i][j] = border_color\n\n    return new_grid",
