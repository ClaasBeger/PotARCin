  "raw_response": "def solve(grid):\n    # Find the border colour (non\u2011zero constant that fills whole border rows/columns)\n    h = len(grid)\n    w = len(grid[0])\n    border_color = None\n    for r in range(h):\n        row = grid[r]\n        if len(set(row)) == 1 and row[0] != 0:\n            border_color = row[0]\n            break\n    if border_color is None:          # should not happen for valid inputs\n        border_color = 0\n\n    # Number of interior blocks (each block is 2x2)\n    nbr = (h + 1) // 3          # block rows\n    nbc = (w + 1) // 3          # block columns\n\n    # Reconstruct the block grid (colour for each 2x2 interior block)\n    block = [[0] * nbc for _ in range(nbr)]\n    for br in range(nbr):\n        for bc in range(nbc):\n            val = grid[br * 3][bc * 3]            # top\u2011left cell of the block\n            if val != 0 and val != border_color:\n                block[br][bc] = val\n\n    # Build colour \u2192 list of block positions\n    from collections import defaultdict\n    colour_pos = defaultdict(list)\n    for br in range(nbr):\n        for bc in range(nbc):\n            c = block[br][bc]\n            if c != 0:\n                colour_pos[c].append((br, bc))\n\n    # Determine the blocks that must be filled\n    fill = set()\n    for col, positions in colour_pos.items():\n        # original blocks\n        for br, bc in positions:\n            fill.add((br, bc, col))\n\n        # horizontal filling\n        rows_by_br = defaultdict(list)\n        for br, bc in positions:\n            rows_by_br[br].append(bc)\n        for br, bcs in rows_by_br.items():\n            if len(set(bcs)) > 1:\n                mn = min(bcs)\n                mx = max(bcs)\n                for bc in range(mn, mx + 1):\n                    fill.add((br, bc, col))\n\n        # vertical filling\n        cols_by_bc = defaultdict(list)\n        for br, bc in positions:\n            cols_by_bc[bc].append(br)\n        for bc, brs in cols_by_bc.items():\n            if len(set(brs)) > 1:\n                mn = min(brs)\n                mx = max(brs)\n                for br in range(mn, mx + 1):\n                    fill.add((br, bc, col))\n\n    # Apply the filling to the block grid\n    for br, bc, col in fill:\n        block[br][bc] = col\n\n    # Reconstruct the full grid from the block grid\n    out = [[0] * w for _ in range(h)]\n    for r in range(h):\n        for c in range(w):\n            if r % 3 == 2 or c % 3 == 2:\n                out[r][c] = border_color\n            else:\n                out[r][c] = block[r // 3][c // 3]\n\n    return out",
  "script": "def solve(grid):\n    # Find the border colour (non\u2011zero constant that fills whole border rows/columns)\n    h = len(grid)\n    w = len(grid[0])\n    border_color = None\n    for r in range(h):\n        row = grid[r]\n        if len(set(row)) == 1 and row[0] != 0:\n            border_color = row[0]\n            break\n    if border_color is None:          # should not happen for valid inputs\n        border_color = 0\n\n    # Number of interior blocks (each block is 2x2)\n    nbr = (h + 1) // 3          # block rows\n    nbc = (w + 1) // 3          # block columns\n\n    # Reconstruct the block grid (colour for each 2x2 interior block)\n    block = [[0] * nbc for _ in range(nbr)]\n    for br in range(nbr):\n        for bc in range(nbc):\n            val = grid[br * 3][bc * 3]            # top\u2011left cell of the block\n            if val != 0 and val != border_color:\n                block[br][bc] = val\n\n    # Build colour \u2192 list of block positions\n    from collections import defaultdict\n    colour_pos = defaultdict(list)\n    for br in range(nbr):\n        for bc in range(nbc):\n            c = block[br][bc]\n            if c != 0:\n                colour_pos[c].append((br, bc))\n\n    # Determine the blocks that must be filled\n    fill = set()\n    for col, positions in colour_pos.items():\n        # original blocks\n        for br, bc in positions:\n            fill.add((br, bc, col))\n\n        # horizontal filling\n        rows_by_br = defaultdict(list)\n        for br, bc in positions:\n            rows_by_br[br].append(bc)\n        for br, bcs in rows_by_br.items():\n            if len(set(bcs)) > 1:\n                mn = min(bcs)\n                mx = max(bcs)\n                for bc in range(mn, mx + 1):\n                    fill.add((br, bc, col))\n\n        # vertical filling\n        cols_by_bc = defaultdict(list)\n        for br, bc in positions:\n            cols_by_bc[bc].append(br)\n        for bc, brs in cols_by_bc.items():\n            if len(set(brs)) > 1:\n                mn = min(brs)\n                mx = max(brs)\n                for br in range(mn, mx + 1):\n                    fill.add((br, bc, col))\n\n    # Apply the filling to the block grid\n    for br, bc, col in fill:\n        block[br][bc] = col\n\n    # Reconstruct the full grid from the block grid\n    out = [[0] * w for _ in range(h)]\n    for r in range(h):\n        for c in range(w):\n            if r % 3 == 2 or c % 3 == 2:\n                out[r][c] = border_color\n            else:\n                out[r][c] = block[r // 3][c // 3]\n\n    return out",
