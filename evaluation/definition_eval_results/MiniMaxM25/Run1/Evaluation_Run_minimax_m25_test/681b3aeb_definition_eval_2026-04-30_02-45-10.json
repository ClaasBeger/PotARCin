ttern'][i][j]\n            if v:\n                canvas[i][j] = v\n\n    # Try to place the second shape\n    best_visible = -1\n    best_r = best_c = 0\n    second_area = second['area']\n\n    # row_offset goes from bottom\u2011aligned to top\u2011aligned\n    for row_off in range(N - second['height'], -1, -1):\n        for col_off in range(0, N + 1):          # allow partial overflow\n            visible = 0\n            for i in range(second['height']):\n                for j in range(second['width']):\n                    v = second['pattern'][i][j]\n                    if v == 0:\n                        continue\n                    r, c = row_off + i, col_off + j\n                    if r >= N or c >= N:\n                        continue                    # out of view\n                    if canvas[r][c] == 0:\n                        visible += 1\n            if visible > best_visible:\n                best_visible = visible\n                best_r, best_c = row_off, col_off\n                if visible == second_area:        # cannot do better\n                    break\n        if best_visible == second_area:\n            break\n\n    # Write the second shape (only where the canvas is empty)\n    for i in range(second['height']):\n        for j in range(second['width']):\n            v = second['pattern'][i][j]\n            if v == 0:\n                continue\n            r, c = best_r + i, best_c + j\n            if r < N and c < N and canvas[r][c] == 0:\n                canvas[r][c] = v\n\n    return canvas",
