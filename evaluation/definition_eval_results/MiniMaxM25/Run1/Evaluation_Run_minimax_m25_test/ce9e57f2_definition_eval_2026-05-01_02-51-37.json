  "raw_response": "def solve(grid):\n    rows = len(grid)\n    if rows == 0:\n        return grid\n    cols = len(grid[0])\n    for col in range(cols):\n        row = 0\n        while row < rows:\n            if grid[row][col] == 2:\n                start = row\n                while row < rows and grid[row][col] == 2:\n                    row += 1\n                end = row - 1\n                length = end - start + 1\n                lower_half = length // 2\n                for r in range(end - lower_half + 1, end + 1):\n                    grid[r][col] = 8\n            else:\n                row += 1\n    return grid",
