  "raw_response": "def solve(grid):\n    n = len(grid)\n    m = len(grid[0]) if n else 0\n\n    # Find the unique non\u2011zero cell (the seed)\n    value = None\n    r = c = None\n    for i in range(n):\n        for j in range(m):\n            if grid[i][j] != 0:\n                value = grid[i][j]\n                r, c = i, j\n                break\n        if value is not None:\n            break\n\n    # If there is no seed, return an all\u2011zero grid of the same size\n    if value is None:\n        return [[0] * m for _ in range(n)]\n\n    diff = r - c          # constant for the NW\u2011SE diagonal\n    sum_rc = r + c        # constant for the NE\u2011SW diagonal\n\n    # Build the output grid\n    out = [[0] * m for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            if i - j == diff or i + j == sum_rc:\n                out[i][j] = value\n\n    return out",
