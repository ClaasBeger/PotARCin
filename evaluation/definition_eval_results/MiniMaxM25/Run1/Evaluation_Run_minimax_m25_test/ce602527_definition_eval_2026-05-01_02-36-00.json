ython script itself, no other text or markdown.",
  "raw_response": "def solve(grid):\n    from collections import Counter, deque\n\n    if not grid:\n        return []\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # find background color (most common)\n    flat = [cell for row in grid for cell in row]\n    background = Counter(flat).most_common(1)[0][0]\n\n    visited = [[False] * cols for _ in range(rows)]\n    components = []\n\n    # directions for 4-connectivity\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for i in range(rows):\n        for j in range(cols):\n            if visited[i][j]:\n                continue\n            if grid[i][j] == background:\n                continue\n            # start a new component\n            color = grid[i][j]\n            queue = deque([(i, j)])\n            visited[i][j] = True\n            cells = [(i, j)]\n            while queue:\n                r, c = queue.popleft()\n                for dr, dc in dirs:\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        if not visited[nr][nc] and grid[nr][nc] == color:\n                            visited[nr][nc] = True\n                            queue.append((nr, nc))\n                            cells.append((nr, nc))\n            # compute bounding box\n            min_r = min(r for r, _ in cells)\n            max_r = max(r for r, _ in cells)\n            min_c = min(c for _, c in cells)\n            max_c = max(c for _, c in cells)\n            height = max_r - min_r + 1\n            width = max_c - min_c + 1\n            touches = min_r == 0 or max_r == rows - 1 or min_c == 0 or max_c == cols - 1\n            components.append({\n                'color': color,\n                'min_r': min_r,\n                'max_r': max_r,\n                'min_c': min_c,\n                'max_c': max_c,\n                'height': height,\n                'width': width,\n                'touches': touches\n            })\n\n    # consider only interior components (do not touch border)\n    interior = [c for c in components if not c['touches']]\n    if not interior:\n        # fallback: just pick the first component\n        selected = components[0]\n    else:\n        # look for non-square components\n        non_square = [c for c in interior if c['height'] != c['width']]\n        if non_square:\n            # choose the tallest\n            max_height = max(c['height'] for c in non_square)\n            candidates = [c for c in non_square if c['height'] == max_height]\n            if len(candidates) > 1:\n                # tie\u2011break by leftmost (smallest column), then topmost\n                candidates.sort(key=lambda c: (c['min_c'], c['min_r']))\n            selected = candidates[0]\n        else:\n            # all interior components are squares \u2013 pick the leftmost\n            interior.sort(key=lambda c: (c['min_c'], c['min_r']))\n            selected = interior[0]\n\n    # extract the sub\u2011grid\n    r1, r2 = selected['min_r'], selected['max_r']\n    c1, c2 = selected['min_c'], selected['max_c']\n    result = [grid[r][c1:c2+1] for r in range(r1, r2+1)]\n    return result",
  "script": "def solve(grid):\n    from collections import Counter, deque\n\n    if not grid:\n        return []\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # find background color (most common)\n    flat = [cell for row in grid for cell in row]\n    background = Counter(flat).most_common(1)[0][0]\n\n    visited = [[False] * cols for _ in range(rows)]\n    components = []\n\n    # directions for 4-connectivity\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for i in range(rows):\n        for j in range(cols):\n            if visited[i][j]:\n                continue\n            if grid[i][j] == background:\n                continue\n            # start a new component\n            color = grid[i][j]\n            queue = deque([(i, j)])\n            visited[i][j] = True\n            cells = [(i, j)]\n            while queue:\n                r, c = queue.popleft()\n                for dr, dc in dirs:\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        if not visited[nr][nc] and grid[nr][nc] == color:\n                            visited[nr][nc] = True\n                            queue.append((nr, nc))\n                            cells.append((nr, nc))\n            # compute bounding box\n            min_r = min(r for r, _ in cells)\n            max_r = max(r for r, _ in cells)\n            min_c = min(c for _, c in cells)\n            max_c = max(c for _, c in cells)\n            height = max_r - min_r + 1\n            width = max_c - min_c + 1\n            touches = min_r == 0 or max_r == rows - 1 or min_c == 0 or max_c == cols - 1\n            components.append({\n                'color': color,\n                'min_r': min_r,\n                'max_r': max_r,\n                'min_c': min_c,\n                'max_c': max_c,\n                'height': height,\n                'width': width,\n                'touches': touches\n            })\n\n    # consider only interior components (do not touch border)\n    interior = [c for c in components if not c['touches']]\n    if not interior:\n        # fallback: just pick the first component\n        selected = components[0]\n    else:\n        # look for non-square components\n        non_square = [c for c in interior if c['height'] != c['width']]\n        if non_square:\n            # choose the tallest\n            max_height = max(c['height'] for c in non_square)\n            candidates = [c for c in non_square if c['height'] == max_height]\n            if len(candidates) > 1:\n                # tie\u2011break by leftmost (smallest column), then topmost\n                candidates.sort(key=lambda c: (c['min_c'], c['min_r']))\n            selected = candidates[0]\n        else:\n            # all interior components are squares \u2013 pick the leftmost\n            interior.sort(key=lambda c: (c['min_c'], c['min_r']))\n            selected = interior[0]\n\n    # extract the sub\u2011grid\n    r1, r2 = selected['min_r'], selected['max_r']\n    c1, c2 = selected['min_c'], selected['max_c']\n    result = [grid[r][c1:c2+1] for r in range(r1, r2+1)]\n    return result",
