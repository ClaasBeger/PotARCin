  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # find the shape colour (the non\u2011zero colour that is not 5)\n    shape_color = None\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0 and v != 5:\n                shape_color = v\n                break\n        if shape_color is not None:\n            break\n\n    # positions of the anchor colour 5\n    fives = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == 5]\n    if not fives:\n        return [row[:] for row in grid]\n\n    min_row = min(r for r, _ in fives)\n    max_row = max(r for r, _ in fives)\n    min_col = min(c for _, c in fives)\n    max_col = max(c for _, c in fives)\n\n    # presence of anchors on each side (corners do not count as top/bottom)\n    top_present = any(r == min_row and min_col < c < max_col for r, c in fives)\n    bottom_present = any(r == max_row and min_col < c < max_col for r, c in fives)\n    left_present = any(c == min_col for r, c in fives)\n    right_present = any(c == max_col for r, c in fives)\n\n    # initial border positions (one cell inside the outermost anchors)\n    top_border = min_row + 1 if top_present else None\n    bottom_border = max_row - 1 if bottom_present else None\n    left_border = min_col + 1 if left_present else None\n    right_border = max_col - 1 if right_present else None\n\n    # distances between opposite sides\n    if left_present and right_present:\n        horiz_dim = right_border - left_border          # distance between vertical borders\n    else:\n        horiz_dim = None\n    if top_present and bottom_present:\n        vert_dim = bottom_border - top_border          # distance between horizontal borders\n    else:\n        vert_dim = None\n\n    # fill missing sides, creating a square when needed\n    if bottom_border is None and left_present and right_present and top_present:\n        bottom_border = top_border + horiz_dim\n    if top_border is None and left_present and right_present and bottom_present:\n        top_border = bottom_border - horiz_dim\n    if right_border is None and top_present and bottom_present and left_present:\n        right_border = left_border + vert_dim\n    if left_border is None and top_present and bottom_present and right_present:\n        left_border = right_border - vert_dim\n\n    # produce output grid\n    out = [row[:] for row in grid]\n\n    if shape_color is None:\n        return out\n\n    # draw the top and bottom borders\n    for c in range(left_border, right_border + 1):\n        if 0 <= top_border < rows and out[top_border][c] != 5:\n            out[top_border][c] = shape_color\n        if 0 <= bottom_border < rows and out[bottom_border][c] != 5:\n            out[bottom_border][c] = shape_color\n\n    # draw the left and right borders\n    for r in range(top_border, bottom_border + 1):\n        if 0 <= r < rows and out[r][left_border] != 5:\n            out[r][left_border] = shape_color\n        if 0 <= r < rows and out[r][right_border] != 5:\n            out[r][right_border] = shape_color\n\n    return out",
