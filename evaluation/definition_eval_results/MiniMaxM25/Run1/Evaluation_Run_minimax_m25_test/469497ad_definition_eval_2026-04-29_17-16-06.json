break\n\n                if dirn is not None:\n                    di, dj = dirn\n                    if di == dj:                # main diagonal (NW\u2011SE)\n                        for t in range(K):\n                            out[r0 + t][c0 + t] = 2\n                    else:                       # anti diagonal (NE\u2011SW)\n                        for t in range(K):\n                            out[r0 + t][c0 + (K - 1 - t)] = 2\n                # otherwise stay zero\n\n    return out",
