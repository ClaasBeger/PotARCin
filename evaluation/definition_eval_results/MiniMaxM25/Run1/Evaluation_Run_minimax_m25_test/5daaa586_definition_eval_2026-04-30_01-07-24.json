  "raw_response": "def solve(grid):\n    R = len(grid)\n    C = len(grid[0])\n\n    # ---- find vertical bars (constant non\u2011zero columns) ----\n    left_col = right_col = -1\n    cand = []\n    for j in range(C):\n        col_vals = [grid[i][j] for i in range(R)]\n        # find most frequent value\n        from collections import Counter\n        cnt = Counter(col_vals)\n        if not cnt:\n            continue\n        most_val, most_cnt = cnt.most_common(1)[0]\n        # require the dominant value appears in almost every row\n        if most_cnt >= R - 1 and most_val != 0:\n            cand.append((j, most_val))\n    # exactly two candidates \u2013 order them\n    cand.sort(key=lambda x: x[0])\n    if len(cand) != 2:\n        # fallback: just pick the two columns that are constant across most rows\n        raise ValueError(\"Could not locate vertical bars\")\n    left_col, left_color = cand[0]\n    right_col, right_color = cand[1]\n\n    # ---- find horizontal bars (rows where interior is constant) ----\n    top_row = bottom_row = -1\n    bar_rows = []\n    for i in range(R):\n        segment = grid[i][left_col+1:right_col]\n        if segment and all(v == segment[0] for v in segment) and segment[0] != 0:\n            bar_rows.append(i)\n    if len(bar_rows) != 2:\n        raise ValueError(\"Could not locate horizontal bars\")\n    top_row, bottom_row = bar_rows[0], bar_rows[1]\n\n    top_color = grid[top_row][left_col+1]\n    bottom_color = grid[bottom_row][left_col+1]\n\n    # ---- crop region ----\n    rows = range(top_row, bottom_row+1)\n    cols = range(left_col, right_col+1)\n    region_rows = bottom_row - top_row + 1\n    region_cols = right_col - left_col + 1\n    interior_width = region_cols - 2\n\n    # extract interior part (without the border columns)\n    interior = [[grid[r][c] for c in range(left_col+1, right_col)] for r in rows]\n\n    # ---- compute global max row containing top colour ----\n    max_top_row = -1\n    for i in range(region_r