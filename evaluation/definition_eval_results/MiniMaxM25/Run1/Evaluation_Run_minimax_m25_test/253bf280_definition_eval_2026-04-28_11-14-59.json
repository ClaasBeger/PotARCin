  "raw_response": "def solve(grid):\n    \"\"\"\n    Transform the input grid by drawing lines of 3 between pairs of 8s\n    that share the same row or the same column.\n    \"\"\"\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # Create a copy to avoid mutating the input\n    out = [row[:] for row in grid]\n\n    from collections import defaultdict\n\n    # Collect positions of 8s\n    row_to_cols = defaultdict(list)\n    col_to_rows = defaultdict(list)\n\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == 8:\n                row_to_cols[r].append(c)\n                col_to_rows[c].append(r)\n\n    # Fill horizontal segments\n    for r, cols_list in row_to_cols.items():\n        if len(cols_list) >= 2:\n            sorted_cols = sorted(cols_list)\n            for i in range(len(sorted_cols) - 1):\n                start = sorted_cols[i]\n                end = sorted_cols[i + 1]\n                for c in range(start + 1, end):\n                    if out[r][c] != 8:\n                        out[r][c] = 3\n\n    # Fill vertical segments\n    for c, rows_list in col_to_rows.items():\n        if len(rows_list) >= 2:\n            sorted_rows = sorted(rows_list)\n            for i in range(len(sorted_rows) - 1):\n                start = sorted_rows[i]\n                end = sorted_rows[i + 1]\n                for r in range(start + 1, end):\n                    if out[r][c] != 8:\n                        out[r][c] = 3\n\n    return out",
