if not (cr == min_r or cr == max_r or cc == min_c or cc == max_c):\n                            ok = False\n                            break\n                    if ok:\n                        candidates.append((color, min_r, max_r, min_c, max_c, height, width))\n\n    if not candidates:\n        # No suitable rectangle found; return the input unchanged\n        return grid\n\n    # Choose the largest rectangle (by area)\n    candidates.sort(key=lambda x: x[5] * x[6], reverse=True)\n    border_color, min_r, max_r, min_c, max_c, height, width = candidates[0]\n\n    # The other non\u2011zero color(s) are the \"fill\" colors\n    fill_colors = [c for c in colors if c != border_color]\n    fill_color = fill_colors[0] if fill_colors else 0\n\n    # Build the output grid\n    out = [[0] * width for _ in range(height)]\n    for i in range(height):\n        for j in range(width):\n            if i == 0 or i == height - 1 or j == 0 or j == width - 1:\n                out[i][j] = fill_color\n            else:\n                val = grid[min_r + i][min_c + j]\n                # Keep any non\u2011border colour (including the fill colour), otherwise 0\n                out[i][j] = val if val != border_color else 0\n\n    return out",
