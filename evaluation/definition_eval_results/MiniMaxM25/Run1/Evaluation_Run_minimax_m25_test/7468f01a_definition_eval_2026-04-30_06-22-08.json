  "raw_response": "def solve(grid):\n    # Find rows that contain any non\u2011zero cell\n    rows_with_nonzero = [i for i, row in enumerate(grid) if any(cell != 0 for cell in row)]\n    if not rows_with_nonzero:\n        return []\n\n    min_row = min(rows_with_nonzero)\n    max_row = max(rows_with_nonzero)\n\n    # Find columns that contain any non\u2011zero cell (consider only the rows that have non\u2011zero)\n    cols_with_nonzero = [j for j in range(len(grid[0])) if any(grid[i][j] != 0 for i in rows_with_nonzero)]\n    if not cols_with_nonzero:\n        return []\n\n    min_col = min(cols_with_nonzero)\n    max_col = max(cols_with_nonzero)\n\n    # Extract the bounding rectangle\n    subgrid = [row[min_col:max_col + 1] for row in grid[min_row:max_row + 1]]\n\n    # Horizontally flip (mirror) each row\n    flipped = [row[::-1] for row in subgrid]\n\n    return flipped",
  "script": "def solve(grid):\n    # Find rows that contain any non\u2011zero cell\n    rows_with_nonzero = [i for i, row in enumerate(grid) if any(cell != 0 for cell in row)]\n    if not rows_with_nonzero:\n        return []\n\n    min_row = min(rows_with_nonzero)\n    max_row = max(rows_with_nonzero)\n\n    # Find columns that contain any non\u2011zero cell (consider only the rows that have non\u2011zero)\n    cols_with_nonzero = [j for j in range(len(grid[0])) if any(grid[i][j] != 0 for i in rows_with_nonzero)]\n    if not cols_with_nonzero:\n        return []\n\n    min_col = min(cols_with_nonzero)\n    max_col = max(cols_with_nonzero)\n\n    # Extract the bounding rectangle\n    subgrid = [row[min_col:max_col + 1] for row in grid[min_row:max_row + 1]]\n\n    # Horizontally flip (mirror) each row\n    flipped = [row[::-1] for row in subgrid]\n\n    return flipped",
