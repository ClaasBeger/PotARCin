  "raw_response": "def solve(grid):\n    from collections import Counter, defaultdict\n\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n\n    # count non\u2011zero values\n    freq = Counter(v for row in grid for v in row if v != 0)\n\n    # find the value that occurs exactly four times\n    target = None\n    for v, cnt in freq.items():\n        if cnt == 4:\n            target = v\n            break\n\n    if target is None:\n        # no qualifying colour \u2013 return original grid\n        return [row[:] for row in grid]\n\n    # collect positions of the target colour\n    positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == target]\n\n    # group by row and column\n    row_pos = defaultdict(list)\n    col_pos = defaultdict(list)\n    for r, c in positions:\n        row_pos[r].append(c)\n        col_pos[c].append(r)\n\n    rows_to_fill = set()\n    cols_to_fill = set()\n\n    # rows that contain a pair on the leftmost and rightmost columns\n    for r, clist in row_pos.items():\n        if len(clist) >= 2 and 0 in clist and cols - 1 in clist:\n            rows_to_fill.add(r)\n\n    # columns that contain a pair on the topmost and bottommost rows\n    for c, rlist in col_pos.items():\n        if len(rlist) >= 2 and 0 in rlist and rows - 1 in rlist:\n            cols_to_fill.add(c)\n\n    # build the output grid\n    out = [[0] * cols for _ in range(rows)]\n    for r in rows_to_fill:\n        out[r] = [target] * cols\n    for c in cols_to_fill:\n        for i in range(rows):\n            out[i][c] = target\n\n    return out",
  "script": "def solve(grid):\n    from collections import Counter, defaultdict\n\n    rows = len(grid)\n    if rows == 0:\n        return []\n    cols = len(grid[0])\n\n    # count non\u2011zero values\n    freq = Counter(v for row in grid for v in row if v != 0)\n\n    # find the value that occurs exactly four times\n    target = None\n    for v, cnt in freq.items():\n        if cnt == 4:\n            target = v\n            break\n\n    if target is None:\n        # no qualifying colour \u2013 return original grid\n        return [row[:] for row in grid]\n\n    # collect positions of the target colour\n    positions = [(r, c) for r in range(rows) for c in range(cols) if grid[r][c] == target]\n\n    # group by row and column\n    row_pos = defaultdict(list)\n    col_pos = defaultdict(list)\n    for r, c in positions:\n        row_pos[r].append(c)\n        col_pos[c].append(r)\n\n    rows_to_fill = set()\n    cols_to_fill = set()\n\n    # rows that contain a pair on the leftmost and rightmost columns\n    for r, clist in row_pos.items():\n        if len(clist) >= 2 and 0 in clist and cols - 1 in clist:\n            rows_to_fill.add(r)\n\n    # columns that contain a pair on the topmost and bottommost rows\n    for c, rlist in col_pos.items():\n        if len(rlist) >= 2 and 0 in rlist and rows - 1 in rlist:\n            cols_to_fill.add(c)\n\n    # build the output grid\n    out = [[0] * cols for _ in range(rows)]\n    for r in rows_to_fill:\n        out[r] = [target] * cols\n    for c in cols_to_fill:\n        for i in range(rows):\n            out[i][c] = target\n\n    return out",
