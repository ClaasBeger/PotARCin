  "raw_response": "def solve(grid):\n    # Determine the two full\u2011column 8\u2011lines and the two full\u2011row 8\u2011lines\n    rows = len(grid)\n    cols = len(grid[0])\n\n    vertical = []\n    for j in range(cols):\n        if all(grid[i][j] == 8 for i in range(rows)):\n            vertical.append(j)\n\n    horizontal = []\n    for i in range(rows):\n        if all(cell == 8 for cell in grid[i]):\n            horizontal.append(i)\n\n    if len(vertical) != 2 or len(horizontal) != 2:\n        # If the pattern does not match, return the input unchanged\n        return grid\n\n    left_col, right_col = vertical[0], vertical[1]\n    top_row, bottom_row = horizontal[0], horizontal[1]\n\n    # Create a copy of the input grid\n    out = [row[:] for row in grid]\n\n    # Fill the five non\u2011corner regions according to the dice\u2011number mapping\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 8:\n                continue  # keep the 8\u2011lines unchanged\n\n            if i < top_row:\n                # top (north) region\n                if left_col < j < right_col:\n                    out[i][j] = 2\n            elif i > bottom_row:\n                # bottom (south) region\n                if left_col < j < right_col:\n                    out[i][j] = 1\n            else:\n                # middle rows (between the two horizontal 8\u2011lines)\n                if j < left_col:\n                    # left (west) region\n                    out[i][j] = 4\n                elif j > right_col:\n                    # right (east) region\n                    out[i][j] = 3\n                else:\n                    # centre region\n                    out[i][j] = 6\n    return out",
  "script": "def solve(grid):\n    # Determine the two full\u2011column 8\u2011lines and the two full\u2011row 8\u2011lines\n    rows = len(grid)\n    cols = len(grid[0])\n\n    vertical = []\n    for j in range(cols):\n        if all(grid[i][j] == 8 for i in range(rows)):\n            vertical.append(j)\n\n    horizontal = []\n    for i in range(rows):\n        if all(cell == 8 for cell in grid[i]):\n            horizontal.append(i)\n\n    if len(vertical) != 2 or len(horizontal) != 2:\n        # If the pattern does not match, return the input unchanged\n        return grid\n\n    left_col, right_col = vertical[0], vertical[1]\n    top_row, bottom_row = horizontal[0], horizontal[1]\n\n    # Create a copy of the input grid\n    out = [row[:] for row in grid]\n\n    # Fill the five non\u2011corner regions according to the dice\u2011number mapping\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 8:\n                continue  # keep the 8\u2011lines unchanged\n\n            if i < top_row:\n                # top (north) region\n                if left_col < j < right_col:\n                    out[i][j] = 2\n            elif i > bottom_row:\n                # bottom (south) region\n                if left_col < j < right_col:\n                    out[i][j] = 1\n            else:\n                # middle rows (between the two horizontal 8\u2011lines)\n                if j < left_col:\n                    # left (west) region\n                    out[i][j] = 4\n                elif j > right_col:\n                    # right (east) region\n                    out[i][j] = 3\n                else:\n                    # centre region\n                    out[i][j] = 6\n    return out",
