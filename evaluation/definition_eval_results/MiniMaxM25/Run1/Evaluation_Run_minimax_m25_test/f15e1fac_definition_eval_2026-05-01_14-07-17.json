      dir_v = 1           # downward\n        else:\n            dir_v = 0           # should not happen\n\n        # Feasibility test: can we place a block in the chosen direction?\n        feasible = True\n        for (r0, c0) in pattern:\n            if dir_v == -1:\n                max_dist = r0\n            else:\n                max_dist = h - 1 - r0\n            start = c0 + sign * step * max_dist\n            if sign == 1:\n                if start > w - step:\n                    feasible = False\n                    break\n            else:\n                if start - step + 1 < 0:\n                    feasible = False\n                    break\n        if not feasible:\n            sign = -sign\n\n        # Propagate each seed upwards (or downwards)\n        for (r0, c0) in pattern:\n            k = 0\n            while True:\n                r = r0 + dir_v * k\n                if r < 0 or r >= h:\n                    break\n                offset = step * k\n                start = c0 + sign * offset\n\n                if sign == 1:\n                    col_l = start\n                    col_r = start + step - 1\n                else:\n                    col_l = start - step + 1\n                    col_r = start\n\n                # clip to grid\n                if col_l > w - 1 or col_r < 0:\n                    if sign == 1 and col_l > w - 1:\n                        break\n                    if sign == -1 and col_r < 0:\n                        break\n                col_l = max(col_l, 0)\n                col_r = min(col_r, w - 1)\n                if col_l > col_r:\n                    break\n\n                for cc in range(col_l, col_r + 1):\n                    if out[r][cc] != 2:\n                        out[r][cc] = 8\n                k += 1\n    # If the 2s do not form a single row or column, leave the grid unchanged\n    return out",
