  "raw_response": "def solve(grid):\n    \"\"\"\n    Fill every zero cell in the grid with the value that belongs to the underlying\n    periodic pattern.  The pattern is discovered by finding the smallest vertical\n    and horizontal periods that are consistent with all non\u2011zero cells.\n    \"\"\"\n    if not grid:\n        return grid\n\n    H = len(grid)\n    W = len(grid[0])\n\n    # ---- find vertical period -----------------------------------------\n    v_period = None\n    for v in range(1, H + 1):\n        ok = True\n        for i in range(H - v):\n            for j in range(W):\n                a = grid[i][j]\n                b = grid[i + v][j]\n                if a != 0 and b != 0 and a != b:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if ok:\n            v_period = v\n            break\n    if v_period is None:\n        v_period = H\n\n    # ---- find horizontal period ----------------------------------------\n    h_period = None\n    for h in range(1, W + 1):\n        ok = True\n        for i in range(H):\n            for j in range(W - h):\n                a = grid[i][j]\n                b = grid[i][j + h]\n                if a != 0 and b != 0 and a != b:\n                    ok = False\n                    break\n            if not ok:\n                break\n        if ok:\n            h_period = h\n            break\n    if h_period is None:\n        h_period = W\n\n    # ---- build the tile ------------------------------------------------\n    tile = [[0] * h_period for _ in range(v_period)]\n    for i in range(H):\n        for j in range(W):\n            val = grid[i][j]\n            if val != 0:\n                ti = i % v_period\n                tj = j % h_period\n                # if the position has already been filled, the values must agree\n                if tile[ti][tj] == 0:\n                    tile[ti][tj] = val\n                else:\n                    # (in a consistent puzzle this never happens)\n                    assert tile[ti][tj] == val\n\n    # ---- generate output ------------------------------------------------\n    out = [[0] * W for _ in range(H)]\n    for i in range(H):\n        for j in range(W):\n            out[i][j] = tile[i % v_period][j % h_period]\n    return out",
