stent puzzle this never happens)\n                    assert tile[ti][tj] == val\n\n    # ---- generate output ------------------------------------------------\n    out = [[0] * W for _ in range(H)]\n    for i in range(H):\n        for j in range(W):\n            out[i][j] = tile[i % v_period][j % h_period]\n    return out",
