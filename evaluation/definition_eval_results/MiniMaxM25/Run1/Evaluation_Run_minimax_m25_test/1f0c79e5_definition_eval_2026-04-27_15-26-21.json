           if fill_up and fill_down:\n                    row_ok = True\n                else:\n                    row_ok = (fill_up and i <= r1) or (fill_down and i >= r0)\n                # column restriction\n                if fill_left and fill_right:\n                    col_ok = True\n                else:\n                    col_ok = (fill_left and j <= c1) or (fill_right and j >= c0)\n                if row_ok and col_ok:\n                    out[i][j] = X_colour\n    return out",
