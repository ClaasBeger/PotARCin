  "raw_response": "def solve(grid):\n    \"\"\"\n    Transforms the input grid by keeping only the largest axis\u2011aligned\n    rectangle (with both dimensions at least 2) for each connected component\n    of a non\u2011zero colour. All other cells are set to zero.\n    \"\"\"\n    if not grid:\n        return grid\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # find distinct non\u2011zero colours\n    colours = {v for row in grid for v in row if v != 0}\n\n    # output starts as all zeros\n    out = [[0] * cols for _ in range(rows)]\n\n    # visited mask\n    visited = [[False] * cols for _ in range(rows)]\n\n    # directions for 4\u2011connectivity\n    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n    for colour in colours:\n        for r in range(rows):\n            for c in range(cols):\n                if grid[r][c] == colour and not visited[r][c]:\n                    # ----- collect one connected component -----\n                    component = []\n                    stack = [(r, c)]\n                    visited[r][c] = True\n                    while stack:\n                        cr, cc = stack.pop()\n                        component.append((cr, cc))\n                        for dr, dc in dirs:\n                            nr, nc = cr + dr, cc + dc\n                            if 0 <= nr < rows and 0 <= nc < cols:\n                                if grid[nr][nc] == colour and not visited[nr][nc]:\n                                    visited[nr][nc] = True\n                                    stack.append((nr, nc))\n\n                    # ----- build row \u2192 set(columns) map -----\n                    row_cols = {}\n                    for cr, cc in component:\n                        row_cols.setdefault(cr, set()).add(cc)\n\n                    sorted_rows = sorted(row_cols.keys())\n\n                    # ----- find the largest full rectangle inside the component -----\n                    best_area = 0\n                    best_top = best_bottom = best_left = best_right = None\n\n                    for i_top, top in enumerate(sorted_rows):\n                        cur_cols = row_cols[top].copy()\n                        for bottom in sorted_rows[i_top:]:\n                            if bottom != top:\n                                cur_cols &= row_cols[bottom]\n                                if not cur_cols:\n                                    break\n                            if not cur_cols:\n                                continue\n                            # longest consecutive run of columns in cur_cols\n                            sorted_cols = sorted(cur_cols)\n                            run_start = sorted_cols[0]\n                            run_len = 1\n                            max_run_len = 1\n                            max_run_start = sorted_cols[0]\n                            for k in range(1, len(sorted_cols)):\n                                if sorted_cols[k] == sorted_cols[k-1] + 1:\n                                    run_len += 1\n                                else:\n                                    if run_len > max_run_len:\n                                        max_run_len = run_len\n                                        max_run_start = run_start\n                                    run_start = sorted_cols[k]\n                                    run_len = 1\n                            if run_len > max_run_len:\n                                max_run_len = run_len\n                                max_run_start = run_start\n\n                            width = max_run_len\n                            height = bottom - top + 1\n                            area = width * height\n                            if area > best_area:\n                                best_area = area\n                                best_top = top\n                                best_bottom = bottom\n                                best_left = max_run_start\n                     