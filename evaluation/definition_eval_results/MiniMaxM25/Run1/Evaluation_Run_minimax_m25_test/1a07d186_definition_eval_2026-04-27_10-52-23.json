  "script": "def solve(grid):\n    n_rows = len(grid)\n    n_cols = len(grid[0]) if n_rows else 0\n\n    # collect positions of each non\u2011zero colour\n    from collections import defaultdict\n    positions = defaultdict(list)\n    for r in range(n_rows):\n        for c in range(n_cols):\n            v = grid[r][c]\n            if v != 0:\n                positions[v].append((r, c))\n\n    # detect full row or full column for each colour\n    line_info = {}                     # colour -> ('row'/'col', index)\n    for col, pos in positions.items():\n        # check for a full row\n        full_row = None\n        for r in range(n_rows):\n            if sum(1 for (rr, _) in pos if rr == r) == n_cols:\n                full_row = r\n                break\n        if full_row is not None:\n            line_info[col] = ('row', full_row)\n            continue\n\n        # check for a full column\n        full_col = None\n        for c in range(n_cols):\n            if sum(1 for (_, cc) in pos if cc == c) == n_rows:\n                full_col = c\n                break\n        if full_col is not None:\n            line_info[col] = ('col', full_col)\n\n    # create output grid (initially all zeros)\n    out = [[0] * n_cols for _ in range(n_rows)]\n\n    # write the full rows/columns\n    for col, (orient, idx) in line_info.items():\n        if orient == 'row':\n            out[idx] = [col] * n_cols\n        else:                      # orientation = 'col'\n            for r in range(n_rows):\n                out[r][idx] = col\n\n    # move extra cells adjacent to the full line\n    for col, (orient, idx) in line_info.items():\n        for (r, c) in positions[col]:\n            if orient == 'row':\n                if r == idx:\n                    continue                # skip cells that belong to the line\n                target_r = idx - 1 if r < idx else idx + 1\n                target_c = c\n                if 0 <= target_r < n_rows:\n                    out[target_r