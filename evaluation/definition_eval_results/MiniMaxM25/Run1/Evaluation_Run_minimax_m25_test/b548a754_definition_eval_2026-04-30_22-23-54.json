  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # locate the single cell with value 8\n    r8 = c8 = -1\n    for i in range(rows):\n        for j in range(cols):\n            if grid[i][j] == 8:\n                r8, c8 = i, j\n                break\n        if r8 != -1:\n            break\n\n    # bounding box of all non\u2011zero cells except the 8\n    minR, maxR, minC, maxC = rows, -1, cols, -1\n    for i in range(rows):\n        for j in range(cols):\n            v = grid[i][j]\n            if v != 0 and v != 8:\n                if i < minR: minR = i\n                if i > maxR: maxR = i\n                if j < minC: minC = j\n                if j > maxC: maxC = j\n\n    # if there is no such shape, return the input unchanged\n    if minR > maxR:\n        return grid\n\n    # determine border colour \u2013 any non\u2011zero cell on the perimeter\n    border_color = None\n    for c in range(minC, maxC + 1):\n        v = grid[minR][c]\n        if v != 0 and v != 8:\n            border_color = v\n            break\n    if border_color is None:\n        for r in range(minR, maxR + 1):\n            v = grid[r][minC]\n            if v != 0 and v != 8:\n                border_color = v\n                break\n\n    # determine interior colour \u2013 a different non\u2011zero cell inside the rectangle\n    interior_color = None\n    for r in range(minR + 1, maxR):\n        for c in range(minC + 1, maxC):\n            v = grid[r][c]\n            if v != 0 and v != 8 and v != border_color:\n                interior_color = v\n                break\n        if interior_color is not None:\n            break\n\n    # decide new rectangle bounds by extending toward the 8\n    new_minR, new_maxR, new_minC, new_maxC = minR, maxR, minC, maxC\n    if minR <= r8 <= maxR:\n        # same vertical range \u2192 expand horizontally\n        if c8 > maxC:\n            new_maxC = c8\n        elif c8 < minC:\n            new_minC = c8\n    elif minC <= c8 <= maxC:\n        # same horizontal range \u2192 expand vertically\n        if r8 > maxR:\n            new_maxR = r8\n        elif r8 < minR:\n            new_minR = r8\n\n    # build the output grid\n    out = [[0] * cols for _ in range(rows)]\n    for i in range(rows):\n        for j in range(cols):\n            if new_minR <= i <= new_maxR and new_minC <= j <= new_maxC:\n                if i == new_minR or i == new_maxR or j == new_minC or j == new_maxC:\n                    out[i][j] = border_color\n                else:\n                    out[i][j] = interior_color if interior_color is not None else 0\n            else:\n                out[i][j] = 0\n\n    return out",
