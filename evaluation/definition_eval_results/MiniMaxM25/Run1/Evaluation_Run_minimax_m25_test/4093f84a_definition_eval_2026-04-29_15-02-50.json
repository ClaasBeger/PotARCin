irst)\n        points[side].sort(key=lambda x: x[0])\n        for dist, r, c in points[side]:\n            if side == 'above':\n                base_r = min_r - 1\n                base_c = c\n                delta = 0\n                while True:\n                    tr = base_r - delta\n                    tc = base_c\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n            elif side == 'below':\n                base_r = max_r + 1\n                base_c = c\n                delta = 0\n                while True:\n                    tr = base_r + delta\n                    tc = base_c\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n            elif side == 'left':\n                base_c = min_c - 1\n                base_r = r\n                delta = 0\n                while True:\n                    tr = base_r\n                    tc = base_c - delta\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n            else:  # right\n                base_c = max_c + 1\n                base_r = r\n                delta = 0\n                while True:\n                    tr = base_r\n                    tc = base_c + delta\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n\n    return out",
