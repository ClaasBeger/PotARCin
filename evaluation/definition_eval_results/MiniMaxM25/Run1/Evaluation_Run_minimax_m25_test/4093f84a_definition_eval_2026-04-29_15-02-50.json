  "raw_response": "def solve(grid):\n    rows = len(grid)\n    cols = len(grid[0]) if rows else 0\n\n    # count non\u2011zero colors\n    freq = {}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0:\n                freq[v] = freq.get(v, 0) + 1\n\n    # block color is the most frequent non\u2011zero colour\n    block_color = max(freq, key=freq.get)\n\n    # bounding box of the block\n    min_r = rows\n    max_r = -1\n    min_c = cols\n    max_c = -1\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == block_color:\n                if r < min_r:\n                    min_r = r\n                if r > max_r:\n                    max_r = r\n                if c < min_c:\n                    min_c = c\n                if c > max_c:\n                    max_c = c\n\n    # initialise output with zeros\n    out = [[0] * cols for _ in range(rows)]\n\n    # copy the block region\n    for r in range(min_r, max_r + 1):\n        for c in range(min_c, max_c + 1):\n            out[r][c] = block_color\n\n    # gather points to move\n    points = {'above': [], 'below': [], 'left': [], 'right': []}\n    for r in range(rows):\n        for c in range(cols):\n            v = grid[r][c]\n            if v != 0 and v != block_color:\n                if r < min_r:\n                    side = 'above'\n                    dist = min_r - r\n                elif r > max_r:\n                    side = 'below'\n                    dist = r - max_r\n                elif c < min_c:\n                    side = 'left'\n                    dist = min_c - c\n                elif c > max_c:\n                    side = 'right'\n                    dist = c - max_c\n                else:\n                    continue  # should not happen\n                points[side].append((dist, r, c))\n\n    # process each side\n    for side in ('above', 'below', 'left', 'right'):\n        # sort by distance to the block (nearest first)\n        points[side].sort(key=lambda x: x[0])\n        for dist, r, c in points[side]:\n            if side == 'above':\n                base_r = min_r - 1\n                base_c = c\n                delta = 0\n                while True:\n                    tr = base_r - delta\n                    tc = base_c\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n            elif side == 'below':\n                base_r = max_r + 1\n                base_c = c\n                delta = 0\n                while True:\n                    tr = base_r + delta\n                    tc = base_c\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n            elif side == 'left':\n                base_c = min_c - 1\n                base_r = r\n                delta = 0\n                while True:\n                    tr = base_r\n                    tc = base_c - delta\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n            else:  # right\n                base_c = max_c + 1\n                base_r = r\n                delta = 0\n                while True:\n                    tr = base_r\n                    tc = base_c + delta\n                    if 0 <= tr < rows and 0 <= tc < cols and out[tr][tc] == 0:\n                        out[tr][tc] = block_color\n                        break\n                    delta += 1\n\n    return out",
