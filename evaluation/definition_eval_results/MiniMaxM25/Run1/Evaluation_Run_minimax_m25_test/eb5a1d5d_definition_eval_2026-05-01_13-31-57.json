  "raw_response": "def solve(grid):\n    if not grid:\n        return []\n\n    rows = len(grid)\n    cols = len(grid[0])\n\n    visited = [[False] * cols for _ in range(rows)]\n    components = []\n\n    for r in range(rows):\n        for c in range(cols):\n            if not visited[r][c]:\n                color = grid[r][c]\n                stack = [(r, c)]\n                visited[r][c] = True\n                min_r = max_r = r\n                min_c = max_c = c\n                while stack:\n                    cr, cc = stack.pop()\n                    if cr < min_r:\n                        min_r = cr\n                    if cr > max_r:\n                        max_r = cr\n                    if cc < min_c:\n                        min_c = cc\n                    if cc > max_c:\n                        max_c = cc\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < rows and 0 <= nc < cols and not visited[nr][nc] and grid[nr][nc] == color:\n                            visited[nr][nc] = True\n                            stack.append((nr, nc))\n                touches_border = (min_r == 0 or max_r == rows - 1 or min_c == 0 or max_c == cols - 1)\n                area = (max_r - min_r + 1) * (max_c - min_c + 1)\n                components.append({'color': color, 'area': area, 'touches_border': touches_border})\n\n    # Sort by area descending; the largest area is the outermost region (background)\n    components.sort(key=lambda x: -x['area'])\n\n    # Extract colors in order\n    layers = [comp['color'] for comp in components]\n\n    n = len(layers)\n    size = 2 * n - 1\n    bg_color = layers[0]\n    out = [[bg_color] * size for _ in range(size)]\n\n    # Draw concentric rings\n    for i, color in enumerate(layers):\n        top = i\n        bottom = size - 1 - i\n        left = i\n        right = size - 1 - i\n        for c in range(left, right + 1):\n      