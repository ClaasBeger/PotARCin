  "raw_response": "def solve(grid):\n    nrows = len(grid)\n    if nrows == 0:\n        return grid\n    ncols = len(grid[0])\n\n    # copy original grid\n    out = [row[:] for row in grid]\n\n    # locate full rows of 8 (horizontal axis)\n    axis_rows = [r for r in range(nrows) if all(cell == 8 for cell in grid[r])]\n    # locate full columns of 8 (vertical axis)\n    axis_cols = [c for c in range(ncols) if all(grid[r][c] == 8 for r in range(nrows))]\n\n    # decide orientation\n    if axis_rows:\n        orientation = 'horizontal'\n        axes = axis_rows\n    elif axis_cols:\n        orientation = 'vertical'\n        axes = axis_cols\n    else:\n        # no axis \u2013 nothing to do\n        return out\n\n    # locate all 2-cells\n    twos = [(r, c) for r in range(nrows) for c in range(ncols) if grid[r][c] == 2]\n\n    for (r, c) in twos:\n        if orientation == 'horizontal':\n            # axes are rows\n            above = [ar for ar in axes if ar < r]\n            below = [ar for ar in axes if ar > r]\n\n            if above and below:\n                # between two axis rows \u2013 connect to both\n                targets = axes\n            else:\n                # only one side \u2013 connect to the nearest axis row\n                if above:\n                    target = max(above)\n                else:\n                    target = min(below)\n                targets = [target]\n\n            for axis_r in targets:\n                if axis_r > r:  # downwards\n                    for rr in range(r + 1, axis_r - 1):\n                        out[rr][c] = 2\n                    out[axis_r][c] = 2\n                else:  # upwards\n                    for rr in range(axis_r + 2, r):\n                        out[rr][c] = 2\n                    out[axis_r][c] = 2\n\n                # 3x3 block of 8 around the intersection\n                for dr in (-1, 0, 1):\n                    for dc in (-1, 0, 1):\n                        if dr == 0 and dc == 0:\n                            continue\n                        nr, nc = axis_r + dr, c + dc\n                        if 0 <= nr < nrows and 0 <= nc < ncols and out[nr][nc] != 2:\n                            out[nr][nc] = 8\n        else:  # orientation == 'vertical'\n            # axes are columns\n            left = [ac for ac in axes if ac < c]\n            right = [ac for ac in axes if ac > c]\n\n            if left and right:\n                targets = axes\n            else:\n                if left:\n                    target = max(left)\n                else:\n                    target = min(right)\n                targets = [target]\n\n            for axis_c in targets:\n                if axis_c > c:  # to the right\n                    for cc in range(c + 1, axis_c - 1):\n                        out[r][cc] = 2\n                    out[r][axis_c] = 2\n                else:  # to the left\n                    for cc in range(axis_c + 2, c):\n                        out[r][cc] = 2\n                    out[r][axis_c] = 2\n\n                # 3x3 block of 8 around the intersection\n                for dr in (-1, 0, 1):\n                    for dc in (-1, 0, 1):\n                        if dr == 0 and dc == 0:\n                            continue\n                        nr, nc = r + dr, axis_c + dc\n                        if 0 <= nr < nrows and 0 <= nc < ncols and out[nr][nc] != 2:\n                            out[nr][nc] = 8\n\n    return out",
