  "raw_response": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    if len(pts) != 2:\n        return [row[:] for row in grid]\n\n    r1, c1, v1 = pts[0]\n    r2, c2, v2 = pts[1]\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    dr = r2 - r1\n    dc = c2 - c1\n\n    # If the two points are vertically adjacent via wrap (or in same row),\n    # create repeating vertical stripes across all rows.\n    if abs(dr) == h - 1 or dr == 0:\n        step = abs(dc)\n        if step == 0:\n            for r in range(h):\n                out[r][c1] = v1\n            return out\n\n        k = 0\n        c = c1\n        while c < w:\n            val = v1 if k % 2 == 0 else v2\n            for r in range(h):\n                out[r][c] = val\n            c += step\n            k += 1\n        return out\n\n    # If the two points are horizontally adjacent via wrap (or in same column),\n    # create repeating horizontal stripes across all columns.\n    if abs(dc) == w - 1 or dc == 0:\n        step = abs(dr)\n        if step == 0:\n            for c in range(w):\n                out[r1][c] = v1\n            return out\n\n        k = 0\n        r = r1\n        while r < h:\n            val = v1 if k % 2 == 0 else v2\n            for c in range(w):\n                out[r][c] = val\n            r += step\n            k += 1\n        return out\n\n    return [row[:] for row in grid]",
  "script": "def solve(grid):\n    h = len(grid)\n    w = len(grid[0]) if h else 0\n\n    pts = []\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != 0:\n                pts.append((r, c, grid[r][c]))\n\n    if len(pts) != 2:\n        return [row[:] for row in grid]\n\n    r1, c1, v1 = pts[0]\n    r2, c2, v2 = pts[1]\n\n    out = [[0 for _ in range(w)] for _ in range(h)]\n\n    dr = r2 - r1\n    dc = c2 - c1\n\n    # If the two points are vertically adjacent via wrap (or in same row),\n    # create repeating vertical stripes across all rows.\n    if abs(dr) == h - 1 or dr == 0:\n        step = abs(dc)\n        if step == 0:\n            for r in range(h):\n                out[r][c1] = v1\n            return out\n\n        k = 0\n        c = c1\n        while c < w:\n            val = v1 if k % 2 == 0 else v2\n            for r in range(h):\n                out[r][c] = val\n            c += step\n            k += 1\n        return out\n\n    # If the two points are horizontally adjacent via wrap (or in same column),\n    # create repeating horizontal stripes across all columns.\n    if abs(dc) == w - 1 or dc == 0:\n        step = abs(dr)\n        if step == 0:\n            for c in range(w):\n                out[r1][c] = v1\n            return out\n\n        k = 0\n        r = r1\n        while r < h:\n            val = v1 if k % 2 == 0 else v2\n            for c in range(w):\n                out[r][c] = val\n            r += step\n            k += 1\n        return out\n\n    return [row[:] for row in grid]",
